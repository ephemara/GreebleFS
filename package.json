{
  "name": "greeblefs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings",
    "icons:folders": "bun scripts/sync-canonical-icons.mjs",
    "dev": "bun scripts/sync-canonical-icons.mjs && cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings && vite",
    "dev:vps": "bash scripts/with-vps-artifacts.sh bun run dev",
    "build": "bun scripts/sync-canonical-icons.mjs && cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings && vite build",
    "build:vps": "bash scripts/with-vps-artifacts.sh bun run build",
    "release:linux:bundle": "bun run tauri build --bundles deb,rpm,appimage --no-sign --ci",
    "release:linux:install": "bash scripts/build-and-install-linux-local-release.sh",
    "release:linux:install:launch": "bash scripts/build-and-install-linux-local-release.sh --launch",
    "preview": "vite preview",
    "tauri": "node scripts/run-platform-tauri.mjs",
    "tauri:vps": "bash scripts/with-vps-artifacts.sh bun run tauri",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:vps": "bash scripts/with-vps-artifacts.sh bun run test:unit",
    "test:watch": "vitest watch",
    "test:unit:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:vps": "bash scripts/with-vps-artifacts.sh bun run test:coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:proof:repository-picker": "node scripts/run-fileExplorer-repositoryPicker-proof.mjs",
    "test:browser:vps": "bash scripts/with-vps-artifacts.sh bun run test:browser",
    "test:browser:watch": "vitest --config vitest.browser.config.ts",
    "test:rust": "node scripts/run-cargo-tests.mjs",
    "test:rust:vps": "bash scripts/with-vps-artifacts.sh bun run test:rust",
    "test:all": "vitest run && vitest run --config vitest.browser.config.ts && node scripts/run-cargo-tests.mjs && vitest run --coverage",
    "heartbeat:pass": "node scripts/run-heartbeat-pass.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "cropperjs": "^1.6",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.3.3",
    "fabric": "^7.2.0",
    "framer-motion": "^12.38.0",
    "hyperformula": "^3.2.0",
    "jsondiffpatch": "^0.7.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.5",
    "nanoid": "^5.1.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smol-toml": "^1.6.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.183.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cropperjs": "^1.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^28.1.0",
    "material-icon-theme": "^5.33.1",
    "playwright": "^1.58.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.0.18"
  }
}
