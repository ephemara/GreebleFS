        let bandCoreNodes = nodes.filter(none)
        let bandSatelliteNodes = nodes.filter(none)
        if bandPrimaryNode:
            if (band.dominant and (!dominantPrimaryNode)):
                dominantPrimaryNode = bandPrimaryNode
            let iter_4 = bandCoreNodes.filter(none)
            let index_5 = 0
            while (index_5 < iter_4.length):
                let node = iter_4[index_5]
                connections.push(createConstellationConnection(bandPrimaryNode, node, "primary"))
                index_5 = (index_5 + 1)
            let iter_6 = bandSatelliteNodes
            let index_7 = 0
            while (index_7 < iter_6.length):
                let node = iter_6[index_7]
                let index = index_7
                let anchorNode = none
                connections.push(createConstellationConnection(anchorNode, node, "secondary"))
                if (((normalizedDensity >= 0.46) and (index > 0)) and ((index % 2) == 0)):
