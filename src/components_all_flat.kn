fn matchesActionSelectionRules(command: ExplorerResolvedActionContextMenuContribution, targetEntries: [ExplorerMenuInvocationEntry]) -> Any:
    let _ = command.execution.action
    let selection: Any = none
    let count = targetEntries.length
    if ((selection.minCount != none) and (count < selection.minCount)):
        return false
    if ((selection.maxCount != none) and (count > selection.maxCount)):
        return false
    if (count == 0):
        return ((selection.minCount == none) or (selection.minCount == 0))
    if ((!selection.allowFiles) and targetEntries.some(none)):
        return false
    if ((!selection.allowDirectories) and targetEntries.some(none)):
        return false
    if (selection.extensions.length == 0):
        return true
    return targetEntries.every(none)

fn canShowCommand(command: ExplorerCommandDefinition, invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment) -> Any:
    if (!command.contexts.includes(invocation.kind)):
        return false
    if (!isCommandApplicableToSelection(command, targetEntries)):
        return false
    if ((command.source == "plugin") or (command.source == "preview")):
        return true
    if (command.source == "action"):
        return matchesActionSelectionRules(command, targetEntries)
    let actionId = command.execution.actionId
    let currentPathEntry = resolveCurrentPathEntry(environment)
    let entry = (primaryEntry or currentPathEntry)
    let entryPath = entry.path
    if (actionId == "open"):
        return (targetEntries.length > 0)
    else if (actionId == "open-with"):
        return (environment.supportsNativeOpenWith and environment.supportsNativeIntegration(entryPath))
    else if (actionId == "windows-shell-actions"):
        return ((resolveExplorerWindowsShellContextMenuRequest(invocation, targetEntries, primaryEntry, environment) != none))
    else if (actionId == "open-admin"):
        return (environment.supportsNativeIntegration(entryPath) and (!environment.isExplorerArchiveVirtualPath(entryPath)))
    else if (actionId == "open-terminal"):
        return ((entry.isDirectory and (!environment.isCloudExplorerPath(entryPath))) and (!environment.isExplorerArchiveVirtualPath(entryPath)))
    else if (actionId == "open-aquarium"):
        return (!environment.isCloudExplorerPath(entryPath))
    else if (actionId == "edit-menu"):
        return true
    else if (actionId == "send-to-mobile-download"):
        return (((((targetEntries.length == 1) and (!entry.isDirectory)) and (!environment.isCloudExplorerPath(entryPath))) and (!environment.isExplorerArchiveVirtualPath(entryPath))) and environment.supportsNativeIntegration(entryPath))
    else if (actionId == "reveal"):
        if (invocation.kind == "background"):
            return environment.supportsNativeIntegration(environment.currentPath)
        return ((targetEntries.length > 0) and targetEntries.every(none))
    else if (actionId == "properties"):
        return none
    else if (actionId == "copy-path"):
        return (targetEntries.length > 0)
    else if (actionId == "new-folder"):
        return (((invocation.kind == "background") and environment.currentLocationSupportsMutation) and environment.canCreateDirectory)
    else if (actionId == "new-file"):
        return (((invocation.kind == "background") and environment.currentLocationSupportsMutation) and environment.canCreateFile)
    else if (actionId == "paste"):
        return (((invocation.kind == "background") and environment.currentLocationSupportsMutation) and environment.clipboardAvailable)
    else if (actionId == "copy"):
        ()
    else if (actionId == "cut"):
        ()
    else if (actionId == "copy-to"):
        ()
    else if (actionId == "move-to"):
        return ((targetEntries.length > 0) and environment.currentLocationSupportsMutation)
    else if (actionId == "extract-here"):
        ()
    else if (actionId == "extract-to"):
        ()
    else if (actionId == "extract-new-folder"):
        return ts_Boolean((primaryEntry and environment.isExplorerArchiveEntry(primaryEntry)))
    else if (actionId == "duplicate"):
        return ((targetEntries.length > 0) and environment.currentLocationSupportsMutation)
    else if (actionId == "find-similar"):
        return ((((targetEntries.length == 1) and (!primaryEntry.isDirectory)) and (!environment.currentPathIsCloud)) and environment.isSemanticSearchTextLikeExtension((primaryEntry.extension or "")))
    else if (actionId == "rename"):
        return ((targetEntries.length == 1) and environment.currentLocationSupportsMutation)
    else if (actionId == "add-tags"):
        ()
    else if (actionId == "remove-tags"):
        return ((targetEntries.length > 0) and environment.currentLocationSupportsMutation)
    else if (actionId == "bookmark-toggle"):
        return (targetEntries.length == 1)
    else if (actionId == "move-trash"):
        return ((targetEntries.length > 0) and environment.currentLocationSupportsMutation)
    else if (actionId == "refresh"):
        return true
    else:
        return true

