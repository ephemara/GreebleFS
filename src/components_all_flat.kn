    let totalColumnCount = Math.max(0, dimensions.width)
    let totalRowCount = Math.max(0, dimensions.height)
    let visibleColumnCount = Math.min(totalColumnCount, maxColumns)
    let visibleRowCount = Math.min(totalRowCount, maxRows)
    let columns: [ExplorerTablePreviewColumn] = [none, ts_Array.from(none, none)]
    let rows: [ExplorerTablePreviewRow] = ts_Array.from(none, none)
    return none

