    state contentRef: Any = useRef(none)
    state verticalTrackRef: Any = useRef(none)
    state verticalThumbRef: Any = useRef(none)
    state horizontalTrackRef: Any = useRef(none)
    state horizontalThumbRef: Any = useRef(none)
    state pendingScrollbarSyncFrameRef: Any = useRef(none)
    state scrollbarSettleFramesRemainingRef: Any = useRef(0)
    state stableScrollbarMeasurementFramesRef: Any = useRef(0)
    state lastScrollbarMeasurementRef: Any = useRef(none)
    state scrollbarDragStateRef: Any = useRef(none)
