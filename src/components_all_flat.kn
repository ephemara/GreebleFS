fn normalizeThemeRendererExport(exported: Any, fallbackContext: OverlayThemeRendererContext) -> Any:
    let candidate = unwrapRuntimeModuleExport(exported, ["themeRenderer"])
    if (candidate == "function"):
        return none
    if ((candidate and (candidate == "object")) and ts_in_operator("component", candidate)):
        let definition = candidate
        if (definition.component_ != "function"):
            ()
        return definition

