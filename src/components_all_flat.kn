fn collectContextMenuDescendantIds(entries: [ExplorerMenuLayoutEntry], rootEntryId: String) -> Set<String>:
    let descendantIds = ts_Set()
    let queue = [rootEntryId]
    while (queue.length > 0):
        let currentEntryId = queue.shift()
        if (!currentEntryId):
            continue
        for entry in entries:
            if ((entry.parentEntryId != currentEntryId) or descendantIds.has(entry.id)):
                continue
            descendantIds.add(entry.id)
            queue.push(entry.id)
    return descendantIds

fn resolveContextMenuEntryTitle(entry: ExplorerMenuLayoutEntry, commandLookup: Map<String, ExplorerCommandDefinition>) -> Any:
    if (entry.kind == "command"):
        return (commandLookup.get(entry.commandId).title or entry.commandId)
    if (entry.kind == "submenu"):
        return entry.title
    if (entry.kind == "group-slot"):
        return none + entry.group
    return "Separator"

fn resolveContextMenuInsertionLabel(args: Any) -> Any:
    let _ = args
    let selectedEntry: Any = none
    let commandLookup: Any = none
    if (!selectedEntry):
        return "at the root of this menu"
    if (selectedEntry.kind == "submenu"):
        return none + selectedEntry.title + none
    return none + resolveContextMenuEntryTitle(selectedEntry, commandLookup) + none

