type RgbColor = Any

fn parseCssColorToRgb(color: Any) -> Any:
    let trimmed = color.trim()
    if (!trimmed):
        return none
    if trimmed.startsWith("#"):
        let hex = trimmed.slice(1)
        if (hex.length == 3):
            return none
        if ((hex.length == 6) or (hex.length == 8)):
            return none
        return none
    let rgbMatch = trimmed.match_(none)
    if (!rgbMatch):
        return none
    let channels = rgbMatch[1].split(",").slice(0, 3).map(none)
    if ((channels.length < 3) or channels.some(none)):
        return none
    return none

fn getRelativeColorLuminance(color: RgbColor) -> Float:
    let normalize = none
    return ((((0.2126 * normalize(color.r)) + (0.7152 * normalize(color.g))) + (0.0722 * normalize(color.b))))

fn resolveSettingsFormColorScheme(backgroundColor: String, textColor: String) -> Any:
    let backgroundRgb = parseCssColorToRgb(backgroundColor)
    if backgroundRgb:
        return none
    let textRgb = parseCssColorToRgb(textColor)
    if textRgb:
        return none
    return "dark"

