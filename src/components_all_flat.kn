    return ts_Boolean(((findThemeBundleCatalogPack((args.activeThemeLocalPacks or []), trimmedId) or findThemeBundleCatalogEntry(args.entries, trimmedId)) or findEmbeddedThemeBundleManifestPack(args.embeddedPacks, trimmedId)))

