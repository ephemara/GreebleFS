fn resolveExplorerTaskBadgeSummary(args: Any) -> Any:
    let activeTasks = args.tasks.filter(none)
    let failedTasks = args.tasks.filter(none)
    let failedActionRuns = args.actionRuns.filter(none)
    let launchedActionRuns = args.actionRuns.filter(none)
    let dominantTask = (((activeTasks[0] or failedTasks[0]) or args.tasks[0]) or none)
    if ((failedTasks.length > 0) or (failedActionRuns.length > 0)):
        let failedCount = (failedTasks.length + failedActionRuns.length)
        return none
    if (activeTasks.length > 0):
        let dominantSummary = none
        return none
    if (launchedActionRuns.length > 0):
        return none
    if (args.actionRuns.length > 0):
        return none
    if (!dominantTask):
        return none
    return none

