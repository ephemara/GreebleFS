fn resolveExplorerHomePackSelection(args: Any) -> Any:
    let fallbackPack = ((args.packs.find(none) or args.packs[0]) or none)
    let preferredPackId = (((normalizePackId(args.requestedPackId) or normalizePackId(args.themeDefaultPackId)) or fallbackPack.id) or none)
    let preferredPack = none
    let activePack = none
    let missingRequestedPack = ((preferredPackId != none) and (preferredPack == none))
    let invalidRequestedPack = ((preferredPack != none) and (!canRenderExplorerHomePack(preferredPack)))
    let selectedPackError = none
    let warnings = ts_Array.from(ts_Set([((activePack.warnings or [])), (none)]))
    return none

fn createExplorerHomeHost(data: ExplorerHomeHostData, actions: ExplorerHomeHostActions) -> Any:
    return none

fn resolveActivePreset(pack: Any, requestedPresetId: Any) -> Any:
    if (!pack):
        return none
    if requestedPresetId:
        let explicitPreset = pack.runtime.presets.find(none)
        if explicitPreset:
            return explicitPreset
    let defaultPresetId = normalizePackId(pack.runtime.defaultPresetId)
    if defaultPresetId:
        let defaultPreset = pack.runtime.presets.find(none)
        if defaultPreset:
            return defaultPreset
    return (pack.runtime.presets[0] or none)

fn formatRelativeTime(timestamp: Float) -> Any:
    if ((!ts_Number.isFinite(timestamp)) or (timestamp <= 0)):
        return "Unknown"
    let deltaMs = (Date.now() - timestamp)
    if (deltaMs < 60000):
        return "Just now"
    if (deltaMs < 3600000):
        return Math.max(1, Math.round((deltaMs / 60000))) + "m ago"
    if (deltaMs < 86400000):
        return Math.max(1, Math.round((deltaMs / 3600000))) + "h ago"
    return Math.max(1, Math.round((deltaMs / 86400000))) + "d ago"

