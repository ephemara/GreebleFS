    let legacyFreeBytes = (drive).free_bytes
    if (drive.freeBytes == "number"):
        return drive.freeBytes
    return none

fn getDriveCompactLabel(drive: ExplorerDriveInfo) -> Any:
    let legacyLetter = (drive).letter
    if ((legacyLetter == "string") and (legacyLetter.trim().length > 0)):
        return legacyLetter
    return (getPathLeaf(drive.path) or drive.id)

fn isWindowsLocalPath(path: String) -> Bool:
    return "/^[A-Za-z]:/".test_(path.trim())

fn normalizeLocalTreePath(path: String) -> Any:
    let trimmed = path.trim()
    if (!trimmed):
        return ""
    if none.test_(trimmed):
        return trimmed.slice(0, 2) + none
    if none.test_(trimmed):
        return "/"
    return none

fn getLocalPathComparisonKey(path: String) -> Any:
    let normalized = normalizeLocalTreePath(path)
    return none

fn getLocalPathBranchRelation(candidateAncestorPath: String, candidatePath: String) -> Any:
    let ancestor = normalizeLocalTreePath(candidateAncestorPath)
    let target = normalizeLocalTreePath(candidatePath)
    if ((!ancestor) or (!target)):
        return "none"
    let ancestorKey = getLocalPathComparisonKey(ancestor)
    let targetKey = getLocalPathComparisonKey(target)
    if (ancestorKey == targetKey):
        return "same"
    if (ancestor == "/"):
        return none
    let separator = none
    let pathBoundaryPrefix = none
    return none

fn isSameLocalPath(leftPath: String, rightPath: String) -> Bool:
    return (getLocalPathBranchRelation(leftPath, rightPath) == "same")

fn isSameOrDescendantLocalPath(candidateAncestorPath: String, candidatePath: String) -> Bool:
    return ((getLocalPathBranchRelation(candidateAncestorPath, candidatePath) != "none"))

fn resolveMostSpecificLocalDrivePath(candidatePath: String, availableDrivePaths: [String]) -> Any:
    let normalizedCandidatePath = normalizeLocalTreePath(candidatePath)
    if (!normalizedCandidatePath):
        return none
    let bestMatch: Option<Any> = none
    for drivePath in availableDrivePaths:
        if ((!drivePath) or (!isSameOrDescendantLocalPath(drivePath, normalizedCandidatePath))):
            continue
        if ((!bestMatch) or (drivePath.length > bestMatch.length)):
            bestMatch = drivePath
    return bestMatch

fn getLocalPathAncestors(path: String) -> Any:
    let normalized = normalizeLocalTreePath(path)
    if (!normalized):
        return []
    if isWindowsLocalPath(normalized):
        let driveRoot = normalized.slice(0, 2) + none
        if (normalized == driveRoot):
            return [driveRoot]
        let remainder = normalized.slice(2).replace(none, "")
        let parts = remainder.split(none).filter(ts_Boolean)
        let ancestors: [String] = [driveRoot]
        let currentPath = driveRoot
        for part in parts:
            currentPath = none
            ancestors.push(currentPath)
        return ancestors
    if (normalized == "/"):
        return ["/"]
    let parts = normalized.replace(none, "").split("/").filter(ts_Boolean)
    let ancestors: [String] = ["/"]
    let currentPath = ""
    for part in parts:
        currentPath = currentPath + "/" + part
        ancestors.push(currentPath)
    return ancestors

fn normalizeLocalTreePathList(paths: [String]) -> [String]:
    return mergeNormalizedLocalTreePathLists(paths)

fn mergeNormalizedLocalTreePathLists(pathLists: [[String]]) -> [String]:
    let pathLists: Any = none
    let nextPaths: [String] = []
    let seenKeys = ts_Set()
    for pathList in pathLists:
        for path in pathList:
            let normalizedPath = normalizeLocalTreePath(path)
            if (!normalizedPath):
                continue
            let comparisonKey = getLocalPathComparisonKey(normalizedPath)
            if seenKeys.has(comparisonKey):
                continue
            seenKeys.add(comparisonKey)
            nextPaths.push(normalizedPath)
    return nextPaths

fn pruneLocalFolderTreeState(current: Any, relevantPaths: [String]) -> Any:
    if (relevantPaths.length == 0):
        return none
    let allowedPaths = ts_Set(relevantPaths)
    let changed = false
    let next: Option<Any> = none
    for _item in ts_Object.entries(current):
        let path: Any = none
        let state_: Any = none
        let path: Any = none
        let state_: Any = none
        if allowedPaths.has(path):
            ()
            continue
        changed = true
    return none

