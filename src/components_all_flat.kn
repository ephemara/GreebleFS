const SOFTWARE_RENDERER_PATTERNS: Any = ["/llvmpipe/i", "/softpipe/i", "/swrast/i", "/swiftshader/i", "/software/i", "/mesa offscreen/i"]

const cachedTerminalWebglSupport: Any = none

fn formatRendererLabel(vendor: Any, renderer: Any) -> Any:
    let vendorLabel = none
    let rendererLabel = none
    let combinedLabel = [vendorLabel, rendererLabel].filter(ts_Boolean).join(" ")
    return (combinedLabel or none)

fn isSoftwareRendererLabel(rendererLabel: Any) -> Bool:
    return ((rendererLabel != none) and SOFTWARE_RENDERER_PATTERNS.some(none))

