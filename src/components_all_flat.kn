impl PluginErrorBoundary:
    fn new_(_self: PluginErrorBoundary, props: Any) -> PluginErrorBoundary:
        super_(props)
        _self.state_ = none

    fn getDerivedStateFromError(error: Any) -> Any:
        return none

    fn componentDidUpdate(_self: PluginErrorBoundary, prevProps: Any):
        if ((prevProps.pluginName != _self.props.pluginName) and _self.state_.error):
            _self.setState(none)

    fn render(_self: PluginErrorBoundary) -> Any:
        if (!_self.state_.error):
            return _self.props.children
        return (none)


fn groupPluginsByCategory(plugins: [LoadedOverlayPlugin]) -> Any:
    let groups = ts_Map()
    let iter_12 = plugins
    let index_13 = 0
    while (index_13 < iter_12.length):
        let plugin = iter_12[index_13]
        let category = getPluginCategory(plugin)
        groups.set(category, [((groups.get(category) or [])), plugin])
        index_13 = (index_13 + 1)
    return [groups.entries()].sort(none).map(none)

fn resolvePreviewTestFile(plugin: Any, lane: Any) -> Any:
    if ((!plugin) or (!lane)):
        return none
    let normalizedExtensions = ts_Set(lane.match_.extensions.map(none))
    let testFiles = getPluginTestFiles(plugin)
    return ((testFiles.find(none) or testFiles[0]) or none)

