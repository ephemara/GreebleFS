    fn applyPreviewSize(nextSize: Float) -> Any:
        let paneElement = rootRef.current
        if (!paneElement):
            return none
        let widthPx = Math.round(nextSize) + "px"
        paneElement.style.width = widthPx
        paneElement.style.minWidth = widthPx
        paneElement.style.maxWidth = widthPx

    fn cancelPreviewFrame():
        if ((previewFrameRef.current != none) and (window != "undefined")):
            window.cancelAnimationFrame(previewFrameRef.current)
        previewFrameRef.current = none

    fn schedulePreviewFlush() -> Any:
        if ((previewFrameRef.current != none) or (window == "undefined")):
            return none
        previewFrameRef.current = window.requestAnimationFrame(none)

    fn __component_effect_0() -> Any:
        if (activeResizePointerIdRef.current != none):
            return none
        previewSizeRef.current = none
        applyPreviewSize(clampPanelSize(size, minSize, maxSize))

    fn __component_effect_1() -> Any:
        return none

    fn handleStyle() -> Any:
        return (none)

    render <div ref={rootRef} data_resizable_pane_root="true" style={none}>{children}<div data_resizable_pane_handle={handleSide} onPointerDown={none} style={handleStyle} onMouseEnter={none} onMouseLeave={none} /></div>

