fn areContextMenuPathsEqual(left: [String], right: [String]) -> Any:
    if (left.length != right.length):
        return false
    return left.every(none)

fn resolveContextMenuEntryAncestorSubmenuPath(entries: [ExplorerMenuLayoutEntry], entryId: Any) -> Any:
    if (!entryId):
        return []
    let entriesById = ts_Map(entries.map(none))
    let path: [String] = []
    let cursor = (entriesById.get(entryId) or none)
    while cursor:
        if (cursor.kind == "submenu"):
            path.unshift(cursor.id)
        cursor = none
    return path

fn resolveContextMenuEditorPanels(args: Any) -> Any:
    let _ = args
    let getBranchEntries: Any = none
    let openSubmenuPath: Any = none
    let rootEntries = getBranchEntries(none)
    let panels: [ContextMenuEditorPanelDescriptor] = [none]
    let resolvedPath: [String] = []
    let currentEntries = rootEntries
    let currentPath: [String] = []
    for submenuId in openSubmenuPath:
        let submenuEntry = currentEntries.find(none)
        if (!submenuEntry):
            break
        currentPath = [currentPath, submenuEntry.id]
        resolvedPath.push(submenuEntry.id)
        currentEntries = getBranchEntries(submenuEntry.id)
        panels.push(none)
    return none

