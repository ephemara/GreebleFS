    return none

fn getConstellationConnectionStrength(score: Float, route: Bool) -> Any:
    if (route or (score >= 1.2)):
        return "primary"
    if (score >= 0.78):
        return "bridge"
    return "secondary"

fn resolveClusterSlot(slots: Any, index: Float, bandCount: Float) -> Any:
    let direct = slots[index]
    if direct:
        return direct
    let progress = ((((index - slots.length) + 1)) / Math.max(1, bandCount))
    return none

