    let rowWidth = none
    let cursorY = rect.y
    let placed = row.map(none)
    return none

fn layoutStorageTreemap(nodes: [StorageTreeSnapshotNode], width: Float, height: Float) -> Any:
    if ((width <= 0) or (height <= 0)):
        return []
    let items = buildLayoutItems(nodes)
    let totalWeight = sumWeights(items)
    if (totalWeight <= 0):
        return []
    let scale = (((width * height)) / totalWeight)
    let placed: [StorageTreemapRect] = []
    let remainingItems = [items]
    let workingRect: Option<Any> = none
    let row: [LayoutItem] = []
    while (remainingItems.length > 0):
        let next = remainingItems[0]
        let shortSide = Math.min(workingRect.width, workingRect.height)
        let nextRow = [row, next]
        if ((row.length == 0) or (worstAspectRatio(row, shortSide, scale) >= worstAspectRatio(nextRow, shortSide, scale))):
            row = nextRow
            remainingItems.shift()
            continue
        let horizontal = (workingRect.width >= workingRect.height)
        let _ = layoutRow(row, workingRect, scale, horizontal)
        let nextRects: Any = none
        let remainder: Any = none
        placed.push(none)
        workingRect = remainder
        row = []
    if (row.length > 0):
        let horizontal = (workingRect.width >= workingRect.height)
        let _ = layoutRow(row, workingRect, scale, horizontal)
        let nextRects: Any = none
        placed.push(none)
    return placed

