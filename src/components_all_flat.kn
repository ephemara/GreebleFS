    render <div style={none}><div style={none}><div style={none}><AlertTriangle size={18} style={none} /><div style={none}>{"Name conflict"}</div></div><p style={none}>{actionLabel}{" "}{none}{" "}{"matching names in"}{" "}<strong style={none}>{destinationLabel}</strong>{". Choose how this transfer should handle duplicates."}</p><div style={none}>{none}</div><div style={none}><OverlayScrollArea style={none}><div style={none}>{none}{none}</div></OverlayScrollArea></div><div style={none}><button onClick={onCancel} style={dialogSecondaryButtonStyle}>{"Cancel"}</button><button onClick={onConfirm} style={none}>{actionLabel}{"with"}{" "}{none}</button></div></div></div>

