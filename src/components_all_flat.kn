type RgbColor = Any

fn parseCssColorToRgb(color: Any) -> Any:
    let trimmed = color.trim()
    if (!trimmed):
        return none
    if trimmed.startsWith("#"):
        let hex = trimmed.slice(1)
        if (hex.length == 3):
            return none
        if ((hex.length == 6) or (hex.length == 8)):
            return none
        return none
    let rgbMatch = trimmed.match_(none)
    if (!rgbMatch):
        return none
    let channels = rgbMatch[1].split(",").slice(0, 3).map(none)
    if ((channels.length < 3) or channels.some(none)):
        return none
    return none

fn getRelativeColorLuminance(color: RgbColor) -> Float:
    let normalize = none
    return ((((0.2126 * normalize(color.r))) + ((0.7152 * normalize(color.g)))) + ((0.0722 * normalize(color.b))))

fn resolveSelectColorScheme(backgroundColor: String, textColor: String) -> Any:
    let backgroundRgb = parseCssColorToRgb(backgroundColor)
    if backgroundRgb:
        return none
    let textRgb = parseCssColorToRgb(textColor)
    if textRgb:
        return none
    return "dark"

fn themedSelectStyle(options: Any) -> Any:
    return none

fn statusLabel(file: GitFileStatus) -> Any:
    if (file.kind == "added"):
        return "Added"
    if (file.kind == "deleted"):
        return "Deleted"
    if (file.kind == "renamed"):
        return "Renamed"
    if (file.kind == "copied"):
        return "Copied"
    if (file.kind == "untracked"):
        return "New"
    if (file.kind == "conflicted"):
        return "Conflict"
    return "Modified"

fn statusColor(file: GitFileStatus, palette: Any) -> Any:
    if (file.kind == "added"):
        return palette.green
    if ((file.kind == "deleted") or (file.kind == "conflicted")):
        return palette.red
    if ((file.kind == "renamed") or (file.kind == "copied")):
        return palette.accent
    if (file.kind == "untracked"):
        return palette.yellow
    return palette.yellow

fn canStageFile(file: GitFileStatus) -> Bool:
    return (file.isUntracked or file.hasUnstagedChanges)

fn stageActionLabel(file: GitFileStatus) -> Any:
    if (file.kind == "conflicted"):
        return "Mark Resolved"
    return "Stage"

fn canDiscardFile(file: GitFileStatus) -> Any:
    if (file.kind == "conflicted"):
        return false
    return (file.isUntracked or file.hasUnstagedChanges)

fn discardActionLabel(file: GitFileStatus) -> Any:
    if (file.isStaged and file.hasUnstagedChanges):
        return "Discard Working"
    return "Discard"

fn buildDiscardConfirmationMessage(file: GitFileStatus) -> Any:
    if file.isUntracked:
        return "Remove the untracked file " + file.file + "? This cannot be undone from GreebleFS."
    if (file.isStaged and file.hasUnstagedChanges):
        return "Discard only the unstaged changes in " + file.file + "? Staged changes will be kept."
    return "Discard the current working tree changes in " + file.file + "?"

fn buildConflictResolutionConfirmationMessage(file: GitFileStatus, side: ConflictResolutionSide) -> Any:
    let sideLabel = none
    let sideCode = none
    if (sideCode == "D"):
        return "Resolve the conflict in " + file.file + " by deleting the file with " + sideLabel + " version? GreebleFS will stage that resolution."
    return "Resolve the conflict in " + file.file + " with " + sideLabel + " version? GreebleFS will replace the working tree file and stage the result as resolved."

fn getGitTrackedPaths(file: GitFileStatus) -> [String]:
    return ts_Array.from(ts_Set([file.originalFile, file.file].filter(none).map(none)))

fn getGitIndexPaths(file: GitFileStatus) -> [String]:
    return ts_Array.from(ts_Set([file.file].filter(none).map(none)))

type ConflictResolutionSide = String

fn resolveConflictedFile(repoPath: String, file: GitFileStatus, side: ConflictResolutionSide, runGit: Any) -> Any:
    let sideCode = none
    let indexPaths = getGitIndexPaths(file)
    if (indexPaths.length == 0):
        ()
    if (sideCode == "D"):
        (await runGit(repoPath, ["rm", "--", indexPaths]))
        return none
    (await runGit(repoPath, ["checkout", "--" + side, "--", indexPaths]))
    (await runGit(repoPath, ["add", "--", indexPaths]))

fn discardTrackedFileChanges(repoPath: String, file: GitFileStatus, runGit: Any, safeGit: Any) -> Any:
    let trackedPaths = getGitTrackedPaths(file)
    if (!file.isStaged):
        (await runGit(repoPath, ["restore", "--worktree", "--source=HEAD", "--", trackedPaths]))
        return none
    let hasHead = ts_Boolean(((await safeGit(repoPath, ["rev-parse", "--verify", "HEAD"], ""))).trim())
    if hasHead:
        (await runGit(repoPath, ["restore", "--worktree", "--source=HEAD", "--", trackedPaths]))
        return none
    let indexPaths = getGitIndexPaths(file)
    if (indexPaths.length == 0):
        ()
    (await runGit(repoPath, ["checkout-index", "--force", "--", indexPaths]))

fn alpha(color: String, opacity: Float) -> String:
    return multiplyColorAlpha(color, opacity)

fn sanitizeRepositoryList(paths: [Any]) -> [String]:
    let unique = ts_Map()
    for value in paths:
        if (value != "string"):
            continue
        let normalized = normalizeRepositoryPath(value)
        if (!normalized):
            continue
        let comparablePath = getRepositoryComparablePath(normalized)
        if (!unique.has(comparablePath)):
            unique.set(comparablePath, normalized)
    return [unique.values()]

fn normalizeRepositoryPath(path: String) -> String:
    return path.trim().replace(none, "")

fn getRepositoryComparablePath(path: String) -> Any:
    let normalized = normalizeRepositoryPath(path).replace(none, "/")
    if (none.test_(normalized) or normalized.startsWith("//")):
        return normalized.toLowerCase()
    return normalized

fn repositoryPathListsEqual(left: [String], right: [String]) -> Any:
    if (left.length != right.length):
        return false
    return left.every(none)

