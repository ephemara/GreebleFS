    state cursorListenerRef: Any = useRef(none)
    state monacoThemeId: Any = resolveExplorerMonacoThemeId(appearance)
    fn publishCursorPosition(editor: Any) -> Any:
        let position = editor.getPosition()
        if (!position):
            return none
        onCursorPositionChange(none)

    fn handleMount(editor: Any, monaco: Any):
        editorRef.current = editor
        monacoRef.current = monaco
        applyExplorerMonacoTheme(monaco, appearance)
        cursorListenerRef.current.dispose()
        cursorListenerRef.current = (editor.onDidChangeCursorPosition(none) or none)
        publishCursorPosition(editor)
        window.requestAnimationFrame(none)

    fn handleBeforeMount(monaco: Any):
        applyExplorerMonacoTheme(monaco, appearance)

    fn __component_effect_0() -> Any:
        if ((!editorRef.current) or (!monacoRef.current)):
            return none
        applyExplorerMonacoTheme(monacoRef.current, appearance)
        let frame = window.requestAnimationFrame(none)
        return none

    fn __component_effect_1() -> Any:
        if (!editorRef.current):
            return none
        publishCursorPosition(editorRef.current)

    fn __component_effect_2() -> Any:
        return none

    render <Suspense fallback={none}><LazyMonacoEditor path={path} height="100%" language={(language or "plaintext")} value={value} theme={monacoThemeId} beforeMount={handleBeforeMount} onMount={handleMount} saveViewState={true} onChange={none} options={options} /></Suspense>

