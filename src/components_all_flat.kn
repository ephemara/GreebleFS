                index_7 = (index_7 + 1)
        let chipAlign = none
        let chipX = clampNumber((centerX + ((radius * slot.chipBiasX))), FIELD_BOUNDS.paddingX, (width - FIELD_BOUNDS.paddingX))
        let chipY = clampNumber((centerY - ((radius * (none)))), FIELD_BOUNDS.paddingY, (height - FIELD_BOUNDS.paddingY))
        fieldBands.push(none)
        index_9 = (index_9 + 1)
    if (!dominantPrimaryNode):
