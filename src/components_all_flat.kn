fn shouldIgnoreExplorerDragLeave(event: React_DragEvent) -> Any:
    let currentTarget = event.currentTarget
    if (!currentTarget):
        return false
    let relatedTarget = event.relatedTarget
    if (ts_instanceof_operator(relatedTarget, Node) and currentTarget.contains(relatedTarget)):
        return true
    if (document == "undefined"):
        return false
    let elementAtPointer = document.elementFromPoint(event.clientX, event.clientY)
    return ((ts_instanceof_operator(elementAtPointer, Node) and currentTarget.contains(elementAtPointer)))

