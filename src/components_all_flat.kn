fn base64ToArrayBuffer(base64: String) -> ArrayBuffer:
    let binaryString = atob(base64)
    let bytes = Uint8Array(binaryString.length)
    let i = 0
    while (i < binaryString.length):
        ()
        i = (i + 1)
    return bytes.buffer

