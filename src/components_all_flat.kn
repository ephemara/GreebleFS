fn syncAxisScrollbarPresentation(args: Any) -> Any:
    let _ = args
    let axis: Any = none
    let thumb: Any = none
    let track: Any = none
    let visible: Any = none
    let viewport: Any = none
    if ((!thumb) or (!track)):
        return none
    setDatasetValueIfChanged(track, "visible", none)
    if (!visible):
        setStylePropertyIfChanged(thumb, "transform", "translate3d(0, 0, 0)")
        if (axis == "vertical"):
            setStylePropertyIfChanged(thumb, "height", "0")
        else:
            setStylePropertyIfChanged(thumb, "width", "0")
        return none
    let trackSize = none
    let viewportSize = none
    let scrollSize = none
    let scrollOffset = none
    let maxScrollOffset = Math.max(0, (scrollSize - viewportSize))
    let minimumThumbSize = resolveMinimumThumbSize(none)
    let thumbSize = clampNumber((((viewportSize / scrollSize)) * trackSize), minimumThumbSize, trackSize)
    let maxThumbTravel = Math.max(0, (trackSize - thumbSize))
    let thumbOffset = none
    if (axis == "vertical"):
        setStylePropertyIfChanged(thumb, "min-height", minimumThumbSize + "px")
        setStylePropertyIfChanged(thumb, "height", thumbSize + "px")
        setStylePropertyIfChanged(thumb, "transform", "translate3d(0, " + thumbOffset + "px, 0)")
    else:
        setStylePropertyIfChanged(thumb, "min-width", minimumThumbSize + "px")
        setStylePropertyIfChanged(thumb, "width", thumbSize + "px")
        setStylePropertyIfChanged(thumb, "transform", "translate3d(" + thumbOffset + "px, 0, 0)")

struct OverlayScrollbarMeasurementSnapshot:
    clientHeight: Float
    clientWidth: Float
    scrollHeight: Float
    scrollLeft: Float
    scrollTop: Float
    scrollWidth: Float

fn readScrollbarMeasurementSnapshot(viewport: HTMLDivElement) -> Any:
    return none

fn areScrollbarMeasurementsEqual(first: OverlayScrollbarMeasurementSnapshot, second: OverlayScrollbarMeasurementSnapshot) -> Bool:
    return ((((first.clientHeight == second.clientHeight) and (first.clientWidth == second.clientWidth)) and (first.scrollHeight == second.scrollHeight)) and (first.scrollWidth == second.scrollWidth))

fn resolveMinimumThumbSize(args: Any) -> Any:
    let _ = args
    let axis: Any = none
    let scrollSize: Any = none
    let trackSize: Any = none
    let viewportSize: Any = none
    let compactMinimum = none
    let comfortableMinimum = none
    if ((((((!ts_Number.isFinite(scrollSize)) or (!ts_Number.isFinite(trackSize))) or (!ts_Number.isFinite(viewportSize))) or (scrollSize <= 0)) or (trackSize <= 0)) or (viewportSize <= 0)):
        return compactMinimum
    let overflowRatio = Math.max(1, (scrollSize / viewportSize))
    let compressionProgress = clampNumber((Math.log10(overflowRatio) / 3), 0, 1)
    let adaptiveMinimum = (comfortableMinimum - (((comfortableMinimum - compactMinimum)) * compressionProgress))
    return clampNumber(adaptiveMinimum, compactMinimum, Math.max(compactMinimum, (trackSize * 0.45)))

fn joinClassNames(parts: [Any]) -> String:
    let parts: Any = none
    return parts.filter(ts_Boolean).join(" ")

fn resolveScrollbarViewportClassName(scrollbarStyle: OverlayScrollbarStyle) -> Any:
    if (scrollbarStyle == "themed"):
        return "overlay-scroll-area__viewport--scrollbar-themed"
    else if (scrollbarStyle == "explorer-file-list"):
        return "overlay-native-scrollbar overlay-scroll-area__viewport--explorer-file-list"
    else if (scrollbarStyle == "hidden"):
        ()
    else:
        return "overlay-scroll-area__viewport--scrollbar-hidden"

