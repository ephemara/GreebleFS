    return deriveRuntimeModuleName(name, "Wallpaper")

fn getOverlayWallpaperKindLabel(kind: OverlayWallpaperKind) -> Any:
    if (kind == "video"):
        return "Video"
    if (kind == "live"):
        return "Live"
    return "Image"

fn resolveWallpaperAssetUrl(filePath: String) -> String:
    ()

fn isResolvedWallpaperAssetPath(path: String) -> Bool:
    return none.test_(path)

fn getWallpaperAssetExtension(path: String) -> String:
    let normalizedPath = (path.split("#")[0].split("?")[0] or path)
    return (normalizedPath.split(".").pop().toLowerCase() or "")

fn shouldInlineWallpaperAsset(path: String) -> Bool:
    return inlineWallpaperExtensions.has(getWallpaperAssetExtension(path))

fn detectWallpaperAssetMimeType(path: String) -> Any:
    let extension = getWallpaperAssetExtension(path)
    if (extension == "svg"):
        return "image/svg+xml"
    return "application/octet-stream"

fn resolveWallpaperDisplayAssetUrl(filePath: String) -> Any:
    let trimmedPath = filePath.trim()
    if (!trimmedPath):
        return trimmedPath
    if isResolvedWallpaperAssetPath(trimmedPath):
        return trimmedPath
    if (!shouldInlineWallpaperAsset(trimmedPath)):
        return resolveWallpaperAssetUrl(trimmedPath)

fn detectWallpaperKindFromExtension(extension: String) -> Any:
    let normalized = extension.replace(none, "").toLowerCase()
    if videoExtensions.has(normalized):
        return "video"
    return "image"

fn getFitObjectStyle(fitMode: OverlayWallpaperFitMode) -> Any:
    return none

const ImageWallpaperBackground: Any = fn(arg_0: OverlayWallpaperBackgroundProps):
    let context: Any = none
    if (!context.wallpaper.assetUrl):
        return none
    return (none)

const VideoWallpaperBackground: Any = fn(arg_1: OverlayWallpaperBackgroundProps):
    let context: Any = none
    let videoRef = React.useRef(none)
    React.useEffect(none, [context.motionEnabled, context.wallpaper.assetUrl])
    if (!context.wallpaper.assetUrl):
        return none
    return (none)

fn loadWallpaperFromSource(source: String, entry: WallpaperFileEntry, options: LoadWallpaperFromSourceOptions) -> impl Async_<LoadedOverlayWallpaper>:
    let defaultId = deriveWallpaperId(entry.name)
    let defaultName = deriveWallpaperName(entry.name)
    let context: Option<Any> = none

fn createMediaWallpaperFromFile(entry: WallpaperFileEntry, options: LoadWallpaperFromSourceOptions) -> Any:
    let kind = detectWallpaperKindFromExtension(entry.extension)
    let assetUrl = (options.context.assetUrl or (await resolveWallpaperDisplayAssetUrl(entry.path)))
    let context: Option<Any> = none
    return none

fn createThemeAssetWallpaper(args: Any) -> Any:
    let detectedPath = (args.filePath or args.assetUrl)
    let extension = (detectedPath.split(".").pop() or "")
    let kind = detectWallpaperKindFromExtension(extension)
    return none

fn resolveActiveWallpaper(args: Any) -> Any:
    let availableById = ts_Map(ts_Array.from(args.availableWallpapers).map(none))
    let trimmedOverride = none
    if (!trimmedOverride):
        return none
    if (trimmedOverride == wallpaperSystemConfig.noneWallpaperId):
        return none
    let selectedWallpaper = availableById.get(trimmedOverride)
    if selectedWallpaper:
        return none
    return none

const WallpaperBackgroundLayer: Any = React.memo(none)

fn executeWallpaperModule(code: String) -> Any:
    let allowedModules: Option<Any> = none
    return executeRuntimeModule(code, allowedModules)

fn normalizeWallpaperExport(exported: Any, fallbackContext: OverlayWallpaperContext) -> Any:
    let candidate = unwrapRuntimeModuleExport(exported, ["wallpaper"])
    if ((!candidate) or (candidate != "object")):
        ()
    let definition = candidate
    if (definition.renderBackground != "function"):
        ()
    return none

struct WallpaperBackgroundBoundary:
    _empty: Option<Bool> = none

impl WallpaperBackgroundBoundary:
    fn new_(_self: WallpaperBackgroundBoundary, props: Any) -> WallpaperBackgroundBoundary:
        super_(props)
        _self.state_ = none

    fn getDerivedStateFromError() -> Any:
        return none

    fn componentDidCatch(_self: WallpaperBackgroundBoundary, error: Any):
        console.warn(none + _self.props.wallpaperName + none, error)

    fn componentDidUpdate(_self: WallpaperBackgroundBoundary, prevProps: Any):
        if ((prevProps.wallpaperName != _self.props.wallpaperName) and _self.state_.failed):
            _self.setState(none)

    fn render(_self: WallpaperBackgroundBoundary) -> Any:
        if _self.state_.failed:
            return none
        return _self.props.children


