const loadedFonts: Any = ts_Set()

fn ensureFont(font: String) -> Any:
    let name = font.split(",")[0].trim().replace(none, "")
    if loadedFonts.has(name):
        return none
    loadedFonts.add(name)
    let safeName = encodeURIComponent(name)
    let link = document.createElement("link")
    link.rel = "stylesheet"
    link.href = "https://fonts.googleapis.com/css2?family=" + safeName + ":wght@400;500;600;700&display=swap"
    document.head.appendChild(link)

