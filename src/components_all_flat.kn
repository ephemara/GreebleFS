fn ExplorerHomeSurface(arg_0: ExplorerHomeSurfaceProps) -> Any:
    let appearance: Any = none
    let packs: Any = none
    let requestedPackId: Any = none
    let themeDefaultPackId: Any = none
    let activePresetIdByPackId: Any = none
    let usageTrackingEnabled: Any = none
    let quickAccess: Any = none
    let bookmarks: Any = none
    let mostUsedFolders: Any = none
    let recentFolders: Any = none
    let savedSearches: Any = none
    let drives: Any = none
    let tasks: Any = none
    let launchpad: Any = none
    let packState: Any = none
    let onNavigate: Any = none
    let onOpenSavedSearch: Any = none
    let onOpenPanel: Any = none
    let onOpenSettingsSection: Any = none
    let onRefresh: Any = none
    let onUpdatePackState: Any = none
    let onSetPreset: Any = none
    let selection = useMemo(none, [packs, requestedPackId, themeDefaultPackId])
    let activePack = selection.activePack
    let activePresetId = none
    let host = useMemo(none, [activePack, activePresetId, activePresetIdByPackId, appearance, bookmarks, drives, launchpad, mostUsedFolders, onNavigate, onOpenPanel, onOpenSavedSearch, onOpenSettingsSection, onRefresh, onSetPreset, onUpdatePackState, packState, quickAccess, recentFolders, savedSearches, selection.authoredPackCount, selection.isFallback, selection.selectedPackError, selection.warnings, tasks, usageTrackingEnabled])
    if ((!activePack) or (!host)):
        return renderFallbackSurface("No Home packs are currently available. Open Settings -> Home to inspect the runtime catalog.")
    let packContext: ExplorerHomePackContext = activePack.runtime
    let fallback = (none)
    if (!activePack.runtime.component_):
        return fallback
    return (none)

