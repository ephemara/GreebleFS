fn compareStorageEntries(left: StorageScanEntry, right: StorageScanEntry, key: Any, rootAllocatedBytes: Float) -> Any:
    if (key == "name"):
        return left.name.localeCompare(right.name)
    else if (key == "logicalBytes"):
        return (left.logicalBytes - right.logicalBytes)
    else if (key == "wasteBytes"):
        return (left.wasteBytes - right.wasteBytes)
    else if (key == "subtreeShare"):
        return (left.allocatedBytes - right.allocatedBytes)
    else if (key == "rootShare"):
        return (resolveRootShare(left.allocatedBytes, rootAllocatedBytes) - resolveRootShare(right.allocatedBytes, rootAllocatedBytes))
    else if (key == "fileCount"):
        return (left.fileCount - right.fileCount)
    else if (key == "directoryCount"):
        return (left.directoryCount - right.directoryCount)
    else if (key == "allocatedBytes"):
        ()
    else:
        return (left.allocatedBytes - right.allocatedBytes)

