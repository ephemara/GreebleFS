component MiniAdder(ph1: Any, ph2: Any, accent: Any, onConfirm: Any, onCancel: Any) with Reactive:
    state n: Any = ""
    state v: Any = ""
    fn setN(value: Any):
        n = value

    fn setV(value: Any):
        v = value

    fn onKey(e: ReactKeyboardEvent):
        if (((e.key == "Enter") and n.trim()) and v.trim()):
            onConfirm(n.trim(), v.trim())
        if (e.key == "Escape"):
            onCancel()

    render <div className="mx-1 my-1 rounded border p-2 flex flex-col gap-1.5" style={none}><input autoFocus={true} value={n} onChange={none} onKeyDown={onKey} placeholder={ph1} className="w-full bg-transparent text-[11px] text-white outline-none placeholder:opacity-30 border-b border-white/10 pb-1" /><input value={v} onChange={none} onKeyDown={onKey} placeholder={ph2} className="w-full bg-transparent text-[10px] text-white/60 font-mono outline-none placeholder:opacity-30" /><div className="flex justify-end gap-1 pt-0.5"><button onClick={onCancel} className="text-[9px] opacity-40 hover:opacity-75 px-1.5 py-0.5 rounded transition-colors">{"Cancel"}</button><button onClick={none} disabled={((!n.trim()) or (!v.trim()))} style={none} className="text-[9px] px-1.5 py-0.5 rounded disabled:opacity-30 hover:opacity-90 transition-all">{"Add"}</button></div></div>

