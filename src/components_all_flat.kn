fn normalizePreviewAction(action: Any) -> Any:
    let title = action.title.trim()
    if ((!title) or (action.onSelect != "function")):
        return none
    let fallbackOrder = none
    let defaultOrder = none
    let priority = none
    return none

fn resolveExplorerPreviewContextMenuActions(registration: Any, workflowTabId: Any) -> Any:
    if (!registration):
        return []
    let baseActions = registration.baseActions.map(none).filter(none)
    if (!workflowTabId):
        return baseActions
    let overlay = registration.workflowOverlays.find(none)
    if (!overlay):
        return baseActions
    let actionsById = ts_Map(baseActions.map(none))
    let orderedIds = baseActions.map(none)
    for override_ in overlay.actions:
        if override_.hidden:
            actionsById.delete_(override_.id)
            continue
        let existingAction = actionsById.get(override_.id)
        let nextAction = normalizePreviewAction(none)
        if (!nextAction):
            continue
        actionsById.set(override_.id, nextAction)
        if (!orderedIds.includes(override_.id)):
            orderedIds.push(override_.id)
    return orderedIds.map(none).filter(none)

