fn buildStandaloneTextRenderKind(extension: String) -> Any:
    let normalizedExtension = extension.trim().toLowerCase()
    if ((normalizedExtension == "md") or (normalizedExtension == "markdown")):
        return "markdown"
    if ((normalizedExtension == "html") or (normalizedExtension == "htm")):
        return "html"
    return "none"

