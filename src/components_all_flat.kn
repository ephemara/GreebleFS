fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(Math.max(value, min), max)

fn createHiddenRegion() -> Any:
    return none

fn shrinkWidths(widths: Any, overflow: Float) -> Any:
    let remainingOverflow = overflow
    let launcher = widths.launcher
    let pinnedLeft = widths.pinnedLeft
    let pinnedRight = widths.pinnedRight
    if ((launcher > 0) and (remainingOverflow > 0)):
        let nextLauncher = Math.max(220, (launcher - remainingOverflow))
        remainingOverflow = (remainingOverflow - (launcher - nextLauncher))
        launcher = nextLauncher
    if ((pinnedRight > 0) and (remainingOverflow > 0)):
        let nextPinnedRight = Math.max(180, (pinnedRight - remainingOverflow))
        remainingOverflow = (remainingOverflow - (pinnedRight - nextPinnedRight))
        pinnedRight = nextPinnedRight
    if ((pinnedLeft > 0) and (remainingOverflow > 0)):
        let nextPinnedLeft = Math.max(180, (pinnedLeft - remainingOverflow))
        remainingOverflow = (remainingOverflow - (pinnedLeft - nextPinnedLeft))
        pinnedLeft = nextPinnedLeft
    if ((remainingOverflow > 0) and (launcher > 0)):
        launcher = Math.max(0, (launcher - remainingOverflow))
    return none

fn normalizeThemeRendererShellLayout(args: NormalizeThemeRendererShellLayoutArgs) -> Any:
    let viewportWidth = Math.max(360, Math.round(args.viewportWidth))
    let viewportHeight = Math.max(240, Math.round(args.viewportHeight))
    let shellInset = clamp(Math.round(args.shellInset), 0, Math.max(12, Math.floor((Math.min(viewportWidth, viewportHeight) * 0.08))))
    let panelGap = clamp(Math.round(args.panelGap), 0, 32)
    let contentInnerPadding = clamp(Math.round(args.contentInnerPadding), 0, 40)
    let chromeHeight = clamp(Math.round(args.chromeHeight), 32, Math.min(96, Math.floor((viewportHeight * 0.2))))
    let horizontalBudget = (viewportWidth - (shellInset * 2))
    let verticalBudget = (viewportHeight - (shellInset * 2))
    let minContentWidth = clamp(Math.floor((horizontalBudget * 0.48)), 280, 720)
    let minContentHeight = clamp(Math.floor((verticalBudget * 0.42)), 220, 560)
    let launcherWidth = none
    let pinnedLeftWidth = none
    let pinnedRightWidth = none
    let sectionCount = [(pinnedLeftWidth > 0), (launcherWidth > 0), true, (pinnedRightWidth > 0)].filter(ts_Boolean).length
    let gapBudget = (Math.max(0, (sectionCount - 1)) * panelGap)
    let requestedContentWidth = ((((horizontalBudget - pinnedLeftWidth) - pinnedRightWidth) - launcherWidth) - gapBudget)
    if (requestedContentWidth < minContentWidth):
        let shrunk = shrinkWidths(none, (minContentWidth - requestedContentWidth))
        launcherWidth = shrunk.launcher
        pinnedLeftWidth = shrunk.pinnedLeft
        pinnedRightWidth = shrunk.pinnedRight
    let contentHeightBeforeClamp = ((verticalBudget - chromeHeight) - panelGap)
    let resolvedChromeHeight = none
    let contentHeight = Math.max(220, ((verticalBudget - resolvedChromeHeight) - panelGap))
    let nextX = shellInset
    let pinnedLeft = none
    if pinnedLeft.visible:
        nextX = (nextX + (pinnedLeft.width + panelGap))
    let launcher = none
    if launcher.visible:
        nextX = (nextX + (launcher.width + panelGap))
    let rightReservedWidth = none
    let content = none
    let pinnedRight = none
    return none

