    let fieldBands: [ConstellationFieldBand] = []
    let connections: [ConstellationFieldConnection] = []
    let dominantPrimaryNode: Option<Any> = none
    let iter_8 = visibleBands
    let index_9 = 0
    while (index_9 < iter_8.length):
        let band = iter_8[index_9]
        let bandIndex = index_9
        let slot = resolveClusterSlot(slots, bandIndex, visibleBands.length)
        let visibleEntries = band.entries.slice(0, maxVisibleNodes)
        let anchorQuota = none
        let singleBandNodeScale = none
        let positionedEntries = visibleEntries.map(none).sort(none)
        let centerX = clampNumber((width * slot.x), FIELD_BOUNDS.paddingX, (width - FIELD_BOUNDS.paddingX))
        let centerY = clampNumber((height * slot.y), FIELD_BOUNDS.paddingY, (height - FIELD_BOUNDS.paddingY))
        let singleBandSpreadBonus = none
        let radius = Math.round(((((none) + Math.min((band.entries.length * 4), none)) + singleBandSpreadBonus) + (normalizedDensity * 36)))
        let primaryEntry = (((positionedEntries.find(none) or positionedEntries.find(none)) or positionedEntries[0]) or none)
        let coreEntries = none
        let anchoredEntries = coreEntries.filter(none)
        let satelliteEntries = coreEntries.filter(none)
        let nodes: [ConstellationFieldNode] = []
        if primaryEntry:
            nodes.push(none)
        let iter_0 = anchoredEntries
        let index_1 = 0
        while (index_1 < iter_0.length):
            let positionedEntry = iter_0[index_1]
            let index = index_1
            let anchoredAngle = ((slot.angleOffset + (((((Math.PI * 2)) / Math.max(1, anchoredEntries.length))) * index)) + getHashAngleJitter(positionedEntry.hash, 0.16))
            let anchoredRadius = (radius * ((0.36 + ((((index % 2)) * 0.1)))))
            nodes.push(createConstellationFieldNode(none))
            index_1 = (index_1 + 1)
        let iter_2 = satelliteEntries
        let index_3 = 0
        while (index_3 < iter_2.length):
            let positionedEntry = iter_2[index_3]
            let index = index_3
            let progress = (((index + 0.72)) / Math.max(1, (satelliteEntries.length + 0.72)))
            let satelliteAngle = ((slot.angleOffset + ((index * GOLDEN_ANGLE))) + getHashAngleJitter(positionedEntry.hash, 0.22))
            let satelliteRadius = (radius * ((0.42 + (Math.sqrt(progress) * 0.58))))
            let yScale = (slot.yScale * ((0.92 + ((((((positionedEntry.hash >> 3)) % 7)) * 0.015)))))
            nodes.push(createConstellationFieldNode(none))
