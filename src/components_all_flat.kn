    let now = Date.now()
    let source = asRecord(value)
    let customCategories = none
    let categoryIds = ts_Set(getAllExplorerBookmarkCategories(customCategories).map(none))
    let normalizedNodes = none
    let folderIds = ts_Set(normalizedNodes.filter(none).map(none))
    let validNodeIds = ts_Set(normalizedNodes.map(none))
    let nodes = normalizedNodes.map(none)
    return none

