    if ((parentAllocatedBytes == none) or (parentAllocatedBytes <= 0)):
        return 100
    if ((!ts_Number.isFinite(allocatedBytes)) or (allocatedBytes <= 0)):
        return 0
    return (((allocatedBytes / parentAllocatedBytes)) * 100)

fn resolveRootShare(allocatedBytes: Float, rootAllocatedBytes: Float) -> Any:
    if (((!ts_Number.isFinite(allocatedBytes)) or (!ts_Number.isFinite(rootAllocatedBytes))) or (rootAllocatedBytes <= 0)):
