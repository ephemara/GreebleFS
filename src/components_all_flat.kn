        return CONSTELLATION_CAMERA_ZOOM_RANGE.default_
    let safeWidth = Math.max(1, (metrics.viewportWidth - ((CONSTELLATION_CAMERA_FIT_PADDING * 2))))
    let safeHeight = Math.max(1, (metrics.viewportHeight - ((CONSTELLATION_CAMERA_FIT_PADDING * 2))))
    return clampConstellationZoom(Math.min((safeWidth / layout.width), (safeHeight / layout.height)))

fn clampConstellationCameraPan(nextPan: Any, metrics: ConstellationViewportMetrics, layout: ConstellationFieldLayout, zoom: Float) -> Any:
    let _ = getConstellationScaledWorldSize(layout, zoom)
    let width: Any = none
    let height: Any = none
    let x = none
    let y = none
    return none

fn createConstellationFitCamera(layout: ConstellationFieldLayout, metrics: ConstellationViewportMetrics) -> Any:
    let zoom = getConstellationFitZoom(layout, metrics)
    let pan = clampConstellationCameraPan(none, metrics, layout, zoom)
    return none

fn centerConstellationCameraOnNode(layout: ConstellationFieldLayout, node: ConstellationFieldNode, metrics: ConstellationViewportMetrics, zoom: Float) -> Any:
    let normalizedZoom = clampConstellationZoom(zoom)
    let pan = clampConstellationCameraPan(none, metrics, layout, normalizedZoom)
    return none

fn zoomConstellationCameraAtViewportPoint(camera: ConstellationCameraState, targetZoom: Float, focalPoint: ConstellationViewportPoint, metrics: ConstellationViewportMetrics, layout: ConstellationFieldLayout) -> Any:
    let normalizedNextZoom = clampConstellationZoom(targetZoom)
    let worldX = (((focalPoint.x - camera.x)) / Math.max(camera.zoom, 0.001))
    let worldY = (((focalPoint.y - camera.y)) / Math.max(camera.zoom, 0.001))
    let pan = clampConstellationCameraPan(none, metrics, layout, normalizedNextZoom)
    return none

fn getConstellationWheelZoom(currentZoom: Float, deltaY: Float) -> Float:
    return clampConstellationZoom((currentZoom * Math.exp((((-deltaY)) * 0.0012))))

