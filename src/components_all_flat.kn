fn defineAnimation(definition: OverlayAnimationDefinition) -> OverlayAnimationDefinition:
    return definition

fn clamp01(value: Float) -> Float:
    return Math.min(Math.max(value, 0), 1)

fn lerp(from: Float, to: Float, progress: Float) -> Float:
    return (from + ((((to - from)) * clamp01(progress))))

fn useAnimationContextRef(value: T) -> React_MutableRefObject<T>:
    let ref = React.useRef(value)
    ref.current = value
    return ref

fn isFrontendAnimationFile(entry: AnimationFileEntry) -> Bool:
    return isSupportedRuntimeFile(entry, animationSystemConfig.frontendExtensions)

fn deriveAnimationId(name: String) -> String:
    return deriveRuntimeModuleId(name, "animation")

fn deriveAnimationName(name: String) -> String:
    return deriveRuntimeModuleName(name, "Animation")

fn loadAnimationFromSource(source: String, entry: AnimationFileEntry, options: LoadAnimationFromSourceOptions) -> impl Async_<LoadedOverlayAnimation>:
    let defaultId = deriveAnimationId(entry.name)
    let defaultName = deriveAnimationName(entry.name)
    let context: Option<Any> = none

