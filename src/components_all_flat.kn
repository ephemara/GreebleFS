component WorkbenchIdeShell(appearance: Any, surfaces: Any, surfaceSeeds: Any, layoutState: Any, onLayoutStateChange: Any, onRequestFocusSurface: Any, onRequestExternalizeSurface: Any, renderSurfaceBody: Any) with Reactive:
    state theme: Any = appearance.theme
    state workbench: Any = appearance.workbenchTheme
    state dockPaneTone: ExplorerPaneTone = none
    state draggedSurfaceTabId: Any = none
    state railPlacementStyle: Any = none
    state dockPlacementStyle: Any = none
    state railActiveSurfaceId: Any = ((layoutState.focusedSurfaceId or explorerSurface.id) or none)
    fn surfaceById() -> Any:
        return ts_Map(surfaces.map(none))

    fn explorerSurface() -> Any:
        return (surfaces.find(none) or none)

    fn primaryRailSurfaces() -> Any:
        return surfaces.filter(none)

    fn secondaryRailSurfaces() -> Any:
        return surfaces.filter(none)

    fn setDraggedSurfaceTabId(value: Any):
        draggedSurfaceTabId = value

    fn commitLayoutState(nextState: IdeWorkbenchLayoutState):
        onLayoutStateChange(nextState)

    fn handleFocusSurface(surfaceId: String) -> Any:
        if (onRequestFocusSurface(surfaceId) == true):
            return none
        commitLayoutState(focusDockSurface(layoutState, surfaceId, surfaceSeeds))

    fn handleMoveSurface(surfaceId: String, placement: DockPlacement) -> Any:
        if (placement == "floating"):
            commitLayoutState(floatDockSurface(layoutState, surfaceId))
            return none
        commitLayoutState(moveSurfaceToDockPlacement(layoutState, surfaceId, placement))

    fn handleHideSurface(surfaceId: String):
        commitLayoutState(hideDockSurface(layoutState, surfaceId))

    fn handleToggleStackCollapsed(stackId: String):
        commitLayoutState(toggleDockStackCollapsed(layoutState, stackId))

    fn handleToggleStackMaximized(stackId: String):
        commitLayoutState(toggleDockMaximize(layoutState, stackId))

    fn handleSurfaceTabDragStart(event: DragEvent<HTMLButtonElement>, surfaceId: String):
        setDraggedSurfaceTabId(surfaceId)
        event.dataTransfer.effectAllowed = "move"
        event.dataTransfer.setData("text/plain", surfaceId)

    fn handleSurfaceTabDrop(event: DragEvent<HTMLButtonElement>, targetSurfaceId: String):
        event.preventDefault()
        let draggedSurfaceId = (event.dataTransfer.getData("text/plain") or draggedSurfaceTabId)
        if (draggedSurfaceId and (draggedSurfaceId != targetSurfaceId)):
            commitLayoutState(reorderDockSurfaceTabs(layoutState, draggedSurfaceId, targetSurfaceId))
        setDraggedSurfaceTabId(none)

    fn renderStackSurfaceActions(stack: DockStackNode, activeSurfaceId: String) -> Any:
        let activeSurface = (surfaceById.get(activeSurfaceId) or none)
        let actions: [Any] = [none, none, none]
        let canExternalizeSurface = ts_Boolean(((activeSurface and (activeSurface.id != explorerSurface.id)) and activeSurface.allowedPresentations.includes("native-window")))
        return (none)

    fn renderCollapsedStack(stack: DockStackNode) -> Any:
        let direction = none
        return (none)

    fn renderDockStack(stack: DockStackNode) -> Any:
        let surfacesInStack = stack.tabs.map(none).filter(none)
        let activeSurfaceId = none
        let activeSurface = none
        let centerExplorerSurfaceId = (explorerSurface.id or "explorer")
        let rendersExplorerCenter = ((stack.id == IDE_WORKBENCH_STACK_IDS.center) and (explorerSurface != none))
        if stack.collapsed:
            return renderCollapsedStack(stack)
        if rendersExplorerCenter:
            let explorerIsActive = (((layoutState.focusedSurfaceId or centerExplorerSurfaceId)) == centerExplorerSurfaceId)
            return (none)
        return (none)

    fn renderDockNode(node: DockNode) -> Any:
        let maximizedNodeId = layoutState.maximizedNodeId
        if maximizedNodeId:
            if (node.type_ == "stack"):
                if (node.id != maximizedNodeId):
                    return none
            else if (!dockNodeContainsStackId(node, maximizedNodeId)):
                return none
        if (node.type_ == "stack"):
            return renderDockStack(node)
        let visibleChildren = none
        let isHorizontal = (node.orientation == "horizontal")
        let renderedChildren = visibleChildren.map(none).filter(none)
        return (none)

    fn renderFloatingWindow(floatingNode: FloatingDockNode) -> Any:
        let activeSurfaceId = none
        let activeSurface = none
        return (none)

    render <div style={none}><div style={none}><div style={none}><DockActionButton title={none} onClick={none}>{none}</DockActionButton></div><div style={none}><div style={none}>{none}</div><div style={none} />{none}<div style={none}>{none}</div></div></div><div style={none}>{renderDockNode(layoutState.rootDockNode)}{layoutState.floatingNodes.map(renderFloatingWindow)}</div></div>

