const BATCH_RENAME_PARENT_TOKEN_PATTERN: Any = none

fn buildExplorerBatchRenamePreview(entries: [ExplorerFileEntry], recipe: ExplorerBatchRenameRecipe) -> Any:
    let renameTargets = entries.filter(none)
    let validationError = validateBatchRenameRecipe(recipe)
    if validationError:
        return none
    let previewRows = renameTargets.map(none)
    let nextRows = previewRows.map(none)
    let collisionCounts = ts_Map()
    for row in nextRows:
        collisionCounts.set(row.destinationPath, (((collisionCounts.get(row.destinationPath) or 0)) + 1))
    for row in nextRows:
        row.collision = (ts_Boolean(validationError) or (((collisionCounts.get(row.destinationPath) or 0)) > 1))
    return none

fn validateBatchRenameRecipe(recipe: ExplorerBatchRenameRecipe) -> Any:
    if ((recipe.mode == "regex") and (recipe.findText.trim().length == 0)):
        return "Regex mode requires a pattern."
    if ((recipe.padding < 0) or (!ts_Number.isFinite(recipe.padding))):
        return "Padding must be a finite, non-negative number."
    if (!ts_Number.isFinite(recipe.startingNumber)):
        return "Starting number must be finite."
    if (recipe.mode != "regex"):
        return none

fn applyRenameTransform(stem: String, recipe: ExplorerBatchRenameRecipe) -> Any:
    if (recipe.findText.trim().length == 0):
        return stem
    if (recipe.mode == "regex"):
        let regex = RegExp(recipe.findText, "g")
        return stem.replace(regex, normalizeRegexReplacement(recipe.replaceText))
    return stem.split(recipe.findText).join(recipe.replaceText)

fn applyRenameTokens(value: String, context: Any) -> String:
    return value.replace(BATCH_RENAME_DATE_TOKEN_PATTERN, context.date).replace(BATCH_RENAME_PARENT_TOKEN_PATTERN, context.parent).replace(BATCH_RENAME_INDEX_TOKEN_PATTERN_GLOBAL, context.index)

fn formatLocalDateToken(date: Date) -> String:
    let year = date.getFullYear()
    let month = ts_String((date.getMonth() + 1)).padStart(2, "0")
    let day = ts_String(date.getDate()).padStart(2, "0")
    return year + "-" + month + "-" + day

fn formatSequenceNumber(value: Float, padding: Float) -> String:
    let width = Math.max(1, (Math.trunc(padding) or 1))
    return ts_String(Math.max(0, Math.trunc(value))).padStart(width, "0")

fn normalizeRegexReplacement(value: String) -> String:
    return value.replace(none, "$<$1>")

fn splitEntryName(name: String) -> Any:
    let extensionMatch = name.match_(none)
    let extension = (extensionMatch[1] or "")
    let stem = none
    return none

fn getPathParent(path: String) -> Any:
    let trimmed = path.replace(none, "")
    let parentPath = trimmed.replace(none, "")
    return none

fn getPathLeaf(path: String) -> String:
    let trimmed = path.replace(none, "")
    let match_ = trimmed.match_(none)
    return (match_[1] or trimmed)

fn joinPath(parentPath: String, leafName: String) -> Any:
    if (!parentPath):
        return leafName
    let separator = none
    return parentPath + separator + leafName

