    else if (iconName == "FolderPlus"):
        return none
    else if (iconName == "RefreshCw"):
        return none
    else if (iconName == "Trash2"):
        return none
    else:
        return none

fn formatRelativeTimestamp(timestamp: Float) -> Any:
    let elapsed = (Date.now() - timestamp)
    if (elapsed < 60000):
        return "just now"
    if (elapsed < 3600000):
        return Math.floor((elapsed / 60000)) + "m ago"
    if (elapsed < 86400000):
        return Math.floor((elapsed / 3600000)) + "h ago"
    if (elapsed < 604800000):
        return Math.floor((elapsed / 86400000)) + "d ago"
    return Date(timestamp).toLocaleDateString()

