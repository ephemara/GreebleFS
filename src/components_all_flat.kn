fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(Math.max(value, min), max)

fn formatDuration(seconds: Float) -> Any:
    if ((!ts_Number.isFinite(seconds)) or (seconds <= 0)):
        return "0:00"
    let totalSeconds = Math.floor(seconds)
    let hours = Math.floor((totalSeconds / 3600))
    let minutes = Math.floor((((totalSeconds % 3600)) / 60))
    let remainingSeconds = (totalSeconds % 60)
    if (hours > 0):
        return hours + ":" + minutes.toString().padStart(2, "0") + ":" + remainingSeconds.toString().padStart(2, "0")
    return minutes + ":" + remainingSeconds.toString().padStart(2, "0")

fn formatDb(value: Any) -> Any:
    if (((value == none) or (!ts_Number.isFinite(value))) or (value <= 0)):
        return "n/a"
    return ((20 * Math.log10(value))).toFixed(1) + " dB"

fn formatFadeDuration(seconds: Float) -> Any:
    if ((!ts_Number.isFinite(seconds)) or (seconds <= 0)):
        return "0.00s"
    if (seconds >= 60):
        return formatDuration(seconds)
    return seconds.toFixed(none) + "s"

fn formatSize(bytes: Float) -> Any:
    if (bytes < 1024):
        return bytes + " B"
    if (bytes < (1024 ** 2)):
        return ((bytes / 1024)).toFixed(1) + " KB"
    if (bytes < (1024 ** 3)):
        return ((bytes / (1024 ** 2))).toFixed(1) + " MB"
    return ((bytes / (1024 ** 3))).toFixed(2) + " GB"

fn formatPreciseSeconds(seconds: Float) -> Any:
    if (!ts_Number.isFinite(seconds)):
        return "0.000"
    return seconds.toFixed(3)

fn formatBpm(value: Any) -> Any:
    if (((value == none) or (!ts_Number.isFinite(value))) or (value <= 0)):
        return "n/a"
    return value.toFixed(none) + " BPM"

fn formatPitchShift(cents: Float) -> Any:
    if ((!ts_Number.isFinite(cents)) or (Math.abs(cents) < 0.5)):
        return "Neutral"
    let semitones = (cents / 100)
    return none

fn isEditableKeyboardTarget(target: Any) -> Any:
    let element = none
    if (!element):
        return false
    return ((element.isContentEditable or ["INPUT", "TEXTAREA", "SELECT"].includes(element.tagName)) or ts_Boolean(element.closest(".monaco-editor")))

fn buildAudioOutputPath(sourcePath: String, suffix: String, extension: String) -> String:
    let match_ = sourcePath.match_(none)
    let parentPath = (match_[1] or "")
    let leafName = (match_[2] or sourcePath)
    let stem = leafName.replace(none, "")
    return parentPath + stem + "." + suffix + "." + extension

