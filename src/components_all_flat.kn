fn shouldOpenExplorerEntryOnTrigger(arg_0: Any) -> Any:
    let isDirectory: Any = none
    let trigger: Any = none
    let plainClick: Any = none
    let folderClickMode: Any = none
    if (!isDirectory):
        return (trigger == "double-click")
    if (folderClickMode == "single"):
        return ((trigger == "click") and plainClick)
    return (trigger == "double-click")

fn shouldNavigateExplorerDirectoryOnSecondClick(arg_1: Any) -> Bool:
    let isDirectory: Any = none
    let clickDetail: Any = none
    let plainClick: Any = none
    let folderClickMode: Any = none
    let selectionModeActive: Any = none
    let immediateNavigationEnabled: Any = none
    return ((((((immediateNavigationEnabled and isDirectory) and (clickDetail > 1)) and plainClick) and (folderClickMode == "double")) and (!selectionModeActive)))

fn shouldShowExplorerFolderOpenIcon(arg_2: Any) -> Any:
    let isDirectory: Any = none
    let isSelected: Any = none
    let isDropTarget: Any = none
    let isOpenPrimed: Any = none
    let folderClickMode: Any = none
    if (!isDirectory):
        return false
    if isDropTarget:
        return true
    return (((folderClickMode == "double") and isSelected) and isOpenPrimed)

fn shouldNavigateUpOnEmptyExplorerDoubleClick(arg_3: Any) -> Any:
    let enabled: Any = none
    let target: Any = none
    let currentTarget: Any = none
    if (!enabled):
        return false
    if (!(ts_instanceof_operator(currentTarget, HTMLElement))):
        return false
    if ((!(ts_instanceof_operator(target, Node))) or (!currentTarget.contains(target))):
        return false
    if (!(ts_instanceof_operator(target, Element))):
        return true
    let blockedAncestor = target.closest(["[data-entry-path]", none, "button", "input", "textarea", "select", "a", none, none, none, none, "[data-no-empty-double-click]"].join(", "))
    return ((blockedAncestor == none) or (!currentTarget.contains(blockedAncestor)))

