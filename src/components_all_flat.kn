    fn setPosition(value: Any):
        position = value

    fn __component_effect_0() -> Any:
        if (!open):
            return none
        let updatePosition = none
        updatePosition()
        let scrollOptions: Option<Any> = none
        window.addEventListener("scroll", updatePosition, scrollOptions)
        window.addEventListener("resize", updatePosition)
        return none

    fn __component_effect_1() -> Any:
        if (!open):
            return none
        let handleKeyDown = none
        window.addEventListener("keydown", handleKeyDown)
        return none

    render <span className={"relative inline-flex items-center " + className.trim()} onPointerEnter={none} onPointerLeave={none}><button ref={triggerRef} type="button" aria_label={ariaLabel} aria_describedby={none} aria_expanded={open} onFocus={none} onBlur={none} onClick={none} className="inline-flex h-4 w-4 items-center justify-center rounded-full opacity-50 transition-opacity hover:opacity-100 focus:opacity-100 focus:outline-none" style={none}><Info size={11} /></button>{none}</span>

