fn clampNumber(value: Float, min: Float, max: Float) -> Float:
    return Math.min(Math.max(value, min), max)

fn dockPlacementLabel(placement: DockStackPlacement) -> String:
    if (placement == "left-sidebar"):
        return "Left"
    else if (placement == "center"):
        return "Center"
    else if (placement == "right-sidebar"):
        return "Right"
    else if (placement == "bottom-panel"):
        return "Bottom"
    else:
        return placement

fn dockNodeContainsStackId(node: DockNode, stackId: String) -> Any:
    if (node.type_ == "stack"):
        return (node.id == stackId)
    return node.children.some(none)

