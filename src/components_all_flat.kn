fn isFrontendWallpaperFile(entry: WallpaperFileEntry) -> Bool:
    return isSupportedRuntimeFile(entry, wallpaperSystemConfig.frontendExtensions)

fn isMediaWallpaperFile(entry: WallpaperFileEntry) -> Any:
    if entry.is_dir:
        return false
    let extension = entry.extension.toLowerCase()
    return (imageExtensions.has(extension) or videoExtensions.has(extension))

fn isSupportedWallpaperFile(entry: WallpaperFileEntry) -> Bool:
    return (isFrontendWallpaperFile(entry) or isMediaWallpaperFile(entry))

