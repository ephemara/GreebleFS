fn getThemeCatalogEntryKey(theme: OverlayThemeDefinition, packageInfo: Any, index: Float) -> String:
    let sourceKind = ((packageInfo.sourceKind or theme.source) or "built-in")
    let sourceLabel = ((packageInfo.sourceLabel or packageInfo.directoryPath) or "catalog")
    return theme.id + ":" + sourceKind + ":" + sourceLabel + ":" + index

component ThemeCatalogGrid(themes: Any, activeThemeId: Any, onSelect: Any, themePackageLookup: Any, createThemeCardMotion: Any) with Reactive:
    fn catalogSections() -> Any:
        let groupedThemes: Option<Any> = none
        let iter_3 = themes
        let index_4 = 0
        while (index_4 < iter_3.length):
            let themeOption = iter_3[index_4]
            let packageInfo = themePackageLookup.get(themeOption.id)
            let sectionId = resolveThemeCatalogSectionId(themeOption, packageInfo)
            groupedThemes[sectionId].push(themeOption)
            index_4 = (index_4 + 1)
        return (["official-pilot", "built-in", "legacy-archive"]).map(none)

    render <div className="space-y-4">{none}</div>

fn summarizeTopBarControls(topBar: LoadedOverlayTopBarDefinition) -> String:
    let prioritizedControls = [topBar.navigationShortcuts, topBar.leadingControls, topBar.trailingControls]
    let labels = ts_Array.from(ts_Set(prioritizedControls.map(none)))
    return labels.slice(0, 4).join(none)

