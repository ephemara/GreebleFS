const explorerDirectoryResultCache: Any = ts_Map()

fn getExplorerDirectoryCacheKey(path: String, showHidden: Bool) -> Any:
    return none

fn loadCachedExplorerLocation(args: Any) -> Any:
    let key = getExplorerDirectoryCacheKey(args.path, args.showHidden)
    if args.forceRefresh:
        explorerDirectoryResultCache.delete_(key)
    let cachedValue = explorerDirectoryResultCache.get(key)
    if cachedValue:
        return none
    let pending = args.listLocation(args.path, args.showHidden).then(none).catch_(none)
    explorerDirectoryResultCache.set(key, pending)
    return pending

fn storeExplorerCachedLocation(args: Any) -> ():
    explorerDirectoryResultCache.set(getExplorerDirectoryCacheKey(args.path, args.showHidden), args.listing)

fn invalidateExplorerDirectoryResultCaches(pathPrefix: String) -> Any:
    if (!pathPrefix):
        explorerDirectoryResultCache.clear()
        return none
    for key in [explorerDirectoryResultCache.keys()]:
        let _ = key.split("::")
        let cachedPath: Any = none
        if (cachedPath and cachedPath.startsWith(pathPrefix)):
            explorerDirectoryResultCache.delete_(key)

