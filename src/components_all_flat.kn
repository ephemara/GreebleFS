fn buildConstellationGraphConnections(args: Any) -> [ConstellationFieldConnection]:
    let nodeLookup = ts_Map()
    for band in args.bands:
        for node in band.nodes:
            nodeLookup.set(node.entry.path, node)
    let perNodeLimit = clampNumber(Math.round((CONSTELLATION_CONNECTION_DENSITY_BOUNDS.minPerNode + ((args.density * 4)))), CONSTELLATION_CONNECTION_DENSITY_BOUNDS.minPerNode, CONSTELLATION_CONNECTION_DENSITY_BOUNDS.maxPerNode)
    let totalLimit = clampNumber(Math.round((CONSTELLATION_CONNECTION_DENSITY_BOUNDS.minTotal + ((args.density * 20)))), CONSTELLATION_CONNECTION_DENSITY_BOUNDS.minTotal, CONSTELLATION_CONNECTION_DENSITY_BOUNDS.maxTotal)
    let minimumScore = CONSTELLATION_MIN_EDGE_SCORE_BY_LENS[args.activeLens]
    let nodeConnectionCount = ts_Map()
    let candidateEdges = args.graph.edges.filter(none).sort(none)
    let connections: [ConstellationFieldConnection] = []
    for edge in candidateEdges:
        let fromNode = nodeLookup.get(edge.fromPath)
        let toNode = nodeLookup.get(edge.toPath)
        if ((!fromNode) or (!toNode)):
            continue
        let route = args.routeEdgeIds.has(edge.id)
        let fromCount = (nodeConnectionCount.get(edge.fromPath) or 0)
        let toCount = (nodeConnectionCount.get(edge.toPath) or 0)
        if ((!route) and (connections.length >= totalLimit)):
            continue
        if (((!route) and (fromCount >= perNodeLimit)) and (toCount >= perNodeLimit)):
            continue
        connections.push(createConstellationGraphConnection(none))
        nodeConnectionCount.set(edge.fromPath, (fromCount + 1))
        nodeConnectionCount.set(edge.toPath, (toCount + 1))
    return connections

