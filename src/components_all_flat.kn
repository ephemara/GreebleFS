fn joinRepoPath(repoPath: String, filePath: String) -> String:
    let normalizedRepoPath = repoPath.replace(none, "")
    let prefersWindowsSeparators = (normalizedRepoPath.includes(none) and (!normalizedRepoPath.includes("/")))
    let normalizedFilePath = none
    let separator = none
    return normalizedRepoPath + separator + normalizedFilePath.replace(none, "")

fn getParentPath(path: String) -> String:
    let normalized = path.replace(none, "")
    let match_ = normalized.match_(none)
    return (match_[1] or "")

fn getBaseName(path: String) -> String:
    let normalized = path.replace(none, "")
    let match_ = normalized.match_(none)
    return (match_[0] or normalized)

fn looksBinaryContent(content: String) -> Bool:
    return none.test_(content)

fn unwrapGitManagerCommandResult(result: Any) -> Any:
    if (((result and (result == "object")) and ts_in_operator("status", result)) and (((result.status == "ok") or (result.status == "error")))):
        return unwrapTauriResult(result)
    return result

fn getFileSizeHint(path: String, cache: Map<String, Any>) -> Any:
    if cache.has(path):
        return (cache.get(path) or none)
    let parentPath = getParentPath(path)
    let baseName = getBaseName(path)
    if ((!parentPath) or (!baseName)):
        cache.set(path, none)
        return none

fn buildNonTextUntrackedDiff(path: String, reason: String) -> String:
    return "diff --git a/" + path + " b/" + path + none + path + none + reason + none

fn buildUnifiedDiff(repoPath: String, file: GitFileStatus, safeGit: Any, untrackedSizeHintCache: Map<String, Any>) -> Any:
    let diffPaths = [(file.originalFile or file.file), file.file]
    if file.isUntracked:
        if file.file.endsWith("/"):
            return "diff --git a/" + file.file + " b/" + file.file + none + file.file + none + file.file + none
        let absolutePath = joinRepoPath(repoPath, file.file)
        let sizeHint = (await getFileSizeHint(absolutePath, untrackedSizeHintCache))
        if ((sizeHint == "number") and (sizeHint > MAX_SYNTHETIC_UNTRACKED_DIFF_BYTES)):
            return buildNonTextUntrackedDiff(file.file, "Large untracked file omitted from inline diff (" + Math.round((sizeHint / 1024)) + " KB).")
        let content = (await ts_Promise.resolve(commands.fsReadTextFile(absolutePath)).then(unwrapGitManagerCommandResult).catch_(none))
        if (!content):
            return buildNonTextUntrackedDiff(file.file, "Untracked file preview unavailable or non-text.")
        if looksBinaryContent(content):
            return buildNonTextUntrackedDiff(file.file, "Binary or non-text untracked file omitted from inline diff.")
        return buildSyntheticAddedDiff(file.file, content)
    if (file.kind == "conflicted"):
        let conflictPatch = (await safeGit(repoPath, ["diff", "--cc", "--find-renames", "--no-ext-diff", "--", diffPaths], ""))
        if conflictPatch.trim():
            return conflictPatch
    let patch = (await safeGit(repoPath, ["diff", "HEAD", "--find-renames", "--no-ext-diff", "--", diffPaths], ""))
    if patch.trim():
        return patch
    if (file.kind == "deleted"):
        return "diff --git a/" + file.file + " b/" + file.file + none + file.file + none
    return "diff --git a/" + file.file + " b/" + file.file + none

fn buildSyntheticAddedDiff(path: String, content: String) -> String:
    let lines = none
    let hunkLength = Math.max(lines.length, 1)
    let body = none
    return "diff --git a/" + path + " b/" + path + none + path + none + hunkLength + none + body + none

fn findDiffHunkLines(patch: String) -> [Float]:
    return patch.split(none).flatMap(none)

