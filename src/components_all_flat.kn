fn resolveAdjustedCutoutMask(args: Any) -> Any:
    let _ = args
    let baseMask: Any = none
    let edgeSoftness: Any = none
    let edgePull: Any = none
    let blurRadius = Math.max(0, (edgeSoftness + (Math.abs(edgePull) * 0.45)))
    let workingCanvas = document.createElement("canvas")
    let filteredCanvas = document.createElement("canvas")
    writeCutoutMaskToCanvas(baseMask, workingCanvas)
    filteredCanvas.width = baseMask.width
    filteredCanvas.height = baseMask.height
    let filteredContext = filteredCanvas.getContext("2d")
    if (!filteredContext):
        return none
    filteredContext.clearRect(0, 0, baseMask.width, baseMask.height)
    filteredContext.filter = none
    filteredContext.drawImage(workingCanvas, 0, 0, baseMask.width, baseMask.height)
    filteredContext.filter = "none"
    let filteredMask = readCutoutMaskFromCanvas(filteredCanvas)
    let alpha = cloneCutoutMaskAlpha(filteredMask.alpha)
    let cutoff = (128 - (edgePull * 4))
    let softnessWindow = Math.max(10, (((edgeSoftness * 6) + (Math.abs(edgePull) * 3)) + 8))
    let index = 0
    while (index < alpha.length):
        let sample = (filteredMask.alpha[index] or 0)
        let weight = smoothstep((cutoff - softnessWindow), (cutoff + softnessWindow), sample)
        ()
        index = (index + 1)
    return none

type ExplorerImageStageTransform = Any

const DEFAULT_EXPLORER_IMAGE_STAGE_TRANSFORM: Option<Any> = none

const EXPLORER_IMAGE_STAGE_MIN_SCALE: Any = 0.5

const EXPLORER_IMAGE_STAGE_MAX_SCALE: Any = 6

const EXPLORER_IMAGE_STAGE_ZOOM_SENSITIVITY: Any = 0.0015

const EXPLORER_PREVIEW_STAGE_CHECKERBOARD_BACKGROUND_IMAGE: Any = none

const EXPLORER_PREVIEW_STAGE_CHECKERBOARD_BACKGROUND_SIZE: Any = "16px 16px"

const EXPLORER_PREVIEW_STAGE_CHECKERBOARD_BACKGROUND_POSITION: Any = "0 0, 0 8px, 8px -8px, -8px 0px"

const EXPLORER_PREVIEW_STAGE_CHECKERBOARD_BACKGROUND_COLOR: Any = "rgba(0,0,0,0.4)"

fn clampExplorerImageStageValue(value: Float, min: Float, max: Float) -> Float:
    return Math.min(max, Math.max(min, value))

fn normalizeExplorerImageStageTransform(transform: ExplorerImageStageTransform, viewport: Any, content: Any) -> Any:
    let nextScale = ts_Number(clampExplorerImageStageValue(transform.scale, EXPLORER_IMAGE_STAGE_MIN_SCALE, EXPLORER_IMAGE_STAGE_MAX_SCALE).toFixed(2))
    if ((!viewport) or (!content)):
        return none
    let viewportWidth = viewport.clientWidth
    let viewportHeight = viewport.clientHeight
    let baseWidth = content.clientWidth
    let baseHeight = content.clientHeight
    if ((((viewportWidth <= 0) or (viewportHeight <= 0)) or (baseWidth <= 0)) or (baseHeight <= 0)):
        return none
    let scaledWidth = (baseWidth * nextScale)
    let scaledHeight = (baseHeight * nextScale)
    let maxOffsetX = Math.max(0, (((scaledWidth - viewportWidth)) / 2))
    let maxOffsetY = Math.max(0, (((scaledHeight - viewportHeight)) / 2))
    return none

fn applyExplorerImageStageWheelZoom(args: Any) -> Any:
    let _ = args
    let currentTransform: Any = none
    let viewport: Any = none
    let content: Any = none
    let clientX: Any = none
    let clientY: Any = none
    let deltaY: Any = none
    if (!viewport):
        return currentTransform
    let zoomFactor = Math.exp(((-deltaY) * EXPLORER_IMAGE_STAGE_ZOOM_SENSITIVITY))
    let viewportRect = viewport.getBoundingClientRect()
    let focusX = ((clientX - viewportRect.left) - (viewportRect.width / 2))
    let focusY = ((clientY - viewportRect.top) - (viewportRect.height / 2))
    let nextScale = ts_Number(clampExplorerImageStageValue((currentTransform.scale * zoomFactor), EXPLORER_IMAGE_STAGE_MIN_SCALE, EXPLORER_IMAGE_STAGE_MAX_SCALE).toFixed(2))
    if (nextScale == currentTransform.scale):
        return currentTransform
    let scaleRatio = (nextScale / currentTransform.scale)
    return normalizeExplorerImageStageTransform(none, viewport, content)

