fn getExplorerThumbnailTypeBadgeMetrics(stageSize: Float) -> Any:
    let shellSize = Math.max(16, Math.min(28, Math.round((stageSize * 0.3))))
    let iconSize = Math.max(10, Math.min(18, (shellSize - Math.max(4, Math.round((shellSize * 0.32))))))
    let inset = Math.max(3, Math.round((stageSize * 0.06)))
    return none

