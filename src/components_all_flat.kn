fn syncPanelListDragSnapshotCache() -> Any:
    let nextSnapshot: Option<Any> = none
    if ((((panelListDragSnapshotCache.active == nextSnapshot.active) and (panelListDragSnapshotCache.draggedItemId == nextSnapshot.draggedItemId)) and (panelListDragSnapshotCache.hoveredListId == nextSnapshot.hoveredListId)) and (panelListDragSnapshotCache.hoveredIndex == nextSnapshot.hoveredIndex)):
        return none
    panelListDragSnapshotCache = nextSnapshot

fn emitPanelListDragSnapshot() -> ():
    syncPanelListDragSnapshotCache()
    for listener in panelListDragListeners:
        listener()

fn getPanelListDragSnapshot() -> PanelListDragSnapshot:
    syncPanelListDragSnapshotCache()
    return panelListDragSnapshotCache

fn subscribeToPanelListDrag(listener: Any) -> Any:
    panelListDragListeners.add(listener)
    return none

fn usePanelListDragSnapshot() -> PanelListDragSnapshot:
    return useSyncExternalStore(subscribeToPanelListDrag, getPanelListDragSnapshot, getPanelListDragSnapshot)

fn clearPanelListHoveredTarget() -> ():
    if (activePanelListDragSession.hoveredListId and panelListRegistry.has(activePanelListDragSession.hoveredListId)):
        panelListRegistry.get(activePanelListDragSession.hoveredListId).setHoveredDropIndex(none)

fn setPanelListHoveredTarget(listId: Any, index: Any) -> Any:
    let currentSession = activePanelListDragSession
    if (!currentSession):
        return none
    if ((currentSession.hoveredListId == listId) and (currentSession.hoveredIndex == index)):
        return none
    clearPanelListHoveredTarget()
    if (listId and (index != none)):
        panelListRegistry.get(listId).setHoveredDropIndex(index)
    activePanelListDragSession = none
    emitPanelListDragSnapshot()

fn applyPanelListDragBodyState() -> Any:
    if (document == "undefined"):
        return none
    let body = document.body
    if (!body):
        return none
    if (savedBodyUserSelect == none):
        savedBodyUserSelect = body.style.userSelect
    if (savedBodyCursor == none):
        savedBodyCursor = body.style.cursor
    body.style.userSelect = "none"
    body.style.cursor = "grabbing"

fn restorePanelListDragBodyState() -> Any:
    if (document == "undefined"):
        savedBodyUserSelect = none
        savedBodyCursor = none
        return none
    let body = document.body
    if (!body):
        savedBodyUserSelect = none
        savedBodyCursor = none
        return none
    if (savedBodyUserSelect != none):
        body.style.userSelect = savedBodyUserSelect
    else:
        body.style.removeProperty("user-select")
    if (savedBodyCursor != none):
        body.style.cursor = savedBodyCursor
    else:
        body.style.removeProperty("cursor")
    savedBodyUserSelect = none
    savedBodyCursor = none

fn resolvePanelListDropTargetFromPoint(point: PanelPointerPoint) -> Any:
    if (document == "undefined"):
        return none
    let hoveredElement = document.elementFromPoint(point.x, point.y)
    if (!(ts_instanceof_operator(hoveredElement, Element))):
        return none
    let explicitDropZone = hoveredElement.closest("[data-draggable-panel-drop-zone-list-id]")
    if explicitDropZone:
        let listRuntimeId = (explicitDropZone.dataset.draggablePanelDropZoneListId or none)
        let listLabel = (explicitDropZone.closest("[data-draggable-panel-list]").dataset.draggablePanelList or none)
        let indexValue = (explicitDropZone.dataset.draggablePanelDropZoneIndex or none)
        let index = none
        if (((listRuntimeId and listLabel) and ts_Number.isFinite(index)) and panelListRegistry.has(listRuntimeId)):
            return none
    let hoveredListElement = hoveredElement.closest("[data-draggable-panel-runtime-list-id]")
    let listRuntimeId = hoveredListElement.dataset.draggablePanelRuntimeListId
    let listLabel = hoveredListElement.dataset.draggablePanelList
    if ((!listRuntimeId) or (!listLabel)):
        return none
    let listEntry = panelListRegistry.get(listRuntimeId)
    if (!listEntry):
        return none
    let resolvedIndex = listEntry.resolveDropIndexFromPoint(point)
    if (resolvedIndex == none):
        return none
    return none

fn resolveDraggablePanelListDropTargetFromPoint(point: PanelPointerPoint) -> Any:
    return resolvePanelListDropTargetFromPoint(point)

fn commitPanelListPointerMove(point: PanelPointerPoint, pointerId: Float) -> Any:
    let currentSession = activePanelListDragSession
    if ((!currentSession) or (currentSession.pointerId != pointerId)):
        return none
    let movedDistance = Math.hypot((point.x - currentSession.startPoint.x), (point.y - currentSession.startPoint.y))
    if ((!currentSession.active) and (movedDistance < PANEL_LIST_DRAG_START_DISTANCE_PX)):
        return none
    if (!currentSession.active):
        activePanelListDragSession = none
        currentSession.onDragStart(currentSession.itemId)
        applyPanelListDragBodyState()
        emitPanelListDragSnapshot()
    else:
        activePanelListDragSession = none
    let dropTarget = resolvePanelListDropTargetFromPoint(point)
    setPanelListHoveredTarget((dropTarget.listRuntimeId or none), (dropTarget.index or none))

fn finishPanelListDragSession(args: Any) -> Any:
    let currentSession = activePanelListDragSession
    if (!currentSession):
        return none
    if ((args.pointerId != none) and (currentSession.pointerId != args.pointerId)):
        return none
    let hoveredListId = currentSession.hoveredListId
    let hoveredIndex = currentSession.hoveredIndex
    let draggedItemId = currentSession.itemId
    let dragWasActive = currentSession.active
    let dragEndHandler = currentSession.onDragEnd
    clearPanelListHoveredTarget()
    activePanelListDragSession = none
    restorePanelListDragBodyState()
    detachPanelListWindowListeners()
    emitPanelListDragSnapshot()
    if (((args.shouldDrop and dragWasActive) and (hoveredListId != none)) and (hoveredIndex != none)):
        panelListRegistry.get(hoveredListId).onDropItem(draggedItemId, hoveredIndex)
    dragEndHandler()

fn handlePanelListWindowPointerMove(event: PointerEvent) -> ():
    commitPanelListPointerMove(none, event.pointerId)

fn handlePanelListWindowPointerUp(event: PointerEvent) -> ():
    finishPanelListDragSession(none)

fn handlePanelListWindowPointerCancel(event: PointerEvent) -> ():
    finishPanelListDragSession(none)

fn handlePanelListWindowBlur() -> ():
    finishPanelListDragSession(none)

fn handlePanelListWindowKeyDown(event: KeyboardEvent) -> Any:
    if (event.key != "Escape"):
        return none
    finishPanelListDragSession(none)

fn attachPanelListWindowListeners() -> Any:
    if (panelListWindowListenersAttached or (window == "undefined")):
        return none
    panelListWindowListenersAttached = true
    window.addEventListener("pointermove", handlePanelListWindowPointerMove)
    window.addEventListener("pointerup", handlePanelListWindowPointerUp)
    window.addEventListener("pointercancel", handlePanelListWindowPointerCancel)
    window.addEventListener("blur", handlePanelListWindowBlur)
    window.addEventListener("keydown", handlePanelListWindowKeyDown)

fn detachPanelListWindowListeners() -> Any:
    if ((!panelListWindowListenersAttached) or (window == "undefined")):
        return none
    panelListWindowListenersAttached = false
    window.removeEventListener("pointermove", handlePanelListWindowPointerMove)
    window.removeEventListener("pointerup", handlePanelListWindowPointerUp)
    window.removeEventListener("pointercancel", handlePanelListWindowPointerCancel)
    window.removeEventListener("blur", handlePanelListWindowBlur)
    window.removeEventListener("keydown", handlePanelListWindowKeyDown)

fn startPanelListPointerSession(args: Any) -> ():
    finishPanelListDragSession(none)
    activePanelListDragSession = none
    attachPanelListWindowListeners()
    emitPanelListDragSnapshot()

