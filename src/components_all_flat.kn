    let matchKind = (source.match_kind or "name")
    let trimmedQuery = searchQuery.trim()
    let searchString = none
    if ((source.line_number == none) and (!searchString)):
        return none
    return none

fn clampSearchFocusLine(lineNumber: Any, lineCount: Float) -> Any:
    if ((!ts_Number.isFinite(lineCount)) or (lineCount < 1)):
        return 1
    if ((lineNumber == none) or (!ts_Number.isFinite(lineNumber))):
        return 1
    return Math.min(Math.max(Math.trunc(lineNumber), 1), lineCount)

fn findSearchFocusColumns(lineContent: String, searchString: Any) -> Any:
    let normalizedLine = (lineContent or "")
    let trimmedSearch = (searchString.trim() or "")
    if (!trimmedSearch):
        return none
    let matchIndex = normalizedLine.toLowerCase().indexOf(trimmedSearch.toLowerCase())
    if (matchIndex < 0):
        return none
    return none

