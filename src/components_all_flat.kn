fn defineShader(definition: OverlayShaderDefinition) -> OverlayShaderDefinition:
    return definition

fn clamp01(value: Float) -> Float:
    return Math.min(Math.max(value, 0), 1)

fn lerp(from: Float, to: Float, progress: Float) -> Float:
    return (from + ((((to - from)) * clamp01(progress))))

fn isFrontendShaderFile(entry: ShaderFileEntry) -> Bool:
    return isSupportedRuntimeFile(entry, shaderSystemConfig.frontendExtensions)

fn deriveShaderId(name: String) -> String:
    return deriveRuntimeModuleId(name, "shader")

fn deriveShaderName(name: String) -> String:
    return deriveRuntimeModuleName(name, "Shader")

fn loadShaderFromSource(source: String, entry: ShaderFileEntry, options: LoadShaderFromSourceOptions) -> impl Async_<LoadedOverlayShader>:
    let defaultId = deriveShaderId(entry.name)
    let defaultName = deriveShaderName(entry.name)
    let context: Option<Any> = none

fn createBuiltInOverlayShaders() -> [LoadedOverlayShader]:
    return [createBuiltInShader(none), createBuiltInShader(none), createBuiltInShader(none), createBuiltInShader(none)]

fn mergeOverlayShaders(builtInShaders: [LoadedOverlayShader], authoredShaders: [LoadedOverlayShader]) -> [LoadedOverlayShader]:
    let byId = ts_Map(builtInShaders.map(none))
    for shader_ in authoredShaders:
        if shader_.error:
            continue
        let existing = byId.get(shader_.id)
        if existing:
            byId.set(shader_.id, none)
            continue
        byId.set(shader_.id, shader_)
    return ts_Array.from(byId.values()).sort(none)

fn resolveShaderComputedUniforms(shader_: Any, shellContext: OverlayShaderShellContext) -> Any:
    if (!shader_.resolveSharedUniforms):
        return none

fn getStepPrecision(step: Float) -> Any:
    let normalizedStep = none
    let decimalSegment = normalizedStep.split(".")[1]
    return none

fn normalizeShaderControlValue(control: OverlayShaderControlDefinition, value: Float, fallbackValue: Float) -> Float:
    let lowerBound = Math.min(control.min, control.max)
    let upperBound = Math.max(control.min, control.max)
    let step = none
    let fallback = none
    let raw = none
    let clamped = Math.min(Math.max(raw, lowerBound), upperBound)
    let snapped = (lowerBound + ((Math.round((((clamped - lowerBound)) / step)) * step)))
    let precision = getStepPrecision(step)
    return ts_Number(snapped.toFixed(precision))

fn resolveShaderControlValues(shader_: Any, persistedValues: Any, computedUniforms: OverlayShaderUniformMap) -> Any:
    if ((!shader_) or (shader_.controls.length == 0)):
        return none
    return ts_Object.fromEntries(shader_.controls.map(none))

fn resolveShaderSharedUniforms(shader_: Any, shellContext: OverlayShaderShellContext) -> Any:
    let computedUniforms = resolveShaderComputedUniforms(shader_, shellContext)
    let controlValues = resolveShaderControlValues(shader_, shellContext.shaderControlValues, computedUniforms)
    return none

fn buildShaderRenderContext(args: Any) -> Any:
    return none

fn resolveShaderSurfaceStyle(shader_: Any, context: OverlayShaderRenderContext) -> Any:
    let surfaceDefinition = shader_[context.surface]
