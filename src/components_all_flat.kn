        let previewCommand = command
        return none
    return none

fn createWindowsShellContextMenuNodes(command: ExplorerCommandDefinition, request: ExplorerShellContextMenuRequest, items: [ExplorerShellContextMenuItem], depth: Float, environment: ExplorerMenuRuntimeEnvironment, idPrefix: String) -> Any:
    let nodes: [ExplorerRuntimeMenuNode] = []
    let iter_0 = items
    let index_1 = 0
    while (index_1 < iter_0.length):
        let item = iter_0[index_1]
        let index = index_1
        let itemId = idPrefix + "." + index + "." + (item.id or "submenu")
        let itemIcon = (item.icon or command.iconName)
        let childItems = (item.children or [])
        if (childItems.length > 0):
            let children = sanitizeNodeList(createWindowsShellContextMenuNodes(command, request, childItems, (depth + 1), environment, itemId))
            if (children.length == 0):
                return none
            nodes.push(none)
            return none
        if (item.id == 0):
            return none
        nodes.push(none)
        index_1 = (index_1 + 1)
    return nodes

fn createResolverChildren(command: ExplorerCommandDefinition, invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment, depth: Float) -> Any:
    if (command.source != "built-in"):
        return []
    if (command.execution.actionId == "open-with"):
        let entry = (primaryEntry or resolveCurrentPathEntry(environment))
        let state_ = environment.openWithProgramsByPath[entry.path]
        let children: [ExplorerRuntimeMenuNode] = []
        let seenProgramKeys = ts_Set()
        let pushSeparatorIfNeeded = none
        if ((state_.status == "ready") and state_.catalog):
            let _ = state_
            let catalog: Any = none
            if catalog.defaultProgram:
                let _ = dedupeOpenWithPrograms([none], seenProgramKeys)
                let defaultProgram: Any = none
                if defaultProgram:
                    children.push(createOpenWithProgramNode(command, entry.path, defaultProgram, depth, environment, defaultProgram.name + " (Default)", "Default application for this file type."))
            let recommendedPrograms = dedupeOpenWithPrograms(catalog.recommendedPrograms, seenProgramKeys)
            for program in recommendedPrograms:
                children.push(createOpenWithProgramNode(command, entry.path, program, depth, environment))
            let otherPrograms = dedupeOpenWithPrograms(catalog.otherPrograms, seenProgramKeys)
            if ((otherPrograms.length > 0) and (children.length > 0)):
                pushSeparatorIfNeeded()
            for program in otherPrograms:
                children.push(createOpenWithProgramNode(command, entry.path, program, depth, environment))
        else if (state_.status == "error"):
            children.push(createDisabledResolverNode(command.id + ".error", "Unable to Load Apps", (state_.error or "The operating system did not return any compatible apps."), command, depth))
        else:
            children.push(createDisabledResolverNode(command.id + ".loading", none, "Resolving applications that can open this item.", command, depth))
        if (children.length == 0):
            children.push(createDisabledResolverNode(command.id + ".empty", "No Compatible Apps Found", "No associated applications were reported for this item.", command, depth))
        if environment.supportsOpenWithSystemPicker:
            pushSeparatorIfNeeded()
            children.push(none)
        return children
    else if (command.execution.actionId == "windows-shell-actions"):
        let resolvedRequest = resolveExplorerWindowsShellContextMenuRequest(invocation, targetEntries, primaryEntry, environment)
        if (!resolvedRequest):
            return []
        let state_ = environment.windowsShellContextMenusByRequestKey[resolvedRequest.requestKey]
        if ((state_.status == "ready") and state_.items):
            let children = sanitizeNodeList(createWindowsShellContextMenuNodes(command, resolvedRequest.request, state_.items, depth, environment, command.id + ".windows-shell-actions"))
            if (children.length > 0):
                return children
            return [createDisabledResolverNode(command.id + ".empty", "No Windows Actions Found", "Windows did not report any native context-menu actions for this target.", command, depth)]
        if (state_.status == "error"):
            return [createDisabledResolverNode(command.id + ".error", "Unable to Load Windows Actions", (state_.error or "Windows did not return a usable context menu for this target."), command, depth)]
        return [createDisabledResolverNode(command.id + ".loading", none, "Resolving the native Windows context-menu actions for this target.", command, depth)]
    else:
        return []

fn createRuntimeNodeForCommand(command: ExplorerCommandDefinition, invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment, depth: Float) -> Any:
    if (command.behavior == "resolver"):
        if (!canShowCommand(command, invocation, targetEntries, primaryEntry, environment)):
            return none
        let children = sanitizeNodeList(createResolverChildren(command, invocation, targetEntries, primaryEntry, environment, (depth + 1)))
        if (children.length == 0):
            return none
        return none
    return createRuntimeLeafNode(command, invocation, targetEntries, primaryEntry, environment, depth)

fn resolveLayoutEntriesForParent(entries: [ExplorerMenuLayoutEntry], parentEntryId: Any) -> [ExplorerMenuLayoutEntry]:
    return sortExplorerMenuLayoutEntries(entries).filter(none)

fn matchesGroupSlot(command: ExplorerCommandDefinition, slot: Any) -> Any:
    if (command.group != slot.group):
        return false
    if (slot.sourceFilter == "any"):
        return true
    return (command.source == slot.sourceFilter)

fn buildNodesForLayout(layout: ExplorerMenuContextLayout, commandRegistry: [ExplorerCommandDefinition], invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment, parentEntryId: Any, depth: Float, handledCommandIds: Set<String>) -> Any:
    let children = resolveLayoutEntriesForParent(layout.entries, parentEntryId)
    let nodes: [ExplorerRuntimeMenuNode] = []
    let iter_4 = children
    let index_5 = 0
    while (index_5 < iter_4.length):
        let entry = iter_4[index_5]
        if (entry.kind == "separator"):
            nodes.push(none)
            return none
        if (entry.kind == "submenu"):
            let submenuChildren = sanitizeNodeList(buildNodesForLayout(layout, commandRegistry, invocation, targetEntries, primaryEntry, environment, entry.id, (depth + 1), handledCommandIds))
            if (submenuChildren.length == 0):
                return none
            nodes.push(none)
            return none
        if (entry.kind == "group-slot"):
            let matchingCommands = commandRegistry.filter(none).filter(none).sort(none)
            let iter_2 = matchingCommands
            let index_3 = 0
            while (index_3 < iter_2.length):
                let command = iter_2[index_3]
                let node = createRuntimeNodeForCommand(command, invocation, targetEntries, primaryEntry, environment, depth)
                if (!node):
                    return none
                handledCommandIds.add(command.id)
                if (node.kind == "command"):
                    node.quickSlot = (entry.quickSlot or "none")
                    node.fallbackBucket = (entry.fallbackBucket or "default")
                nodes.push(node)
                index_3 = (index_3 + 1)
            return none
        let command = (commandRegistry.find(none) or none)
        if (!command):
            return none
        let node = createRuntimeNodeForCommand(command, invocation, targetEntries, primaryEntry, environment, depth)
        if (!node):
            return none
        handledCommandIds.add(command.id)
        if (node.kind == "command"):
            node.quickSlot = (entry.quickSlot or "none")
            node.fallbackBucket = (entry.fallbackBucket or "default")
        nodes.push(node)
        index_5 = (index_5 + 1)
    return sanitizeNodeList(nodes)

fn layoutHasGroupSlot(layout: ExplorerMenuContextLayout, group: Any) -> Bool:
    return layout.entries.some(none)

fn createFallbackSeparatorNode(id: String) -> Any:
    return none

fn injectFallbackPreviewNodes(nodes: [ExplorerRuntimeMenuNode], layout: ExplorerMenuContextLayout, commandRegistry: [ExplorerCommandDefinition], invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment, handledCommandIds: Set<String>) -> Any:
    if ((invocation.kind != "preview-pane") or layoutHasGroupSlot(layout, "preview")):
        return nodes
    let previewNodes = commandRegistry.filter(none).sort(none).flatMap(none)
    let sanitizedPreviewNodes = sanitizeNodeList(previewNodes)
    if (sanitizedPreviewNodes.length == 0):
        return nodes
    let pinnedTopCommandIds = ts_Set(["built-in.open", "built-in.open-with"])
    let insertionIndex = 0
    while (insertionIndex < nodes.length):
        let node = nodes[insertionIndex]
        let matchesPinnedTopCommand = ((((node.kind == "command") and pinnedTopCommandIds.has(node.commandId))) or (((node.kind == "submenu") and pinnedTopCommandIds.has(node.id))))
        if (!matchesPinnedTopCommand):
            break
        insertionIndex = (insertionIndex + 1)
    let prefix = nodes.slice(0, insertionIndex)
    let suffix = nodes.slice(insertionIndex)
    let mergedNodes: [ExplorerRuntimeMenuNode] = [prefix]
    if ((prefix.length > 0) and (prefix[(prefix.length - 1)].kind != "separator")):
        mergedNodes.push(createFallbackSeparatorNode("preview.fallback.leading-separator"))
    mergedNodes.push(none)
    if (suffix.length > 0):
        mergedNodes.push(createFallbackSeparatorNode("preview.fallback.trailing-separator"))
        mergedNodes.push(none)
    return sanitizeNodeList(mergedNodes)

fn injectFallbackActionNodes(nodes: [ExplorerRuntimeMenuNode], layout: ExplorerMenuContextLayout, commandRegistry: [ExplorerCommandDefinition], invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment, handledCommandIds: Set<String>) -> Any:
    if layoutHasGroupSlot(layout, "action"):
        return nodes
    let actionNodes = commandRegistry.filter(none).sort(none).flatMap(none)
    let sanitizedActionNodes = sanitizeNodeList(actionNodes)
    if (sanitizedActionNodes.length == 0):
        return nodes
    let insertionIndex = nodes.findIndex(none)
    let safeInsertionIndex = none
    let prefix = nodes.slice(0, safeInsertionIndex)
    let suffix = nodes.slice(safeInsertionIndex)
    let mergedNodes: [ExplorerRuntimeMenuNode] = [prefix]
    if ((mergedNodes.length > 0) and (mergedNodes[(mergedNodes.length - 1)].kind != "separator")):
        mergedNodes.push(createFallbackSeparatorNode("action.fallback.leading-separator"))
    mergedNodes.push(none)
    if (suffix.length > 0):
        mergedNodes.push(createFallbackSeparatorNode("action.fallback.trailing-separator"))
        mergedNodes.push(none)
    return sanitizeNodeList(mergedNodes)

fn resolveActiveMenuPack(menuPacks: [LoadedExplorerMenuPack], activeMenuPackId: Any) -> Any:
    let builtInPack = (menuPacks.find(none) or createBuiltInExplorerMenuPack())
    if (!activeMenuPackId):
        return builtInPack
    return (menuPacks.find(none) or builtInPack)

fn getLayoutForContext(menuPack: LoadedExplorerMenuPack, overridesByContext: ExplorerMenuContextLayoutOverrideMap, contextKind: ExplorerMenuContextKind) -> ExplorerMenuContextLayout:
    return ((overridesByContext[contextKind] or menuPack.contexts[contextKind]) or none)

fn buildExplorerRuntimeMenu(options: BuildExplorerRuntimeMenuOptions) -> Any:
    let pluginCommands = normalizePluginContextMenuContributions(options.pluginContextMenuItems)
    let actionCommands = normalizeExplorerActionContributions(options.actions)
    let menuPack = resolveActiveMenuPack(options.menuPacks, options.activeMenuPackId)
    let targetEntries = getActionEntries(options.invocation)
    let primaryEntry = getPrimaryActionEntry(options.invocation, options.environment, targetEntries)
    let dynamicCommands = createDynamicAudioCommands(options.invocation, options.environment)
    let previewCommands = createPreviewContextMenuCommands(options.invocation, options.previewContextMenuRegistration)
    let commandRegistry: [ExplorerCommandDefinition] = [BUILT_IN_EXPLORER_CONTEXT_MENU_ITEMS, dynamicCommands, previewCommands, actionCommands, pluginCommands]
    let layout = getLayoutForContext(menuPack, options.layoutOverridesByContext, options.invocation.kind)
    let handledCommandIds = ts_Set()
    let layoutNodes = buildNodesForLayout(layout, commandRegistry, options.invocation, targetEntries, primaryEntry, options.environment, none, 0, handledCommandIds)
    let previewInjectedNodes = injectFallbackPreviewNodes(layoutNodes, layout, commandRegistry, options.invocation, targetEntries, primaryEntry, options.environment, handledCommandIds)
    let nodes = injectFallbackActionNodes(previewInjectedNodes, layout, commandRegistry, options.invocation, targetEntries, primaryEntry, options.environment, handledCommandIds)
    let finalizedNodes = none
    return none

fn resolveMenuInvocationInputModality(event: Any) -> Any:
    if (!event):
        return "mouse"
    if (event.pointerType == "touch"):
        return "touch"
    if (event.pointerType == "pen"):
        return "pen"
    return "mouse"

type ExplorerPickerEntry = Any

type ExplorerPickerRequest = Any

struct ExplorerPickerSelectableEntry:
    isDirectory: Bool
    name: String
    path: String

struct ResolveExplorerPickerEntriesArgs:
    currentPath: String
    hasAnySelection: Bool
    request: Any
    saveFileName: Any
    selectedEntries: [ExplorerPickerSelectableEntry]

fn resolveExplorerPickerEntries(args: ResolveExplorerPickerEntriesArgs) -> Any:
    let request = args.request
    if (!request):
        return []
    if (request.kind == "saveFile"):
        let normalizedPath = buildExplorerPickerSavePath(none)
        if (!normalizedPath):
            return []
        return [none]
    let selectedEntries = sanitizeSelectedEntries(args.selectedEntries, request.allowedExtensions)
    if ((request.kind == "openFile") or (request.kind == "openFiles")):
        let fileEntries = selectedEntries.filter(none)
        if (fileEntries.length == 0):
            return []
        let effectiveEntries = none
        return effectiveEntries.map(none)
    let folderEntries = selectedEntries.filter(none)
    if (folderEntries.length > 0):
        let effectiveEntries = none
        return effectiveEntries.map(none)
    let normalizedCurrentPath = args.currentPath.trim()
    if ((args.hasAnySelection or (!normalizedCurrentPath)) or (!supportsCurrentDirectoryFallback(request.kind))):
        return []
    return [none]

fn supportsCurrentDirectoryFallback(kind: Any) -> Bool:
    return (((kind == "openFolder") or (kind == "openFolders")) or (kind == "pickDestinationFolder"))

fn allowsExplorerPickerMultipleSelection(kind: Any) -> Bool:
    return ((kind == "openFiles") or (kind == "openFolders"))

fn buildExplorerPickerSavePath(args: Any) -> Any:
    let currentPath = args.currentPath.trim()
    let fileName = normalizeSaveFileName(args.fileName, args.defaultExtension)
    if ((!currentPath) or (!fileName)):
        return none
    let separator = none
    let trimmedParent = currentPath.replace(none, "")
    return none

fn normalizeSaveFileName(fileName: String, defaultExtension: Any) -> Any:
    let trimmedFileName = fileName.trim().replace(none, "")
    if (!trimmedFileName):
        return ""
    let normalizedExtension = normalizeExtension(defaultExtension)
    if ((!normalizedExtension) or none.test_(trimmedFileName)):
        return trimmedFileName
    return trimmedFileName + "." + normalizedExtension

fn getPathLeaf(path: String) -> Any:
    let trimmed = path.trim().replace(none, "")
    if (!trimmed):
        return path.trim()
    let segments = trimmed.split(none).filter(ts_Boolean)
    return (segments[(segments.length - 1)] or trimmed)

fn sanitizeSelectedEntries(entries: [ExplorerPickerSelectableEntry], allowedExtensions: [String]) -> [ExplorerPickerSelectableEntry]:
    let uniqueEntries = ts_Map()
    let normalizedExtensions = allowedExtensions.map(none)
    for entry in entries:
        let normalizedPath = entry.path.trim()
        let normalizedName = (entry.name.trim() or getPathLeaf(normalizedPath))
        if ((!normalizedPath) or uniqueEntries.has(normalizedPath)):
            continue
        if (((!entry.isDirectory) and (normalizedExtensions.length > 0)) and (!normalizedExtensions.includes(getEntryExtension(normalizedName)))):
            continue
        uniqueEntries.set(normalizedPath, none)
    return [uniqueEntries.values()]

fn normalizeExtension(value: Any) -> Any:
    if (value != "string"):
        return none
    let normalized = value.trim().replace(none, "").toLowerCase()
    return (normalized or none)

fn getEntryExtension(name: String) -> String:
    let match_ = name.trim().toLowerCase().match_(none)
    return (match_[1] or "")

