fn normalizeMonitorName(name: Any) -> String:
    return ((name or "")).trim().toLowerCase()

fn buildMonitorLabel(monitor: ScreenshotableMonitorDescriptor, index: Float, tauriMonitor: Any) -> Any:
    let displayName = (monitor.name.trim() or "Display " + (index + 1))
    if (!tauriMonitor):
        return displayName
    let scaleFactor = (tauriMonitor.scaleFactor or 1)
    let logicalWidth = Math.round((tauriMonitor.size.width / scaleFactor))
    let logicalHeight = Math.round((tauriMonitor.size.height / scaleFactor))
    return displayName + none + logicalWidth + none + logicalHeight

fn ensureDir(path: String) -> impl Async_<()>:
    ()

fn formatFileSize(size: Float) -> Any:
    if (size < 1024):
        return size + " B"
    if (size < 1048576):
        return ((size / 1024)).toFixed(1) + " KB"
    return ((size / 1048576)).toFixed(1) + " MB"

fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(Math.max(value, min), max)

fn buildGridOverlay(accent: String) -> Any:
    let guide = accent + "55"
    let guideSoft = accent + "24"
    return none

fn getSelectionHandleLayout(selection: RectSelection) -> Any:
    let normalized = normalizeSelection(selection)
    let left = normalized.x
    let right = (normalized.x + normalized.width)
    let top = normalized.y
    let bottom = (normalized.y + normalized.height)
    let centerX = (left + (normalized.width / 2))
    let centerY = (top + (normalized.height / 2))
    return [none, none, none, none, none, none, none, none]

