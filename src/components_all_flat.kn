    if (!trimmedName):
        return snapshot
    return none

fn cycleExplorerBookmarkNodeColor(snapshot: ExplorerRailSnapshot, nodeId: String) -> Any:
    return none

fn removeExplorerBookmarkNode(snapshot: ExplorerRailSnapshot, nodeId: String) -> Any:
    let descendantIds = collectDescendantIds(snapshot.nodes, nodeId)
    let idsToRemove = ts_Set([nodeId, descendantIds])
    return none

fn moveExplorerBookmarkNode(snapshot: ExplorerRailSnapshot, nodeId: String, parentId: Any) -> Any:
    let node = snapshot.nodes.find(none)
    if ((!node) or (node.parentId == parentId)):
        return snapshot
    if (parentId and (!snapshot.nodes.some(none))):
        return snapshot
    let invalidParents = ts_Set(collectDescendantIds(snapshot.nodes, nodeId))
    if (parentId and invalidParents.has(parentId)):
        return snapshot
    return none

fn createExplorerCustomCategory(snapshot: ExplorerRailSnapshot, name: String, color: String) -> Any:
    let color: Any = none
    let trimmedName = name.trim()
    if (!trimmedName):
        return none
    let existing = snapshot.customCategories.find(none)
    if existing:
        return none
    let category: Option<Any> = none
    return none

fn upsertExplorerBookmark(snapshot: ExplorerRailSnapshot, source: ExplorerBookmarkImportSource, options: Any) -> Any:
    let options: Any = none
    let parentId = (options.parentId or none)
    let existingNode = snapshot.nodes.find(none)
    let categoryIds = normalizeCategoryIds(none)
    let color = (((options.color or suggestBookmarkColor(categoryIds)) or source.color) or none)
    if existingNode:
        let updatedNode: Option<Any> = none
        return none
    let now = Date.now()
    let node: Option<Any> = none
    return none

fn removeExplorerBookmarksByPath(snapshot: ExplorerRailSnapshot, path: String) -> Any:
    return none

fn planExplorerBookmarkImport(snapshot: ExplorerRailSnapshot, sources: [ExplorerBookmarkImportSource], targetFolderId: Any) -> Any:
    let normalizedSources = sources.filter(none).map(none)
    if (normalizedSources.length == 0):
        return none
    let categoryIds = normalizeCategoryIds(ts_Array.from(ts_Set(normalizedSources.flatMap(none))))
    let suggestedParentId = (targetFolderId or findSuggestedFolderParent(snapshot, categoryIds))
    let suggestedName = none
    let suggestedMode = none
    return none

fn applyExplorerBookmarkImportPlan(snapshot: ExplorerRailSnapshot, plan: ExplorerBookmarkImportPlan, mode: String) -> Any:
    let mode: Any = none
    let nextSnapshot = snapshot
    let parentId = plan.suggestedParentId
    let createdNodes: [ExplorerBookmarkLeafNode] = []
    if (mode == "folder"):
        let folderResult = createExplorerBookmarkFolder(nextSnapshot, none)
        nextSnapshot = folderResult.snapshot
        parentId = folderResult.node.id
    for source in plan.sources:
        let result = upsertExplorerBookmark(nextSnapshot, source, none)
        nextSnapshot = result.snapshot
        if result.created:
            createdNodes.push(result.node)
    return none

fn buildExplorerBookmarkTree(snapshot: ExplorerRailSnapshot, filters: ExplorerRailFilterState) -> [ExplorerBookmarkTreeNode]:
    let filters: Any = none
    let byParent = ts_Map()
    for node in snapshot.nodes:
        let bucket = (byParent.get(node.parentId) or [])
        bucket.push(node)
        byParent.set(node.parentId, bucket)
    let buildChildren = none
    return buildChildren(none, 0)

fn doesBookmarkNodeMatchFilters(node: ExplorerBookmarkNode, filters: ExplorerRailFilterState) -> Any:
    let normalizedQuery = filters.query.trim().toLowerCase()
    let requiresCategoryMatch = (filters.activeCategoryIds.length > 0)
    let categoryMatch = ((!requiresCategoryMatch) or filters.activeCategoryIds.every(none))
    if (!categoryMatch):
        return false
    if (!normalizedQuery):
        return true
    let haystack = [node.name, none].join(" ").toLowerCase()
    return haystack.includes(normalizedQuery)

fn hasActiveExplorerFilters(filters: ExplorerRailFilterState) -> Bool:
    return (ts_Boolean(filters.query.trim()) or (filters.activeCategoryIds.length > 0))

fn inferBookmarkCategoryIds(source: Any, customCategories: [ExplorerBookmarkCategory]) -> [String]:
    let categories = [explorerBookmarkCategoryPresets, customCategories]
    let haystack = source.name + " " + source.path.toLowerCase()
    return normalizeCategoryIds(categories.flatMap(none))

fn suggestBookmarkColor(categoryIds: [String]) -> Any:
    for categoryId in categoryIds:
        let preset = explorerBookmarkCategoryPresets.find(none)
        if preset:
            return preset.color
    return (explorerBookmarkColorOptions[0].value or none)

fn normalizeCustomCategory(value: Any, now: Float) -> Any:
    let source = asRecord(value)
    let id = none
    let name = none
    if (!name):
        return none
    return none

fn normalizeNode(value: Any, now: Float, validCategoryIds: Set<String>) -> Any:
    let source = asRecord(value)
    if (!source):
        return none
    let kind = source.kind
    if ((kind != "folder") and (kind != "bookmark")):
        return none
    let name = none
    if (!name):
        return none
    let base = none
    if (kind == "folder"):
        return none
    let path = none
    if (!path):
        return none
    return none

fn compareBookmarkNodes(a: ExplorerBookmarkNode, b: ExplorerBookmarkNode) -> Any:
    if ((a.kind == "folder") and (b.kind != "folder")):
        return (-1)
    if ((a.kind != "folder") and (b.kind == "folder")):
        return 1
    return a.name.localeCompare(b.name, undefined, none)

fn normalizeCategoryIds(categoryIds: [String]) -> [String]:
    return ts_Array.from(ts_Set(categoryIds.filter(none))).sort()

fn collectDescendantIds(nodes: [ExplorerBookmarkNode], nodeId: String) -> [String]:
    let descendants: [String] = []
    let visit = none
    visit(nodeId)
    return descendants

fn findSuggestedFolderParent(snapshot: ExplorerRailSnapshot, categoryIds: [String]) -> Any:
    if (snapshot.activeCategoryIds.length == 1):
        let match_ = snapshot.nodes.find(none)
        if match_:
            return match_.id
    for categoryId in categoryIds:
        let directMatch = snapshot.nodes.find(none)
        if directMatch:
            return directMatch.id
    return none

fn getLeafNameFromPath(path: String) -> String:
    let parts = path.split(none).filter(ts_Boolean)
    return (parts[(parts.length - 1)] or path)

fn isExplorerRailSectionId(value: Any) -> Any:
    return ((value == "string") and explorerRailSectionOrder.includes(value))

fn createStableId(prefix: String) -> Any:
    let maybeCrypto = none
    if maybeCrypto.randomUUID:
        return prefix + "-" + maybeCrypto.randomUUID()
    return prefix + "-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10)

