fn getResultGroupLabel(result: ExplorerUtilitySearchResult) -> Any:
    let relativePath = getResultRelativePath(result)
    let separatorIndex = Math.max(relativePath.lastIndexOf("/"), relativePath.lastIndexOf(none))
