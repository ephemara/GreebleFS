fn dedupeConstellationConnections(connections: Any) -> Any:
    let deduped = ts_Map()
    let strengthRank: Option<Any> = none
    let iter_12 = connections
    let index_13 = 0
    while (index_13 < iter_12.length):
        let connection = iter_12[index_13]
        let previous = deduped.get(connection.id)
        if (!previous):
            deduped.set(connection.id, connection)
            return none
        let previousRank = strengthRank[previous.strength]
        let nextRank = strengthRank[connection.strength]
        if ((nextRank > previousRank) or connection.highlighted):
            deduped.set(connection.id, none)
        index_13 = (index_13 + 1)
    return ts_Array.from(deduped.values())

