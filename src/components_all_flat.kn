fn md5Round(a: Float, b: Float, c: Float, d: Float, x: Float, s: Float, ac: Float, round: Float, extra: Float) -> Float:
    let extra: Any = none
    let f: Float = none
    if (round < 16):
        f = (((b & c)) | (((~b) & d)))
    else if (round < 32):
        f = (((d & b)) | (((~d) & c)))
    else if (round < 48):
        f = ((b ^ c) ^ d)
    else:
        f = (c ^ ((b | (~d))))
    let rotated = rotateLeft(addUnsigned(addUnsigned(a, f), addUnsigned(x, addUnsigned(ac, extra))), s)
    return addUnsigned(b, rotated)

fn addUnsigned(left: Float, right: Float) -> Float:
    let leftLow = (left & 65535)
    let rightLow = (right & 65535)
    let leftHigh = (left >> 16)
    let rightHigh = (right >> 16)
    let low = (leftLow + rightLow)
    let carry = (low >> 16)
    let high = ((leftHigh + rightHigh) + carry)
    return (((((high & 65535)) << 16)) | ((low & 65535)))

fn rotateLeft(value: Float, bits: Float) -> Float:
    return (((value << bits)) | ((value >> ((32 - bits)))))

fn bytesToMd5Words(bytes: Uint8Array) -> [Float]:
    let words: [Float] = []
    let byteLength = bytes.length
    let index = 0
    while ((index + 4) <= byteLength):
        words.push((((bytes[index] | ((bytes[(index + 1)] << 8))) | ((bytes[(index + 2)] << 16))) | ((bytes[(index + 3)] << 24))))
        index = (index + 4)
    let remaining = (byteLength - index)
    let lastWord = 0
    let offset = 0
    while (offset < remaining):
        lastWord = (lastWord | (bytes[(index + offset)] << ((offset * 8))))
        offset = (offset + 1)
    words.push(lastWord)
    let messageLengthBits = (byteLength * 8)
    words.push(128)
    while (((words.length % 16)) != 14):
        words.push(0)
    words.push((messageLengthBits & 4294967295))
    words.push(Math.floor((messageLengthBits / 4294967296)))
    return words

fn wordsToBytes(words: [Float]) -> Uint8Array:
    let bytes = Uint8Array((words.length * 4))
    let wordIndex = 0
    while (wordIndex < words.length):
        let word = (words[wordIndex] or 0)
        let offset = (wordIndex * 4)
        ()
        ()
        ()
        ()
        wordIndex = (wordIndex + 1)
    return bytes

fn bytesToHex(bytes: Uint8Array) -> String:
    return ts_Array.from(bytes, none).join("")

type ExplorerFileEntry = Any

struct ExplorerJumpFilterState:
    query: String
    active: Bool
    resultIndex: Float

struct ExplorerJumpFilterMatch:
    entry: ExplorerFileEntry
    score: Float
    originalIndex: Float

const PRINTABLE_KEY_PATTERN: Any = "/^.$/"

fn isExplorerJumpFilterPrintableKey(event: Any) -> Bool:
    return (((PRINTABLE_KEY_PATTERN.test_(event.key) and (!event.ctrlKey)) and (!event.metaKey)) and (!event.altKey))

fn appendExplorerJumpFilterCharacter(query: String, key: String) -> String:
    return query + key

fn removeExplorerJumpFilterCharacter(query: String) -> String:
    return query.slice(0, (-1))

fn filterExplorerEntriesForJump(entries: [ExplorerFileEntry], query: String) -> Any:
    let normalizedQuery = query.trim().toLowerCase()
    if (!normalizedQuery):
        return entries
    return entries.map(none).filter(none).sort(none).map(none)

fn scoreExplorerJumpEntry(entry: ExplorerFileEntry, query: String) -> Any:
    let filenameScore = scoreFuzzyText(entry.name.toLowerCase(), query)
    let pathSegments = entry.path.split(none).map(none).filter(ts_Boolean)
    let pathScore = pathSegments.reduce(none, none)
    if ((filenameScore == none) and (pathScore == none)):
        return none
    let filenameWeight = (filenameScore or 0)
    let pathWeight = (pathScore or 0)
    return (((filenameWeight * 3)) + ((pathWeight * 2)))

fn scoreFuzzyText(value: String, query: String) -> Any:
    if (value == query):
        return 10000
    let cursor = 0
    let score = 0
    let previousMatchIndex = (-1)
    for queryChar in query:
        let nextIndex = value.indexOf(queryChar, cursor)
        if (nextIndex < 0):
            return none
        score = (score + 100)
        if (previousMatchIndex >= 0):
            let gap = ((nextIndex - previousMatchIndex) - 1)
            score = (score - Math.min(50, (gap * 3)))
            if (gap == 0):
                score = (score + 35)
        if (nextIndex == cursor):
            score = (score + 12)
        previousMatchIndex = nextIndex
        cursor = (nextIndex + 1)
    score = (score - value.length)
    if value.startsWith(query):
        score = (score + 120)
    if value.includes(query):
        score = (score + 60)
    return score

type CSSProperties = Any

const getFolderIconSrc: Any = none

type FolderIconRule = Any

type FolderIconValue = Any

const getBuiltInIconTheme: Any = none

const resolveFileIconSrc: Any = none

type OverlayResolvedIconTheme = Any

type ExplorerFileEntry = Any

struct ExplorerPreviewFolderIconConfig:
    folderIconRules: Any
    defaultFolderIcon: Any
    iconTheme: Any

struct ExplorerArchivePreviewEntryMetadata:
    originalPath: String
    normalizedPath: String
    name: String
    parentPath: String
    isDirectory: Bool

fn getEffectiveIconTheme(iconTheme: OverlayResolvedIconTheme) -> OverlayResolvedIconTheme:
    return (iconTheme or getBuiltInIconTheme())

fn getExplorerEntryExtension(entry: Any) -> Any:
    if entry.is_dir:
        return ""
    let normalizedExtension = entry.extension.trim().replace(none, "").toLowerCase()
    if normalizedExtension:
        return normalizedExtension
    let lastDotIndex = entry.name.lastIndexOf(".")
    if ((lastDotIndex <= 0) or (lastDotIndex == (entry.name.length - 1))):
        return ""
    return entry.name.slice((lastDotIndex + 1)).toLowerCase()

fn getArchiveEntryExtension(entryName: String) -> Any:
    let lastDotIndex = entryName.lastIndexOf(".")
    if ((lastDotIndex <= 0) or (lastDotIndex == (entryName.length - 1))):
        return ""
    return entryName.slice((lastDotIndex + 1)).toLowerCase()

fn trimArchivePath(path: String) -> String:
    return path.replace(none, "")

fn resolveExplorerPreviewFolderIconSrc(folderPath: String, open: Any, options: ExplorerPreviewFolderIconConfig) -> String:
    let open: Any = none
    let options: Any = none
    let iconTheme = getEffectiveIconTheme(options.iconTheme)
    return getFolderIconSrc(folderPath, open, none)

fn resolveExplorerPreviewEntryIconSrc(entry: Any, options: ExplorerPreviewFolderIconConfig) -> Any:
    let options: Any = none
    let iconTheme = getEffectiveIconTheme(options.iconTheme)
    if entry.is_dir:
        return resolveExplorerPreviewFolderIconSrc(entry.path, false, options)
    return resolveFileIconSrc(entry.name, getExplorerEntryExtension(entry), iconTheme)

fn buildArchivePreviewEntryMetadata(paths: Any) -> [ExplorerArchivePreviewEntryMetadata]:
    let directoryHints = ts_Set()
    for path in paths:
        let normalizedPath = trimArchivePath(path)
        if (!normalizedPath):
            continue
        let segments = normalizedPath.split(none).filter(ts_Boolean)
        let index = 1
        while (index < segments.length):
            directoryHints.add(segments.slice(0, index).join("/"))
            index = (index + 1)
    return paths.map(none).filter(none)

fn resolveArchivePreviewEntryIconSrc(entry: ExplorerArchivePreviewEntryMetadata, options: ExplorerPreviewFolderIconConfig) -> Any:
    let options: Any = none
    let iconTheme = getEffectiveIconTheme(options.iconTheme)
    if entry.isDirectory:
        return resolveExplorerPreviewFolderIconSrc(entry.normalizedPath, false, options)
    return resolveFileIconSrc(entry.name, getArchiveEntryExtension(entry.name), iconTheme)

