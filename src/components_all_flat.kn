const BUILT_IN_EXPLORER_PREVIEW_LANE_PRIORITY: Any = 100

const FIRST_PARTY_WORKBENCH_PLUGIN_ID_PREFIX: Any = "greeblefs-workbench-"

const BUILT_IN_EXPLORER_PREVIEW_LANES: Any = [none, none, none, none, none, none, none, none, none, none, none, none, none]

fn resolveExplorerPreviewDescriptor(entry: FileEntry, options: ExplorerPreviewResolverOptions) -> ExplorerResolvedPreviewDescriptor:
    return ((resolveExplorerPreviewWorkbenchSelection(entry, options).activeWorkbench.descriptor or none))

fn resolveExplorerPreviewWorkbenchSelection(entry: FileEntry, options: ExplorerPreviewResolverOptions) -> Any:
    let extension = getExplorerPreviewEntryExtension(entry)
    let matchContext: Option<Any> = none
    let candidates = coalesceFirstPartyExplorerPreviewWorkbenchCandidates(buildRegisteredExplorerPreviewLanes(options).map(none).filter(none))
    if (candidates.length == 0):
        return none
    let preferredWorkbenchId = (options.preferredWorkbenchId.trim() or "")
    if preferredWorkbenchId:
        let preferredCandidate = candidates.find(none)
        if preferredCandidate:
            return none
    let activeWorkbench = candidates[0]
    let nextCandidate = (candidates[1] or none)
    return none

fn getExplorerPreviewEntryExtension(entry: Any) -> Any:
    if entry.is_dir:
        return ""
    let extension = entry.extension.trim().replace(none, "").toLowerCase()
    if extension:
        return extension
    let lastDotIndex = entry.name.lastIndexOf(".")
    if ((lastDotIndex <= 0) or (lastDotIndex == (entry.name.length - 1))):
        return ""
    return entry.name.slice((lastDotIndex + 1)).toLowerCase()

fn isInlineExplorerPreviewDescriptor(descriptor: ExplorerResolvedPreviewDescriptor) -> Bool:
    return (descriptor.kind != "unsupported")

fn buildRegisteredExplorerPreviewLanes(options: ExplorerPreviewResolverOptions) -> [ExplorerPreviewLaneDefinition]:
    let pluginPreviewLanes = ((options.pluginPreviewLanes or [])).map(createPluginExplorerPreviewLaneDefinition)
    return [pluginPreviewLanes, BUILT_IN_EXPLORER_PREVIEW_LANES].map(none).sort(none).map(none)

fn createPluginExplorerPreviewLaneDefinition(lane: OverlayPluginPreviewLaneContribution) -> Any:
    return none

fn coalesceFirstPartyExplorerPreviewWorkbenchCandidates(candidates: [ExplorerResolvedPreviewWorkbenchCandidate]) -> Any:
    let firstPartyDelegateKinds = ts_Set()
    for candidate in candidates:
        let descriptor = candidate.descriptor
        if (((descriptor.kind == "plugin") and isFirstPartyExplorerWorkbenchPluginLane(descriptor.lane)) and descriptor.delegateDescriptor):
            firstPartyDelegateKinds.add(descriptor.delegateDescriptor.kind)
    if (firstPartyDelegateKinds.size == 0):
        return candidates
    return candidates.filter(none)

fn getPluginExplorerPreviewLaneDisplayTitle(lane: OverlayPluginPreviewLaneContribution) -> Any:
    if (isFirstPartyExplorerWorkbenchPluginLane(lane) or (lane.pluginName.trim() == lane.title.trim())):
        return lane.title
    return lane.pluginName + ": " + lane.title

fn isFirstPartyExplorerWorkbenchPluginLane(lane: Any) -> Bool:
    return lane.pluginId.trim().toLowerCase().startsWith(FIRST_PARTY_WORKBENCH_PLUGIN_ID_PREFIX)

fn matchesOverlayPluginPreviewLane(entry: FileEntry, extension: String, lane: OverlayPluginPreviewLaneContribution, builtInDelegateDescriptor: Any) -> Any:
    if (!matchesOverlayPluginPreviewLaneAppliesTo(entry, lane)):
        return false
    let hasExtensionRules = (lane.match_.extensions.length > 0)
    let hasFileNameRules = (lane.match_.fileNames.length > 0)
    let hasPreviewKindRules = (lane.match_.previewKinds.length > 0)
    if (((!hasExtensionRules) and (!hasFileNameRules)) and (!hasPreviewKindRules)):
        return true
    if (hasPreviewKindRules and (((!builtInDelegateDescriptor) or (!lane.match_.previewKinds.includes(builtInDelegateDescriptor.kind))))):
        return false
    if (hasExtensionRules and (!lane.match_.extensions.includes(extension.toLowerCase()))):
        return false
    if (hasFileNameRules and (!lane.match_.fileNames.includes(entry.name.trim().toLowerCase()))):
        return false
    return true

fn matchesOverlayPluginPreviewLaneAppliesTo(entry: FileEntry, lane: OverlayPluginPreviewLaneContribution) -> Bool:
    if (lane.match_.appliesTo == "any"):
        return true
    else if (lane.match_.appliesTo == "directory"):
        return entry.is_dir
    else if (lane.match_.appliesTo == "file"):
        return (!entry.is_dir)

fn resolveBuiltInExplorerPreviewDescriptor(context: ExplorerPreviewMatchContext) -> Any:
    for lane in BUILT_IN_EXPLORER_PREVIEW_LANES:
        let descriptor = lane.match_(context)
        if descriptor:
            return descriptor
    return none

