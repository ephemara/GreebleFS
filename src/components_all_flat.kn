    return (left - right)

fn scoreFuzzySubsequence(candidate: String, query: String) -> Any:
    let score = 0
    let queryIndex = 0
    let consecutiveMatches = 0
    let candidateIndex = 0
    while (candidateIndex < candidate.length):
        if (queryIndex >= query.length):
            break
        if (candidate[candidateIndex] != query[queryIndex]):
            consecutiveMatches = 0
            continue
        let previousCharacter = (candidate[(candidateIndex - 1)] or "")
        let isBoundaryMatch = ((candidateIndex == 0) or none.test_(previousCharacter))
        score = (score + ((8 + (consecutiveMatches * 6)) + (none)))
        consecutiveMatches = (consecutiveMatches + 1)
        queryIndex = (queryIndex + 1)
        candidateIndex = (candidateIndex + 1)
    if (queryIndex != query.length):
        return none
    return ((90 + score) - Math.max((candidate.length - query.length), 0))

fn scoreSearchField(fieldValue: Any, normalizedToken: String) -> Any:
    let candidate = fieldValue.trim().toLowerCase()
    if (!candidate):
        return none
    if (candidate == normalizedToken):
        return 260
    if candidate.startsWith(normalizedToken):
        return (220 - Math.min((candidate.length - normalizedToken.length), 28))
    let containsIndex = candidate.indexOf(normalizedToken)
    if (containsIndex >= 0):
        let previousCharacter = (candidate[(containsIndex - 1)] or "")
        let isBoundaryMatch = ((containsIndex == 0) or none.test_(previousCharacter))
        return ((176 - Math.min(containsIndex, 48)) + (none))
    return scoreFuzzySubsequence(candidate, normalizedToken)

fn scoreCommandPaletteAction(action: OverlayCommandPaletteAction, normalizedTokens: [String]) -> Any:
    if (normalizedTokens.length == 0):
        return 0
    let actionKindLabel = getCommandPaletteActionKindLabel(action.kind)
    let totalScore = 0
    for token in normalizedTokens:
        let titleScore = scoreSearchField(action.title, token)
        let subtitleScore = scoreSearchField(action.subtitle, token)
        let groupScore = scoreSearchField(action.group, token)
        let kindScore = scoreSearchField(actionKindLabel, token)
        let keywordScores = ((action.keywords or [])).map(none).filter(none).map(none)
        let bestScore = Math.max((titleScore or ts_Number.NEGATIVE_INFINITY), none, none, none, none)
        if (!ts_Number.isFinite(bestScore)):
            return none
        totalScore = (totalScore + bestScore)
    return totalScore

fn actionMatchesQuickFilter(actionEntry: ScoredCommandPaletteAction, quickFilterId: OverlayCommandPaletteQuickFilterId) -> Any:
    if (quickFilterId == "pinned"):
        return actionEntry.isPinned
    else if (quickFilterId == "recent"):
        return actionEntry.isRecent
    else if (quickFilterId == "commands"):
        return (((actionEntry.action.kind or "command")) == "command")
    else if (quickFilterId == "files"):
        return (actionEntry.action.kind == "file")
    else if (quickFilterId == "panels"):
        return (actionEntry.action.kind == "panel")
    else if (quickFilterId == "plugins"):
        return (actionEntry.action.kind == "plugin")
    else if (quickFilterId == "all"):
        ()
    else:
        return true

fn resolveEmptyStateMessage(quickFilterId: OverlayCommandPaletteQuickFilterId, quickFilterLabel: String, query: String, hasPinnedActions: Bool, hasRecentActions: Bool) -> Any:
    if (((quickFilterId == "pinned") and (!hasPinnedActions)) and (query.trim().length == 0)):
        return "Pin commands to keep your daily drivers at the top."
    if (((quickFilterId == "recent") and (!hasRecentActions)) and (query.trim().length == 0)):
        return "Run a few commands and they will appear here."
    if (query.trim().length > 0):
        return "No matches in " + quickFilterLabel.toLowerCase() + ". Try a shorter query or switch scope."
    return "No matching actions."

