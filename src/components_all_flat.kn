type GitFileKind = String

struct GitFileStatus:
    file: String
    originalFile: Any
    statusText: String
    stagedCode: String
    unstagedCode: String
    isStaged: Bool
    hasUnstagedChanges: Bool
    isUntracked: Bool
    kind: GitFileKind
    stagedAdditions: Float
    stagedDeletions: Float
    unstagedAdditions: Float
    unstagedDeletions: Float
    additions: Float
    deletions: Float

struct GitNumstatEntry:
    path: String
    additions: Float
    deletions: Float
    isBinary: Bool

struct GitSummary:
    totalFiles: Float
    stagedFiles: Float
    unstagedFiles: Float
    untrackedFiles: Float
    conflictedFiles: Float
    additions: Float
    deletions: Float

const EMPTY_STATS: Any = none

fn parseGitStatus(output: String) -> [GitFileStatus]:
    return output.split(none).map(none).filter(ts_Boolean).map(none).sort(none)

fn parseGitNumstat(output: String) -> [GitNumstatEntry]:
    return output.split(none).map(none).filter(ts_Boolean).map(none).filter(none)

fn mergeGitStatusWithStats(statuses: [GitFileStatus], unstagedStats: [GitNumstatEntry], stagedStats: [GitNumstatEntry]) -> [GitFileStatus]:
    let unstagedMap = buildStatsMap(unstagedStats)
    let stagedMap = buildStatsMap(stagedStats)
    return statuses.map(none)

fn summarizeGitFiles(files: [GitFileStatus]) -> GitSummary:
    return files.reduce(none, none)

fn deriveGitFileKind(statusText: String) -> Any:
    if (statusText == "??"):
        return "untracked"
    let codes = ts_Set(statusText.trim().split(""))
    if codes.has("U"):
        return "conflicted"
    if codes.has("R"):
        return "renamed"
    if codes.has("C"):
        return "copied"
    if codes.has("D"):
        return "deleted"
    if codes.has("A"):
        return "added"
    return "modified"

fn buildStatsMap(entries: [GitNumstatEntry]) -> Map<String, Any>:
    let map = ts_Map()
    for entry in entries:
        let key = normalizeGitPath(entry.path)
        let current = (map.get(key) or EMPTY_STATS)
        map.set(key, none)
    return map

fn sumStatsForPaths(map: Map<String, Any>, paths: [String]) -> Any:
    let seen = ts_Set()
    return paths.reduce(none, none)

fn splitGitRenamePath(rawPath: String) -> Any:
    if (!rawPath.includes(" -> ")):
        return [none, normalizeGitPath(rawPath)]
    let _ = rawPath.split(none, 2)
    let from: Any = none
    let to: Any = none
    return [normalizeGitPath(from), normalizeGitPath(to)]

fn normalizeGitPath(path: String) -> String:
    return unquoteGitPath(path).replace(none, "/")

fn unquoteGitPath(path: String) -> Any:
    if (path.startsWith(none) and path.endsWith(none)):
        return path.slice(1, (-1)).replace(none, none)
    return path

