    if (window == "undefined"):
        return sourcePath

fn audioBufferToWav(buf: AudioBuffer) -> Blob:
    let numCh = buf.numberOfChannels
    let length = (((buf.length * numCh) * 2) + 44)
    let ab = ArrayBuffer(length)
    let view = DataView(ab)
    let channels: [Float32Array] = []
    let pos = 0
    let u16 = none
    let u32 = none
    u32(1179011410)
    u32((length - 8))
    u32(1163280727)
    u32(544501094)
    u32(16)
    u16(1)
    u16(numCh)
    u32(buf.sampleRate)
    u32(((buf.sampleRate * 2) * numCh))
    u16((numCh * 2))
    u16(16)
    u32(1635017060)
    u32(((length - pos) - 4))
    let i = 0
    while (i < numCh):
        channels.push(buf.getChannelData(i))
        i = (i + 1)
    let offset = 0
    while (pos < length):
        let i = 0
        while (i < numCh):
            let s = clamp(channels[i][offset], (-1), 1)
            let int_ = ((none) | 0)
            view.setInt16(pos, int_, true)
            pos = (pos + 2)
            i = (i + 1)
        offset = (offset + 1)
    return Blob([ab], none)

