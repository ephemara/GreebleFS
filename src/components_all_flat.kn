fn isPointWithinElementRect(element: HTMLElement, point: Any) -> Any:
    let rect = getExplorerCachedElementRect(element)
    let hasUsableRect = ((((((rect.width > 0) or (rect.height > 0)) or (rect.left != 0)) or (rect.top != 0)) or (rect.right != 0)) or (rect.bottom != 0))
    if (!hasUsableRect):
        return true
    return (((((point.x >= rect.left) and (point.x <= rect.right)) and (point.y >= rect.top)) and (point.y <= rect.bottom)))

fn normalizeExplorerDropPoint(pointer: ExplorerDropPointerLike, scaleFactor: Float) -> Any:
    let safeScaleFactor = none
    if (pointer.toLogical == "function"):
        return pointer.toLogical(safeScaleFactor)
    return none

fn getExplorerDropSurfaceBehavior(surfaceId: Any) -> Any:
    if (!surfaceId):
        return none
    return (explorerDropSurfaceBehaviorById.get(surfaceId) or none)

fn stabilizeExplorerPaths(nextPaths: Any) -> Any:
    let currentPaths = explorerDragInteractionState.paths
    if ((currentPaths.length == nextPaths.length) and currentPaths.every(none)):
        return currentPaths
    return [nextPaths]

fn stabilizeExplorerDragAvatarStackItems(nextItems: Any) -> Any:
    let currentItems = explorerDragInteractionState.sourceStackItems
    if ((currentItems.length == nextItems.length) and currentItems.every(none)):
        return currentItems
    return nextItems.map(none)

fn getExplorerDragPresentationTargetPoint(hit: Any) -> Any:
    let targetElement = ((hit.targetElement or hit.scopeElement) or none)
    if targetElement:
        return getElementCenterPoint(targetElement)
    return (hit.point or none)

fn resolveExplorerScopeElement(scopeId: String) -> Any:
    let scopeRootSurfaceId = (explorerDropScopeRootSurfaceIdByScopeId.get(scopeId) or none)
    if scopeRootSurfaceId:
        return (explorerDropSurfaceElementById.get(scopeRootSurfaceId) or none)
    let selector = "[" + EXPLORER_DROP_SURFACE_ROLE_ATTRIBUTE + none + EXPLORER_DROP_SCOPE_ATTRIBUTE + none + CSS.escape(scopeId) + none
    let element = document.querySelector(selector)
    return none

fn getSurfaceMetadataFromElement(element: HTMLElement) -> Any:
    let registeredMetadata = (explorerDropSurfaceMetadataByElement.get(element) or none)
    if registeredMetadata:
        return registeredMetadata
    let surfaceId = element.getAttribute(EXPLORER_DROP_SURFACE_ID_ATTRIBUTE)
    if surfaceId:
        let cachedMetadata = (explorerDropSurfaceMetadataById.get(surfaceId) or none)
        if cachedMetadata:
            return cachedMetadata
    let scopeId = element.getAttribute(EXPLORER_DROP_SCOPE_ATTRIBUTE)
    let role = element.getAttribute(EXPLORER_DROP_SURFACE_ROLE_ATTRIBUTE)
    if (((!surfaceId) or (!scopeId)) or (!role)):
        return none
    return none

fn registerExplorerScopeRootSurface(surfaceId: String, previousMetadata: Any, nextMetadata: Any) -> ():
    if ((previousMetadata.role == "scope-root") and (explorerDropScopeRootSurfaceIdByScopeId.get(previousMetadata.scopeId) == surfaceId)):
        explorerDropScopeRootSurfaceIdByScopeId.delete_(previousMetadata.scopeId)
    if (nextMetadata.role == "scope-root"):
        explorerDropScopeRootSurfaceIdByScopeId.set(nextMetadata.scopeId, surfaceId)

fn resolveDropHitFromSurfaceMetadata(args: Any) -> Any:
    let _ = args
    let metadata: Any = none
    let point: Any = none
    let targetElement: Any = none
    if (!metadata):
        return none
    if ((metadata.role == "directory-target") and metadata.targetPath):
        return none
    if ((metadata.role == "navigation-target") and metadata.targetPath):
        return none
    if ((metadata.role == "scope-root") and metadata.rootPath):
        return none
    return none

fn clearExplorerDragAutoOpenState() -> ():
    if (explorerDragAutoOpenTimer != none):
        clearTimeout(explorerDragAutoOpenTimer)
        explorerDragAutoOpenTimer = none
    if ((explorerDragAutoOpenFrame != none) and (cancelAnimationFrame == "function")):
        cancelAnimationFrame(explorerDragAutoOpenFrame)
        explorerDragAutoOpenFrame = none
    explorerDragAutoOpenStartedAt = 0

fn updateExplorerDragDwellState(args: Any) -> ():
    setExplorerDragInteractionState(none)

fn scheduleExplorerDragAutoOpen(hit: Any) -> Any:
    let behavior = getExplorerDropSurfaceBehavior(hit.surfaceId)
    if ((!hit) or (!behavior.onAutoOpen)):
        clearExplorerDragAutoOpenState()
        updateExplorerDragDwellState(none)
        return none
    let configuredDelay = ((behavior.autoOpenDelayMs or explorerAutoOpenDelayMsByRole[hit.surfaceRole]) or (none))
    if ((!configuredDelay) or (configuredDelay <= 0)):
        clearExplorerDragAutoOpenState()
        updateExplorerDragDwellState(none)
        return none
    if ((explorerDragInteractionState.dwellSurfaceId == hit.surfaceId) and (explorerDragAutoOpenTimer != none)):
        return none
    clearExplorerDragAutoOpenState()
    explorerDragAutoOpenStartedAt = Date.now()
    updateExplorerDragDwellState(none)
    let tick = none
    if (requestAnimationFrame == "function"):
        explorerDragAutoOpenFrame = requestAnimationFrame(tick)
    explorerDragAutoOpenTimer = setTimeout(none, configuredDelay)

fn getExplorerDropSurfaceCandidates(startElement: Any) -> [HTMLElement]:
    let candidates: [HTMLElement] = []
    let currentElement = startElement
    while ts_instanceof_operator(currentElement, HTMLElement):
        if (currentElement.hasAttribute(EXPLORER_DROP_SURFACE_ROLE_ATTRIBUTE) and currentElement.hasAttribute(EXPLORER_DROP_SCOPE_ATTRIBUTE)):
            candidates.push(currentElement)
        currentElement = currentElement.parentElement
    return candidates

fn resolveExplorerDropHitFromCandidateElements(args: Any) -> Any:
    let bestHit: Option<Any> = none
    let bestPriority = (-1)
    for candidate in args.candidates:
        if (args.enforcePointContainment and (!isPointWithinElementRect(candidate, args.point))):
            continue
        let metadata = getSurfaceMetadataFromElement(candidate)
        let hit = resolveDropHitFromSurfaceMetadata(none)
        if (!hit):
            continue
        let priority = (explorerDropSurfacePriority[hit.surfaceRole] or 0)
        if (priority > bestPriority):
            bestPriority = priority
            bestHit = hit
    return bestHit

fn getElementCenterPoint(element: HTMLElement) -> Any:
    let rect = getExplorerCachedElementRect(element)
    return none

fn clearExplorerCachedElementRects() -> ():
    if ((explorerElementRectCacheClearFrame != none) and (cancelAnimationFrame == "function")):
        cancelAnimationFrame(explorerElementRectCacheClearFrame)
    explorerElementRectCacheClearFrame = none
    explorerElementRectCacheEnabled = false
    explorerElementRectCache = WeakMap()

fn scheduleExplorerCachedElementRectReset() -> Any:
    if (explorerElementRectCacheClearFrame != none):
        return none
    if (requestAnimationFrame != "function"):
        explorerElementRectCacheEnabled = false
        return none
    explorerElementRectCacheClearFrame = requestAnimationFrame(none)

fn getExplorerCachedElementRect(element: HTMLElement) -> Any:
    if (!explorerElementRectCacheEnabled):
        explorerElementRectCacheEnabled = true
        scheduleExplorerCachedElementRectReset()
    let cachedRect = explorerElementRectCache.get(element)
    if cachedRect:
        return cachedRect
    let nextRect = element.getBoundingClientRect()
    explorerElementRectCache.set(element, nextRect)
    return nextRect

fn clearExplorerResolvedDropHitCache() -> ():
    explorerLastResolvedDropHit = none

fn tryResolveExplorerDropHitFromCachedTarget(point: Any) -> Any:
    let cachedHit = explorerLastResolvedDropHit
    let cachedTargetElement = (cachedHit.targetElement or none)
    if (((!(ts_instanceof_operator(cachedTargetElement, HTMLElement))) or (!cachedTargetElement.isConnected)) or (!isPointWithinElementRect(cachedTargetElement, point))):
        return none
    return resolveDropHitFromSurfaceMetadata(none)

fn resolveLegacyExplorerDropHitFromElement(element: HTMLElement, point: Any) -> Any:
    let legacyScopeElement = element.closest("[" + EXPLORER_DROP_SCOPE_ATTRIBUTE + "]")
    if (!legacyScopeElement):
        return none
    let legacyScopeId = legacyScopeElement.getAttribute(EXPLORER_DROP_SCOPE_ATTRIBUTE)
    if (!legacyScopeId):
        return none
    let legacyTargetElement = element.closest("[" + EXPLORER_DROP_TARGET_ATTRIBUTE + "]")
    let legacyTargetPath = legacyTargetElement.getAttribute(EXPLORER_DROP_TARGET_ATTRIBUTE)
    if (legacyTargetElement and legacyTargetPath):
        return none
    let legacyRootPath = legacyScopeElement.getAttribute(EXPLORER_DROP_SCOPE_ROOT_PATH_ATTRIBUTE)
    if (!legacyRootPath):
        return none
    return none

fn resolveExplorerDropHitFromElement(element: Any) -> Any:
    if (!(ts_instanceof_operator(element, HTMLElement))):
        return none
    let point = getElementCenterPoint(element)
    let candidates = getExplorerDropSurfaceCandidates(element)
    if (candidates.length > 0):
        return resolveExplorerDropHitFromCandidateElements(none)
    return resolveLegacyExplorerDropHitFromElement(element, point)

fn resolveExplorerDropHitFromPoint(pointer: ExplorerDropPointerLike, scaleFactor: Any) -> Any:
    let scaleFactor: Any = none
    if ((document == "undefined") or (document.elementFromPoint != "function")):
        return none
    let point = normalizeExplorerDropPoint(pointer, scaleFactor)
    let cachedHit = tryResolveExplorerDropHitFromCachedTarget(point)
    if cachedHit:
        explorerLastResolvedDropHit = cachedHit
        return cachedHit
    let elementAtPointer = document.elementFromPoint(point.x, point.y)
    if (!(ts_instanceof_operator(elementAtPointer, HTMLElement))):
        clearExplorerResolvedDropHitCache()
        return none
    let candidates = getExplorerDropSurfaceCandidates(elementAtPointer)
    if (candidates.length == 0):
        let legacyHit = resolveLegacyExplorerDropHitFromElement(elementAtPointer, point)
        explorerLastResolvedDropHit = none
        return legacyHit
    let resolvedHit = resolveExplorerDropHitFromCandidateElements(none)
    explorerLastResolvedDropHit = none
    return resolvedHit

fn normalizeExplorerComparablePath(path: String, platform: RuntimePlatform) -> Any:
    let collapsed = path.replace(none, "/").replace(none, "")
    return none

fn getExplorerParentComparablePath(path: String, platform: RuntimePlatform) -> Any:
    let normalizedPath = normalizeExplorerComparablePath(path, platform)
    let parts = normalizedPath.split("/").filter(ts_Boolean)
    parts.pop()
    if (parts.length == 0):
        return none
    return none

fn validateExplorerDropTarget(args: Any) -> Any:
    let normalizedTargetPath = normalizeExplorerComparablePath(args.targetPath, args.platform)
    let platformValidationContext = (explorerDropValidationContextByPaths.get(args.sourcePaths).get(args.platform) or none)
    if (!platformValidationContext):
        let normalizedSourcePaths = args.sourcePaths.map(none)
        platformValidationContext = none
        let contextByPlatform = (explorerDropValidationContextByPaths.get(args.sourcePaths) or ts_Map())
        contextByPlatform.set(args.platform, platformValidationContext)
        explorerDropValidationContextByPaths.set(args.sourcePaths, contextByPlatform)
    let _ = platformValidationContext
    let normalizedSourcePaths: Any = none
    let uniqueParentPaths: Any = none
    if normalizedSourcePaths.some(none):
        return none
    if normalizedSourcePaths.some(none):
        return none
    if ((uniqueParentPaths.size == 1) and uniqueParentPaths.has(normalizedTargetPath)):
        return none
    return none

fn startExplorerSharedDragSession(args: Any) -> ():
    clearExplorerSharedDragSessionExpiryTimer()
    explorerSharedDragSession = none

fn settleExplorerSharedDragSessionAfterDragEnd(intent: ExplorerDragIntent, lingerMs: Any) -> Any:
    let lingerMs: Any = none
    if (!explorerSharedDragSession):
        return none
    if (intent != "native-out"):
        clearExplorerSharedDragSession()
        return none
    let durationMs = none
    explorerSharedDragSession = none
    scheduleExplorerSharedDragSessionExpiry(durationMs)

fn clearExplorerSharedDragSession() -> ():
    clearExplorerSharedDragSessionExpiryTimer()
    explorerSharedDragSession = none

fn getExplorerSharedDragSession() -> Any:
    if ((explorerSharedDragSession and (explorerSharedDragSession.expiresAt != none)) and (explorerSharedDragSession.expiresAt <= Date.now())):
        clearExplorerSharedDragSession()
        return none
    return none

fn readExplorerPathsFromDataTransfer(args: Any) -> Any:
    let _ = args
    let dataTransfer: Any = none
    let fallbackPaths: Any = none
    let normalizedFallbackPaths = fallbackPaths.filter(none)
    if ((!dataTransfer) or (dataTransfer.getData != "function")):
