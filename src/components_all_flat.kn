    let targetSize: Any = none
    let root = THREE.Group()
    let wrapper = THREE.Group()
    wrapper.name = (object.name or "model") + "-normalized"
    wrapper.rotation.copy(getModelPreviewRotation(format))
    wrapper.add(object)
    root.add(wrapper)
    wrapper.updateWorldMatrix(true, true)
    let initialBounds = THREE.Box3().setFromObject(root)
    if initialBounds.isEmpty():
        return root
    let initialSize = initialBounds.getSize(THREE.Vector3())
    let maxDimension = Math.max(initialSize.x, initialSize.y, initialSize.z, 0.001)
    let scale = (targetSize / maxDimension)
    wrapper.scale.setScalar(scale)
    wrapper.updateWorldMatrix(true, true)
    let normalizedBounds = THREE.Box3().setFromObject(root)
    let center = normalizedBounds.getCenter(THREE.Vector3())
    wrapper.position.x = (wrapper.position.x - center.x)
    wrapper.position.z = (wrapper.position.z - center.z)
    wrapper.position.y = (wrapper.position.y - normalizedBounds.min.y)
    wrapper.updateWorldMatrix(true, true)
    root.userData.previewScale = scale
    root.userData.previewRotation = wrapper.rotation.toArray()
    return root

fn collectNormalizedBounds(object: THREE_Object3D) -> THREE_Box3:
    object.updateWorldMatrix(true, true)
    return THREE.Box3().setFromObject(object)

fn applyModelPreviewFallbackMaterials(object: THREE_Object3D):
    object.traverse(none)

type DisposablePreviewObject = Any

fn disposeModelPreviewObject(object: THREE_Object3D):
    object.traverse(none)

fn parseDiffuseTexturePath(path: String) -> String:
    return path.replace(none, "/")

const THREE: Any = none

const FBXLoader: Any = none

const GLTFLoader: Any = none

const MeshoptDecoder: Any = none

const OBJLoader: Any = none

const STLLoader: Any = none

const MODEL_PREVIEW_SOURCE_CONFIG: Any = none

type ModelPreviewFormat = Any

const detectClientPlatform: Any = none

const getPlatformPathSeparator: Any = none

const joinPlatformPath: Any = none

const readExplorerPreviewBytes: Any = none

type GltfResourceCollection = Any

type PreparedGltfContent = Any

const MODEL_PREVIEW_TEXTURE_MIME_TYPE_BY_EXTENSION: Option<Any> = none

const MODEL_PREVIEW_TEXT_DECODER: Any = TextDecoder("utf-8")

fn loadModelPreviewObject(format: ModelPreviewFormat, sourcePath: String) -> impl Async_<THREE_Object3D>:
    if (format == "glb"):
        return loadGlbPreviewObject(sourcePath)
    else if (format == "gltf"):
        return loadGltfPreviewObject(sourcePath)
    else if (format == "obj"):
        return loadObjPreviewObject(sourcePath)
    else if (format == "fbx"):
        return loadFbxPreviewObject(sourcePath)
    else if (format == "stl"):
        return loadStlPreviewObject(sourcePath)
    else:
        ()

fn loadGlbPreviewObject(sourcePath: String) -> impl Async_<THREE_Object3D>:
    let loader = createGltfLoader()
    let bytes = (await readModelPreviewBytes(sourcePath, MODEL_PREVIEW_SOURCE_CONFIG.maxRootSourceBytes))
    let asset = (await parseGltfAsync(loader, toArrayBuffer(bytes)))
    return (asset.scene or asset.scenes[0])

fn loadGltfPreviewObject(sourcePath: String) -> impl Async_<THREE_Object3D>:
    let loader = createGltfLoader()
    let sourceBytes = (await readModelPreviewBytes(sourcePath, MODEL_PREVIEW_SOURCE_CONFIG.maxRootSourceBytes))
    let preparedContent = (await inlineGltfExternalResources(decodePreviewText(sourceBytes), sourcePath))

fn loadObjPreviewObject(sourcePath: String) -> impl Async_<THREE_Object3D>:
    let loader = OBJLoader()
    let bytes = (await readModelPreviewBytes(sourcePath, MODEL_PREVIEW_SOURCE_CONFIG.maxRootSourceBytes))
    return loader.parse(decodePreviewText(bytes))

fn loadFbxPreviewObject(sourcePath: String) -> impl Async_<THREE_Object3D>:
    let loader = FBXLoader()
    let bytes = (await readModelPreviewBytes(sourcePath, MODEL_PREVIEW_SOURCE_CONFIG.maxRootSourceBytes))
    return parseFbxAsync(loader, toArrayBuffer(bytes))

fn loadStlPreviewObject(sourcePath: String) -> impl Async_<THREE_Object3D>:
    let loader = STLLoader()
    let bytes = (await readModelPreviewBytes(sourcePath, MODEL_PREVIEW_SOURCE_CONFIG.maxRootSourceBytes))
    let geometry = loader.parse(toArrayBuffer(bytes))
    geometry.computeBoundingBox()
    geometry.computeVertexNormals()
    return THREE.Mesh(geometry, THREE.MeshStandardMaterial(none))

fn createGltfLoader() -> GLTFLoader:
    let loader = GLTFLoader()
    loader.setMeshoptDecoder(MeshoptDecoder)
    return loader

fn inlineGltfExternalResources(content: String, sourcePath: String) -> Any:
    let gltf = JSON.parse(content)
    let sourceDirectory = getParentDirectory(sourcePath)
    if (!sourceDirectory):
        return none
    let objectUrlCache = ts_Map()
    let trackedObjectUrls = ts_Set()
    (await ts_Promise.all([inlineGltfResourceCollection(gltf.buffers, sourceDirectory, objectUrlCache, trackedObjectUrls), inlineGltfResourceCollection(gltf.images, sourceDirectory, objectUrlCache, trackedObjectUrls)]))
    return none

fn inlineGltfResourceCollection(entries: GltfResourceCollection, sourceDirectory: String, objectUrlCache: Map<String, Async_<String>>, trackedObjectUrls: Set<String>) -> Any:
    if (!entries.length):
        return none
    (await ts_Promise.all(entries.map(none)))

fn resolvePreviewObjectUrl(uri: String, sourceDirectory: String, objectUrlCache: Map<String, Async_<String>>, trackedObjectUrls: Set<String>) -> Any:
    if isAbsolutePreviewResourceUrl(uri):
        return none
    let _ = (uri.match_("/^([^?#]+)/") or [])
    let relativePath: Any = none
    if (!relativePath):
        return none
    let resolvedPath = resolvePreviewRelativePath(sourceDirectory, relativePath)
    let cachedObjectUrl = objectUrlCache.get(resolvedPath)
    if cachedObjectUrl:
        return cachedObjectUrl
    let objectUrlPromise = readModelPreviewBytes(resolvedPath, MODEL_PREVIEW_SOURCE_CONFIG.maxGltfExternalResourceBytes).then(none).catch_(none)
    objectUrlCache.set(resolvedPath, objectUrlPromise)
    return objectUrlPromise

fn readModelPreviewBytes(path: String, maxBytes: Float) -> impl Async_<Uint8Array>:
    return readExplorerPreviewBytes(path, maxBytes)

fn decodePreviewText(bytes: Uint8Array) -> String:
    return MODEL_PREVIEW_TEXT_DECODER.decode(bytes)

fn toArrayBuffer(bytes: Uint8Array) -> ArrayBuffer:
    return bytes.buffer.slice(bytes.byteOffset, (bytes.byteOffset + bytes.byteLength))

fn getPreviewBlobMimeType(path: String) -> String:
    let extension = (path.split(".").pop().toLowerCase() or "")
    return ((MODEL_PREVIEW_TEXTURE_MIME_TYPE_BY_EXTENSION[extension] or "application/octet-stream"))

fn resolvePreviewRelativePath(sourceDirectory: String, relativePath: String) -> Any:
    let platform = detectClientPlatform()
    let separator = getPlatformPathSeparator(platform)
    let normalizedRelativePath = relativePath.replace(none, separator)
    if (sourceDirectory == "/"):
        return "/" + normalizedRelativePath
    return joinPlatformPath(sourceDirectory, normalizedRelativePath, platform)

fn getParentDirectory(path: String) -> Any:
    let normalizedPath = path.replace(none, "/")
    let lastSlashIndex = normalizedPath.lastIndexOf("/")
    if (lastSlashIndex < 0):
        return ""
    if (lastSlashIndex == 0):
        return "/"
    return path.slice(0, lastSlashIndex)

fn isAbsolutePreviewResourceUrl(url: String) -> Bool:
    return (none.test_(url) or none.test_(url))

fn parseGltfAsync(loader: GLTFLoader, data: Any) -> Any:
    return ts_Promise(none)

fn parseFbxAsync(loader: FBXLoader, data: ArrayBuffer) -> Any:
    return ts_Promise(none)

