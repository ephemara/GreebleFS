        let green = (data[(offset + 1)] or 0)
        let blue = (data[(offset + 2)] or 0)
        let alpha = (data[(offset + 3)] or 0)
        let luma = Math.max(red, green, blue)
        let channelSpread = (Math.max(red, green, blue) - Math.min(red, green, blue))
        if (alpha < alphaMin):
            alphaMin = alpha
        if (alpha > alphaMax):
            alphaMax = alpha
        if (luma < lumaMin):
            lumaMin = luma
        if (luma > lumaMax):
            lumaMax = luma
        if (channelSpread > maxChannelSpread):
            maxChannelSpread = channelSpread
        offset = (offset + 4)
    let alphaRange = (alphaMax - alphaMin)
    let lumaRange = (lumaMax - lumaMin)
    let looksLikeOpaqueGrayscaleMask = (((alphaMin >= 250) and (alphaRange <= 1)) and (maxChannelSpread <= 1))
    if looksLikeOpaqueGrayscaleMask:
