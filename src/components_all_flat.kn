struct ExplorerActivityDockWidthBounds:
    min: Float
    max: Float
    default_: Float

fn clampExplorerActivityDockWidthToBounds(bounds: ExplorerActivityDockWidthBounds, width: Float) -> Float:
    return Math.max(bounds.min, Math.min(bounds.max, width))

fn uniqueExplorerActivityLaneIds(laneIds: Any) -> [ExplorerActivityLaneId]:
    let seen = ts_Set()
    let normalized: [ExplorerActivityLaneId] = []
    for laneId in laneIds:
        if seen.has(laneId):
            continue
        seen.add(laneId)
        normalized.push(laneId)
    return normalized

fn setExplorerActivityLaneOpen(laneIds: Any, laneId: ExplorerActivityLaneId, open: Bool) -> Any:
    if open:
        return uniqueExplorerActivityLaneIds([laneIds, laneId])
    return laneIds.filter(none)

fn normalizeExplorerActivityLaneIdsForRailOpenMode(args: Any) -> Any:
    let normalizedLaneIds = uniqueExplorerActivityLaneIds(args.laneIds)
    if (args.openMode == "multiple"):
        return normalizedLaneIds
    let latestLaneIdBySide = ts_Map()
    for laneId in normalizedLaneIds:
        let railSide = ((args.placementById[laneId] or (defaultExplorerActivityLanePlacementById)[laneId]) or "left")
        latestLaneIdBySide.set(railSide, laneId)
    let retainedLaneIds = ts_Set(latestLaneIdBySide.values())
    return normalizedLaneIds.filter(none)

fn replaceExplorerActionsHostLane(laneIds: Any, nextLaneId: Any) -> Any:
    let filteredLaneIds = laneIds.filter(none)
    return none

fn areExplorerActivityLaneIdListsEqual(left: Any, right: Any) -> Bool:
    return (((left.length == right.length) and left.every(none)))

fn areUnknownRecordValuesEqual(left: Any, right: Any) -> Bool:
    let leftEntries = ts_Object.entries(left)
    let rightEntries = ts_Object.entries(right)
    return (((leftEntries.length == rightEntries.length) and leftEntries.every(none)))

fn areExplorerWorkflowStatusesEqual(left: Any, right: Any) -> Any:
    if (left == right):
        return true
    if ((!left) or (!right)):
        return false
    return ((left.label == right.label) and (left.tone == right.tone))

type ExplorerInteractiveHostRuntime = Any

fn getExplorerChromeSurfaceContextLabel(surfaceId: ExplorerChromeSurfaceId) -> String:
    if (surfaceId == "explorerTopbar"):
        return "Explorer Top Bar"
    else if (surfaceId == "explorerToolbar"):
        return "Explorer Toolbar"
    else if (surfaceId == "workspaceHeader"):
        return "Workspace Header"
    else if (surfaceId == "railHeader"):
        return "Rail Header"
    else if (surfaceId == "previewHeader"):
        return "Preview Header"
    else if (surfaceId == "explorerStatusBar"):
        return "Explorer Status Bar"
    else:
        return "Explorer Chrome"

const builtInExplorerViewIdSet: Any = ts_Set([STANDARD_EXPLORER_VIEW_ID, "adaptive-semantic-grid", "constellation", "timeline-surface"])

fn cloneLocalExplorerViewStateById(value: Any) -> Any:
    if (structuredClone == "function"):
        return structuredClone(value)
    return JSON.parse(JSON.stringify(value))

fn resolveExplorerViewStateRecord(value: Any) -> Any:
    return none

fn findNearestExplorerViewDensityStop(view: Any, density: Float) -> Any:
    let stops = (view.density.stops or [])
    if (stops.length == 0):
        return none
    let closest = stops[0]
    let closestDistance = Math.abs((density - closest.value))
    for stop in stops.slice(1):
        let distance = Math.abs((density - stop.value))
        if (distance < closestDistance):
            closest = stop
            closestDistance = distance
    return closest

fn resolveStableExplorerChromeLabelWidthCh(labels: Any, options: Any) -> Float:
    let options: Any = none
    let minimumCh = (options.minimumCh or 4)
    let maximumCh = (options.maximumCh or 14)
    let longestLabelLength = labels.reduce(none, 0)
    return Math.max(minimumCh, Math.min(maximumCh, longestLabelLength))

