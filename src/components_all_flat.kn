    targetDir: String
    sources: [String]
    operation: FileTransferOperation
    collisionPolicy: Any

fn resolveExplorerPreviewDropTarget(preview: PreviewState) -> Any:
    if (preview.type_ != "folder"):
        return none
    let targetPath = preview.path.trim()
    if (((!targetPath) or isCloudExplorerPath(targetPath)) or isExplorerVirtualPath(targetPath)):
        return none
    return none

fn collectExplorerTransferAffectedDirectories(args: Any) -> [String]:
    let affectedDirectories = ts_Set()
    let normalizedTargetDir = normalizeExplorerPath(args.targetDir.trim())
    if normalizedTargetDir:
        affectedDirectories.add(normalizedTargetDir)
    for sourcePath in args.sources:
        let sourceParentPath = getPathParent(sourcePath)
        if (!sourceParentPath):
            continue
        let normalizedSourceParentPath = normalizeExplorerPath(sourceParentPath.trim())
        if normalizedSourceParentPath:
            affectedDirectories.add(normalizedSourceParentPath)
    return [affectedDirectories]

