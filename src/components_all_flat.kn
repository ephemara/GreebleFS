fn renderSettingsContextMenuIcon(iconName: String) -> Any:
    if iconName.startsWith("data:image/"):
        return (none)
    if (iconName == "Clipboard"):
        return none
    else if (iconName == "Copy"):
        return none
    else if (iconName == "CopyPlus"):
        return none
    else if (iconName == "Edit3"):
        return none
    else if (iconName == "Eraser"):
        return none
    else if (iconName == "ExternalLink"):
        return none
    else if (iconName == "Eye"):
        return none
    else if (iconName == "FilePlus"):
        return none
    else if (iconName == "FolderPlus"):
        return none
    else if (iconName == "Info"):
        return none
    else if (iconName == "Pencil"):
        return none
    else if (iconName == "RefreshCw"):
        return none
    else if (iconName == "RotateCcw"):
        return none
    else if (iconName == "Save"):
        return none
    else if (iconName == "Scissors"):
        return none
    else if (iconName == "Shield"):
        return none
    else if (iconName == "Sliders"):
        return none
    else if (iconName == "Sparkles"):
        return none
    else if (iconName == "Star"):
        return none
    else if (iconName == "Tags"):
        return none
    else if (iconName == "Terminal"):
        return none
    else if (iconName == "Trash2"):
        return none
    else if (iconName == "Undo2"):
        return none
    else:
        return none

fn createSettingsContextMenuPreviewEntry(path: String, options: Any) -> Any:
    let normalizedPath = path.trim()
    let segments = normalizedPath.split(none).filter(ts_Boolean)
    let name = ((options.name or segments[(segments.length - 1)]) or normalizedPath)
    let isDirectory = (options.isDirectory or false)
    let extension = none
    return none

fn buildSettingsContextMenuPreviewInvocation(contextKind: ExplorerMenuContextKind) -> Any:
    let currentLocation = "/workspace/greeblefs-demo"
    let fileEntry = createSettingsContextMenuPreviewEntry("/workspace/greeblefs-demo/notes/alpha.txt")
    let secondFileEntry = createSettingsContextMenuPreviewEntry("/workspace/greeblefs-demo/notes/beta.ts")
    let previewEntry = createSettingsContextMenuPreviewEntry("/workspace/greeblefs-demo/renders/preview.png")
    let baseInvocation: Option<Any> = none
    if (contextKind == "background"):
        return baseInvocation
    else if (contextKind == "multi-select"):
        return none
    else if (contextKind == "search-result"):
        return none
    else if (contextKind == "preview-pane"):
        return none
    else if (contextKind == "entry"):
        ()
    else:
        return none

fn resolveContextMenuCommandSourceLabel(command: ExplorerCommandDefinition) -> Any:
    if (command.source == "action"):
        return none + command.packName
    if (command.source == "plugin"):
        return none + command.pluginName
    if (command.source == "preview"):
        return "Preview Lane"
    return "Built-In"

fn getContextMenuPreviewPathKey(path: [String]) -> Any:
    return none

fn resolveContextMenuPreviewPanels(rootNodes: [ExplorerRuntimeMenuNode], openSubmenuPath: [String]) -> Any:
    let panels: [[ExplorerRuntimeMenuNode]] = [rootNodes]
    let resolvedPath: [String] = []
    let currentNodes = rootNodes
    for submenuId in openSubmenuPath:
        let submenuNode = currentNodes.find(none)
        if (!submenuNode):
            break
        panels.push(submenuNode.children)
        resolvedPath.push(submenuId)
        currentNodes = submenuNode.children
    return none

fn ExplorerContextMenuPreviewPanels(arg_1: Any) -> Any:
    let nodes: Any = none
    let density: Any = none
    let showDescriptions: Any = none
    let selectedNodeId: Any = none
    let onSelectNode: Any = none
    let _ = useState([])
    let openSubmenuPath: Any = none
    let setOpenSubmenuPath: Any = none
    let panelState = useMemo(none, [nodes, openSubmenuPath])
    useEffect(none, [nodes])
    if (nodes.length == 0):
        return (none)
    let panelWidth = none
    return (none)

fn getThemePreviewBackground(theme: OverlayThemeDefinition, previewUrl: String) -> Any:
    if previewUrl:
        return ["linear-gradient(180deg, rgba(5,10,18,0.1) 0%, rgba(5,10,18,0.72) 100%)", none + previewUrl + none].join(", ")
    return ["radial-gradient(circle at 18% 20%, " + (theme.palette.accentSoft or theme.palette.accent + "33") + ", transparent 28%)", "linear-gradient(135deg, " + theme.palette.appBackgroundAlt + " 0%, " + theme.palette.appBackground + " 52%, " + theme.palette.panelBackground + " 100%)"].join(", ")

fn clampThemeDescription(text: Any) -> Any:
    let trimmed = text.trim()
    if (!trimmed):
        return none
    return none

fn getThemePackageSourceBadgeLabel(sourceKind: Any) -> String:
    if (sourceKind == "plugin-package"):
        return "Plugin Package"
    else if (sourceKind == "vscode-theme-directory"):
        return "VS Code Folder"
    else if (sourceKind == "vscode-theme-vsix"):
        return "VS Code VSIX"
    else:
        return "Theme Folder"

fn getIconThemePackageSourceBadgeLabel(sourceKind: Any) -> String:
    if (sourceKind == "built-in"):
        return "Built-In"
    else if (sourceKind == "vscode-icon-theme-directory"):
        return "VS Code Folder"
    else if (sourceKind == "vscode-icon-theme-vsix"):
        return "VS Code VSIX"
    else:
        return "Pack"

type ThemeCatalogSectionId = String

fn resolveThemeCatalogSectionId(theme: OverlayThemeDefinition, packageInfo: Any) -> Any:
    if (theme.source == "built-in"):
        return "built-in"
    if packageInfo.catalog.isOfficialPilot:
        return "official-pilot"
    return "legacy-archive"

fn getThemeCatalogBadgeLabel(sectionId: ThemeCatalogSectionId, packageInfo: Any) -> Any:
    if (sectionId == "built-in"):
        return "Built-In"
    return (packageInfo.catalog.badgeLabel or "Package")

fn getThemeCatalogSectionTitle(sectionId: ThemeCatalogSectionId) -> String:
    if (sectionId == "official-pilot"):
        return "Official Pilot Suite"
    else if (sectionId == "built-in"):
        return "Built-In Baselines"
    else if (sectionId == "legacy-archive"):
        return "Legacy / Lab Archive"

fn getThemeCatalogSectionSubtitle(sectionId: ThemeCatalogSectionId) -> String:
    if (sectionId == "official-pilot"):
        return "The current pilot set. These are the front-of-house themes that should feel full-screen, readable, and intentional."
    else if (sectionId == "built-in"):
        return "Bundled baseline themes stay visible and supported as stable defaults for the app and dock."
    else if (sectionId == "legacy-archive"):
        return "Older experiments, transitional shells, and archive material remain selectable without reading like the primary product."

fn getThemeCatalogEntrySortRank(packageInfo: Any) -> Float:
    return (packageInfo.catalog.sortRank or 0)

fn getThemeCatalogCardOpacity(sectionId: ThemeCatalogSectionId) -> Any:
    if (sectionId == "legacy-archive"):
        return 0.82
    if (sectionId == "built-in"):
        return 0.96
    return 1

component ThemeCatalogCard(themeOption: Any, packageInfo: Any, active: Any, sectionId: Any, onSelect: Any, motionBinding: Any) with Reactive:
    state description: Any = clampThemeDescription((packageInfo.description or themeOption.description))
    state previewBackground: Any = getThemePreviewBackground(themeOption, packageInfo.previewUrl)
    state compiledEngineManifest: Any = packageInfo.compiledEngineManifest
    state defaultLayoutPrimitive: Any = compiledEngineManifest.defaultLayoutPrimitive
    state defaultNavigationPattern: Any = compiledEngineManifest.defaultNavigationPattern
    state defaultAnimationProfile: Any = compiledEngineManifest.defaultAnimationProfile
    state defaultIconPack: Any = compiledEngineManifest.defaultIconPack
    state defaultRenderStyle: Any = compiledEngineManifest.defaultRenderStyle
