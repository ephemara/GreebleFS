fn mergePreviewContextMenuRegistrations(primary: Any, secondary: Any) -> Any:
    if (!primary):
        return secondary
    if (!secondary):
        return primary
    let workflowOverlayMap = ts_Map()
    for overlay in (primary.workflowOverlays or []):
        workflowOverlayMap.set(overlay.workflowTabId, none)
    for overlay in (secondary.workflowOverlays or []):
        let existingOverlay = workflowOverlayMap.get(overlay.workflowTabId)
        workflowOverlayMap.set(overlay.workflowTabId, none)
    return none

