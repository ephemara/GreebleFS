fn buildTicks(duration: Float) -> Any:
    if ((!ts_Number.isFinite(duration)) or (duration <= 0)):
        return [0]
    let steps = [1, 2, 5, 10, 15, 30, 60, 120, 300, 600, 1800]
    let minStep = (duration / 6)
    let step = (steps.find(none) or 3600)
    let ticks: [Float] = []
    let t = 0
    while (t <= duration):
        ticks.push(parseFloat(t.toFixed(4)))
        t = (t + step)
    if (ticks[(ticks.length - 1)] != duration):
        ticks.push(duration)
    return ticks

fn buildTrimmedVideoOutputPath(sourcePath: String) -> String:
    let match_ = sourcePath.match_(none)
    let parentPath = (match_[1] or "")
    let leafName = (match_[2] or sourcePath)
    let stem = leafName.replace(none, "")
    return parentPath + stem + ".trimmed.mp4"

