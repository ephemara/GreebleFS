fn resolveBuiltInLabel(command: ExplorerCommandDefinition, invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment) -> Any:
    if (command.source != "built-in"):
