fn resolveExplorerDirectionalSelectionIndex(args: Any) -> Any:
    if (args.totalEntries <= 0):
        return (-1)
    let maxIndex = (args.totalEntries - 1)
    let safeCurrentIndex = Math.max(0, Math.min(args.currentIndex, maxIndex))
    if (args.presentation != "grid"):
        if (args.direction == "up"):
            return Math.max(0, (safeCurrentIndex - 1))
        if (args.direction == "down"):
            return Math.min(maxIndex, (safeCurrentIndex + 1))
        return safeCurrentIndex
    let gridStep = Math.max(1, args.gridColumnCount)
    if (args.direction == "up"):
        return Math.max(0, (safeCurrentIndex - gridStep))
    else if (args.direction == "down"):
        return Math.min(maxIndex, (safeCurrentIndex + gridStep))
    else if (args.direction == "left"):
        return Math.max(0, (safeCurrentIndex - 1))
    else if (args.direction == "right"):
        return Math.min(maxIndex, (safeCurrentIndex + 1))
    else:
        return safeCurrentIndex

