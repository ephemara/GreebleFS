const MIN_SPLIT_RATIO: Any = 0.18

const MAX_SPLIT_RATIO: Any = 0.82

fn clampTerminalSplitRatio(value: Float) -> Any:
    if (!ts_Number.isFinite(value)):
        return 0.5
    return Math.min(MAX_SPLIT_RATIO, Math.max(MIN_SPLIT_RATIO, value))

fn createTerminalPaneLayout(paneId: String) -> Any:
    return none

fn collectTerminalPaneIds(layout: TerminalPaneLayoutNode) -> Any:
    if (layout.kind == "leaf"):
        return [layout.paneId]
    return [collectTerminalPaneIds(layout.first), collectTerminalPaneIds(layout.second)]

fn countTerminalPanes(layout: TerminalPaneLayoutNode) -> Any:
    if (layout.kind == "leaf"):
        return 1
    return (countTerminalPanes(layout.first) + countTerminalPanes(layout.second))

fn describeTerminalPaneLayout(layout: TerminalPaneLayoutNode) -> Any:
    if (layout.kind == "leaf"):
        return "single pane"
    let directionLabel = none
    return directionLabel + none + countTerminalPanes(layout) + " panes"

fn collectTerminalPaneGeometry(layout: TerminalPaneLayoutNode, box: Any) -> Any:
    let box: Any = none
    if (layout.kind == "leaf"):
        return none
    if (layout.direction == "columns"):
        let firstWidth = (box.width * layout.ratio)
        let secondWidth = (box.width - firstWidth)
        let firstBox = none
        let secondBox = none
        let firstGeometry = collectTerminalPaneGeometry(layout.first, firstBox)
        let secondGeometry = collectTerminalPaneGeometry(layout.second, secondBox)
        return none
    let firstHeight = (box.height * layout.ratio)
    let secondHeight = (box.height - firstHeight)
    let firstBox = none
    let secondBox = none
    let firstGeometry = collectTerminalPaneGeometry(layout.first, firstBox)
    let secondGeometry = collectTerminalPaneGeometry(layout.second, secondBox)
    return none

fn getImmediatePaneSplitDirection(layout: TerminalPaneLayoutNode, paneId: String, parentDirection: Any) -> Any:
    let parentDirection: Any = none
    if (layout.kind == "leaf"):
        return none
    return ((getImmediatePaneSplitDirection(layout.first, paneId, layout.direction) or getImmediatePaneSplitDirection(layout.second, paneId, layout.direction)))

fn splitTerminalPaneLayout(layout: TerminalPaneLayoutNode, targetPaneId: String, direction: TerminalSplitDirection, newPaneId: String, createSplitId: Any) -> Any:
    if (layout.kind == "leaf"):
        if (layout.paneId != targetPaneId):
            return none
        return none
    let firstResult = splitTerminalPaneLayout(layout.first, targetPaneId, direction, newPaneId, createSplitId)
    if firstResult.inserted:
        return none
    let secondResult = splitTerminalPaneLayout(layout.second, targetPaneId, direction, newPaneId, createSplitId)
    if secondResult.inserted:
        return none
    return none

fn updateTerminalPaneSplitRatio(layout: TerminalPaneLayoutNode, splitId: String, ratio: Float) -> Any:
    if (layout.kind == "leaf"):
        return layout
    if (layout.splitId == splitId):
        return none
    return none

fn removeTerminalPaneFromLayout(layout: TerminalPaneLayoutNode, targetPaneId: String) -> Any:
    if (layout.kind == "leaf"):
        if (layout.paneId != targetPaneId):
            return none
        return none
    let firstResult = removeTerminalPaneFromLayout(layout.first, targetPaneId)
    if firstResult.removed:
        if (firstResult.layout == none):
            let fallbackPaneId = (collectTerminalPaneIds(layout.second)[0] or none)
            return none
        return none
    let secondResult = removeTerminalPaneFromLayout(layout.second, targetPaneId)
    if secondResult.removed:
        if (secondResult.layout == none):
            let fallbackPaneId = (collectTerminalPaneIds(layout.first)[0] or none)
            return none
        return none
    return none

