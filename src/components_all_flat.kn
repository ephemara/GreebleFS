struct NotesRichMarkdownEditorProps:
    appearance: ResolvedOverlayAppearance
    markdown: String
    onMarkdownChange: Any
    onBlur: Any

component NotesRichMarkdownEditor(appearance: Any, markdown: Any, onMarkdownChange: Any, onBlur: Any) with Reactive:
    state lastAppliedMarkdownRef: Any = useRef(markdown)
    state isApplyingExternalMarkdownRef: Any = useRef(false)
    state editor: Any = useEditor(none, [])
    fn __component_effect_1() -> Any:
        if ((!editor) or (markdown == lastAppliedMarkdownRef.current)):
            return none
        isApplyingExternalMarkdownRef.current = true
        editor.commands.setContent(parseNotesMarkdownToDocument(markdown), none)
        lastAppliedMarkdownRef.current = markdown
        isApplyingExternalMarkdownRef.current = false

    render <div />

component ToolbarButton(appearance: Any, active: Any, disabled: Any, label: Any, onClick: Any) with Reactive:
    render <OverlayActionButton appearance={appearance} tone={none} size="compact" active={active} disabled={disabled} onClick={onClick} style={none}>{label}</OverlayActionButton>

component ToolbarDivider() with Reactive:
    render <div aria_hidden={true} style={none} />

fn reorderPanelIds(ids: [String], draggedId: String, targetId: String) -> Any:
    if (draggedId == targetId):
        return ids
    let next = [ids]
    let draggedIndex = next.indexOf(draggedId)
    let targetIndex = next.indexOf(targetId)
    if ((draggedIndex == (-1)) or (targetIndex == (-1))):
        return ids
    let _ = next.splice(draggedIndex, 1)
    let dragged: Any = none
    next.splice(targetIndex, 0, dragged)
    return next

fn togglePanelId(ids: [String], panelId: String) -> Any:
    return none

fn syncOpenPanelIds(openIds: [String], availableIds: [String], defaultOpenIds: [String]) -> [String]:
    return derivePanelOpenState(none)

fn derivePanelOpenState(args: Any) -> [String]:
    let availableSet = ts_Set(args.availableIds)
    let savedOpenIds = args.savedOpenIds.filter(none)
    let dismissedSet = ts_Set(args.dismissedPanelIds.filter(none))
    let defaultOpenIds = args.defaultOpenIds.filter(none)
    let enforcedOpenIds = args.enforcedOpenIds.filter(none)
    return ts_Array.from(ts_Set([savedOpenIds, defaultOpenIds, enforcedOpenIds]))

fn getNextActivePanelId(openIds: [String], closedId: String) -> Any:
    let next = openIds.filter(none)
    return (next[(next.length - 1)] or none)

