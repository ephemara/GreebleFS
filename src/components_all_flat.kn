    fn refreshScrollbarSizeFromStyle() -> Any:
        let root = rootRef.current
        if (!root):
            return none
        let resolvedScrollbarSize = ts_Number.parseFloat(window.getComputedStyle(root).getPropertyValue("--overlay-scrollbar-size"))
        scrollbarSizePxRef.current = none

    fn syncScrollbarPresentation() -> Any:
        let root = rootRef.current
        let viewport = internalViewportRef.current
        if ((!root) or (!viewport)):
            return none
        let measurement = readScrollbarMeasurementSnapshot(viewport)
        if (!usesAppOwnedScrollbarChrome):
            setDatasetValueIfChanged(root, "overlayVerticalScrollbarVisible", "false")
            setDatasetValueIfChanged(root, "overlayHorizontalScrollbarVisible", "false")
            setStylePropertyIfChanged(root, "--overlay-scroll-area-vertical-reserve", "0")
            setStylePropertyIfChanged(root, "--overlay-scroll-area-horizontal-reserve", "0")
            return measurement
        let scrollbarSizePx = scrollbarSizePxRef.current
        let verticalScrollbarVisible = ((direction != "horizontal") and (viewport.scrollHeight > (viewport.clientHeight + 1)))
        let horizontalScrollbarVisible = ((direction != "vertical") and (viewport.scrollWidth > (viewport.clientWidth + 1)))
        setDatasetValueIfChanged(root, "overlayVerticalScrollbarVisible", none)
        setDatasetValueIfChanged(root, "overlayHorizontalScrollbarVisible", none)
        setStylePropertyIfChanged(root, "--overlay-scroll-area-vertical-reserve", none)
        setStylePropertyIfChanged(root, "--overlay-scroll-area-horizontal-reserve", none)
        syncAxisScrollbarPresentation(none)
        syncAxisScrollbarPresentation(none)
        return measurement

    fn scheduleScrollbarPresentationSync(options: Any) -> Any:
        if options.sustain:
            scrollbarSettleFramesRemainingRef.current = Math.max(scrollbarSettleFramesRemainingRef.current, 18)
            stableScrollbarMeasurementFramesRef.current = 0
        if (pendingScrollbarSyncFrameRef.current != none):
            return none
        pendingScrollbarSyncFrameRef.current = window.requestAnimationFrame(none)

    fn handleViewportScroll(event: React_UIEvent<HTMLDivElement>):
        onViewportScroll(event)
        if usesAppOwnedScrollbarChrome:
            scheduleScrollbarPresentationSync()

    fn handleScrollbarDragPointerMove(event: PointerEvent) -> Any:
        let dragState = scrollbarDragStateRef.current
        let viewport = internalViewportRef.current
        if ((!dragState) or (!viewport)):
            return none
        let pointerOffset = none
        let maxThumbTravel = Math.max(1, (dragState.trackSize - dragState.thumbSize))
        let nextScrollRatio = clampNumber((pointerOffset / maxThumbTravel), 0, 1)
        let nextScrollOffset = (nextScrollRatio * dragState.maxScrollOffset)
        if (dragState.axis == "vertical"):
            viewport.scrollTop = nextScrollOffset
        else:
            viewport.scrollLeft = nextScrollOffset
        syncScrollbarPresentation()

    fn handleScrollbarDragPointerEnd():
        scrollbarDragStateRef.current = none
        window.removeEventListener("pointermove", handleScrollbarDragPointerMove)
        window.removeEventListener("pointerup", handleScrollbarDragPointerEnd)
        window.removeEventListener("pointercancel", handleScrollbarDragPointerEnd)

    fn beginScrollbarDrag(args: Any) -> Any:
        let viewport = internalViewportRef.current
        let trackElement = none
        let thumbElement = none
        if (((!viewport) or (!trackElement)) or (!thumbElement)):
            return none
        let trackRect = trackElement.getBoundingClientRect()
        let thumbRect = thumbElement.getBoundingClientRect()
        let trackSize = none
        let thumbSize = none
        let maxScrollOffset = none
        if (((trackSize <= 0) or (thumbSize <= 0)) or (maxScrollOffset <= 0)):
            return none
        args.event.preventDefault()
        args.event.stopPropagation()
        let thumbPointerOffset = none
        scrollbarDragStateRef.current = none
        window.addEventListener("pointermove", handleScrollbarDragPointerMove)
        window.addEventListener("pointerup", handleScrollbarDragPointerEnd)
        window.addEventListener("pointercancel", handleScrollbarDragPointerEnd)
        handleScrollbarDragPointerMove(args.event.nativeEvent)

    fn __component_effect_0() -> Any:
        if (!usesAppOwnedScrollbarChrome):
            return none
        refreshScrollbarSizeFromStyle()
        scheduleScrollbarPresentationSync(none)

    fn __component_effect_1() -> Any:
        if (!usesAppOwnedScrollbarChrome):
            handleScrollbarDragPointerEnd()
            if (pendingScrollbarSyncFrameRef.current != none):
                window.cancelAnimationFrame(pendingScrollbarSyncFrameRef.current)
                pendingScrollbarSyncFrameRef.current = none
            return none
        let viewport = internalViewportRef.current
        let content = contentRef.current
        if (!viewport):
            return none
        refreshScrollbarSizeFromStyle()
        scheduleScrollbarPresentationSync(none)
        let handleWindowResize = none
        window.addEventListener("resize", handleWindowResize)
        if (ResizeObserver != "function"):
            return none
        let resizeObserver = ResizeObserver(none)
        resizeObserver.observe(viewport)
        if content:
            resizeObserver.observe(content)
        return none

    render <div ref={rootRef} className={joinClassNames("overlay-scroll-area", "overlay-scroll-area--" + scrollbarStyle, className)} style={none}><div ref={mergeRefs(internalViewportRef, viewportRef)} onScroll={handleViewportScroll} className={joinClassNames("overlay-scroll-area__viewport", "overlay-scroll-area__viewport--" + direction, resolveScrollbarViewportClassName(scrollbarStyle), viewportClassName)} data_overlay_scrollbar_style={scrollbarStyle} data_overlay_native_scrollbar={nativeScrollbarStyle} style={none}><div ref={contentRef} className={joinClassNames("overlay-scroll-area__content", contentClassName)} style={none}>{children}</div></div>{none}</div>

