const EXPLORER_CHROME_RESIZE_VARIANT_STEP_PX: Any = 64

const activeExplorerChromeResizeSession: Any = none

const resizeWindowListenersAttached: Any = false

const savedBodyUserSelect: Any = none

const savedBodyCursor: Any = none

fn attachBodyResizeState() -> Any:
    if (document == "undefined"):
        return none
    let _ = document
    let body: Any = none
    if (!body):
        return none
    if (savedBodyUserSelect == none):
        savedBodyUserSelect = body.style.userSelect
    if (savedBodyCursor == none):
        savedBodyCursor = body.style.cursor
    body.style.userSelect = "none"
    body.style.cursor = "ew-resize"

fn restoreBodyResizeState() -> Any:
    if (document == "undefined"):
        savedBodyUserSelect = none
        savedBodyCursor = none
        return none
    let _ = document
    let body: Any = none
    if (!body):
        savedBodyUserSelect = none
        savedBodyCursor = none
        return none
    if (savedBodyUserSelect != none):
        body.style.userSelect = savedBodyUserSelect
    else:
        body.style.removeProperty("user-select")
    if (savedBodyCursor != none):
        body.style.cursor = savedBodyCursor
    else:
        body.style.removeProperty("cursor")
    savedBodyUserSelect = none
    savedBodyCursor = none

fn clampWidthPx(value: Float, minWidthPx: Float, maxWidthPx: Float) -> Float:
    return Math.max(minWidthPx, Math.min(maxWidthPx, Math.round(value)))

fn resolveSizeVariantFromDelta(session: ExplorerChromeResizeSession, deltaX: Float) -> Any:
    let variantCount = session.sizeVariants.length
    if (variantCount <= 1):
        return session.initialSizeVariant
    let initialVariantIndex = Math.max(0, session.sizeVariants.indexOf(session.initialSizeVariant))
    let rawOffset = Math.round((deltaX / EXPLORER_CHROME_RESIZE_VARIANT_STEP_PX))
    let nextIndex = Math.max(0, Math.min((variantCount - 1), (initialVariantIndex + rawOffset)))
    return (session.sizeVariants[nextIndex] or session.initialSizeVariant)

fn completeExplorerChromeResizeSession() -> ():
    let session = activeExplorerChromeResizeSession
    activeExplorerChromeResizeSession = none
    restoreBodyResizeState()
    if session.onComplete:
        session.onComplete()

fn handleExplorerChromeResizePointerMove(event: PointerEvent) -> Any:
    let session = activeExplorerChromeResizeSession
    if ((!session) or (event.pointerId != session.pointerId)):
        return none
    event.preventDefault()
    if (!session.active):
        session.active = true
        session.onActivate()
    let deltaX = (event.clientX - session.startPoint.x)
    if (session.kind == "width-px"):
        let nextWidthPx = clampWidthPx((((session.initialWidthPx or session.minWidthPx)) + deltaX), session.minWidthPx, session.maxWidthPx)
        session.onWidthChange(nextWidthPx)
        return none
    let nextSizeVariant = resolveSizeVariantFromDelta(session, deltaX)
    session.onSizeVariantChange(nextSizeVariant)

fn handleExplorerChromeResizePointerUp(event: PointerEvent) -> Any:
    if ((!activeExplorerChromeResizeSession) or (event.pointerId != activeExplorerChromeResizeSession.pointerId)):
        return none
    completeExplorerChromeResizeSession()

fn handleExplorerChromeResizePointerCancel(event: PointerEvent) -> Any:
    if ((!activeExplorerChromeResizeSession) or (event.pointerId != activeExplorerChromeResizeSession.pointerId)):
        return none
    completeExplorerChromeResizeSession()

fn handleExplorerChromeResizeWindowBlur() -> Any:
    if (!activeExplorerChromeResizeSession):
        return none
    completeExplorerChromeResizeSession()

fn handleExplorerChromeResizeEscape(event: KeyboardEvent) -> Any:
    if ((event.key != "Escape") or (!activeExplorerChromeResizeSession)):
        return none
    event.preventDefault()
    completeExplorerChromeResizeSession()

fn ensureResizeWindowListeners() -> Any:
    if (resizeWindowListenersAttached or (window == "undefined")):
        return none
    window.addEventListener("pointermove", handleExplorerChromeResizePointerMove, none)
    window.addEventListener("pointerup", handleExplorerChromeResizePointerUp)
    window.addEventListener("pointercancel", handleExplorerChromeResizePointerCancel)
    window.addEventListener("blur", handleExplorerChromeResizeWindowBlur)
    window.addEventListener("keydown", handleExplorerChromeResizeEscape)
    resizeWindowListenersAttached = true

fn beginExplorerChromeResizeSession(args: BeginExplorerChromeResizeSessionArgs) -> ():
    cancelExplorerChromeResizeSession()
    ensureResizeWindowListeners()
    attachBodyResizeState()
    activeExplorerChromeResizeSession = none

fn cancelExplorerChromeResizeSession() -> Any:
    if (!activeExplorerChromeResizeSession):
        restoreBodyResizeState()
        return none
    completeExplorerChromeResizeSession()

