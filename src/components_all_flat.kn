fn clampPremiumSliderValue(value: Float, min: Float, max: Float) -> Any:
    if (!ts_Number.isFinite(value)):
        return min
    if (max <= min):
        return min
    return Math.min(max, Math.max(min, value))

component PremiumSlider(value: Any, min: Any, max: Any, step: Any, disabled: Any, density: Any, ariaLabel: Any, ariaLabelledBy: Any, ariaValueText: Any, onChange: Any, onCommit: Any, style: Any) with Reactive:
    state isDragging: Any = false
    state isFocused: Any = false
    state metrics: Any = PREMIUM_SLIDER_DENSITY_METRICS[density]
    state clampedValue: Any = clampPremiumSliderValue(value, min, max)
    state trackRadius: Any = (metrics.trackHeight / 2)
    state thumbRadius: Any = (metrics.thumbSize / 2)
    state isInteractive: Any = (!disabled)
    state activityStrength: Any = none
    state rootStyle: CSSProperties = none
    state trackStyle: CSSProperties = none
    state rangeStyle: CSSProperties = none
    state thumbStyle: CSSProperties = none
    state thumbCoreStyle: CSSProperties = none
    state rangeGlowStyle: CSSProperties = none
    fn setIsDragging(value: Any):
        isDragging = value

    fn setIsFocused(value: Any):
        isFocused = value

    fn normalizedProgress() -> Any:
        if (max <= min):
            return 0
        return (((clampedValue - min)) / ((max - min)))

    fn __component_effect_0() -> Any:
        if ((!isDragging) or (window == "undefined")):
            return none
        let handlePointerRelease = none
        window.addEventListener("pointerup", handlePointerRelease)
        window.addEventListener("pointercancel", handlePointerRelease)
        window.addEventListener("blur", handlePointerRelease)
        return none

    render <SliderPrimitive_Root value={[clampedValue]} min={min} max={max} step={step} disabled={disabled} onValueChange={none} onValueCommit={none} onPointerDownCapture={none} onFocus={none} onBlur={none} style={rootStyle}><SliderPrimitive_Track style={trackStyle}><div aria_hidden="true" style={none} /><SliderPrimitive_Range style={rangeStyle} /><div aria_hidden="true" style={rangeGlowStyle} /></SliderPrimitive_Track><SliderPrimitive_Thumb aria_label={ariaLabel} aria_labelledby={ariaLabelledBy} aria_valuetext={ariaValueText} style={thumbStyle}><div aria_hidden="true" style={thumbCoreStyle} /></SliderPrimitive_Thumb></SliderPrimitive_Root>

