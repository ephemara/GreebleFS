fn getFileExtension(name: String) -> Any:
    let dotIndex = name.lastIndexOf(".")
    if ((dotIndex <= 0) or (dotIndex == (name.length - 1))):
        return ""
    return name.slice((dotIndex + 1)).toLowerCase()

fn getFileStem(name: String) -> Any:
    let dotIndex = name.lastIndexOf(".")
    if (dotIndex <= 0):
        return name
    return name.slice(0, dotIndex)

