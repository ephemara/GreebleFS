fn formatRelativeTime(timestamp: Float) -> Any:
    if (!timestamp):
        return "Never"
    let elapsedMs = Math.max(0, (Date.now() - timestamp))
    let elapsedMinutes = Math.round((elapsedMs / 60000))
    if (elapsedMinutes < 1):
        return "Just now"
    if (elapsedMinutes < 60):
        return elapsedMinutes + "m ago"
    let elapsedHours = Math.round((elapsedMinutes / 60))
    if (elapsedHours < 24):
        return elapsedHours + "h ago"
    let elapsedDays = Math.round((elapsedHours / 24))
    return elapsedDays + "d ago"

