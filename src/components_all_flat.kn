    return none

fn setDatasetValueIfChanged(element: HTMLElement, key: String, value: String) -> Any:
    if (element.dataset[key] == value):
        return none
    ()

fn setStylePropertyIfChanged(element: HTMLElement, propertyName: String, value: String) -> Any:
    if (element.style.getPropertyValue(propertyName) == value):
        return none
    element.style.setProperty(propertyName, value)

fn clampNumber(value: Float, minimum: Float, maximum: Float) -> Float:
    return Math.min(Math.max(value, minimum), maximum)

