    let shellSize = Math.max(9, Math.min(15, Math.round((stageSize * 0.16))))
    let iconSize = Math.max(7, Math.min(12, Math.round((shellSize * 0.82))))
    let inset = Math.max(1, Math.round((stageSize * 0.025)))
    return none

