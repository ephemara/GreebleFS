impl ThemeRendererErrorBoundary:
    fn new_(_self: ThemeRendererErrorBoundary, props: Any) -> ThemeRendererErrorBoundary:
        super_(props)
        _self.state_ = none

    fn getDerivedStateFromError() -> Any:
        return none

    fn componentDidCatch(_self: ThemeRendererErrorBoundary, error: Error):
        console.warn(none + _self.props.rendererName + none, error)
        _self.props.onError(error)

    fn componentDidUpdate(_self: ThemeRendererErrorBoundary, prevProps: Any):
        if ((prevProps.rendererName != _self.props.rendererName) and _self.state_.failed):
            _self.setState(none)

    fn render(_self: ThemeRendererErrorBoundary) -> Any:
        if _self.state_.failed:
            return _self.props.fallback
        return _self.props.children


