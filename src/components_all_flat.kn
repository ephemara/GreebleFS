fn readStandaloneTextPreviewFile(filePath: String, assetUrl: String) -> Any:
    if (!filePath.trim()):
        return ""
    if (((window != "undefined") and ((window).TAURI_INTERNALS == none)) and assetUrl.trim()):
        let response = (await fetch(assetUrl))
        return response.text()
    return readExplorerTextFile(filePath)

