    let sy = ((f[2] * 0) - (f[0] * 0))
    let sz = ((f[0] * 1) - (f[1] * 0))
    let sx2 = ((f[1] * 0) - (f[2] * 1))
    let sy2 = ((f[2] * 0) - (f[0] * 0))
    let sz2 = ((f[0] * 1) - (f[1] * 0))
