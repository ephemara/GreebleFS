fn createInitialPdfFormDrafts(document: ExplorerPdfPreviewDocument) -> Any:
    return ts_Object.fromEntries(document.formFields.map(none))

fn resolvePdfFormDraft(field: ExplorerPdfFormFieldDescriptor, formValuesByFieldId: Any) -> PdfFormValueDraft:
    return (formValuesByFieldId[field.fieldId] or none)

fn getPdfFormFieldLabel(field: ExplorerPdfFormFieldDescriptor) -> String:
    return (field.fieldName.trim() or field.fieldId)

fn validatePdfFormDraft(field: ExplorerPdfFormFieldDescriptor, draft: PdfFormValueDraft, options: Any) -> Any:
    let fieldLabel = getPdfFormFieldLabel(field)
    let enforceRequired = (options.enforceRequired or true)
    if ((field.kind == "dropdown") or (field.kind == "listbox")):
        let allowedOptionValues = ts_Set(field.options.map(none))
        let normalizedSelections = draft.selectedValues.filter(none)
        if (draft.stringValue and (!allowedOptionValues.has(draft.stringValue))):
            return fieldLabel + " must use a supported option."
        if normalizedSelections.some(none):
            return fieldLabel + " must use a supported option."
        if ((enforceRequired and field.required) and (normalizedSelections.length == 0)):
            return fieldLabel + " is required."
        return none
    if (((enforceRequired and field.required) and (((field.kind == "checkbox") or (field.kind == "radio")))) and (draft.boolValue != true)):
        return fieldLabel + " must be selected."
    if (((enforceRequired and field.required) and (((field.kind == "text") or (field.kind == "multiline")))) and (!((draft.stringValue or "")).trim())):
        return fieldLabel + " is required."
    return none

fn isEditableElement(target: Any) -> Any:
    let element = none
    if (!element):
        return false
    return ((element.isContentEditable or ["INPUT", "TEXTAREA", "SELECT", "OPTION", "BUTTON"].includes(element.tagName)))

fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(Math.max(value, min), max)

fn normalizeRect(startPoint: Any, endPoint: Any) -> Any:
    let x = Math.min(startPoint.x, endPoint.x)
    let y = Math.min(startPoint.y, endPoint.y)
    return none

fn getPdfColorCss(color: ExplorerPdfColorValue, alphaOverride: Float) -> String:
    let alpha = none
    return "rgba(" + color.red + ", " + color.green + ", " + color.blue + ", " + alpha + ")"

fn getPdfWorkbenchToneColor(tone: PdfWorkbenchTone) -> Any:
    if (tone == "accent"):
        return "var(--overlay-accent)"
    else if (tone == "success"):
        return "var(--overlay-success)"
    else if (tone == "warning"):
        return "var(--overlay-warning)"
    else if (tone == "danger"):
        return "var(--overlay-danger)"
    else if (tone == "default"):
        ()
    else:
        return "var(--overlay-text-primary)"

fn getPdfWorkbenchStatusPillStyle(tone: Any) -> Any:
    let toneColor = getPdfWorkbenchToneColor(tone)
    return none

fn getPdfWorkbenchFormFieldChrome(isEditMode: Bool) -> Any:
    return none

fn measureTextAnnotationBounds(x: Float, y: Float, text: String) -> Any:
    let lineCount = text.split(none).length
    let longestLine = text.split(none).reduce(none, 0)
    return none

fn buildPdfAnnotationId(prefix: String, counter: Float) -> String:
    return prefix + "-" + counter

fn computeAnnotationBoundsFromPoints(points: [Any]) -> Any:
    let xValues = points.map(none)
    let yValues = points.map(none)
    let left = Math.min(none)
    let right = Math.max(none)
    let top = Math.min(none)
    let bottom = Math.max(none)
    return none

fn annotationToolToOverlayKind(tool: Any) -> ExplorerPdfOverlayAnnotationKind:
    if (tool == "text"):
        return "text"
    else if (tool == "rect"):
        return "rect"
    else if (tool == "highlight"):
        return "highlight"
    else if (tool == "arrow"):
        return "arrow"
    else if (tool == "signature"):
        return "signature"

