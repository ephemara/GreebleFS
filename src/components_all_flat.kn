const xtermRegistry: Any = ts_Map()

fn getTerminalPaneDomKey(tabId: String, nodeId: String) -> String:
    return tabId + "::" + nodeId

fn applyTerminalPaneFrameToElement(element: HTMLElement, frame: TerminalPaneFrame) -> ():
    element.style.left = (frame.x * 100) + "%"
    element.style.top = (frame.y * 100) + "%"
    element.style.width = (frame.width * 100) + "%"
    element.style.height = (frame.height * 100) + "%"

fn applyTerminalSplitHandleToElement(element: HTMLElement, handle: TerminalPaneSplitHandle) -> ():
    let isColumnSplit = (handle.direction == "columns")
    element.style.left = none
    element.style.top = none
    element.style.width = none
    element.style.height = none
    element.style.cursor = none

fn shouldKeepTerminalViewportPinnedToBottom(term: XTerm) -> Any:
    let viewportY = term.buffer.active.viewportY
    let baseY = term.buffer.active.baseY
    if ((!ts_Number.isFinite(viewportY)) or (!ts_Number.isFinite(baseY))):
        return true
    return (Math.abs((baseY - viewportY)) <= 1)

fn destroyXterm(id: String) -> Any:
    let e = xtermRegistry.get(id)
    if (!e):
        return none
    e.unlisten()
    e.xterm.dispose()
    commands.terminalKill(id).then(unwrapTauriResult).catch_(none)
    xtermRegistry.delete_(id)
    unregisterTerminalPaneHostEntry(id)

fn copyTextToClipboard(text: String) -> Any:
    if (!text):
        return false

fn formatCopiedLineLabel(text: String) -> Any:
    let lineCount = text.split(none).filter(none).length
    return none

