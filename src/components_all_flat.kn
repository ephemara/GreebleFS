fn buildConstellationFieldLayout(bands: Any, selectedPaths: ReadonlySet<String>, density: Float, options: ConstellationFieldLayoutOptions) -> Any:
    let normalizedDensity = clamp(density, 0, 1)
    let maxVisibleNodes = clampNumber(Math.round((8 + (normalizedDensity * 22))), 8, 30)
    let visibleBands = bands.filter(none)
