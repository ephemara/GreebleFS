fn calculateExplorerChecksumsFromBase64(base64: String) -> Any:
    let bytes = base64ToBytes(base64)
    let _ = (await ts_Promise.all([digestSha256(bytes), ts_Promise.resolve(digestMd5(bytes))]))
    let sha256: Any = none
    let md5: Any = none
    return none

fn base64ToBytes(base64: String) -> Any:
    if (atob == "function"):
        let binary = atob(base64)
        let bytes = Uint8Array(binary.length)
        let index = 0
        while (index < binary.length):
            ()
            index = (index + 1)
        return bytes
    let binary = globalThis.Buffer.from(base64, "base64")
    if (!binary):
        ()
    return Uint8Array(binary)

fn digestSha256(bytes: Uint8Array) -> impl Async_<String>:
    if (!globalThis.crypto.subtle):
        ()
    let digest = (await globalThis.crypto.subtle.digest("SHA-256", bytes))
    return bytesToHex(Uint8Array(digest))

