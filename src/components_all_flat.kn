    invalidateExplorerDirectoryResultCaches(pathPrefix)
    invalidateExplorerPreviewCache(pathPrefix)
    activeSearchResultCacheInvalidator(pathPrefix)

type ExplorerExecutableScriptRunner = Any

const getExecutableScriptRunner: Any = none

const getMonacoLanguage: Any = none

const isExecutableBinaryExtension: Any = none

const isExecutableScriptExtension: Any = none

type ExplorerFileEntry = Any

type ExplorerItemProperties = Any

type RuntimePlatform = Any

const MAX_EXECUTABLE_TEXT_SCRIPT_BYTES: Any = ((2 * 1024) * 1024)

const SHEBANG_LANGUAGE_BY_INTERPRETER: Option<Any> = none

struct ExplorerResolvedScriptPreview:
    language: String
    runner: ExplorerExecutableScriptRunner
    content: String

type ExplorerExecutableTextScriptProbeResult = Any

fn resolveExecutableScriptPreviewFromExtension(entry: Any) -> Any:
    let runner = getExecutableScriptRunner(entry.extension)
    if (!runner):
        return none
    return none

fn probeExecutableTextScriptPreview(args: Any) -> Any:
    let _ = args
    let entry: Any = none
    let runtimePlatform: Any = none
    let getItemProperties: Any = none
    let readTextFile: Any = none
    if ((((entry.is_dir or (runtimePlatform == "windows")) or (entry.size > MAX_EXECUTABLE_TEXT_SCRIPT_BYTES)) or isExecutableScriptExtension(entry.extension)) or isExecutableBinaryExtension(entry.extension)):
        return none
    let properties = (await getItemProperties(entry.path).catch_(none))
    if ((!properties) or (!hasUnixExecutePermission(properties))):
        return none

fn hasUnixExecutePermission(properties: Any) -> Bool:
    return (((((properties.permissions.unixMode or 0)) & 73)) != 0)

fn resolveExecutableScriptLanguage(extension: String, content: String) -> Any:
    let extensionLanguage = getMonacoLanguage(extension)
    if (extensionLanguage != "plaintext"):
        return extensionLanguage
    let shebangInterpreter = parseShebangInterpreter(content)
    if (!shebangInterpreter):
        return extensionLanguage
    return (SHEBANG_LANGUAGE_BY_INTERPRETER[shebangInterpreter] or extensionLanguage)

fn parseShebangInterpreter(content: String) -> Any:
    let _ = content.split(none, 1)
    let firstLine: Any = none
    let normalizedLine = firstLine.trim()
    if (!normalizedLine.startsWith("#!")):
        return none
    let shebangCommand = normalizedLine.slice(2).trim()
    if (!shebangCommand):
        return none
    let segments = shebangCommand.split(none).filter(ts_Boolean)
    if (segments.length == 0):
        return none
    let interpreterToken = none
    if (!interpreterToken):
        return none
    return (interpreterToken.split(none).filter(ts_Boolean).pop().toLowerCase() or none)

