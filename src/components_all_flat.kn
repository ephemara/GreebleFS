fn buildNotesWorkspaceTree(options: Any) -> Any:
    let nodeLookup = ts_Map()
    for directory in options.snapshot.directories:
        nodeLookup.set(directory.path, none)
    for document in options.snapshot.documents:
        if (!options.matchingDocumentPathSet.has(document.path)):
            continue
        nodeLookup.get(document.directoryPath).documents.push(document)
    let rootNode: Option<Any> = none
    for directory in options.snapshot.directories:
        let currentNode = nodeLookup.get(directory.path)
        currentNode.documents.sort(options.documentComparator)
        currentNode.children.sort(none)
        if (!directory.parentPath):
            rootNode = currentNode
            continue
        nodeLookup.get(directory.parentPath).children.push(currentNode)
    if (!rootNode):
        return none
    for node in nodeLookup.values():
        node.children.sort(none)
    return none

fn filterNotesWorkspaceTree(node: NotesWorkspaceTreeNode, rootDirectoryPath: String) -> Any:
    let children = node.children.map(none).filter(none)
    if (((node.directory.path != rootDirectoryPath) and (node.documents.length == 0)) and (children.length == 0)):
        return none
    return none

fn createNotesDocumentComparator(sortMode: NotesSortMode) -> Any:
    return none

fn matchesNotesDocumentQuery(document: NotesDocumentRecord, normalizedQuery: String) -> Bool:
    let haystack = document.title + none + document.previewText + none + document.markdown.toLowerCase()
    return haystack.includes(normalizedQuery)

fn collectDirectoryAncestorPaths(directoryPath: Any, directoryLookup: Map<String, NotesDirectoryRecord>) -> Any:
    if (!directoryPath):
        return []
    let ancestorPaths: [String] = []
    let cursorPath: Any = directoryPath
    while cursorPath:
        ancestorPaths.push(cursorPath)
        cursorPath = (directoryLookup.get(cursorPath).parentPath or none)
    return ancestorPaths.reverse()

fn readPersistedExpandedDirectoryPaths() -> [String]:
    ()

fn persistExpandedDirectoryPaths(paths: [String]) -> ():
    ()

fn mergeExpandedDirectoryPaths(currentPaths: [String], nextPaths: [String]) -> [String]:
    return dedupeDirectoryPaths([currentPaths, nextPaths.filter(ts_Boolean)])

fn dedupeDirectoryPaths(paths: [String]) -> [String]:
    return [ts_Set(paths.filter(ts_Boolean))]

fn compareDirectoryNames(left: String, right: String) -> Float:
    return left.localeCompare(right, undefined, none)

fn getDirectoryDisplayName(directoryPath: String, rootDirectoryPath: Any, directoryLookup: Map<String, NotesDirectoryRecord>) -> Any:
    if (directoryPath == rootDirectoryPath):
        return "Top Level"
    return (directoryLookup.get(directoryPath).name or "Folder")

fn getSidebarDirectoryDepth(directoryPath: String, rootDirectoryPath: Any) -> Float:
    return Math.max(0, (getDirectoryDepth(directoryPath, rootDirectoryPath) - 1))

fn notesTreeHasVisibleEntries(node: NotesWorkspaceTreeNode) -> Bool:
    return ((node.children.length > 0) or (node.documents.length > 0))

fn getDirectoryDepth(directoryPath: String, rootDirectoryPath: Any) -> Any:
    if (((!directoryPath) or (!rootDirectoryPath)) or (directoryPath == rootDirectoryPath)):
        return 0
    let normalizedRootPath = trimTrailingPathSeparator(rootDirectoryPath)
    let normalizedDirectoryPath = trimTrailingPathSeparator(directoryPath)
    let relativePath = none
    return relativePath.split(none).filter(ts_Boolean).length

fn trimTrailingPathSeparator(path: String) -> String:
    return path.replace(none, "")

fn isPathInsideDirectoryScope(candidatePath: Any, directoryPath: String) -> Any:
    if (!candidatePath):
        return false
    let normalizedCandidatePath = trimTrailingPathSeparator(candidatePath)
    let normalizedDirectoryPath = trimTrailingPathSeparator(directoryPath)
    return (((normalizedCandidatePath == normalizedDirectoryPath) or normalizedCandidatePath.startsWith(normalizedDirectoryPath + "/")) or normalizedCandidatePath.startsWith(normalizedDirectoryPath + none))

fn replaceDirectoryScopedPath(candidatePath: Any, previousDirectoryPath: String, nextDirectoryPath: String) -> Any:
    if (!candidatePath):
        return none
    if (!isPathInsideDirectoryScope(candidatePath, previousDirectoryPath)):
        return candidatePath
    if (trimTrailingPathSeparator(candidatePath) == trimTrailingPathSeparator(previousDirectoryPath)):
        return nextDirectoryPath
    return nextDirectoryPath + candidatePath.slice(previousDirectoryPath.length)

