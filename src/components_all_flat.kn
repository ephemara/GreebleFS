type PanelRuntimeStatus = String

fn createDefaultHostSize() -> Any:
    return none

fn formatRuntimeEventLabel(event: Any) -> Any:
    if (!event):
        return "No runtime event yet"
    if (event.kind == "ready"):
        return "runtime ready"
    if (event.kind == "error"):
        return "runtime error: " + event.message
    if (event.kind == "request-resize"):
        return "resize requested: " + event.width + "x" + event.height
    let payloadPreview = none
    return event.name + payloadPreview.trim()

fn hostToolbarButtonStyle() -> Any:
    return none

fn hostPillStyle(background: String) -> Any:
    return none

component GoRuntimeSmokePanel(appearance: Any) with Reactive:
    state panelRef: Any = useRef(none)
    state runtimeViewportRef: Any = useRef(none)
    state hostSize: Any = createDefaultHostSize
    state hasResolvedHostSize: Any = false
    state runtimeStatus: PanelRuntimeStatus = "booting"
    state runtimeError: Any = none
    state lastRuntimeEvent: Any = none
    state lastRuntimeEventAt: Any = none
    fn setHostSize(value: Any):
        hostSize = value

    fn setHasResolvedHostSize(value: Any):
        hasResolvedHostSize = value

    fn setRuntimeStatus(value: PanelRuntimeStatus):
        runtimeStatus = value

    fn setRuntimeError(value: Any):
        runtimeError = value

    fn setLastRuntimeEvent(value: Any):
        lastRuntimeEvent = value

    fn setLastRuntimeEventAt(value: Any):
        lastRuntimeEventAt = value

    fn __component_effect_0() -> Any:
        let element = runtimeViewportRef.current
        if ((!element) or (ResizeObserver == "undefined")):
            setHasResolvedHostSize(true)
            return undefined
        let observer = ResizeObserver(none)
        observer.observe(element)
        return none

    fn context() -> Any:
        return (none)

    fn handleRuntimeEvent(event: GoPanelHostEvent) -> Any:
        setLastRuntimeEvent(event)
        setLastRuntimeEventAt(Date().toLocaleTimeString())
        if (event.kind == "error"):
            setRuntimeStatus("error")
            setRuntimeError(event.message)
            return none
        if (event.kind == "ready"):
            setRuntimeStatus("ready")
            setRuntimeError(none)

    render <div style={none}><section style={none}><div style={none}><div style={none}><div style={none}><Cpu size={16} style={none} /></div><div><div style={none}>{"Go/Wasm Runtime Smoke Panel"}</div><div style={none}>{"Real `wasm-panel` runtime, live host events, and persisted local state."}</div></div></div><div style={none}><div style={hostPillStyle(none)}>{"Status:"}{runtimeStatus}</div><div style={hostPillStyle(PANEL_BACKGROUND)}>{"Runtime: `sample-panel`"}</div><div style={hostPillStyle(PANEL_BACKGROUND)}>{"Viewport:"}{hostSize.width}{"x"}{hostSize.height}</div></div></div><div style={none}><button type="button" onClick={none} style={hostToolbarButtonStyle()}><RefreshCw size={14} />{"Reload Runtime"}</button><div style={none}>{"Last runtime event"}{none}{":"}{formatRuntimeEventLabel(lastRuntimeEvent)}</div></div></section><div ref={runtimeViewportRef} style={none}>{none}</div></div>

