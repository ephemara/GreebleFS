    width: Float
    height: Float

type SelectionHandle = String

struct Point2D:
    x: Float
    y: Float

fn isSupportedScreenshotEntry(entry: ScreenshotEntryLike) -> Bool:
    return ((!entry.is_dir) and screenshotFeatureConfig.supportedExtensions.includes(entry.extension.toLowerCase()))

fn sortScreenshotEntries(entries: [T]) -> [T]:
    return [entries].sort(none)

fn normalizeSelection(selection: RectSelection) -> Any:
    let x = Math.min(selection.x, (selection.x + selection.width))
    let y = Math.min(selection.y, (selection.y + selection.height))
    let width = Math.abs(selection.width)
    let height = Math.abs(selection.height)
    return none

fn createFullSelection(rendered: RenderedSize) -> Any:
    return none

fn createInsetSelection(rendered: RenderedSize, insetRatio: Float) -> RectSelection:
    let insetRatio: Any = none
    let insetX = (rendered.width * insetRatio)
    let insetY = (rendered.height * insetRatio)
    return clampSelectionToBounds(none, rendered, screenshotFeatureConfig.editor.minSelectionSize)

fn clampSelectionToBounds(selection: RectSelection, rendered: RenderedSize, minSize: Float) -> Any:
    let minSize: Any = none
    let normalized = normalizeSelection(selection)
    let width = Math.min(Math.max(normalized.width, minSize), rendered.width)
    let height = Math.min(Math.max(normalized.height, minSize), rendered.height)
    let x = clamp(normalized.x, 0, Math.max((rendered.width - width), 0))
    let y = clamp(normalized.y, 0, Math.max((rendered.height - height), 0))
    return none

fn moveSelection(selection: RectSelection, deltaX: Float, deltaY: Float, rendered: RenderedSize) -> RectSelection:
    let normalized = normalizeSelection(selection)
    return clampSelectionToBounds(none, rendered)

fn resizeSelection(selection: RectSelection, handle: Any, deltaX: Float, deltaY: Float, rendered: RenderedSize, minSize: Float) -> Any:
    let minSize: Any = none
    let normalized = normalizeSelection(selection)
    let left = normalized.x
    let top = normalized.y
    let right = (normalized.x + normalized.width)
    let bottom = (normalized.y + normalized.height)
    if handle.includes("west"):
        left = clamp((left + deltaX), 0, (right - minSize))
    if handle.includes("east"):
        right = clamp((right + deltaX), (left + minSize), rendered.width)
    if handle.includes("north"):
        top = clamp((top + deltaY), 0, (bottom - minSize))
    if handle.includes("south"):
        bottom = clamp((bottom + deltaY), (top + minSize), rendered.height)
    return none

fn isPointInSelection(point: Point2D, selection: RectSelection) -> Bool:
    let normalized = normalizeSelection(selection)
    return ((((point.x >= normalized.x) and (point.x <= (normalized.x + normalized.width))) and (point.y >= normalized.y)) and (point.y <= (normalized.y + normalized.height)))

fn getSelectionHandleAtPoint(point: Point2D, selection: RectSelection, handleRadius: Float) -> Any:
    let normalized = normalizeSelection(selection)
    let left = normalized.x
    let right = (normalized.x + normalized.width)
    let top = normalized.y
    let bottom = (normalized.y + normalized.height)
    let centerX = (left + (normalized.width / 2))
    let centerY = (top + (normalized.height / 2))
    let handles: [Any] = [none, none, none, none, none, none, none, none]
    for handle in handles:
        if ((Math.abs((point.x - handle.x)) <= handleRadius) and (Math.abs((point.y - handle.y)) <= handleRadius)):
            return handle.handle
    return none

fn areSelectionsEqual(left: Any, right: Any) -> Any:
    if ((!left) and (!right)):
        return true
    if ((!left) or (!right)):
        return false
    let normalizedLeft = normalizeSelection(left)
    let normalizedRight = normalizeSelection(right)
    return ((((normalizedLeft.x == normalizedRight.x) and (normalizedLeft.y == normalizedRight.y)) and (normalizedLeft.width == normalizedRight.width)) and (normalizedLeft.height == normalizedRight.height))

fn roundSelection(selection: RectSelection) -> Any:
    let normalized = normalizeSelection(selection)
    return none

fn selectionToMonitorRect(selection: RectSelection, rendered: RenderedSize, monitor: MonitorBounds) -> Any:
    let pixelRect = selectionToPixelRect(selection, rendered, monitor)
    return none

fn selectionToPixelRect(selection: RectSelection, rendered: RenderedSize, image: PixelSize) -> Any:
    let normalized = normalizeSelection(selection)
    let scaleX = (image.width / rendered.width)
    let scaleY = (image.height / rendered.height)
    return none

fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(Math.max(value, min), max)

