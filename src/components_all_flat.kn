    if cachedTerminalWebglSupport:
        return cachedTerminalWebglSupport
    if (document == "undefined"):
        cachedTerminalWebglSupport = none
        return cachedTerminalWebglSupport

fn shouldLoadTerminalWebglRenderer(rendererPreference: OverlayWorkbenchTerminalRenderer) -> Any:
    if (rendererPreference == "dom"):
        return false
    let support = probeTerminalWebglSupport()
    return (support.contextAvailable and (!support.softwareRenderer))

type ExplorerExecutableScriptRunner = Any

fn escapeSingleQuotedPath(path: String) -> String:
    return path.replace("/'/g", none)

fn escapePowerShellSingleQuotedPath(path: String) -> String:
    return path.replace("/'/g", "''")

fn shellExecutableName(shell: String) -> Any:
    let trimmed = shell.trim()
    if (!trimmed):
        return ""
    let match_ = trimmed.match_(none)
    return ((((match_[1] or match_[2]) or match_[3]) or trimmed)).toLowerCase()

fn isPowerShellShell(normalizedShell: String) -> Bool:
    return (((normalizedShell.endsWith("powershell.exe") or normalizedShell.endsWith("powershell")) or normalizedShell.endsWith("pwsh.exe")) or normalizedShell.endsWith("pwsh"))

fn isCmdShell(normalizedShell: String) -> Bool:
    return (normalizedShell.endsWith("cmd.exe") or normalizedShell.endsWith("cmd"))

fn quotePathForPowerShell(path: String) -> String:
    return "'" + escapePowerShellSingleQuotedPath(path) + "'"

fn quotePathForCmd(path: String) -> String:
    return none + path.replace(none, none) + none

fn quotePathForUnixShell(path: String) -> String:
    return "'" + escapeSingleQuotedPath(path) + "'"

fn buildTerminalCdCommand(path: String, shell: String) -> Any:
    let normalizedPath = path.trim()
    let normalizedShell = shellExecutableName(shell)
    if (!normalizedPath):
        return ""
    if isPowerShellShell(normalizedShell):
        return "Set-Location -LiteralPath '" + escapePowerShellSingleQuotedPath(normalizedPath) + "'"
    if isCmdShell(normalizedShell):
        let escaped = normalizedPath.replace(none, none)
        return none + escaped + none
    if (((normalizedShell.endsWith("bash.exe") or normalizedShell.endsWith("bash")) or normalizedShell.endsWith("zsh")) or normalizedShell.endsWith("fish")):
        return "builtin cd -- '" + escapeSingleQuotedPath(normalizedPath) + "'"
    return "cd -- '" + escapeSingleQuotedPath(normalizedPath) + "'"

fn buildTerminalScriptRunCommand(args: Any) -> Any:
    let normalizedPath = args.path.trim()
    let normalizedShell = shellExecutableName(args.shell)
    if (!normalizedPath):
        return ""
    if (args.runner == "batch"):
        if isPowerShellShell(normalizedShell):
            return "& " + quotePathForPowerShell(normalizedPath)
        if isCmdShell(normalizedShell):
            return "call " + quotePathForCmd(normalizedPath)
        return "cmd.exe /c " + quotePathForUnixShell(quotePathForCmd(normalizedPath))
    if (args.runner == "powershell"):
        if isPowerShellShell(normalizedShell):
            return "& " + quotePathForPowerShell(normalizedPath)
        if isCmdShell(normalizedShell):
            return "powershell.exe -NoProfile -ExecutionPolicy Bypass -File " + quotePathForCmd(normalizedPath)
        return "if command -v pwsh >/dev/null 2>&1; then pwsh -NoProfile -ExecutionPolicy Bypass -File " + quotePathForUnixShell(normalizedPath) + "; elif command -v powershell >/dev/null 2>&1; then powershell -NoProfile -ExecutionPolicy Bypass -File " + quotePathForUnixShell(normalizedPath) + "; else echo 'PowerShell is not available in PATH.'; fi"
    if (args.runner == "direct"):
        if isPowerShellShell(normalizedShell):
            return "& " + quotePathForPowerShell(normalizedPath)
        if isCmdShell(normalizedShell):
            return "call " + quotePathForCmd(normalizedPath)
        return quotePathForUnixShell(normalizedPath)
    let interpreter = args.runner
    if isPowerShellShell(normalizedShell):
        return "& " + interpreter + " " + quotePathForPowerShell(normalizedPath)
    if isCmdShell(normalizedShell):
        return interpreter + " " + quotePathForCmd(normalizedPath)
    return interpreter + " " + quotePathForUnixShell(normalizedPath)

fn buildTerminalPythonRunCommand(args: Any) -> Any:
    let normalizedPath = args.path.trim()
    let normalizedShell = shellExecutableName(args.shell)
    if (!normalizedPath):
        return ""
    if isPowerShellShell(normalizedShell):
        return "if (Get-Command python -ErrorAction SilentlyContinue) { & python " + quotePathForPowerShell(normalizedPath) + " } elseif (Get-Command py -ErrorAction SilentlyContinue) { & py -3 " + quotePathForPowerShell(normalizedPath) + " } else { Write-Host 'Python is not available in PATH.' }"
    if isCmdShell(normalizedShell):
        return "python " + quotePathForCmd(normalizedPath) + " || py -3 " + quotePathForCmd(normalizedPath)
    return "if command -v python3 >/dev/null 2>&1; then python3 " + quotePathForUnixShell(normalizedPath) + "; elif command -v python >/dev/null 2>&1; then python " + quotePathForUnixShell(normalizedPath) + "; else echo 'Python is not available in PATH.'; fi"

