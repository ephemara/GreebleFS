component PythonSidebarContent(theme: Any, emitToTerminal: Any, announce: Any, shell: Any, platform: Any, launchManagedRepl: Any) with Reactive:
    state pythonSettings: Any = useSettingsStore(none)
    state status: Any = none
    state sidecarStatus: Any = none
    state loadingStatus: Any = true
    state statusError: Any = none
    state pendingAction: Any = none
    state buttonStyle: Any = none
    fn runtimeConfig() -> Any:
        return createPythonRuntimeConfig(pythonSettings)

    fn setStatus(value: Any):
        status = value

    fn setSidecarStatus(value: Any):
        sidecarStatus = value

    fn setLoadingStatus(value: Any):
        loadingStatus = value

    fn setStatusError(value: Any):
        statusError = value

    fn setPendingAction(value: Any):
        pendingAction = value

    fn refreshStatus():
        setLoadingStatus(true)
        setStatusError(none)

    fn __component_effect_2():
        refreshStatus()

    fn runAction(label: String, factory: Any):
        setPendingAction(label)
        setStatusError(none)

    fn runSidecarAction(label: String, factory: Any):
        setPendingAction(label)
        setStatusError(none)

    fn runSidecarLifecycle(label: String, factory: Any):
        setPendingAction(label)
        setStatusError(none)

    fn bootstrapRuntime():
        (await runAction("Bootstrapped Python runtime", none))

    fn installConfiguredPackages():
        (await runAction("Installed configured Python packages", none))

    fn applyPackagePreset(packages: [String]):
        (await runAction("Installed Python package preset", none))

    fn startManagedSidecar():
        (await runSidecarLifecycle("Started Python sidecar", none))

    fn stopManagedSidecar():
        (await runSidecarLifecycle("Stopped Python sidecar", none))

    fn openManagedRepl() -> Any:
        if ((!status.ready) or (!status.managedPythonPath)):
            announce("Managed Python is not ready yet")
            return none
        let replCommand = buildManagedPythonReplCommand(status.managedPythonPath, shell, platform)
        (await launchManagedRepl(replCommand))
        announce("Opened managed Python REPL")

    fn runPreset(preset: PythonExamplePreset):
        (await runAction("Ran " + preset.label, none))

    fn runRuntimeSummary():
        (await runSidecarAction("Ran Python runtime summary", none))

    fn runMlProbe():
        (await runSidecarAction("Probed Python ML runtime", none))

    fn runWorkingDirectoryScan():
        (await runSidecarAction("Scanned working directory with Python", none))

    render <div />

