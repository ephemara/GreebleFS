fn getPreviewTextWorkbenchSession(preview: PreviewState, path: String) -> Any:
    if (preview.path != path):
        return none
    if (preview.type_ == "text"):
        return none
    if ((preview.type_ == "plugin") and preview.delegateText):
        return none
    return none

fn updatePreviewTextWorkbenchState(preview: PreviewState, path: String, updater: Any) -> Any:
    if (preview.path != path):
        return preview
    if (preview.type_ == "text"):
        return none
    if ((preview.type_ == "plugin") and preview.delegateText):
        return none
    return preview

fn getPreviewShaderWorkbenchSession(preview: PreviewState, path: String) -> Any:
    if (preview.path != path):
        return none
    if (preview.type_ == "shader"):
        return none
    if ((preview.type_ == "plugin") and preview.delegateShader):
        return none
    return none

fn updatePreviewShaderWorkbenchState(preview: PreviewState, path: String, updater: Any) -> Any:
    if (preview.path != path):
        return preview
    if (preview.type_ == "shader"):
        return none
    if ((preview.type_ == "plugin") and preview.delegateShader):
        return none
    return preview

