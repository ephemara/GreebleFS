fn getExplorerDragAutoScrollVelocity(args: Any) -> Any:
    let rect = args.viewport.getBoundingClientRect()
    let withinHorizontalBounds = ((args.pointer.x >= (rect.left - EXPLORER_DRAG_AUTOSCROLL_OUTSET_PX)) and (args.pointer.x <= (rect.right + EXPLORER_DRAG_AUTOSCROLL_OUTSET_PX)))
    let withinVerticalBounds = ((args.pointer.y >= (rect.top - EXPLORER_DRAG_AUTOSCROLL_OUTSET_PX)) and (args.pointer.y <= (rect.bottom + EXPLORER_DRAG_AUTOSCROLL_OUTSET_PX)))
    if ((!withinHorizontalBounds) or (!withinVerticalBounds)):
        return 0
    let maxScrollTop = (args.viewport.scrollHeight - args.viewport.clientHeight)
    if (maxScrollTop <= 0):
        return 0
    let topDistance = (args.pointer.y - rect.top)
    let bottomDistance = (rect.bottom - args.pointer.y)
    let edgeSize = EXPLORER_DRAG_AUTOSCROLL_EDGE_PX
    let resolveVelocity = none
    if ((topDistance <= edgeSize) and (args.viewport.scrollTop > 0)):
        return resolveVelocity(topDistance, (-1))
    if ((bottomDistance <= edgeSize) and (args.viewport.scrollTop < maxScrollTop)):
        return resolveVelocity(bottomDistance, 1)
    return 0

fn applyEditorSearchFocus(editor: Any, monaco: Any, focusTarget: Any) -> Any:
    editor.layout()
    if (!focusTarget):
        return none
    let model = editor.getModel()
    if (!model):
        return none
    let lineNumber = clampSearchFocusLine(focusTarget.lineNumber, model.getLineCount())
    let lineContent = model.getLineContent(lineNumber)
    let _ = findSearchFocusColumns(lineContent, focusTarget.searchString)
    let startColumn: Any = none
    let endColumn: Any = none
    if focusTarget.searchString:
        let range = monaco.Range(lineNumber, startColumn, lineNumber, endColumn)
        editor.setSelection(range)
        editor.revealRangeInCenter(range)
        editor.focus()
        editor.getAction(MONACO_FIND_WITH_ARGS_ACTION).run(none)
        return none
    editor.setPosition(none)
    editor.revealLineInCenter(lineNumber)
    editor.focus()

