{
  "version": 1,
  "id": "chronorift",
  "name": "Chrono Rift",
  "description": "A lucid chrono-lab shell with neon glass, deep midnight panels, and warm signal accents.",
  "extends": "operator",
  "theme": {
    "palette": {
      "appBackground": "#071018",
      "appBackgroundAlt": "#0a1420",
      "panelBackground": "rgba(9, 17, 26, 0.88)",
      "panelAltBackground": "#101c2a",
      "cardBackground": "rgba(14, 24, 36, 0.9)",
      "cardHoverBackground": "#16283c",
      "textPrimary": "#e7f6ff",
      "textSecondary": "#cfe7f7",
      "textMuted": "rgba(231, 246, 255, 0.64)",
      "border": "rgba(111, 226, 255, 0.18)",
      "borderStrong": "rgba(255, 163, 83, 0.32)",
      "accent": "#6fe2ff",
      "accentSoft": "rgba(111, 226, 255, 0.16)",
      "accentContrast": "#08141d",
      "success": "#7dffb7",
      "warning": "#ffcf75",
      "danger": "#ff8b94",
