use serde::{Deserialize, Serialize};
use std::path::PathBuf;

#[derive(Debug, Clone, Serialize, Deserialize, specta::Type)]
#[serde(rename_all = "camelCase")]
pub struct HexReadRangeRequest {
    pub path: String,
    pub offset: u64,
    pub length: u64,
}

