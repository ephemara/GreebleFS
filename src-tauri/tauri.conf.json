{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GreebleFS",
  "version": "0.1.0",
  "identifier": "co.greeblefs.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "GreebleFS",
        "width": 1000,
        "height": 500,
        "dragDropEnabled": true,
        "scrollBarStyle": "default",
        "transparent": true,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../dist-mobile/": "mobile-dist/",
      "icons/tray.ico": "icons/tray.ico",
      "icons/icon.ico": "icons/icon.ico"
    }
  }
}
