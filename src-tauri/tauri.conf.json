{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OverlayTerm",
  "version": "0.1.0",
  "identifier": "co.overlayterm.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "OverlayTerm",
        "width": 1000,
        "height": 500,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "icons/tray.ico": "icons/tray.ico",
      "icons/icon.ico": "icons/icon.ico"
    }
  }
}
