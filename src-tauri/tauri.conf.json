{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GreebleFS",
  "version": "0.1.0",
  "identifier": "co.greeblefs.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "GreebleFS",
        "width": 1000,
        "height": 500,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "icons/tray.ico": "icons/tray.ico",
      "icons/icon.ico": "icons/icon.ico",
      "../packages/sox/bin/sox-14.4.2-linux.zip": "packages/sox/bin/sox-14.4.2-linux.zip",
      "../packages/sox/bin/sox-14.4.2-darwin.zip": "packages/sox/bin/sox-14.4.2-darwin.zip",
      "../packages/sox/bin/sox-14.4.2-win32.zip": "packages/sox/bin/sox-14.4.2-win32.zip"
    }
  }
}
