{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GreebleFS",
  "version": "0.1.0",
  "identifier": "co.greeblefs.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "GreebleFS",
        "width": 1000,
        "height": 500,
        "dragDropEnabled": true,
        "scrollBarStyle": "default",
        "transparent": true,
        "webview2VisualHostingMode": "compositionController",
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "template": "./windows/greeblefs-installer.nsi",
        "headerImage": "./windows/assets/greeblefs-installer-header.bmp",
        "sidebarImage": "./windows/assets/greeblefs-installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "startMenuFolder": "GreebleFS"
      }
    },
    "resources": {
      "../dist-mobile/": "mobile-dist/",
      "../usr/": "usr/",
      "icons/tray.ico": "icons/tray.ico",
      "icons/icon.ico": "icons/icon.ico"
    }
  }
}
