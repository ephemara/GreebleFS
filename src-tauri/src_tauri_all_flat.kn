fn pdf_open_preview_document(manager: tauri::State<_, PdfPreviewManager>, input_path: String) -> Result<PdfPreviewDocument, String>:
    let manager = manager.inner().clone()
    (await tauri__async_runtime__spawn_blocking(|| manager.open_preview_document(input_path))).map_err(|error| format!("PDF preview open task failed to join: {error}"))?

