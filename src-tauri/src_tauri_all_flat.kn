fn image_cutout_open_session(app: tauri::AppHandle, manager: tauri::State<_, ImageCutoutManager>, request: ImageCutoutSessionOpenRequest) -> Result<ImageCutoutSessionSnapshot, String>:
    let manager = manager.inner().clone()
    (await tauri__async_runtime__spawn_blocking(|| manager.open_session(app, request))).map_err(|error| format!("Image cutout open-session task failed to join: {error}"))?

fn image_cutout_apply_prompts(app: tauri::AppHandle, manager: tauri::State<_, ImageCutoutManager>, request: ImageCutoutApplyPromptsRequest) -> Result<ImageCutoutSessionSnapshot, String>:
    let manager = manager.inner().clone()
    (await tauri__async_runtime__spawn_blocking(|| manager.apply_prompts(app, request))).map_err(|error| format!("Image cutout prompt task failed to join: {error}"))?

fn image_cutout_reset_session(app: tauri::AppHandle, manager: tauri::State<_, ImageCutoutManager>, request: ImageCutoutResetSessionRequest) -> Result<ImageCutoutSessionSnapshot, String>:
    let manager = manager.inner().clone()
    (await tauri__async_runtime__spawn_blocking(|| manager.reset_session(app, request))).map_err(|error| format!("Image cutout reset task failed to join: {error}"))?

fn image_cutout_stage_export(app: tauri::AppHandle, manager: tauri::State<_, ImageCutoutManager>, request: ImageCutoutStageExportRequest) -> Result<ImageCutoutStagedExportArtifact, String>:
    let manager = manager.inner().clone()
    (await tauri__async_runtime__spawn_blocking(|| manager.stage_export(app, request))).map_err(|error| format!("Image cutout stage-export task failed to join: {error}"))?

fn image_cutout_copy_to_clipboard(app: tauri::AppHandle, manager: tauri::State<_, ImageCutoutManager>, request: ImageCutoutCopyToClipboardRequest) -> Result<ImageCutoutStagedExportArtifact, String>:
    let manager = manager.inner().clone()
    (await tauri__async_runtime__spawn_blocking(|| manager.copy_to_clipboard(app, request))).map_err(|error| format!("Image cutout clipboard task failed to join: {error}"))?

fn image_cutout_close_session(app: tauri::AppHandle, manager: tauri::State<_, ImageCutoutManager>, session_id: String) -> Result<(), String>:
    manager.close_session(app, session_id)

impl ImageCutoutManager:
    fn open_session(_self: &ImageCutoutManager, app: tauri::AppHandle, request: ImageCutoutSessionOpenRequest) -> Result<ImageCutoutSessionSnapshot, String>:
        validate_cutout_input(&request)?
        ()
        let session_id = format!("image-cutout-{}", (*_self).inner.next_session_id.fetch_add(1, std::sync::atomic::Ordering::Relaxed) + 1)
        let preview_max_dimension = request.preview_max_dimension.unwrap_or(DEFAULT_IMAGE_CUTOUT_PREVIEW_MAX_DIMENSION).clamp(256, 2048)
        let logical_output_path = normalize_optional_output_path(request.logical_output_path.clone())
        let workflow_mode = request.workflow_mode
        let response: PythonSidecarDecodedActionResponse<PythonImageCutoutSessionSnapshot> = python_sidecar__call_sidecar_action_json_with_ipc(&app, request.config.clone(), python_sidecar__action_ids__IMAGE_CUTOUT_OPEN_SESSION, Option::Some(PythonImageCutoutOpenSessionPayload { session_id: session_id.clone(), input_path: request.input_path.clone(), input_artifact_id: request.input_artifact.map(|artifact| artifact.id.clone()), input_data_url: request.input_data_url.clone(), logical_output_path: logical_output_path.clone(), preview_max_dimension: preview_max_dimension, model_id: request.model_id.clone(), backend_preference: request.backend_preference.clone(), workflow_mode: workflow_mode }), request.input_artifact.clone().map(|artifact| vec!(artifact)), none, none, none, Option::Some(true))?
        let snapshot = build_cutout_snapshot(response.result, &response.raw.output_artifacts, &response.raw.output_artifact_tokens)?
        let snapshot_artifact_ids = collect_snapshot_artifact_ids(&snapshot)
        let mut sessions = (*_self).inner.sessions.lock().map_err(
            |_| block:
                release_ipc_artifacts(&app, &snapshot_artifact_ids)
                ()
                "Image cutout session map was poisoned.".to_string()
        )?
        sessions.insert(session_id.clone(), ImageCutoutSession { logical_output_path: logical_output_path, workflow_mode: workflow_mode, preview_mask_artifact_id: Option::Some(snapshot.preview_mask.artifact.id.clone()), cutout_preview_artifact_id: Option::Some(snapshot.cutout_preview_artifact.id.clone()) })
        ()
        Result::Ok(snapshot)

    fn apply_prompts(_self: &ImageCutoutManager, app: tauri::AppHandle, request: ImageCutoutApplyPromptsRequest) -> Result<ImageCutoutSessionSnapshot, String>:
        let session_id = request.session_id.trim().to_string()
        (*_self).get_session(&session_id)?
        ()
        let session_id_for_update = session_id.clone()
        let response: PythonSidecarDecodedActionResponse<PythonImageCutoutSessionSnapshot> = python_sidecar__call_sidecar_action_json(&app, none, python_sidecar__action_ids__IMAGE_CUTOUT_APPLY_PROMPTS, Option::Some(PythonImageCutoutApplyPromptsPayload { session_id: session_id, prompts: request.prompts }), none, none, Option::Some(true))?
        let snapshot = build_cutout_snapshot(response.result, &response.raw.output_artifacts, &response.raw.output_artifact_tokens)?
        (*_self).replace_session_preview_artifacts(&app, &session_id_for_update, &snapshot)?
        ()
        Result::Ok(snapshot)

    fn reset_session(_self: &ImageCutoutManager, app: tauri::AppHandle, request: ImageCutoutResetSessionRequest) -> Result<ImageCutoutSessionSnapshot, String>:
        let session_id = request.session_id.trim().to_string()
        (*_self).get_session(&session_id)?
        ()
        let session_id_for_update = session_id.clone()
        let response: PythonSidecarDecodedActionResponse<PythonImageCutoutSessionSnapshot> = python_sidecar__call_sidecar_action_json(&app, none, python_sidecar__action_ids__IMAGE_CUTOUT_RESET_SESSION, Option::Some(PythonImageCutoutSessionIdPayload { session_id: session_id }), none, none, Option::Some(true))?
        let snapshot = build_cutout_snapshot(response.result, &response.raw.output_artifacts, &response.raw.output_artifact_tokens)?
        (*_self).replace_session_preview_artifacts(&app, &session_id_for_update, &snapshot)?
        ()
        Result::Ok(snapshot)

    fn stage_export(_self: &ImageCutoutManager, app: tauri::AppHandle, request: ImageCutoutStageExportRequest) -> Result<ImageCutoutStagedExportArtifact, String>:
        let session_id = request.session_id.trim().to_string()
        let session = (*_self).get_session(&session_id)?
        let output_path = match request.export_mode:
            ImageCutoutExportMode::Staging =>
                let stage_root = resolve_cutout_stage_root(&app)?
                create_cutout_stage_path(&stage_root, request.logical_output_path.or_(session.logical_output_path))?
            ImageCutoutExportMode::SiblingPng => resolve_cutout_sibling_output_path(request.logical_output_path.or_(session.logical_output_path))?
        (*_self).stage_export_to_path(app, &session_id, output_path, request.export_mode, request.filters, request.override_mask_artifact, request.override_mask_data_url)

    fn copy_to_clipboard(_self: &ImageCutoutManager, app: tauri::AppHandle, request: ImageCutoutCopyToClipboardRequest) -> Result<ImageCutoutStagedExportArtifact, String>:
        let export_ = (*_self).stage_export(app.clone(), ImageCutoutStageExportRequest { session_id: request.session_id.clone(), export_mode: ImageCutoutExportMode::Staging, logical_output_path: request.logical_output_path.clone(), filters: request.filters, override_mask_artifact: request.override_mask_artifact, override_mask_data_url: request.override_mask_data_url })?
        let image = ((ImageReader__open(&export_.output_path).map_err(|error| format!("Failed to open staged image cutout '{}': {error}", export_.output_path))?).decode().map_err(|error| format!("Failed to decode staged image cutout '{}': {error}", export_.output_path))?).to_rgba8()
        screenshot_commands__copy_rgba_image_to_clipboard(image)?
        ()
        Result::Ok(export_)

    fn close_session(_self: &ImageCutoutManager, app: tauri::AppHandle, session_id: String) -> Result<(), String>:
        let trimmed_session_id = session_id.trim().to_string()
        let removed_session = ((*_self).inner.sessions.lock().map_err(|_| "Image cutout session map was poisoned.".to_string())?).remove(trimmed_session_id.as_str())
        match removed_session:
            Some(session) =>
                release_ipc_artifacts(&app, &collect_session_preview_artifact_ids(&session))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let _ = python_sidecar__call_sidecar_action_json(&app, none, python_sidecar__action_ids__IMAGE_CUTOUT_CLOSE_SESSION, Option::Some(PythonImageCutoutSessionIdPayload { session_id: trimmed_session_id }), none, none, Option::Some(true))
        Result::Ok(())

    fn get_session(_self: &ImageCutoutManager, session_id: String) -> Result<ImageCutoutSession, String>:
        ((*_self).inner.sessions.lock().map_err(|_| "Image cutout session map was poisoned.".to_string())?).get(session_id).cloned().ok_or_else(|| format!("Image cutout session was not found: {session_id}"))

    fn replace_session_preview_artifacts(_self: &ImageCutoutManager, app: &tauri::AppHandle, session_id: String, snapshot: &ImageCutoutSessionSnapshot) -> Result<(), String>:
        let new_artifact_ids = collect_snapshot_artifact_ids(snapshot)
        let previous_artifact_ids = block:
            let mut sessions = (*_self).inner.sessions.lock().map_err(
                |_| block:
                    release_ipc_artifacts(app, &new_artifact_ids)
                    ()
                    "Image cutout session map was poisoned.".to_string()
            )?
            let session = sessions.get_mut(session_id).ok_or_else(
                || block:
                    release_ipc_artifacts(app, &new_artifact_ids)
                    ()
                    format!("Image cutout session was not found: {session_id}")
            )?
            let previous_artifact_ids = collect_session_preview_artifact_ids(session)
            session.preview_mask_artifact_id = Option::Some((*snapshot).preview_mask.artifact.id.clone())
            ()
            session.cutout_preview_artifact_id = Option::Some((*snapshot).cutout_preview_artifact.id.clone())
            ()
            previous_artifact_ids
        release_ipc_artifacts(app, &previous_artifact_ids)
        ()
        Result::Ok(())

    fn stage_export_to_path(_self: &ImageCutoutManager, app: tauri::AppHandle, session_id: String, output_path: std::path::PathBuf, mode: ImageCutoutExportMode, filters: Option<ImageCutoutExportFilterState>, override_mask_artifact: Option<greeble_ipc_contracts::IpcArtifactRef>, override_mask_data_url: Option<String>) -> Result<ImageCutoutStagedExportArtifact, String>:
        let output_path_string = output_path.to_string_lossy().to_string()
        let response: PythonSidecarDecodedActionResponse<PythonImageCutoutStageExportResult> = python_sidecar__call_sidecar_action_json_with_ipc(
            &app,
            none,
            python_sidecar__action_ids__IMAGE_CUTOUT_STAGE_EXPORT,
            Option::Some(PythonImageCutoutStageExportPayload { session_id: session_id.to_string(), output_path: output_path_string, filters: filters, override_mask_artifact_id: match override_mask_artifact:
                Option::Some(__kain_option_as_ref_value) => Option::Some(&__kain_option_as_ref_value)
                Option::None => none.map(|artifact| artifact.id.clone()), override_mask_data_url: override_mask_data_url }),
            override_mask_artifact.map(|artifact| vec!(artifact)),
            none,
            none,
            none,
            Option::Some(true)
        )?
        let result = response.result
        let file_name = Path__new_(&result.output_path).file_name().and_then(|value| value.to_str()).unwrap_or("cutout.png").to_string()
        Result::Ok(ImageCutoutStagedExportArtifact { session_id: session_id.to_string(), mode: mode, output_path: result.output_path, file_name: file_name, width: result.width, height: result.height })


fn resolve_output_artifact_descriptor_by_token(output_artifacts: &Slice<greeble_ipc_contracts::IpcArtifactDescriptor>, output_artifact_tokens: &Slice<Option<String>>, token: String, fallback_index: usize) -> Result<greeble_ipc_contracts::IpcArtifactDescriptor, String>:
    match output_artifact_tokens.iter().enumerate().find(|__kain_closure_arg0| __kain_closure_arg0.__kain_tuple_1 == Option::Some(token)):
        Some((index, _)) =>
            return output_artifacts.get(index).cloned().ok_or_else(|| format!("Python cutout artifact token was missing a descriptor: {token}"))
        _ =>
            ()
            ()
    output_artifacts.get(fallback_index).cloned().ok_or_else(|| format!("Python cutout response did not include the expected artifact token or fallback index: {token}"))

fn build_cutout_snapshot(snapshot: PythonImageCutoutSessionSnapshot, output_artifacts: &Slice<greeble_ipc_contracts::IpcArtifactDescriptor>, output_artifact_tokens: &Slice<Option<String>>) -> Result<ImageCutoutSessionSnapshot, String>:
    let prompt_count = snapshot.prompt_count
    let preview_width = snapshot.preview_width
    let preview_height = snapshot.preview_height
    let preview_mask_artifact = resolve_output_artifact_descriptor_by_token(output_artifacts, output_artifact_tokens, snapshot.preview_mask_artifact_token.as_str(), 0)?
    let cutout_preview_artifact = resolve_output_artifact_descriptor_by_token(output_artifacts, output_artifact_tokens, snapshot.cutout_preview_artifact_token.as_str(), 1)?
    Result::Ok(ImageCutoutSessionSnapshot { session_id: snapshot.session_id, preview_mask: ImageCutoutPreviewMask { artifact: preview_mask_artifact, width: preview_width, height: preview_height }, cutout_preview_artifact: cutout_preview_artifact, preview_width: preview_width, preview_height: preview_height, prompt_count: prompt_count, can_undo: prompt_count > 0, can_redo: false, diagnostics: ImageCutoutProviderDiagnostics { provider_kind: snapshot.diagnostics.provider_kind, backend_kind: snapshot.diagnostics.backend_kind, model_id: snapshot.diagnostics.model_id, provider_model_id: snapshot.diagnostics.provider_model_id, family: snapshot.diagnostics.family, message: snapshot.diagnostics.message } })

fn collect_snapshot_artifact_ids(snapshot: &ImageCutoutSessionSnapshot) -> Array<String>:
    vec!((*snapshot).preview_mask.artifact.id.clone(), (*snapshot).cutout_preview_artifact.id.clone())

fn collect_session_preview_artifact_ids(session: &ImageCutoutSession) -> Array<String>:
    (*session).preview_mask_artifact_id.iter().chain((*session).cutout_preview_artifact_id.iter()).cloned().collect()

fn release_ipc_artifacts(app: &tauri::AppHandle, artifact_ids: &Slice<String>):
    let ipc_runtime = app.state()
    for artifact_id in artifact_ids:
        let _ = ipc_runtime.release_artifact(app, artifact_id)

fn validate_cutout_input(request: &ImageCutoutSessionOpenRequest) -> Result<(), String>:
    let has_input_path = (*request).input_path.map(|value| !value.trim().is_empty()).unwrap_or(false)
    let has_input_data_url = (*request).input_data_url.map(|value| !value.trim().is_empty()).unwrap_or(false)
    let has_input_artifact = (*request).input_artifact.map(|artifact| !artifact.id.trim().is_empty() and artifact.resource_rid != 0).unwrap_or(false)
    if !has_input_path and !has_input_data_url and !has_input_artifact:
        return Result::Err("Image cutout session open requires an inputPath, inputArtifact, or inputDataUrl.".to_string())
    Result::Ok(())

fn normalize_optional_output_path(path: Option<String>) -> Option<String>:
    path.and_then(
        |value| block:
            let trimmed = value.trim().to_string()
            if trimmed.is_empty():
                none
            else:
                Option::Some(trimmed)
    )

fn resolve_cutout_stage_root(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let root = app.path().app_local_data_dir().map(|path| path.join(IMAGE_CUTOUT_STAGE_DIR)).map_err(|error| format!("Failed to resolve cutout staging directory: {error}"))?
    resolve_cutout_stage_root_under(&root)

fn resolve_cutout_stage_root_under(root: &std::path::Path) -> Result<std::path::PathBuf, String>:
    std__fs__create_dir_all(root).map_err(|error| format!("Failed to create image cutout staging directory '{}': {error}", root.display()))?
    ()
    Result::Ok(root.to_path_buf())

fn create_cutout_stage_path(stage_root: &std::path::Path, logical_output_path: Option<String>) -> Result<std::path::PathBuf, String>:
    let created_at = current_timestamp_millis()?
    let sequence = IMAGE_CUTOUT_STAGE_SEQUENCE.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
    let file_stem = sanitize_cutout_file_stem(logical_output_path.and_then(cutout_source_file_stem).unwrap_or("cutout"))
    Result::Ok(stage_root.join(format!("{file_stem}-{created_at}-{sequence}.png")))

fn resolve_cutout_sibling_output_path(logical_output_path: Option<String>) -> Result<std::path::PathBuf, String>:
    let source_path = normalize_local_output_source_path(logical_output_path)?
    let parent = source_path.parent().ok_or_else(|| format!("Image cutout could not resolve a sibling directory for '{}'.", source_path.display()))?
    let cutout_stem = sanitize_cutout_file_stem(cutout_source_file_stem(logical_output_path.unwrap_or_default()).unwrap_or("cutout"))
    Result::Ok(parent.join(format!("{cutout_stem}.cutout.png")))

fn normalize_local_output_source_path(logical_output_path: Option<String>) -> Result<std::path::PathBuf, String>:
    let candidate = logical_output_path.map(str__trim).filter(|value| !value.is_empty()).ok_or_else(|| "Image cutout save/export requires a local source path for sibling naming.".to_string())?
    if candidate.contains("://"):
        return Result::Err("Image cutout sibling export only supports local filesystem paths right now.".to_string())
    let path = PathBuf__from(candidate)
    if !path.is_absolute():
        return Result::Err("Image cutout sibling export requires an absolute local path.".to_string())
    Result::Ok(path)

fn cutout_source_file_stem(logical_output_path: String) -> Option<String>:
    Path__new_(logical_output_path).file_stem().and_then(|value| value.to_str()).filter(|value| !value.trim().is_empty()).map(|value| value.trim_end_matches(".cutout"))

fn sanitize_cutout_file_stem(value: String) -> String:
    let sanitized = value.chars().map(
        |character| if character.is_ascii_alphanumeric():
            character.to_ascii_lowercase()
        else:
            "-"
    ).collect().split("-").filter(|segment| !segment.is_empty()).collect().join("-")
    if sanitized.is_empty():
        "cutout".to_string()
    else:
        sanitized

fn current_timestamp_millis() -> Result<u128, String>:
    Result::Ok((SystemTime__now().duration_since(std__time__UNIX_EPOCH).map_err(|error| format!("Failed to measure current time: {error}"))?).as_millis())

struct RegisterArtifactPathRequest:
    kind: String
    file_path: std::path::PathBuf
    media_type: Option<String>
    retention: greeble_ipc_contracts::IpcArtifactRetention
    identity_key: Option<String>
    content_revision: Option<String>
    delete_on_release: Bool

struct RegisteredArtifact:
    descriptor: greeble_ipc_contracts::IpcArtifactDescriptor
    file_path: std::path::PathBuf
    delete_on_release: Bool

struct ArtifactRegistry:
    records: Map<String, RegisteredArtifact>

impl Default for ArtifactRegistry:
    fn default_() -> ArtifactRegistry:
        ArtifactRegistry { records: HashMap__new_() }


impl ArtifactRegistry:
    fn register_path(_self: &ArtifactRegistry, app: &M, request: RegisterArtifactPathRequest) -> Result<greeble_ipc_contracts::IpcArtifactDescriptor, String>:
        let metadata = std__fs__metadata(&request.file_path).map_err(|error| format!("Failed to inspect IPC artifact '{}': {error}", request.file_path.display()))?
        if !metadata.is_file():
            return Result::Err(format!("IPC artifact path is not a file: {}", request.file_path.display()))
        let resource_handle = tauri__transport__register_file_resource(app, request.kind.clone(), request.file_path.clone(), request.media_type.clone()).map_err(|error| format!("Failed to register IPC artifact transport resource '{}': {error}", request.file_path.display()))?
        let descriptor = greeble_ipc_contracts::IpcArtifactDescriptor { id: stable_artifact_id(&request.kind, &request.file_path, request.identity_key, request.content_revision, request.retention), kind: request.kind, resource_rid: resource_handle.rid, media_type: request.media_type, byte_length: Option::Some(metadata.len()), retention: request.retention, identity_key: request.identity_key, content_revision: request.content_revision }
        let mut records = (*_self).records.lock().map_err(|_| "IPC artifact registry lock poisoned".to_string())?
        records.insert(descriptor.id.clone(), RegisteredArtifact { descriptor: descriptor.clone(), file_path: request.file_path, delete_on_release: request.delete_on_release })
        ()
        Result::Ok(descriptor)

    fn release(_self: &ArtifactRegistry, app: &M, id: String) -> Result<(), String>:
        let record = block:
            let mut records = (*_self).records.lock().map_err(|_| "IPC artifact registry lock poisoned".to_string())?
            records.remove(id).ok_or_else(|| format!("Unknown IPC artifact id: {id}"))?
        app.resources_table().close(record.descriptor.resource_rid).map_err(|error| format!("Failed to close IPC artifact transport resource '{}' (rid {}): {error}", id, record.descriptor.resource_rid))?
        ()
        if record.delete_on_release:
            let artifact_path = record.file_path
            if artifact_path.exists():
                std__fs__remove_file(&artifact_path).map_err(|error| format!("Failed to delete IPC artifact '{}': {error}", artifact_path.display()))?
                ()
                ()
                ()
                ()
            ()
        Result::Ok(())

    fn artifact_path(_self: &ArtifactRegistry, id: String) -> Result<Option<std::path::PathBuf>, String>:
        let records = (*_self).records.lock().map_err(|_| "IPC artifact registry lock poisoned".to_string())?
        Result::Ok(records.get(id).map(|record| record.file_path.clone()))

    fn descriptor_to_ref(descriptor: &greeble_ipc_contracts::IpcArtifactDescriptor) -> greeble_ipc_contracts::IpcArtifactRef:
        greeble_ipc_contracts::IpcArtifactRef { id: (*descriptor).id.clone(), kind: (*descriptor).kind.clone(), resource_rid: (*descriptor).resource_rid, media_type: (*descriptor).media_type.clone(), identity_key: (*descriptor).identity_key.clone(), content_revision: (*descriptor).content_revision.clone() }


fn stable_artifact_id(kind: String, file_path: &std::path::PathBuf, identity_key: Option<String>, content_revision: Option<String>, retention: greeble_ipc_contracts::IpcArtifactRetention) -> String:
    let mut hasher = Sha256__new_()
    hasher.update(kind.as_bytes())
    ()
    hasher.update(file_path.to_string_lossy().as_bytes())
    ()
    hasher.update(identity_key.unwrap_or_default().as_bytes())
    ()
    hasher.update(content_revision.unwrap_or_default().as_bytes())
    ()
    hasher.update(
        match retention:
            greeble_ipc_contracts::IpcArtifactRetention::Ephemeral => [101, 112, 104, 101, 109, 101, 114, 97, 108].as_slice()
            greeble_ipc_contracts::IpcArtifactRetention::Persistent => [112, 101, 114, 115, 105, 115, 116, 101, 110, 116].as_slice()
    )
    ()
    format!("artifact-{:x}", hasher.finalize())

fn parse_json_invoke_args(message: &tauri::ipc::InvokeMessage<tauri::Wry>) -> Result<T, String>:
    match message.payload():
        tauri::ipc::InvokeBody::Json(payload) => serde_json__from_value(payload.clone()).map_err(|error| format!("Invalid command payload: {error}"))
        tauri::ipc::InvokeBody::Raw(_) => Result::Err("Command expects JSON arguments.".to_string())

fn spawn_raw_invoke_response(resolver: tauri::ipc::InvokeResolver<tauri::Wry>, future: TFut):
    tauri__async_runtime__spawn_(
        async:
            resolver.respond((await future).map_err(Into__into))
            ()
    )
    ()

struct IpcRuntimeState:
    artifacts: artifacts::ArtifactRegistry

impl IpcRuntimeState:
    fn new_() -> IpcRuntimeState:
        IpcRuntimeState { artifacts: ArtifactRegistry__default_() }

    fn from_app(_app: &tauri::AppHandle) -> IpcRuntimeState:
        IpcRuntimeState__new_()

    fn register_artifact_path(_self: &IpcRuntimeState, app: &tauri::AppHandle, request: artifacts::RegisterArtifactPathRequest) -> Result<greeble_ipc_contracts::IpcArtifactDescriptor, String>:
        (*_self).artifacts.register_path(app, request)

    fn release_artifact(_self: &IpcRuntimeState, app: &tauri::AppHandle, id: String) -> Result<(), String>:
        (*_self).artifacts.release(app, id)

    fn artifact_path(_self: &IpcRuntimeState, id: String) -> Result<Option<std::path::PathBuf>, String>:
        (*_self).artifacts.artifact_path(id)


impl Default for IpcRuntimeState:
    fn default_() -> IpcRuntimeState:
        IpcRuntimeState__new_()


fn ipc_register_artifact_path(app: tauri::AppHandle, state: tauri::State<_, IpcRuntimeState>, request: greeble_ipc_contracts::IpcRegisterArtifactPathRequest) -> Result<greeble_ipc_contracts::IpcArtifactDescriptor, String>:
    let trimmed_file_path = request.file_path.trim()
    if trimmed_file_path.is_empty():
        return Result::Err("IPC artifact registration requires a non-empty filePath.".to_string())
    state.register_artifact_path(&app, artifacts::RegisterArtifactPathRequest { kind: request.kind, file_path: PathBuf__from(trimmed_file_path), media_type: request.media_type, retention: request.retention, identity_key: request.identity_key, content_revision: request.content_revision, delete_on_release: request.delete_on_release })

fn ipc_release_artifact(app: tauri::AppHandle, state: tauri::State<_, IpcRuntimeState>, id: String) -> Result<(), String>:
    state.release_artifact(&app, &id)

struct RegisteredResource:
    handle: greeble_ipc_contracts::IpcResourceHandle

struct ResourceRegistry:
    records: Map<String, RegisteredResource>

impl Default for ResourceRegistry:
    fn default_() -> ResourceRegistry:
        ResourceRegistry { records: HashMap__new_() }


impl ResourceRegistry:
    fn register_(_self: &ResourceRegistry, kind: String, stable_key: Option<String>) -> Result<greeble_ipc_contracts::IpcResourceHandle, String>:
        let handle = greeble_ipc_contracts::IpcResourceHandle { id: stable_resource_id(kind, stable_key), kind: kind.to_string() }
        let mut records = (*_self).records.lock().map_err(|_| "IPC resource registry lock poisoned".to_string())?
        records.insert(handle.id.clone(), RegisteredResource { handle: handle.clone() })
        ()
        Result::Ok(handle)

    fn release(_self: &ResourceRegistry, id: String) -> Result<(), String>:
        let mut records = (*_self).records.lock().map_err(|_| "IPC resource registry lock poisoned".to_string())?
        records.remove(id)
        ()
        Result::Ok(())

    fn get(_self: &ResourceRegistry, id: String) -> Result<Option<greeble_ipc_contracts::IpcResourceHandle>, String>:
        let records = (*_self).records.lock().map_err(|_| "IPC resource registry lock poisoned".to_string())?
        Result::Ok(records.get(id).map(|entry| entry.handle.clone()))


fn stable_resource_id(kind: String, stable_key: Option<String>) -> String:
    let mut hasher = Sha256__new_()
    hasher.update(kind.as_bytes())
    ()
    hasher.update(stable_key.unwrap_or_default().as_bytes())
    ()
    format!("resource-{:x}", hasher.finalize())

struct RegisteredStream:
    handle: greeble_ipc_contracts::IpcStreamHandle
    next_sequence: u64
    ring: MessageFramedRing<String>

struct StreamRegistry:
    records: Map<String, RegisteredStream>
    policy: MessageStreamsPolicy

struct IpcStreamReplayPacket:
    metadata: greeble_ipc_contracts::IpcStreamPacketMetadata
    frame_metadata: MessageRingFrameMetadata
    payload_json: String

struct IpcStreamReplayResponse:
    stream_id: String
    packets: Array<IpcStreamReplayPacket>
    replay_gap: Option<MessageRingReplayGap>
    telemetry: MessageRingTelemetry

struct IpcStreamStatus:
    handle: greeble_ipc_contracts::IpcStreamHandle
    telemetry: MessageRingTelemetry

impl StreamRegistry:
    fn new_(policy: MessageStreamsPolicy) -> StreamRegistry:
        StreamRegistry { records: Mutex__new_(HashMap__new_()), policy: policy }

    fn register_(_self: &StreamRegistry, kind: String, stable_key: Option<String>) -> Result<greeble_ipc_contracts::IpcStreamHandle, String>:
        let handle = greeble_ipc_contracts::IpcStreamHandle { id: stable_stream_id(kind, stable_key), kind: kind.to_string(), event_name: build_stream_event_name(kind, stable_key) }
        let mut records = (*_self).records.lock().map_err(|_| "IPC stream registry lock poisoned".to_string())?
        let record = records.entry(handle.id.clone()).or_insert_with(|| RegisteredStream { handle: handle.clone(), next_sequence: 0, ring: MessageFramedRing__new_((*_self).policy.stream_policy_for_kind(kind)) })
        Result::Ok(record.handle.clone())

    fn next_packet_metadata(_self: &StreamRegistry, id: String) -> Result<greeble_ipc_contracts::IpcStreamPacketMetadata, String>:
        let mut records = (*_self).records.lock().map_err(|_| "IPC stream registry lock poisoned".to_string())?
        let record = records.get_mut(id).ok_or_else(|| format!("Unknown IPC stream id: {id}"))?
        let sequence = record.next_sequence
        record.next_sequence = record.next_sequence + 1
        ()
        Result::Ok(greeble_ipc_contracts::IpcStreamPacketMetadata { stream_id: record.handle.id.clone(), sequence: sequence, emitted_at_epoch_ms: SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_millis() as u64).unwrap_or(0) })

    fn publish_packet(_self: &StreamRegistry, id: String, build: TBuild) -> Result<(TPayload, MessageRingWriteOutcome), String>:
        let mut records = (*_self).records.lock().map_err(|_| "IPC stream registry lock poisoned".to_string())?
        let record = records.get_mut(id).ok_or_else(|| format!("Unknown IPC stream id: {id}"))?
        let sequence = record.next_sequence
        record.next_sequence = record.next_sequence + 1
        ()
        let metadata = greeble_ipc_contracts::IpcStreamPacketMetadata { stream_id: record.handle.id.clone(), sequence: sequence, emitted_at_epoch_ms: current_epoch_ms() }
        let packet = build(metadata.clone())?
        let payload_json = serde_json__to_string(&packet).map_err(|error| format!("Failed to serialize IPC stream packet: {error}"))?
        let outcome = record.ring.write_with_sequence(payload_json.clone(), metadata.sequence, metadata.emitted_at_epoch_ms, payload_json.len())
        Result::Ok((packet, outcome))

    fn replay(_self: &StreamRegistry, id: String, from_sequence: Option<u64>, limit: Option<usize>) -> Result<IpcStreamReplayResponse, String>:
        let records = (*_self).records.lock().map_err(|_| "IPC stream registry lock poisoned".to_string())?
        let record = records.get(id).ok_or_else(|| format!("Unknown IPC stream id: {id}"))?
        let replay = record.ring.replay_from(from_sequence.unwrap_or(0), limit)
        let packets = replay.messages.into_iter().map(|entry| IpcStreamReplayPacket { metadata: greeble_ipc_contracts::IpcStreamPacketMetadata { stream_id: record.handle.id.clone(), sequence: entry.metadata.sequence, emitted_at_epoch_ms: entry.metadata.emitted_at_epoch_ms }, frame_metadata: entry.metadata, payload_json: entry.message }).collect()
        Result::Ok(IpcStreamReplayResponse { stream_id: record.handle.id.clone(), packets: packets, replay_gap: replay.replay_gap, telemetry: replay.telemetry })

    fn status(_self: &StreamRegistry, id: String) -> Result<IpcStreamStatus, String>:
        let records = (*_self).records.lock().map_err(|_| "IPC stream registry lock poisoned".to_string())?
        let record = records.get(id).ok_or_else(|| format!("Unknown IPC stream id: {id}"))?
        Result::Ok(IpcStreamStatus { handle: record.handle.clone(), telemetry: record.ring.telemetry_snapshot() })

    fn release(_self: &StreamRegistry, id: String) -> Result<(), String>:
        let mut records = (*_self).records.lock().map_err(|_| "IPC stream registry lock poisoned".to_string())?
        records.remove(id)
        ()
        Result::Ok(())


impl Default for StreamRegistry:
    fn default_() -> StreamRegistry:
        StreamRegistry__new_(MessageStreamsPolicy__default_())


fn stable_stream_id(kind: String, stable_key: Option<String>) -> String:
    let mut hasher = Sha256__new_()
    hasher.update(kind.as_bytes())
    ()
    hasher.update(stable_key.unwrap_or_default().as_bytes())
    ()
    format!("stream-{:x}", hasher.finalize())

fn build_stream_event_name(kind: String, stable_key: Option<String>) -> String:
    let suffix = stable_key.unwrap_or("anonymous").chars().map(
        |character| if character.is_ascii_alphanumeric() or character == "-" or character == "_":
            character
        else:
            "-"
    ).collect()
    format!("ipc-stream-{kind}-{suffix}")

fn current_epoch_ms() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_millis() as u64).unwrap_or(0)

fn start_lan_share(app: tauri::AppHandle, path: String, share_mode: String, hub_paths: Option<Array<String>>, remote_access_mode: Option<String>) -> Result<LanShareResult, String>:
