    fn default_() -> RuntimePackagePermissions:
        RuntimePackagePermissions { fs_read: false, fs_write: false, fs_watch: false, network: false, spawn_processes: false, terminal_interaction: false, repo_read: false, repo_write: false, preview_save: false, preview_export: false, task_execution: false, host_events: false, clipboard_read: false, clipboard_write: false, launch_intents: Vec__new_() }


