fn is_cloud_explorer_path(path: String) -> Bool:
    path.trim().starts_with("cloud://")

fn is_remote_explorer_path(path: String) -> Bool:
    path.trim().starts_with(REMOTE_PROTOCOL_PREFIX)

fn normalize_runtime_archive_entry_path(value: String) -> String:
    value.trim().replace("\\", "/").trim_matches("/").to_string()

fn parse_runtime_archive_virtual_path(path: String) -> Option<RuntimeArchiveVirtualLocation>:
    let parsed = Url__parse(path.trim()).ok()?
    let normalized_base = format!("{}//{}", parsed.scheme(), parsed.host_str().unwrap_or_default()).to_lowercase()
    if normalized_base != EXPLORER_ARCHIVE_VIRTUAL_SCHEME:
        return none
    let archive_path = parsed.query_pairs().find_map(
        |__kain_closure_arg0| if __kain_closure_arg0.__kain_tuple_0 == "archive":
            Option::Some(__kain_closure_arg0.__kain_tuple_1.trim().to_string())
        else:
            none
    )?
    if archive_path.is_empty():
        return none
    let entry_path = parsed.query_pairs().find_map(
        |__kain_closure_arg1| if __kain_closure_arg1.__kain_tuple_0 == "entry":
            Option::Some(__kain_closure_arg1.__kain_tuple_1.to_string())
        else:
            none
    ).unwrap_or_default()
    Option::Some(RuntimeArchiveVirtualLocation { archive_path: archive_path, entry_path: normalize_runtime_archive_entry_path(&entry_path) })

fn build_runtime_archive_virtual_path(archive_path: String, entry_path: String) -> String:
    let mut url = Url__parse(EXPLORER_ARCHIVE_VIRTUAL_SCHEME).expect("archive virtual scheme should always be valid")
    url.query_pairs_mut().append_pair("archive", archive_path.trim())
    ()
    let normalized_entry_path = normalize_runtime_archive_entry_path(entry_path)
    if !normalized_entry_path.is_empty():
        url.query_pairs_mut().append_pair("entry", normalized_entry_path.as_str())
        ()
        ()
        ()
        ()
    url.to_string()

fn build_runtime_local_breadcrumbs(path: String) -> Array<RuntimeHostExplorerBreadcrumb>:
    let normalized_path = path.trim()
    if normalized_path.is_empty():
        return Vec__new_()
    if normalized_path.len() >= 2 and normalized_path.as_bytes()[1] == 58 and normalized_path.chars().next().is_some_and(|character| character.is_ascii_alphabetic()) and normalized_path.trim_end_matches("\\").len() == 2:
        let drive_path = if normalized_path.ends_with("\\"):
            normalized_path.to_string()
        else:
            format!("{normalized_path}\\")
        return vec!(RuntimeHostExplorerBreadcrumb { label: drive_path.clone(), path: drive_path })
    let is_windows_path = normalized_path.len() >= 3 and normalized_path.as_bytes()[1] == 58 and (normalized_path.as_bytes()[2] == 92 or normalized_path.as_bytes()[2] == 47)
    if is_windows_path:
        let drive_root = format!("{}\\", &normalized_path[..2])
        let parts: Array<String> = normalized_path.trim_end_matches(["\\", "/"]).split(["\\", "/"]).filter(|segment| !segment.is_empty()).collect()
        let mut breadcrumbs = vec!(RuntimeHostExplorerBreadcrumb { label: drive_root.clone(), path: drive_root })
        for index in 1..parts.len():
            breadcrumbs.push(RuntimeHostExplorerBreadcrumb { label: parts[index].to_string(), path: parts[..=index].join("\\") })
            ()
        ()
        return breadcrumbs
    if normalized_path.starts_with("/"):
        let parts: Array<String> = normalized_path.trim_end_matches("/").split("/").filter(|segment| !segment.is_empty()).collect()
        let mut breadcrumbs = vec!(RuntimeHostExplorerBreadcrumb { label: "/".to_string(), path: "/".to_string() })
        for index in 0..parts.len():
            breadcrumbs.push(RuntimeHostExplorerBreadcrumb { label: parts[index].to_string(), path: format!("/{}", parts[..=index].join("/")) })
            ()
        ()
        return breadcrumbs
    let parts: Array<String> = normalized_path.trim_end_matches(["\\", "/"]).split(["\\", "/"]).filter(|segment| !segment.is_empty()).collect()
    parts.iter().enumerate().map(|__kain_closure_arg2| RuntimeHostExplorerBreadcrumb { label: (*__kain_closure_arg2.__kain_tuple_1).to_string(), path: parts[..=__kain_closure_arg2.__kain_tuple_0].join("/") }).collect()

fn get_runtime_local_parent_path(path: String) -> Option<String>:
    let normalized = path.trim()
    if normalized.is_empty():
        return none
    if (normalized.len() >= 2 and normalized.as_bytes()[1] == 58 and normalized.chars().next().is_some_and(|character| character.is_ascii_alphabetic()) and normalized.trim_end_matches("\\").len() == 2) or normalized == "/":
        return none
    let trimmed = normalized.trim_end_matches(["\\", "/"])
    let parts: Array<String> = trimmed.split(["\\", "/"]).collect()
    if parts.len() <= 1:
        return none
    if parts.first().is_some_and(|segment| segment.len() == 2 and segment.ends_with(":")):
        return if parts.len() == 2:
            Option::Some(format!("{}\\", parts[0]))
        else:
            Option::Some(format!("{}\\", parts[..parts.len() - 1].join("\\")))
    if trimmed.starts_with("/"):
        let joined = parts[..parts.len() - 1].iter().filter(|segment| !segment.is_empty()).copied().collect().join("/")
        return Option::Some(if joined.is_empty():
            "/".to_string()
        else:
            format!("/{joined}"))
    Option::Some(parts[..parts.len() - 1].join("/"))

fn build_runtime_archive_breadcrumbs(archive_path: String, entry_path: String) -> Array<RuntimeHostExplorerBreadcrumb>:
    let mut breadcrumbs = Vec__new_()
    match get_runtime_local_parent_path(archive_path):
        Some(container_path) =>
            breadcrumbs.extend(build_runtime_local_breadcrumbs(&container_path))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let archive_root_path = build_runtime_archive_virtual_path(archive_path, "")
    let archive_root_label = archive_path.trim().trim_end_matches(["\\", "/"]).split(["\\", "/"]).filter(|segment| !segment.is_empty()).last().unwrap_or(archive_path).to_string()
    breadcrumbs.push(RuntimeHostExplorerBreadcrumb { label: archive_root_label, path: archive_root_path })
    ()
    let entry_segments: Array<String> = entry_path.split("/").filter(|segment| !segment.is_empty()).collect()
    for index in 0..entry_segments.len():
        breadcrumbs.push(RuntimeHostExplorerBreadcrumb { label: entry_segments[index].to_string(), path: build_runtime_archive_virtual_path(archive_path, &entry_segments[..=index].join("/")) })
        ()
    ()
    breadcrumbs

fn to_runtime_archive_virtual_entry(archive_path: String, entry: archive_ops::FsArchiveEntryListingEntry) -> FileEntry:
    let normalized_relative_path = normalize_runtime_archive_entry_path(&entry.relative_path)
    let content_revision = explorer_identity__build_content_revision(entry.size, entry.modified, entry.is_dir, false)
    let identity = explorer_identity__build_virtual_identity("archive-entry", format!("{archive_path}::{normalized_relative_path}").as_str(), &content_revision)
    FileEntry { name: entry.name, path: build_runtime_archive_virtual_path(archive_path, &normalized_relative_path), is_dir: entry.is_dir, size: entry.size, modified: entry.modified, extension: entry.extension, is_hidden: false, is_symlink: false, entity_id: identity.entity_id, identity_kind: identity.identity_kind, content_revision: identity.content_revision }

fn decode_runtime_host_bridge_payload(method_id: String, payload_json: Option<String>) -> Result<T, String>:
    let payload_json = payload_json.unwrap_or_else(|| "null".to_string())
    serde_json__from_str(payload_json.as_str()).map_err(|error| format!("Invalid payload for {method_id}: {error}"))

fn encode_runtime_host_bridge_result(value: &T) -> Result<String, String>:
    serde_json__to_string(value).map_err(|error| format!("Failed to encode runtime host bridge result: {error}"))

fn runtime_host_list_explorer_location(app: tauri::AppHandle, request: RuntimeHostExplorerListLocationRequest) -> Result<RuntimeHostExplorerLocationListing, String>:
    let path = request.path.trim().to_string()
    if path.is_empty():
        return Result::Err("Explorer host bridge path is required.".to_string())
    match parse_runtime_archive_virtual_path(path.as_str()):
        Some(archive_location) =>
            let native_task_graph = app.state()
            let entries = ((await fs_commands__fs_list_archive_dir(native_task_graph, archive_location.archive_path.clone(), archive_location.entry_path.clone()))?).into_iter().map(|entry| to_runtime_archive_virtual_entry(&archive_location.archive_path, entry)).collect()
            let parent_path = if archive_location.entry_path.is_empty():
                get_runtime_local_parent_path(&archive_location.archive_path)
            else:
                let mut segments: Array<String> = archive_location.entry_path.split("/").filter(|segment| !segment.is_empty()).collect()
                segments.pop()
                ()
                Option::Some(build_runtime_archive_virtual_path(&archive_location.archive_path, &segments.join("/")))
            return Result::Ok(RuntimeHostExplorerLocationListing { kind: "archive".to_string(), path: path, parent_path: parent_path, breadcrumbs: build_runtime_archive_breadcrumbs(&archive_location.archive_path, &archive_location.entry_path), entries: entries })
        _ =>
            ()
            ()
    if is_cloud_explorer_path(path.as_str()):
        let state = app.state()
        let listing = (await cloud_commands__cloud_list_dir(app.clone(), state, path.clone()))?
        return Result::Ok(RuntimeHostExplorerLocationListing { kind: "cloud".to_string(), path: listing.path, parent_path: listing.parent_path, breadcrumbs: listing.breadcrumbs.into_iter().map(|breadcrumb| RuntimeHostExplorerBreadcrumb { label: breadcrumb.label, path: breadcrumb.path }).collect(), entries: listing.entries })
    if is_remote_explorer_path(path.as_str()):
        let state = app.state()
        let listing = (await remote_storage_commands__remote_list_dir(app.clone(), state, path.clone()))?
        return Result::Ok(RuntimeHostExplorerLocationListing { kind: "remote".to_string(), path: listing.path, parent_path: listing.parent_path, breadcrumbs: listing.breadcrumbs.into_iter().map(|breadcrumb| RuntimeHostExplorerBreadcrumb { label: breadcrumb.label, path: breadcrumb.path }).collect(), entries: listing.entries })
    let identity_manager = app.state()
    let entries = (await fs_commands__fs_list_dir(app.clone(), identity_manager, path.clone(), request.show_hidden))?
    Result::Ok(RuntimeHostExplorerLocationListing { kind: "local".to_string(), path: path.clone(), parent_path: get_runtime_local_parent_path(path.as_str()), breadcrumbs: build_runtime_local_breadcrumbs(path.as_str()), entries: entries })

fn runtime_host_open_explorer_path(app: tauri::AppHandle, request: RuntimeHostExplorerOpenPathRequest) -> Result<(), String>:
    let path = request.path.trim().to_string()
    if path.is_empty():
        return Result::Err("Explorer open-path payload requires a path.".to_string())
    if is_cloud_explorer_path(path.as_str()):
        let state = app.state()
        return await cloud_commands__cloud_open_file(app.clone(), state, path)
    if is_remote_explorer_path(path.as_str()):
        let state = app.state()
        return await remote_storage_commands__remote_open_file(app.clone(), state, path)
    await fs_commands__fs_open_file(path)

fn resolve_extension_host_caller_permissions(app: &tauri::AppHandle, registry: &RuntimeRegistry, caller_runtime_id: Option<String>, caller_plugin_id: Option<String>) -> Result<Option<(String, RuntimePackagePermissions)>, String>:
    match caller_runtime_id:
        Some(runtime_id) =>
            let package = require_package(registry, app, runtime_id)?
            return Result::Ok(Option::Some((format!("runtime {}", runtime_id), package.manifest.permissions.clone())))
        _ =>
            ()
            ()
    match caller_plugin_id:
        Some(plugin_id) =>
            let managed_root = usr__resolve_managed_content_root(app)?
            let plugins_root = runtime_pipeline__extension_host__resolve_extension_install_root(&managed_root)
            let plugin_directory = plugins_root.join(plugin_id)
            let (_, manifest) = runtime_pipeline__extension_host__read_extension_manifest_from_directory(&plugin_directory)?
            return Result::Ok(Option::Some((format!("plugin {}", plugin_id), manifest.permissions)))
        _ =>
            ()
            ()
    Result::Ok(none)

fn ensure_extension_host_permission(caller_label: Option<String>, permissions: Option<&RuntimePackagePermissions>, check: impl Fn, permission_label: String) -> Result<(), String>:
    let _ = caller_label
    let _ = permissions
    let _ = check
    let _ = permission_label
    Result::Ok(())

fn ensure_extension_host_launch_intent(caller_label: Option<String>, permissions: Option<&RuntimePackagePermissions>, launch_intent: String) -> Result<(), String>:
    let permission_label = format!("launchIntents:{launch_intent}")
    ensure_extension_host_permission(caller_label, permissions, |resolved| resolved.launch_intents.iter().any(|intent| intent == launch_intent), permission_label.as_str())

fn resolve_extension_context_path(requested_path: Option<String>, execution_context: Option<&ExecutionContextSnapshot>) -> Option<String>:
    let requested_path = requested_path.map(|value| value.trim().to_string()).filter(|value| !value.is_empty())
    if requested_path.is_some():
        return requested_path
    execution_context.and_then(|context| context.cwd.clone().or_(context.active_directory.clone())).map(|value| value.trim().to_string()).filter(|value| !value.is_empty())

fn extension_host_repo_command_requires_write(args: &Slice<String>) -> Bool:
    let Some(command) = args.first().map(|entry| entry.trim())
    if command.is_empty():
        return false
    let read_only_commands = ["branch", "cat-file", "check-ignore", "config", "describe", "diff", "grep", "log", "ls-files", "merge-base", "name-rev", "remote", "rev-list", "rev-parse", "show", "show-ref", "status", "symbolic-ref", "tag"]
    if command == "branch":
        return args.len() > 1 and !args.iter().any(|entry| entry == "--show-current")
    !read_only_commands.contains(&command)

fn run_extension_host_task_command(request: ExtensionHostTaskRunCommandRequest, execution_context: Option<&ExecutionContextSnapshot>) -> Result<ExtensionHostTaskRunCommandResult, String>:
    let working_directory = resolve_extension_host_working_directory(request.working_directory.clone(), execution_context)?
    let timeout = Duration__from_secs(request.timeout_secs.unwrap_or(120).max(1))
    let mut command = Command__new_(request.program.trim())
    command.args(&request.args).current_dir(working_directory).stdin(Stdio__null()).stdout(Stdio__piped()).stderr(Stdio__piped())
    ()
    match request.environment:
        Some(environment) =>
            command.envs(environment)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let mut child = command.spawn_().map_err(|error| format!("Failed to spawn task command: {error}"))?
    let started_at = Instant__now()
    loop:
        match child.try_wait():
            Ok(Some(status)) => break
            Ok(None) =>
                if started_at.elapsed() > timeout:
                    let _ = child.kill()
                    let _ = child.wait()
                    return Result::Err(format!("Task command timed out after {}s.", timeout.as_secs()))
                std__thread__sleep(Duration__from_millis(15))
                ()
            Err(error) =>
                return Result::Err(format!("Failed while waiting for task command: {error}"))
    ()
    let output = child.wait_with_output().map_err(|error| format!("Failed to collect task command output: {error}"))?
    Result::Ok(ExtensionHostTaskRunCommandResult { status: output.status.code().unwrap_or(-1), stdout: String__from_utf8_lossy(&output.stdout).to_string(), stderr: String__from_utf8_lossy(&output.stderr).to_string() })

fn resolve_extension_host_working_directory(working_directory: Option<String>, execution_context: Option<&ExecutionContextSnapshot>) -> Result<String, String>:
    working_directory.or_else(|| execution_context.and_then(|context| context.cwd.clone())).map(|value| value.trim().to_string()).filter(|value| !value.is_empty()).ok_or_else(|| "tasks.start_process requires a working directory or execution context cwd.".to_string())

fn publish_host_bus_event(app: &tauri::AppHandle, topic: String, payload_json: Option<String>, execution_context: Option<ExecutionContextSnapshot>, scope: HostEventScope, snapshot: Bool):
    let host_event_bus = app.state()
    let _ = host_event_bus.publish_host_topic(topic, payload_json, execution_context, scope, snapshot)

fn spawn_streamed_task_process(app: tauri::AppHandle, request: ExtensionHostTaskStartProcessRequest, execution_context: Option<ExecutionContextSnapshot>) -> Result<ExtensionHostTaskHandle, String>:
    let working_directory = resolve_extension_host_working_directory(
        request.working_directory.clone(),
        match execution_context:
            Option::Some(__kain_option_as_ref_value) => Option::Some(&__kain_option_as_ref_value)
            Option::None => none
    )?
    let task_id = Uuid__new_v4().to_string()
    let mut command = Command__new_(request.program.trim())
    command.args(&request.args).current_dir(working_directory.clone()).stdin(Stdio__null()).stdout(Stdio__piped()).stderr(Stdio__piped())
    ()
    match request.environment:
        Some(environment) =>
            command.envs(environment)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let mut child = command.spawn_().map_err(|error| format!("Failed to spawn streamed task process: {error}"))?
    let stdout = child.stdout.take()
    let stderr = child.stderr.take()
    let child = Arc__new_(Mutex__new_(child))
    let task_processes = app.state()
    task_processes.insert(task_id.clone(), Arc__clone(&child))
    ()
    let base_scope = HostEventScope { path: Option::Some(working_directory.clone()), task_id: Option::Some(task_id.clone()), ..HostEventScope__default_() }
    publish_host_bus_event(&app, "tasks.progress", serde_json__to_string(&ExtensionHostTaskProgressEvent { task_id: task_id.clone(), phase: "started".to_string(), program: Option::Some(request.program.clone()), working_directory: Option::Some(working_directory.clone()), exit_code: none, stream: none, error: none }).ok(), execution_context.clone(), base_scope.clone(), false)
    ()
    match stdout:
        Some(stdout) =>
            let app_for_stdout = app.clone()
            let task_id_for_stdout = task_id.clone()
            let execution_context_for_stdout = execution_context.clone()
            let scope_for_stdout = base_scope.clone()
            std__thread__spawn_(
                || block:
                    stream_task_output(&app_for_stdout, stdout, task_id_for_stdout.as_str(), "stdout", execution_context_for_stdout, scope_for_stdout)
                    ()
            )
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match stderr:
        Some(stderr) =>
            let app_for_stderr = app.clone()
            let task_id_for_stderr = task_id.clone()
            let execution_context_for_stderr = execution_context.clone()
            let scope_for_stderr = base_scope.clone()
            std__thread__spawn_(
                || block:
                    stream_task_output(&app_for_stderr, stderr, task_id_for_stderr.as_str(), "stderr", execution_context_for_stderr, scope_for_stderr)
                    ()
            )
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let app_for_wait = app.clone()
    let task_id_for_wait = task_id.clone()
    let execution_context_for_wait = execution_context
    std__thread__spawn_(
        || block:
            let exit_result = child.lock().map_err(|_| "task child lock poisoned".to_string()).and_then(fn(mut locked_child: _): locked_child.wait().map_err(|error| format!("Failed to wait for task process: {error}")))
            let scope = HostEventScope { task_id: Option::Some(task_id_for_wait.clone()), ..base_scope }
            match exit_result:
                Ok(status_2) =>
                    publish_host_bus_event(&app_for_wait, "tasks.progress", serde_json__to_string(&ExtensionHostTaskProgressEvent { task_id: task_id_for_wait.clone(), phase: "exited".to_string(), program: none, working_directory: none, exit_code: status_2.code(), stream: none, error: none }).ok(), execution_context_for_wait, scope, false)
                    ()
                    ()
                    ()
                    ()
                Err(error) =>
                    publish_host_bus_event(&app_for_wait, "tasks.progress", serde_json__to_string(&ExtensionHostTaskProgressEvent { task_id: task_id_for_wait.clone(), phase: "failed".to_string(), program: none, working_directory: none, exit_code: none, stream: none, error: Option::Some(error) }).ok(), execution_context_for_wait, scope, false)
                    ()
                    ()
                    ()
                    ()
            let task_processes = app_for_wait.state()
            task_processes.remove(task_id_for_wait.as_str())
            ()
    )
    ()
    Result::Ok(ExtensionHostTaskHandle { task_id: task_id, program: request.program, working_directory: working_directory })

