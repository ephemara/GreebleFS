fn build_stream_router(state: ShareState) -> axum::Router:
    Router__new_().route("/", axum__routing__get(stream_handler)).with_state(state)

fn stream_handler(_: axum::extract::State<ShareState>, headers: axum::http::HeaderMap) -> axum::response::Response:
    let path = &state.share_path
    if !path.exists() or !path.is_file():
        return (axum::http::StatusCode::NOT_FOUND, "File not found").into_response()
    await streaming__stream_file_response(path, &headers)

fn build_stream_dir_router(state: ShareState) -> axum::Router:
    Router__new_().route("/", axum__routing__get(stream_dir_page_handler)).route("/app-icon.png", axum__routing__get(ftp_app_icon_handler)).route("/api/list", axum__routing__get(ftp_list_handler)).route("/files/{*path}", axum__routing__get(ftp_file_handler)).with_state(state)

fn stream_dir_page_handler() -> axum::response::Html<String>:
    axum__response__Html(types__STREAM_HTML)

fn build_ftp_router(state: ShareState) -> axum::Router:
    Router__new_().route("/", axum__routing__get(ftp_page_handler)).route("/app-icon.png", axum__routing__get(ftp_app_icon_handler)).route("/api/list", axum__routing__get(ftp_list_handler)).route("/api/upload", axum__routing__post(ftp_upload_handler)).route("/files/{*path}", axum__routing__get(ftp_file_handler)).layer(DefaultBodyLimit__max(types__FTP_MAX_UPLOAD_BYTES)).with_state(state)

fn ftp_page_handler() -> axum::response::Html<String>:
    axum__response__Html(types__FTP_HTML)

fn ftp_app_icon_handler() -> axum::response::Response:
    Response__builder().status(axum::http::StatusCode::OK).header(axum__http__header__CONTENT_TYPE, "image/png").header(axum__http__header__CACHE_CONTROL, "public, max-age=86400").body(Body__from(types__APP_ICON_PNG)).unwrap_or_else(|_| (axum::http::StatusCode::INTERNAL_SERVER_ERROR, "Failed to build response").into_response())

fn hub_list_handler(state: &ShareState, query: &ListQuery) -> axum::response::Response:
    if (*query).path.map(|segment| !segment.is_empty()).unwrap_or(false):
        return (axum::http::StatusCode::BAD_REQUEST, "Invalid path").into_response()
    let hub = (*state).file_hub.unwrap()
    let mut entries: Array<DirEntryInfo> = Vec__new_()
    for (idx, path) in hub.iter().enumerate():
        let metadata = match std__fs__metadata(path):
            Ok(meta) => meta
            Err(_) => continue
        let name = path.file_name().unwrap_or_default().to_string_lossy().to_string()
        entries.push(DirEntryInfo { name: name, is_dir: false, size: metadata.len(), file_id: Option::Some(idx.to_string()) })
        ()
    ()
    entries.sort_by(|left, right| left.name.to_lowercase().cmp(&right.name.to_lowercase()))
    ()
    let share_name = streaming__share_root_label(&(*state).share_path)
    let response_body = serde_json::json!()
    (axum::http::StatusCode::OK, axum__Json(response_body)).into_response()

fn ftp_list_handler(_: axum::extract::State<ShareState>, _: axum::extract::Query<ListQuery>) -> axum::response::Response:
    if state.file_hub.is_some():
        return hub_list_handler(&state, &query)
    let target = match streaming__resolve_sub_path(&state.share_path, query.path):
        Ok(path) => path
        Err(status) => return (status, "Invalid path").into_response()
    if !target.is_dir():
        return (axum::http::StatusCode::BAD_REQUEST, "Not a directory").into_response()
    let read_dir = match std__fs__read_dir(&target):
        Ok(rd) => rd
        Err(_) =>
            return (axum::http::StatusCode::INTERNAL_SERVER_ERROR, "Failed to read directory").into_response()
    let canonical_base = state.share_path.canonicalize().unwrap_or_default()
    let canonical_target = target.canonicalize().unwrap_or_default()
    let relative_path = canonical_target.strip_prefix(&canonical_base).unwrap_or(Path__new_("")).to_string_lossy().replace("\\", "/")
    let mut entries: Array<DirEntryInfo> = Vec__new_()
    for entry in read_dir.flatten():
        let metadata = match entry.metadata():
            Ok(meta) => meta
            Err(_) => continue
        entries.push(DirEntryInfo { name: entry.file_name().to_string_lossy().to_string(), is_dir: metadata.is_dir(), size: metadata.len(), file_id: none })
        ()
    ()
    entries.sort_by(|left, right| right.is_dir.cmp(&left.is_dir).then_with(|| left.name.to_lowercase().cmp(&right.name.to_lowercase())))
    ()
    let share_name = streaming__share_root_label(&state.share_path)
    let response_body = serde_json::json!()
    (axum::http::StatusCode::OK, axum__Json(response_body)).into_response()

fn hub_file_handler(hub: &Slice<std::path::PathBuf>, file_path: String, request_headers: &axum::http::HeaderMap) -> axum::response::Response:
    let target = match file_path.parse():
        Ok(idx) => hub.get(idx)
        Err(_) => none
    let Some(target) = target
    if !target.is_file():
        return (axum::http::StatusCode::NOT_FOUND, "File not found").into_response()
    await streaming__stream_file_response(target, request_headers)

fn ftp_file_handler(_: axum::extract::State<ShareState>, headers: axum::http::HeaderMap, _: axum::extract::Path<String>) -> axum::response::Response:
    match &state.file_hub:
        Some(hub) =>
            return await hub_file_handler(hub, &file_path, &headers)
        _ =>
            ()
            ()
    let target = match streaming__resolve_sub_path(&state.share_path, Option::Some(&file_path)):
        Ok(path) => path
        Err(status) => return (status, "Invalid path").into_response()
    if !target.is_file():
        return (axum::http::StatusCode::NOT_FOUND, "File not found").into_response()
    await streaming__stream_file_response(&target, &headers)

fn ftp_upload_handler(_: axum::extract::State<ShareState>, _: axum::extract::Query<UploadQuery>, multipart: axum::extract::Multipart) -> axum::response::Response:
    await handle_multipart_upload(&state, query.path, multipart)

fn handle_multipart_upload(state: &ShareState, upload_path: Option<String>, multipart: axum::extract::Multipart) -> axum::response::Response:
    if (*state).file_hub.is_some():
        return (axum::http::StatusCode::FORBIDDEN, "Upload not allowed").into_response()
    let target_dir = match streaming__resolve_sub_path(&(*state).share_path, upload_path):
        Ok(path) => path
        Err(status) => return (status, "Invalid upload path").into_response()
    if !target_dir.is_dir():
        return (axum::http::StatusCode::BAD_REQUEST, "Target is not a directory").into_response()
    let mut uploaded_count: u32 = 0
    loop:
        match await multipart.next_field():
            Ok(Some(field)) =>
                let raw_name = match field.file_name():
                    Some(name) => name.to_string()
                    None => continue
                let safe_name = match streaming__sanitize_upload_filename(&raw_name):
                    Some(name) => name
                    None => continue
                let dest_path = get_unique_path(&target_dir.join(&safe_name))
                let bytes = match await field.bytes():
                    Ok(bytes) => bytes
                    Err(_) => continue
                if (await tokio__fs__write(&dest_path, &bytes)).is_ok():
                    uploaded_count = uploaded_count + 1
                    ()
            _ => break
    ()
    let response_body = serde_json::json!()
    (axum::http::StatusCode::OK, axum__Json(response_body)).into_response()

fn get_unique_path(path: &std::path::Path) -> std::path::PathBuf:
    let parent = path.parent().unwrap_or(Path__new_(""))
    let stem = path.file_stem().and_then(|value| value.to_str()).unwrap_or("file")
    let extension = path.extension().map(|value| format!(".{}", value.to_string_lossy())).unwrap_or_default()
    if !path.exists():
        return path.to_path_buf()
    let mut index = 1
    loop:
        let candidate = parent.join(format!("{} ({}){}", stem, index, extension))
        if !candidate.exists():
            return candidate
        index = index + 1
        ()

fn register_mdns(port: u16, ip: std::net::Ipv4Addr) -> Result<mdns_sd::ServiceDaemon, String>:
    let daemon = ServiceDaemon__new_().map_err(|err| format!("Failed to create mDNS daemon: {err}"))?
    let ip_str = ip.to_string()
    let service = ServiceInfo__new_(types__MDNS_SERVICE_TYPE, types__MDNS_INSTANCE_NAME, types__MDNS_HOSTNAME, ip_str.as_str(), port, none).map_err(|err| format!("Failed to create mDNS service info: {err}"))?
    daemon.register_(service).map_err(|err| format!("Failed to register mDNS service: {err}"))?
    ()
    Result::Ok(daemon)

fn unregister_mdns(daemon: &mdns_sd::ServiceDaemon):
    let full_name = format!("{MDNS_INSTANCE_NAME}.{MDNS_SERVICE_TYPE}")
    let _ = daemon.unregister(&full_name)
    let _ = daemon.shutdown()

