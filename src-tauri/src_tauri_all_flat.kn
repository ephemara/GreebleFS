fn current_timestamp_ms() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_millis() as u64).unwrap_or(0)

fn profile_setting_slice_keys() -> Array<String>:
    PROFILE_SETTING_SLICE_KEYS.iter().map(|slice| (*slice).to_string()).collect()

fn profiles_root(shared_usr_root: &std::path::Path) -> std::path::PathBuf:
    shared_usr_root.join(PROFILES_DIRECTORY_NAME)

fn shared_profiles_directory(shared_usr_root: &std::path::Path) -> std::path::PathBuf:
    profiles_root(shared_usr_root).join(SHARED_DIRECTORY_NAME)

fn profile_catalog_path(shared_usr_root: &std::path::Path) -> std::path::PathBuf:
    profiles_root(shared_usr_root).join(PROFILE_CATALOG_FILE_NAME)

fn shared_settings_path(shared_usr_root: &std::path::Path) -> std::path::PathBuf:
    shared_profiles_directory(shared_usr_root).join(PROFILE_SETTINGS_FILE_NAME)

fn legacy_settings_backup_path(shared_usr_root: &std::path::Path) -> std::path::PathBuf:
    profiles_root(shared_usr_root).join(LEGACY_SETTINGS_BACKUP_FILE_NAME)

fn profile_directory(shared_usr_root: &std::path::Path, profile_id: String) -> std::path::PathBuf:
    profiles_root(shared_usr_root).join(profile_id)

fn profile_metadata_path(shared_usr_root: &std::path::Path, profile_id: String) -> std::path::PathBuf:
    profile_directory(shared_usr_root, profile_id).join(PROFILE_METADATA_FILE_NAME)

fn profile_settings_path(shared_usr_root: &std::path::Path, profile_id: String) -> std::path::PathBuf:
    profile_directory(shared_usr_root, profile_id).join(PROFILE_SETTINGS_FILE_NAME)

fn default_profile_overlay_directory(shared_usr_root: &std::path::Path, relative_directory: String) -> std::path::PathBuf:
    shared_usr_root.join(usr__build_usr_profile_relative_directory(DEFAULT_PROFILE_ID, relative_directory))

fn legacy_profile_overlay_root_directory(shared_usr_root: &std::path::Path, relative_directory: String) -> std::path::PathBuf:
    shared_usr_root.join(relative_directory)

fn normalize_profile_id_fragment(value: String) -> String:
    let mut normalized = |__kain_ctor_arg0| String::new()(value.len())
    let mut last_was_dash = false
    for character in value.trim().chars():
        if character.is_ascii_alphanumeric():
            normalized.push(character.to_ascii_lowercase())
            ()
            last_was_dash = false
            ()
        else if !last_was_dash:
            normalized.push("-")
            ()
            last_was_dash = true
            ()
    ()
    normalized.trim_matches("-").to_string()

fn sanitize_profile_name(name: String) -> String:
    let trimmed = name.trim()
    if trimmed.is_empty():
        DEFAULT_PROFILE_NAME.to_string()
    else:
        trimmed.to_string()

fn ensure_parent_directory(path: &std::path::Path) -> Result<(), String>:
    match path.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create {}: {error}", parent.display()))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn copy_missing_entries(source: &std::path::Path, target: &std::path::Path) -> Result<(), String>:
    let metadata = std__fs__metadata(source).map_err(|error| format!("Failed to inspect {}: {error}", source.display()))?
    if metadata.is_dir():
        std__fs__create_dir_all(target).map_err(|error| format!("Failed to create {}: {error}", target.display()))?
        ()
        for child in std__fs__read_dir(source).map_err(|error| format!("Failed to read {}: {error}", source.display()))?:
            let child = child.map_err(|error| format!("Failed to read directory entry: {error}"))?
            let child_source = child.path()
            let child_target = target.join(child.file_name())
            copy_missing_entries(&child_source, &child_target)?
            ()
        ()
        return Result::Ok(())
    if target.exists():
        return Result::Ok(())
    ensure_parent_directory(target)?
    ()
    std__fs__copy(source, target).map_err(|error| format!("Failed to copy profile content {} -> {}: {error}", source.display(), target.display()))?
    ()
    Result::Ok(())

fn write_json_file(path: &std::path::Path, value: &T) -> Result<(), String>:
    ensure_parent_directory(path)?
    ()
    let json = serde_json__to_string_pretty(value).map_err(|error| format!("Failed to serialize {}: {error}", path.display()))?
    std__fs__write(path, json).map_err(|error| format!("Failed to write {}: {error}", path.display()))

fn read_json_file(path: &std::path::Path) -> Result<T, String>:
    let text = std__fs__read_to_string(path).map_err(|error| format!("Failed to read {}: {error}", path.display()))?
    serde_json__from_str(&text).map_err(|error| format!("Failed to parse {}: {error}", path.display()))

fn read_json_object_file(path: &std::path::Path) -> Result<JsonObject, String>:
    if !path.exists():
        return Result::Ok(JsonObject__new_())
    let value: serde_json::Value = read_json_file(path)?
    match value:
        serde_json::Value::Object(object) => Result::Ok(object)
        other => Result::Err(format!("Expected {} to contain a JSON object, found {}", path.display(), other))

fn parse_settings_json_object(json: String, label: String) -> Result<JsonObject, String>:
    let value: serde_json::Value = serde_json__from_str(json).map_err(|error| format!("Failed to parse {label} as JSON: {error}"))?
    match value:
        serde_json::Value::Object(object) => Result::Ok(object)
        other => Result::Err(format!("Expected {label} to be a JSON object, found {other}"))

fn parse_settings_from_legacy_storage_json(legacy_storage_json: String) -> Result<JsonObject, String>:
    let storage_value: serde_json::Value = serde_json__from_str(legacy_storage_json).map_err(|error| format!("Failed to parse legacy ultacode-settings JSON: {error}"))?
    let storage_object = storage_value.as_object().ok_or_else(|| "Expected legacy ultacode-settings to be a JSON object with state.settings".to_string())?
    let state_object = storage_object.get("state").and_then(Value__as_object).ok_or_else(|| "Expected legacy ultacode-settings JSON to include a state object".to_string())?
    let settings_object = state_object.get("settings").and_then(Value__as_object).ok_or_else(|| "Expected legacy ultacode-settings JSON to include state.settings".to_string())?
    Result::Ok(settings_object.clone())

fn resolve_seed_settings_object(current_settings_json: Option<String>, legacy_settings_storage_json: Option<String>) -> Result<JsonObject, String>:
    match current_settings_json:
        Some(current_settings_json) =>
            return parse_settings_json_object(current_settings_json, "current settings snapshot")
        _ =>
            ()
            ()
    match legacy_settings_storage_json:
        Some(legacy_settings_storage_json) =>
            return parse_settings_from_legacy_storage_json(legacy_settings_storage_json)
        _ =>
            ()
            ()
    Result::Ok(JsonObject__new_())

fn partition_settings_object(settings: &JsonObject) -> (JsonObject, JsonObject):
    let mut shared_settings = JsonObject__new_()
    let mut profile_settings = JsonObject__new_()
    for key in SHARED_SETTING_SLICE_KEYS:
        match settings.get(*key):
            Some(value) =>
                shared_settings.insert((*key).to_string(), value.clone())
                ()
            _ => ()
    ()
    for key in PROFILE_SETTING_SLICE_KEYS:
        match settings.get(*key):
            Some(value) =>
                profile_settings.insert((*key).to_string(), value.clone())
                ()
            _ => ()
    ()
    (shared_settings, profile_settings)

fn merge_settings_objects(shared_settings: &JsonObject, profile_settings: &JsonObject) -> JsonObject:
    let mut merged_settings = shared_settings.clone()
    for (key, value) in profile_settings:
        merged_settings.insert(key.clone(), value.clone())
        ()
    ()
    merged_settings

fn serialize_json_object(object: &JsonObject, label: String) -> Result<String, String>:
    serde_json__to_string(object).map_err(|error| format!("Failed to serialize {label}: {error}"))

fn create_profile_manifest_file(profile_id: String, name: String, timestamp_ms: u64) -> UsrProfileManifestFile:
    UsrProfileManifestFile { id: profile_id.to_string(), name: sanitize_profile_name(name), override_slices: profile_setting_slice_keys(), created_at_ms: timestamp_ms, updated_at_ms: timestamp_ms }

fn read_profile_manifest_file(shared_usr_root: &std::path::Path, profile_id: String) -> Result<UsrProfileManifestFile, String>:
    read_json_file(&profile_metadata_path(shared_usr_root, profile_id))

fn write_profile_manifest_file(shared_usr_root: &std::path::Path, manifest: &UsrProfileManifestFile) -> Result<(), String>:
    write_json_file(&profile_metadata_path(shared_usr_root, &(*manifest).id), manifest)

fn load_profile_catalog(shared_usr_root: &std::path::Path) -> Result<UsrProfileCatalogFile, String>:
    read_json_file(&profile_catalog_path(shared_usr_root))

fn write_profile_catalog(shared_usr_root: &std::path::Path, catalog: &UsrProfileCatalogFile) -> Result<(), String>:
    write_json_file(&profile_catalog_path(shared_usr_root), catalog)

fn profile_exists(shared_usr_root: &std::path::Path, profile_id: String) -> Bool:
    profile_directory(shared_usr_root, profile_id).exists()

fn unique_profile_id(shared_usr_root: &std::path::Path, requested_profile_id: Option<String>, profile_name: String, reserved_profile_ids: &Slice<String>) -> String:
    let requested_candidate = requested_profile_id.map(normalize_profile_id_fragment).filter(|value| !value.is_empty())
    let base_profile_id = requested_candidate.unwrap_or_else(|| normalize_profile_id_fragment(profile_name))
    let base_profile_id = if base_profile_id.is_empty():
        "profile".to_string()
    else:
        base_profile_id
    let mut suffix = 1
    let mut candidate = base_profile_id.clone()
    while reserved_profile_ids.iter().any(|entry| entry == &candidate) or profile_exists(shared_usr_root, &candidate):
        suffix = suffix + 1
        ()
        candidate = format!("{base_profile_id}-{suffix}")
        ()
    ()
    candidate

fn move_or_merge_legacy_profile_overlay_directory(shared_usr_root: &std::path::Path, relative_directory: String) -> Result<(), String>:
    let legacy_directory = legacy_profile_overlay_root_directory(shared_usr_root, relative_directory)
    if !legacy_directory.exists():
        return Result::Ok(())
    let canonical_directory = default_profile_overlay_directory(shared_usr_root, relative_directory)
    if !canonical_directory.exists():
        ensure_parent_directory(&canonical_directory)?
        ()
        match std__fs__rename(&legacy_directory, &canonical_directory):
            Ok(()) => return Result::Ok(())
            Err(_) =>
                ()
        ()
    copy_missing_entries(&legacy_directory, &canonical_directory)?
    ()
    std__fs__remove_dir_all(&legacy_directory).map_err(|error| format!("Failed to remove legacy usr profile-overlay directory {} after migration: {error}", legacy_directory.display()))?
    ()
    Result::Ok(())

fn migrate_legacy_profile_overlay_lanes(shared_usr_root: &std::path::Path) -> Result<(), String>:
    let manifest = usr__load_usr_manifest()?
    for entry in manifest.entries:
        if entry.profile_mode != UsrProfileLaneMode::ProfileOverlay:
            continue
        move_or_merge_legacy_profile_overlay_directory(shared_usr_root, &entry.relative_directory)?
        ()
    ()
    Result::Ok(())

fn copy_profile_overlay_lane_directories(shared_usr_root: &std::path::Path, source_profile_id: String, target_profile_id: String) -> Result<(), String>:
    let manifest = usr__load_usr_manifest()?
    for entry in manifest.entries:
        if entry.profile_mode != UsrProfileLaneMode::ProfileOverlay:
            continue
        let source_directory = profile_directory(shared_usr_root, source_profile_id).join(&entry.relative_directory)
        if !source_directory.exists():
            continue
        let target_directory = profile_directory(shared_usr_root, target_profile_id).join(&entry.relative_directory)
        copy_missing_entries(&source_directory, &target_directory)?
        ()
    ()
    Result::Ok(())

fn ensure_catalog_profile_exists(catalog: &UsrProfileCatalogFile, profile_id: String) -> Result<(), String>:
    if (*catalog).profile_order.iter().any(|entry| entry == profile_id):
        Result::Ok(())
    else:
        Result::Err(format!("Usr profile '{profile_id}' does not exist"))

fn seed_default_profile(shared_usr_root: &std::path::Path, current_settings_json: Option<String>, legacy_settings_storage_json: Option<String>) -> Result<UsrProfileCatalogFile, String>:
    std__fs__create_dir_all(shared_profiles_directory(shared_usr_root)).map_err(|error| format!("Failed to create {}: {error}", shared_profiles_directory(shared_usr_root).display()))?
    ()
    match legacy_settings_storage_json:
        Some(legacy_settings_storage_json) =>
            let backup_path = legacy_settings_backup_path(shared_usr_root)
            if !backup_path.exists():
                ensure_parent_directory(&backup_path)?
                ()
                std__fs__write(&backup_path, legacy_settings_storage_json).map_err(|error| format!("Failed to write {}: {error}", backup_path.display()))?
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    let seed_settings_object = resolve_seed_settings_object(current_settings_json, legacy_settings_storage_json)?
    let (shared_settings, default_profile_settings) = partition_settings_object(&seed_settings_object)
    let timestamp_ms = current_timestamp_ms()
    let default_profile_manifest = create_profile_manifest_file(DEFAULT_PROFILE_ID, DEFAULT_PROFILE_NAME, timestamp_ms)
    write_json_file(&shared_settings_path(shared_usr_root), &shared_settings)?
    ()
    write_profile_manifest_file(shared_usr_root, &default_profile_manifest)?
    ()
    write_json_file(&profile_settings_path(shared_usr_root, DEFAULT_PROFILE_ID), &default_profile_settings)?
    ()
    let catalog = UsrProfileCatalogFile { version: PROFILE_CATALOG_VERSION, active_profile_id: DEFAULT_PROFILE_ID.to_string(), profile_order: vec!(DEFAULT_PROFILE_ID.to_string()) }
    write_profile_catalog(shared_usr_root, &catalog)?
    ()
    Result::Ok(catalog)

fn load_or_initialize_catalog(shared_usr_root: &std::path::Path, current_settings_json: Option<String>, legacy_settings_storage_json: Option<String>) -> Result<UsrProfileCatalogFile, String>:
    std__fs__create_dir_all(profiles_root(shared_usr_root)).map_err(|error| format!("Failed to create {}: {error}", profiles_root(shared_usr_root).display()))?
    ()
    std__fs__create_dir_all(shared_profiles_directory(shared_usr_root)).map_err(|error| format!("Failed to create {}: {error}", shared_profiles_directory(shared_usr_root).display()))?
    ()
    let catalog_path = profile_catalog_path(shared_usr_root)
    if !catalog_path.exists():
        let catalog = seed_default_profile(shared_usr_root, current_settings_json, legacy_settings_storage_json)?
        migrate_legacy_profile_overlay_lanes(shared_usr_root)?
        ()
        return Result::Ok(catalog)
    let mut catalog = load_profile_catalog(shared_usr_root)?
    if catalog.profile_order.is_empty():
        catalog = seed_default_profile(shared_usr_root, current_settings_json, legacy_settings_storage_json)?
        ()
        ()
        ()
        ()
    migrate_legacy_profile_overlay_lanes(shared_usr_root)?
    ()
    if !catalog.profile_order.iter().any(|profile_id| profile_id == &catalog.active_profile_id):
        match catalog.profile_order.first():
            Some(first_profile_id) =>
                catalog.active_profile_id = first_profile_id.clone()
                ()
                write_profile_catalog(shared_usr_root, &catalog)?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    Result::Ok(catalog)

fn persist_partitioned_settings(shared_usr_root: &std::path::Path, active_profile_id: String, settings: &JsonObject) -> Result<(), String>:
    let (shared_settings, profile_settings) = partition_settings_object(settings)
    write_json_file(&shared_settings_path(shared_usr_root), &shared_settings)?
    ()
    write_json_file(&profile_settings_path(shared_usr_root, active_profile_id), &profile_settings)?
    ()
    Result::Ok(())

fn read_active_settings(shared_usr_root: &std::path::Path, active_profile_id: String) -> Result<(JsonObject, JsonObject, JsonObject), String>:
    let shared_settings = read_json_object_file(&shared_settings_path(shared_usr_root))?
    let active_profile_settings = read_json_object_file(&profile_settings_path(shared_usr_root, active_profile_id))?
    let effective_settings = merge_settings_objects(&shared_settings, &active_profile_settings)
    Result::Ok((shared_settings, active_profile_settings, effective_settings))

fn to_profile_summary(shared_usr_root: &std::path::Path, manifest: UsrProfileManifestFile, is_active: Bool) -> UsrProfileSummary:
    let settings_path = profile_settings_path(shared_usr_root, &manifest.id)
    let directory_path = profile_directory(shared_usr_root, &manifest.id)
    UsrProfileSummary { id: manifest.id, name: manifest.name, override_slices: manifest.override_slices, created_at_ms: manifest.created_at_ms, updated_at_ms: manifest.updated_at_ms, directory_path: directory_path.to_string_lossy().into_owned(), settings_path: settings_path.to_string_lossy().into_owned(), is_active: is_active }

fn append_stack_directory(directories: &mut Array<String>, next_directory: std::path::PathBuf):
    let next_value = next_directory.to_string_lossy().into_owned()
    if directories.iter().all(|existing| existing != &next_value):
        directories.push(next_value)
        ()

fn build_directory_stacks(app: &tauri::AppHandle, shared_usr_root: &std::path::Path, active_profile_id: String) -> Result<Array<UsrManagedContentDirectoryStack>, String>:
    let manifest = usr__load_usr_manifest()?
    let bundled_usr_root = usr__resolve_bundled_usr_root(app)?
    let mut directory_stacks = Vec__new_()
    for entry in manifest.entries:
        if entry.env_var_suffix.is_none():
            continue
        let shared_root_directory = match entry.profile_mode:
            UsrProfileLaneMode::SharedRoot => Option::Some(shared_usr_root.join(&entry.relative_directory))
            UsrProfileLaneMode::ProfileOverlay => none
        let default_profile_directory = match entry.profile_mode:
            UsrProfileLaneMode::SharedRoot => none
            UsrProfileLaneMode::ProfileOverlay => Option::Some(default_profile_overlay_directory(shared_usr_root, &entry.relative_directory))
        let bundled_directory_path = bundled_usr_root.join(usr__resolve_shipped_usr_entry_relative_directory(&entry))
        let active_profile_directory = match entry.profile_mode:
            UsrProfileLaneMode::SharedRoot => none
            UsrProfileLaneMode::ProfileOverlay => Option::Some(profile_directory(shared_usr_root, active_profile_id).join(&entry.relative_directory))
        let baseline_directory = default_profile_directory.clone().or_else(|| shared_root_directory.clone()).ok_or_else(|| format!("Usr managed-content lane '{}' is missing a baseline directory", entry.id))?
        let writable_directory = active_profile_directory.clone().unwrap_or_else(|| baseline_directory.clone())
        let mut directories = Vec__new_()
        match active_profile_directory.clone():
            Some(active_profile_directory) =>
                append_stack_directory(&mut directories, active_profile_directory)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        append_stack_directory(&mut directories, baseline_directory.clone())
        ()
        if entry.bundled:
            append_stack_directory(&mut directories, bundled_directory_path.clone())
            ()
            ()
            ()
            ()
        directory_stacks.push(UsrManagedContentDirectoryStack { lane_id: entry.id, profile_mode: entry.profile_mode, directories: directories, baseline_directory: baseline_directory.to_string_lossy().into_owned(), shared_root_directory: shared_root_directory.map(|path| path.to_string_lossy().into_owned()), default_profile_directory: default_profile_directory.map(|path| path.to_string_lossy().into_owned()), active_profile_directory: active_profile_directory.map(|path| path.to_string_lossy().into_owned()), bundled_directory: entry.bundled.then(|| bundled_directory_path.to_string_lossy().into_owned()), writable_directory: writable_directory.to_string_lossy().into_owned() })
        ()
    ()
    Result::Ok(directory_stacks)

fn build_runtime_snapshot_from_catalog(app: &tauri::AppHandle, shared_usr_root: &std::path::Path, catalog: &UsrProfileCatalogFile) -> Result<UsrProfileRuntimeSnapshot, String>:
    ensure_catalog_profile_exists(catalog, &(*catalog).active_profile_id)?
    ()
    let (shared_settings, active_profile_settings, effective_settings) = read_active_settings(shared_usr_root, &(*catalog).active_profile_id)?
    let profiles = (*catalog).profile_order.iter().map(|profile_id| read_profile_manifest_file(shared_usr_root, profile_id).map(|manifest| to_profile_summary(shared_usr_root, manifest, profile_id == &(*catalog).active_profile_id))).collect()?
    let active_profile_settings_path = profile_settings_path(shared_usr_root, &(*catalog).active_profile_id).to_string_lossy().into_owned()
    Result::Ok(UsrProfileRuntimeSnapshot { active_profile_id: (*catalog).active_profile_id.clone(), profiles_root: profiles_root(shared_usr_root).to_string_lossy().into_owned(), shared_settings_path: shared_settings_path(shared_usr_root).to_string_lossy().into_owned(), shared_settings_json: serialize_json_object(&shared_settings, "shared profile settings")?, active_profile_settings_path: active_profile_settings_path, active_profile_settings_json: serialize_json_object(&active_profile_settings, "active profile settings")?, effective_settings_json: serialize_json_object(&effective_settings, "effective profile settings")?, profiles: profiles, managed_content_directory_stacks: build_directory_stacks(app, shared_usr_root, &(*catalog).active_profile_id)? })

fn emit_profile_changed(app: &tauri::AppHandle, snapshot: UsrProfileRuntimeSnapshot):
    let _ = UsrProfileChangedEvent { snapshot: snapshot }.emit_(app)

fn resolve_shared_usr_root_for_profiles(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let root = usr__resolve_shared_usr_root(app)?
    std__fs__create_dir_all(&root).map_err(|error| format!("Failed to create {}: {error}", root.display()))?
    ()
    Result::Ok(root)

fn usr_profiles_initialize(app: tauri::AppHandle, current_settings_json: Option<String>, legacy_settings_storage_json: Option<String>) -> Result<UsrProfileRuntimeSnapshot, String>:
    let shared_usr_root = resolve_shared_usr_root_for_profiles(&app)?
    let catalog = load_or_initialize_catalog(&shared_usr_root, current_settings_json, legacy_settings_storage_json)?
    build_runtime_snapshot_from_catalog(&app, &shared_usr_root, &catalog)

fn usr_profiles_get_runtime_snapshot(app: tauri::AppHandle) -> Result<UsrProfileRuntimeSnapshot, String>:
    let shared_usr_root = resolve_shared_usr_root_for_profiles(&app)?
    let catalog = load_or_initialize_catalog(&shared_usr_root, none, none)?
    build_runtime_snapshot_from_catalog(&app, &shared_usr_root, &catalog)

fn usr_profiles_persist_active_settings_snapshot(app: tauri::AppHandle, settings_json: String) -> Result<UsrProfileRuntimeSnapshot, String>:
    let shared_usr_root = resolve_shared_usr_root_for_profiles(&app)?
    let catalog = load_or_initialize_catalog(&shared_usr_root, none, none)?
    let settings = parse_settings_json_object(&settings_json, "active settings snapshot")?
    persist_partitioned_settings(&shared_usr_root, &catalog.active_profile_id, &settings)?
    ()
    let snapshot = build_runtime_snapshot_from_catalog(&app, &shared_usr_root, &catalog)?
    emit_profile_changed(&app, snapshot.clone())
    ()
    Result::Ok(snapshot)

fn usr_profiles_switch(app: tauri::AppHandle, profile_id: String, current_settings_json: Option<String>) -> Result<UsrProfileRuntimeSnapshot, String>:
    let shared_usr_root = resolve_shared_usr_root_for_profiles(&app)?
    let mut catalog = load_or_initialize_catalog(&shared_usr_root, none, none)?
    ensure_catalog_profile_exists(&catalog, &profile_id)?
    ()
    match current_settings_json:
        Some(current_settings_json) =>
            let settings = parse_settings_json_object(current_settings_json, "active settings snapshot")?
            persist_partitioned_settings(&shared_usr_root, &catalog.active_profile_id, &settings)?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    catalog.active_profile_id = profile_id
    ()
    write_profile_catalog(&shared_usr_root, &catalog)?
    ()
    let snapshot = build_runtime_snapshot_from_catalog(&app, &shared_usr_root, &catalog)?
    emit_profile_changed(&app, snapshot.clone())
    ()
    Result::Ok(snapshot)

fn usr_profiles_create(app: tauri::AppHandle, request: UsrProfileCreateRequest) -> Result<UsrProfileRuntimeSnapshot, String>:
    let shared_usr_root = resolve_shared_usr_root_for_profiles(&app)?
    let mut catalog = load_or_initialize_catalog(&shared_usr_root, none, none)?
    let profile_name = sanitize_profile_name(&request.name)
    let new_profile_id = unique_profile_id(&shared_usr_root, request.profile_id, &profile_name, &catalog.profile_order)
    let timestamp_ms = current_timestamp_ms()
    let manifest = create_profile_manifest_file(&new_profile_id, &profile_name, timestamp_ms)
    let seed_profile_settings = match request.seed_settings_json:
        Some(seed_settings_json) =>
            let seed_settings = parse_settings_json_object(seed_settings_json, "new profile seed settings")?
            let (_, profile_settings) = partition_settings_object(&seed_settings)
            profile_settings
        _ =>
            read_json_object_file(&profile_settings_path(&shared_usr_root, &catalog.active_profile_id))?
    write_profile_manifest_file(&shared_usr_root, &manifest)?
    ()
    write_json_file(&profile_settings_path(&shared_usr_root, &new_profile_id), &seed_profile_settings)?
    ()
    copy_profile_overlay_lane_directories(&shared_usr_root, &catalog.active_profile_id, &new_profile_id)?
    ()
    catalog.profile_order.push(new_profile_id.clone())
    ()
    if request.activate:
        catalog.active_profile_id = new_profile_id
        ()
        ()
        ()
        ()
    write_profile_catalog(&shared_usr_root, &catalog)?
    ()
    let snapshot = build_runtime_snapshot_from_catalog(&app, &shared_usr_root, &catalog)?
    emit_profile_changed(&app, snapshot.clone())
    ()
    Result::Ok(snapshot)

fn usr_profiles_duplicate(app: tauri::AppHandle, request: UsrProfileDuplicateRequest) -> Result<UsrProfileRuntimeSnapshot, String>:
    let shared_usr_root = resolve_shared_usr_root_for_profiles(&app)?
    let mut catalog = load_or_initialize_catalog(&shared_usr_root, none, none)?
    ensure_catalog_profile_exists(&catalog, &request.source_profile_id)?
    ()
    if request.source_profile_id == catalog.active_profile_id:
        match request.current_settings_json:
            Some(current_settings_json) =>
                let settings = parse_settings_json_object(current_settings_json, "active settings snapshot")?
                persist_partitioned_settings(&shared_usr_root, &catalog.active_profile_id, &settings)?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    let source_manifest = read_profile_manifest_file(&shared_usr_root, &request.source_profile_id)?
    let duplicate_name = sanitize_profile_name(&request.name)
    let new_profile_id = unique_profile_id(&shared_usr_root, request.profile_id, &duplicate_name, &catalog.profile_order)
    let timestamp_ms = current_timestamp_ms()
    let duplicate_manifest = UsrProfileManifestFile { id: new_profile_id.clone(), name: duplicate_name, override_slices: source_manifest.override_slices.clone(), created_at_ms: timestamp_ms, updated_at_ms: timestamp_ms }
    let source_settings = read_json_object_file(&profile_settings_path(&shared_usr_root, &request.source_profile_id))?
    write_profile_manifest_file(&shared_usr_root, &duplicate_manifest)?
    ()
    write_json_file(&profile_settings_path(&shared_usr_root, &new_profile_id), &source_settings)?
    ()
    copy_profile_overlay_lane_directories(&shared_usr_root, &request.source_profile_id, &new_profile_id)?
    ()
    catalog.profile_order.push(new_profile_id.clone())
    ()
    if request.activate:
        catalog.active_profile_id = new_profile_id
        ()
        ()
        ()
        ()
    write_profile_catalog(&shared_usr_root, &catalog)?
    ()
    let snapshot = build_runtime_snapshot_from_catalog(&app, &shared_usr_root, &catalog)?
    emit_profile_changed(&app, snapshot.clone())
    ()
    Result::Ok(snapshot)

fn usr_profiles_rename(app: tauri::AppHandle, request: UsrProfileRenameRequest) -> Result<UsrProfileRuntimeSnapshot, String>:
    let shared_usr_root = resolve_shared_usr_root_for_profiles(&app)?
    let catalog = load_or_initialize_catalog(&shared_usr_root, none, none)?
    ensure_catalog_profile_exists(&catalog, &request.profile_id)?
    ()
    let mut manifest = read_profile_manifest_file(&shared_usr_root, &request.profile_id)?
    manifest.name = sanitize_profile_name(&request.name)
    ()
    manifest.updated_at_ms = current_timestamp_ms()
    ()
    write_profile_manifest_file(&shared_usr_root, &manifest)?
    ()
    let snapshot = build_runtime_snapshot_from_catalog(&app, &shared_usr_root, &catalog)?
    emit_profile_changed(&app, snapshot.clone())
    ()
    Result::Ok(snapshot)

fn usr_profiles_delete(app: tauri::AppHandle, request: UsrProfileDeleteRequest) -> Result<UsrProfileRuntimeSnapshot, String>:
    let shared_usr_root = resolve_shared_usr_root_for_profiles(&app)?
    let mut catalog = load_or_initialize_catalog(&shared_usr_root, none, none)?
    ensure_catalog_profile_exists(&catalog, &request.profile_id)?
    ()
    if catalog.profile_order.len() <= 1:
        return Result::Err("Cannot delete the last remaining usr profile".to_string())
    let fallback_profile_id = match request.fallback_profile_id:
        Some(fallback_profile_id) =>
            ensure_catalog_profile_exists(&catalog, &fallback_profile_id)?
            ()
            fallback_profile_id
        _ =>
            catalog.profile_order.iter().find(|profile_id| *profile_id != &request.profile_id).cloned().ok_or_else(|| "Unable to resolve a fallback usr profile".to_string())?
    let profile_directory_path = profile_directory(&shared_usr_root, &request.profile_id)
    if profile_directory_path.exists():
        std__fs__remove_dir_all(&profile_directory_path).map_err(|error| format!("Failed to delete {}: {error}", profile_directory_path.display()))?
        ()
        ()
        ()
        ()
    catalog.profile_order.retain(|profile_id| profile_id != &request.profile_id)
    ()
    if catalog.active_profile_id == request.profile_id:
        catalog.active_profile_id = fallback_profile_id
        ()
        ()
        ()
        ()
    write_profile_catalog(&shared_usr_root, &catalog)?
    ()
    let snapshot = build_runtime_snapshot_from_catalog(&app, &shared_usr_root, &catalog)?
    emit_profile_changed(&app, snapshot.clone())
    ()
    Result::Ok(snapshot)

enum VideoPreviewSourceKind:
    Direct
    Proxy

struct ResolvedVideoPreviewSource:
    source_path: String
    source_kind: VideoPreviewSourceKind
    mime_type: Option<String>
    generated_from_path: Option<String>

struct VideoTrimExportRequest:
    input_path: String
    output_path: String
    start_time_seconds: f64
    end_time_seconds: f64
    overwrite_existing: Bool

struct VideoTrimExportResult:
    output_path: String
    start_time_seconds: f64
    end_time_seconds: f64
    duration_seconds: f64
    ffmpeg_binary: String

struct VideoPreviewCompatibility:
    direct_playback_supported: Bool
    has_audio_track: Bool
    mime_type: Option<String>

fn video_export_trim(request: VideoTrimExportRequest) -> Result<VideoTrimExportResult, String>:
    await run_video_trim_export(request)

fn video_create_preview_proxy(app: tauri::AppHandle, input_path: String) -> Result<ResolvedVideoPreviewSource, String>:
    let input = video_engine__validate_video_source_path(&input_path)?
    let compatibility = (await resolve_video_preview_compatibility(&input))?
    let proxy_path = (await ensure_video_preview_proxy(&app, &input, compatibility.has_audio_track))?
    Result::Ok(ResolvedVideoPreviewSource { source_path: path_to_string(&proxy_path), source_kind: VideoPreviewSourceKind::Proxy, mime_type: Option::Some(video_preview_proxy_mime_type().to_string()), generated_from_path: Option::Some(path_to_string(&input)) })

fn video_resolve_preview_source(app: tauri::AppHandle, input_path: String) -> Result<ResolvedVideoPreviewSource, String>:
    let input = video_engine__validate_video_source_path(&input_path)?
    let compatibility = (await resolve_video_preview_compatibility(&input))?
    if compatibility.direct_playback_supported:
        return Result::Ok(ResolvedVideoPreviewSource { source_path: path_to_string(&input), source_kind: VideoPreviewSourceKind::Direct, mime_type: compatibility.mime_type, generated_from_path: none })
    let proxy_path = (await ensure_video_preview_proxy(&app, &input, compatibility.has_audio_track))?
    Result::Ok(ResolvedVideoPreviewSource { source_path: path_to_string(&proxy_path), source_kind: VideoPreviewSourceKind::Proxy, mime_type: Option::Some(video_preview_proxy_mime_type().to_string()), generated_from_path: Option::Some(path_to_string(&input)) })

fn run_video_trim_export(request: VideoTrimExportRequest) -> Result<VideoTrimExportResult, String>:
    let normalized_request = normalize_trim_export_request(request)?
    let input_path = PathBuf__from(&normalized_request.input_path)
    let compatibility = (await resolve_video_preview_compatibility(&input_path))?
    let ffmpeg_binary = video_engine__resolve_video_ffmpeg_binary()
    let clip_duration_seconds = normalized_request.end_time_seconds - normalized_request.start_time_seconds
    let trim_input = Input__new_(normalized_request.input_path.clone()).seek(ffmpeg_duration_from_seconds(normalized_request.start_time_seconds)).duration(ffmpeg_duration_from_seconds(clip_duration_seconds))
    let trim_output = build_trim_export_output(Path__new_(&normalized_request.output_path), compatibility.has_audio_track)
    let builder = FFmpegBuilder__with_executable(ffmpeg_binary.clone()).log_level(rust_ffmpeg::LogLevel::Error).input(trim_input).raw_args(["-vf", VIDEO_TRIM_SCALE_FILTER])
    let builder = if normalized_request.overwrite_existing:
        builder.overwrite()
    else:
        builder.no_overwrite()
    (await builder.output(trim_output).run()).map_err(|error| format!("Video trim export failed: {error}"))?
    ()
    Result::Ok(VideoTrimExportResult { output_path: normalized_request.output_path, start_time_seconds: normalized_request.start_time_seconds, end_time_seconds: normalized_request.end_time_seconds, duration_seconds: clip_duration_seconds, ffmpeg_binary: ffmpeg_binary })

fn normalize_trim_export_request(request: VideoTrimExportRequest) -> Result<VideoTrimExportRequest, String>:
    let input_path = request.input_path.trim()
    let output_path = request.output_path.trim()
    if input_path.is_empty():
        return Result::Err("Input video path cannot be empty.".to_string())
    if output_path.is_empty():
        return Result::Err("Output video path cannot be empty.".to_string())
    if !request.start_time_seconds.is_finite() or !request.end_time_seconds.is_finite():
        return Result::Err("Trim points must be finite numbers.".to_string())
    if request.start_time_seconds < 0.0:
        return Result::Err("Trim start cannot be negative.".to_string())
    if request.end_time_seconds <= request.start_time_seconds:
        return Result::Err("Trim end must be greater than trim start.".to_string())
    let input = PathBuf__from(input_path)
    if !input.exists():
        return Result::Err(format!("Input video does not exist: {}", input.display()))
    if !input.is_file():
        return Result::Err(format!("Input path is not a file: {}", input.display()))
    let output = PathBuf__from(output_path)
    if paths_match(&input, &output):
        return Result::Err("Trim export must write to a different output path.".to_string())
    match output.parent():
        Some(parent) =>
            if !parent.as_os_str().is_empty():
                std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create output directory '{}': {error}", parent.display()))?
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    if output.exists() and !request.overwrite_existing:
        return Result::Err(format!("Output path already exists and overwrite is disabled: {}", output.display()))
    Result::Ok(VideoTrimExportRequest { input_path: input.to_string_lossy().to_string(), output_path: output.to_string_lossy().to_string(), start_time_seconds: request.start_time_seconds, end_time_seconds: request.end_time_seconds, overwrite_existing: request.overwrite_existing })

fn resolve_video_temp_root(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let root = (video_engine__resolve_video_runtime_root(app)?).join("temp")
    std__fs__create_dir_all(&root).map_err(|error| format!("Failed to create video temp directory '{}': {error}", root.display()))?
    ()
    Result::Ok(root)

fn video_preview_proxy_path(app: &tauri::AppHandle, input_path: &std::path::Path) -> Result<std::path::PathBuf, String>:
    let temp_root = (resolve_video_temp_root(app)?).join("preview-proxies")
    std__fs__create_dir_all(&temp_root).map_err(|error| format!("Failed to create video proxy directory '{}': {error}", temp_root.display()))?
    ()
    let metadata = std__fs__metadata(input_path).map_err(|error| format!("Failed to read video metadata '{}': {error}", input_path.display()))?
    let modified_nanos = metadata.modified().ok().and_then(|value| value.duration_since(std__time__UNIX_EPOCH).ok()).map(|value| value.as_nanos()).unwrap_or_default()
    let mut hasher = Sha256__new_()
    hasher.update(input_path.to_string_lossy().as_bytes())
    ()
    hasher.update(metadata.len().to_le_bytes())
    ()
    hasher.update(modified_nanos.to_le_bytes())
    ()
    let digest = format!("{:x}", hasher.finalize())
    let digest_prefix = &digest[..16]
    let stem = video_engine__sanitize_video_runtime_stem(input_path.file_stem().and_then(|value| value.to_str()).unwrap_or("video"))
    Result::Ok(temp_root.join(format!("{stem}.{digest_prefix}.preview.{}", video_preview_proxy_extension())))

fn can_reuse_video_preview_proxy(input_path: &std::path::Path, proxy_path: &std::path::Path) -> Bool:
    let Ok(proxy_metadata) = std__fs__metadata(proxy_path)
    if !proxy_metadata.is_file() or proxy_metadata.len() == 0:
        return false
    let Ok(input_metadata) = std__fs__metadata(input_path)
    let input_modified = input_metadata.modified().ok()
    let proxy_modified = proxy_metadata.modified().ok()
    match (input_modified, proxy_modified):
        (Some(input_time), Some(proxy_time)) => proxy_time >= input_time
        _ => false

fn ensure_video_preview_proxy(app: &tauri::AppHandle, input_path: &std::path::Path, has_audio_track: Bool) -> Result<std::path::PathBuf, String>:
    let proxy_path = video_preview_proxy_path(app, input_path)?
    if !can_reuse_video_preview_proxy(input_path, &proxy_path):
        (await generate_video_preview_proxy(input_path, &proxy_path, has_audio_track))?
        ()
        ()
        ()
        ()
    Result::Ok(proxy_path)

fn generate_video_preview_proxy(input_path: &std::path::Path, proxy_path: &std::path::Path, has_audio_track: Bool) -> Result<(), String>:
    match proxy_path.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create preview proxy directory '{}': {error}", parent.display()))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    (await FFmpegBuilder__with_executable(video_engine__resolve_video_ffmpeg_binary()).log_level(rust_ffmpeg::LogLevel::Error).overwrite().input_path(path_to_string(input_path)).raw_args(["-vf", VIDEO_PREVIEW_PROXY_SCALE_FILTER]).output(build_preview_proxy_output(proxy_path, has_audio_track)).run()).map_err(|error| format!("Video preview proxy generation failed: {error}"))?
    ()
    Result::Ok(())

fn build_preview_proxy_output(proxy_path: &std::path::Path, has_audio_track: Bool) -> rust_ffmpeg::Output:
    let output = Output__new_(path_to_string(proxy_path)).format("mp4").video_codec_opts(CodecOptions__new_(Codec__new_("libx264")).quality(VIDEO_PREVIEW_PROXY_MP4_CRF).pixel_format(PixelFormat__yuv420p()).option("profile:v", "high")).preset(VIDEO_PREVIEW_PROXY_MP4_PRESET).faststart()
    if has_audio_track:
        output.audio_codec_opts(CodecOptions__new_(Codec__aac()).bitrate(VIDEO_PREVIEW_PROXY_AUDIO_BITRATE))
    else:
        output.no_audio()

fn video_preview_proxy_extension() -> String:
    "mp4"

fn video_preview_proxy_mime_type() -> String:
    "video/mp4"

fn build_trim_export_output(output_path: &std::path::Path, has_audio_track: Bool) -> rust_ffmpeg::Output:
    let output = Output__new_(path_to_string(output_path)).format("mp4").video_codec_opts(CodecOptions__new_(Codec__new_("libx264")).quality(VIDEO_TRIM_CRF).pixel_format(PixelFormat__yuv420p())).preset(VIDEO_TRIM_PRESET).faststart()
    if has_audio_track:
        output.audio_codec_opts(CodecOptions__new_(Codec__aac()).bitrate(VIDEO_TRIM_AUDIO_BITRATE))
    else:
        output.no_audio()

fn resolve_video_preview_compatibility(input_path: &std::path::Path) -> Result<VideoPreviewCompatibility, String>:
    let probe = (await probe_video_media(input_path))?
    let video_stream = probe.primary_video_stream().ok_or_else(|| format!("No video stream was found in '{}'.", input_path.display()))?
    let audio_stream = probe.primary_audio_stream()
    let extension = lowercase_extension(input_path)
    let direct_playback_supported = match extension:
        Some("mp4" | "m4v") =>
            is_mp4_video_stream_supported(video_stream) and audio_stream.map(is_mp4_audio_stream_supported).unwrap_or(true)
        Some("webm") =>
            is_webm_video_stream_supported(video_stream) and audio_stream.map(is_webm_audio_stream_supported).unwrap_or(true)
        Some("ogv") =>
            is_ogv_video_stream_supported(video_stream) and audio_stream.map(is_ogv_audio_stream_supported).unwrap_or(true)
        _ => false
    Result::Ok(VideoPreviewCompatibility { direct_playback_supported: direct_playback_supported, has_audio_track: audio_stream.is_some(), mime_type: direct_video_preview_mime_type(input_path) })

fn probe_video_media(input_path: &std::path::Path) -> Result<rust_ffprobe::ProbeResult, String>:
    (await FFprobeBuilder__with_executable(video_engine__resolve_video_ffprobe_binary()).input(path_to_string(input_path)).show_format().show_streams().log_level(rust_ffprobe::LogLevel::Error).run()).map_err(|error| format!("Video probe failed for '{}': {error}", input_path.display()))

fn is_mp4_video_stream_supported(video_stream: &rust_ffprobe::StreamInfo) -> Bool:
    let Some(codec_name) = lowercase_codec_name(video_stream)
    if !matches!(codec_name.as_str(), "h264" | "avc1"):
        return false
    match lowercase_optional((*video_stream).pix_fmt):
        Some(pixel_format) =>
            pixel_format.contains("420") or pixel_format == "nv12" or pixel_format == "yuvj420p"
        None => true

fn is_mp4_audio_stream_supported(audio_stream: &rust_ffprobe::StreamInfo) -> Bool:
    matches!(lowercase_codec_name(audio_stream), Option::Some("aac" | "mp3" | "mp4a"))

fn is_webm_video_stream_supported(video_stream: &rust_ffprobe::StreamInfo) -> Bool:
    matches!(lowercase_codec_name(video_stream), Option::Some("vp8" | "vp9"))

fn is_webm_audio_stream_supported(audio_stream: &rust_ffprobe::StreamInfo) -> Bool:
    matches!(lowercase_codec_name(audio_stream), Option::Some("opus" | "vorbis"))

fn is_ogv_video_stream_supported(video_stream: &rust_ffprobe::StreamInfo) -> Bool:
    matches!(lowercase_codec_name(video_stream), Option::Some("theora"))

fn is_ogv_audio_stream_supported(audio_stream: &rust_ffprobe::StreamInfo) -> Bool:
    matches!(lowercase_codec_name(audio_stream), Option::Some("opus" | "vorbis"))

fn lowercase_extension(input_path: &std::path::Path) -> Option<String>:
    input_path.extension().and_then(|value| value.to_str()).map(|value| value.trim().trim_start_matches(".").to_ascii_lowercase())

fn lowercase_codec_name(stream: &rust_ffprobe::StreamInfo) -> Option<String>:
    lowercase_optional((*stream).codec_name)

fn lowercase_optional(value: Option<String>) -> Option<String>:
    value.map(str__trim).filter(|value| !value.is_empty()).map(str__to_ascii_lowercase)

fn direct_video_preview_mime_type(input_path: &std::path::Path) -> Option<String>:
    let extension = lowercase_extension(input_path)?
    let mime_type = match extension.as_str():
        "3g2" => "video/3gpp2"
        "3gp" => "video/3gpp"
        "asf" => "video/x-ms-asf"
        "avi" => "video/x-msvideo"
        "flv" => "video/x-flv"
        "m2ts" | "mts" => "video/mp2t"
        "m2v" | "mpe" | "mpeg" | "mpg" => "video/mpeg"
        "m4v" => "video/x-m4v"
        "mkv" => "video/x-matroska"
        "mov" | "qt" => "video/quicktime"
        "mp4" => "video/mp4"
        "ogv" => "video/ogg"
        "webm" => "video/webm"
        "wmv" => "video/x-ms-wmv"
        _ => return none
    Option::Some(mime_type.to_string())

fn ffmpeg_duration_from_seconds(seconds: f64) -> rust_ffmpeg::Duration:
    Duration__from_secs_f64(seconds.max(0.0)).into()

fn path_to_string(path: &std::path::Path) -> String:
    path.to_string_lossy().to_string()

fn paths_match(left: &std::path::Path, right: &std::path::Path) -> Bool:
    let canonical_left = std__fs__canonicalize(left).ok()
    let canonical_right = std__fs__canonicalize(right).ok()
    match (canonical_left, canonical_right):
        (Some(normalized_left), Some(normalized_right)) => normalized_left == normalized_right
        _ => left == right

enum VideoPlaybackBackend:
    WebviewMediaElement

struct VideoEngineLoopRegion:
    start_seconds: f64
    end_seconds: f64
    enabled: Bool

struct VideoEngineStateSnapshot:
    ready: Bool
    engine_error: Option<String>
    loaded_path: Option<String>
    loaded_name: Option<String>
    duration_seconds: f64
    width_px: Option<u32>
    height_px: Option<u32>
    frame_rate: Option<f64>
    has_audio_track: Bool
    current_time_seconds: f64
    is_playing: Bool
    is_loading: Bool
    playback_backend: VideoPlaybackBackend
    loop_region: VideoEngineLoopRegion
    audio_transport_ready: Bool
    audio_transport_error: Option<String>

struct VideoEngineStateEvent:
    state: VideoEngineStateSnapshot

struct VideoEngineLoadSourceRequest:
    input_path: String

struct VideoEngineSeekRequest:
    position_seconds: f64

struct VideoEngineLoopRegionRequest:
    start_seconds: f64
    end_seconds: f64
    enabled: Bool

struct VideoEngineManager:
    runtime: Option<VideoEngineRuntimeHost>

impl Default for VideoEngineManager:
    fn default_() -> VideoEngineManager:
        VideoEngineManager { runtime: none }


struct VideoEngineRuntimeHost:
    shared_: VideoEngineSharedState

struct VideoEngineSharedState:
    app_handle: tauri::AppHandle
    state: VideoEngineMutableState
    background_thread_started: std::sync::atomic::AtomicBool

struct VideoEngineMutableState:
    ready: Bool
    engine_error: Option<String>
    playback_backend: VideoPlaybackBackend
    loaded_path: Option<String>
    loaded_name: Option<String>
    duration_seconds: f64
    width_px: Option<u32>
    height_px: Option<u32>
    frame_rate: Option<f64>
    has_audio_track: Bool
    current_time_seconds: f64
    is_playing: Bool
    is_loading: Bool
    loop_region: VideoEngineLoopRegion
    audio_transport_ready: Bool
    audio_transport_error: Option<String>
    loaded_generation: u64
    silent_playback_started_at: Option<std::time::Instant>
    silent_playback_started_time_seconds: f64

struct PreparedVideoSource:
    input_path: std::path::PathBuf
    loaded_name: String
    duration_seconds: f64
    width_px: u32
    height_px: u32
    frame_rate: Option<f64>
    has_audio_track: Bool

struct ProbedVideoMetadata:
    duration_seconds: f64
    width_px: u32
    height_px: u32
    frame_rate: Option<f64>
    has_audio_track: Bool

struct FfprobeResponse:
    streams: Array<FfprobeStream>
    format: Option<FfprobeFormat>

struct FfprobeStream:
    codec_type: Option<String>
    width: Option<u32>
    height: Option<u32>
    avg_frame_rate: Option<String>

struct FfprobeFormat:
    duration: Option<String>

impl Default for VideoEngineMutableState:
    fn default_() -> VideoEngineMutableState:
        VideoEngineMutableState { ready: false, engine_error: none, playback_backend: VideoPlaybackBackend::WebviewMediaElement, loaded_path: none, loaded_name: none, duration_seconds: 0.0, width_px: none, height_px: none, frame_rate: none, has_audio_track: false, current_time_seconds: 0.0, is_playing: false, is_loading: false, loop_region: VideoEngineLoopRegion { start_seconds: 0.0, end_seconds: 0.0, enabled: false }, audio_transport_ready: false, audio_transport_error: none, loaded_generation: 0, silent_playback_started_at: none, silent_playback_started_time_seconds: 0.0 }


impl VideoEngineSharedState:
    fn new_(app_handle: tauri::AppHandle) -> VideoEngineSharedState:
        VideoEngineSharedState { app_handle: app_handle, state: Mutex__new_(VideoEngineMutableState__default_()), background_thread_started: AtomicBool__new_(false) }

    fn snapshot(_self: &VideoEngineSharedState) -> VideoEngineStateSnapshot:
        let state = (*_self).state.lock().expect("video engine state poisoned")
        build_snapshot(&state)

    fn emit_state(_self: &VideoEngineSharedState):
        let _ = VideoEngineStateEvent { state: (*_self).snapshot() }.emit_(&(*_self).app_handle)


fn build_snapshot(state: &VideoEngineMutableState) -> VideoEngineStateSnapshot:
    VideoEngineStateSnapshot { ready: (*state).ready, engine_error: (*state).engine_error.clone(), loaded_path: (*state).loaded_path.clone(), loaded_name: (*state).loaded_name.clone(), duration_seconds: (*state).duration_seconds, width_px: (*state).width_px, height_px: (*state).height_px, frame_rate: (*state).frame_rate, has_audio_track: (*state).has_audio_track, current_time_seconds: (*state).current_time_seconds, is_playing: (*state).is_playing, is_loading: (*state).is_loading, playback_backend: (*state).playback_backend, loop_region: (*state).loop_region.clone(), audio_transport_ready: (*state).audio_transport_ready, audio_transport_error: (*state).audio_transport_error.clone() }

fn ensure_video_engine_shared(app: &tauri::AppHandle) -> Result<VideoEngineSharedState, String>:
    let manager = app.state()
    let mut runtime = manager.runtime.lock().map_err(|_| "Video engine runtime lock was poisoned.".to_string())?
    match runtime:
        Some(runtime_host) =>
            return Result::Ok(runtime_host.shared_.clone())
        _ =>
            ()
            ()
    let runtime_host = build_video_engine_runtime(app)?
    let shared_ = runtime_host.shared_.clone()
    *runtime = Option::Some(runtime_host)
    ()
    Result::Ok(shared_)

fn existing_video_engine_shared(app: &tauri::AppHandle) -> Option<VideoEngineSharedState>:
    let manager = app.state()
    let runtime = manager.runtime.lock().ok()?
    runtime.map(|value| value.shared_.clone())

fn build_video_engine_runtime(app: &tauri::AppHandle) -> Result<VideoEngineRuntimeHost, String>:
    let shared_ = Arc__new_(VideoEngineSharedState__new_(app.clone()))
    start_video_engine_background_thread(shared_.clone())
    ()
    Result::Ok(VideoEngineRuntimeHost { shared_: shared_ })

fn start_video_engine_background_thread(shared: VideoEngineSharedState):
    if shared_.background_thread_started.swap(true, std::sync::atomic::Ordering::Relaxed):
        return
    std__thread__spawn_(
        || loop:
            std__thread__sleep(Duration__from_millis(VIDEO_ENGINE_TICK_INTERVAL_MS))
            ()
            if advance_video_engine_transport(&shared_).unwrap_or(false):
                shared_.emit_state()
                ()
    )
    ()

fn advance_video_engine_transport(shared: &VideoEngineSharedState) -> Result<Bool, String>:
    let audio_snapshot = audio_engine__audio_engine_get_state(shared_.app_handle.clone()).ok()
    let mut state = shared_.state.lock().map_err(|_| "Video engine state lock was poisoned.".to_string())?
    if state.loaded_path.is_none():
        state.silent_playback_started_at = none
        ()
        return Result::Ok(false)
    let mut changed = false
    let maybe_audio_deck = audio_snapshot.and_then(|snapshot| snapshot.decks.iter().find(|deck| deck.deck_id == VIDEO_AUDIO_DECK_ID))
    match maybe_audio_deck:
        Some(audio_deck) =>
            let audio_loaded_matches = audio_deck.loaded_path == state.loaded_path
            if audio_loaded_matches:
                let next_time_seconds = clamp_video_position(audio_deck.current_time_seconds, state.duration_seconds)
                if (state.current_time_seconds - next_time_seconds).abs() > 0.02:
                    state.current_time_seconds = next_time_seconds
                    ()
                    changed = true
                    ()
                    ()
                    ()
                    ()
                if state.is_playing != audio_deck.is_playing:
                    state.is_playing = audio_deck.is_playing
                    ()
                    changed = true
                    ()
                    ()
                    ()
                    ()
                state.silent_playback_started_at = none
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    if state.is_playing and !state.audio_transport_ready:
        let now = Instant__now()
        let elapsed_seconds = match state.silent_playback_started_at:
            Some(started_at) => now.duration_since(started_at).as_secs_f64()
            None =>
                state.silent_playback_started_at = Option::Some(now)
                ()
                state.silent_playback_started_time_seconds = state.current_time_seconds
                ()
                0.0
        let mut next_time_seconds = state.silent_playback_started_time_seconds + elapsed_seconds
        if state.loop_region.enabled and state.loop_region.end_seconds > state.loop_region.start_seconds:
            let loop_duration = (state.loop_region.end_seconds - state.loop_region.start_seconds).max(MINIMUM_VIDEO_LOOP_DURATION_SECONDS)
            if next_time_seconds >= state.loop_region.end_seconds:
                let overshoot = (next_time_seconds - state.loop_region.start_seconds) % loop_duration
                next_time_seconds = state.loop_region.start_seconds + overshoot
                ()
                ()
                ()
                ()
            ()
        else if next_time_seconds >= state.duration_seconds:
            next_time_seconds = state.duration_seconds
            ()
            state.is_playing = false
            ()
            state.silent_playback_started_at = none
            ()
            ()
            ()
            ()
        let next_time_seconds = clamp_video_position(next_time_seconds, state.duration_seconds)
        if (state.current_time_seconds - next_time_seconds).abs() > 0.02:
            state.current_time_seconds = next_time_seconds
            ()
            changed = true
            ()
            ()
            ()
            ()
        ()
    else:
        state.silent_playback_started_at = none
        ()
        ()
        ()
        ()
    Result::Ok(changed)

fn clamp_video_position(position_seconds: f64, duration_seconds: f64) -> f64:
    if !position_seconds.is_finite():
        return 0.0
    position_seconds.clamp(0.0, duration_seconds.max(0.0))

fn validate_video_source_path(input_path: String) -> Result<std::path::PathBuf, String>:
    let trimmed = input_path.trim()
    if trimmed.is_empty():
        return Result::Err("Input video path cannot be empty.".to_string())
    let path = PathBuf__from(trimmed)
    if !path.exists() or !path.is_file():
        return Result::Err(format!("Input video does not exist: {}", path.display()))
    Result::Ok(path)

fn resolve_video_ffmpeg_binary() -> String:
    resolve_video_binary_from_env(&["GREEBLEFS_VIDEO_FFMPEG_BINARY", "GREEBLEFS_FFMPEG_BINARY", "FFMPEG_BIN"], DEFAULT_VIDEO_FFMPEG_BINARY)

fn resolve_video_ffprobe_binary() -> String:
    resolve_video_binary_from_env(&["GREEBLEFS_VIDEO_FFPROBE_BINARY", "GREEBLEFS_FFPROBE_BINARY", "FFPROBE_BIN"], DEFAULT_VIDEO_FFPROBE_BINARY)

fn resolve_video_binary_from_env(keys: &Slice<String>, fallback: String) -> String:
    keys.iter().find_map(|key| std__env__var_(key).ok()).map(|value| value.trim().to_string()).filter(|value| !value.is_empty()).unwrap_or_else(|| fallback.to_string())

fn sanitize_video_runtime_stem(value: String) -> String:
    let sanitized: String = value.chars().map(
        |character| if character.is_ascii_alphanumeric() or character == "-" or character == "_":
            character
        else:
            "-"
    ).collect()
    let collapsed = sanitized.trim_matches("-")
    if collapsed.is_empty():
        "video".to_string()
    else:
        collapsed.to_string()

fn resolve_video_runtime_root(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    app.path().app_local_data_dir().map(|path| path.join(VIDEO_ENGINE_RUNTIME_DIR)).map_err(|error| format!("Failed to resolve app local data directory: {error}"))

fn prepare_video_source(input_path: &std::path::Path) -> Result<PreparedVideoSource, String>:
    let metadata = probe_video_metadata(input_path)?
    Result::Ok(PreparedVideoSource { input_path: input_path.to_path_buf(), loaded_name: input_path.file_name().and_then(|value| value.to_str()).unwrap_or("video").to_string(), duration_seconds: metadata.duration_seconds, width_px: metadata.width_px, height_px: metadata.height_px, frame_rate: metadata.frame_rate, has_audio_track: metadata.has_audio_track })

fn probe_video_metadata(input_path: &std::path::Path) -> Result<ProbedVideoMetadata, String>:
    let ffprobe_binary = resolve_video_ffprobe_binary()
    let output = Command__new_(&ffprobe_binary).args(["-v", "error", "-show_streams", "-show_format", "-print_format", "json", &input_path.to_string_lossy()]).output().map_err(|error| format!("Failed to launch ffprobe at '{ffprobe_binary}': {error}"))?
    if !output.status.success():
        let stderr = String__from_utf8_lossy(&output.stderr).trim().to_string()
        let stdout = String__from_utf8_lossy(&output.stdout).trim().to_string()
        let message = if !stderr.is_empty():
            stderr
        else if !stdout.is_empty():
            stdout
        else:
            format!("ffprobe exited with status {}", output.status)
        return Result::Err(format!("Video metadata probe failed: {message}"))
    let response: FfprobeResponse = serde_json__from_slice(&output.stdout).map_err(|error| format!("Failed to parse ffprobe JSON metadata: {error}"))?
    let video_stream = response.streams.iter().find(|stream| stream.codec_type == Option::Some("video")).ok_or_else(|| "No video stream was found in the selected file.".to_string())?
    let width_px = video_stream.width.ok_or_else(|| "Video width was missing from ffprobe metadata.".to_string())?
    let height_px = video_stream.height.ok_or_else(|| "Video height was missing from ffprobe metadata.".to_string())?
    let duration_seconds = response.format.and_then(|format| format.duration).and_then(parse_ffprobe_duration_seconds).filter(|value| *value > 0.0).ok_or_else(|| "Video duration was missing from ffprobe metadata.".to_string())?
    Result::Ok(ProbedVideoMetadata { duration_seconds: duration_seconds, width_px: width_px, height_px: height_px, frame_rate: video_stream.avg_frame_rate.and_then(parse_ffprobe_frame_rate), has_audio_track: response.streams.iter().any(|stream| stream.codec_type == Option::Some("audio")) })

fn resolve_video_audio_transport_status(audio_load_result: &Result<AudioEngineStateSnapshot, String>, input_path: &std::path::Path, has_audio_track: Bool) -> (Bool, Option<String>):
    if !has_audio_track:
        return (false, none)
    match audio_load_result:
        Ok(snapshot) =>
            let input_path_string = input_path.to_string_lossy()
            let maybe_video_deck = snapshot.decks.iter().find(|deck| deck.deck_id == VIDEO_AUDIO_DECK_ID)
            let Some(video_deck) = maybe_video_deck
            let deck_loaded_matches = video_deck.loaded_path == Option::Some(input_path_string)
            if deck_loaded_matches and video_deck.error.is_none():
                return (true, none)
            let error_message = video_deck.error.clone().unwrap_or_else(|| "Native soundtrack preview could not load this video's audio track. Silent timing fallback is active.".to_string())
            (false, Option::Some(error_message))
        Err(error) => (false, Option::Some(format!("Native soundtrack preview failed to start: {error}")))

fn parse_ffprobe_duration_seconds(value: String) -> Option<f64>:
    let trimmed = value.trim()
    if trimmed.is_empty():
        return none
    trimmed.parse().ok().filter(|seconds| seconds.is_finite())

fn parse_ffprobe_frame_rate(value: String) -> Option<f64>:
    let trimmed = value.trim()
    if trimmed.is_empty() or trimmed == "0/0":
        return none
    match trimmed.split_once("/"):
        Some((numerator, denominator)) =>
            let numerator = numerator.trim().parse().ok()?
            let denominator = denominator.trim().parse().ok()?
            if !numerator.is_finite() or !denominator.is_finite() or denominator.abs() < f64__EPSILON:
                return none
            let rate = numerator / denominator
            return rate.is_finite().then_some(rate)
        _ =>
            ()
            ()
    trimmed.parse().ok().filter(|rate| rate.is_finite())

fn clamp_loop_region(duration_seconds: f64, start_seconds: f64, end_seconds: f64) -> Result<(f64, f64), String>:
    if !start_seconds.is_finite() or !end_seconds.is_finite():
        return Result::Err("Loop points must be finite numbers.".to_string())
    if start_seconds < 0.0:
        return Result::Err("Loop start cannot be negative.".to_string())
    if end_seconds <= start_seconds:
        return Result::Err("Loop end must be greater than loop start.".to_string())
    let bounded_start = start_seconds.clamp(0.0, duration_seconds.max(0.0))
    let bounded_end = end_seconds.clamp(bounded_start + MINIMUM_VIDEO_LOOP_DURATION_SECONDS, duration_seconds.max(bounded_start + MINIMUM_VIDEO_LOOP_DURATION_SECONDS))
    Result::Ok((bounded_start, bounded_end))

fn video_engine_prepare(app: tauri::AppHandle) -> Result<VideoEngineStateSnapshot, String>:
    let shared_ = ensure_video_engine_shared(&app)?
    let mut state = shared_.state.lock().map_err(|_| "Video engine state lock was poisoned.".to_string())?
    state.ready = true
    ()
    ()
    ()
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn video_engine_get_state(app: tauri::AppHandle) -> Result<VideoEngineStateSnapshot, String>:
    Result::Ok(existing_video_engine_shared(&app).map(|shared| shared_.snapshot()).unwrap_or_else(|| build_snapshot(&VideoEngineMutableState__default_())))

fn video_engine_load_source(app: tauri::AppHandle, request: VideoEngineLoadSourceRequest) -> Result<VideoEngineStateSnapshot, String>:
    let shared_ = ensure_video_engine_shared(&app)?
    let input_path = validate_video_source_path(&request.input_path)?
    let generation = block:
        let mut state = shared_.state.lock().map_err(|_| "Video engine state lock was poisoned.".to_string())?
        state.loaded_generation = state.loaded_generation.saturating_add(1)
        ()
        state.ready = true
        ()
        state.engine_error = none
        ()
        state.loaded_path = Option::Some(input_path.to_string_lossy().to_string())
        ()
        state.loaded_name = input_path.file_name().and_then(|value| value.to_str()).map(ToOwned__to_owned)
        ()
        state.duration_seconds = 0.0
        ()
        state.width_px = none
        ()
        state.height_px = none
        ()
        state.frame_rate = none
        ()
        state.has_audio_track = false
        ()
        state.current_time_seconds = 0.0
        ()
        state.is_playing = false
        ()
        state.is_loading = true
        ()
        state.loop_region = VideoEngineLoopRegion { start_seconds: 0.0, end_seconds: 0.0, enabled: false }
        ()
        state.audio_transport_ready = false
        ()
        state.audio_transport_error = none
        ()
        state.silent_playback_started_at = none
        ()
        state.silent_playback_started_time_seconds = 0.0
        ()
        state.loaded_generation
    shared_.emit_state()
    ()
    let input_path_for_prepare = input_path.clone()
    let prepared_source = ((await tauri__async_runtime__spawn_blocking(|| prepare_video_source(&input_path_for_prepare))).map_err(|error| format!("Video source preparation task failed to join: {error}"))?)?
    let audio_transport_result = if prepared_source.has_audio_track:
        Option::Some(await audio_engine__audio_engine_load_deck(app.clone(), AudioEngineLoadDeckRequest { deck_id: VIDEO_AUDIO_DECK_ID, input_path: prepared_source.input_path.to_string_lossy().to_string() }))
    else:
        none
    let (audio_transport_ready, audio_transport_error) = audio_transport_result.map(|result| resolve_video_audio_transport_status(result, prepared_source.input_path.as_path(), prepared_source.has_audio_track)).unwrap_or((false, none))
    let snapshot = block:
        let mut state = shared_.state.lock().map_err(|_| "Video engine state lock was poisoned.".to_string())?
        if state.loaded_generation != generation:
            return Result::Ok(build_snapshot(&state))
        state.ready = true
        ()
        state.engine_error = none
        ()
        state.loaded_path = Option::Some(prepared_source.input_path.to_string_lossy().to_string())
        ()
        state.loaded_name = Option::Some(prepared_source.loaded_name)
        ()
        state.duration_seconds = prepared_source.duration_seconds
        ()
        state.width_px = Option::Some(prepared_source.width_px)
        ()
        state.height_px = Option::Some(prepared_source.height_px)
        ()
        state.frame_rate = prepared_source.frame_rate
        ()
        state.has_audio_track = prepared_source.has_audio_track
        ()
        state.current_time_seconds = 0.0
        ()
        state.is_playing = false
        ()
        state.is_loading = false
        ()
        state.loop_region = VideoEngineLoopRegion { start_seconds: 0.0, end_seconds: prepared_source.duration_seconds, enabled: false }
        ()
        state.audio_transport_ready = audio_transport_ready
        ()
        state.audio_transport_error = audio_transport_error
        ()
        build_snapshot(&state)
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn video_engine_play(app: tauri::AppHandle) -> Result<VideoEngineStateSnapshot, String>:
    let shared_ = ensure_video_engine_shared(&app)?
    let mut state = shared_.state.lock().map_err(|_| "Video engine state lock was poisoned.".to_string())?
    if state.loaded_path.is_none():
        return Result::Err("Load a video before starting playback.".to_string())
    state.is_playing = true
    ()
    state.ready = true
    ()
    state.silent_playback_started_at = Option::Some(Instant__now())
    ()
    state.silent_playback_started_time_seconds = state.current_time_seconds
    ()
    if state.audio_transport_ready:
        audio_engine__audio_engine_seek(app.clone(), AudioEngineSeekRequest { deck_id: VIDEO_AUDIO_DECK_ID, position_seconds: state.current_time_seconds })?
        ()
        audio_engine__audio_engine_set_loop_region(app.clone(), AudioEngineLoopRegionRequest { deck_id: VIDEO_AUDIO_DECK_ID, start_seconds: state.loop_region.start_seconds, end_seconds: state.loop_region.end_seconds, enabled: state.loop_region.enabled })?
        ()
        audio_engine__audio_engine_play(app.clone(), AudioEngineDeckRequest { deck_id: VIDEO_AUDIO_DECK_ID })?
        ()
        ()
        ()
        ()
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn video_engine_pause(app: tauri::AppHandle) -> Result<VideoEngineStateSnapshot, String>:
    let shared_ = ensure_video_engine_shared(&app)?
    let mut state = shared_.state.lock().map_err(|_| "Video engine state lock was poisoned.".to_string())?
    state.is_playing = false
    ()
    state.silent_playback_started_at = none
    ()
    if state.audio_transport_ready:
        audio_engine__audio_engine_pause(app.clone(), AudioEngineDeckRequest { deck_id: VIDEO_AUDIO_DECK_ID })?
        ()
        ()
        ()
        ()
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn video_engine_stop(app: tauri::AppHandle) -> Result<VideoEngineStateSnapshot, String>:
    let shared_ = ensure_video_engine_shared(&app)?
    let mut state = shared_.state.lock().map_err(|_| "Video engine state lock was poisoned.".to_string())?
    state.is_playing = false
    ()
    state.silent_playback_started_at = none
    ()
    state.current_time_seconds = if state.loop_region.enabled:
        state.loop_region.start_seconds
    else:
        0.0
    ()
    if state.audio_transport_ready:
        audio_engine__audio_engine_stop(app.clone(), AudioEngineDeckRequest { deck_id: VIDEO_AUDIO_DECK_ID })?
        ()
        ()
        ()
        ()
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn video_engine_seek(app: tauri::AppHandle, request: VideoEngineSeekRequest) -> Result<VideoEngineStateSnapshot, String>:
    let shared_ = ensure_video_engine_shared(&app)?
    let mut state = shared_.state.lock().map_err(|_| "Video engine state lock was poisoned.".to_string())?
    if state.loaded_path.is_none():
        return Result::Err("Load a video before seeking.".to_string())
    state.current_time_seconds = clamp_video_position(request.position_seconds, state.duration_seconds)
    ()
    state.silent_playback_started_at = if state.is_playing:
        Option::Some(Instant__now())
    else:
        none
    ()
    state.silent_playback_started_time_seconds = state.current_time_seconds
    ()
    if state.audio_transport_ready:
        audio_engine__audio_engine_seek(app.clone(), AudioEngineSeekRequest { deck_id: VIDEO_AUDIO_DECK_ID, position_seconds: state.current_time_seconds })?
        ()
        ()
        ()
        ()
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn video_engine_set_loop_region(app: tauri::AppHandle, request: VideoEngineLoopRegionRequest) -> Result<VideoEngineStateSnapshot, String>:
    let shared_ = ensure_video_engine_shared(&app)?
    let mut state = shared_.state.lock().map_err(|_| "Video engine state lock was poisoned.".to_string())?
    if state.loaded_path.is_none():
        return Result::Err("Load a video before setting a loop region.".to_string())
    let (start_seconds, end_seconds) = clamp_loop_region(state.duration_seconds, request.start_seconds, request.end_seconds)?
    state.loop_region = VideoEngineLoopRegion { start_seconds: start_seconds, end_seconds: end_seconds, enabled: request.enabled }
    ()
    if request.enabled and state.current_time_seconds >= end_seconds:
        state.current_time_seconds = start_seconds
        ()
        ()
        ()
        ()
    state.silent_playback_started_at = if state.is_playing:
        Option::Some(Instant__now())
    else:
        none
    ()
    state.silent_playback_started_time_seconds = state.current_time_seconds
    ()
    if state.audio_transport_ready:
        audio_engine__audio_engine_set_loop_region(app.clone(), AudioEngineLoopRegionRequest { deck_id: VIDEO_AUDIO_DECK_ID, start_seconds: start_seconds, end_seconds: end_seconds, enabled: request.enabled })?
        ()
        ()
        ()
        ()
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

enum DriveClassification:
    System
    Home
    External
    Network
    Optical
    Virtual
    Unknown

struct DriveInfo:
    id: String
    path: String
    label: String
    total_bytes: u64
    free_bytes: u64
    classification: DriveClassification
    volume_id: String
    file_system_type: Option<String>
    is_removable: Bool
    is_network: Bool
    is_read_only: Bool
    supports_scan: Bool

struct LinuxMountInfo:
    mount_id: u64
    parent_id: u64
    major: u32
    minor: u32
    source: String
    mount_point: std::path::PathBuf
    file_system_type: String
    mount_options: Array<String>
    super_options: Array<String>

struct LinuxUDisksMetadata:
    file_system_type: Option<String>
    label: Option<String>
    is_read_only: Option<Bool>
    is_removable: Option<Bool>
    hint_system: Option<Bool>

impl Default for LinuxUDisksMetadata:
    fn default_() -> LinuxUDisksMetadata:
        LinuxUDisksMetadata { file_system_type: none, label: none, is_read_only: none, is_removable: none, hint_system: none }


struct MacDiskInfoMetadata:
    volume_name: Option<String>
    file_system_type: Option<String>
    read_only: Option<Bool>
    removable: Option<Bool>
    ejectable: Option<Bool>
    internal: Option<Bool>
    protocol: Option<String>

impl Default for MacDiskInfoMetadata:
    fn default_() -> MacDiskInfoMetadata:
        MacDiskInfoMetadata { volume_name: none, file_system_type: none, read_only: none, removable: none, ejectable: none, internal: none, protocol: none }


fn list_local_volumes() -> Result<Array<DriveInfo>, String>:
    return list_windows_volumes()
    return list_linux_volumes()
    return list_macos_volumes()
    Result::Ok(vec!(fallback_root_drive_info()))

fn is_same_volume(root: &std::path::Path, candidate: &std::path::Path) -> Bool:
    return unix_device_id(root).zip(unix_device_id(candidate)).is_some_and(|__kain_closure_arg0| __kain_closure_arg0.__kain_tuple_0 == __kain_closure_arg0.__kain_tuple_1)
    return windows_volume_root(root).zip(windows_volume_root(candidate)).is_some_and(|__kain_closure_arg1| __kain_closure_arg1.__kain_tuple_0.eq_ignore_ascii_case(&__kain_closure_arg1.__kain_tuple_1))
    root == candidate

fn unix_drive_capacity(path: &std::path::Path) -> (u64, u64):
    let Ok(path_bytes) = CString__new_(path.as_os_str().as_bytes())
    let mut stats = std__mem__zeroed()
    let status = libc__statvfs(path_bytes.as_ptr(), &mut stats)
    if status != 0:
        return (0, 0)
    let block_size = stats.f_bsize as u64
    let total_bytes = (stats.f_blocks as u64).saturating_mul(block_size)
    let free_bytes = (stats.f_bavail as u64).saturating_mul(block_size)
    (total_bytes, free_bytes)

fn unix_device_id(path: &std::path::Path) -> Option<u64>:
    std__fs__metadata(path).ok().map(|metadata| metadata.dev())

fn list_linux_volumes() -> Result<Array<DriveInfo>, String>:
    let mountinfo = std__fs__read_to_string("/proc/self/mountinfo").map_err(|error| format!("Failed to read /proc/self/mountinfo: {error}"))?
    let mounts = parse_linux_mountinfo(&mountinfo)
    let home_dir = dirs__home_dir()
    let home_dir_path = home_dir
    let mut seen_paths = HashSet__new_()
    let mut drives = Vec__new_()
    for mount in mounts:
        let mount_path_string = mount.mount_point.to_string_lossy().to_string()
        if mount_path_string.is_empty() or !mount.mount_point.is_dir():
            continue
        let is_root = mount.mount_point == Path__new_("/")
        let is_home_mount = home_dir_path.is_some_and(|home| home == mount.mount_point)
        if !is_root and !is_home_mount and !should_surface_linux_mount(&mount):
            continue
        if !seen_paths.insert(mount_path_string.clone()):
            continue
        drives.push(build_linux_drive_info(&mount, home_dir_path))
        ()
    ()
    match home_dir_path:
        Some(home) =>
            if home.is_dir():
                let home_path = home.to_string_lossy().to_string()
                if seen_paths.insert(home_path.clone()):
                    drives.push(build_unix_home_alias(home))
                    ()
                    ()
                    ()
                    ()
                ()
            ()
        _ =>
            ()
            ()
    sort_drive_infos(&mut drives)
    ()
    Result::Ok(drives)

fn build_linux_drive_info(mount: &LinuxMountInfo, home_dir: Option<&std::path::Path>) -> DriveInfo:
    let metadata = linux_query_udisks_metadata(&(*mount).source)
    let mount_path = (*mount).mount_point.to_string_lossy().to_string()
    let volume_id = format!("linux:{}:{}", (*mount).major, (*mount).minor)
    let is_network = linux_is_network_filesystem(&(*mount).file_system_type) or linux_is_network_source(&(*mount).source)
    let is_optical = linux_is_optical_mount(mount)
    let removable_hint = metadata.and_then(|value| value.is_removable).or_else(|| linux_sysfs_removable_flag(&(*mount).source)).unwrap_or(false)
    let is_removable = removable_hint or (!is_network and mount_path != "/" and is_external_mount_path(&(*mount).mount_point))
    let is_read_only = metadata.and_then(|value| value.is_read_only).unwrap_or_else(|| (*mount).mount_options.iter().any(|option| option == "ro"))
    let file_system_type = metadata.and_then(|value| value.file_system_type.clone()).or_else(|| Option::Some((*mount).file_system_type.clone()))
    let classification = if home_dir.is_some_and(|home| home == (*mount).mount_point):
        DriveClassification::Home
    else if is_network:
        DriveClassification::Network
    else if is_optical:
        DriveClassification::Optical
    else if is_removable or is_external_mount_path(&(*mount).mount_point):
        DriveClassification::External
    else if mount_path == "/" or (*mount).source.starts_with("/dev/"):
        DriveClassification::System
    else if metadata.and_then(|value| value.hint_system) == Option::Some(false):
        DriveClassification::External
    else:
        DriveClassification::Virtual
    let label = if mount_path == "/":
        "Root".to_string()
    else if home_dir.is_some_and(|home| home == (*mount).mount_point):
        "Home".to_string()
    else:
        metadata.and_then(|value| value.label.clone()).or_else(|| (*mount).mount_point.file_name().and_then(OsStr__to_str).map(|value| value.to_string())).filter(|value| !value.trim().is_empty()).unwrap_or_else(|| mount_path.clone())
    let (total_bytes, free_bytes) = unix_drive_capacity(&(*mount).mount_point)
    DriveInfo { id: format!("local:{volume_id}:{mount_path}"), path: mount_path, label: label, total_bytes: total_bytes, free_bytes: free_bytes, classification: classification, volume_id: volume_id, file_system_type: file_system_type, is_removable: is_removable, is_network: is_network, is_read_only: is_read_only, supports_scan: (*mount).mount_point.is_dir() }

fn should_surface_linux_mount(mount: &LinuxMountInfo) -> Bool:
    let mount_path = (*mount).mount_point.to_string_lossy()
    if mount_path.starts_with("/proc") or mount_path.starts_with("/sys") or mount_path.starts_with("/dev") or mount_path.starts_with("/run/user") or mount_path.starts_with("/snap"):
        return false
    if linux_is_pseudo_filesystem(&(*mount).file_system_type):
        return false
    if linux_is_network_filesystem(&(*mount).file_system_type) or linux_is_network_source(&(*mount).source):
        return true
    if is_external_mount_path(&(*mount).mount_point):
        return true
    (*mount).source.starts_with("/dev/")

fn linux_is_pseudo_filesystem(file_system_type: String) -> Bool:
    matches!(file_system_type, "autofs" | "bpf" | "cgroup" | "cgroup2" | "configfs" | "debugfs" | "devpts" | "devtmpfs" | "efivarfs" | "fusectl" | "hugetlbfs" | "mqueue" | "overlay" | "proc" | "pstore" | "ramfs" | "securityfs" | "selinuxfs" | "squashfs" | "sysfs" | "tmpfs" | "tracefs")

fn linux_is_network_filesystem(file_system_type: String) -> Bool:
    matches!(file_system_type, "9p" | "afpfs" | "cifs" | "davfs" | "davfs2" | "fuse.rclone" | "fuse.sshfs" | "gvfsd-fuse" | "nfs" | "nfs4" | "smb3" | "smbfs" | "sshfs" | "webdav")

fn linux_is_network_source(source: String) -> Bool:
    source.starts_with("//") or source.starts_with("\\\\") or source.contains(":/") or source.starts_with("smb://") or source.starts_with("afp://") or source.starts_with("dav://") or source.starts_with("sshfs#")

fn linux_is_optical_mount(mount: &LinuxMountInfo) -> Bool:
    (*mount).file_system_type == "iso9660" or (*mount).file_system_type == "udf" or (*mount).source.starts_with("/dev/sr") or (*mount).source.starts_with("/dev/cd")

fn linux_sysfs_removable_flag(device_path: String) -> Option<Bool>:
    let block_device_name = linux_block_device_name(device_path)?
    let sysfs_path = Path__new_("/sys/block").join(block_device_name).join("removable")
    match (std__fs__read_to_string(sysfs_path).ok()?).trim():
        "0" => Option::Some(false)
        "1" => Option::Some(true)
        _ => none

fn linux_block_device_name(device_path: String) -> Option<String>:
    let name = device_path.strip_prefix("/dev/")?
    if name.starts_with("mapper/"):
        return none
    let trimmed = match name.strip_prefix("nvme"):
        Some(value) =>
            let suffix = value.rsplit_once("p")?
            format!("nvme{}", suffix.field_0)
        _ =>
            match name.strip_prefix("mmcblk"):
                Some(value) =>
                    let suffix = value.rsplit_once("p")?
                    format!("mmcblk{}", suffix.field_0)
                _ =>
                    name.trim_end_matches(char__is_numeric).to_string()
    if trimmed.is_empty():
        none
    else:
        Option::Some(trimmed)

fn linux_query_udisks_metadata(device_path: String) -> Option<LinuxUDisksMetadata>:
    if !device_path.starts_with("/dev/"):
        return none
    let output = Command__new_("udisksctl").args(["info", "-b", device_path]).output().ok()?
    if !output.status.success():
        return none
    let stdout = String__from_utf8(output.stdout).ok()?
    let mut metadata = LinuxUDisksMetadata__default_()
    for line_ in stdout.lines():
        let trimmed = line_.trim()
        let Some((key, value)) = trimmed.split_once(":")
        let key = key.trim()
        let value = value.trim()
        match key:
            "IdLabel" =>
                if !value.is_empty():
                    metadata.label = Option::Some(value.to_string())
                    ()
            "IdType" =>
                if !value.is_empty():
                    metadata.file_system_type = Option::Some(value.to_string())
                    ()
            "ReadOnly" => metadata.is_read_only = parse_bool_token(value)
            "HintSystem" => metadata.hint_system = parse_bool_token(value)
            "Drive.Removable" | "Drive.MediaRemovable" =>
                metadata.is_removable = parse_bool_token(value).or_(metadata.is_removable)
                ()
            _ =>
                ()
    ()
    Option::Some(metadata)

fn parse_linux_mountinfo(contents: String) -> Array<LinuxMountInfo>:
    contents.lines().filter_map(parse_linux_mountinfo_line).collect()

fn parse_linux_mountinfo_line(line: String) -> Option<LinuxMountInfo>:
    let (left, right) = line_.split_once(" - ")?
    let left_parts = left.split_whitespace().collect()
    if left_parts.len() < 6:
        return none
    let right_parts = right.split_whitespace().collect()
    if right_parts.len() < 3:
        return none
    let (major, minor) = left_parts[2].split_once(":")?
    let mount_id = left_parts[0].parse().ok()?
    let parent_id = left_parts[1].parse().ok()?
    let major = major.parse().ok()?
    let minor = minor.parse().ok()?
    let mount_point = PathBuf__from(unmangle_mount_escape(left_parts[4]))
    let mount_options = left_parts[5].split(",").map(str__to_string).collect()
    let file_system_type = unmangle_mount_escape(right_parts[0])
    let source = unmangle_mount_escape(right_parts[1])
    let super_options = right_parts[2].split(",").map(str__to_string).collect()
    Option::Some(LinuxMountInfo { mount_id: mount_id, parent_id: parent_id, major: major, minor: minor, source: source, mount_point: mount_point, file_system_type: file_system_type, mount_options: mount_options, super_options: super_options })

fn unmangle_mount_escape(value: String) -> String:
    value.replace("\\011", "\t").replace("\\012", "\n").replace("\\040", " ").replace("\\043", "#").replace("\\134", "\\")

fn list_macos_volumes() -> Result<Array<DriveInfo>, String>:
    let mut mounts_ptr: PtrMut<libc::statfs> = std__ptr__null_mut()
    let mount_count = libc__getmntinfo(&mut mounts_ptr, libc__MNT_NOWAIT)
    if mount_count <= 0:
        return Result::Ok(vec!(fallback_root_drive_info()))
    let home_dir = dirs__home_dir()
    let home_dir_path = home_dir
    let mut seen_paths = HashSet__new_()
    let mut drives = Vec__new_()
    for index in 0..mount_count as usize:
        let mount = &*mounts_ptr.add(index)
        let mount_path = CStr__from_ptr(mount.f_mntonname.as_ptr()).to_string_lossy().to_string()
        if mount_path.is_empty():
            continue
        let source = CStr__from_ptr(mount.f_mntfromname.as_ptr()).to_string_lossy().to_string()
        let file_system_type = CStr__from_ptr(mount.f_fstypename.as_ptr()).to_string_lossy().to_string()
        let mount_path_buf = PathBuf__from(&mount_path)
        if !mount_path_buf.is_dir():
            continue
        let is_root = mount_path == "/"
        let is_home_mount = home_dir_path.is_some_and(|home| home == mount_path_buf)
        let is_network = macos_is_network_filesystem(&file_system_type) or source.starts_with("//")
        let is_surface_candidate = is_root or is_home_mount or is_network or is_external_mount_path(&mount_path_buf)
        if !is_surface_candidate:
            continue
        if !seen_paths.insert(mount_path.clone()):
            continue
        let diskutil = macos_diskutil_info(&mount_path)
        let removable = diskutil.and_then(|value| value.removable.or_(value.ejectable)).unwrap_or_else(|| !is_root and !is_home_mount and !is_network and mount_path.starts_with("/Volumes/"))
        let read_only = diskutil.and_then(|value| value.read_only).unwrap_or_else(|| (mount.f_flags & libc__MNT_RDONLY) != 0)
        let classification = if is_home_mount:
            DriveClassification::Home
        else if is_network:
            DriveClassification::Network
        else if removable:
            DriveClassification::External
        else if is_root:
            DriveClassification::System
        else:
            DriveClassification::Unknown
        let label = if is_root:
            "Root".to_string()
        else if is_home_mount:
            "Home".to_string()
        else:
            diskutil.and_then(|value| value.volume_name.clone()).or_else(|| mount_path_buf.file_name().and_then(OsStr__to_str).map(str__to_string)).unwrap_or_else(|| mount_path.clone())
        let (total_bytes, free_bytes) = unix_drive_capacity(&mount_path_buf)
        let volume_id = unix_device_id(&mount_path_buf).map(|value| format!("macos:{value}")).unwrap_or_else(|| format!("macos:{source}:{mount_path}"))
        drives.push(DriveInfo { id: format!("local:{volume_id}:{mount_path}"), path: mount_path, label: label, total_bytes: total_bytes, free_bytes: free_bytes, classification: classification, volume_id: volume_id, file_system_type: diskutil.and_then(|value| value.file_system_type.clone()).or_else(|| Option::Some(file_system_type)), is_removable: removable, is_network: is_network, is_read_only: read_only, supports_scan: true })
        ()
    ()
    match home_dir_path:
        Some(home) =>
            if home.is_dir():
                let home_path = home.to_string_lossy().to_string()
                if seen_paths.insert(home_path.clone()):
                    drives.push(build_unix_home_alias(home))
                    ()
                    ()
                    ()
                    ()
                ()
            ()
        _ =>
            ()
            ()
    if drives.is_empty():
        drives.push(fallback_root_drive_info())
        ()
        ()
        ()
        ()
    sort_drive_infos(&mut drives)
    ()
    Result::Ok(drives)

fn macos_is_network_filesystem(file_system_type: String) -> Bool:
    matches!(file_system_type, "afpfs" | "nfs" | "smbfs" | "webdav")

fn macos_diskutil_info(mount_path: String) -> Option<MacDiskInfoMetadata>:
    let output = Command__new_("diskutil").args(["info", mount_path]).output().ok()?
    if !output.status.success():
        return none
    let stdout = String__from_utf8(output.stdout).ok()?
    let mut metadata = MacDiskInfoMetadata__default_()
    for line_ in stdout.lines():
        let Some((key, value)) = line_.split_once(":")
        let key = key.trim()
        let value = value.trim()
        match key:
            "Volume Name" =>
                if !value.is_empty():
                    metadata.volume_name = Option::Some(value.to_string())
                    ()
            "File System Personality" =>
                if !value.is_empty():
                    metadata.file_system_type = Option::Some(value.to_string())
                    ()
            "Read-Only Media" => metadata.read_only = parse_bool_token(value)
            "Removable Media" => metadata.removable = parse_bool_token(value)
            "Ejectable" => metadata.ejectable = parse_bool_token(value)
            "Device Location" => metadata.internal = parse_internal_token(value)
            "Protocol" =>
                if !value.is_empty():
                    metadata.protocol = Option::Some(value.to_string())
                    ()
            _ =>
                ()
    ()
    Option::Some(metadata)

fn list_windows_volumes() -> Result<Array<DriveInfo>, String>:
    let mut buffer = vec!()
    let length = windows_sys::Win32::Storage::FileSystem::GetLogicalDriveStringsW(buffer.len() as u32, buffer.as_mut_ptr())
    if length == 0:
        return Result::Err("Failed to enumerate Windows volumes.".to_string())
    let mut drives = Vec__new_()
    let mut start = 0
    for index in 0..length as usize:
        if buffer[index] != 0:
            continue
        if index <= start:
            start = index + 1
            ()
            continue
        let drive_string = OsString__from_wide(&buffer[start..index]).to_string_lossy().to_string()
        start = index + 1
        ()
        if drive_string.is_empty():
            continue
        let drive_root = drive_string
        let drive_path = drive_root.trim_end_matches("\\").to_string()
        let drive_wide = drive_root.encode_utf16().chain(std__iter__once(0)).collect()
        let mut total_bytes = 0
        let mut free_bytes = 0
        windows_sys::Win32::Storage::FileSystem::GetDiskFreeSpaceExW(drive_wide.as_ptr(), std__ptr__null_mut(), &mut total_bytes, &mut free_bytes)
        ()
        ()
        ()
        ()
        let mut volume_name_buffer = vec!()
        let mut file_system_buffer = vec!()
        let mut volume_serial_number = 0
        let mut file_system_flags = 0
        windows_sys::Win32::Storage::FileSystem::GetVolumeInformationW(drive_wide.as_ptr(), volume_name_buffer.as_mut_ptr(), volume_name_buffer.len() as u32, &mut volume_serial_number, std__ptr__null_mut(), &mut file_system_flags, file_system_buffer.as_mut_ptr(), file_system_buffer.len() as u32)
        ()
        ()
        ()
        ()
        let drive_type = windows_sys::Win32::Storage::FileSystem::GetDriveTypeW(drive_wide.as_ptr())
        let classification = match drive_type:
            DRIVE_REMOTE => DriveClassification::Network
            DRIVE_REMOVABLE => DriveClassification::External
            DRIVE_CDROM => DriveClassification::Optical
            DRIVE_FIXED | DRIVE_RAMDISK => DriveClassification::System
            _ => DriveClassification::Unknown
        let label = utf16_buffer_to_string(&volume_name_buffer).filter(|value| !value.is_empty()).unwrap_or_else(|| drive_path.clone())
        let file_system_type = utf16_buffer_to_string(&file_system_buffer).filter(|value| !value.is_empty())
        let volume_id = format!("windows:{volume_serial_number:08X}")
        drives.push(DriveInfo { id: format!("local:{volume_id}:{drive_path}"), path: drive_path.clone(), label: label, total_bytes: total_bytes, free_bytes: free_bytes, classification: classification, volume_id: volume_id, file_system_type: file_system_type, is_removable: drive_type == DRIVE_REMOVABLE or drive_type == DRIVE_CDROM, is_network: drive_type == DRIVE_REMOTE, is_read_only: (file_system_flags & FILE_READ_ONLY_VOLUME) != 0, supports_scan: true })
        ()
    ()
    sort_drive_infos(&mut drives)
    ()
    Result::Ok(drives)

fn utf16_buffer_to_string(buffer: &Slice<u16>) -> Option<String>:
    let end = buffer.iter().position(|value| *value == 0)?
    Option::Some(OsString__from_wide(&buffer[..end]).to_string_lossy().to_string())

fn windows_volume_root(path: &std::path::Path) -> Option<String>:
    let wide_path = path.as_os_str().encode_wide().chain(std__iter__once(0)).collect()
    let mut buffer = vec!()
    let success = windows_sys::Win32::Storage::FileSystem::GetVolumePathNameW(wide_path.as_ptr(), buffer.as_mut_ptr(), buffer.len() as u32)
    if success == 0:
        return none
    let end = buffer.iter().position(|value| *value == 0)?
    Option::Some(OsString__from_wide(&buffer[..end]).to_string_lossy().to_string())

fn build_unix_home_alias(home_dir: &std::path::Path) -> DriveInfo:
    let (total_bytes, free_bytes) = unix_drive_capacity(home_dir)
    let volume_id = unix_device_id(home_dir).map(|value| format!("unix:{value}")).unwrap_or_else(|| format!("unix:{}", home_dir.to_string_lossy()))
    let path = home_dir.to_string_lossy().to_string()
    DriveInfo { id: format!("local:{volume_id}:{path}"), path: path, label: "Home".to_string(), total_bytes: total_bytes, free_bytes: free_bytes, classification: DriveClassification::Home, volume_id: volume_id, file_system_type: none, is_removable: false, is_network: false, is_read_only: false, supports_scan: home_dir.is_dir() }

fn fallback_root_drive_info() -> DriveInfo:
    DriveInfo { id: "local:fallback:/".to_string(), path: "/".to_string(), label: "Root".to_string(), total_bytes: 0, free_bytes: 0, classification: DriveClassification::System, volume_id: "fallback:/".to_string(), file_system_type: none, is_removable: false, is_network: false, is_read_only: false, supports_scan: true }

fn is_external_mount_path(path: &std::path::Path) -> Bool:
    path.starts_with("/run/media") or path.starts_with("/media") or path.starts_with("/mnt") or path.starts_with("/Volumes")

fn sort_drive_infos(drives: &mut Slice<DriveInfo>):
    drives.sort_by(|left, right| drive_sort_rank(left.classification).cmp(&drive_sort_rank(right.classification)).then_with(|| left.label.to_lowercase().cmp(&right.label.to_lowercase())).then_with(|| left.path.cmp(&right.path)))
    ()

fn drive_sort_rank(classification: DriveClassification) -> u8:
    match classification:
        DriveClassification::Home => 0
        DriveClassification::System => 1
        DriveClassification::External => 2
        DriveClassification::Network => 3
        DriveClassification::Optical => 4
        DriveClassification::Virtual => 5
        DriveClassification::Unknown => 6

fn parse_bool_token(value: String) -> Option<Bool>:
    match value.trim().to_ascii_lowercase().as_str():
        "0" | "false" | "no" | "off" => Option::Some(false)
        "1" | "true" | "yes" | "on" => Option::Some(true)
        _ => none

fn parse_internal_token(value: String) -> Option<Bool>:
    match value.trim().to_ascii_lowercase().as_str():
        "internal" => Option::Some(true)
        "external" => Option::Some(false)
        _ => none

struct VstScanPath:
    path: String
    exists: Bool
    kind: VstScanPathKind

enum VstScanPathKind:
    System
    User
    Custom

struct VstPluginEntry:
    name: String
    path: String
    file_stem: String

fn platform_default_vst3_paths() -> Array<VstScanPath>:
    let mut paths: Array<VstScanPath> = Vec__new_()
    match dirs__home_dir():
        Some(home) =>
            push_path(&mut paths, home.join(".vst3"), VstScanPathKind::User)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    push_path(&mut paths, PathBuf__from("/usr/lib/vst3"), VstScanPathKind::System)
    ()
    push_path(&mut paths, PathBuf__from("/usr/local/lib/vst3"), VstScanPathKind::System)
    ()
    push_path(&mut paths, PathBuf__from("/usr/lib/x86_64-linux-gnu/vst3"), VstScanPathKind::System)
    ()
    ()
    ()
    ()
    match dirs__home_dir():
        Some(home) =>
            push_path(&mut paths, home.join("Library/Audio/Plug-Ins/VST3"), VstScanPathKind::User)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    push_path(&mut paths, PathBuf__from("/Library/Audio/Plug-Ins/VST3"), VstScanPathKind::System)
    ()
    ()
    ()
    ()
    match std__env__var_("COMMONPROGRAMFILES"):
        Ok(common) =>
            push_path(&mut paths, PathBuf__from(&common).join("VST3"), VstScanPathKind::System)
            ()
            ()
            ()
            ()
        _ =>
            push_path(&mut paths, PathBuf__from("C:\\Program Files\\Common Files\\VST3"), VstScanPathKind::System)
            ()
            ()
            ()
            ()
    match std__env__var_("LOCALAPPDATA"):
        Ok(local) =>
            push_path(&mut paths, PathBuf__from(&local).join("Programs\\Common\\VST3"), VstScanPathKind::User)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    ()
    paths

fn push_path(out: &mut Array<VstScanPath>, path: std::path::PathBuf, kind: VstScanPathKind):
    let exists = path.exists()
    out_.push(VstScanPath { path: path.to_string_lossy().to_string(), exists: exists, kind: kind })
    ()

fn scan_dir_for_plugins(dir: &std::path::PathBuf, out: &mut Array<VstPluginEntry>):
    let read = match std__fs__read_dir(dir):
        Ok(r) => r
        Err(_) => return
    for entry in read.flatten():
        let path = entry.path()
        let ext = path.extension().and_then(|e| e.to_str()).unwrap_or("").to_lowercase()
        if ext == "vst3":
            if vst_host__resolve_vst3_module_path(&path).is_err():
                continue
            let file_stem = path.file_stem().map(|s| s.to_string_lossy().to_string()).unwrap_or_else(|| "Unknown".to_string())
            out_.push(VstPluginEntry { name: file_stem.clone(), path: path.to_string_lossy().to_string(), file_stem: file_stem })
            ()
        else if path.is_dir():
            scan_dir_for_plugins(&path, out_)
            ()

fn vst_get_default_scan_paths() -> Array<VstScanPath>:
    platform_default_vst3_paths()

fn vst_scan_plugins(paths: Array<String>) -> Array<VstPluginEntry>:
    let mut out_: Array<VstPluginEntry> = Vec__new_()
    for raw_path in &paths:
        let dir = PathBuf__from(raw_path)
        if dir.exists():
            scan_dir_for_plugins(&dir, &mut out_)
            ()
    ()
    out_.sort_by(|a, b| a.name.to_lowercase().cmp(&b.name.to_lowercase()))
    ()
    out_.dedup_by(|a, b| a.path == b.path)
    ()
    out_

struct VstHostRuntimeManager:
    sessions: Map<String, VstEditorSessionState>

impl Default for VstHostRuntimeManager:
    fn default_() -> VstHostRuntimeManager:
        VstHostRuntimeManager { sessions: HashMap__new_() }


enum VstEditorAttachMode:
    Inline
    Detached
    Unavailable

struct VstEditorHostRect:
    x: f64
    y: f64
    width: f64
    height: f64
    scale_factor: f64

struct VstEditorSessionState:
    session_id: String
    deck_id: AudioDeckId
    plugin_path: String
    attach_mode: VstEditorAttachMode
    status_label: String
    last_rect: Option<VstEditorHostRect>

struct VstEditorSessionCreateRequest:
    deck_id: AudioDeckId
    plugin_path: String

struct VstEditorSessionRectRequest:
    session_id: String
    rect: VstEditorHostRect

fn manager(app: &tauri::AppHandle) -> tauri::State<_, VstHostRuntimeManager>:
    app.state()

fn vst_host_create_editor_session(app: tauri::AppHandle, request: VstEditorSessionCreateRequest) -> Result<VstEditorSessionState, String>:
    let session_id = Uuid__new_v4().to_string()
    let (attach_mode, status_label) = match HeadlessVstHost__load_plugin(&request.plugin_path):
        Ok(host) if host.edit_controller.is_some() => (VstEditorAttachMode::Unavailable, "Plugin editor controller loaded. Native editor attachment is not available in the current host bridge.".to_string())
        Ok(_) => (VstEditorAttachMode::Unavailable, "Plugin loaded, but no editor controller was exposed by this VST3.".to_string())
        Err(error) => (VstEditorAttachMode::Unavailable, format!("Failed to load the plugin into the native host bridge: {error}"))
    let session = VstEditorSessionState { session_id: session_id.clone(), deck_id: request.deck_id, plugin_path: request.plugin_path, attach_mode: attach_mode, status_label: status_label, last_rect: none }
    (manager(&app).sessions.lock().map_err(|_| "VST host runtime session lock was poisoned.".to_string())?).insert(session_id, session.clone())
    ()
    Result::Ok(session)

fn vst_host_update_editor_session_rect(app: tauri::AppHandle, request: VstEditorSessionRectRequest) -> Result<VstEditorSessionState, String>:
    let host_manager = manager(&app)
    let mut sessions = host_manager.sessions.lock().map_err(|_| "VST host runtime session lock was poisoned.".to_string())?
    let session = sessions.get_mut(&request.session_id).ok_or_else(|| "Unknown VST editor session.".to_string())?
    session.last_rect = Option::Some(request.rect.clone())
    ()
    if request.rect.width > 0.0 and request.rect.height > 0.0:
        session.status_label = format!("Host rect synced to {:.0}×{:.0}. Native editor attachment remains unavailable in the current bridge.", request.rect.width, request.rect.height)
        ()
        ()
        ()
        ()
    Result::Ok(session.clone())

fn vst_host_focus_editor_session(app: tauri::AppHandle, session_id: String) -> Result<VstEditorSessionState, String>:
    let host_manager = manager(&app)
    let sessions = host_manager.sessions.lock().map_err(|_| "VST host runtime session lock was poisoned.".to_string())?
    sessions.get(&session_id).cloned().ok_or_else(|| "Unknown VST editor session.".to_string())

fn vst_host_destroy_editor_session(app: tauri::AppHandle, session_id: String) -> Result<(), String>:
    (manager(&app).sessions.lock().map_err(|_| "VST host runtime session lock was poisoned.".to_string())?).remove(&session_id)
    ()
    Result::Ok(())

struct WaylandDockHostStatus:
    enabled: Bool
    window_label: Option<String>

enum WaylandDockAnchor:
    Top
    Bottom

fn wayland_dock_host_status(app: &tauri::AppHandle) -> WaylandDockHostStatus:
    WaylandDockHostStatus { enabled: is_wayland_session() and app.get_webview_window(WAYLAND_DOCK_WINDOW_LABEL).is_some(), window_label: app.get_webview_window(WAYLAND_DOCK_WINDOW_LABEL).map(|_| WAYLAND_DOCK_WINDOW_LABEL.to_string()) }

fn initialize_wayland_dock_host(app: &tauri::AppHandle) -> Result<(), String>:
    if !is_wayland_session() or app.get_webview_window(WAYLAND_DOCK_WINDOW_LABEL).is_some():
        return Result::Ok(())
    let dock_window = WebviewWindowBuilder__new_(app, WAYLAND_DOCK_WINDOW_LABEL, tauri::WebviewUrl::App("index.html".into())).title("GreebleFS Dock").inner_size(WAYLAND_DOCK_DEFAULT_WIDTH as f64, WAYLAND_DOCK_DEFAULT_HEIGHT as f64).visible(false).focused(false).focusable(true).decorations(false).transparent(true).always_on_top(true).skip_taskbar(true).shadow(false).resizable(true).build().map_err(|error| format!("failed to build dock window: {error}"))?
    configure_wayland_dock_window(&dock_window)?
    ()
    dock_window.hide().map_err(|error| error.to_string())?
    ()
    Result::Ok(())

fn initialize_wayland_dock_host(_app: &tauri::AppHandle) -> Result<(), String>:
    Result::Ok(())

fn apply_wayland_dock_layout(window: &tauri::WebviewWindow, anchor: WaylandDockAnchor, monitor_name: Option<String>, width: u32, height: u32) -> Result<(), String>:
    if !is_wayland_session():
        return Result::Err("Wayland dock layout is only available on Linux Wayland".to_string())
    let dock_window = window.clone()
    return run_on_window_main_thread(window, || apply_wayland_dock_layout_on_main_thread(&dock_window, anchor, monitor_name, width, height))?
    let _ = (window, anchor, monitor_name, width, height)
    Result::Err("Wayland dock layout is only available on Linux Wayland".to_string())

fn configure_wayland_dock_window(window: &tauri::WebviewWindow) -> Result<(), String>:
    let dock_window = window.clone()
    run_on_window_main_thread(window, || configure_wayland_dock_window_on_main_thread(&dock_window))?

fn configure_wayland_dock_window_on_main_thread(window: &tauri::WebviewWindow) -> Result<(), String>:
    let gtk_window = window.gtk_window().map_err(|error| error.to_string())?
    gtk_window.init_layer_shell()
    ()
    gtk_window.set_namespace(WAYLAND_DOCK_WINDOW_NAMESPACE)
    ()
    gtk_window.set_layer(gtk_layer_shell::Layer::Top)
    ()
    gtk_window.set_anchor(gtk_layer_shell::Edge::Left, true)
    ()
    gtk_window.set_anchor(gtk_layer_shell::Edge::Right, false)
    ()
    gtk_window.set_anchor(gtk_layer_shell::Edge::Top, false)
    ()
    gtk_window.set_anchor(gtk_layer_shell::Edge::Bottom, true)
    ()
    gtk_window.set_keyboard_mode(gtk_layer_shell::KeyboardMode::OnDemand)
    ()
    gtk_window.set_accept_focus(true)
    ()
    gtk_window.set_decorated(false)
    ()
    gtk_window.set_keep_above(true)
    ()
    gtk_window.set_default_size(WAYLAND_DOCK_DEFAULT_WIDTH, WAYLAND_DOCK_DEFAULT_HEIGHT)
    ()
    gtk_window.resize(WAYLAND_DOCK_DEFAULT_WIDTH, WAYLAND_DOCK_DEFAULT_HEIGHT)
    ()
    gtk_window.set_exclusive_zone(0)
    ()
    gtk_window.set_layer_shell_margin(gtk_layer_shell::Edge::Left, 0)
    ()
    gtk_window.set_layer_shell_margin(gtk_layer_shell::Edge::Right, 0)
    ()
    gtk_window.set_layer_shell_margin(gtk_layer_shell::Edge::Top, 0)
    ()
    gtk_window.set_layer_shell_margin(gtk_layer_shell::Edge::Bottom, 0)
    ()
    Result::Ok(())

fn apply_wayland_dock_layout_on_main_thread(window: &tauri::WebviewWindow, anchor: WaylandDockAnchor, monitor_name: Option<String>, width: u32, height: u32) -> Result<(), String>:
    let gtk_window = window.gtk_window().map_err(|error| error.to_string())?
    let width = clamp_dimension(width)
    let height = clamp_dimension(height)
    gtk_window.set_anchor(gtk_layer_shell::Edge::Left, true)
    ()
    gtk_window.set_anchor(gtk_layer_shell::Edge::Right, false)
    ()
    gtk_window.set_anchor(gtk_layer_shell::Edge::Top, matches!(anchor, WaylandDockAnchor::Top))
    ()
    gtk_window.set_anchor(gtk_layer_shell::Edge::Bottom, matches!(anchor, WaylandDockAnchor::Bottom))
    ()
    gtk_window.set_keyboard_mode(gtk_layer_shell::KeyboardMode::OnDemand)
    ()
    gtk_window.set_accept_focus(true)
    ()
    gtk_window.set_exclusive_zone(0)
    ()
    gtk_window.set_layer_shell_margin(gtk_layer_shell::Edge::Left, 0)
    ()
    gtk_window.set_layer_shell_margin(gtk_layer_shell::Edge::Right, 0)
    ()
    gtk_window.set_layer_shell_margin(gtk_layer_shell::Edge::Top, 0)
    ()
    gtk_window.set_layer_shell_margin(gtk_layer_shell::Edge::Bottom, 0)
    ()
    gtk_window.set_default_size(width, height)
    ()
    gtk_window.resize(width, height)
    ()
    match resolve_gtk_monitor_by_name(monitor_name):
        Some(monitor) =>
            gtk_window.set_monitor(&monitor)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn resolve_gtk_monitor_by_name(monitor_name: Option<String>) -> Option<gdk::Monitor>:
    let trimmed_name = monitor_name.map(str__trim).filter(|value| !value.is_empty())
    let display = Display__default_()?
    let monitor_count = display.n_monitors()
    let mut first_monitor: Option<gdk::Monitor> = none
    for index in 0..monitor_count:
        let monitor = display.monitor(index)?
        if first_monitor.is_none():
            first_monitor = Option::Some(monitor.clone())
            ()
            ()
            ()
            ()
        let Some(target_name) = trimmed_name
        let model = monitor.model().map(|value| value.to_string())
        let manufacturer = monitor.manufacturer().map(|value| value.to_string())
        let combined = match (manufacturer, model):
            (Some(maker), Some(model_name)) => Option::Some(format!("{maker} {model_name}"))
            _ => none
        let matches_target = [model, manufacturer, combined].into_iter().flatten().any(|candidate| candidate.eq_ignore_ascii_case(target_name))
        if matches_target:
            return Option::Some(monitor)
    ()
    first_monitor

fn clamp_dimension(value: u32) -> i32:
    value.clamp(320, i32__MAX as u32) as i32

fn run_on_window_main_thread(window: &tauri::WebviewWindow, task: F) -> Result<T, String>:
    let (sender, receiver) = std__sync__mpsc__sync_channel(1)
    window.run_on_main_thread(|| let _ = sender.send_(task())).map_err(|error| error.to_string())?
    ()
    receiver.recv().map_err(|error| format!("failed to receive main-thread task result: {error}"))

fn is_wayland_session() -> Bool:
    linux_graphics__current_linux_display_backend() == Option::Some(LinuxDisplayBackend::Wayland)

fn is_wayland_session() -> Bool:
    false

struct TrayVisibilityState:
    requested_visible: Bool

impl TrayVisibilityState:
    fn new_(initial_visible: Bool) -> TrayVisibilityState:
        TrayVisibilityState { requested_visible: Mutex__new_(initial_visible) }

    fn lock_requested_visible(_self: &TrayVisibilityState) -> Result<sync::MutexGuard<_, Bool>, String>:
        (*_self).requested_visible.lock().map_err(|_| "Tray visibility state lock was poisoned".to_string())

    fn claim_visibility_change(_self: &TrayVisibilityState, visible: Bool) -> Result<Bool, String>:
        let mut requested_visible = (*_self).lock_requested_visible()?
        if *requested_visible == visible:
            return Result::Ok(false)
        *requested_visible = visible
        ()
        Result::Ok(true)


struct WindowApplyModeRequest:
    decorations: Bool
    always_on_top: Bool
    shadow: Bool
    skip_taskbar: Bool
    x: i32
    y: i32
    width: u32
    height: u32
    min_width: u32
    min_height: u32
    max_width: u32
    max_height: u32

fn window_apply_mode(app: tauri::AppHandle, window: tauri::WebviewWindow, request: WindowApplyModeRequest) -> Result<(), String>:
    log_optional_window_error(window.set_decorations(request.decorations), "set_decorations")
    ()
    log_optional_window_error(window.set_always_on_top(request.always_on_top), "set_always_on_top")
    ()
    log_optional_window_error(window.set_shadow(request.shadow), "set_shadow")
    ()
    log_optional_window_error(set_native_taskbar_visibility(&app, &window, !request.skip_taskbar), "set_taskbar_visibility")
    ()
    let (min_size, max_size) = normalize_window_size_constraints(request.min_width, request.min_height, request.max_width, request.max_height)
    log_optional_window_error(window.set_min_size(none), "clear_min_size")
    ()
    log_optional_window_error(window.set_max_size(none), "clear_max_size")
    ()
    log_optional_window_error(window.set_max_size(max_size), "set_max_size")
    ()
    log_optional_window_error(window.set_min_size(min_size), "set_min_size")
    ()
    if should_preserve_hidden_wayland_overlay_geometry(&window, request.decorations, request.always_on_top):
        return Result::Ok(())
    if request.width > 0 and request.height > 0:
        window.set_size(PhysicalSize__new_(request.width, request.height)).map_err(|error| format!("window_apply_mode set_size failed: {error}"))?
        ()
        ()
        ()
        ()
    window.set_position(PhysicalPosition__new_(request.x, request.y)).map_err(|error| format!("window_apply_mode set_position failed: {error}"))?
    ()
    Result::Ok(())

fn normalize_window_size_constraints(min_width: u32, min_height: u32, max_width: u32, max_height: u32) -> (Option<tauri::PhysicalSize<u32>>, Option<tauri::PhysicalSize<u32>>):
    let min_size = (min_width > 0 and min_height > 0).then(|| PhysicalSize__new_(min_width, min_height))
    let max_size = (max_width > 0 and max_height > 0).then(
        || block:
            match min_size:
                Some(min_size) =>
                    return PhysicalSize__new_(max_width.max(min_size.width), max_height.max(min_size.height))
                _ =>
                    ()
                    ()
            PhysicalSize__new_(max_width, max_height)
    )
    (min_size, max_size)

fn window_set_blur(window: tauri::WebviewWindow, enabled: Bool, strength: Option<f64>) -> Result<(), String>:
    set_native_blur(&window, enabled, strength)

fn window_set_taskbar_visibility(app: tauri::AppHandle, window: tauri::WebviewWindow, visible: Bool) -> Result<(), String>:
    set_native_taskbar_visibility(&app, &window, visible)

fn tray_set_visible(app: tauri::AppHandle, visible: Bool) -> Result<(), String>:
    let visibility_state = app.try_state()
    match visibility_state:
        Some(state) =>
            if !state.claim_visibility_change(visible)?:
                return Result::Ok(())
            ()
        _ =>
            ()
            ()
    let tray = app.tray_by_id(MAIN_TRAY_ICON_ID).ok_or_else(|| "Main tray icon not found".to_string())?
    tray.set_visible(visible).map_err(|error| error.to_string())?
    ()
    Result::Ok(())

fn window_get_linux_display_server() -> Option<String>:
    linux_graphics__current_linux_display_backend().map(|backend| backend.as_label().to_string())

fn window_get_wayland_dock_host_status(app: tauri::AppHandle) -> WaylandDockHostStatus:
    wayland_dock__wayland_dock_host_status(&app)

fn window_apply_wayland_dock_layout(window: tauri::WebviewWindow, anchor: WaylandDockAnchor, monitor_name: Option<String>, width: u32, height: u32) -> Result<(), String>:
    wayland_dock__apply_wayland_dock_layout(&window, anchor, monitor_name, width, height)

fn set_native_blur(window: &tauri::WebviewWindow, enabled: Bool, strength: Option<f64>) -> Result<(), String>:
    clear_windows_effects(window)
    ()
    if !enabled:
        return Result::Ok(())
    let normalized_strength = normalize_blur_strength(strength)
    let acrylic_alpha = lerp_u8(144, 44, normalized_strength)
    let blur_alpha = lerp_u8(108, 28, normalized_strength)
    window_vibrancy__apply_acrylic(window, Option::Some((18, 18, 18, acrylic_alpha))).or_else(|acrylic_error| window_vibrancy__apply_blur(window, Option::Some((18, 18, 18, blur_alpha))).map_err(|blur_error| format!("Windows acrylic blur failed: {acrylic_error}; Windows blur fallback failed: {blur_error}"))).or_else(|effect_error| window_vibrancy__apply_mica(window, Option::Some(true)).map_err(|mica_error| format!("{effect_error}; Windows mica fallback failed: {mica_error}")))?
    ()
    Result::Ok(())

fn clear_windows_effects(window: &tauri::WebviewWindow):
    let _ = window_vibrancy__clear_acrylic(window)
    let _ = window_vibrancy__clear_blur(window)
    let _ = window_vibrancy__clear_mica(window)

fn set_native_blur(window: &tauri::WebviewWindow, enabled: Bool, _strength: Option<f64>) -> Result<(), String>:
    if enabled:
        window_vibrancy__apply_vibrancy(window, window_vibrancy::NSVisualEffectMaterial::HudWindow, none, Option::Some(18.0)).map_err(|error| error.to_string())?
        ()
        ()
        ()
        ()
    else:
        window_vibrancy__clear_vibrancy(window).map_err(|error| error.to_string())?
        ()
        ()
        ()
        ()
    Result::Ok(())

fn set_native_blur(_window: &tauri::WebviewWindow, _enabled: Bool, _strength: Option<f64>) -> Result<(), String>:
    Result::Ok(())

fn set_native_taskbar_visibility(app: &tauri::AppHandle, _window: &tauri::WebviewWindow, visible: Bool) -> Result<(), String>:
    app.set_dock_visibility(visible).map_err(|error| error.to_string())

fn set_native_taskbar_visibility(_app: &tauri::AppHandle, window: &tauri::WebviewWindow, visible: Bool) -> Result<(), String>:
    window.set_skip_taskbar(!visible).map_err(|error| error.to_string())

fn log_optional_window_error(result: Result<T, E>, operation: String):
    match result:
        Err(error) =>
            eprintln!("OverlayTerm: window_apply_mode {operation} failed: {error}")
        _ => ()

fn detect_linux_display_server() -> Option<String>:
    match linux_graphics__current_linux_display_backend():
        Some(LinuxDisplayBackend::Wayland) => Option::Some("wayland")
        Some(LinuxDisplayBackend::X11) => Option::Some("x11")
        None => none

fn detect_linux_display_server() -> Option<String>:
    none

fn should_preserve_hidden_wayland_overlay_geometry(window: &tauri::WebviewWindow, decorations: Bool, always_on_top: Bool) -> Bool:
    if detect_linux_display_server() != Option::Some("wayland") or decorations or !always_on_top:
        return false
    !window.is_visible().unwrap_or(true)

fn normalize_blur_strength(strength: Option<f64>) -> f64:
    strength.unwrap_or(18.0).clamp(0.0, 32.0) / 32.0

fn lerp_u8(start: u8, end: u8, amount: f64) -> u8:
    (start as f64 + (end as f64 - start as f64) * amount).round().clamp(0.0, 255.0) as u8

