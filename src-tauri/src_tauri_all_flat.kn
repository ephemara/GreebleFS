struct PythonSidecarHandshakePayload:
    manifest_id: String
    module_name: String
    entry_module: String
    transport: String
    available_actions: Array<String>

fn encode_sidecar_payload_json(payload: Option<&T>) -> Result<Option<String>, String>:
    payload.map(|value| serde_json__to_string(value).map_err(|error| format!("Failed to serialize Python sidecar payload: {error}"))).transpose()

fn decode_sidecar_result_json(result_json: String) -> Result<TResult, String>:
    serde_json__from_str(result_json).map_err(|error| format!("Failed to decode Python sidecar result JSON: {error}"))

fn get_sidecar_status(app: &tauri::AppHandle, config: Option<PythonRuntimeConfig>) -> Result<PythonSidecarStatus, String>:
    get_sidecar_status_impl(app, config)

fn start_sidecar(app: &tauri::AppHandle, config: Option<PythonRuntimeConfig>) -> Result<PythonSidecarStartResponse, String>:
    start_sidecar_impl(app, config)

fn stop_sidecar(app: &tauri::AppHandle, config: Option<PythonRuntimeConfig>) -> Result<PythonSidecarStatus, String>:
    stop_sidecar_impl(app, config)

fn call_sidecar_action(app: &tauri::AppHandle, request: PythonSidecarActionRequest) -> Result<PythonSidecarActionResponse, String>:
    call_sidecar_impl(app, request)

fn decode_sidecar_action_result(response: &PythonSidecarActionResponse) -> Result<TResult, String>:
    decode_sidecar_result_json(&(*response).result_json)

fn call_sidecar_action_json(app: &tauri::AppHandle, config: Option<PythonRuntimeConfig>, action_id: impl Into<String>, payload: Option<TPayload>, working_directory: Option<String>, environment: Option<Map<String, String>>, start_if_needed: Option<Bool>) -> Result<PythonSidecarDecodedActionResponse<TResult>, String>:
    call_sidecar_action_json_with_ipc(app, config, action_id, payload, none, none, working_directory, environment, start_if_needed)

fn call_sidecar_action_json_with_ipc(app: &tauri::AppHandle, config: Option<PythonRuntimeConfig>, action_id: impl Into<String>, payload: Option<TPayload>, input_artifacts: Option<Array<greeble_ipc_contracts::IpcArtifactRef>>, resource_handles: Option<Array<greeble_ipc_contracts::IpcResourceHandle>>, working_directory: Option<String>, environment: Option<Map<String, String>>, start_if_needed: Option<Bool>) -> Result<PythonSidecarDecodedActionResponse<TResult>, String>:
    let raw = call_sidecar_impl(
        app,
        PythonSidecarActionRequest { config: config, action_id: action_id.into(), payload_json: encode_sidecar_payload_json(
            match payload:
                Option::Some(__kain_option_as_ref_value) => Option::Some(&__kain_option_as_ref_value)
                Option::None => none
        )?, input_artifacts: input_artifacts, resource_handles: resource_handles, working_directory: working_directory, environment: environment, start_if_needed: start_if_needed }
    )?
    let result = decode_sidecar_action_result(&raw)?
    Result::Ok(PythonSidecarDecodedActionResponse { raw: raw, result: result })

impl PythonSidecarManager:
    fn set_last_error(_self: &PythonSidecarManager, error: Option<String>) -> Result<(), String>:
        let mut guard = (*_self).last_error.lock().map_err(|_| "python sidecar error state lock poisoned".to_string())?
        *guard = error
        ()
        Result::Ok(())

    fn get_last_error(_self: &PythonSidecarManager) -> Result<Option<String>, String>:
        let guard = (*_self).last_error.lock().map_err(|_| "python sidecar error state lock poisoned".to_string())?
        Result::Ok(guard.clone())


impl PythonSidecarSession:
    fn send_request(_self: &mut PythonSidecarSession, kind: String, action_id: Option<String>, payload_json: Option<String>, input_artifacts: Option<Array<greeble_ipc_contracts::IpcArtifactRef>>, resource_handles: Option<Array<greeble_ipc_contracts::IpcResourceHandle>>, cwd: Option<String>, environment: Option<Map<String, String>>) -> Result<PythonSidecarProtocolResponse, String>:
        (*_self).request_counter = (*_self).request_counter + 1
        ()
        let request_id = format!("sidecar-{}", (*_self).request_counter)
        let request = PythonSidecarProtocolRequest { request_id: request_id.clone(), kind: kind.to_string(), action_id: action_id, payload_json: payload_json, input_artifacts: input_artifacts, resource_handles: resource_handles, cwd: cwd, environment: environment }
        let serialized = serde_json__to_string(&request).map_err(|error| format!("Failed to serialize sidecar request: {error}"))?
        (*_self).stdin.write_all(serialized.as_bytes()).and_then(|_| (*_self).stdin.write_all([10])).and_then(|_| (*_self).stdin.flush()).map_err(|error| format!("Failed to write to Python sidecar stdin: {error}"))?
        ()
        let mut response_line = String__new_()
        let bytes_read = (*_self).stdout.read_line(&mut response_line).map_err(|error| format!("Failed to read Python sidecar stdout: {error}"))?
        if bytes_read == 0:
            return Result::Err("Python sidecar exited before returning a response.".to_string())
        let response: PythonSidecarProtocolResponse = serde_json__from_str(response_line.trim()).map_err(|error| format!("Failed to parse Python sidecar response '{}': {error}", response_line.trim()))?
        if response.request_id != request_id:
            return Result::Err(format!("Python sidecar response id mismatch. Expected {}, got {}.", request_id, response.request_id))
        Result::Ok(response)

    fn stop(_self: &mut PythonSidecarSession):
        let _ = (*_self).send_request("shutdown", none, none, none, none, none, none)
        let _ = (*_self).child.kill()
        let _ = (*_self).child.wait()


fn repo_python_workspace_root() -> std::path::PathBuf:
    PathBuf__from(env!("CARGO_MANIFEST_DIR")).join("../src-python")

fn repo_local_model_catalog_path() -> std::path::PathBuf:
    PathBuf__from(env!("CARGO_MANIFEST_DIR")).join("../src/config/localModelCatalog.json")

fn should_skip_workspace_entry(path: &std::path::Path) -> Bool:
    path.components().any(|component| matches!(component_.as_os_str().to_string_lossy(), "__pycache__" | ".pytest_cache"))

fn build_sidecar_paths(paths: &RuntimePaths, manifest: &PythonSidecarWorkspaceManifest) -> PythonSidecarPaths:
    let workspace_root = (*paths).root_dir.join(PYTHON_SIDECAR_WORKSPACE_DIR_NAME)
    PythonSidecarPaths { manifest_path: workspace_root.join(PYTHON_SIDECAR_MANIFEST_FILENAME), guide_path: workspace_root.join(&(*manifest).guide_path), workspace_root: workspace_root, log_path: (*paths).logs_dir.join(PYTHON_SIDECAR_LOG_FILENAME) }

fn read_manifest_from_text(text: String) -> Result<PythonSidecarWorkspaceManifest, String>:
    serde_json__from_str(text).map_err(|error| format!("Failed to parse Python sidecar manifest: {error}"))

fn load_sidecar_manifest() -> Result<PythonSidecarWorkspaceManifest, String>:
    let repo_manifest_path = repo_python_workspace_root().join(PYTHON_SIDECAR_MANIFEST_FILENAME)
    if repo_manifest_path.exists():
        let text = std__fs__read_to_string(&repo_manifest_path).map_err(|error| format!("Failed to read Python sidecar manifest {}: {error}", python_commands__path_to_string(&repo_manifest_path)))?
        return read_manifest_from_text(&text)
    let embedded = EMBEDDED_PYTHON_WORKSPACE.get_file(PYTHON_SIDECAR_MANIFEST_FILENAME).ok_or_else(|| "Embedded Python sidecar manifest is missing.".to_string())?
    let text = std__str__from_utf8(embedded.contents()).map_err(|error| format!("Embedded Python sidecar manifest is not valid UTF-8: {error}"))?
    read_manifest_from_text(text)

fn copy_embedded_workspace(target_root: &std::path::Path) -> Result<(), String>:
    for entry in EMBEDDED_PYTHON_WORKSPACE.entries():
        match entry:
            include_dir::DirEntry::Dir(dir) => copy_embedded_directory(target_root, dir)?
            include_dir::DirEntry::File(file) =>
                let target_path = target_root.join(file.path())
                match target_path.parent():
                    Some(parent) =>
                        std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create embedded Python sidecar directory {}: {error}", python_commands__path_to_string(parent)))?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                std__fs__write(&target_path, file.contents()).map_err(|error| format!("Failed to write embedded Python sidecar file {}: {error}", python_commands__path_to_string(&target_path)))?
                ()
    ()
    Result::Ok(())

fn copy_embedded_directory(target_root: &std::path::Path, dir: &include_dir::Dir<_>) -> Result<(), String>:
    let directory_path = target_root.join(dir.path())
    std__fs__create_dir_all(&directory_path).map_err(|error| format!("Failed to create embedded Python sidecar directory {}: {error}", python_commands__path_to_string(&directory_path)))?
    ()
    for entry in dir.entries():
        match entry:
            include_dir::DirEntry::Dir(child) => copy_embedded_directory(target_root, child)?
            include_dir::DirEntry::File(file) =>
                let file_path = target_root.join(file.path())
                match file_path.parent():
                    Some(parent) =>
                        std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create embedded Python sidecar directory {}: {error}", python_commands__path_to_string(parent)))?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                std__fs__write(&file_path, file.contents()).map_err(|error| format!("Failed to write embedded Python sidecar file {}: {error}", python_commands__path_to_string(&file_path)))?
                ()
    ()
    Result::Ok(())

fn copy_filesystem_workspace(source_root: &std::path::Path, target_root: &std::path::Path) -> Result<(), String>:
    fn recurse(source_root: &std::path::Path, current: &std::path::Path, target_root: &std::path::Path) -> Result<(), String>:
        let entries = std__fs__read_dir(current).map_err(|error| format!("Failed to read Python sidecar source directory {}: {error}", python_commands__path_to_string(current)))?
        for entry in entries:
            let entry = entry.map_err(|error| format!("Failed to read Python sidecar source entry inside {}: {error}", python_commands__path_to_string(current)))?
            let path = entry.path()
            let relative_path = path.strip_prefix(source_root).map_err(|error| format!("Failed to resolve Python sidecar relative path for {}: {error}", python_commands__path_to_string(&path)))?
            if should_skip_workspace_entry(relative_path):
                continue
            let target_path = target_root.join(relative_path)
            if path.is_dir():
                std__fs__create_dir_all(&target_path).map_err(|error| format!("Failed to create Python sidecar target directory {}: {error}", python_commands__path_to_string(&target_path)))?
                ()
                recurse(source_root, &path, target_root)?
                ()
            else:
                match target_path.parent():
                    Some(parent) =>
                        std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create Python sidecar target directory {}: {error}", python_commands__path_to_string(parent)))?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                std__fs__copy(&path, &target_path).map_err(|error| format!("Failed to copy Python sidecar file {} to {}: {error}", python_commands__path_to_string(&path), python_commands__path_to_string(&target_path)))?
                ()
        ()
        Result::Ok(())

    recurse(source_root, source_root, target_root)

fn load_local_model_catalog_text() -> Result<String, String>:
    let repo_catalog_path = repo_local_model_catalog_path()
    if repo_catalog_path.exists():
        return std__fs__read_to_string(&repo_catalog_path).map_err(|error| format!("Failed to read local model catalog {}: {error}", python_commands__path_to_string(&repo_catalog_path)))
    Result::Ok(EMBEDDED_LOCAL_MODEL_CATALOG_TEXT.to_string())

fn sync_sidecar_runtime_assets(target_root: &std::path::Path) -> Result<(), String>:
    let local_model_catalog_path = target_root.join(LOCAL_MODEL_CATALOG_RUNTIME_RELATIVE_PATH)
    match local_model_catalog_path.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create Python sidecar runtime asset directory {}: {error}", python_commands__path_to_string(parent)))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let local_model_catalog_text = load_local_model_catalog_text()?
    std__fs__write(&local_model_catalog_path, local_model_catalog_text).map_err(|error| format!("Failed to write Python sidecar local model catalog {}: {error}", python_commands__path_to_string(&local_model_catalog_path)))?
    ()
    Result::Ok(())

fn sync_python_workspace(paths: &RuntimePaths) -> Result<(PythonSidecarWorkspaceManifest, PythonSidecarPaths), String>:
    let manifest = load_sidecar_manifest()?
    let sidecar_paths = build_sidecar_paths(paths, &manifest)
    if sidecar_paths.workspace_root.exists():
        std__fs__remove_dir_all(&sidecar_paths.workspace_root).map_err(|error| format!("Failed to replace Python sidecar workspace {}: {error}", python_commands__path_to_string(&sidecar_paths.workspace_root)))?
        ()
        ()
        ()
        ()
    std__fs__create_dir_all(&sidecar_paths.workspace_root).map_err(|error| format!("Failed to create Python sidecar workspace {}: {error}", python_commands__path_to_string(&sidecar_paths.workspace_root)))?
    ()
    let repo_root = repo_python_workspace_root()
    if repo_root.exists():
        copy_filesystem_workspace(&repo_root, &sidecar_paths.workspace_root)?
        ()
        ()
        ()
        ()
    else:
        copy_embedded_workspace(&sidecar_paths.workspace_root)?
        ()
        ()
        ()
        ()
    sync_sidecar_runtime_assets(&sidecar_paths.workspace_root)?
    ()
    Result::Ok((manifest, sidecar_paths))

fn prepend_python_workspace_to_environment(paths: &RuntimePaths, workspace_root: &std::path::Path) -> Map<String, String>:
    let mut environment = python_commands__pythonpath_environment(paths, none)
    let separator = if cfg!(target_os = "windows"):
        ";"
    else:
        ":"
    let workspace_root_string = python_commands__path_to_string(workspace_root)
    let current_pythonpath = environment.get("PYTHONPATH").cloned().unwrap_or_default()
    let pythonpath = if current_pythonpath.trim().is_empty():
        workspace_root_string.clone()
    else:
        format!("{workspace_root_string}{separator}{current_pythonpath}")
    environment.insert("PYTHONPATH".to_string(), pythonpath)
    ()
    environment.insert(PYTHON_SIDECAR_ENV_RUNTIME_ROOT.to_string(), python_commands__path_to_string(&(*paths).root_dir))
    ()
    environment.insert(PYTHON_SIDECAR_ENV_WORKSPACE_ROOT.to_string(), workspace_root_string)
    ()
    environment.insert(PYTHON_SIDECAR_ENV_PROTOCOL.to_string(), "stdio-json-lines".to_string())
    ()
    environment.insert(PYTHON_SIDECAR_ENV_UNBUFFERED.to_string(), "1".to_string())
    ()
    environment

fn spawn_sidecar_session(app: &tauri::AppHandle, paths: &RuntimePaths, manifest: PythonSidecarWorkspaceManifest, sidecar_paths: PythonSidecarPaths) -> Result<PythonSidecarSession, String>:
    let resource_handle = greeble_ipc_contracts::IpcResourceHandle { rid: app.resources_table().add(PythonSidecarSessionResource { runtime_root: python_commands__path_to_string(&(*paths).root_dir) }), kind: "python-sidecar-session".to_string() }
    let managed_python = python_commands__managed_python_path(paths)
    let log_file = OpenOptions__new_().create(true).append(true).open(&sidecar_paths.log_path).map_err(|error| format!("Failed to open Python sidecar log file {}: {error}", python_commands__path_to_string(&sidecar_paths.log_path)))?
    let mut command = Command__new_(&managed_python)
    command.arg("-m").arg(&manifest.entry_module).arg("--stdio").current_dir(&sidecar_paths.workspace_root).stdin(Stdio__piped()).stdout(Stdio__piped()).stderr(Stdio__from(log_file))
    ()
    command.creation_flags(CREATE_NO_WINDOW)
    ()
    ()
    ()
    ()
    for (key, value) in prepend_python_workspace_to_environment(paths, &sidecar_paths.workspace_root):
        command.env(key, value)
        ()
    ()
    let mut child = command.spawn_().map_err(|error| format!("Failed to launch Python sidecar with {}: {error}", python_commands__path_to_string(&managed_python)))?
    let pid = child.id()
    let stdin = child.stdin.take().ok_or_else(|| "Python sidecar stdin pipe was not available.".to_string())?
    let stdout = child.stdout.take().ok_or_else(|| "Python sidecar stdout pipe was not available.".to_string())?
    let mut session = PythonSidecarSession { runtime_root: (*paths).root_dir.clone(), sidecar_paths: sidecar_paths, manifest: manifest.clone(), resource_handle: resource_handle, child: child, stdin: stdin, stdout: BufReader__new_(stdout), pid: pid, request_counter: 0 }
    let handshake = session.send_request("handshake", none, none, none, none, none, none)?
    if !handshake.ok:
        let error = handshake.error.unwrap_or_else(|| "Python sidecar handshake failed.".to_string())
        session.stop()
        ()
        close_sidecar_session_resource(app, &session.resource_handle)
        ()
        return Result::Err(error)
    let handshake_payload = handshake.result_json.ok_or_else(|| "Python sidecar handshake returned no payload.".to_string()).and_then(|payload| serde_json__from_str(&payload).map_err(|error| format!("Failed to parse Python sidecar handshake payload: {error}")))?
    if handshake_payload.manifest_id != manifest.id or handshake_payload.module_name != manifest.module_name or handshake_payload.entry_module != manifest.entry_module or handshake_payload.transport != manifest.transport:
        session.stop()
        ()
        close_sidecar_session_resource(app, &session.resource_handle)
        ()
        return Result::Err("Python sidecar handshake did not match the local manifest.".to_string())
    let mut expected_actions = manifest.actions.iter().map(|action| action.id.clone()).collect()
    expected_actions.sort()
    ()
    if handshake_payload.available_actions != expected_actions:
        session.stop()
        ()
        close_sidecar_session_resource(app, &session.resource_handle)
        ()
        return Result::Err("Python sidecar handshake returned an unexpected action registry.".to_string())
    Result::Ok(session)

fn sidecar_status_from_parts(paths: &RuntimePaths, manifest: &PythonSidecarWorkspaceManifest, sidecar_paths: &PythonSidecarPaths, running: Bool, pid: Option<u32>, last_error: Option<String>) -> PythonSidecarStatus:
    PythonSidecarStatus { runtime_root: python_commands__path_to_string(&(*paths).root_dir), workspace_root: python_commands__path_to_string(&(*sidecar_paths).workspace_root), manifest_path: python_commands__path_to_string(&(*sidecar_paths).manifest_path), guide_path: python_commands__path_to_string(&(*sidecar_paths).guide_path), log_path: python_commands__path_to_string(&(*sidecar_paths).log_path), running: running, pid: pid, module_name: (*manifest).module_name.clone(), entry_module: (*manifest).entry_module.clone(), transport: (*manifest).transport.clone(), action_ids: (*manifest).actions.iter().map(|action| action.id.clone()).collect(), last_error: last_error }

fn session_matches_runtime_root(session: &PythonSidecarSession, runtime_root: &std::path::Path) -> Bool:
    (*session).runtime_root == runtime_root

fn current_sidecar_process_status(app: &tauri::AppHandle, manager: &PythonSidecarManager, runtime_root: &std::path::Path) -> Result<(Bool, Option<u32>), String>:
    let mut session_guard = (*manager).session.lock().map_err(|_| "python sidecar session lock poisoned".to_string())?
    let Some(session) = session_guard
    if !session_matches_runtime_root(session, runtime_root):
        return Result::Ok((false, none))
    match session.child.try_wait():
        Ok(Some(status)) =>
            manager.set_last_error(Option::Some(format!("Python sidecar exited with status {}.", status.code().unwrap_or(-1))))?
            ()
            close_sidecar_session_resource(app, &session.resource_handle)
            ()
            *session_guard = none
            ()
            Result::Ok((false, none))
        Ok(None) => Result::Ok((true, Option::Some(session.pid)))
        Err(error) =>
            manager.set_last_error(Option::Some(format!("Failed to inspect Python sidecar process state: {error}")))?
            ()
            close_sidecar_session_resource(app, &session.resource_handle)
            ()
            *session_guard = none
            ()
            Result::Ok((false, none))

fn stop_current_sidecar_session(app: &tauri::AppHandle, manager: &PythonSidecarManager) -> Result<(), String>:
    let mut session_guard = (*manager).session.lock().map_err(|_| "python sidecar session lock poisoned".to_string())?
    match session_guard:
        Some(session) =>
            session.stop()
            ()
            close_sidecar_session_resource(app, &session.resource_handle)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    *session_guard = none
    ()
    Result::Ok(())

fn get_sidecar_status_impl(app: &tauri::AppHandle, config: Option<PythonRuntimeConfig>) -> Result<PythonSidecarStatus, String>:
    let manager = app.state()
    let manifest = load_sidecar_manifest()?
    let resolved = python_commands__resolve_runtime_config(app, config)?
    let paths = python_commands__build_runtime_paths(&resolved.runtime_root)
    let sidecar_paths = build_sidecar_paths(&paths, &manifest)
    let (running, pid) = current_sidecar_process_status(app, &manager, &paths.root_dir)?
    Result::Ok(sidecar_status_from_parts(&paths, &manifest, &sidecar_paths, running, pid, manager.get_last_error()?))

fn start_sidecar_impl(app: &tauri::AppHandle, config: Option<PythonRuntimeConfig>) -> Result<PythonSidecarStartResponse, String>:
    let manager = app.state()
    let (resolved, paths, interpreters, base_interpreter) = python_commands__prepare_managed_python_runtime(app, config)?
    if resolved.create_boilerplate:
        python_commands__seed_boilerplate_files(&paths, &resolved.bootstrap_packages)?
        ()
        ()
        ()
        ()
    else:
        python_commands__ensure_runtime_directories(&paths)?
        ()
        ()
        ()
        ()
    let runtime_status = python_commands__runtime_status_with_base_interpreter(&resolved, &paths, interpreters, Option::Some(base_interpreter))
    let manifest = load_sidecar_manifest()?
    let sidecar_paths = build_sidecar_paths(&paths, &manifest)
    let (running, pid) = current_sidecar_process_status(app, &manager, &paths.root_dir)?
    if running:
        manager.set_last_error(none)?
        ()
        return Result::Ok(PythonSidecarStartResponse { runtime_status: runtime_status, sidecar: sidecar_status_from_parts(&paths, &manifest, &sidecar_paths, true, pid, none) })
    stop_current_sidecar_session(app, &manager)?
    ()
    let (synced_manifest, synced_paths) = sync_python_workspace(&paths)?
    let session = spawn_sidecar_session(app, &paths, synced_manifest.clone(), synced_paths.clone())?
    let pid = session.pid
    let mut session_guard = manager.session.lock().map_err(|_| "python sidecar session lock poisoned".to_string())?
    *session_guard = Option::Some(session)
    ()
    ()
    ()
    ()
    manager.set_last_error(none)?
    ()
    Result::Ok(PythonSidecarStartResponse { runtime_status: runtime_status, sidecar: sidecar_status_from_parts(&paths, &synced_manifest, &synced_paths, true, Option::Some(pid), none) })

fn stop_sidecar_impl(app: &tauri::AppHandle, config: Option<PythonRuntimeConfig>) -> Result<PythonSidecarStatus, String>:
    let manager = app.state()
    let manifest = load_sidecar_manifest()?
    let resolved = python_commands__resolve_runtime_config(app, config)?
    let paths = python_commands__build_runtime_paths(&resolved.runtime_root)
    let sidecar_paths = build_sidecar_paths(&paths, &manifest)
    stop_current_sidecar_session(app, &manager)?
    ()
    manager.set_last_error(none)?
    ()
    Result::Ok(sidecar_status_from_parts(&paths, &manifest, &sidecar_paths, false, none, none))

fn resolve_sidecar_output_artifacts(app: &tauri::AppHandle, output_artifacts: Option<Array<PythonSidecarOutputArtifactEnvelope>>) -> Result<ResolvedPythonSidecarOutputArtifacts, String>:
    let ipc_runtime = app.state()
    let Some(output_artifacts) = output_artifacts
    let mut resolved = ResolvedPythonSidecarOutputArtifacts { descriptors: |__kain_ctor_arg0| Vec::new()(output_artifacts.len()), tokens: |__kain_ctor_arg0| Vec::new()(output_artifacts.len()) }
    let mut newly_registered_artifact_ids: Array<String> = Vec__new_()
    for artifact in output_artifacts:
        match artifact:
            PythonSidecarOutputArtifactEnvelope::Descriptor(descriptor) =>
                resolved.tokens.push(none)
                ()
                resolved.descriptors.push(descriptor)
                ()
            PythonSidecarOutputArtifactEnvelope::Candidate(candidate) =>
                let trimmed_file_path = candidate.file_path.trim()
                if trimmed_file_path.is_empty():
                    for artifact_id in newly_registered_artifact_ids:
                        let _ = ipc_runtime.release_artifact(app, &artifact_id)
                    ()
                    return Result::Err("Python sidecar output artifact candidates require a non-empty filePath.".to_string())
                let retention = candidate.retention.unwrap_or(greeble_ipc_contracts::IpcArtifactRetention::Ephemeral)
                let delete_on_release = candidate.delete_on_release.unwrap_or(matches!(retention, greeble_ipc_contracts::IpcArtifactRetention::Ephemeral))
                let descriptor = match ipc_runtime.register_artifact_path(app, ipc_runtime::artifacts::RegisterArtifactPathRequest { kind: candidate.kind, file_path: PathBuf__from(trimmed_file_path), media_type: candidate.media_type, retention: retention, identity_key: candidate.identity_key, content_revision: candidate.content_revision, delete_on_release: delete_on_release }):
                    Ok(descriptor) => descriptor
                    Err(error) =>
                        for artifact_id in newly_registered_artifact_ids:
                            let _ = ipc_runtime.release_artifact(app, &artifact_id)
                        ()
                        return Result::Err(error)
                newly_registered_artifact_ids.push(descriptor.id.clone())
                ()
                resolved.tokens.push(candidate.token)
                ()
                resolved.descriptors.push(descriptor)
                ()
    ()
    Result::Ok(resolved)

fn call_sidecar_impl(app: &tauri::AppHandle, request: PythonSidecarActionRequest) -> Result<PythonSidecarActionResponse, String>:
    let manager = app.state()
    let start_if_needed = request.start_if_needed.unwrap_or(true)
    let action_id = request.action_id.trim().to_string()
    if action_id.is_empty():
        return Result::Err("Python sidecar action id cannot be empty.".to_string())
    let start_response = if start_if_needed:
        Option::Some(start_sidecar_impl(app, request.config.clone())?)
    else:
        none
    let runtime_status = match start_response:
        Some(response) =>
            response.runtime_status
        _ =>
            let (resolved, paths, interpreters, base_interpreter) = python_commands__prepare_managed_python_runtime(app, request.config.clone())?
            python_commands__runtime_status_with_base_interpreter(&resolved, &paths, interpreters, Option::Some(base_interpreter))
    let mut session_guard = manager.session.lock().map_err(|_| "python sidecar session lock poisoned".to_string())?
    let session = session_guard.ok_or_else(|| "Python sidecar is not running.".to_string())?
    if !session_matches_runtime_root(session, Path__new_(&runtime_status.runtime_root)):
        return Result::Err("Python sidecar is running for a different runtime root.".to_string())
    let working_directory = request.working_directory.clone().unwrap_or_else(|| runtime_status.runtime_root.clone())
    let response = session.send_request("action", Option::Some(action_id.clone()), request.payload_json.clone(), request.input_artifacts.clone(), request.resource_handles.clone(), Option::Some(working_directory), request.environment.clone())?
    if !response.ok:
        let error = response.error.clone().unwrap_or_else(|| format!("Python sidecar action '{}' failed.", action_id))
        manager.set_last_error(Option::Some(error.clone()))?
        ()
        return Result::Err(error)
    manager.set_last_error(none)?
    ()
    let resolved_output_artifacts = resolve_sidecar_output_artifacts(app, response.output_artifacts)?
    Result::Ok(PythonSidecarActionResponse { runtime_status: runtime_status, sidecar: sidecar_status_from_parts(&python_commands__build_runtime_paths(&session.runtime_root), &session.manifest, &session.sidecar_paths, true, Option::Some(session.pid), none), request_id: response.request_id, action_id: action_id, result_json: response.result_json.unwrap_or_else(|| "null".to_string()), output_artifacts: resolved_output_artifacts.descriptors, output_artifact_tokens: resolved_output_artifacts.tokens, resource_handles: response.resource_handles.unwrap_or_else(|| vec!(session.resource_handle.clone())) })

fn close_sidecar_session_resource(app: &tauri::AppHandle, resource_handle: &greeble_ipc_contracts::IpcResourceHandle):
    let _ = app.resources_table().close((*resource_handle).rid)

fn python_get_sidecar_status(app: tauri::AppHandle, config: Option<PythonRuntimeConfig>) -> Result<PythonSidecarStatus, String>:
    (await tokio__task__spawn_blocking(|| get_sidecar_status_impl(&app, config))).map_err(|error| format!("Python sidecar status task failed to join: {error}"))?

fn python_start_sidecar(app: tauri::AppHandle, config: Option<PythonRuntimeConfig>) -> Result<PythonSidecarStartResponse, String>:
    (await tokio__task__spawn_blocking(|| start_sidecar_impl(&app, config))).map_err(|error| format!("Python sidecar start task failed to join: {error}"))?

fn python_stop_sidecar(app: tauri::AppHandle, config: Option<PythonRuntimeConfig>) -> Result<PythonSidecarStatus, String>:
    (await tokio__task__spawn_blocking(|| stop_sidecar_impl(&app, config))).map_err(|error| format!("Python sidecar stop task failed to join: {error}"))?

fn python_sidecar_call(app: tauri::AppHandle, request: PythonSidecarActionRequest) -> Result<PythonSidecarActionResponse, String>:
    (await tokio__task__spawn_blocking(|| call_sidecar_impl(&app, request))).map_err(|error| format!("Python sidecar action task failed to join: {error}"))?

enum RemoteProtocol:
    Sftp

enum RemoteAuthMode:
    Password
    PrivateKeyFile

enum RemoteConnectionStatus:
    Disconnected
    Connecting
    Connected
    Error
    UntrustedHost

struct RemoteBreadcrumb:
    label: String
    path: String

struct RemotePendingHostVerification:
    connection_id: String
    host: String
    port: u16
    algorithm: String
    fingerprint_sha256: String
    public_key: String
    observed_at: u64

struct RemoteTrustedHostRecord:
    host: String
    port: u16
    algorithm: String
    fingerprint_sha256: String
    public_key: String
    trusted_at: u64

struct RemoteConnectionSummary:
    id: String
    label: String
    protocol: RemoteProtocol
    host: String
    port: u16
    username: String
    start_path: String
    auth_mode: RemoteAuthMode
    private_key_path: Option<String>
    status: RemoteConnectionStatus
    last_error: Option<String>
    pending_host_verification: Option<RemotePendingHostVerification>

struct RemoteConnectionUpsertRequest:
    id: Option<String>
    label: String
    host: String
    port: Option<u16>
    username: String
    start_path: String
    auth_mode: RemoteAuthMode
    private_key_path: Option<String>
    password: Option<String>
    key_passphrase: Option<String>

struct RemoteTrustedHostRemovalRequest:
    host: String
    port: u16

struct RemoteDirectoryListing:
    path: String
    parent_path: Option<String>
    breadcrumbs: Array<RemoteBreadcrumb>
    entries: Array<FileEntry>

struct PersistedRemoteConnections:
    connections: Array<PersistedRemoteConnection>

struct PersistedRemoteConnection:
    id: String
    label: String
    protocol: RemoteProtocol
    host: String
    port: u16
    username: String
    start_path: String
    auth_mode: RemoteAuthMode
    private_key_path: Option<String>

struct PersistedTrustedHosts:
    hosts: Array<RemoteTrustedHostRecord>

impl Default for PersistedTrustedHosts:
    fn default_() -> PersistedTrustedHosts:
        PersistedTrustedHosts { hosts: Vec__new_() }


struct RemoteConnectionRuntimeStatus:
    status: RemoteConnectionStatus
    last_error: Option<String>

struct RemoteSftpSession:
    operator_: yazi_sftp::Operator

struct RemoteStorageState:
    sessions: Map<String, RemoteSftpSession>
    statuses: Map<String, RemoteConnectionRuntimeStatus>
    pending_host_verifications: Map<String, RemotePendingHostVerification>

impl Default for RemoteStorageState:
    fn default_() -> RemoteStorageState:
        RemoteStorageState { sessions: Mutex__new_(HashMap__new_()), statuses: Mutex__new_(HashMap__new_()), pending_host_verifications: Arc__new_(Mutex__new_(HashMap__new_())) }


struct RemoteVirtualPath:
    connection_id: String
    relative_segments: Array<String>

struct RemoteHostKeyObservation:
    algorithm: String
    fingerprint_sha256: String
    public_key: String

struct RemoteClientHandler:
    connection_id: String
    host: String
    port: u16
    trusted_host: Option<RemoteTrustedHostRecord>
    pending_host_verifications: Map<String, RemotePendingHostVerification>

impl russh::client::Handler for RemoteClientHandler:
    fn check_server_key(_self: &mut RemoteClientHandler, server_public_key: &russh::keys::PublicKey) -> Result<Bool, Self::Error>:
        let observation = observe_remote_host_key(server_public_key)
        match &(*_self).trusted_host:
            Some(trusted) if trusted.algorithm == observation.algorithm and trusted.fingerprint_sha256 == observation.fingerprint_sha256 and trusted.public_key == observation.public_key =>
                clear_pending_host_verification(&(*_self).pending_host_verifications, &(*_self).connection_id).map_err(russh::Error::InvalidConfig)?
                ()
                Result::Ok(true)
            _ =>
                record_pending_host_verification(&(*_self).pending_host_verifications, RemotePendingHostVerification { connection_id: (*_self).connection_id.clone(), host: (*_self).host.clone(), port: (*_self).port, algorithm: observation.algorithm, fingerprint_sha256: observation.fingerprint_sha256, public_key: observation.public_key, observed_at: now_ms() })?
                ()
                Result::Err(russh::Error::InvalidConfig(format!("Host key for {}:{} is not trusted yet.", (*_self).host, (*_self).port)))


fn remote_list_connections(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>) -> Result<Array<RemoteConnectionSummary>, String>:
    let persisted = read_remote_connections(&app)?
    let statuses = clone_remote_statuses(&state)?
    let pending = clone_pending_host_verifications(&state)?
    let mut connections = persisted.connections.into_iter().map(
        |connection| block:
            let runtime = statuses.get(&connection.id)
            RemoteConnectionSummary { id: connection.id.clone(), label: connection.label.clone(), protocol: connection.protocol, host: connection.host.clone(), port: connection.port, username: connection.username.clone(), start_path: connection.start_path.clone(), auth_mode: connection.auth_mode, private_key_path: connection.private_key_path.clone(), status: runtime.map(|status| status.status).unwrap_or(RemoteConnectionStatus::Disconnected), last_error: runtime.and_then(|status| status.last_error.clone()), pending_host_verification: pending.get(&connection.id).cloned() }
    ).collect()
    connections.sort_by(|left, right| left.label.to_ascii_lowercase().cmp(&right.label.to_ascii_lowercase()).then_with(|| left.host.cmp(&right.host)).then_with(|| left.start_path.cmp(&right.start_path)))
    ()
    Result::Ok(connections)

fn remote_upsert_connection(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, request: RemoteConnectionUpsertRequest) -> Result<RemoteConnectionSummary, String>:
    let existing_connections = read_remote_connections(&app)?
    let existing = request.id.and_then(|id| existing_connections.connections.iter().find(|connection| connection.id == id).cloned())
    let id = request.id.clone().unwrap_or_else(|| Uuid__new_v4().to_string())
    let label = normalize_required_text(&request.label, "Remote connection label")?
    let host = normalize_required_text(&request.host, "Remote host")?
    let username = normalize_required_text(&request.username, "Remote username")?
    let start_path = normalize_remote_start_path(&request.start_path)?
    let port = request.port.unwrap_or(22).max(1)
    let private_key_path = match request.auth_mode:
        RemoteAuthMode::Password => none
        RemoteAuthMode::PrivateKeyFile => Option::Some(normalize_required_text(request.private_key_path.ok_or_else(|| "Private key file path is required for private-key authentication.".to_string())?, "Private key file path")?)
    let connection = PersistedRemoteConnection { id: id.clone(), label: label, protocol: RemoteProtocol::Sftp, host: host, port: port, username: username, start_path: start_path, auth_mode: request.auth_mode, private_key_path: private_key_path }
    persist_remote_auth_secrets(&connection, &request, existing)?
    ()
    upsert_remote_connection(&app, connection.clone())?
    ()
    (await remote_disconnect_inner(&state, &id))?
    ()
    update_remote_status(&state, &id, RemoteConnectionStatus::Disconnected, none)?
    ()
    summarize_remote_connection(&state, connection)

fn remote_delete_connection(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, connection_id: String) -> Result<(), String>:
    remove_remote_connection(&app, &connection_id)?
    ()
    delete_remote_auth_secrets(&connection_id)?
    ()
    (await remote_disconnect_inner(&state, &connection_id))?
    ()
    clear_remote_status(&state, &connection_id)?
    ()
    clear_pending_host_verification(&state.pending_host_verifications, &connection_id)?
    ()
    Result::Ok(())

fn remote_connect(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, connection_id: String) -> Result<RemoteConnectionSummary, String>:
    let connection = load_remote_connection(&app, &connection_id)?
    let _ = (await get_or_connect_remote_session(&app, &state, &connection))?
    summarize_remote_connection(&state, connection)

fn remote_disconnect(state: tauri::State<_, RemoteStorageState>, connection_id: String) -> Result<(), String>:
    await remote_disconnect_inner(&state, &connection_id)

fn remote_list_trusted_hosts(app: tauri::AppHandle) -> Result<Array<RemoteTrustedHostRecord>, String>:
    let mut trusted_hosts = (read_trusted_hosts(&app)?).hosts
    trusted_hosts.sort_by(|left, right| left.host.cmp(&right.host).then_with(|| left.port.cmp(&right.port)))
    ()
    Result::Ok(trusted_hosts)

fn remote_trust_pending_host(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, connection_id: String) -> Result<RemoteTrustedHostRecord, String>:
    let pending = block:
        let pending = state.pending_host_verifications.lock().map_err(|_| "remote pending host verification lock poisoned".to_string())?
        pending.get(&connection_id).cloned().ok_or_else(|| "No pending host verification is available for that connection.".to_string())?
    let trusted = RemoteTrustedHostRecord { host: pending.host.clone(), port: pending.port, algorithm: pending.algorithm.clone(), fingerprint_sha256: pending.fingerprint_sha256.clone(), public_key: pending.public_key.clone(), trusted_at: now_ms() }
    upsert_trusted_host(&app, trusted.clone())?
    ()
    clear_pending_host_verification(&state.pending_host_verifications, &connection_id)?
    ()
    (await remote_disconnect_inner(&state, &connection_id))?
    ()
    update_remote_status(&state, &connection_id, RemoteConnectionStatus::Disconnected, none)?
    ()
    Result::Ok(trusted)

fn remote_remove_trusted_host(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, request: RemoteTrustedHostRemovalRequest) -> Result<(), String>:
    remove_trusted_host(&app, &request.host, request.port)?
    ()
    clear_pending_hosts_for_target(&state.pending_host_verifications, &request.host, request.port)?
    ()
    (await disconnect_sessions_for_host(&app, &state, &request.host, request.port))?
    ()
    Result::Ok(())

fn remote_list_dir(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, path: String) -> Result<RemoteDirectoryListing, String>:
    let parsed = parse_remote_virtual_path(&path)?
    let connection = load_remote_connection(&app, &parsed.connection_id)?
    let session = (await get_or_connect_remote_session(&app, &state, &connection))?
    let actual_path = build_actual_remote_path(&connection.start_path, &parsed.relative_segments)?
    let mut reader = block:
        let operator_ = await session.operator_.lock()
        (await operator_.read_dir(actual_path.as_str())).map_err(|error| remote_operation_error(error, true).message)?
    let mut entries = Vec__new_()
    loop:
        match (await reader.next()).map_err(|error| remote_operation_error(error, true).message)?:
            Some(entry) =>
                entries.push(remote_dir_entry_to_file_entry(&connection, &parsed, entry))
                ()
            _ => break
    ()
    sort_entries(&mut entries)
    ()
    Result::Ok(RemoteDirectoryListing { path: build_remote_virtual_path(&connection.id, &parsed.relative_segments), parent_path: parsed.parent_path(), breadcrumbs: build_remote_breadcrumbs(&connection, &parsed.relative_segments), entries: entries })

fn remote_open_file(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, path: String) -> Result<(), String>:
    let staged_path = (await stage_remote_file(&app, &state, &path))?
    await fs_commands__fs_open_file(staged_path.to_string_lossy().into_owned())

fn remote_read_text_file(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, path: String) -> Result<String, String>:
    let bytes = (await read_remote_file_bytes(&app, &state, &path, REMOTE_TEXT_PREVIEW_MAX_BYTES as u64))?
    String__from_utf8(bytes).map_err(|error| format!("Remote file is not valid UTF-8: {error}"))

fn remote_read_file_base64(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, path: String) -> Result<String, String>:
    let bytes = (await read_remote_file_bytes(&app, &state, &path, REMOTE_BASE64_PREVIEW_MAX_BYTES as u64))?
    Result::Ok(base64__engine__general_purpose__STANDARD.encode(bytes))

fn remote_read_preview_bytes(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, path: String, max_bytes: Option<u64>) -> Result<tauri::transport::BinaryResponse, String>:
    let bytes = (await read_remote_file_bytes(&app, &state, &path, resolve_preview_byte_limit(max_bytes, REMOTE_PREVIEW_BYTES_MAX_BYTES as u64)))?
    Result::Ok(BinaryResponse__new_(bytes))

fn remote_write_file(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, path: String, content: FsWriteFileContent) -> Result<(), String>:
    let parsed = parse_remote_virtual_path(&path)?
    let connection = load_remote_connection(&app, &parsed.connection_id)?
    let session = (await get_or_connect_remote_session(&app, &state, &connection))?
    let actual_path = build_actual_remote_path(&connection.start_path, &parsed.relative_segments)?
    await write_remote_file_content(&session, &actual_path, content)

fn remote_create_file(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, parent_path: String, name: String, content: FsWriteFileContent) -> Result<(), String>:
    let parsed = parse_remote_virtual_path(&parent_path)?
    let connection = load_remote_connection(&app, &parsed.connection_id)?
    let session = (await get_or_connect_remote_session(&app, &state, &connection))?
    let child_name = normalize_remote_leaf_name(&name)?
    let mut relative_segments = parsed.relative_segments.clone()
    relative_segments.push(child_name)
    ()
    let actual_path = build_actual_remote_path(&connection.start_path, &relative_segments)?
    await write_remote_file_content(&session, &actual_path, content)

fn remote_create_directory(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, parent_path: String, name: String) -> Result<(), String>:
    let parsed = parse_remote_virtual_path(&parent_path)?
    let connection = load_remote_connection(&app, &parsed.connection_id)?
    let session = (await get_or_connect_remote_session(&app, &state, &connection))?
    let child_name = normalize_remote_leaf_name(&name)?
    let mut relative_segments = parsed.relative_segments.clone()
    relative_segments.push(child_name)
    ()
    let actual_path = build_actual_remote_path(&connection.start_path, &relative_segments)?
    await create_remote_directory(&session, &actual_path)

fn remote_rename_path(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, path: String, new_name: String) -> Result<(), String>:
    let parsed = parse_remote_virtual_path(&path)?
    if parsed.relative_segments.is_empty():
        return Result::Err("Remote root paths cannot be renamed.".to_string())
    let connection = load_remote_connection(&app, &parsed.connection_id)?
    let session = (await get_or_connect_remote_session(&app, &state, &connection))?
    let mut destination_segments = parsed.relative_segments.clone()
    *destination_segments.last_mut().expect("non-root remote paths always have at least one segment") = normalize_remote_leaf_name(&new_name)?
    ()
    let source_actual_path = build_actual_remote_path(&connection.start_path, &parsed.relative_segments)?
    let destination_actual_path = build_actual_remote_path(&connection.start_path, &destination_segments)?
    await rename_remote_path(&session, &source_actual_path, &destination_actual_path)

fn remote_delete_path(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, path: String) -> Result<(), String>:
    let parsed = parse_remote_virtual_path(&path)?
    if parsed.relative_segments.is_empty():
        return Result::Err("Remote root paths cannot be deleted.".to_string())
    let connection = load_remote_connection(&app, &parsed.connection_id)?
    let session = (await get_or_connect_remote_session(&app, &state, &connection))?
    let actual_path = build_actual_remote_path(&connection.start_path, &parsed.relative_segments)?
    await delete_remote_tree(&session, &actual_path)

fn remote_transfer_items(app: tauri::AppHandle, state: tauri::State<_, RemoteStorageState>, target_dir: String, sources: Array<String>, operation: FileTransferOperation) -> Result<Array<FileTransferResult>, String>:
    if sources.is_empty():
        return Result::Ok(Vec__new_())
    let target_remote = if target_dir.trim().starts_with("remote://"):
        Option::Some(parse_remote_virtual_path(&target_dir)?)
    else:
        none
    if sources.iter().any(|source| source.trim().starts_with("cloud://")) or target_dir.trim().starts_with("cloud://"):
        return Result::Err("Remote and cloud transfer mixing is not supported yet. Use a local staging folder.".to_string())
    let mut results = Vec__new_()
    for source in sources:
        let destination_path = (await transfer_single_source(&app, &state, target_remote, &target_dir, &source, operation))?
        let content_revision = explorer_identity__build_content_revision(0, now_ms(), false, false)
        let identity = explorer_identity__build_virtual_identity("remote-transfer", &format!("{source}->{destination_path}::{operation:?}"), &content_revision)
        results.push(FileTransferResult { source_path: source.clone(), destination_path: destination_path, operation: operation, collision_policy: FileTransferCollisionPolicy::KeepBoth, disposition: FileTransferDisposition::Transferred, entity_id: identity.entity_id, identity_kind: identity.identity_kind, content_revision: identity.content_revision })
        ()
    ()
    Result::Ok(results)

fn transfer_single_source(app: &tauri::AppHandle, state: &RemoteStorageState, target_remote: Option<&RemoteVirtualPath>, target_dir: String, source: String, operation: FileTransferOperation) -> Result<String, String>:
    let source_is_remote = source.trim().starts_with("remote://")
    match (source_is_remote, target_remote):
        (true, Some(target_remote)) =>
            await transfer_remote_to_remote(app, state, source, target_remote, operation)
        (true, None) => await transfer_remote_to_local(app, state, source, target_dir, operation)
        (false, Some(target_remote)) =>
            await transfer_local_to_remote(app, state, source, target_remote, operation)
        (false, None) => Result::Err("remote_transfer_items only handles transfers with at least one remote endpoint.".to_string())

fn transfer_remote_to_local(app: &tauri::AppHandle, state: &RemoteStorageState, source: String, target_dir: String, operation: FileTransferOperation) -> Result<String, String>:
    let source_path = parse_remote_virtual_path(source)?
    let connection = load_remote_connection(app, &source_path.connection_id)?
    let session = (await get_or_connect_remote_session(app, state, &connection))?
    let source_actual_path = build_actual_remote_path(&connection.start_path, &source_path.relative_segments)?
    let source_metadata = (await stat_remote_path(&session, &source_actual_path))?
    let source_name = remote_virtual_leaf_name(&connection, &source_path)?
    let destination_path = resolve_local_keep_both_target_path(Path__new_(target_dir), &source_name)?
    if remote_attrs_is_dir(&source_metadata, true):
        (await copy_remote_directory_to_local(&session, &source_actual_path, &destination_path))?
        ()
        if operation == FileTransferOperation::Move:
            (await delete_remote_tree(&session, &source_actual_path))?
            ()
            ()
            ()
            ()
        ()
    else:
        (await copy_remote_file_to_local(&session, &source_actual_path, &destination_path))?
        ()
        if operation == FileTransferOperation::Move:
            (await delete_remote_file(&session, &source_actual_path))?
            ()
            ()
            ()
            ()
        ()
    Result::Ok(destination_path.to_string_lossy().into_owned())

fn transfer_local_to_remote(app: &tauri::AppHandle, state: &RemoteStorageState, source: String, target_remote: &RemoteVirtualPath, operation: FileTransferOperation) -> Result<String, String>:
    let connection = load_remote_connection(app, &(*target_remote).connection_id)?
    let session = (await get_or_connect_remote_session(app, state, &connection))?
    let source_path = PathBuf__from(source)
    let metadata = std__fs__symlink_metadata(&source_path).map_err(|error| format!("Failed to inspect local transfer source {}: {error}", source_path.display()))?
    let source_name = (source_path.file_name().and_then(OsStr__to_str).ok_or_else(|| format!("Unable to derive a transfer name for {}", source_path.display()))?).to_string()
    let target_path = (await resolve_remote_keep_both_target_path(&session, &connection.start_path, &(*target_remote).relative_segments, &source_name))?
    if metadata.is_dir():
        (await copy_local_directory_to_remote(&source_path, &session, &target_path))?
        ()
        if operation == FileTransferOperation::Move:
            std__fs__remove_dir_all(&source_path).map_err(|error| format!("Failed to remove local directory {} after move: {error}", source_path.display()))?
            ()
            ()
            ()
            ()
        ()
    else:
        (await copy_local_file_to_remote(&source_path, &session, &target_path))?
        ()
        if operation == FileTransferOperation::Move:
            std__fs__remove_file(&source_path).map_err(|error| format!("Failed to remove local file {} after move: {error}", source_path.display()))?
            ()
            ()
            ()
            ()
        ()
    Result::Ok(build_remote_virtual_path_from_actual(&connection, &target_path)?)

fn transfer_remote_to_remote(app: &tauri::AppHandle, state: &RemoteStorageState, source: String, target_remote: &RemoteVirtualPath, operation: FileTransferOperation) -> Result<String, String>:
    let source_path = parse_remote_virtual_path(source)?
    let source_connection = load_remote_connection(app, &source_path.connection_id)?
    let target_connection = load_remote_connection(app, &(*target_remote).connection_id)?
    let source_session = (await get_or_connect_remote_session(app, state, &source_connection))?
    let target_session = (await get_or_connect_remote_session(app, state, &target_connection))?
    let source_actual_path = build_actual_remote_path(&source_connection.start_path, &source_path.relative_segments)?
    let source_metadata = (await stat_remote_path(&source_session, &source_actual_path))?
    let source_name = remote_virtual_leaf_name(&source_connection, &source_path)?
    let target_actual_path = (await resolve_remote_keep_both_target_path(&target_session, &target_connection.start_path, &(*target_remote).relative_segments, &source_name))?
    let same_connection = source_connection.id == target_connection.id
    if operation == FileTransferOperation::Move and same_connection:
        (await rename_remote_path(&source_session, &source_actual_path, &target_actual_path))?
        ()
        return Result::Ok(build_remote_virtual_path_from_actual(&target_connection, &target_actual_path)?)
    if remote_attrs_is_dir(&source_metadata, source_path.relative_segments.is_empty()):
        (await copy_remote_directory_to_remote(&source_session, &source_actual_path, &target_session, &target_actual_path))?
        ()
        if operation == FileTransferOperation::Move:
            (await delete_remote_tree(&source_session, &source_actual_path))?
            ()
            ()
            ()
            ()
        ()
    else:
        (await copy_remote_file_to_remote(&source_session, &source_actual_path, &target_session, &target_actual_path))?
        ()
        if operation == FileTransferOperation::Move:
            (await delete_remote_file(&source_session, &source_actual_path))?
            ()
            ()
            ()
            ()
        ()
    Result::Ok(build_remote_virtual_path_from_actual(&target_connection, &target_actual_path)?)

fn copy_remote_directory_to_local(session: &RemoteSftpSession, source_actual_path: String, destination_path: &std::path::Path) -> Result<(), String>:
    std__fs__create_dir_all(destination_path).map_err(|error| format!("Failed to create destination directory {}: {error}", destination_path.display()))?
    ()
    let mut reader = (await open_remote_directory(session, source_actual_path))?
    loop:
        match (await reader.next()).map_err(|error| remote_operation_error(error, true).message)?:
            Some(entry) =>
                let entry_name = remote_dir_entry_name(&entry)
                let child_source_path = format!("{}/{}", trim_trailing_slashes(source_actual_path), entry_name)
                let child_destination = destination_path.join(&entry_name)
                if remote_dir_entry_is_dir(&entry):
                    (await copy_remote_directory_to_local(session, &child_source_path, &child_destination))?
                    ()
                else:
                    (await copy_remote_file_to_local(session, &child_source_path, &child_destination))?
                    ()
            _ => break
    ()
    Result::Ok(())

fn copy_remote_directory_to_remote(source_session: &RemoteSftpSession, source_actual_path: String, target_session: &RemoteSftpSession, target_actual_path: String) -> Result<(), String>:
    (await create_remote_directory(target_session, target_actual_path))?
    ()
    let mut reader = (await open_remote_directory(source_session, source_actual_path))?
    loop:
        match (await reader.next()).map_err(|error| remote_operation_error(error, true).message)?:
            Some(entry) =>
                let entry_name = remote_dir_entry_name(&entry)
                let child_source_path = format!("{}/{}", trim_trailing_slashes(source_actual_path), entry_name)
                let child_target_path = format!("{}/{}", trim_trailing_slashes(target_actual_path), entry_name)
                if remote_dir_entry_is_dir(&entry):
                    (await copy_remote_directory_to_remote(source_session, &child_source_path, target_session, &child_target_path))?
                    ()
                else:
                    (await copy_remote_file_to_remote(source_session, &child_source_path, target_session, &child_target_path))?
                    ()
            _ => break
    ()
    Result::Ok(())

fn copy_local_directory_to_remote(source_path: &std::path::Path, session: &RemoteSftpSession, target_actual_path: String) -> Result<(), String>:
    (await create_remote_directory(session, target_actual_path))?
    ()
    let entries = std__fs__read_dir(source_path).map_err(|error| format!("Failed to read local directory {} for upload: {error}", source_path.display()))?
    for entry in entries:
        let entry = entry.map_err(|error| format!("Failed to read local directory entry: {error}"))?
        let metadata = entry.metadata().map_err(|error| format!("Failed to inspect local upload entry {}: {error}", entry.path().display()))?
        let child_name = entry.file_name().to_string_lossy().into_owned()
        let child_target_path = format!("{}/{}", trim_trailing_slashes(target_actual_path), child_name)
        if metadata.is_dir():
            (await copy_local_directory_to_remote(&entry.path(), session, &child_target_path))?
            ()
        else:
            (await copy_local_file_to_remote(&entry.path(), session, &child_target_path))?
            ()
    ()
    Result::Ok(())

fn copy_local_file_to_remote(source_path: &std::path::Path, session: &RemoteSftpSession, target_actual_path: String) -> Result<(), String>:
    let mut source_file = (await File__open(source_path)).map_err(|error| format!("Failed to open local upload source {}: {error}", source_path.display()))?
    let mut target_file = (await open_remote_file_for_write(session, target_actual_path))?
    (await tokio__io__copy(&mut source_file, &mut target_file)).map_err(|error| format!("Failed to upload {}: {error}", source_path.display()))?
    ()
    (await target_file.shutdown()).map_err(|error| format!("Failed to finalize remote upload to {target_actual_path}: {error}"))?
    ()
    Result::Ok(())

fn copy_remote_file_to_local(session: &RemoteSftpSession, source_actual_path: String, destination_path: &std::path::Path) -> Result<(), String>:
    match destination_path.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create local destination directory {}: {error}", parent.display()))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let mut source_file = (await open_remote_file_for_read(session, source_actual_path))?
    let mut destination_file = (await File__create(destination_path)).map_err(|error| format!("Failed to create local destination {}: {error}", destination_path.display()))?
    (await tokio__io__copy(&mut source_file, &mut destination_file)).map_err(|error| format!("Failed to download remote file {source_actual_path}: {error}"))?
    ()
    (await destination_file.flush()).map_err(|error| format!("Failed to flush local destination {}: {error}", destination_path.display()))?
    ()
    Result::Ok(())

fn copy_remote_file_to_remote(source_session: &RemoteSftpSession, source_actual_path: String, target_session: &RemoteSftpSession, target_actual_path: String) -> Result<(), String>:
    let mut source_file = (await open_remote_file_for_read(source_session, source_actual_path))?
    let mut target_file = (await open_remote_file_for_write(target_session, target_actual_path))?
    (await tokio__io__copy(&mut source_file, &mut target_file)).map_err(|error| format!("Failed to copy remote file {source_actual_path}: {error}"))?
    ()
    (await target_file.shutdown()).map_err(|error| format!("Failed to finalize remote copy to {target_actual_path}: {error}"))?
    ()
    Result::Ok(())

fn stage_remote_file(app: &tauri::AppHandle, state: &RemoteStorageState, path: String) -> Result<std::path::PathBuf, String>:
    let parsed = parse_remote_virtual_path(path)?
    let connection = load_remote_connection(app, &parsed.connection_id)?
    let session = (await get_or_connect_remote_session(app, state, &connection))?
    let actual_path = build_actual_remote_path(&connection.start_path, &parsed.relative_segments)?
    let mut source_file = (await open_remote_file_for_read(&session, &actual_path))?
    let temp_root = remote_temp_root_path(app)?
    let file_name = remote_virtual_leaf_name(&connection, &parsed)?
    let staged_path = temp_root.join(format!("{}-{}", Uuid__new_v4(), file_name))
    let mut destination_file = (await File__create(&staged_path)).map_err(|error| format!("Failed to create staged remote file {}: {error}", staged_path.display()))?
    (await tokio__io__copy(&mut source_file, &mut destination_file)).map_err(|error| format!("Failed to stage remote file {path}: {error}"))?
    ()
    (await destination_file.flush()).map_err(|error| format!("Failed to flush staged remote file {}: {error}", staged_path.display()))?
    ()
    Result::Ok(staged_path)

fn read_remote_file_bytes(app: &tauri::AppHandle, state: &RemoteStorageState, path: String, max_bytes: u64) -> Result<Array<u8>, String>:
    let parsed = parse_remote_virtual_path(path)?
    let connection = load_remote_connection(app, &parsed.connection_id)?
    let session = (await get_or_connect_remote_session(app, state, &connection))?
    let actual_path = build_actual_remote_path(&connection.start_path, &parsed.relative_segments)?
    let attrs = (await stat_remote_path(&session, &actual_path))?
    if attrs.size.unwrap_or(0) > max_bytes:
        return Result::Err(format!("Remote file is too large for preview transport (> {}).", format_preview_byte_limit(max_bytes)))
    let mut file = (await open_remote_file_for_read(&session, &actual_path))?
    let mut bytes = Vec__new_()
    (await file.read_to_end(&mut bytes)).map_err(|error| format!("Failed to read remote file {path}: {error}"))?
    ()
    Result::Ok(bytes)

fn open_remote_directory(session: &RemoteSftpSession, actual_path: String) -> Result<yazi_sftp::fs::ReadDir, String>:
    let operator_ = await (*session).operator_.lock()
    (await operator_.read_dir(actual_path)).map_err(|error| remote_operation_error(error, true).message)

fn open_remote_file_for_read(session: &RemoteSftpSession, actual_path: String) -> Result<yazi_sftp::fs::File, String>:
    let operator_ = await (*session).operator_.lock()
    (await operator_.open(actual_path, yazi_sftp::fs::Flags::READ, &Attrs__default_())).map_err(|error| remote_operation_error(error, true).message)

fn open_remote_file_for_write(session: &RemoteSftpSession, actual_path: String) -> Result<yazi_sftp::fs::File, String>:
    let operator_ = await (*session).operator_.lock()
    (await operator_.open(actual_path, yazi_sftp::fs::Flags::WRITE | yazi_sftp::fs::Flags::CREATE | yazi_sftp::fs::Flags::TRUNCATE, &Attrs__default_())).map_err(|error| remote_operation_error(error, true).message)

fn write_remote_file_content(session: &RemoteSftpSession, actual_path: String, content: FsWriteFileContent) -> Result<(), String>:
    let mut file = (await open_remote_file_for_write(session, actual_path))?
    let bytes = match content:
        FsWriteFileContent::Text(text) => text.into_bytes()
        FsWriteFileContent::Bytes(bytes) => bytes
    (await file.write_all(&bytes)).map_err(|error| format!("Failed to write remote file {actual_path}: {error}"))?
    ()
    (await file.shutdown()).map_err(|error| format!("Failed to finalize remote file write {actual_path}: {error}"))

fn create_remote_directory(session: &RemoteSftpSession, actual_path: String) -> Result<(), String>:
    let operator_ = await (*session).operator_.lock()
    match await operator_.mkdir(actual_path, Attrs__default_()):
        Ok(()) => Result::Ok(())
        Err(yazi_sftp::Error::Status(status)) if matches!(status.code, yazi_sftp::responses::StatusCode::FileAlreadyExists) =>
            Result::Ok(())
        Err(error) => Result::Err(remote_operation_error(error, true).message)

fn rename_remote_path(session: &RemoteSftpSession, from_actual_path: String, to_actual_path: String) -> Result<(), String>:
    let operator_ = await (*session).operator_.lock()
    match await operator_.rename_posix(from_actual_path, to_actual_path):
        Ok(()) => Result::Ok(())
        Err(yazi_sftp::Error::Unsupported) => (await operator_.rename(from_actual_path, to_actual_path)).map_err(|error| remote_operation_error(error, true).message)
        Err(error) => Result::Err(remote_operation_error(error, true).message)

fn delete_remote_tree(session: &RemoteSftpSession, actual_path: String) -> Result<(), String>:
    let attrs = (await stat_remote_path(session, actual_path))?
    if remote_attrs_is_dir(&attrs, false):
        let mut reader = (await open_remote_directory(session, actual_path))?
        loop:
            match (await reader.next()).map_err(|error| remote_operation_error(error, true).message)?:
                Some(entry) =>
                    let child_name = remote_dir_entry_name(&entry)
                    let child_path = format!("{}/{}", trim_trailing_slashes(actual_path), child_name)
                    if remote_dir_entry_is_dir(&entry):
                        (await delete_remote_tree(session, &child_path))?
                        ()
                    else:
                        (await delete_remote_file(session, &child_path))?
                        ()
                _ => break
        ()
        let operator_ = await (*session).operator_.lock()
        (await operator_.rmdir(actual_path)).map_err(|error| remote_operation_error(error, true).message)
    else:
        await delete_remote_file(session, actual_path)

fn delete_remote_file(session: &RemoteSftpSession, actual_path: String) -> Result<(), String>:
    let operator_ = await (*session).operator_.lock()
    (await operator_.remove(actual_path)).map_err(|error| remote_operation_error(error, true).message)

fn stat_remote_path(session: &RemoteSftpSession, actual_path: String) -> Result<yazi_sftp::fs::Attrs, String>:
    let operator_ = await (*session).operator_.lock()
    (await operator_.stat(actual_path)).map_err(|error| remote_operation_error(error, true).message)

fn resolve_remote_keep_both_target_path(session: &RemoteSftpSession, root_start_path: String, target_relative_segments: &Slice<String>, source_name: String) -> Result<String, String>:
    let mut candidate_name = source_name.to_string()
    let mut counter = 2
    loop:
        let mut candidate_segments = target_relative_segments.to_vec()
        candidate_segments.push(candidate_name.clone())
        ()
        let candidate_path = build_actual_remote_path(root_start_path, &candidate_segments)?
        if !(await remote_path_exists(session, &candidate_path))?:
            return Result::Ok(candidate_path)
        candidate_name = make_keep_both_name(source_name, counter)
        ()
        counter = counter.saturating_add(1)
        ()

fn remote_path_exists(session: &RemoteSftpSession, actual_path: String) -> Result<Bool, String>:
    let operator_ = await (*session).operator_.lock()
    match await operator_.stat(actual_path):
        Ok(_) => Result::Ok(true)
        Err(yazi_sftp::Error::Status(status)) if matches!(status.code, yazi_sftp::responses::StatusCode::NoSuchFile | yazi_sftp::responses::StatusCode::NoSuchPath) =>
            Result::Ok(false)
        Err(error) => Result::Err(remote_operation_error(error, true).message)

fn resolve_local_keep_both_target_path(target_dir: &std::path::Path, source_name: String) -> Result<std::path::PathBuf, String>:
    std__fs__create_dir_all(target_dir).map_err(|error| format!("Failed to prepare local transfer destination {}: {error}", target_dir.display()))?
    ()
    let mut candidate_name = source_name.to_string()
    let mut counter = 2
    loop:
        let candidate_path = target_dir.join(&candidate_name)
        if !candidate_path.exists():
            return Result::Ok(candidate_path)
        candidate_name = make_keep_both_name(source_name, counter)
        ()
        counter = counter.saturating_add(1)
        ()

fn make_keep_both_name(source_name: String, counter: u32) -> String:
    let path = Path__new_(source_name)
    let stem = path.file_stem().and_then(OsStr__to_str).unwrap_or(source_name)
    let extension = path.extension().and_then(OsStr__to_str).unwrap_or_default()
    if extension.is_empty():
        format!("{stem} copy {counter}")
    else:
        format!("{stem} copy {counter}.{extension}")

fn get_or_connect_remote_session(app: &tauri::AppHandle, state: &RemoteStorageState, connection: &PersistedRemoteConnection) -> Result<RemoteSftpSession, String>:
    match (await (*state).sessions.lock()).get(&(*connection).id).cloned():
        Some(existing) =>
            let operator_ = await existing.operator_.lock()
            if !operator_.is_closed():
                drop(operator_)
                ()
                return Result::Ok(existing)
            drop(operator_)
            ()
            (await (*state).sessions.lock()).remove(&(*connection).id)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    update_remote_status(state, &(*connection).id, RemoteConnectionStatus::Connecting, none)?
    ()
    match await connect_remote_session(app, state, connection):
        Ok(session) =>
            (await (*state).sessions.lock()).insert((*connection).id.clone(), session.clone())
            ()
            update_remote_status(state, &(*connection).id, RemoteConnectionStatus::Connected, none)?
            ()
            clear_pending_host_verification(&(*state).pending_host_verifications, &(*connection).id)?
            ()
            Result::Ok(session)
        Err(error) =>
            let status = if has_pending_host_verification(state, &(*connection).id)?:
                RemoteConnectionStatus::UntrustedHost
            else:
                RemoteConnectionStatus::Error
            update_remote_status(state, &(*connection).id, status, Option::Some(error.clone()))?
            ()
            Result::Err(error)

fn connect_remote_session(app: &tauri::AppHandle, state: &RemoteStorageState, connection: &PersistedRemoteConnection) -> Result<RemoteSftpSession, String>:
    let trusted_host = (read_trusted_hosts(app)?).hosts.into_iter().find(|entry| entry.host == (*connection).host and entry.port == (*connection).port)
    let pending_host_verifications = (*state).pending_host_verifications.clone()
    let handler = RemoteClientHandler { connection_id: (*connection).id.clone(), host: (*connection).host.clone(), port: (*connection).port, trusted_host: trusted_host, pending_host_verifications: pending_host_verifications }
    let config = Arc__new_(russh::client::Config { inactivity_timeout: Option::Some(Duration__from_secs(60)), keepalive_interval: Option::Some(Duration__from_secs(10)), ..Default__default_() })
    let mut client = (await russh__client__connect(config, ((*connection).host.as_str(), (*connection).port), handler)).map_err(|error| format!("Failed to connect to {}:{}: {error}", (*connection).host, (*connection).port))?
    (await authenticate_remote_client(connection, &mut client))?
    ()
    let channel = (await client.channel_open_session()).map_err(|error| format!("Failed to open remote SSH session: {error}"))?
    (await channel.request_subsystem(true, "sftp")).map_err(|error| format!("Failed to request the remote SFTP subsystem: {error}"))?
    ()
    let mut operator_ = Operator__make(channel.into_stream())
    (await operator_.init()).map_err(|error| format!("Failed to initialize the remote SFTP operator: {error}"))?
    ()
    Result::Ok(Arc__new_(RemoteSftpSession { operator_: Mutex__new_(operator_) }))

fn authenticate_remote_client(connection: &PersistedRemoteConnection, client: &mut russh::client::Handle<RemoteClientHandler>) -> Result<(), String>:
    match (*connection).auth_mode:
        RemoteAuthMode::Password =>
            let password = read_remote_password(&(*connection).id)?
            let result = (await client.authenticate_password(&(*connection).username, &password)).map_err(|error| format!("Password authentication failed: {error}"))?
            if result.success():
                Result::Ok(())
            else:
                Result::Err("Password authentication failed.".to_string())
        RemoteAuthMode::PrivateKeyFile =>
            let private_key_path = (*connection).private_key_path.ok_or_else(|| "Private-key authentication requires a private key path.".to_string())?
            let key_contents = std__fs__read_to_string(private_key_path).map_err(|error| format!("Failed to read private key file {private_key_path}: {error}"))?
            let key = russh__keys__decode_secret_key(&key_contents, read_remote_key_passphrase(&(*connection).id).ok()).map_err(|error| format!("Failed to decode the private key: {error}"))?
            let result = (await client.authenticate_publickey(&(*connection).username, PrivateKeyWithHashAlg__new_(Arc__new_(key), ((await client.best_supported_rsa_hash()).map_err(|error| format!("Failed to negotiate an SSH public-key hash algorithm: {error}"))?).flatten()))).map_err(|error| format!("Private-key authentication failed: {error}"))?
            if result.success():
                Result::Ok(())
            else:
                Result::Err("Private-key authentication failed.".to_string())

fn remote_disconnect_inner(state: &RemoteStorageState, connection_id: String) -> Result<(), String>:
    (await (*state).sessions.lock()).remove(connection_id)
    ()
    update_remote_status(state, connection_id, RemoteConnectionStatus::Disconnected, none)

fn disconnect_sessions_for_host(app: &tauri::AppHandle, state: &RemoteStorageState, host: String, port: u16) -> Result<(), String>:
    let connections = read_remote_connections(app)?
    for connection in connections.connections.into_iter().filter(|connection| connection.host == host and connection.port == port):
        (await remote_disconnect_inner(state, &connection.id))?
        ()
    ()
    Result::Ok(())

fn summarize_remote_connection(state: &RemoteStorageState, connection: PersistedRemoteConnection) -> Result<RemoteConnectionSummary, String>:
    let statuses = clone_remote_statuses(state)?
    let pending = clone_pending_host_verifications(state)?
    let runtime = statuses.get(&connection.id)
    Result::Ok(RemoteConnectionSummary { id: connection.id.clone(), label: connection.label, protocol: connection.protocol, host: connection.host, port: connection.port, username: connection.username, start_path: connection.start_path, auth_mode: connection.auth_mode, private_key_path: connection.private_key_path, status: runtime.map(|status| status.status).unwrap_or(RemoteConnectionStatus::Disconnected), last_error: runtime.and_then(|status| status.last_error.clone()), pending_host_verification: pending.get(&connection.id).cloned() })

fn update_remote_status(state: &RemoteStorageState, connection_id: String, status: RemoteConnectionStatus, last_error: Option<String>) -> Result<(), String>:
    let mut statuses = (*state).statuses.lock().map_err(|_| "remote connection status lock poisoned".to_string())?
    statuses.insert(connection_id.to_string(), RemoteConnectionRuntimeStatus { status: status, last_error: last_error })
    ()
    Result::Ok(())

fn clear_remote_status(state: &RemoteStorageState, connection_id: String) -> Result<(), String>:
    let mut statuses = (*state).statuses.lock().map_err(|_| "remote connection status lock poisoned".to_string())?
    statuses.remove(connection_id)
    ()
    Result::Ok(())

fn clone_remote_statuses(state: &RemoteStorageState) -> Result<Map<String, RemoteConnectionRuntimeStatus>, String>:
    (*state).statuses.lock().map_err(|_| "remote connection status lock poisoned".to_string()).map(|statuses| statuses.clone())

fn clone_pending_host_verifications(state: &RemoteStorageState) -> Result<Map<String, RemotePendingHostVerification>, String>:
    (*state).pending_host_verifications.lock().map_err(|_| "remote pending host verification lock poisoned".to_string()).map(|pending| pending.clone())

fn has_pending_host_verification(state: &RemoteStorageState, connection_id: String) -> Result<Bool, String>:
    (*state).pending_host_verifications.lock().map_err(|_| "remote pending host verification lock poisoned".to_string()).map(|pending| pending.contains_key(connection_id))

fn record_pending_host_verification(pending_host_verifications: &Map<String, RemotePendingHostVerification>, verification: RemotePendingHostVerification) -> Result<(), russh::Error>:
    (pending_host_verifications.lock().map_err(|_| russh::Error::InvalidConfig("remote pending host verification lock poisoned".to_string()))?).insert(verification.connection_id.clone(), verification)
    ()
    Result::Ok(())

fn clear_pending_host_verification(pending_host_verifications: &Map<String, RemotePendingHostVerification>, connection_id: String) -> Result<(), String>:
    (pending_host_verifications.lock().map_err(|_| "remote pending host verification lock poisoned".to_string())?).remove(connection_id)
    ()
    Result::Ok(())

fn clear_pending_hosts_for_target(pending_host_verifications: &Map<String, RemotePendingHostVerification>, host: String, port: u16) -> Result<(), String>:
    let mut pending = pending_host_verifications.lock().map_err(|_| "remote pending host verification lock poisoned".to_string())?
    pending.retain(|_, verification| verification.host != host or verification.port != port)
    ()
    Result::Ok(())

fn observe_remote_host_key(public_key: &russh::keys::PublicKey) -> RemoteHostKeyObservation:
    RemoteHostKeyObservation { algorithm: public_key.algorithm().to_string(), fingerprint_sha256: public_key.fingerprint(russh::keys::HashAlg::Sha256).to_string(), public_key: public_key.public_key_base64() }

fn remote_storage_root(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let root = (app.path().app_local_data_dir().map_err(|error| format!("Failed to resolve the app local data directory: {error}"))?).join(REMOTE_STORAGE_DIRECTORY)
    std__fs__create_dir_all(&root).map_err(|error| format!("Failed to create the remote-storage data directory: {error}"))?
    ()
    Result::Ok(root)

fn remote_connections_file_path(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    Result::Ok((remote_storage_root(app)?).join(REMOTE_CONNECTIONS_FILE))

fn remote_trusted_hosts_file_path(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    Result::Ok((remote_storage_root(app)?).join(REMOTE_TRUSTED_HOSTS_FILE))

fn remote_temp_root_path(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let root = (remote_storage_root(app)?).join(REMOTE_TEMP_DIRECTORY)
    std__fs__create_dir_all(&root).map_err(|error| format!("Failed to create the remote temp directory: {error}"))?
    ()
    Result::Ok(root)

fn read_remote_connections(app: &tauri::AppHandle) -> Result<PersistedRemoteConnections, String>:
    let path = remote_connections_file_path(app)?
    if !path.exists():
        return Result::Ok(PersistedRemoteConnections { connections: Vec__new_() })
    let content = std__fs__read_to_string(&path).map_err(|error| format!("Failed to read persisted remote connections: {error}"))?
    serde_json__from_str(&content).map_err(|error| format!("Failed to parse persisted remote connections: {error}"))

fn write_remote_connections(app: &tauri::AppHandle, connections: &PersistedRemoteConnections) -> Result<(), String>:
    let path = remote_connections_file_path(app)?
    let content = serde_json__to_string_pretty(connections).map_err(|error| format!("Failed to serialize persisted remote connections: {error}"))?
    std__fs__write(&path, content).map_err(|error| format!("Failed to persist remote connections: {error}"))

fn upsert_remote_connection(app: &tauri::AppHandle, next: PersistedRemoteConnection) -> Result<(), String>:
    let mut connections = read_remote_connections(app)?
    match connections.connections.iter_mut().find(|connection| connection.id == next.id):
        Some(existing) =>
            *existing = next
            ()
            ()
            ()
            ()
        _ =>
            connections.connections.push(next)
            ()
            ()
            ()
            ()
    connections.connections.sort_by(|left, right| left.label.to_ascii_lowercase().cmp(&right.label.to_ascii_lowercase()).then_with(|| left.host.cmp(&right.host)).then_with(|| left.start_path.cmp(&right.start_path)))
    ()
    write_remote_connections(app, &connections)

fn remove_remote_connection(app: &tauri::AppHandle, connection_id: String) -> Result<(), String>:
    let mut connections = read_remote_connections(app)?
    connections.connections.retain(|connection| connection.id != connection_id)
    ()
    write_remote_connections(app, &connections)

fn load_remote_connection(app: &tauri::AppHandle, connection_id: String) -> Result<PersistedRemoteConnection, String>:
    (read_remote_connections(app)?).connections.into_iter().find(|connection| connection.id == connection_id).ok_or_else(|| "Remote connection was not found.".to_string())

fn read_trusted_hosts(app: &tauri::AppHandle) -> Result<PersistedTrustedHosts, String>:
    let path = remote_trusted_hosts_file_path(app)?
    if !path.exists():
        return Result::Ok(PersistedTrustedHosts__default_())
    let content = std__fs__read_to_string(&path).map_err(|error| format!("Failed to read the remote trusted-hosts store: {error}"))?
    serde_json__from_str(&content).map_err(|error| format!("Failed to parse the remote trusted-hosts store: {error}"))

fn write_trusted_hosts(app: &tauri::AppHandle, trusted_hosts: &PersistedTrustedHosts) -> Result<(), String>:
    let path = remote_trusted_hosts_file_path(app)?
    let content = serde_json__to_string_pretty(trusted_hosts).map_err(|error| format!("Failed to serialize trusted remote hosts: {error}"))?
    std__fs__write(&path, content).map_err(|error| format!("Failed to persist trusted remote hosts: {error}"))

fn upsert_trusted_host(app: &tauri::AppHandle, next: RemoteTrustedHostRecord) -> Result<(), String>:
    let mut trusted_hosts = read_trusted_hosts(app)?
    match trusted_hosts.hosts.iter_mut().find(|host| host.host == next.host and host.port == next.port):
        Some(existing) =>
            *existing = next
            ()
            ()
            ()
            ()
        _ =>
            trusted_hosts.hosts.push(next)
            ()
            ()
            ()
            ()
    trusted_hosts.hosts.sort_by(|left, right| left.host.cmp(&right.host).then_with(|| left.port.cmp(&right.port)))
    ()
    write_trusted_hosts(app, &trusted_hosts)

fn remove_trusted_host(app: &tauri::AppHandle, host: String, port: u16) -> Result<(), String>:
    let mut trusted_hosts = read_trusted_hosts(app)?
    trusted_hosts.hosts.retain(|entry| entry.host != host or entry.port != port)
    ()
    write_trusted_hosts(app, &trusted_hosts)

fn keyring_entry(connection_id: String, secret_kind: String) -> Result<keyring::Entry, String>:
    Entry__new_(REMOTE_KEYRING_SERVICE, &format!("{connection_id}:{secret_kind}")).map_err(|error| format!("Failed to open the remote-storage keychain entry: {error}"))

fn persist_remote_auth_secrets(connection: &PersistedRemoteConnection, request: &RemoteConnectionUpsertRequest, existing: Option<&PersistedRemoteConnection>) -> Result<(), String>:
    match (*connection).auth_mode:
        RemoteAuthMode::Password =>
            let password = (*request).password.map(str__trim).filter(|value| !value.is_empty()).map(str__to_string).or_else(|| existing.filter(|entry| entry.auth_mode == RemoteAuthMode::Password).and_then(|_| read_remote_password(&(*connection).id).ok())).ok_or_else(|| "Password authentication requires a password.".to_string())?
            (keyring_entry(&(*connection).id, "password")?).set_password(&password).map_err(|error| format!("Failed to store the remote password in the OS keychain: {error}"))?
            ()
            delete_remote_key_passphrase(&(*connection).id)?
            ()
            ()
            ()
            ()
        RemoteAuthMode::PrivateKeyFile =>
            delete_remote_password(&(*connection).id)?
            ()
            match (*request).key_passphrase:
                Some(value) if value.trim().is_empty() =>
                    delete_remote_key_passphrase(&(*connection).id)?
                    ()
                    ()
                Some(value) =>
                    (keyring_entry(&(*connection).id, "key-passphrase")?).set_password(value).map_err(|error| format!("Failed to store the remote private-key passphrase in the OS keychain: {error}"))?
                    ()
                    ()
                    ()
                    ()
                None =>
                    ()
            ()
    Result::Ok(())

fn delete_remote_auth_secrets(connection_id: String) -> Result<(), String>:
    delete_remote_password(connection_id)?
    ()
    delete_remote_key_passphrase(connection_id)?
    ()
    Result::Ok(())

fn delete_remote_password(connection_id: String) -> Result<(), String>:
    delete_keyring_secret(connection_id, "password")

fn delete_remote_key_passphrase(connection_id: String) -> Result<(), String>:
    delete_keyring_secret(connection_id, "key-passphrase")

fn delete_keyring_secret(connection_id: String, secret_kind: String) -> Result<(), String>:
    let entry = keyring_entry(connection_id, secret_kind)?
    match entry.delete_credential():
        Ok(()) | Err(keyring::Error::NoEntry) => Result::Ok(())
        Err(error) => Result::Err(format!("Failed to remove the remote {secret_kind} secret from the OS keychain: {error}"))

fn read_remote_password(connection_id: String) -> Result<String, String>:
    (keyring_entry(connection_id, "password")?).get_password().map_err(|error| format!("Failed to read the remote password from the OS keychain: {error}"))

fn read_remote_key_passphrase(connection_id: String) -> Result<String, String>:
    (keyring_entry(connection_id, "key-passphrase")?).get_password().map_err(|error| format!("Failed to read the remote private-key passphrase from the OS keychain: {error}"))

fn parse_remote_virtual_path(path: String) -> Result<RemoteVirtualPath, String>:
    let url = Url__parse(path).map_err(|error| format!("Invalid remote path: {error}"))?
    if url.scheme() != "remote":
        return Result::Err("Not a remote path.".to_string())
    if url.host_str() != Option::Some("sftp"):
        return Result::Err("Unsupported remote protocol in path.".to_string())
    let segments = url.path_segments().map(|segments| segments.collect()).ok_or_else(|| "Remote path is missing segments.".to_string())?
    if segments.len() < 2 or segments[1] != "root":
        return Result::Err("Unsupported remote path shape.".to_string())
    let connection_id = (urlencoding__decode(segments[0]).map_err(|error| format!("Invalid remote connection identifier: {error}"))?).into_owned()
    let relative_segments = normalize_remote_relative_segments(&segments[2..])?
    Result::Ok(RemoteVirtualPath { connection_id: connection_id, relative_segments: relative_segments })

fn build_remote_virtual_path(connection_id: String, relative_segments: &Slice<String>) -> String:
    let mut path = format!("remote://sftp/{}/root", urlencoding__encode(connection_id))
    for segment in relative_segments:
        path.push("/")
        ()
        path.push_str(&urlencoding__encode(segment))
        ()
    ()
    path

fn build_remote_virtual_path_from_actual(connection: &PersistedRemoteConnection, actual_path: String) -> Result<String, String>:
    let normalized_root = normalize_remote_start_path(&(*connection).start_path)?
    let normalized_actual = normalize_remote_join_path(actual_path)
    let relative_segments = if normalized_actual == normalized_root:
        Vec__new_()
    else:
        let root_prefix = if normalized_root.ends_with("/"):
            normalized_root.clone()
        else:
            format!("{normalized_root}/")
        let relative = normalized_actual.strip_prefix(&root_prefix).ok_or_else(|| "Remote path escaped the configured connection root.".to_string())?
        relative.split("/").filter(|segment| !segment.is_empty()).map(str__to_string).collect()
    Result::Ok(build_remote_virtual_path(&(*connection).id, &relative_segments))

fn normalize_remote_relative_segments(raw_segments: &Slice<String>) -> Result<Array<String>, String>:
    let mut normalized = Vec__new_()
    for raw_segment in raw_segments:
        if raw_segment.is_empty():
            continue
        let decoded = (urlencoding__decode(raw_segment).map_err(|error| format!("Invalid remote path segment: {error}"))?).into_owned()
        match decoded.as_str():
            "" | "." =>
                ()
            ".." =>
                if normalized.pop().is_none():
                    return Result::Err("Remote path cannot navigate above its configured root.".to_string())
            _ => normalized.push(decoded)
    ()
    Result::Ok(normalized)

fn build_actual_remote_path(start_path: String, relative_segments: &Slice<String>) -> Result<String, String>:
    let root = normalize_remote_start_path(start_path)?
    if relative_segments.is_empty():
        return Result::Ok(root)
    let joined_segments = relative_segments.join("/")
    if root == "/":
        Result::Ok(format!("/{joined_segments}"))
    else if root.ends_with("/"):
        Result::Ok(format!("{root}{joined_segments}"))
    else:
        Result::Ok(format!("{root}/{joined_segments}"))

fn normalize_remote_start_path(start_path: String) -> Result<String, String>:
    let trimmed = start_path.trim()
    if trimmed.is_empty():
        return Result::Err("Remote start path is required.".to_string())
    let normalized = normalize_remote_join_path(trimmed)
    if normalized.is_empty():
        return Result::Err("Remote start path is invalid.".to_string())
    Result::Ok(normalized)

fn normalize_remote_join_path(path: String) -> String:
    let mut normalized = path.replace("\\", "/")
    while normalized.contains("//"):
        normalized = normalized.replace("//", "/")
        ()
    ()
    if normalized.len() > 1:
        normalized = normalized.trim_end_matches("/").to_string()
        ()
        ()
        ()
        ()
    normalized

fn trim_trailing_slashes(path: String) -> String:
    if path == "/":
        path
    else:
        path.trim_end_matches("/")

fn build_remote_breadcrumbs(connection: &PersistedRemoteConnection, relative_segments: &Slice<String>) -> Array<RemoteBreadcrumb>:
    let mut breadcrumbs = vec!(RemoteBreadcrumb { label: (*connection).label.clone(), path: build_remote_virtual_path(&(*connection).id, &[]) })
    let mut current_segments = Vec__new_()
    for segment in relative_segments:
        current_segments.push(segment.clone())
        ()
        breadcrumbs.push(RemoteBreadcrumb { label: segment.clone(), path: build_remote_virtual_path(&(*connection).id, &current_segments) })
        ()
    ()
    breadcrumbs

fn normalize_required_text(value: String, label: String) -> Result<String, String>:
    let trimmed = value.trim()
    if trimmed.is_empty():
        return Result::Err(format!("{label} is required."))
    Result::Ok(trimmed.to_string())

fn normalize_remote_leaf_name(name: String) -> Result<String, String>:
    let trimmed = name.trim()
    if trimmed.is_empty():
        return Result::Err("Remote item name is required.".to_string())
    if trimmed == "." or trimmed == ".." or trimmed.contains("/") or trimmed.contains("\\"):
        return Result::Err("Remote item names cannot contain path separators or reserved relative segments.".to_string())
    Result::Ok(trimmed.to_string())

fn remote_virtual_leaf_name(connection: &PersistedRemoteConnection, path: &RemoteVirtualPath) -> Result<String, String>:
    match (*path).relative_segments.last():
        Some(leaf) =>
            return Result::Ok(leaf.clone())
        _ =>
            ()
            ()
    Path__new_(&(*connection).start_path).file_name().and_then(OsStr__to_str).filter(|value| !value.is_empty()).map(str__to_string).ok_or_else(|| "Remote root cannot be transferred because it does not have a stable leaf name.".to_string())

impl RemoteVirtualPath:
    fn parent_path(_self: &RemoteVirtualPath) -> Option<String>:
        if (*_self).relative_segments.is_empty():
            none
        else:
            Option::Some(build_remote_virtual_path(&(*_self).connection_id, &(*_self).relative_segments[..(*_self).relative_segments.len() - 1].iter().cloned().collect()))


fn remote_dir_entry_to_file_entry(connection: &PersistedRemoteConnection, parent: &RemoteVirtualPath, entry: yazi_sftp::fs::DirEntry) -> FileEntry:
    let name = remote_dir_entry_name(&entry)
    let mut relative_segments = (*parent).relative_segments.clone()
    relative_segments.push(name.clone())
    ()
    let path = build_remote_virtual_path(&(*connection).id, &relative_segments)
    let is_dir = remote_dir_entry_is_dir(&entry)
    let is_symlink = remote_dir_entry_is_symlink(&entry)
    let modified = entry.attrs().mtime.unwrap_or_default() as u64 * 1000
    let size = entry.attrs().size.unwrap_or_default()
    let content_revision = explorer_identity__build_content_revision(size, modified, is_dir, is_symlink)
    let identity = explorer_identity__build_virtual_identity("remote-sftp", &path, &content_revision)
    FileEntry { name: name.clone(), path: path, is_dir: is_dir, size: size, modified: modified, extension: if is_dir:
        String__new_()
    else:
        Path__new_(&name).extension().and_then(OsStr__to_str).unwrap_or_default().to_string(), is_hidden: name.starts_with("."), is_symlink: is_symlink, entity_id: identity.entity_id, identity_kind: identity.identity_kind, content_revision: identity.content_revision }

fn remote_dir_entry_name(entry: &yazi_sftp::fs::DirEntry) -> String:
    String__from_utf8_lossy(entry.name()).into_owned()

fn remote_dir_entry_is_dir(entry: &yazi_sftp::fs::DirEntry) -> Bool:
    remote_attrs_is_dir(entry.attrs(), false) or entry.long_name().first() == Option::Some(&100)

fn remote_dir_entry_is_symlink(entry: &yazi_sftp::fs::DirEntry) -> Bool:
    remote_attrs_is_symlink(entry.attrs()) or entry.long_name().first() == Option::Some(&108)

fn remote_attrs_is_dir(attrs: &yazi_sftp::fs::Attrs, assume_root_directory: Bool) -> Bool:
    match (*attrs).perm.map(|perm| perm & UNIX_S_IFMT):
        Some(mode) if mode == UNIX_S_IFDIR => true
        Some(_) => false
        None => assume_root_directory

fn remote_attrs_is_symlink(attrs: &yazi_sftp::fs::Attrs) -> Bool:
    matches!()

fn sort_entries(entries: &mut Slice<FileEntry>):
    entries.sort_by(|left, right| right.is_dir.cmp(&left.is_dir).then_with(|| left.name.to_ascii_lowercase().cmp(&right.name.to_ascii_lowercase())).then_with(|| left.path.cmp(&right.path)))
    ()

struct RemoteOperationError:
    message: String

fn remote_operation_error(error: yazi_sftp::Error, include_hint: Bool) -> RemoteOperationError:
    let message = match error:
        yazi_sftp::Error::Status(status) if include_hint =>
            format!("Remote SFTP request failed: {:?} ({})", status.code, status.message)
        other => format!("Remote SFTP operation failed: {other}")
    RemoteOperationError { message: message }

fn resolve_preview_byte_limit(requested_bytes: Option<u64>, hard_limit_bytes: u64) -> u64:
    requested_bytes.unwrap_or(hard_limit_bytes).max(1).min(hard_limit_bytes)

fn format_preview_byte_limit(limit_bytes: u64) -> String:
    if limit_bytes >= GB:
        format!("{:.1} GB", limit_bytes as f64 / GB as f64)
    else if limit_bytes >= MB:
        format!("{:.1} MB", limit_bytes as f64 / MB as f64)
    else if limit_bytes >= KB:
        format!("{:.1} KB", limit_bytes as f64 / KB as f64)
    else:
        format!("{limit_bytes} B")

fn now_ms() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).unwrap_or_default().as_millis() as u64

struct CacheKeyParts:
    runtime_id: String
    compiler: String
    toolchain_version: String
    target: String
    mode: String
    source_signature: String

impl CacheKeyParts<a>:
    fn finalize(_self: &CacheKeyParts<a>) -> String:
        let mut hasher = Sha256__new_()
        hasher.update((*_self).runtime_id.as_bytes())
        ()
        hasher.update([124])
        ()
        hasher.update((*_self).compiler.as_bytes())
        ()
        hasher.update([124])
        ()
        hasher.update((*_self).toolchain_version.as_bytes())
        ()
        hasher.update([124])
        ()
        hasher.update((*_self).target.as_bytes())
        ()
        hasher.update([124])
        ()
        hasher.update((*_self).mode.as_bytes())
        ()
        hasher.update([124])
        ()
        hasher.update((*_self).source_signature.as_bytes())
        ()
        format!("{:x}", hasher.finalize())


struct CompileCacheLayout:
    root_dir: std::path::PathBuf

impl CompileCacheLayout:
    fn from_app(app: &tauri::AppHandle) -> Result<CompileCacheLayout, String>:
        let local_data = app.path().app_local_data_dir().map_err(|error| format!("failed to resolve app local data dir: {error}"))?
        Result::Ok(CompileCacheLayout { root_dir: local_data.join("runtime-cache") })

    fn for_root(root: impl Into<std::path::PathBuf>) -> CompileCacheLayout:
        CompileCacheLayout { root_dir: root.into() }

    fn entry_for(_self: &CompileCacheLayout, key: String) -> CompileCacheEntry:
        let entry_dir = (*_self).root_dir.join(key)
        CompileCacheEntry { entry_dir: entry_dir, key: key.to_string() }


struct CompileCacheEntry:
    entry_dir: std::path::PathBuf
    key: String

impl CompileCacheEntry:
    fn artifact_path(_self: &CompileCacheEntry, artifact_name: String) -> std::path::PathBuf:
        (*_self).entry_dir.join(artifact_name)

    fn ensure_dir(_self: &CompileCacheEntry) -> Result<(), String>:
        std__fs__create_dir_all(&(*_self).entry_dir).map_err(|error| format!("Failed to create runtime cache entry {}: {error}", (*_self).entry_dir.to_string_lossy()))

    fn exists_and_has(_self: &CompileCacheEntry, artifact_name: String) -> Bool:
        (*_self).artifact_path(artifact_name).exists()


fn compute_source_signature(module_dir: &std::path::Path) -> Result<String, String>:
    let mut entries = Vec__new_()
    visit_for_signature("module", module_dir, module_dir, &mut entries)?
    ()
    for replacement_root in collect_local_go_replacement_roots(module_dir):
        if !replacement_root.path.exists():
            continue
        if same_canonical_path(module_dir, &replacement_root.path):
            continue
        visit_for_signature(&format!("go-replace/{}", replacement_root.label), &replacement_root.path, &replacement_root.path, &mut entries)?
        ()
    ()
    entries.sort_by(|a, b| a.field_0.cmp(&b.field_0))
    ()
    let mut hasher = Sha256__new_()
    for (relative_path, size, mtime, head) in entries:
        hasher.update(relative_path.as_bytes())
        ()
        hasher.update([124])
        ()
        hasher.update(size.to_le_bytes())
        ()
        hasher.update([124])
        ()
        hasher.update(mtime.to_le_bytes())
        ()
        hasher.update([124])
        ()
        hasher.update(&head)
        ()
        hasher.update([10])
        ()
    ()
    Result::Ok(format!("{:x}", hasher.finalize()))

struct SignatureRoot:
    label: String
    path: std::path::PathBuf

fn collect_local_go_replacement_roots(module_dir: &std::path::Path) -> Array<SignatureRoot>:
    let go_mod = module_dir.join("go.mod")
    let Ok(text) = std__fs__read_to_string(&go_mod)
    let mut roots = Vec__new_()
    let mut seen = BTreeSet__new_()
    let mut in_replace_block = false
    for raw_line in text.lines():
        let line_ = strip_go_mod_comment(raw_line).trim()
        if line_.is_empty():
            continue
        if line_ == "replace (":
            in_replace_block = true
            ()
            continue
        if in_replace_block and line_ == ")":
            in_replace_block = false
            ()
            continue
        let directive = match line_.strip_prefix("replace "):
            Some(rest) =>
                Option::Some(rest)
            _ =>
                if in_replace_block:
                    Option::Some(line_)
                else:
                    none
        let Some(directive) = directive
        let Some((label, path)) = parse_local_go_replace_target(module_dir, directive)
        if seen.insert(label.clone()):
            roots.push(SignatureRoot { label: label, path: path })
            ()
    ()
    roots

fn strip_go_mod_comment(line: String) -> String:
    line_.split_once("//").map(|__kain_closure_arg0| __kain_closure_arg0.__kain_tuple_0).unwrap_or(line_)

fn parse_local_go_replace_target(module_dir: &std::path::Path, directive: String) -> Option<(String, std::path::PathBuf)>:
    let (_, target) = directive.split_once("=>")?
    let target_path = (target.split_whitespace().next()?).trim()
    if !is_local_go_replace_path(target_path):
        return none
    let path = resolve_go_replace_path(module_dir, target_path)
    Option::Some((normalize_signature_path_label(target_path), path))

fn is_local_go_replace_path(path: String) -> Bool:
    let candidate = Path__new_(path)
    candidate.is_absolute() or path.starts_with(".")

fn resolve_go_replace_path(module_dir: &std::path::Path, target_path: String) -> std::path::PathBuf:
    let candidate = Path__new_(target_path)
    if candidate.is_absolute():
        candidate.to_path_buf()
    else:
        module_dir.join(candidate)

fn normalize_signature_path_label(path: String) -> String:
    path.replace("\\", "/").trim_matches("/").to_string()

fn same_canonical_path(left: &std::path::Path, right: &std::path::Path) -> Bool:
    match (left.canonicalize(), right.canonicalize()):
        (Ok(left), Ok(right)) => left == right
        _ => false

fn visit_for_signature(label_prefix: String, root: &std::path::Path, current: &std::path::Path, out: &mut Array<(String, u64, i64, Array<u8>)>) -> Result<(), String>:
    let entries = match std__fs__read_dir(current):
        Ok(entries) => entries
        Err(_) => return Result::Ok(())
    for entry in entries.flatten():
        let path = entry.path()
        let file_name = entry.file_name().to_string_lossy().to_string()
        if file_name.starts_with("."):
            continue
        if matches!(file_name.as_str(), "node_modules" | "target" | "dist" | "build" | "vendor" | ".cache" | ".runtime-cache" | "__pycache__"):
            continue
        let metadata = match entry.metadata():
            Ok(metadata) => metadata
            Err(_) => continue
        if metadata.is_dir():
            visit_for_signature(label_prefix, root, &path, out_)?
            ()
            continue
        let relative = path.strip_prefix(root).map(|p| p.to_string_lossy().replace("\\", "/").to_string()).unwrap_or_else(|_| path.to_string_lossy().to_string())
        let signature_path = format!("{label_prefix}/{relative}")
        let size = metadata.len()
        let mtime = metadata.modified().ok().and_then(|time| time.duration_since(std__time__UNIX_EPOCH).ok()).map(|duration| duration.as_secs() as i64).unwrap_or(0)
        let mut head = |__kain_ctor_arg0| Vec::new()(4096)
        if size > 0:
            match std__fs__read(&path):
                Ok(bytes) =>
                    head.extend(bytes.iter().take(4096))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        out_.push((signature_path, size, mtime, head))
        ()
    ()
    Result::Ok(())

struct ExternalRuntimeCommandRequest:
    runtime_id: String
    args: Array<String>
    stdin: Option<String>
    working_directory: Option<String>
    environment: Option<Map<String, String>>

struct ExternalRuntimeCommandResult:
    runtime_id: String
    exit_status: i32
    stdout: String
    stderr: String
    duration_ms: u64
    timed_out: Bool

fn run_native_command(manifest: &RuntimeManifest, binary_path: &std::path::Path, request: ExternalRuntimeCommandRequest) -> Result<ExternalRuntimeCommandResult, String>:
    if !matches!((*manifest).kind, RuntimeKind::NativeCommand):
        return Result::Err(format!("runtime {} is not a native-command (kind = {})", (*manifest).id, (*manifest).kind.as_str()))
    let timeout = (*manifest).command.and_then(|c| c.timeout_secs).map(Duration__from_secs).unwrap_or_else(|| Duration__from_secs(60))
    let started_at = Instant__now()
    let mut command = Command__new_(binary_path)
    command.args(&(*manifest).args).args(&request.args).envs((*manifest).env.iter()).stdin(
        if request.stdin.is_some():
            Stdio__piped()
        else:
            Stdio__null()
    ).stdout(Stdio__piped()).stderr(Stdio__piped())
    ()
    match request.environment:
        Some(env) =>
            command.envs(env.iter())
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let cwd = request.working_directory.clone().or_else(|| (*manifest).working_directory.clone()).unwrap_or_else(|| (*manifest).module_dir.clone())
    command.current_dir(&cwd)
    ()
    let mut child = command.spawn_().map_err(|error| format!("failed to spawn native-command {}: {error}", (*manifest).id))?
    match (request.stdin, child.stdin.take()):
        (Some(payload), Some(mut stdin)) =>
            let _ = stdin.write_all(payload.as_bytes())
            drop(stdin)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let mut timed_out = false
    let exit_status = loop:
        match child.try_wait():
            Ok(Some(status)) => break status
            Ok(None) =>
                if started_at.elapsed() >= timeout:
                    timed_out = true
                    ()
                    let _ = child.kill()
                    break child.wait().map_err(|error| format!("failed to wait on killed child: {error}"))?
                std__thread__sleep(Duration__from_millis(20))
                ()
            Err(error) => return Result::Err(format!("failed to poll native-command status: {error}"))
    let mut stdout = String__new_()
    let mut stderr = String__new_()
    match child.stdout.take():
        Some(mut handle) =>
            let _ = handle.read_to_string(&mut stdout)
            ()
        _ =>
            ()
            ()
    match child.stderr.take():
        Some(mut handle) =>
            let _ = handle.read_to_string(&mut stderr)
            ()
        _ =>
            ()
            ()
    Result::Ok(ExternalRuntimeCommandResult { runtime_id: (*manifest).id.clone(), exit_status: exit_status.code().unwrap_or(-1), stdout: stdout, stderr: stderr, duration_ms: started_at.elapsed().as_millis() as u64, timed_out: timed_out })

