fn semantic_search_manifest() -> &SemanticSearchFileTypeManifest:
    MANIFEST.get_or_init(|| serde_json__from_str(SEMANTIC_SEARCH_FILE_TYPES_JSON).expect("semantic search file-type manifest must decode"))

fn semantic_search_extensions() -> &Set<String>:
    EXTENSIONS.get_or_init(|| semantic_search_manifest().text_like_extensions.iter().map(|extension| extension.trim().to_ascii_lowercase()).filter(|extension| !extension.is_empty()).collect())

fn semantic_search_allowed_extension_list() -> Array<String>:
    let mut extensions = semantic_search_extensions().iter().cloned().collect()
    extensions.sort_unstable()
    ()
    extensions

fn semantic_search_path_to_string(path: &std::path::Path) -> String:
    path.to_string_lossy().to_string()

fn semantic_search_data_root(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let root = (app.path().app_local_data_dir().map_err(|error| format!("Failed to resolve semantic-search data root: {error}"))?).join("explorer").join(SEMANTIC_SEARCH_DIRECTORY)
    std__fs__create_dir_all(&root).map_err(|error| format!("Failed to create semantic-search data root: {error}"))?
    ()
    Result::Ok(root)

fn semantic_search_database_path(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    Result::Ok((semantic_search_data_root(app)?).join(SEMANTIC_SEARCH_DATABASE_FILENAME))

fn open_semantic_search_connection(app: &tauri::AppHandle) -> Result<rusqlite::Connection, String>:
    let database_path = semantic_search_database_path(app)?
    let connection = Connection__open(&database_path).map_err(|error| format!("Failed to open semantic-search database '{}': {error}", database_path.display()))?
    connection.pragma_update(none, "journal_mode", "WAL").map_err(|error| format!("Failed to enable semantic-search WAL mode: {error}"))?
    ()
    connection.pragma_update(none, "foreign_keys", "ON").map_err(|error| format!("Failed to enable semantic-search foreign keys: {error}"))?
    ()
    ensure_semantic_search_schema(&connection)?
    ()
    Result::Ok(connection)

fn ensure_semantic_search_schema(connection: &rusqlite::Connection) -> Result<(), String>:
    connection.execute_batch("\n            CREATE TABLE IF NOT EXISTS semantic_meta (\n              key TEXT PRIMARY KEY NOT NULL,\n              value TEXT NOT NULL\n            );\n\n            CREATE TABLE IF NOT EXISTS indexed_roots (\n              id TEXT PRIMARY KEY NOT NULL,\n              root_path TEXT NOT NULL UNIQUE,\n              model_id TEXT NOT NULL,\n              backend_kind TEXT NOT NULL,\n              provider_kind TEXT NOT NULL,\n              source_signature TEXT NOT NULL,\n              indexed_at_ms INTEGER NOT NULL,\n              file_count INTEGER NOT NULL,\n              chunk_count INTEGER NOT NULL,\n              last_error TEXT\n            );\n\n            CREATE TABLE IF NOT EXISTS indexed_files (\n              id TEXT PRIMARY KEY NOT NULL,\n              root_id TEXT NOT NULL,\n              path TEXT NOT NULL,\n              relative_path TEXT NOT NULL,\n              name TEXT NOT NULL,\n              extension TEXT NOT NULL,\n              size_bytes INTEGER NOT NULL,\n              modified_ms INTEGER NOT NULL,\n              chunk_count INTEGER NOT NULL,\n              snippet_preview TEXT NOT NULL,\n              embedding_json TEXT NOT NULL,\n              UNIQUE(root_id, path),\n              FOREIGN KEY(root_id) REFERENCES indexed_roots(id) ON DELETE CASCADE\n            );\n\n            CREATE TABLE IF NOT EXISTS indexed_chunks (\n              id TEXT PRIMARY KEY NOT NULL,\n              file_id TEXT NOT NULL,\n              chunk_index INTEGER NOT NULL,\n              line_start INTEGER,\n              line_end INTEGER,\n              snippet TEXT NOT NULL,\n              embedding_json TEXT NOT NULL,\n              UNIQUE(file_id, chunk_index),\n              FOREIGN KEY(file_id) REFERENCES indexed_files(id) ON DELETE CASCADE\n            );\n\n            CREATE INDEX IF NOT EXISTS indexed_files_root_id_idx\n              ON indexed_files(root_id);\n            CREATE INDEX IF NOT EXISTS indexed_chunks_file_id_idx\n              ON indexed_chunks(file_id);\n            ").map_err(|error| format!("Failed to initialize semantic-search schema: {error}"))?
    ()
    connection.execute("INSERT OR REPLACE INTO semantic_meta(key, value) VALUES ('schemaVersion', ?1)", params!(SEMANTIC_SEARCH_SCHEMA_VERSION.to_string())).map_err(|error| format!("Failed to persist semantic-search schema version: {error}"))?
    ()
    Result::Ok(())

fn canonicalize_local_directory(raw_path: String) -> Result<std::path::PathBuf, String>:
    let trimmed = raw_path.trim()
    if trimmed.is_empty():
        return Result::Err("Semantic-search root path cannot be empty.".to_string())
    let input_path = PathBuf__from(trimmed)
    let canonical_path = std__fs__canonicalize(&input_path).map_err(|error| format!("Failed to resolve semantic-search root '{}': {error}", input_path.display()))?
    if !canonical_path.is_dir():
        return Result::Err(format!("Semantic-search root is not a directory: {}", canonical_path.display()))
    Result::Ok(canonical_path)

fn canonicalize_local_file(raw_path: String) -> Result<std::path::PathBuf, String>:
    let trimmed = raw_path.trim()
    if trimmed.is_empty():
        return Result::Err("Semantic-search target path cannot be empty.".to_string())
    let input_path = PathBuf__from(trimmed)
    let canonical_path = std__fs__canonicalize(&input_path).map_err(|error| format!("Failed to resolve semantic-search target '{}': {error}", input_path.display()))?
    if !canonical_path.is_file():
        return Result::Err(format!("Semantic-search target is not a file: {}", canonical_path.display()))
    Result::Ok(canonical_path)

fn ensure_path_within_root(root_path: &std::path::Path, candidate_path: &std::path::Path) -> Result<(), String>:
    if candidate_path.starts_with(root_path):
        return Result::Ok(())
    Result::Err(format!("Semantic-search target '{}' is outside the indexed root '{}'.", candidate_path.display(), root_path.display()))

fn normalized_extension(path: &std::path::Path) -> Option<String>:
    path.extension().and_then(|value| value.to_str()).map(|value| value.trim().trim_start_matches(".").to_ascii_lowercase()).filter(|value| !value.is_empty())

fn is_indexable_semantic_file(path: &std::path::Path, metadata_len: u64) -> Bool:
    if metadata_len == 0 or metadata_len > SEMANTIC_SEARCH_MAX_INDEXABLE_FILE_BYTES:
        return false
    normalized_extension(path).map(|extension| semantic_search_extensions().contains(&extension)).unwrap_or(false)

fn compute_root_source_signature(root_path: &std::path::Path) -> Result<(String, u64), String>:
    let mut walker = WalkBuilder__new_(root_path)
    walker.standard_filters(true).require_git(false)
    ()
    let mut descriptors = Vec__new_()
    let mut indexed_file_count = 0
    for result in walker.build():
        let entry = result.map_err(|error| format!("Failed to walk semantic-search root '{}': {error}", root_path.display()))?
        let path = entry.path()
        let metadata = match std__fs__metadata(path):
            Ok(metadata) => metadata
            Err(error) =>
                return Result::Err(format!("Failed to inspect semantic-search candidate '{}': {error}", path.display()))
        if !metadata.is_file() or !is_indexable_semantic_file(path, metadata.len()):
            continue
        let relative_path = (path.strip_prefix(root_path).map_err(|error| format!("Failed to normalize semantic-search path '{}': {error}", path.display()))?).to_string_lossy().replace("\\", "/")
        let modified_ms = metadata.modified().ok().and_then(|value| value.duration_since(std__time__UNIX_EPOCH).ok()).map(|value| value.as_millis() as u64).unwrap_or(0)
        descriptors.push(format!("{relative_path}|{}|{modified_ms}", metadata.len()))
        ()
        indexed_file_count = indexed_file_count + 1
        ()
    ()
    descriptors.sort_unstable()
    ()
    let mut hasher = Sha256__new_()
    for descriptor in descriptors:
        hasher.update(descriptor.as_bytes())
        ()
        hasher.update([10])
        ()
    ()
    Result::Ok((format!("{:x}", hasher.finalize()), indexed_file_count))

fn read_indexed_root_row(connection: &rusqlite::Connection, root_path: String) -> Result<Option<IndexedRootRow>, String>:
    connection.query_row("\n            SELECT\n              file_count,\n              chunk_count,\n              indexed_at_ms,\n              model_id,\n              backend_kind,\n              provider_kind,\n              source_signature,\n              last_error\n            FROM indexed_roots\n            WHERE root_path = ?1\n            ", params!(root_path), |row| Result::Ok(IndexedRootRow { file_count: row.get(0)?, chunk_count: row.get(1)?, indexed_at: row.get(2)?, model_id: row.get(3)?, backend_kind: row.get(4)?, provider_kind: row.get(5)?, source_signature: row.get(6)?, last_error: row.get(7)? })).optional().map_err(|error| format!("Failed to read semantic-search index status: {error}"))

fn read_semantic_index_summary_for_root(app: &tauri::AppHandle, root_path: &std::path::Path) -> Result<ExplorerSemanticIndexSummary, String>:
    let connection = open_semantic_search_connection(app)?
    let root_path_string = semantic_search_path_to_string(root_path)
    let Some(row) = read_indexed_root_row(&connection, &root_path_string)?
    let (current_signature, _) = compute_root_source_signature(root_path)?
    Result::Ok(ExplorerSemanticIndexSummary { root_path: root_path_string, indexed: true, stale: current_signature != row.source_signature, file_count: row.file_count, chunk_count: row.chunk_count, indexed_at: Option::Some(row.indexed_at), model_id: Option::Some(row.model_id), backend_kind: Option::Some(row.backend_kind), provider_kind: Option::Some(row.provider_kind), last_error: row.last_error })

fn semantic_force_cpu(routing_mode: Option<AccelerationRoutingMode>) -> Bool:
    matches!(routing_mode, Option::Some(AccelerationRoutingMode::CpuOnly))

fn normalize_result_limit(limit: Option<usize>) -> usize:
    limit.unwrap_or(SEMANTIC_SEARCH_DEFAULT_RESULT_LIMIT).clamp(1, SEMANTIC_SEARCH_MAX_RESULT_LIMIT)

fn semantic_index_task_detail(mode: ExplorerSemanticIndexBuildMode, root_path: &std::path::Path, summary: Option<&ExplorerSemanticIndexSummary>) -> String:
    match mode:
        ExplorerSemanticIndexBuildMode::Build =>
            match summary:
                Some(summary) =>
                    format!("Indexed {} files into {} chunks via {} / {}.", summary.file_count, summary.chunk_count, summary.backend_kind.unwrap_or("unknown"), summary.provider_kind.unwrap_or("unknown"))
                _ =>
                    format!("Building semantic index for {}", root_path.display())
        ExplorerSemanticIndexBuildMode::Rebuild =>
            match summary:
                Some(summary) =>
                    format!("Rebuilt semantic index: {} files, {} chunks.", summary.file_count, summary.chunk_count)
                _ =>
                    format!("Rebuilding semantic index for {}", root_path.display())
        ExplorerSemanticIndexBuildMode::Clear =>
            format!("Cleared semantic index for {}", root_path.display())

fn semantic_index_task_registration(root_path: &std::path::Path, mode: ExplorerSemanticIndexBuildMode) -> ExplorerTaskRegistration:
    let title = match mode:
        ExplorerSemanticIndexBuildMode::Build =>
            format!("Build semantic index for {}", root_path.display())
        ExplorerSemanticIndexBuildMode::Rebuild =>
            format!("Rebuild semantic index for {}", root_path.display())
        ExplorerSemanticIndexBuildMode::Clear =>
            format!("Clear semantic index for {}", root_path.display())
    let detail = match mode:
        ExplorerSemanticIndexBuildMode::Build =>
            "Preparing manual semantic-index build".to_string()
        ExplorerSemanticIndexBuildMode::Rebuild => "Preparing semantic-index rebuild".to_string()
        ExplorerSemanticIndexBuildMode::Clear =>
            "Removing semantic-index data for this root".to_string()
    ExplorerTaskRegistration { kind: ExplorerTaskKind::SemanticIndex, title: title, detail: detail, source_paths: vec!(semantic_search_path_to_string(root_path)), destination_path: none, retry_context: none, can_undo: false }

fn semantic_search_db_path_string(app: &tauri::AppHandle) -> Result<String, String>:
    semantic_search_database_path(app).map(|path| semantic_search_path_to_string(&path))

fn run_semantic_index_task(app: tauri::AppHandle, task_id: String, request: ExplorerSemanticIndexBuildRequest) -> Result<(), String>:
    let root_path = canonicalize_local_directory(&request.root_path)?
    let db_path = semantic_search_db_path_string(&app)?
    let root_path_string = semantic_search_path_to_string(&root_path)
    let force_cpu = semantic_force_cpu(request.routing_mode)
    let _ = fs_commands__update_manual_explorer_task(&task_id, Option::Some("Preparing semantic-search runtime".to_string()), Option::Some(1), Option::Some(3))
    match request.mode:
        ExplorerSemanticIndexBuildMode::Clear =>
            let _: PythonSidecarDecodedActionResponse<PythonSemanticIndexStatusResult> = python_sidecar__call_sidecar_action_json(&app, request.config, python_sidecar__action_ids__SEMANTIC_DELETE_INDEX, Option::Some(PythonSemanticDeleteIndexPayload { db_path: db_path, root_path: root_path_string.clone() }), Option::Some(root_path_string.clone()), Option::Some(BTreeMap__from([("TOKENIZERS_PARALLELISM".to_string(), "false".to_string())]).into_iter().collect()), Option::Some(true))?
            let _ = fs_commands__complete_manual_explorer_task(&task_id, Option::Some(semantic_index_task_detail(request.mode, &root_path, none)), Option::Some(false))
            return Result::Ok(())
        ExplorerSemanticIndexBuildMode::Build | ExplorerSemanticIndexBuildMode::Rebuild =>
            ()
    let (source_signature, _) = compute_root_source_signature(&root_path)?
    let _ = fs_commands__update_manual_explorer_task(&task_id, Option::Some("Indexing local text/code files through the Python sidecar".to_string()), Option::Some(2), Option::Some(3))
    let _: PythonSidecarDecodedActionResponse<PythonSemanticIndexRootResult> = python_sidecar__call_sidecar_action_json(&app, request.config, python_sidecar__action_ids__SEMANTIC_INDEX_ROOT, Option::Some(PythonSemanticIndexRootPayload { db_path: db_path, root_path: root_path_string.clone(), allowed_extensions: semantic_search_allowed_extension_list(), max_file_bytes: SEMANTIC_SEARCH_MAX_INDEXABLE_FILE_BYTES, source_signature: source_signature, force_cpu: force_cpu, model_id: request.model_id.clone(), backend_preference: request.backend_preference.clone() }), Option::Some(root_path_string.clone()), Option::Some(BTreeMap__from([("TOKENIZERS_PARALLELISM".to_string(), "false".to_string())]).into_iter().collect()), Option::Some(true))?
    let summary = read_semantic_index_summary_for_root(&app, &root_path)?
    let _ = fs_commands__update_manual_explorer_task(&task_id, Option::Some("Finalizing semantic-search index metadata".to_string()), Option::Some(3), Option::Some(3))
    let _ = fs_commands__complete_manual_explorer_task(&task_id, Option::Some(semantic_index_task_detail(request.mode, &root_path, Option::Some(&summary))), Option::Some(false))
    Result::Ok(())

fn build_semantic_search_response(query_kind: ExplorerSemanticSearchQueryKind, stale_index: Bool, force_cpu: Bool, result_limit: usize, response: PythonSemanticSearchResponse) -> ExplorerSemanticSearchResponse:
    ExplorerSemanticSearchResponse { results: response.results, diagnostics: ExplorerSemanticSearchDiagnostics { query_kind: query_kind, backend_kind: response.diagnostics.backend_kind, provider_kind: response.diagnostics.provider_kind, model_id: response.diagnostics.model_id, indexed_file_count: response.diagnostics.indexed_file_count, indexed_chunk_count: response.diagnostics.indexed_chunk_count, stale_index: stale_index, result_limit: result_limit as u64, force_cpu: force_cpu } }

fn explorer_semantic_index_get_summary(app: tauri::AppHandle, root_path: String) -> Result<ExplorerSemanticIndexSummary, String>:
    let canonical_root = canonicalize_local_directory(&root_path)?
    (await tauri__async_runtime__spawn_blocking(|| read_semantic_index_summary_for_root(&app, &canonical_root))).map_err(|error| format!("Semantic index summary task failed to join: {error}"))?

fn explorer_semantic_index_build(app: tauri::AppHandle, request: ExplorerSemanticIndexBuildRequest) -> Result<ExplorerSemanticIndexBuildStartResponse, String>:
    let canonical_root = canonicalize_local_directory(&request.root_path)?
    let task_id = Uuid__new_v4().to_string()
    fs_commands__create_manual_explorer_task_with_id(task_id.clone(), semantic_index_task_registration(&canonical_root, request.mode))
    ()
    let thread_app = app.clone()
    let thread_request = ExplorerSemanticIndexBuildRequest { root_path: semantic_search_path_to_string(&canonical_root), ..request }
    let thread_task_id = task_id.clone()
    std__thread__spawn_(
        || match run_semantic_index_task(thread_app, thread_task_id.clone(), thread_request):
            Err(error) =>
                let _ = fs_commands__fail_manual_explorer_task(&thread_task_id, error)
            _ => ()
    )
    ()
    Result::Ok(ExplorerSemanticIndexBuildStartResponse { task_id: task_id, root_path: semantic_search_path_to_string(&canonical_root) })

fn explorer_semantic_search(app: tauri::AppHandle, request: ExplorerSemanticSearchRequest) -> Result<ExplorerSemanticSearchResponse, String>:
    let span = telemetry__start_native_span(&app, "rust", "explorer_semantic_search", BTreeMap__from([("rootPath".to_string(), request.root_path.clone()), ("queryLength".to_string(), request.query.len().to_string())]))
    let canonical_root = canonicalize_local_directory(&request.root_path)?
    let query = request.query.trim().to_string()
    if query.is_empty():
        telemetry__finish_native_span(&app, span, "error", BTreeMap__new_(), Option::Some("Semantic search query cannot be empty.".to_string()))
        ()
        return Result::Err("Semantic search query cannot be empty.".to_string())
    let summary = read_semantic_index_summary_for_root(&app, &canonical_root)?
    if !summary.indexed:
        telemetry__finish_native_span(&app, span, "error", BTreeMap__new_(), Option::Some("Semantic index has not been built for this root.".to_string()))
        ()
        return Result::Err("Semantic index has not been built for this root.".to_string())
    let result_limit = normalize_result_limit(request.limit)
    let force_cpu = semantic_force_cpu(request.routing_mode)
    let resolved_model_id = summary.model_id.clone().or_(request.model_id.clone())
    let response = python_sidecar__call_sidecar_action_json(&app, request.config, python_sidecar__action_ids__SEMANTIC_QUERY_INDEX, Option::Some(PythonSemanticSearchPayload { db_path: semantic_search_db_path_string(&app)?, root_path: semantic_search_path_to_string(&canonical_root), query: query, limit: result_limit, force_cpu: force_cpu, model_id: resolved_model_id, backend_preference: request.backend_preference.clone() }), Option::Some(semantic_search_path_to_string(&canonical_root)), Option::Some(BTreeMap__from([("TOKENIZERS_PARALLELISM".to_string(), "false".to_string())]).into_iter().collect()), Option::Some(true)).map(|response| build_semantic_search_response(ExplorerSemanticSearchQueryKind::Query, summary.stale, force_cpu, result_limit, response.result))
    let status = if response.is_ok():
        "ok"
    else:
        "error"
    let error = response.err().cloned()
    let result_count = response.map(|payload| payload.results.len().to_string()).unwrap_or_else(|_| "0".to_string())
    telemetry__finish_native_span(&app, span, status, BTreeMap__from([("resultCount".to_string(), result_count)]), error)
    ()
    response

fn explorer_semantic_find_similar(app: tauri::AppHandle, request: ExplorerSemanticFindSimilarRequest) -> Result<ExplorerSemanticSearchResponse, String>:
    let span = telemetry__start_native_span(&app, "rust", "explorer_semantic_find_similar", BTreeMap__from([("rootPath".to_string(), request.root_path.clone()), ("targetPath".to_string(), request.target_path.clone())]))
    let canonical_root = canonicalize_local_directory(&request.root_path)?
    let canonical_target = canonicalize_local_file(&request.target_path)?
    ensure_path_within_root(&canonical_root, &canonical_target)?
    ()
    let summary = read_semantic_index_summary_for_root(&app, &canonical_root)?
    if !summary.indexed:
        telemetry__finish_native_span(&app, span, "error", BTreeMap__new_(), Option::Some("Semantic index has not been built for this root.".to_string()))
        ()
        return Result::Err("Semantic index has not been built for this root.".to_string())
    let result_limit = normalize_result_limit(request.limit)
    let force_cpu = semantic_force_cpu(request.routing_mode)
    let resolved_model_id = summary.model_id.clone().or_(request.model_id.clone())
    let response = python_sidecar__call_sidecar_action_json(&app, request.config, python_sidecar__action_ids__SEMANTIC_FIND_SIMILAR_FILE, Option::Some(PythonSemanticFindSimilarPayload { db_path: semantic_search_db_path_string(&app)?, root_path: semantic_search_path_to_string(&canonical_root), target_path: semantic_search_path_to_string(&canonical_target), limit: result_limit, force_cpu: force_cpu, model_id: resolved_model_id, backend_preference: request.backend_preference.clone() }), Option::Some(semantic_search_path_to_string(&canonical_root)), Option::Some(BTreeMap__from([("TOKENIZERS_PARALLELISM".to_string(), "false".to_string())]).into_iter().collect()), Option::Some(true)).map(|response| build_semantic_search_response(ExplorerSemanticSearchQueryKind::Similarity, summary.stale, force_cpu, result_limit, response.result))
    let status = if response.is_ok():
        "ok"
    else:
        "error"
    let error = response.err().cloned()
    let result_count = response.map(|payload| payload.results.len().to_string()).unwrap_or_else(|_| "0".to_string())
    telemetry__finish_native_span(&app, span, status, BTreeMap__from([("resultCount".to_string(), result_count)]), error)
    ()
    response

enum ExplorerShaderFormat:
    Wgsl
    Hlsl
    Spv

enum ExplorerShaderStage:
    Vertex
    Fragment
    Compute

enum ExplorerShaderDiagnosticSeverity:
    Error
    Warning
    Info

struct ExplorerShaderDiagnostic:
    severity: ExplorerShaderDiagnosticSeverity
    message: String
    line_number: Option<u32>
    column_number: Option<u32>

struct ExplorerShaderEntryPoint:
    name: String
    stage: ExplorerShaderStage
    supports_live_preview: Bool

struct ExplorerShaderPreviewDocument:
    path: String
    name: String
    format: ExplorerShaderFormat
    editable_source: Option<String>
    inspection_source: String
    is_read_only: Bool
    selected_stage: Option<ExplorerShaderStage>
    selected_entry_point: Option<String>
    entry_points: Array<ExplorerShaderEntryPoint>
    diagnostics: Array<ExplorerShaderDiagnostic>
    normalized_wgsl: Option<String>
    supports_live_preview: Bool
    preview_abi: String

struct ExplorerShaderCompileRequest:
    path: String
    format: ExplorerShaderFormat
    source_text: Option<String>
    selected_stage: Option<ExplorerShaderStage>
    selected_entry_point: Option<String>

struct ExplorerShaderCompileResult:
    format: ExplorerShaderFormat
    inspection_source: String
    entry_points: Array<ExplorerShaderEntryPoint>
    selected_stage: Option<ExplorerShaderStage>
    selected_entry_point: Option<String>
    diagnostics: Array<ExplorerShaderDiagnostic>
    normalized_wgsl: Option<String>
    supports_live_preview: Bool
    preview_abi: String

struct ShaderInspectionPayload:
    editable_source: Option<String>
    inspection_source: String
    entry_points: Array<ExplorerShaderEntryPoint>
    selected_stage: Option<ExplorerShaderStage>
    selected_entry_point: Option<String>
    diagnostics: Array<ExplorerShaderDiagnostic>
    normalized_wgsl: Option<String>
    supports_live_preview: Bool

fn shader_preview_inspect(path: String) -> Result<ExplorerShaderPreviewDocument, String>:
    (await tauri__async_runtime__spawn_blocking(|| inspect_shader_preview_document(&path))).map_err(|error| format!("Shader preview inspect task failed: {error}"))?

fn shader_preview_compile(request: ExplorerShaderCompileRequest) -> Result<ExplorerShaderCompileResult, String>:
    (await tauri__async_runtime__spawn_blocking(|| compile_shader_preview_document(&request))).map_err(|error| format!("Shader preview compile task failed: {error}"))?

fn inspect_shader_preview_document(path: String) -> Result<ExplorerShaderPreviewDocument, String>:
    let format = detect_shader_format(path)?
    let input_path = PathBuf__from(path)
    let name = input_path.file_name().map(|value| value.to_string_lossy().into_owned()).unwrap_or_else(|| path.to_string())
    let payload = match format:
        ExplorerShaderFormat::Wgsl =>
            let source = std__fs__read_to_string(&input_path).map_err(|error| format!("Failed to read WGSL source '{}': {error}", input_path.display()))?
            inspect_text_shader_source(&input_path, format, &source, none, none, true)
        ExplorerShaderFormat::Hlsl =>
            let source = std__fs__read_to_string(&input_path).map_err(|error| format!("Failed to read HLSL source '{}': {error}", input_path.display()))?
            inspect_text_shader_source(&input_path, format, &source, none, none, true)
        ExplorerShaderFormat::Spv =>
            let bytes = std__fs__read(&input_path).map_err(|error| format!("Failed to read SPIR-V source '{}': {error}", input_path.display()))?
            inspect_spirv_shader_source(&input_path, &bytes, none, none)?
    Result::Ok(ExplorerShaderPreviewDocument { path: path.to_string(), name: name, format: format, editable_source: payload.editable_source, inspection_source: payload.inspection_source, is_read_only: format == ExplorerShaderFormat::Spv, selected_stage: payload.selected_stage, selected_entry_point: payload.selected_entry_point, entry_points: payload.entry_points, diagnostics: payload.diagnostics, normalized_wgsl: payload.normalized_wgsl, supports_live_preview: payload.supports_live_preview, preview_abi: GREEBLEFS_SHADER_PREVIEW_ABI_V1.to_string() })

fn compile_shader_preview_document(request: &ExplorerShaderCompileRequest) -> Result<ExplorerShaderCompileResult, String>:
    let input_path = PathBuf__from(&(*request).path)
    let payload = match (*request).format:
        ExplorerShaderFormat::Wgsl =>
            let source = (*request).source_text.clone().ok_or_else(|| "WGSL compile requests require sourceText.".to_string())?
            inspect_text_shader_source(&input_path, ExplorerShaderFormat::Wgsl, &source, (*request).selected_stage, (*request).selected_entry_point, false)
        ExplorerShaderFormat::Hlsl =>
            let source = (*request).source_text.clone().ok_or_else(|| "HLSL compile requests require sourceText.".to_string())?
            inspect_text_shader_source(&input_path, ExplorerShaderFormat::Hlsl, &source, (*request).selected_stage, (*request).selected_entry_point, false)
        ExplorerShaderFormat::Spv =>
            let bytes = std__fs__read(&input_path).map_err(|error| format!("Failed to read SPIR-V source '{}': {error}", input_path.display()))?
            inspect_spirv_shader_source(&input_path, &bytes, (*request).selected_stage, (*request).selected_entry_point)?
    Result::Ok(ExplorerShaderCompileResult { format: (*request).format, inspection_source: payload.inspection_source, entry_points: payload.entry_points, selected_stage: payload.selected_stage, selected_entry_point: payload.selected_entry_point, diagnostics: payload.diagnostics, normalized_wgsl: payload.normalized_wgsl, supports_live_preview: payload.supports_live_preview, preview_abi: GREEBLEFS_SHADER_PREVIEW_ABI_V1.to_string() })

fn inspect_text_shader_source(input_path: &std::path::Path, format: ExplorerShaderFormat, source: String, requested_stage: Option<ExplorerShaderStage>, requested_entry_point: Option<String>, include_editable_source: Bool) -> Result<ShaderInspectionPayload, String>:
    match format:
        ExplorerShaderFormat::Wgsl => inspect_wgsl_shader_source(source, requested_stage, requested_entry_point, include_editable_source)
        ExplorerShaderFormat::Hlsl => inspect_hlsl_shader_source(input_path, source, requested_stage, requested_entry_point, include_editable_source)
        ExplorerShaderFormat::Spv => Result::Err("SPIR-V must be inspected from bytes.".to_string())

fn inspect_wgsl_shader_source(source: String, requested_stage: Option<ExplorerShaderStage>, requested_entry_point: Option<String>, include_editable_source: Bool) -> Result<ShaderInspectionPayload, String>:
    let mut diagnostics = Vec__new_()
    match naga__front__wgsl__parse_str(source):
        Ok(module) =>
            let entry_points = reflect_module_entry_points(&module)
            let selection = resolve_entry_point_selection(&entry_points, requested_stage, requested_entry_point)
            let normalized = validate_and_write_wgsl(&module).map_err(|error| format!("WGSL validation failed: {error}"))
            match normalized:
                Ok(normalized_wgsl) => Result::Ok(build_shader_payload(include_editable_source.then(|| source.to_string()), source.to_string(), entry_points, selection, diagnostics, Option::Some(normalized_wgsl)))
                Err(error) =>
                    diagnostics.push(ExplorerShaderDiagnostic { severity: ExplorerShaderDiagnosticSeverity::Error, message: error, line_number: none, column_number: none })
                    ()
                    Result::Ok(build_shader_payload(include_editable_source.then(|| source.to_string()), source.to_string(), entry_points, selection, diagnostics, none))
        Err(error) =>
            diagnostics.push(diagnostic_from_message(ExplorerShaderDiagnosticSeverity::Error, error.to_string()))
            ()
            Result::Ok(build_shader_payload(include_editable_source.then(|| source.to_string()), source.to_string(), Vec__new_(), (requested_stage, requested_entry_point.map(str__to_string)), diagnostics, none))

fn inspect_hlsl_shader_source(input_path: &std::path::Path, source: String, requested_stage: Option<ExplorerShaderStage>, requested_entry_point: Option<String>, include_editable_source: Bool) -> Result<ShaderInspectionPayload, String>:
    let mut diagnostics = Vec__new_()
    let inferred_entry_points = reflect_hlsl_entry_points(source)
    let selection = resolve_entry_point_selection(&inferred_entry_points, requested_stage, requested_entry_point)
    let Some(selected_stage) = selection.field_0
    let selected_entry_point = selection.field_1.clone().unwrap_or_else(|| "main".to_string())
    match compile_hlsl_to_spirv(input_path, source, selected_stage, &selected_entry_point):
        Ok(words) =>
            let spirv_payload = inspect_spirv_words(&words, Option::Some(selected_stage), Option::Some(selected_entry_point.as_str()))?
            Result::Ok(build_shader_payload(
                include_editable_source.then(|| source.to_string()),
                source.to_string(),
                if spirv_payload.entry_points.is_empty():
                    inferred_entry_points
                else:
                    spirv_payload.entry_points,
                (spirv_payload.selected_stage.or_(Option::Some(selected_stage)), spirv_payload.selected_entry_point.or_(Option::Some(selected_entry_point))),
                spirv_payload.diagnostics,
                spirv_payload.normalized_wgsl
            ))
        Err(error) =>
            diagnostics.push(diagnostic_from_message(ExplorerShaderDiagnosticSeverity::Error, error))
            ()
            Result::Ok(build_shader_payload(include_editable_source.then(|| source.to_string()), source.to_string(), inferred_entry_points, selection, diagnostics, none))

fn inspect_spirv_shader_source(input_path: &std::path::Path, bytes: &Slice<u8>, requested_stage: Option<ExplorerShaderStage>, requested_entry_point: Option<String>) -> Result<ShaderInspectionPayload, String>:
    let words = decode_spirv_words(bytes)?
    let mut payload = inspect_spirv_words(&words, requested_stage, requested_entry_point)?
    payload.editable_source = none
    ()
    payload.inspection_source = format_spirv_inspection_source(payload.normalized_wgsl, &words, input_path)
    ()
    Result::Ok(payload)

fn inspect_spirv_words(words: &Slice<u32>, requested_stage: Option<ExplorerShaderStage>, requested_entry_point: Option<String>) -> Result<ShaderInspectionPayload, String>:
    let mut diagnostics = Vec__new_()
    match naga__front__spv__parse_u8_slice(&encode_spirv_words(words), &Options__default_()):
        Ok(module) =>
            let entry_points = reflect_module_entry_points(&module)
            let selection = resolve_entry_point_selection(&entry_points, requested_stage, requested_entry_point)
            match validate_and_write_wgsl(&module):
                Ok(normalized_wgsl) => Result::Ok(build_shader_payload(none, String__new_(), entry_points, selection, diagnostics, Option::Some(normalized_wgsl)))
                Err(error) =>
                    diagnostics.push(diagnostic_from_message(ExplorerShaderDiagnosticSeverity::Error, format!("SPIR-V validation failed: {error}")))
                    ()
                    Result::Ok(build_shader_payload(none, String__new_(), entry_points, selection, diagnostics, none))
        Err(error) =>
            diagnostics.push(diagnostic_from_message(ExplorerShaderDiagnosticSeverity::Error, error.to_string()))
            ()
            Result::Ok(build_shader_payload(none, String__new_(), Vec__new_(), (requested_stage, requested_entry_point.map(str__to_string)), diagnostics, none))

fn build_shader_payload(editable_source: Option<String>, inspection_source: String, entry_points: Array<ExplorerShaderEntryPoint>, selection: (Option<ExplorerShaderStage>, Option<String>), diagnostics: Array<ExplorerShaderDiagnostic>, normalized_wgsl: Option<String>) -> ShaderInspectionPayload:
    let supports_live_preview = normalized_wgsl.is_some() and selection.field_0.is_some() and selection.field_1.is_some()
    ShaderInspectionPayload { editable_source: editable_source, inspection_source: inspection_source, entry_points: entry_points, selected_stage: selection.field_0, selected_entry_point: selection.field_1, diagnostics: diagnostics, normalized_wgsl: normalized_wgsl, supports_live_preview: supports_live_preview }

fn validate_and_write_wgsl(module: &naga::Module) -> Result<String, String>:
    let info = Validator__new_(ValidationFlags__all(), Capabilities__all()).validate(module).map_err(|error| error.to_string())?
    naga__back__wgsl__write_string(module, &info, WriterFlags__empty()).map_err(|error| error.to_string())

fn reflect_module_entry_points(module: &naga::Module) -> Array<ExplorerShaderEntryPoint>:
    (*module).entry_points.iter().filter_map(
        |entry_point| block:
            let stage = map_naga_stage(entry_point.stage)?
            Option::Some(ExplorerShaderEntryPoint { name: entry_point.name.clone(), stage: stage, supports_live_preview: true })
    ).collect()

fn reflect_hlsl_entry_points(source: String) -> Array<ExplorerShaderEntryPoint>:
    let Ok(entry_point_regex) = Regex__new_("(?is)\\[\\s*shader\\s*\\(\\s*\"(?P<stage>vertex|pixel|fragment|compute)\"\\s*\\)\\s*\\]\\s*[A-Za-z0-9_<>,:\\s\\[\\]]+\\b(?P<name>[A-Za-z_][A-Za-z0-9_]*)\\s*\\(")
    entry_point_regex.captures_iter(source).filter_map(
        |captures| block:
            let name = (captures.name("name")?).as_str().to_string()
            let stage = match (captures.name("stage")?).as_str().to_ascii_lowercase().as_str():
                "vertex" => ExplorerShaderStage::Vertex
                "pixel" | "fragment" => ExplorerShaderStage::Fragment
                "compute" => ExplorerShaderStage::Compute
                _ => return none
            Option::Some(ExplorerShaderEntryPoint { name: name, stage: stage, supports_live_preview: true })
    ).collect()

fn resolve_entry_point_selection(entry_points: &Slice<ExplorerShaderEntryPoint>, requested_stage: Option<ExplorerShaderStage>, requested_entry_point: Option<String>) -> (Option<ExplorerShaderStage>, Option<String>):
    match requested_entry_point:
        Some(entry_point_name) =>
            let normalized_name = entry_point_name.trim()
            match entry_points.iter().find(|entry| entry.name == normalized_name and requested_stage.map(|stage| stage == entry.stage).unwrap_or(true)):
                Some(entry_point) =>
                    return (Option::Some(entry_point.stage), Option::Some(entry_point.name.clone()))
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match requested_stage:
        Some(stage) =>
            let stage_matches: Array<&ExplorerShaderEntryPoint> = entry_points.iter().filter(|entry| entry.stage == stage).collect()
            if stage_matches.len() == 1:
                return (Option::Some(stage), Option::Some(stage_matches[0].name.clone()))
            if stage_matches.is_empty():
                return (Option::Some(stage), requested_entry_point.map(str__to_string))
            ()
        _ =>
            ()
            ()
    if entry_points.len() == 1:
        return (Option::Some(entry_points[0].stage), Option::Some(entry_points[0].name.clone()))
    (requested_stage, requested_entry_point.map(str__to_string))

fn compile_hlsl_to_spirv(input_path: &std::path::Path, source: String, stage: ExplorerShaderStage, entry_point: String) -> Result<Array<u32>, String>:
    compile_hlsl_to_spirv_with_native_shaderc(input_path, source, stage, entry_point)

fn compile_hlsl_to_spirv_with_native_shaderc(input_path: &std::path::Path, source: String, stage: ExplorerShaderStage, entry_point: String) -> Result<Array<u32>, String>:
    let compiler = Compiler__new_().map_err(|error| format!("Failed to initialize shaderc: {error}"))?
    let mut options = CompileOptions__new_().map_err(|error| format!("Failed to create shaderc compile options: {error}"))?
    options.set_source_language(shaderc::SourceLanguage::HLSL)
    ()
    options.set_hlsl_io_mapping(true)
    ()
    options.set_auto_map_locations(true)
    ()
    let include_root = input_path.parent().map(Path__to_path_buf).unwrap_or_else(|| PathBuf__from("."))
    options.set_include_callback(|requested_source, include_type, requesting_source, _depth| resolve_shader_include(&include_root, requested_source, include_type, requesting_source))
    ()
    let artifact = compiler.compile_into_spirv(source, map_shaderc_stage(stage), &input_path.to_string_lossy(), entry_point, Option::Some(&options)).map_err(|error| error.to_string())?
    Result::Ok(artifact.as_binary().to_vec())

fn compile_hlsl_to_spirv_with_native_shaderc(_input_path: &std::path::Path, _source: String, _stage: ExplorerShaderStage, _entry_point: String) -> Result<Array<u32>, String>:
    Result::Err("HLSL-to-SPIR-V compilation requires the native-shaderc Cargo feature. WGSL and SPIR-V inspection remain available in the default test-safe build.".to_string())

fn resolve_shader_include(include_root: &std::path::Path, requested_source: String, include_type: shaderc::IncludeType, requesting_source: String) -> shaderc::IncludeCallbackResult:
    let requested_path = PathBuf__from(requested_source)
    let base_dir = match include_type:
        shaderc::IncludeType::Relative => Path__new_(requesting_source).parent().map(Path__to_path_buf).unwrap_or_else(|| include_root.to_path_buf())
        shaderc::IncludeType::Standard => include_root.to_path_buf()
    let resolved_path = if requested_path.is_absolute():
        requested_path
    else:
        base_dir.join(requested_path)
    let content = std__fs__read_to_string(&resolved_path).map_err(|error| format!("Failed to resolve shader include '{}' from '{}': {error}", requested_source, requesting_source))?
    Result::Ok(shaderc::ResolvedInclude { resolved_name: resolved_path.to_string_lossy().into_owned(), content: content })

fn detect_shader_format(path: String) -> Result<ExplorerShaderFormat, String>:
    let extension = Path__new_(path).extension().and_then(|value| value.to_str()).map(|value| value.trim().to_ascii_lowercase()).unwrap_or_default()
    match extension.as_str():
        "wgsl" => Result::Ok(ExplorerShaderFormat::Wgsl)
        "hlsl" => Result::Ok(ExplorerShaderFormat::Hlsl)
        "spv" => Result::Ok(ExplorerShaderFormat::Spv)
        _ => Result::Err(format!("Unsupported shader preview format for '{}'. Expected .wgsl, .hlsl, or .spv.", path))

fn decode_spirv_words(bytes: &Slice<u8>) -> Result<Array<u32>, String>:
    if bytes.is_empty():
        return Result::Err("SPIR-V preview source is empty.".to_string())
    if bytes.len() % 4 != 0:
        return Result::Err("SPIR-V preview source length must be divisible by 4.".to_string())
    Result::Ok(bytes.chunks_exact(4).map(|chunk| u32__from_le_bytes([chunk[0], chunk[1], chunk[2], chunk[3]])).collect())

fn encode_spirv_words(words: &Slice<u32>) -> Array<u8>:
    let mut bytes = |__kain_ctor_arg0| Vec::new()(words.len() * 4)
    for word in words:
        bytes.extend_from_slice(&word.to_le_bytes())
        ()
    ()
    bytes

fn format_spirv_inspection_source(normalized_wgsl: Option<String>, words: &Slice<u32>, input_path: &std::path::Path) -> String:
    let mut sections = Vec__new_()
    match normalized_wgsl:
        Some(wgsl) =>
            sections.push(format!("// Generated WGSL for {}\n\n{}", input_path.display(), wgsl))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    sections.push(format!("// SPIR-V word dump for {}\n{}", input_path.display(), words.iter().enumerate().map(|__kain_closure_arg0| format!("{index:04}: 0x{word:08x}")).collect().join("\n")))
    ()
    sections.join("\n\n")

fn diagnostic_from_message(severity: ExplorerShaderDiagnosticSeverity, message: String) -> ExplorerShaderDiagnostic:
    let location_regex = Regex__new_("(?P<line>\\d+):(?P<column>\\d+)").ok()
    let location = location_regex.and_then(|regex| regex.captures(&message)).map(|captures| (captures.name("line").and_then(|value| value.as_str().parse().ok()), captures.name("column").and_then(|value| value.as_str().parse().ok())))
    ExplorerShaderDiagnostic { severity: severity, message: message, line_number: location.and_then(|__kain_closure_arg1| *__kain_closure_arg1.__kain_tuple_0), column_number: location.and_then(|__kain_closure_arg2| *__kain_closure_arg2.__kain_tuple_1) }

fn map_naga_stage(stage: naga::ShaderStage) -> Option<ExplorerShaderStage>:
    match stage:
        naga::ShaderStage::Vertex => Option::Some(ExplorerShaderStage::Vertex)
        naga::ShaderStage::Fragment => Option::Some(ExplorerShaderStage::Fragment)
        naga::ShaderStage::Compute => Option::Some(ExplorerShaderStage::Compute)
        _ => none

fn map_shaderc_stage(stage: ExplorerShaderStage) -> shaderc::ShaderKind:
    match stage:
        ExplorerShaderStage::Vertex => shaderc::ShaderKind::Vertex
        ExplorerShaderStage::Fragment => shaderc::ShaderKind::Fragment
        ExplorerShaderStage::Compute => shaderc::ShaderKind::Compute

