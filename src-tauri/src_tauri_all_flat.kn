    let count = stream.read(&mut buffer).map_err(|error| format!("Failed to read OAuth callback request: {error}"))?
    let request = String__from_utf8_lossy(&buffer[..count])
    let request_line = request.lines().next().ok_or_else(|| "OAuth callback request was empty.".to_string())?
    let path = request_line.split_whitespace().nth(1).ok_or_else(|| "OAuth callback request was malformed.".to_string())?
    let url = Url__parse(&format!("http://127.0.0.1{path}")).map_err(|error| format!("OAuth callback URL was malformed: {error}"))?
    let query = url.query_pairs().collect()
    let callback_state = query.get("state").map(|value| value.to_string()).ok_or_else(|| "OAuth callback did not include state.".to_string())?
    if callback_state != expected_state:
        return Result::Err("OAuth callback state did not match the pending login request.".to_string())
    Result::Ok(AuthCallbackPayload { code: query.get("code").map(|value| value.to_string()), error: query.get("error").map(|value| value.to_string()) })

fn write_callback_response(stream: &mut net::TcpStream, success: Bool) -> Result<(), String>:
    let body = if success:
        "<html><body style=\"font-family: sans-serif; background: #0d1016; color: #e8eef8;\"><h3>Cloud account connected</h3><p>You can close this browser tab and return to GreebleFS.</p></body></html>"
    else:
        "<html><body style=\"font-family: sans-serif; background: #0d1016; color: #fca5a5;\"><h3>Cloud sign-in failed</h3><p>Return to GreebleFS for details.</p></body></html>"
    let response = format!("HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}", body.len(), body)
    stream.write_all(response.as_bytes()).map_err(|error| format!("Failed to write OAuth callback response: {error}"))

fn build_authorization_url(config: &ProviderConfig, redirect_uri: String, state: String, code_challenge: String) -> Result<String, String>:
    let url = match (*config).provider:
        CloudProviderId::GoogleDrive => Url__parse_with_params("https://accounts.google.com/o/oauth2/v2/auth", &[("client_id", (*config).client_id.as_str()), ("redirect_uri", redirect_uri), ("response_type", "code"), ("scope", "openid email profile https://www.googleapis.com/auth/drive"), ("access_type", "offline"), ("prompt", "consent"), ("code_challenge", code_challenge), ("code_challenge_method", "S256"), ("state", state)])
        CloudProviderId::Dropbox => Url__parse_with_params("https://www.dropbox.com/oauth2/authorize", &[("client_id", (*config).client_id.as_str()), ("redirect_uri", redirect_uri), ("response_type", "code"), ("token_access_type", "offline"), ("scope", "account_info.read files.metadata.read files.content.read files.content.write"), ("code_challenge", code_challenge), ("code_challenge_method", "S256"), ("state", state)]).map_err(|error| format!("Failed to build cloud authorization URL: {error}"))?
    Result::Ok(url.to_string())

fn exchange_authorization_code(client: &reqwest::Client, config: &ProviderConfig, redirect_uri: String, code_verifier: String, code: String) -> Result<GoogleTokenResponse, String>:
    match (*config).provider:
        CloudProviderId::GoogleDrive =>
            let mut form = vec!(("client_id", (*config).client_id.as_str()), ("code", code), ("code_verifier", code_verifier), ("grant_type", "authorization_code"), ("redirect_uri", redirect_uri))
            match (*config).client_secret:
                Some(client_secret) =>
                    form.push(("client_secret", client_secret))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            (await (((await client.post("https://oauth2.googleapis.com/token").form(&form).send_()).map_err(|error| format!("Google Drive token exchange failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive token exchange failed: {error}"))?).json()).map_err(|error| format!("Failed to parse Google Drive token response: {error}"))
        CloudProviderId::Dropbox =>
            let mut form = vec!(("client_id", (*config).client_id.as_str()), ("code", code), ("code_verifier", code_verifier), ("grant_type", "authorization_code"), ("redirect_uri", redirect_uri))
            match (*config).client_secret:
                Some(client_secret) =>
                    form.push(("client_secret", client_secret))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            let response = (await (((await client.post("https://api.dropboxapi.com/oauth2/token").form(&form).send_()).map_err(|error| format!("Dropbox token exchange failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox token exchange failed: {error}"))?).json()).map_err(|error| format!("Failed to parse Dropbox token response: {error}"))?
            Result::Ok(GoogleTokenResponse { access_token: response.access_token, expires_in: response.expires_in, refresh_token: response.refresh_token })

fn refresh_access_token(client: &reqwest::Client, config: &ProviderConfig, refresh_token: String) -> Result<GoogleTokenResponse, String>:
    match (*config).provider:
        CloudProviderId::GoogleDrive =>
            let mut form = vec!(("client_id", (*config).client_id.as_str()), ("refresh_token", refresh_token), ("grant_type", "refresh_token"))
            match (*config).client_secret:
                Some(client_secret) =>
                    form.push(("client_secret", client_secret))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            (await (((await client.post("https://oauth2.googleapis.com/token").form(&form).send_()).map_err(|error| format!("Google Drive access token refresh failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive access token refresh failed: {error}"))?).json()).map_err(|error| format!("Failed to parse Google Drive refresh response: {error}"))
        CloudProviderId::Dropbox =>
            let mut form = vec!(("client_id", (*config).client_id.as_str()), ("refresh_token", refresh_token), ("grant_type", "refresh_token"))
            match (*config).client_secret:
                Some(client_secret) =>
                    form.push(("client_secret", client_secret))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            let response = (await (((await client.post("https://api.dropboxapi.com/oauth2/token").form(&form).send_()).map_err(|error| format!("Dropbox access token refresh failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox access token refresh failed: {error}"))?).json()).map_err(|error| format!("Failed to parse Dropbox refresh response: {error}"))?
            Result::Ok(GoogleTokenResponse { access_token: response.access_token, expires_in: response.expires_in, refresh_token: response.refresh_token })

struct CloudProfile:
    provider: CloudProviderId
    id: String
    display_name: String
    email: String
    avatar_url: Option<String>
    connected_at: u64
    drive_label: String

fn fetch_account_profile(client: &reqwest::Client, provider: CloudProviderId, access_token: String) -> Result<CloudProfile, String>:
    match provider:
        CloudProviderId::GoogleDrive =>
            let user = (await (((await client.get("https://openidconnect.googleapis.com/v1/userinfo").bearer_auth(access_token).send_()).map_err(|error| format!("Google Drive account lookup failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive account lookup failed: {error}"))?).json()).map_err(|error| format!("Failed to parse Google Drive account response: {error}"))?
            let email = user.email.clone().filter(|value| !value.trim().is_empty()).ok_or_else(|| "Google Drive account response did not include an email.".to_string())?
            Result::Ok(CloudProfile { provider: provider, id: format!("google-drive:{}", slugify(&email)), display_name: user.name.clone().filter(|value| !value.trim().is_empty()).unwrap_or_else(|| email.clone()), email: email.clone(), avatar_url: user.picture, connected_at: now_ms(), drive_label: format!("Google Drive · {email}") })
        CloudProviderId::Dropbox =>
            let user = (await (((await client.post("https://api.dropboxapi.com/2/users/get_current_account").bearer_auth(access_token).json(&serde_json::json!(())).send_()).map_err(|error| format!("Dropbox account lookup failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox account lookup failed: {error}"))?).json()).map_err(|error| format!("Failed to parse Dropbox account response: {error}"))?
            let email = user.email.clone().filter(|value| !value.trim().is_empty()).ok_or_else(|| "Dropbox account response did not include an email.".to_string())?
            Result::Ok(CloudProfile { provider: provider, id: format!("dropbox:{}", slugify(&email)), display_name: if user.name.display_name.trim().is_empty():
                email.clone()
            else:
                user.name.display_name, email: email.clone(), avatar_url: user.profile_photo_url, connected_at: now_ms(), drive_label: format!("Dropbox · {email}") })

fn slugify(value: String) -> String:
    value.chars().map(
        |ch| if ch.is_ascii_alphanumeric():
            ch.to_ascii_lowercase()
        else:
            "-"
    ).collect().trim_matches("-").to_string()

fn list_cloud_root_directory(app: &tauri::AppHandle, state: &CloudRuntimeState, client: &reqwest::Client, provider: CloudProviderId, account_id: String, account: &PersistedCloudAccount) -> Result<CloudDirectoryListing, String>:
    let access_token = (await access_token_for_account(app, state, client, account))?
    match provider:
        CloudProviderId::GoogleDrive =>
            let entries = (await google_list_children(client, &access_token, "root", account_id))?
            Result::Ok(CloudDirectoryListing { path: build_cloud_root_path(provider, account_id), parent_path: none, breadcrumbs: vec!(CloudBreadcrumb { label: (*account).drive_label.clone(), path: build_cloud_root_path(provider, account_id) }), entries: entries })
        CloudProviderId::Dropbox =>
            let entries = (await dropbox_list_children(client, &access_token, "", account_id))?
            Result::Ok(CloudDirectoryListing { path: build_cloud_root_path(provider, account_id), parent_path: none, breadcrumbs: vec!(CloudBreadcrumb { label: (*account).drive_label.clone(), path: build_cloud_root_path(provider, account_id) }), entries: entries })

fn list_cloud_item_directory(app: &tauri::AppHandle, state: &CloudRuntimeState, client: &reqwest::Client, provider: CloudProviderId, account_id: String, item_id: String, account: &PersistedCloudAccount) -> Result<CloudDirectoryListing, String>:
    let access_token = (await access_token_for_account(app, state, client, account))?
    match provider:
        CloudProviderId::GoogleDrive =>
            let current = (await google_get_file_metadata(client, &access_token, item_id))?
            let parent_path = current.parents.and_then(|parents| parents.first()).map(
                |parent_id| if parent_id == "root":
                    build_cloud_root_path(provider, account_id)
                else:
                    build_cloud_item_path(provider, account_id, parent_id)
            )
            let breadcrumbs = (await google_breadcrumbs(client, &access_token, account, account_id, item_id))?
            let entries = (await google_list_children(client, &access_token, item_id, account_id))?
            Result::Ok(CloudDirectoryListing { path: build_cloud_item_path(provider, account_id, item_id), parent_path: parent_path, breadcrumbs: breadcrumbs, entries: entries })
        CloudProviderId::Dropbox =>
            let current_path = item_id
            let parent_path = dropbox_parent_path(current_path).map(
                |parent| if parent.is_empty():
                    build_cloud_root_path(provider, account_id)
                else:
                    build_cloud_item_path(provider, account_id, &parent)
            )
            let breadcrumbs = dropbox_breadcrumbs(account, account_id, current_path)
            let entries = (await dropbox_list_children(client, &access_token, current_path, account_id))?
            Result::Ok(CloudDirectoryListing { path: build_cloud_item_path(provider, account_id, item_id), parent_path: parent_path, breadcrumbs: breadcrumbs, entries: entries })

fn google_list_children(client: &reqwest::Client, access_token: String, parent_id: String, account_id: String) -> Result<Array<FileEntry>, String>:
    let mut page_token: Option<String> = none
    let mut files = Vec__new_()
    loop:
        let mut url = Url__parse("https://www.googleapis.com/drive/v3/files").map_err(|error| format!("Failed to build Google Drive list URL: {error}"))?
        url.query_pairs_mut().append_pair("q", &format!("trashed = false and '{parent_id}' in parents")).append_pair("fields", "nextPageToken,files(id,name,mimeType,size,modifiedTime,parents)").append_pair("pageSize", "500")
        ()
        match page_token:
            Some(token) =>
                url.query_pairs_mut().append_pair("pageToken", token)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let response = (await (((await client.get(url).bearer_auth(access_token).send_()).map_err(|error| format!("Google Drive folder listing failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive folder listing failed: {error}"))?).json()).map_err(|error| format!("Failed to parse Google Drive folder listing: {error}"))?
        files.extend(response.files)
        ()
        if response.next_page_token.is_none():
            break
        page_token = response.next_page_token
        ()
    ()
    let mut entries = files.into_iter().map(|file| google_file_to_entry(account_id, file)).collect()
    sort_entries(&mut entries)
    ()
    Result::Ok(entries)

fn google_get_file_metadata(client: &reqwest::Client, access_token: String, item_id: String) -> Result<GoogleDriveFile, String>:
    (await (((await client.get(format!("https://www.googleapis.com/drive/v3/files/{item_id}")).bearer_auth(access_token).query(&[("fields", "id,name,mimeType,size,modifiedTime,parents")]).send_()).map_err(|error| format!("Google Drive metadata lookup failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive metadata lookup failed: {error}"))?).json()).map_err(|error| format!("Failed to parse Google Drive metadata: {error}"))

fn google_file_to_entry(account_id: String, file: GoogleDriveFile) -> FileEntry:
    let is_dir = file.mime_type == "application/vnd.google-apps.folder"
    let extension = if is_dir:
        String__new_()
    else:
        Path__new_(&file.name).extension().and_then(|value| value.to_str()).unwrap_or_default().to_string()
    let path = build_cloud_item_path(CloudProviderId::GoogleDrive, account_id, &file.id)
    let size = file.size.and_then(|value| value.parse().ok()).unwrap_or(0)
    let modified = parse_timestamp_ms(file.modified_time)
    let content_revision = explorer_identity__build_content_revision(size, modified, is_dir, false)
    let identity = explorer_identity__build_virtual_identity("cloud-google-drive", &path, &content_revision)
    FileEntry { name: file.name.clone(), path: path, is_dir: is_dir, size: size, modified: modified, extension: extension, is_hidden: false, is_symlink: false, entity_id: identity.entity_id, identity_kind: identity.identity_kind, content_revision: identity.content_revision }

fn google_breadcrumbs(client: &reqwest::Client, access_token: String, account: &PersistedCloudAccount, account_id: String, current_item_id: String) -> Result<Array<CloudBreadcrumb>, String>:
    let mut crumbs = vec!(CloudBreadcrumb { label: (*account).drive_label.clone(), path: build_cloud_root_path(CloudProviderId::GoogleDrive, account_id) })
    let mut cursor = current_item_id.to_string()
    let mut stack = Vec__new_()
    while cursor != "root":
        let metadata = (await google_get_file_metadata(client, access_token, &cursor))?
        let path = build_cloud_item_path(CloudProviderId::GoogleDrive, account_id, &metadata.id)
        stack.push(CloudBreadcrumb { label: metadata.name.clone(), path: path })
        ()
        let Some(parent) = metadata.parents.and_then(|parents| parents.first())
        cursor = parent.clone()
        ()
    ()
    stack.reverse()
    ()
    crumbs.extend(stack)
    ()
    Result::Ok(crumbs)

fn dropbox_list_children(client: &reqwest::Client, access_token: String, current_path: String, account_id: String) -> Result<Array<FileEntry>, String>:
    let response = (await (((await client.post("https://api.dropboxapi.com/2/files/list_folder").bearer_auth(access_token).json(&serde_json::json!()).send_()).map_err(|error| format!("Dropbox folder listing failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox folder listing failed: {error}"))?).json()).map_err(|error| format!("Failed to parse Dropbox folder listing: {error}"))?
    let mut entries = response.entries.into_iter().filter_map(|entry| dropbox_entry_to_file_entry(account_id, entry)).collect()
    sort_entries(&mut entries)
    ()
    Result::Ok(entries)

fn dropbox_entry_to_file_entry(account_id: String, entry: DropboxMetadataEntry) -> Option<FileEntry>:
    let item_path = entry.path_display.or_(entry.path_lower)?
    let is_dir = entry.tag == "folder"
    let extension = if is_dir:
        String__new_()
    else:
        Path__new_(&entry.name).extension().and_then(|value| value.to_str()).unwrap_or_default().to_string()
    let path = build_cloud_item_path(CloudProviderId::Dropbox, account_id, &item_path)
    let size = entry.size.unwrap_or(0)
    let modified = parse_timestamp_ms(entry.server_modified)
    let content_revision = explorer_identity__build_content_revision(size, modified, is_dir, false)
    let identity = explorer_identity__build_virtual_identity("cloud-dropbox", &path, &content_revision)
    Option::Some(FileEntry { name: entry.name.clone(), path: path, is_dir: is_dir, size: size, modified: modified, extension: extension, is_hidden: entry.name.starts_with("."), is_symlink: false, entity_id: identity.entity_id, identity_kind: identity.identity_kind, content_revision: identity.content_revision })

fn dropbox_breadcrumbs(account: &PersistedCloudAccount, account_id: String, current_path: String) -> Array<CloudBreadcrumb>:
    let mut crumbs = vec!(CloudBreadcrumb { label: (*account).drive_label.clone(), path: build_cloud_root_path(CloudProviderId::Dropbox, account_id) })
    let mut prefix = String__new_()
    for segment in current_path.split("/").filter(|value| !value.is_empty()):
        prefix.push("/")
        ()
        prefix.push_str(segment)
        ()
        crumbs.push(CloudBreadcrumb { label: segment.to_string(), path: build_cloud_item_path(CloudProviderId::Dropbox, account_id, &prefix) })
        ()
    ()
    crumbs

fn dropbox_parent_path(path: String) -> Option<String>:
    let normalized = path.trim_end_matches("/")
    if normalized.is_empty():
        return none
    let mut parts = normalized.rsplitn(2, "/")
    let _ = parts.next()
    let parent = parts.next().unwrap_or_default()
    if parent.is_empty():
        Option::Some(String__new_())
    else:
        Option::Some(parent.to_string())

fn download_cloud_file(app: &tauri::AppHandle, state: &CloudRuntimeState, path: String) -> Result<CloudFilePayload, String>:
    let parsed = parse_cloud_path(path)?
    let item_id = parsed.item_id().ok_or_else(|| "Cloud drive roots cannot be downloaded.".to_string())?
    let account = load_account(app, parsed.account_id())?
    let client = cloud_http_client()?
    let access_token = (await access_token_for_account(app, state, &client, &account))?
    match parsed.provider():
        CloudProviderId::GoogleDrive =>
            let metadata = (await google_get_file_metadata(&client, &access_token, item_id))?
            if metadata.mime_type == "application/vnd.google-apps.folder":
                return Result::Err("Folders cannot be downloaded as files.".to_string())
            if metadata.mime_type.starts_with("application/vnd.google-apps."):
                return Result::Err("Google-native Docs/Sheets/Slides export is not implemented yet.".to_string())
            let bytes = ((await (((await client.get(format!("https://www.googleapis.com/drive/v3/files/{item_id}?alt=media")).bearer_auth(access_token).send_()).map_err(|error| format!("Google Drive download failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive download failed: {error}"))?).bytes()).map_err(|error| format!("Failed to read Google Drive download payload: {error}"))?).to_vec()
            Result::Ok(CloudFilePayload { bytes: bytes, name: metadata.name })
        CloudProviderId::Dropbox =>
            let response = ((await client.post("https://content.dropboxapi.com/2/files/download").bearer_auth(access_token).header("Dropbox-API-Arg", serde_json::json!().to_string()).send_()).map_err(|error| format!("Dropbox download failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox download failed: {error}"))?
            let bytes = ((await response.bytes()).map_err(|error| format!("Failed to read Dropbox download payload: {error}"))?).to_vec()
            let name = Path__new_(item_id).file_name().and_then(|value| value.to_str()).unwrap_or("download").to_string()
            Result::Ok(CloudFilePayload { bytes: bytes, name: name })

fn cloud_download_to_temp(app: &tauri::AppHandle, state: &CloudRuntimeState, path: String) -> Result<String, String>:
    let payload = (await download_cloud_file(app, state, path))?
    let temp_root = temp_root_path(app)?
    let file_name = format!("{}-{}", Uuid__new_v4(), payload.name)
    let destination = temp_root.join(file_name)
    std__fs__write(&destination, &payload.bytes).map_err(|error| format!("Failed to write cloud temp file: {error}"))?
    ()
    Result::Ok(destination.to_string_lossy().to_string())

fn overwrite_cloud_file(client: &reqwest::Client, provider: CloudProviderId, access_token: String, item_id: String, bytes: Array<u8>) -> Result<(), String>:
    match provider:
        CloudProviderId::GoogleDrive =>
            ((await client.patch(format!("https://www.googleapis.com/upload/drive/v3/files/{item_id}?uploadType=media")).bearer_auth(access_token).header("Content-Type", "application/octet-stream").body(bytes).send_()).map_err(|error| format!("Google Drive file overwrite failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive file overwrite failed: {error}"))?
            ()
            Result::Ok(())
        CloudProviderId::Dropbox =>
            ((await client.post("https://content.dropboxapi.com/2/files/upload").bearer_auth(access_token).header("Dropbox-API-Arg", serde_json::json!().to_string()).header("Content-Type", "application/octet-stream").body(bytes).send_()).map_err(|error| format!("Dropbox file overwrite failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox file overwrite failed: {error}"))?
            ()
            Result::Ok(())

fn create_cloud_file(client: &reqwest::Client, parent: &CloudPathRef, access_token: String, name: String, bytes: Array<u8>) -> Result<(), String>:
    match parent.provider():
        CloudProviderId::GoogleDrive =>
            let parent_id = parent.item_id().unwrap_or("root")
            let metadata = serde_json::json!()
            let metadata_part = Part__text(metadata.to_string()).mime_str("application/json").map_err(|error| format!("Failed to build Google Drive upload metadata: {error}"))?
            let media_part = Part__bytes(bytes).file_name(name.to_string())
            ((await client.post("https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart").bearer_auth(access_token).multipart(Form__new_().part("metadata", metadata_part).part("file", media_part)).send_()).map_err(|error| format!("Google Drive file creation failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive file creation failed: {error}"))?
            ()
            Result::Ok(())
        CloudProviderId::Dropbox =>
            let parent_path = parent.item_id().unwrap_or("")
            let remote_path = if parent_path.is_empty():
                format!("/{name}")
            else:
                format!("{}/{}", parent_path.trim_end_matches("/"), name)
            ((await client.post("https://content.dropboxapi.com/2/files/upload").bearer_auth(access_token).header("Dropbox-API-Arg", serde_json::json!().to_string()).header("Content-Type", "application/octet-stream").body(bytes).send_()).map_err(|error| format!("Dropbox file creation failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox file creation failed: {error}"))?
            ()
            Result::Ok(())

fn create_cloud_directory_impl(client: &reqwest::Client, parent: &CloudPathRef, access_token: String, name: String) -> Result<(), String>:
    match parent.provider():
        CloudProviderId::GoogleDrive =>
            let parent_id = parent.item_id().unwrap_or("root")
            ((await client.post("https://www.googleapis.com/drive/v3/files").bearer_auth(access_token).json(&serde_json::json!()).send_()).map_err(|error| format!("Google Drive folder creation failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive folder creation failed: {error}"))?
            ()
            Result::Ok(())
        CloudProviderId::Dropbox =>
            let parent_path = parent.item_id().unwrap_or("")
            let remote_path = if parent_path.is_empty():
                format!("/{name}")
            else:
                format!("{}/{}", parent_path.trim_end_matches("/"), name)
            ((await client.post("https://api.dropboxapi.com/2/files/create_folder_v2").bearer_auth(access_token).json(&serde_json::json!()).send_()).map_err(|error| format!("Dropbox folder creation failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox folder creation failed: {error}"))?
            ()
            Result::Ok(())

fn rename_cloud_path_impl(client: &reqwest::Client, path: &CloudPathRef, access_token: String, new_name: String) -> Result<(), String>:
    match path.provider():
        CloudProviderId::GoogleDrive =>
            let item_id = path.item_id().ok_or_else(|| "Cloud drive roots cannot be renamed.".to_string())?
            ((await client.patch(format!("https://www.googleapis.com/drive/v3/files/{item_id}")).bearer_auth(access_token).json(&serde_json::json!()).send_()).map_err(|error| format!("Google Drive rename failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive rename failed: {error}"))?
            ()
            Result::Ok(())
        CloudProviderId::Dropbox =>
            let item_id = path.item_id().ok_or_else(|| "Cloud drive roots cannot be renamed.".to_string())?
            let parent = dropbox_parent_path(item_id).unwrap_or_default()
            let new_path = if parent.is_empty():
                format!("/{new_name}")
            else:
                format!("{}/{}", parent.trim_end_matches("/"), new_name)
            ((await client.post("https://api.dropboxapi.com/2/files/move_v2").bearer_auth(access_token).json(&serde_json::json!()).send_()).map_err(|error| format!("Dropbox rename failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox rename failed: {error}"))?
            ()
            Result::Ok(())

fn delete_cloud_path_impl(client: &reqwest::Client, path: &CloudPathRef, access_token: String) -> Result<(), String>:
    match path.provider():
        CloudProviderId::GoogleDrive =>
            let item_id = path.item_id().ok_or_else(|| "Cloud drive roots cannot be deleted.".to_string())?
            ((await client.delete_(format!("https://www.googleapis.com/drive/v3/files/{item_id}")).bearer_auth(access_token).send_()).map_err(|error| format!("Google Drive delete failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive delete failed: {error}"))?
            ()
            Result::Ok(())
        CloudProviderId::Dropbox =>
            let item_id = path.item_id().ok_or_else(|| "Cloud drive roots cannot be deleted.".to_string())?
            ((await client.post("https://api.dropboxapi.com/2/files/delete_v2").bearer_auth(access_token).json(&serde_json::json!()).send_()).map_err(|error| format!("Dropbox delete failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox delete failed: {error}"))?
            ()
            Result::Ok(())

fn transfer_between_local_and_cloud(app: &tauri::AppHandle, state: &CloudRuntimeState, client: &reqwest::Client, target_dir: String, source: String, operation: FileTransferOperation) -> Result<(), String>:
    let source_is_cloud = source.starts_with("cloud://")
    let target_is_cloud = target_dir.starts_with("cloud://")
    match (source_is_cloud, target_is_cloud):
        (true, true) =>
            await transfer_cloud_to_cloud(app, state, client, source, target_dir, operation)
        (true, false) =>
            await transfer_cloud_to_local(app, state, client, source, target_dir, operation)
        (false, true) =>
            await transfer_local_to_cloud(app, state, client, source, target_dir, operation)
        (false, false) => Result::Ok(())

fn transfer_local_to_cloud(app: &tauri::AppHandle, state: &CloudRuntimeState, client: &reqwest::Client, source: String, target_dir: String, operation: FileTransferOperation) -> Result<(), String>:
    let target = parse_cloud_path(target_dir)?
    let account = load_account(app, target.account_id())?
    let access_token = (await access_token_for_account(app, state, client, &account))?
    let source_path = PathBuf__from(source)
    (await upload_local_path(client, &target, &access_token, &source_path))?
    ()
    if operation == FileTransferOperation::Move:
        remove_local_path(&source_path)?
        ()
        ()
        ()
        ()
    Result::Ok(())

fn transfer_cloud_to_local(app: &tauri::AppHandle, state: &CloudRuntimeState, client: &reqwest::Client, source: String, target_dir: String, operation: FileTransferOperation) -> Result<(), String>:
    let source_ref = parse_cloud_path(source)?
    let item_id = source_ref.item_id().ok_or_else(|| "Cloud drive roots cannot be downloaded.".to_string())?
    let account = load_account(app, source_ref.account_id())?
    let access_token = (await access_token_for_account(app, state, client, &account))?
    let target_root = PathBuf__from(target_dir)
    if source_ref.provider() == CloudProviderId::GoogleDrive:
        let metadata = (await google_get_file_metadata(client, &access_token, item_id))?
        (await download_google_item_to_local(client, &access_token, &metadata, source_ref.account_id(), &target_root))?
        ()
        ()
        ()
        ()
    else:
        (await download_dropbox_item_to_local(client, &access_token, item_id, &target_root))?
        ()
        ()
        ()
        ()
    if operation == FileTransferOperation::Move:
        (await delete_cloud_path_impl(client, &source_ref, &access_token))?
        ()
        ()
        ()
        ()
    Result::Ok(())

fn transfer_cloud_to_cloud(app: &tauri::AppHandle, state: &CloudRuntimeState, client: &reqwest::Client, source: String, target_dir: String, operation: FileTransferOperation) -> Result<(), String>:
    let source_ref = parse_cloud_path(source)?
    let target_ref = parse_cloud_path(target_dir)?
    if source_ref.provider() != target_ref.provider() or source_ref.account_id() != target_ref.account_id():
        let temp_dir = (temp_root_path(app)?).join(Uuid__new_v4().to_string())
        std__fs__create_dir_all(&temp_dir).map_err(|error| format!("Failed to create temp cloud transfer directory: {error}"))?
        ()
        (await transfer_cloud_to_local(app, state, client, source, temp_dir.to_string_lossy(), FileTransferOperation::Copy))?
        ()
        let source_name = Path__new_(source).file_name().and_then(|value| value.to_str()).unwrap_or("transfer")
        (await transfer_local_to_cloud(app, state, client, temp_dir.join(source_name).to_string_lossy(), target_dir, FileTransferOperation::Copy))?
        ()
        if operation == FileTransferOperation::Move:
            let account = load_account(app, source_ref.account_id())?
            let access_token = (await access_token_for_account(app, state, client, &account))?
            (await delete_cloud_path_impl(client, &source_ref, &access_token))?
            ()
            ()
            ()
            ()
        return Result::Ok(())
    let account = load_account(app, source_ref.account_id())?
    let access_token = (await access_token_for_account(app, state, client, &account))?
    match source_ref.provider():
        CloudProviderId::Dropbox =>
            let from_path = source_ref.item_id().ok_or_else(|| "Cloud drive roots cannot be transferred.".to_string())?
            let target_path = target_ref.item_id().unwrap_or("")
            let name = Path__new_(from_path).file_name().and_then(|value| value.to_str()).unwrap_or("item")
            let destination = if target_path.is_empty():
                format!("/{name}")
            else:
                format!("{}/{}", target_path.trim_end_matches("/"), name)
            let endpoint = if operation == FileTransferOperation::Move:
                "https://api.dropboxapi.com/2/files/move_v2"
            else:
                "https://api.dropboxapi.com/2/files/copy_v2"
            ((await client.post(endpoint).bearer_auth(access_token).json(&serde_json::json!()).send_()).map_err(|error| format!("Dropbox cloud transfer failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox cloud transfer failed: {error}"))?
            ()
            Result::Ok(())
        CloudProviderId::GoogleDrive =>
            let source_item_id = source_ref.item_id().ok_or_else(|| "Cloud drive roots cannot be transferred.".to_string())?
            let target_parent_id = target_ref.item_id().unwrap_or("root")
            let metadata = (await google_get_file_metadata(client, &access_token, source_item_id))?
            if operation == FileTransferOperation::Copy:
                if metadata.mime_type == "application/vnd.google-apps.folder":
                    return Result::Err("Google Drive folder duplication is not implemented yet.".to_string())
                ((await client.post(format!("https://www.googleapis.com/drive/v3/files/{source_item_id}/copy")).bearer_auth(access_token).json(&serde_json::json!()).send_()).map_err(|error| format!("Google Drive cloud copy failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive cloud copy failed: {error}"))?
                ()
                ()
                ()
                ()
            else:
                let remove_parents = metadata.parents.unwrap_or_default().join(",")
                ((await client.patch(format!("https://www.googleapis.com/drive/v3/files/{source_item_id}")).bearer_auth(access_token).query(&[("addParents", target_parent_id), ("removeParents", remove_parents.as_str())]).send_()).map_err(|error| format!("Google Drive cloud move failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive cloud move failed: {error}"))?
                ()
                ()
                ()
                ()
            Result::Ok(())

fn upload_local_path(client: &reqwest::Client, target: &CloudPathRef, access_token: String, source_path: &std::path::Path) -> Result<(), String>:
    let metadata = std__fs__metadata(source_path).map_err(|error| format!("Failed to inspect local source path: {error}"))?
    if metadata.is_dir():
        let folder_name = source_path.file_name().and_then(|value| value.to_str()).ok_or_else(|| "Local folder is missing a valid name.".to_string())?
        (await create_cloud_directory_impl(client, target, access_token, folder_name))?
        ()
        let next_target = match target.provider():
            CloudProviderId::GoogleDrive =>
                let created = (await find_child_by_name(client, target, access_token, folder_name))?
                CloudPathRef::Item { provider: target.provider(), account_id: target.account_id().to_string(), item_id: created }
            CloudProviderId::Dropbox =>
                let parent_path = target.item_id().unwrap_or("")
                CloudPathRef::Item { provider: target.provider(), account_id: target.account_id().to_string(), item_id: if parent_path.is_empty():
                    format!("/{folder_name}")
                else:
                    format!("{}/{}", parent_path.trim_end_matches("/"), folder_name) }
        for child in std__fs__read_dir(source_path).map_err(|error| format!("Failed to enumerate local folder for upload: {error}"))?:
            let child = child.map_err(|error| format!("Failed to read local folder entry: {error}"))?
            (await upload_local_path(client, &next_target, access_token, &child.path()))?
            ()
        ()
        Result::Ok(())
    else:
        let name = source_path.file_name().and_then(|value| value.to_str()).ok_or_else(|| "Local file is missing a valid name.".to_string())?
        let bytes = std__fs__read(source_path).map_err(|error| format!("Failed to read local file for upload: {error}"))?
        await create_cloud_file(client, target, access_token, name, bytes)

fn find_child_by_name(client: &reqwest::Client, parent: &CloudPathRef, access_token: String, child_name: String) -> Result<String, String>:
    match parent.provider():
        CloudProviderId::GoogleDrive =>
            let parent_id = parent.item_id().unwrap_or("root")
            let query = vec!(("q", format!("trashed = false and '{parent_id}' in parents and name = '{child_name}'")), ("fields", "files(id,name)".to_string()), ("pageSize", "100".to_string()))
            let url = Url__parse_with_params("https://www.googleapis.com/drive/v3/files", &query).map_err(|error| format!("Failed to build Google Drive child lookup URL: {error}"))?
            let response = (await (((await client.get(url).bearer_auth(access_token).send_()).map_err(|error| format!("Google Drive child lookup failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive child lookup failed: {error}"))?).json()).map_err(|error| format!("Failed to parse Google Drive child lookup: {error}"))?
            response.files.into_iter().find(|file| file.name == child_name).map(|file| file.id).ok_or_else(|| "Created Google Drive child folder could not be reloaded.".to_string())
        CloudProviderId::Dropbox => Result::Err("Dropbox child lookup is not required.".to_string())

fn download_google_item_to_local(client: &reqwest::Client, access_token: String, metadata: &GoogleDriveFile, account_id: String, destination_root: &std::path::Path) -> Result<(), String>:
    let destination = destination_root.join(&(*metadata).name)
    if (*metadata).mime_type == "application/vnd.google-apps.folder":
        std__fs__create_dir_all(&destination).map_err(|error| format!("Failed to create local folder from Google Drive item: {error}"))?
        ()
        let children = (await google_list_children(client, access_token, &(*metadata).id, account_id))?
        for child in children:
            let child_ref = parse_cloud_path(&child.path)?
            let child_item_id = child_ref.item_id().ok_or_else(|| "Google Drive child item is missing an identifier.".to_string())?
            let child_metadata = await google_get_file_metadata(client, access_token, child_item_id)
            match child_metadata:
                Ok(child_metadata) =>
                    (await download_google_item_to_local(client, access_token, &child_metadata, account_id, &destination))?
                    ()
                _ => ()
        ()
        Result::Ok(())
    else:
        let bytes = (await (((await client.get(format!("https://www.googleapis.com/drive/v3/files/{}?alt=media", (*metadata).id)).bearer_auth(access_token).send_()).map_err(|error| format!("Google Drive download failed: {error}"))?).error_for_status().map_err(|error| format!("Google Drive download failed: {error}"))?).bytes()).map_err(|error| format!("Failed to read Google Drive download payload: {error}"))?
        std__fs__write(destination, bytes).map_err(|error| format!("Failed to write local Google Drive download: {error}"))

fn download_dropbox_item_to_local(client: &reqwest::Client, access_token: String, item_path: String, destination_root: &std::path::Path) -> Result<(), String>:
    let metadata = (await (((await client.post("https://api.dropboxapi.com/2/files/get_metadata").bearer_auth(access_token).json(&serde_json::json!()).send_()).map_err(|error| format!("Dropbox metadata lookup failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox metadata lookup failed: {error}"))?).json()).map_err(|error| format!("Failed to parse Dropbox metadata response: {error}"))?
    let destination = destination_root.join(&metadata.name)
    if metadata.tag == "folder":
        std__fs__create_dir_all(&destination).map_err(|error| format!("Failed to create local Dropbox folder: {error}"))?
        ()
        let children = (await dropbox_list_children(client, access_token, item_path, "local-copy"))?
        for child in children:
            let parsed = parse_cloud_path(&child.path)?
            match parsed.item_id():
                Some(child_item_id) =>
                    (await download_dropbox_item_to_local(client, access_token, child_item_id, &destination))?
                    ()
                _ => ()
        ()
        Result::Ok(())
    else:
        let bytes = (await (((await client.post("https://content.dropboxapi.com/2/files/download").bearer_auth(access_token).header("Dropbox-API-Arg", serde_json::json!().to_string()).send_()).map_err(|error| format!("Dropbox download failed: {error}"))?).error_for_status().map_err(|error| format!("Dropbox download failed: {error}"))?).bytes()).map_err(|error| format!("Failed to read Dropbox download payload: {error}"))?
        std__fs__write(destination, bytes).map_err(|error| format!("Failed to write local Dropbox download: {error}"))

fn remove_local_path(path: &std::path::Path) -> Result<(), String>:
    let metadata = std__fs__metadata(path).map_err(|error| format!("Failed to inspect local path for removal: {error}"))?
    if metadata.is_dir():
        std__fs__remove_dir_all(path).map_err(|error| format!("Failed to remove local directory after transfer: {error}"))
    else:
        std__fs__remove_file(path).map_err(|error| format!("Failed to remove local file after transfer: {error}"))

fn sort_entries(entries: &mut Slice<FileEntry>):
    entries.sort_by(
        |left, right| match (left.is_dir, right.is_dir):
            (true, false) => cmp::Ordering::Less
            (false, true) => cmp::Ordering::Greater
            _ => left.name.to_lowercase().cmp(&right.name.to_lowercase())
    )
    ()

fn parse_timestamp_ms(value: Option<String>) -> u64:
    value.and_then(|raw| DateTime__parse_from_rfc3339(raw).ok()).map(|date| date.with_timezone(&chrono__Utc).timestamp_millis()).unwrap_or_default().max(0) as u64

fn now_ms() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|value| value.as_millis() as u64).unwrap_or_default()

fn mime_from_extension(extension: String) -> String:
    match extension.to_ascii_lowercase().as_str():
        "png" => "image/png"
        "jpg" | "jpeg" => "image/jpeg"
        "gif" => "image/gif"
        "webp" => "image/webp"
        "bmp" => "image/bmp"
        "ico" => "image/x-icon"
        "svg" => "image/svg+xml"
        "tiff" | "tif" => "image/tiff"
        "avif" => "image/avif"
        "glb" => "model/gltf-binary"
        "gltf" => "model/gltf+json"
        "obj" => "text/plain"
        "stl" => "model/stl"
        _ => "application/octet-stream"

struct NativeIconRequest:
    path: String
    size: Option<u32>

struct NativeIconResponse:
    path: String
    src: Option<String>

struct CachedNativeIcon:
    src: Option<String>

fn native_icon_cache() -> &Map<String, CachedNativeIcon>:
    NATIVE_ICON_CACHE.get_or_init(|| Mutex__new_(HashMap__new_()))

fn normalize_icon_size(size: Option<u32>) -> u32:
    size.unwrap_or(DEFAULT_NATIVE_ICON_SIZE).clamp(16, MAX_NATIVE_ICON_SIZE)

fn build_icon_cache_key(path: &std::path::Path, size: u32) -> String:
    format!("{}::{size}", path.to_string_lossy().to_lowercase())

fn encode_png_data_url(bytes: Array<u8>) -> String:
    format!("data:image/png;base64,{}", base64__engine__general_purpose__STANDARD.encode(bytes))

fn icon_pixels_to_png_bytes(width: u32, height: u32, pixels: Array<u8>) -> Result<Array<u8>, String>:
    let image = RgbaImage__from_raw(width, height, pixels).map(image::DynamicImage::ImageRgba8).ok_or_else(|| "native icon provider returned invalid RGBA pixel data".to_string())?
    let mut cursor = Cursor__new_(Vec__new_())
    image.write_to(&mut cursor, image::ImageFormat::Png).map_err(|error| format!("failed to encode native icon as PNG: {error}"))?
    ()
    Result::Ok(cursor.into_inner())

fn icon_pixels_to_png_data_url(width: u32, height: u32, pixels: Array<u8>) -> Result<String, String>:
    Result::Ok(encode_png_data_url(icon_pixels_to_png_bytes(width, height, pixels)?))

fn resolve_native_icon_pixels_with_provider(path: &std::path::Path, size: u32) -> Result<Option<NativeIconPixelBuffer>, String>:
    if !path.exists():
        return Result::Ok(none)
    let icon = file_icon_provider__get_file_icon(path.to_path_buf(), size as u16).map_err(|error| error.to_string())?
    Result::Ok(Option::Some((icon.width, icon.height, icon.pixels)))

fn path_to_wide_null(path: &std::path::Path) -> Array<u16>:
    path.as_os_str().encode_wide().chain(std__iter__once(0)).collect()

fn wide_null_buffer_to_string(buffer: &Slice<u16>) -> String:
    let len = buffer.iter().position(|value| *value == 0).unwrap_or(buffer.len())
    String__from_utf16_lossy(&buffer[..len])

fn expand_windows_icon_location(value: String) -> String:
    let input: Array<u16> = OsStr__new_(value).encode_wide().chain(std__iter__once(0)).collect()
    let required = windows_sys::Win32::System::Environment::ExpandEnvironmentStringsW(input.as_ptr(), std__ptr__null_mut(), 0)
    if required == 0:
        return value.to_string()
    let mut output = vec!()
    let written = windows_sys::Win32::System::Environment::ExpandEnvironmentStringsW(input.as_ptr(), output.as_mut_ptr(), required)
    if written == 0 or written > required:
        return value.to_string()
    wide_null_buffer_to_string(&output)

fn rasterize_windows_hicon(hicon: windows_sys::Win32::UI::WindowsAndMessaging::HICON, size: u32) -> Result<NativeIconPixelBuffer, String>:
    let hdc = windows_sys::Win32::Graphics::Gdi::CreateCompatibleDC(std__ptr__null_mut())
    if hdc == std__ptr__null_mut():
        windows_sys::Win32::UI::WindowsAndMessaging::DestroyIcon(hicon)
        ()
        ()
        ()
        ()
        return Result::Err("failed to create a compatible device context for native icon rendering".to_string())
    let mut bitmap_info: windows_sys::Win32::Graphics::Gdi::BITMAPINFO = std__mem__zeroed()
    bitmap_info.bmiHeader.biSize = std__mem__size_of() as u32
    ()
    bitmap_info.bmiHeader.biWidth = size as i32
    ()
    bitmap_info.bmiHeader.biHeight = -(size as i32)
    ()
    bitmap_info.bmiHeader.biPlanes = 1
    ()
    bitmap_info.bmiHeader.biBitCount = 32
    ()
    bitmap_info.bmiHeader.biCompression = windows_sys::Win32::Graphics::Gdi::BI_RGB
    ()
    let mut pixels_ptr: PtrMut<ffi::c_void> = std__ptr__null_mut()
    let hbitmap = windows_sys::Win32::Graphics::Gdi::CreateDIBSection(hdc, &bitmap_info, windows_sys::Win32::Graphics::Gdi::DIB_RGB_COLORS, &mut pixels_ptr, std__ptr__null_mut(), 0)
    if hbitmap == std__ptr__null_mut() or pixels_ptr.is_null():
        windows_sys::Win32::Graphics::Gdi::DeleteDC(hdc)
        ()
        windows_sys::Win32::UI::WindowsAndMessaging::DestroyIcon(hicon)
        ()
        ()
        ()
        ()
        return Result::Err("failed to create a bitmap surface for native icon rendering".to_string())
    let previous_bitmap = windows_sys::Win32::Graphics::Gdi::SelectObject(hdc, hbitmap as _)
    if previous_bitmap == std__ptr__null_mut():
        windows_sys::Win32::Graphics::Gdi::DeleteObject(hbitmap as _)
        ()
        windows_sys::Win32::Graphics::Gdi::DeleteDC(hdc)
        ()
        windows_sys::Win32::UI::WindowsAndMessaging::DestroyIcon(hicon)
        ()
        ()
        ()
        ()
        return Result::Err("failed to select the native icon bitmap surface".to_string())
    let byte_len = (size as usize) * (size as usize) * 4
    std__ptr__write_bytes(pixels_ptr as PtrMut<u8>, 0, byte_len)
    ()
    ()
    ()
    ()
    let draw_result = windows_sys::Win32::UI::WindowsAndMessaging::DrawIconEx(hdc, 0, 0, hicon, size as i32, size as i32, 0, std__ptr__null_mut(), windows_sys::Win32::UI::WindowsAndMessaging::DI_NORMAL)
    let mut pixels = if draw_result == 0:
        Vec__new_()
    else:
        std__slice__from_raw_parts(pixels_ptr as Ptr<u8>, byte_len).to_vec()
    windows_sys::Win32::Graphics::Gdi::SelectObject(hdc, previous_bitmap)
    ()
    windows_sys::Win32::Graphics::Gdi::DeleteObject(hbitmap as _)
    ()
    windows_sys::Win32::Graphics::Gdi::DeleteDC(hdc)
    ()
    windows_sys::Win32::UI::WindowsAndMessaging::DestroyIcon(hicon)
    ()
    ()
    ()
    ()
    if draw_result == 0:
        return Result::Err("failed to rasterize native Windows icon".to_string())
    for chunk in pixels.chunks_exact_mut(4):
        chunk.swap(0, 2)
        ()
    ()
    Result::Ok((size, size, pixels))

fn extract_windows_icon_location_pixels(icon_path: &std::path::Path, icon_index: i32, size: u32) -> Result<Option<NativeIconPixelBuffer>, String>:
    if !icon_path.exists():
        return Result::Ok(none)
    let path_wide = path_to_wide_null(icon_path)
    let mut large_icon: windows_sys::Win32::UI::WindowsAndMessaging::HICON = std__ptr__null_mut()
    let count = windows_sys::Win32::UI::Shell::ExtractIconExW(path_wide.as_ptr(), icon_index, &mut large_icon, std__ptr__null_mut(), 1)
    if count == 0 or large_icon == std__ptr__null_mut():
        return Result::Ok(none)
    rasterize_windows_hicon(large_icon, size).map(|__kain_closure_arg0| Option::Some(__kain_closure_arg0))

fn load_windows_shortcut_icon_target(path: &std::path::Path) -> Result<Option<(std::path::PathBuf, i32)>, String>:
    if !path.exists() or path.extension().and_then(|extension| extension.to_str()).map(|extension| !extension.eq_ignore_ascii_case("lnk")).unwrap_or(true):
        return Result::Ok(none)
    let coinit_result = windows::Win32::System::Com::CoInitializeEx(none, windows::Win32::System::Com::COINIT_APARTMENTTHREADED)
    let needs_uninit = coinit_result.is_ok()
    let result = fn() -> Result<Option<(std::path::PathBuf, i32)>, String>:
        let shell_link: windows::Win32::UI::Shell::IShellLinkW = windows::Win32::System::Com::CoCreateInstance(&windows::Win32::UI::Shell::ShellLink, none, windows::Win32::System::Com::CLSCTX_INPROC_SERVER).map_err(|error| error.to_string())?
        let persist_file: windows::Win32::System::Com::IPersistFile = shell_link.cast().map_err(|error| error.to_string())?
        let shortcut_path_wide = path_to_wide_null(path)
        persist_file.Load(windows__core__PCWSTR(shortcut_path_wide.as_ptr()), windows::Win32::System::Com::STGM_READ).map_err(|error| error.to_string())?
        ()
        let mut icon_path_buffer = vec!()
        let mut icon_index = 0
        if shell_link.GetIconLocation(&mut icon_path_buffer, &mut icon_index).is_ok():
            let icon_path = expand_windows_icon_location(wide_null_buffer_to_string(&icon_path_buffer).trim())
            if !icon_path.is_empty():
                return Result::Ok(Option::Some((PathBuf__from(icon_path), icon_index)))
            ()
        let mut target_path_buffer = vec!()
        if shell_link.GetPath(&mut target_path_buffer, std__ptr__null_mut(), 0).is_ok():
            let target_path = expand_windows_icon_location(wide_null_buffer_to_string(&target_path_buffer).trim())
            if !target_path.is_empty():
                return Result::Ok(Option::Some((PathBuf__from(target_path), 0)))
            ()
        Result::Ok(none)()
    if needs_uninit:
        windows::Win32::System::Com::CoUninitialize()
        ()
        ()
        ()
        ()
    result

fn resolve_native_icon_pixels_with_windows_shortcut(path: &std::path::Path, size: u32) -> Result<Option<NativeIconPixelBuffer>, String>:
    let Some((icon_path, icon_index)) = load_windows_shortcut_icon_target(path)?
    match extract_windows_icon_location_pixels(&icon_path, icon_index, size)?:
        Some(icon) =>
            return Result::Ok(Option::Some(icon))
        _ =>
            ()
            ()
    resolve_native_icon_pixels_with_provider(&icon_path, size)

fn resolve_native_icon_pixels_with_windows_shell(path: &std::path::Path, size: u32) -> Result<Option<NativeIconPixelBuffer>, String>:
    if !path.exists():
        return Result::Ok(none)
    let path_wide = path_to_wide_null(path)
    let mut file_info: windows_sys::Win32::UI::Shell::SHFILEINFOW = std__mem__zeroed()
    let icon_size = if size <= 16:
        windows_sys::Win32::UI::Shell::SHGFI_SMALLICON
    else:
        windows_sys::Win32::UI::Shell::SHGFI_LARGEICON
    let file_attributes = if path.is_dir():
        windows_sys::Win32::Storage::FileSystem::FILE_ATTRIBUTE_DIRECTORY
    else:
        windows_sys::Win32::Storage::FileSystem::FILE_ATTRIBUTE_NORMAL
    let result = windows_sys::Win32::UI::Shell::SHGetFileInfoW(path_wide.as_ptr(), file_attributes, &mut file_info, std__mem__size_of() as u32, windows_sys::Win32::UI::Shell::SHGFI_ICON | icon_size)
    if result == 0 or file_info.hIcon == std__ptr__null_mut():
        return Result::Ok(none)
    rasterize_windows_hicon(file_info.hIcon, size).map(|__kain_closure_arg1| Option::Some(__kain_closure_arg1))

fn resolve_native_icon_pixels(path: &std::path::Path, size: u32) -> Result<Option<NativeIconPixelBuffer>, String>:
    match resolve_native_icon_pixels_with_windows_shortcut(path, size):
        Ok(Some(icon)) => return Result::Ok(Option::Some(icon))
        Ok(None) =>
            ()
        Err(error) =>
            warn!("GreebleFS: Windows shortcut icon extraction failed for {}: {}", path.display(), error)
            ()
            ()
    ()
    match resolve_native_icon_pixels_with_provider(path, size):
        Ok(Some(icon)) => return Result::Ok(Option::Some(icon))
        Ok(None) =>
            ()
        Err(error) =>
            warn!("GreebleFS: file_icon_provider failed for {}: {}", path.display(), error)
            ()
            ()
    match resolve_native_icon_pixels_with_windows_shell(path, size):
        Ok(Some(icon)) => return Result::Ok(Option::Some(icon))
        Ok(None) =>
            ()
        Err(error) =>
            warn!("GreebleFS: Windows shell icon extraction failed for {}: {}", path.display(), error)
            ()
            ()
    ()
    Result::Ok(none)

fn resolve_native_icon_png_bytes(path: &std::path::Path, size: u32) -> Result<Option<Array<u8>>, String>:
    let Some((width, height, pixels)) = resolve_native_icon_pixels(path, size)?
    let png = icon_pixels_to_png_bytes(width, height, pixels)?
    Result::Ok(Option::Some(png))

fn resolve_native_icon_for_path(path: &std::path::Path, size: u32) -> Result<Option<String>, String>:
    let Some((width, height, pixels)) = resolve_native_icon_pixels(path, size)?
    let src = icon_pixels_to_png_data_url(width, height, pixels)?
    Result::Ok(Option::Some(src))

fn put_pixel_if_in_bounds(image: &mut image::RgbaImage, x: i32, y: i32, color: image::Rgba<u8>):
    if x < 0 or y < 0:
        return
    let x = x as u32
    let y = y as u32
    if x < image.width() and y < image.height():
        image.put_pixel(x, y, color)
        ()

fn fill_rect(image: &mut image::RgbaImage, left: u32, top: u32, right: u32, bottom: u32, color: image::Rgba<u8>):
    let clamped_right = right.min(image.width())
    let clamped_bottom = bottom.min(image.height())
    for y in top.min(clamped_bottom)..clamped_bottom:
        for x in left.min(clamped_right)..clamped_right:
            image.put_pixel(x, y, color)
            ()

fn build_default_drag_preview_png() -> Result<Array<u8>, String>:
    let mut image = RgbaImage__from_pixel(64, 64, image__Rgba([0, 0, 0, 0]))
    let shadow = image__Rgba([0, 0, 0, 48])
    let body = image__Rgba([243, 246, 252, 255])
    let body_outline = image__Rgba([104, 114, 132, 255])
    let fold = image__Rgba([221, 228, 240, 255])
    let accent = image__Rgba([73, 151, 255, 255])
    let text = image__Rgba([141, 152, 171, 255])
    fill_rect(&mut image, 17, 15, 51, 55, shadow)
    ()
    fill_rect(&mut image, 15, 11, 49, 51, body)
    ()
    for x in 15..49:
        put_pixel_if_in_bounds(&mut image, x as i32, 11, body_outline)
        ()
        put_pixel_if_in_bounds(&mut image, x as i32, 50, body_outline)
        ()
    ()
    for y in 11..51:
        put_pixel_if_in_bounds(&mut image, 15, y as i32, body_outline)
        ()
        put_pixel_if_in_bounds(&mut image, 48, y as i32, body_outline)
        ()
    ()
    for y in 11..24:
        for x in 35..49:
            if (x - 35) + (y - 11) >= 13:
                put_pixel_if_in_bounds(&mut image, x as i32, y as i32, fold)
                ()
    ()
    for x in 36..49:
        put_pixel_if_in_bounds(&mut image, x as i32, 11, body_outline)
        ()
    ()
    for y in 11..24:
        put_pixel_if_in_bounds(&mut image, 48, y as i32, body_outline)
        ()
    ()
    for offset in 0..13:
        put_pixel_if_in_bounds(&mut image, (35 + offset) as i32, (11 + offset) as i32, body_outline)
        ()
    ()
    fill_rect(&mut image, 19, 18, 41, 23, accent)
    ()
    fill_rect(&mut image, 19, 29, 40, 31, text)
    ()
    fill_rect(&mut image, 19, 36, 35, 38, text)
    ()
    fill_rect(&mut image, 19, 43, 31, 45, text)
    ()
    let mut cursor = Cursor__new_(Vec__new_())
    image::DynamicImage::ImageRgba8(image).write_to(&mut cursor, image::ImageFormat::Png).map_err(|error| format!("failed to encode default drag preview PNG: {error}"))?
    ()
    Result::Ok(cursor.into_inner())

fn default_drag_preview_png() -> &Slice<u8>:
    DEFAULT_DRAG_PREVIEW_PNG.get_or_init(|| build_default_drag_preview_png().unwrap_or_else(|_| FALLBACK_APP_ICON_PNG.to_vec())).as_slice()

fn resolve_native_icons_batch(requests: Array<NativeIconRequest>) -> Array<NativeIconResponse>:
    let mut responses = |__kain_ctor_arg0| Vec::new()(requests.len())
    for request in requests:
        let path = PathBuf__from(&request.path)
        let size = normalize_icon_size(request.size)
        let cache_key = build_icon_cache_key(&path, size)
        let cached = native_icon_cache().lock().ok().and_then(|cache| cache.get(&cache_key).cloned())
        match cached:
            Some(entry) =>
                responses.push(NativeIconResponse { path: request.path, src: entry.src })
                ()
                continue
            _ =>
                ()
                ()
        let src = resolve_native_icon_for_path(&path, size).unwrap_or(none)
        match native_icon_cache().lock():
            Ok(mut cache) =>
                cache.insert(cache_key, CachedNativeIcon { src: src.clone() })
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        responses.push(NativeIconResponse { path: request.path, src: src })
        ()
    ()
    responses

fn run_on_window_main_thread(window: &tauri::WebviewWindow, task: F) -> Result<T, String>:
    let (sender, receiver) = std__sync__mpsc__sync_channel(1)
    window.run_on_main_thread(|| let _ = sender.send_(task())).map_err(|error| error.to_string())?
    ()
    receiver.recv().map_err(|error| format!("failed to receive main-thread task result: {error}"))

fn collect_drag_paths(paths: Array<String>) -> Array<std::path::PathBuf>:
    paths.into_iter().filter_map(
        |path| block:
            let trimmed = path.trim()
            if trimmed.is_empty():
                return none
            let candidate = PathBuf__from(trimmed)
            if !candidate.exists():
                return none
            std__fs__canonicalize(&candidate).ok().or_(Option::Some(candidate))
    ).collect()

fn start_native_drag_impl(window: tauri::WebviewWindow, drag_paths: Array<std::path::PathBuf>) -> Result<(), String>:
    if drag_paths.is_empty():
        return Result::Ok(())
    let preview_icon = drag_paths.first().and_then(|path| resolve_native_icon_png_bytes(path, DRAG_PREVIEW_ICON_SIZE).ok().flatten()).map(drag::Image::Raw).unwrap_or_else(|| drag::Image::Raw(default_drag_preview_png().to_vec()))
    let drag_item = drag::DragItem::Files(drag_paths)
    let gtk_window = window.gtk_window().map_err(|error| error.to_string())?
    drag__start_drag(&gtk_window, drag_item, preview_icon, |_result, _cursor_position| (), Options__default_()).map_err(|error| error.to_string())
    ()
    ()
    drag__start_drag(&window, drag_item, preview_icon, |_result, _cursor_position| (), Options__default_()).map_err(|error| error.to_string())

fn fs_resolve_native_icons(requests: Array<NativeIconRequest>) -> Result<Array<NativeIconResponse>, String>:
    if requests.is_empty():
        return Result::Ok(Vec__new_())
    Result::Ok(resolve_native_icons_batch(requests))

fn fs_start_native_file_drag(window: tauri::WebviewWindow, paths: Array<String>) -> Result<(), String>:
    let drag_paths = collect_drag_paths(paths)
    if drag_paths.is_empty():
        return Result::Ok(())
    let drag_window = window.clone()
    run_on_window_main_thread(&window, || start_native_drag_impl(drag_window, drag_paths))?

struct DevMcpNativeAutomationCapabilities:
    health: Bool
    host_api: Bool
    host_events: Bool
    telemetry: Bool
    usr_profiles: Bool
    window_metadata: Bool

struct DevMcpNativeAutomationSessionRecord:
    version: u32
    pid: u32
    started_at_unix_ms: u64
    updated_at_unix_ms: u64
    file_path: String
    base_url: String
    health_url: String
    rpc_url: String
    host_events_subscribe_url: String
    host_events_read_url: String
    host_events_unsubscribe_url: String
    auth_token: String
    capabilities: DevMcpNativeAutomationCapabilities

struct DevMcpNativeAutomationWindowRecord:
    window_label: String
    title: String
    visible: Option<Bool>
    secondary_window_id: Option<String>
    secondary_window_kind: Option<String>

struct DevMcpNativeAutomationRpcRequest:
    method: String
    payload: Option<serde_json::Value>

struct DevMcpNativeAutomationRpcResponse:
    ok: Bool
    result: Option<serde_json::Value>
    error: Option<String>

struct NativeHostEventsReadQuery:
    subscription_id: String
    after_sequence: Option<u64>

struct NativeHostEventsUnsubscribeRequest:
    subscription_id: String

struct NativeHostEventsSubscriptionSummary:
    subscription_id: String
    host_subscription_id: String
    created_at_unix_ms: u64
    updated_at_unix_ms: u64
    dropped_events: u64
    latest_sequence: Option<u64>

struct NativeHostEventsReadResponse:
    subscription: NativeHostEventsSubscriptionSummary
    events: Array<HostEventEnvelope>

struct NativeHostEventsSubscriptionState:
    request: HostSubscriptionRequest
    host_subscription_id: String
    created_at_unix_ms: u64
    updated_at_unix_ms: u64
    dropped_events: u64
    events: Array<HostEventEnvelope>

impl NativeHostEventsSubscriptionState:
    fn new_(request: HostSubscriptionRequest, host_subscription_id: String) -> NativeHostEventsSubscriptionState:
        let now = now_unix_ms()
        NativeHostEventsSubscriptionState { request: request, host_subscription_id: host_subscription_id, created_at_unix_ms: now, updated_at_unix_ms: now, dropped_events: 0, events: VecDeque__new_() }

    fn push_event(_self: &mut NativeHostEventsSubscriptionState, event: HostEventEnvelope):
        (*_self).updated_at_unix_ms = now_unix_ms()
        ()
        if (*_self).events.len() >= MAX_SUBSCRIPTION_EVENTS:
            (*_self).events.pop_front()
            ()
            (*_self).dropped_events = (*_self).dropped_events + 1
            ()
            ()
            ()
            ()
        (*_self).events.push_back(event)
        ()

    fn summary(_self: &NativeHostEventsSubscriptionState, subscription_id: String) -> NativeHostEventsSubscriptionSummary:
        NativeHostEventsSubscriptionSummary { subscription_id: subscription_id.to_string(), host_subscription_id: (*_self).host_subscription_id.clone(), created_at_unix_ms: (*_self).created_at_unix_ms, updated_at_unix_ms: (*_self).updated_at_unix_ms, dropped_events: (*_self).dropped_events, latest_sequence: (*_self).events.back().map(|event| event.sequence) }


struct DevMcpNativeAutomationState:
    app: tauri::AppHandle
    auth_token: String
    session_record: DevMcpNativeAutomationSessionRecord
    subscriptions: Map<String, NativeHostEventsSubscriptionState>

struct DevMcpNativeAutomationServerHandle:
    shutdown: tokio::sync::watch::Sender<Bool>
    session_file_path: std::path::PathBuf

impl Drop for DevMcpNativeAutomationServerHandle:
    fn drop(_self: &mut DevMcpNativeAutomationServerHandle):
        let _ = (*_self).shutdown.send_(true)
        let _ = std__fs__remove_file(&(*_self).session_file_path)


fn start_dev_mcp_native_automation_server(app: &tauri::AppHandle) -> Result<Option<DevMcpNativeAutomationServerHandle>, String>:
    if !read_enabled_environment_flag():
        return Result::Ok(none)
    let session_file_path = match resolve_session_file_path():
        Some(path) => path
        None => return Result::Ok(none)
    let std_listener = TcpListener__bind("127.0.0.1:0").map_err(|error| format!("Failed to bind the dev MCP native automation server: {error}"))?
    std_listener.set_nonblocking(true).map_err(|error| format!("Failed to configure the dev MCP native automation server socket: {error}"))?
    ()
    let socket_addr = std_listener.local_addr().map_err(|error| format!("Failed to resolve the dev MCP automation socket address: {error}"))?
    let auth_token = Uuid__new_v4().to_string()
    let started_at_unix_ms = now_unix_ms()
    let base_url = format!("http://127.0.0.1:{}", socket_addr.port())
    let session_record = DevMcpNativeAutomationSessionRecord { version: 1, pid: std__process__id(), started_at_unix_ms: started_at_unix_ms, updated_at_unix_ms: started_at_unix_ms, file_path: normalize_path_for_json(&session_file_path), base_url: base_url.clone(), health_url: format!("{base_url}/health"), rpc_url: format!("{base_url}/rpc"), host_events_subscribe_url: format!("{base_url}/host-events/subscribe"), host_events_read_url: format!("{base_url}/host-events/read"), host_events_unsubscribe_url: format!("{base_url}/host-events/unsubscribe"), auth_token: auth_token.clone(), capabilities: DevMcpNativeAutomationCapabilities { health: true, host_api: true, host_events: true, telemetry: true, usr_profiles: true, window_metadata: true } }
    write_session_record(&session_file_path, &session_record)?
    ()
    let state = DevMcpNativeAutomationState { app: app.clone(), auth_token: auth_token, session_record: session_record, subscriptions: Arc__new_(Mutex__new_(HashMap__new_())) }
    let router = Router__new_().route("/health", axum__routing__get(handle_health)).route("/rpc", axum__routing__post(handle_rpc)).route("/host-events/subscribe", axum__routing__post(handle_host_events_subscribe)).route("/host-events/read", axum__routing__get(handle_host_events_read)).route("/host-events/unsubscribe", axum__routing__post(handle_host_events_unsubscribe)).with_state(state)
    let (shutdown_tx, mut shutdown_rx) = tokio__sync__watch__channel(false)
    let session_file_path_for_server = session_file_path.clone()
    tauri__async_runtime__spawn_(
        async:
            let listener = match TcpListener__from_std(std_listener):
                Ok(listener) => listener
                Err(error) =>
                    eprintln!("GreebleFS: failed to create the Tokio listener for dev MCP native automation: {error}")
                    let _ = std__fs__remove_file(&session_file_path_for_server)
                    return
            let _ = await axum__serve(listener, router).with_graceful_shutdown(
                async:
                    while (await shutdown_rx.changed()).is_ok():
                        if *shutdown_rx.borrow():
                            break
            )
    )
    ()
    Result::Ok(Option::Some(DevMcpNativeAutomationServerHandle { shutdown: shutdown_tx, session_file_path: session_file_path }))

fn handle_health(_: axum::extract::State<DevMcpNativeAutomationState>, headers: axum::http::HeaderMap) -> axum::response::Response:
    match authorize_request(&headers, &state):
        Ok(()) => axum__Json(serde_json::json!()).into_response()
        Err(response) => response

fn handle_rpc(_: axum::extract::State<DevMcpNativeAutomationState>, headers: axum::http::HeaderMap, _: axum::Json<DevMcpNativeAutomationRpcRequest>) -> axum::response::Response:
    match authorize_request(&headers, &state):
        Err(response) =>
            return response
        _ =>
            ()
            ()
    let response = match await dispatch_rpc_request(&state, request):
        Ok(result) => DevMcpNativeAutomationRpcResponse { ok: true, result: Option::Some(result), error: none }
        Err(error) => DevMcpNativeAutomationRpcResponse { ok: false, result: none, error: Option::Some(error) }
    axum__Json(response).into_response()

fn handle_host_events_subscribe(_: axum::extract::State<DevMcpNativeAutomationState>, headers: axum::http::HeaderMap, _: axum::Json<HostSubscriptionRequest>) -> axum::response::Response:
    match authorize_request(&headers, &state):
        Err(response) =>
            return response
        _ =>
            ()
            ()
    match create_native_host_subscription(&state, request):
        Ok(result) => axum__Json(result).into_response()
        Err(error) => error_response(axum::http::StatusCode::BAD_REQUEST, error)

fn handle_host_events_read(_: axum::extract::State<DevMcpNativeAutomationState>, headers: axum::http::HeaderMap, _: axum::extract::Query<NativeHostEventsReadQuery>) -> axum::response::Response:
    match authorize_request(&headers, &state):
        Err(response) =>
            return response
        _ =>
            ()
            ()
    let records = match state.subscriptions.lock():
        Ok(records) => records
        Err(_) =>
            return error_response(axum::http::StatusCode::INTERNAL_SERVER_ERROR, "Native host-event registry lock poisoned.")
    let record = match records.get(query.subscription_id.as_str()):
        Some(record) => record
        None =>
            return error_response(axum::http::StatusCode::NOT_FOUND, format!("Unknown native host-event subscription id: {}", query.subscription_id))
    let events = record.events.iter().filter(
        |event| match query.after_sequence:
            Some(after_sequence) => event.sequence > after_sequence
            None => true
    ).cloned().collect()
    axum__Json(NativeHostEventsReadResponse { subscription: record.summary(query.subscription_id.as_str()), events: events }).into_response()

fn handle_host_events_unsubscribe(_: axum::extract::State<DevMcpNativeAutomationState>, headers: axum::http::HeaderMap, _: axum::Json<NativeHostEventsUnsubscribeRequest>) -> axum::response::Response:
    match authorize_request(&headers, &state):
        Err(response) =>
            return response
        _ =>
            ()
            ()
    let removed = match state.subscriptions.lock():
        Ok(mut records) => records.remove(request.subscription_id.as_str())
        Err(_) =>
            return error_response(axum::http::StatusCode::INTERNAL_SERVER_ERROR, "Native host-event registry lock poisoned.")
    let Some(record) = removed
    let host_event_bus = state.app.state()
    let _ = host_event_bus.unsubscribe(&state.app, record.host_subscription_id.as_str())
    axum__Json(serde_json::json!()).into_response()

fn dispatch_rpc_request(state: &DevMcpNativeAutomationState, request: DevMcpNativeAutomationRpcRequest) -> Result<serde_json::Value, String>:
    match request.method.as_str():
        "host.get_api_schema" =>
            let schema = runtime_pipeline__build_extension_host_api_schema()
            serde_json__to_value(schema).map_err(|error| format!("Failed to serialize the extension-host API schema: {error}"))
        "host.call" =>
            let payload = request.payload.ok_or_else(|| "host.call requires a payload object.".to_string())?
            let method_id = payload.get("methodId").and_then(Value__as_str).map(str__trim).filter(|value| !value.is_empty()).ok_or_else(|| "host.call requires a non-empty string methodId.".to_string())?
            let host_payload_json = payload.get("payload").map(serde_json__to_string).transpose().map_err(|error| format!("Failed to encode the native host-call payload: {error}"))?
            let execution_context = payload.get("executionContext").cloned().map(serde_json__from_value).transpose().map_err(|error| format!("Failed to decode host.call executionContext: {error}"))?
            let response_json = (await runtime_pipeline__commands__dispatch_native_dev_host_call((*state).app.clone(), &(*state).app.state(), ExtensionHostCallRequest { caller_plugin_id: none, caller_runtime_id: none, method_id: method_id.to_string(), payload_json: host_payload_json, execution_context: execution_context }))?
            serde_json__from_str(&response_json).map_err(|error| format!("Failed to decode the native host-call JSON response: {error}"))
        "host.events.get_snapshot" =>
            let payload = request.payload.ok_or_else(|| "host.events.get_snapshot requires a payload object.".to_string())?
            let subscription_request: HostSubscriptionRequest = serde_json__from_value(payload).map_err(|error| format!("Failed to decode the host-events snapshot request: {error}"))?
            let host_event_bus = (*state).app.state()
            serde_json__to_value(host_event_bus.snapshots_for_request(&subscription_request)).map_err(|error| format!("Failed to serialize the native host-events snapshot response: {error}"))
        "telemetry.get_status" => serde_json__to_value(telemetry__telemetry_get_status((*state).app.clone(), (*state).app.state())?).map_err(|error| format!("Failed to serialize the native telemetry status: {error}"))
        "telemetry.get_recent_records" =>
            let limit = request.payload.and_then(|value| value.get("limit")).and_then(Value__as_u64).map(|value| value as usize)
            serde_json__to_value(telemetry__telemetry_get_recent_records((*state).app.state(), limit)?).map_err(|error| format!("Failed to serialize the native telemetry records: {error}"))
        "usr_profiles.get_runtime_snapshot" => serde_json__to_value((await usr_profiles__usr_profiles_get_runtime_snapshot((*state).app.clone()))?).map_err(|error| format!("Failed to serialize the native USR profile runtime snapshot: {error}"))
        "windows.get_metadata" => serde_json__to_value(collect_window_records(&(*state).app)).map_err(|error| format!("Failed to serialize native window metadata: {error}"))
        other => Result::Err(format!("Unsupported dev MCP native automation RPC method: {other}"))

fn create_native_host_subscription(state: &DevMcpNativeAutomationState, request: HostSubscriptionRequest) -> Result<NativeHostEventsReadResponse, String>:
    let subscription_id = Uuid__new_v4().to_string()
    let subscriptions = Arc__clone(&(*state).subscriptions)
    let subscription_id_for_sink = subscription_id.clone()
    let host_event_bus = (*state).app.state()
    let subscription = host_event_bus.subscribe_callback(
        request.clone(),
        "dev-mcp-native-automation".to_string(),
        Arc__new_(
            |event| match subscriptions.lock():
                Ok(mut records) =>
                    match records.get_mut(subscription_id_for_sink.as_str()):
                        Some(record) =>
                            record.push_event(event)
                            ()
                        _ => ()
                _ => ()
        )
    )?
    let mut record = NativeHostEventsSubscriptionState__new_(request.clone(), subscription.subscription_id)
    let snapshots = host_event_bus.snapshots_for_request(&request)
    for mut event in snapshots:
        event.subscription_id = Option::Some(subscription_id.clone())
        ()
        record.push_event(event)
        ()
    ()
    let response = NativeHostEventsReadResponse { subscription: record.summary(subscription_id.as_str()), events: record.events.iter().cloned().collect() }
    ((*state).subscriptions.lock().map_err(|_| "Native host-event registry lock poisoned.".to_string())?).insert(subscription_id, record)
    ()
    Result::Ok(response)

fn collect_window_records(app: &tauri::AppHandle) -> Array<DevMcpNativeAutomationWindowRecord>:
    let secondary_windows = app.state()
    let mut records = app.webview_windows().into_iter().map(
        |__kain_closure_arg0| block:
            let descriptor = secondary_windows.find_descriptor_by_window_label(__kain_closure_arg0.__kain_tuple_0.as_str())
            DevMcpNativeAutomationWindowRecord { title: __kain_closure_arg0.__kain_tuple_1.title().unwrap_or_else(|_| __kain_closure_arg0.__kain_tuple_0.clone()), visible: __kain_closure_arg0.__kain_tuple_1.is_visible().ok(), secondary_window_id: descriptor.map(|value| value.window_id.clone()), secondary_window_kind: descriptor.map(|value| secondary_window_kind_to_string(&value.surface_kind)), window_label: __kain_closure_arg0.__kain_tuple_0 }
    ).collect()
    records.sort_by(|left, right| left.window_label.cmp(&right.window_label))
    ()
    records

fn secondary_window_kind_to_string(kind: &SecondaryWindowSurfaceKind) -> String:
    match kind:
        SecondaryWindowSurfaceKind::ExplorerPicker => "explorer-picker".to_string()
        SecondaryWindowSurfaceKind::FileOperations => "file-operations".to_string()
        SecondaryWindowSurfaceKind::Panel => "panel".to_string()
        SecondaryWindowSurfaceKind::PluginPanel => "plugin-panel".to_string()
        SecondaryWindowSurfaceKind::ActionWidget => "action-widget".to_string()
        SecondaryWindowSurfaceKind::Lookdev => "lookdev".to_string()

fn authorize_request(headers: &axum::http::HeaderMap, state: &DevMcpNativeAutomationState) -> Result<(), axum::response::Response>:
    let provided_token = headers.get("x-greeblefs-dev-token").and_then(|value| value.to_str().ok()).map(str__trim).filter(|value| !value.is_empty())
    if provided_token == Option::Some((*state).auth_token.as_str()):
        return Result::Ok(())
    Result::Err(error_response(axum::http::StatusCode::UNAUTHORIZED, "Unauthorized dev MCP native automation request."))

fn error_response(status: axum::http::StatusCode, message: impl Into<String>) -> axum::response::Response:
    (status, axum__Json(serde_json::json!())).into_response()

fn read_enabled_environment_flag() -> Bool:
    matches!(std__env__var_(ENV_GREEBLEFS_MCP_ENABLED).ok().or_else(|| std__env__var_(ENV_OVERLAYTERM_MCP_ENABLED).ok()), Option::Some("1" | "true" | "TRUE" | "yes" | "YES"))

fn resolve_session_file_path() -> Option<std::path::PathBuf>:
    std__env__var_(ENV_GREEBLEFS_MCP_NATIVE_AUTOMATION_FILE).ok().or_else(|| std__env__var_(ENV_OVERLAYTERM_MCP_NATIVE_AUTOMATION_FILE).ok()).map(|value| value.trim().to_string()).filter(|value| !value.is_empty()).map(PathBuf__from)

fn write_session_record(session_file_path: &std::path::Path, record: &DevMcpNativeAutomationSessionRecord) -> Result<(), String>:
    match session_file_path.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create the dev MCP native automation directory {}: {error}", parent.display()))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let content = serde_json__to_string_pretty(record).map_err(|error| format!("Failed to encode the dev MCP native automation session record: {error}"))?
    std__fs__write(session_file_path, format!("{content}\n")).map_err(|error| format!("Failed to write the dev MCP native automation session record {}: {error}", session_file_path.display()))

fn normalize_path_for_json(path: &std::path::Path) -> String:
    path.to_string_lossy().replace("\\", "/")

fn now_unix_ms() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_millis() as u64).unwrap_or_default()

fn initialize_greeblefs_dev_observatory(app: &tauri::AppHandle) -> Result<(), String>:
    let mut config = DevObservatoryConfig__dev_default("GreebleFS")
    match resolve_dev_log_path():
        Some(log_path) =>
            config.log_file_paths.push(log_path)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    tauri__dev_observatory__init(app, config)?
    ()
    let app_for_runtime = app.clone()
    tauri__dev_observatory__register_json_provider(app, "greeblefs.runtime", "GreebleFS Runtime", || build_greeblefs_runtime_snapshot(&app_for_runtime))

fn build_greeblefs_runtime_snapshot(app: &tauri::AppHandle) -> Result<serde_json::Value, String>:
    let telemetry_status = app.try_state().map(|state| telemetry__telemetry_get_status(app.clone(), state)).transpose()?
    let telemetry_records = app.try_state().map(|state| telemetry__telemetry_get_recent_records(state, Option::Some(60))).transpose()?
    let native_task_graph = app.try_state().map(|state| serde_json__to_value(state.telemetry_snapshot())).transpose().map_err(|error| format!("Failed to serialize native task graph telemetry: {error}"))?
    let preview_streaming = app.try_state().map(|state| serde_json__to_value(state.policy())).transpose().map_err(|error| format!("Failed to serialize preview streaming policy: {error}"))?
    let gpu = app.try_state().map(|state| serde_json__to_value(state.status_snapshot())).transpose().map_err(|error| format!("Failed to serialize GPU runtime status: {error}"))?
    Result::Ok(serde_json::json!())

fn resolve_dev_log_path() -> Option<std::path::PathBuf>:
    std__env__var_os("GREEBLEFS_MCP_LOG_FILE").map(PathBuf__from).or_else(|| std__env__current_dir().ok().map(|cwd| cwd.join("MCP").join(".state").join("tauri-dev.log")))

fn load_runtime_usr_domain_catalog(app: &tauri::AppHandle, relative_path: String, catalog_name: String, fallback_loader: F) -> Array<T>:
    match usr__read_usr_text_file(app, relative_path):
        Ok(text) =>
            match serde_json__from_str(&text):
                Ok(entries) => entries
                Err(error) =>
                    eprintln!("failed to parse runtime usr domain catalog {} at {}: {}", catalog_name, relative_path, error)
                    fallback_loader()
        Err(error) =>
            eprintln!("failed to read runtime usr domain catalog {} at {}: {}", catalog_name, relative_path, error)
            fallback_loader()

fn domain_list_shell_blueprints(app: tauri::AppHandle) -> Array<overlay_contracts::ShellBlueprint>:
