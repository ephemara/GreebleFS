struct PersistedEntrySize:
    path: String
    bytes: u64
    is_dir: Bool
    is_complete: Bool
    modified_ms: Option<u64>
    entry_bytes: Option<u64>
    measured_at_ms: u64
    dirty: Bool

fn normalize_cache_path(path: &std::path::Path) -> String:
    ExplorerPathKey__from_path(path).into_string()

fn initialize_entry_size_cache(app: &tauri::AppHandle) -> Result<(), String>:
    let db_path = (app.path().app_local_data_dir().map_err(|error| format!("Failed to resolve app local data directory: {error}"))?).join("explorer-cache").join("entry-sizes.sqlite3")
    let _ = ENTRY_SIZE_DB_PATH.set(db_path.clone())
    ensure_schema(&db_path)?
    ()
    Result::Ok(())

fn resolve_db_path() -> Result<std::path::PathBuf, String>:
    match std__env__var_(ENTRY_SIZE_DB_ENV):
        Ok(override_path) =>
            let trimmed = override_path.trim()
            if !trimmed.is_empty():
                return Result::Ok(PathBuf__from(trimmed))
            ()
        _ =>
            ()
            ()
    ENTRY_SIZE_DB_PATH.get().cloned().ok_or_else(|| "Entry size cache has not been initialized".to_string())

fn ensure_schema(path: &std::path::Path) -> Result<(), String>:
    match path.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create entry size cache directory: {error}"))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let connection = Connection__open(path).map_err(|error| format!("Failed to open entry size cache database: {error}"))?
    connection.execute_batch("\n            PRAGMA journal_mode = WAL;\n            PRAGMA synchronous = NORMAL;\n            PRAGMA temp_store = MEMORY;\n\n            CREATE TABLE IF NOT EXISTS entry_size_cache (\n                path TEXT PRIMARY KEY,\n                bytes INTEGER NOT NULL,\n                is_dir INTEGER NOT NULL,\n                is_complete INTEGER NOT NULL,\n                modified_ms INTEGER,\n                entry_bytes INTEGER,\n                measured_at_ms INTEGER NOT NULL,\n                dirty INTEGER NOT NULL DEFAULT 0\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_entry_size_cache_dirty\n            ON entry_size_cache (dirty);\n            ").map_err(|error| format!("Failed to initialize entry size cache schema: {error}"))?
    ()
    Result::Ok(())

fn with_connection(operation: impl FnOnce) -> Result<T, String>:
    let db_path = resolve_db_path()?
    ensure_schema(&db_path)?
    ()
    let connection = Connection__open(&db_path).map_err(|error| format!("Failed to open entry size cache database: {error}"))?
    operation(&connection)

fn u64_to_i64(value: u64) -> Result<i64, String>:
    i64__try_from(value).map_err(|_| format!("Value {value} exceeds SQLite integer range"))

fn i64_to_u64(value: i64) -> Result<u64, String>:
    u64__try_from(value).map_err(|_| format!("Negative SQLite value {value} cannot become u64"))

fn persisted_entry_size_from_row(row: &rusqlite::Row<_>) -> Result<PersistedEntrySize, Error>:
    Result::Ok(PersistedEntrySize { path: row.get(0)?, bytes: i64_to_u64(row.get(1)?).map_err(|error| rusqlite::Error::ToSqlConversionFailure(error.into()))?, is_dir: row.get(2)? != 0, is_complete: row.get(3)? != 0, modified_ms: (row.get(4)?).map(i64_to_u64).transpose().map_err(|error| rusqlite::Error::ToSqlConversionFailure(error.into()))?, entry_bytes: (row.get(5)?).map(i64_to_u64).transpose().map_err(|error| rusqlite::Error::ToSqlConversionFailure(error.into()))?, measured_at_ms: i64_to_u64(row.get(6)?).map_err(|error| rusqlite::Error::ToSqlConversionFailure(error.into()))?, dirty: row.get(7)? != 0 })

fn load_entry_size_cache(paths: &Slice<std::path::PathBuf>) -> Result<Map<String, PersistedEntrySize>, String>:
    if paths.is_empty():
        return Result::Ok(HashMap__new_())
    with_connection(
        |connection| block:
            let mut unique_keys = |__kain_ctor_arg0| Vec::new()(paths.len())
            let mut seen = |__kain_ctor_arg0| std::collections::HashMap::new()(paths.len())
            for path in paths:
                let key = normalize_cache_path(path)
                if seen.insert(key.clone(), ()).is_none():
                    unique_keys.push(key)
                    ()
            ()
            let mut entries = |__kain_ctor_arg0| std::collections::HashMap::new()(unique_keys.len())
            for chunk in unique_keys.chunks(SQLITE_PARAMETER_LIMIT):
                let placeholders = std__iter__repeat_n("?", chunk.len()).collect().join(", ")
                let query = format!("\n                SELECT path, bytes, is_dir, is_complete, modified_ms, entry_bytes, measured_at_ms, dirty\n                FROM entry_size_cache\n                WHERE path IN ({placeholders})\n                ")
                let mut statement = connection.prepare(&query).map_err(|error| format!("Failed to prepare entry size cache read: {error}"))?
                let mut rows = statement.query(rusqlite__params_from_iter(chunk.iter())).map_err(|error| format!("Failed to query entry size cache batch: {error}"))?
                loop:
                    match rows.next().map_err(|error| format!("Failed to read entry size cache row: {error}"))?:
                        Some(row) =>
                            let entry = persisted_entry_size_from_row(row).map_err(|error| format!("Failed to decode entry size cache row: {error}"))?
                            entries.insert(entry.path.clone(), entry)
                            ()
                        _ => break
            ()
            Result::Ok(entries)
    )

fn upsert_entry_size_cache(entries: &Slice<PersistedEntrySize>) -> Result<(), String>:
    if entries.is_empty():
        return Result::Ok(())
    with_connection(
        |connection| block:
            let mut statement = connection.prepare_cached("\n                INSERT INTO entry_size_cache (\n                    path, bytes, is_dir, is_complete, modified_ms, entry_bytes, measured_at_ms, dirty\n                )\n                VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)\n                ON CONFLICT(path) DO UPDATE SET\n                    bytes = excluded.bytes,\n                    is_dir = excluded.is_dir,\n                    is_complete = excluded.is_complete,\n                    modified_ms = excluded.modified_ms,\n                    entry_bytes = excluded.entry_bytes,\n                    measured_at_ms = excluded.measured_at_ms,\n                    dirty = excluded.dirty\n                ").map_err(|error| format!("Failed to prepare entry size cache upsert: {error}"))?
            for entry in entries:
                statement.execute(
                    params!(entry.path, u64_to_i64(entry.bytes)?, if entry.is_dir:
                        1
                    else:
                        0, if entry.is_complete:
                        1
                    else:
                        0, entry.modified_ms.map(u64_to_i64).transpose()?, entry.entry_bytes.map(u64_to_i64).transpose()?, u64_to_i64(entry.measured_at_ms)?, if entry.dirty:
                        1
                    else:
                        0)
                ).map_err(|error| format!("Failed to upsert cached entry size for {}: {error}", entry.path))?
                ()
            ()
            Result::Ok(())
    )

fn delete_entry_size_subtree(path: &std::path::Path) -> Result<(), String>:
    let key = normalize_cache_path(path)
    let subtree_prefix = format!("{}{}%", key, std__path__MAIN_SEPARATOR)
    with_connection(
        |connection| block:
            connection.execute("\n                DELETE FROM entry_size_cache\n                WHERE path = ?1 OR path LIKE ?2\n                ", params!(key, subtree_prefix)).map_err(|error| format!("Failed to delete cached subtree for {}: {error}", path.display()))?
            ()
            Result::Ok(())
    )

fn mark_path_and_ancestors_dirty(path: &std::path::Path) -> Result<(), String>:
    let mut keys = Vec__new_()
    for ancestor in path.ancestors():
        let key = normalize_cache_path(ancestor)
        if !key.is_empty():
            keys.push(key)
            ()
    ()
    if keys.is_empty():
        return Result::Ok(())
    with_connection(
        |connection| block:
            let mut statement = connection.prepare_cached("UPDATE entry_size_cache SET dirty = 1 WHERE path = ?1").map_err(|error| format!("Failed to prepare entry size dirty update: {error}"))?
            for key in keys:
                statement.execute(params!(key)).map_err(|error| format!("Failed to mark cached path dirty: {error}"))?
                ()
            ()
            Result::Ok(())
    )

struct ActiveEntrySizeWatcher:
    root: std::path::PathBuf
    watcher: notify::RecommendedWatcher
    ref_count: usize

struct EntrySizeWatcherState:
    active: Map<String, ActiveEntrySizeWatcher>

impl Default for EntrySizeWatcherState:
    fn default_() -> EntrySizeWatcherState:
        EntrySizeWatcherState { active: HashMap__new_() }


fn watch_key_for_path(path: &std::path::Path) -> String:
    std__fs__canonicalize(path).map(|value| normalize_cache_path(&value)).unwrap_or_else(|_| normalize_cache_path(path))

fn handle_watch_event(event: notify::Event):
    for path in event.paths:
        fs_commands__invalidate_all_fs_caches_for_path(&path)
        ()

fn resolve_watch_root(path: String) -> Result<std::path::PathBuf, String>:
    let root = PathBuf__from(path)
    let provider = Local__regular(&root)
    let metadata = (await provider.metadata()).map_err(|error| format!("Path is not available for watching '{}': {error}", path))?
    if !ChaType__from(metadata.mode).is_dir():
        return Result::Err(format!("Path is not a directory: {path}"))
    Result::Ok((await provider.canonicalize()).ok().and_then(|url| url.as_local().map(PathBuf__from)).unwrap_or(root))

fn fs_watch_entry_size_root(state: tauri::State<_, EntrySizeWatcherState>, path: String) -> Result<(), String>:
    let trimmed = path.trim()
    if trimmed.is_empty():
        return Result::Err("path cannot be empty".to_string())
    let root = (await resolve_watch_root(trimmed))?
    let watch_key = watch_key_for_path(&root)
    let mut active = state.active.lock().map_err(|_| "entry size watcher state lock poisoned".to_string())?
    match active.get_mut(&watch_key):
        Some(existing) =>
            existing.ref_count = existing.ref_count + 1
            ()
            return Result::Ok(())
        _ =>
            ()
            ()
    let watch_root = root.clone()
    let mut watcher = notify__recommended_watcher(
        |result| match result:
            Ok(event) =>
                handle_watch_event(event)
                ()
            _ => ()
    ).map_err(|error| format!("Could not create entry size watcher: {error}"))?
    watcher.watch(&watch_root, notify::RecursiveMode::NonRecursive).map_err(|error| format!("Could not watch entry size root '{}': {error}", watch_root.display()))?
    ()
    active.insert(watch_key, ActiveEntrySizeWatcher { root: watch_root, watcher: watcher, ref_count: 1 })
    ()
    Result::Ok(())

fn fs_unwatch_entry_size_root(state: tauri::State<_, EntrySizeWatcherState>, path: String) -> Result<(), String>:
    let trimmed = path.trim()
    if trimmed.is_empty():
        return Result::Ok(())
    let watch_key = watch_key_for_path(Path__new_(trimmed))
    let mut active = state.active.lock().map_err(|_| "entry size watcher state lock poisoned".to_string())?
    let should_remove = active.get(&watch_key).map(|watcher| watcher.ref_count <= 1).unwrap_or(false)
    if !should_remove:
        match active.get_mut(&watch_key):
            Some(existing) =>
                existing.ref_count = existing.ref_count - 1
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        return Result::Ok(())
    match active.remove(&watch_key):
        Some(mut current) =>
            let _ = current.watcher.unwatch(&current.root)
            ()
        _ =>
            ()
            ()
    Result::Ok(())

enum ExplorerIdentityKind:
    Native
    Operation
    Derived

struct ExplorerResolvedIdentity:
    entity_id: String
    identity_kind: ExplorerIdentityKind
    content_revision: String

struct PersistedThumbnailArtifactRecordInput:
    entity_id: String
    content_revision: String
    kind: String
    variant_key: String
    poster_path: String
    hover_frame_paths: Array<String>
    hover_frame_delay_ms: Option<u32>

struct PersistedPathIdentityAlias:
    path_key: String
    entity_id: String
    identity_kind: ExplorerIdentityKind
    updated_at_ms: u64

struct ExplorerIdentityManager:
    path_identity_aliases: Map<String, PersistedPathIdentityAlias>

impl Default for ExplorerIdentityManager:
    fn default_() -> ExplorerIdentityManager:
        ExplorerIdentityManager { path_identity_aliases: HashMap__new_() }


fn initialize_explorer_identity_store(app: &tauri::AppHandle) -> Result<(), String>:
    let db_path = (app.path().app_local_data_dir().map_err(|error| format!("Failed to resolve app local data directory: {error}"))?).join("explorer-cache").join("explorer-identity.sqlite3")
    let _ = EXPLORER_IDENTITY_DB_PATH.set(db_path.clone())
    ensure_schema(&db_path)?
    ()
    Result::Ok(())

fn build_content_revision(size: u64, modified: u64, is_dir: Bool, is_symlink: Bool) -> String:
    let mut hasher = Sha256__new_()
    hasher.update(size.to_le_bytes())
    ()
    hasher.update(modified.to_le_bytes())
    ()
    hasher.update(
        [if is_dir:
            1
        else:
            0]
    )
    ()
    hasher.update(
        [if is_symlink:
            1
        else:
            0]
    )
    ()
    format!("rev-{:x}", hasher.finalize())

fn build_virtual_identity(namespace: String, stable_key: String, content_revision: String) -> ExplorerResolvedIdentity:
    ExplorerResolvedIdentity { entity_id: build_entity_id(namespace_, stable_key), identity_kind: ExplorerIdentityKind::Derived, content_revision: content_revision.to_string() }

fn resolve_local_identity(app: &tauri::AppHandle, manager: &ExplorerIdentityManager, path: &std::path::Path, content_revision: String) -> Result<ExplorerResolvedIdentity, String>:
    match resolve_native_identity_key(path)?:
        Some(native_key) =>
            let path_key = normalize_path_key(path)
            let _ = remove_path_identity_alias(app, manager, &path_key)
            return Result::Ok(ExplorerResolvedIdentity { entity_id: build_entity_id("native", &native_key), identity_kind: ExplorerIdentityKind::Native, content_revision: content_revision.to_string() })
        _ =>
            ()
            ()
    let path_key = normalize_path_key(path)
    match load_path_identity_alias(app, manager, &path_key)?:
        Some(alias) =>
            return Result::Ok(ExplorerResolvedIdentity { entity_id: alias.entity_id, identity_kind: alias.identity_kind, content_revision: content_revision.to_string() })
        _ =>
            ()
            ()
    let alias = PersistedPathIdentityAlias { path_key: path_key.clone(), entity_id: build_entity_id("derived", &path_key), identity_kind: ExplorerIdentityKind::Derived, updated_at_ms: now_ms() }
    upsert_path_identity_alias(app, manager, alias.clone())?
    ()
    Result::Ok(ExplorerResolvedIdentity { entity_id: alias.entity_id, identity_kind: alias.identity_kind, content_revision: content_revision.to_string() })

fn resolve_fast_local_listing_identity(manager: &ExplorerIdentityManager, path: &std::path::Path, content_revision: String) -> ExplorerResolvedIdentity:
    let path_key = normalize_path_key(path)
    match (*manager).path_identity_aliases.lock():
        Ok(cache) =>
            match cache.get(&path_key):
                Some(alias) =>
                    return ExplorerResolvedIdentity { entity_id: alias.entity_id.clone(), identity_kind: alias.identity_kind, content_revision: content_revision.to_string() }
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    build_virtual_identity("derived", &path_key, content_revision)

fn prepare_move_operation_continuity(app: &tauri::AppHandle, manager: &ExplorerIdentityManager, source_path: &std::path::Path, content_revision: String) -> Result<Option<String>, String>:
    let identity = resolve_local_identity(app, manager, source_path, content_revision)?
    if identity.identity_kind == ExplorerIdentityKind::Native:
        return Result::Ok(none)
    Result::Ok(Option::Some(identity.entity_id))

fn apply_move_operation_continuity(app: &tauri::AppHandle, manager: &ExplorerIdentityManager, source_path: &std::path::Path, destination_path: &std::path::Path, entity_id: Option<String>) -> Result<(), String>:
    let source_key = normalize_path_key(source_path)
    remove_path_identity_alias(app, manager, &source_key)?
    ()
    let Some(entity_id) = entity_id
    let destination_key = normalize_path_key(destination_path)
    upsert_path_identity_alias(app, manager, PersistedPathIdentityAlias { path_key: destination_key, entity_id: entity_id.to_string(), identity_kind: ExplorerIdentityKind::Operation, updated_at_ms: now_ms() })

fn record_thumbnail_artifact(app: &tauri::AppHandle, record: PersistedThumbnailArtifactRecordInput) -> Result<(), String>:
    let artifact_key = build_thumbnail_artifact_key(&record.entity_id, &record.content_revision, &record.variant_key, &record.kind)
    with_connection(
        app,
        |connection| block:
            let hover_frame_paths = serde_json__to_string(&record.hover_frame_paths).map_err(|error| format!("Failed to serialize thumbnail hover frame paths: {error}"))?
            connection.execute("\n                INSERT INTO explorer_thumbnail_artifacts (\n                    artifact_key,\n                    entity_id,\n                    content_revision,\n                    kind,\n                    variant_key,\n                    poster_path,\n                    hover_frame_paths_json,\n                    hover_frame_delay_ms,\n                    updated_at_ms\n                )\n                VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)\n                ON CONFLICT(artifact_key) DO UPDATE SET\n                    entity_id = excluded.entity_id,\n                    content_revision = excluded.content_revision,\n                    kind = excluded.kind,\n                    variant_key = excluded.variant_key,\n                    poster_path = excluded.poster_path,\n                    hover_frame_paths_json = excluded.hover_frame_paths_json,\n                    hover_frame_delay_ms = excluded.hover_frame_delay_ms,\n                    updated_at_ms = excluded.updated_at_ms\n                ", params!(artifact_key, record.entity_id, record.content_revision, record.kind, record.variant_key, record.poster_path, hover_frame_paths, record.hover_frame_delay_ms.map(i64__from), u64_to_i64(now_ms())?)).map_err(|error| format!("Failed to persist explorer thumbnail artifact record: {error}"))?
            ()
            Result::Ok(())
    )

fn resolve_db_path(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    match std__env__var_(EXPLORER_IDENTITY_DB_ENV):
        Ok(override_path) =>
            let trimmed = override_path.trim()
            if !trimmed.is_empty():
                return Result::Ok(PathBuf__from(trimmed))
            ()
        _ =>
            ()
            ()
    match EXPLORER_IDENTITY_DB_PATH.get():
        Some(existing_path) =>
            return Result::Ok(existing_path.clone())
        _ =>
            ()
            ()
    let db_path = (app.path().app_local_data_dir().map_err(|error| format!("Failed to resolve app local data directory: {error}"))?).join("explorer-cache").join("explorer-identity.sqlite3")
    let _ = EXPLORER_IDENTITY_DB_PATH.set(db_path.clone())
    Result::Ok(db_path)

fn ensure_schema(path: &std::path::Path) -> Result<(), String>:
    match path.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create explorer identity directory: {error}"))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let connection = Connection__open(path).map_err(|error| format!("Failed to open explorer identity database: {error}"))?
    connection.execute_batch("\n            PRAGMA journal_mode = WAL;\n            PRAGMA synchronous = NORMAL;\n            PRAGMA temp_store = MEMORY;\n\n            CREATE TABLE IF NOT EXISTS explorer_path_identity_aliases (\n                path_key TEXT PRIMARY KEY,\n                entity_id TEXT NOT NULL,\n                identity_kind TEXT NOT NULL,\n                updated_at_ms INTEGER NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_explorer_path_identity_aliases_updated_at\n            ON explorer_path_identity_aliases (updated_at_ms);\n\n            CREATE TABLE IF NOT EXISTS explorer_thumbnail_artifacts (\n                artifact_key TEXT PRIMARY KEY,\n                entity_id TEXT NOT NULL,\n                content_revision TEXT NOT NULL,\n                kind TEXT NOT NULL,\n                variant_key TEXT NOT NULL,\n                poster_path TEXT NOT NULL,\n                hover_frame_paths_json TEXT NOT NULL,\n                hover_frame_delay_ms INTEGER,\n                updated_at_ms INTEGER NOT NULL\n            );\n\n            CREATE INDEX IF NOT EXISTS idx_explorer_thumbnail_artifacts_entity_revision\n            ON explorer_thumbnail_artifacts (entity_id, content_revision);\n            ").map_err(|error| format!("Failed to initialize explorer identity schema: {error}"))?
    ()
    Result::Ok(())

fn with_connection(app: &tauri::AppHandle, operation: impl FnOnce) -> Result<T, String>:
    let db_path = resolve_db_path(app)?
    ensure_schema(&db_path)?
    ()
    let connection = Connection__open(&db_path).map_err(|error| format!("Failed to open explorer identity database: {error}"))?
    operation(&connection)

fn build_entity_id(namespace: String, stable_key: String) -> String:
    let mut hasher = Sha256__new_()
    hasher.update(namespace_.as_bytes())
    ()
    hasher.update([58])
    ()
    hasher.update(stable_key.as_bytes())
    ()
    format!("entity-{:x}", hasher.finalize())

fn build_thumbnail_artifact_key(entity_id: String, content_revision: String, variant_key: String, kind: String) -> String:
    let mut hasher = Sha256__new_()
    hasher.update(entity_id.as_bytes())
    ()
    hasher.update([58])
    ()
    hasher.update(content_revision.as_bytes())
    ()
    hasher.update([58])
    ()
    hasher.update(variant_key.as_bytes())
    ()
    hasher.update([58])
    ()
    hasher.update(kind.as_bytes())
    ()
    format!("artifact-{:x}", hasher.finalize())

fn load_path_identity_alias(app: &tauri::AppHandle, manager: &ExplorerIdentityManager, path_key: String) -> Result<Option<PersistedPathIdentityAlias>, String>:
    match (*manager).path_identity_aliases.lock():
        Ok(cache) =>
            match cache.get(path_key):
                Some(alias) =>
                    return Result::Ok(Option::Some(alias.clone()))
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    let alias = with_connection(app, |connection| connection.query_row("\n                SELECT path_key, entity_id, identity_kind, updated_at_ms\n                FROM explorer_path_identity_aliases\n                WHERE path_key = ?1\n                ", params!(path_key), persisted_path_identity_alias_from_row).optional().map_err(|error| format!("Failed to query explorer path identity alias: {error}")))?
    match alias:
        Some(alias) =>
            match (*manager).path_identity_aliases.lock():
                Ok(mut cache) =>
                    cache.insert(path_key.to_string(), alias.clone())
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    Result::Ok(alias)

fn upsert_path_identity_alias(app: &tauri::AppHandle, manager: &ExplorerIdentityManager, alias: PersistedPathIdentityAlias) -> Result<(), String>:
    with_connection(
        app,
        |connection| block:
            connection.execute("\n                INSERT INTO explorer_path_identity_aliases (\n                    path_key,\n                    entity_id,\n                    identity_kind,\n                    updated_at_ms\n                )\n                VALUES (?1, ?2, ?3, ?4)\n                ON CONFLICT(path_key) DO UPDATE SET\n                    entity_id = excluded.entity_id,\n                    identity_kind = excluded.identity_kind,\n                    updated_at_ms = excluded.updated_at_ms\n                ", params!(alias.path_key, alias.entity_id, identity_kind_to_storage(alias.identity_kind), u64_to_i64(alias.updated_at_ms)?)).map_err(|error| format!("Failed to upsert explorer path identity alias: {error}"))?
            ()
            Result::Ok(())
    )?
    ()
    match (*manager).path_identity_aliases.lock():
        Ok(mut cache) =>
            cache.insert(alias.path_key.clone(), alias)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn remove_path_identity_alias(app: &tauri::AppHandle, manager: &ExplorerIdentityManager, path_key: String) -> Result<(), String>:
    with_connection(
        app,
        |connection| block:
            connection.execute("\n                DELETE FROM explorer_path_identity_aliases\n                WHERE path_key = ?1\n                ", params!(path_key)).map_err(|error| format!("Failed to delete explorer path identity alias: {error}"))?
            ()
            Result::Ok(())
    )?
    ()
    match (*manager).path_identity_aliases.lock():
        Ok(mut cache) =>
            cache.remove(path_key)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn persisted_path_identity_alias_from_row(row: &rusqlite::Row<_>) -> Result<PersistedPathIdentityAlias, Error>:
    let identity_kind = identity_kind_from_storage(&row.get(2)?).map_err(|error| rusqlite::Error::ToSqlConversionFailure(error.into()))?
    Result::Ok(PersistedPathIdentityAlias { path_key: row.get(0)?, entity_id: row.get(1)?, identity_kind: identity_kind, updated_at_ms: i64_to_u64(row.get(3)?).map_err(|error| rusqlite::Error::ToSqlConversionFailure(error.into()))? })

fn identity_kind_to_storage(value: ExplorerIdentityKind) -> String:
    match value:
        ExplorerIdentityKind::Native => "native"
        ExplorerIdentityKind::Operation => "operation"
        ExplorerIdentityKind::Derived => "derived"

fn identity_kind_from_storage(value: String) -> Result<ExplorerIdentityKind, String>:
    match value:
        "native" => Result::Ok(ExplorerIdentityKind::Native)
        "operation" => Result::Ok(ExplorerIdentityKind::Operation)
        "derived" => Result::Ok(ExplorerIdentityKind::Derived)
        other => Result::Err(format!("Unsupported explorer identity kind '{other}'"))

fn normalize_path_key(path: &std::path::Path) -> String:
    ExplorerPathKey__from_path(path).into_string()

fn now_ms() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_millis() as u64).unwrap_or(0)

fn u64_to_i64(value: u64) -> Result<i64, String>:
    i64__try_from(value).map_err(|_| format!("Value {value} exceeds SQLite integer range"))

fn i64_to_u64(value: i64) -> Result<u64, String>:
    u64__try_from(value).map_err(|_| format!("Negative SQLite value {value} cannot become u64"))

fn resolve_native_identity_key(path: &std::path::Path) -> Result<Option<String>, String>:
    let metadata = std__fs__symlink_metadata(path).map_err(|error| format!("Failed to inspect local entry identity metadata '{}': {error}", path.display()))?
    let device_id = metadata.dev()
    let inode = metadata.ino()
    if inode == 0:
        return Result::Ok(none)
    Result::Ok(Option::Some(format!("unix:{device_id}:{inode}")))

fn resolve_native_identity_key(path: &std::path::Path) -> Result<Option<String>, String>:
    let file = OpenOptions__new_().read(true).custom_flags(windows_sys::Win32::Storage::FileSystem::FILE_FLAG_BACKUP_SEMANTICS | windows_sys::Win32::Storage::FileSystem::FILE_FLAG_OPEN_REPARSE_POINT).open(path)
    let Ok(file) = file
    let mut info = MaybeUninit__zeroed()
    let handle = file.as_raw_handle()
    let success = windows_sys::Win32::Storage::FileSystem::GetFileInformationByHandle(handle, info.as_mut_ptr())
    if success == 0:
        return Result::Ok(none)
    let info = info.assume_init()
    let file_index = ((info.nFileIndexHigh as u64) << 32) | u64__from(info.nFileIndexLow)
    if file_index == 0:
        return Result::Ok(none)
    Result::Ok(Option::Some(format!("windows:{}:{}", info.dwVolumeSerialNumber, file_index)))

fn resolve_native_identity_key(_path: &std::path::Path) -> Result<Option<String>, String>:
    Result::Ok(none)

struct ExplorerPathHash64:
    field_0: u64

impl ExplorerPathHash64:
    fn value(_self: ExplorerPathHash64) -> u64:
        _self.field_0


struct ExplorerPathKey:
    normalized: String
    hash64: ExplorerPathHash64

impl ExplorerPathKey:
    fn from_path(path: &std::path::Path) -> ExplorerPathKey:
        ExplorerPathKey__from_raw(path.to_string_lossy())

    fn from_raw(raw: String) -> ExplorerPathKey:
        let normalized = normalize_explorer_path_key(raw)
        let hash64 = ExplorerPathHash64(stable_hash64(normalized.as_bytes()))
        ExplorerPathKey { normalized: normalized, hash64: hash64 }

    fn as_str(_self: &ExplorerPathKey) -> String:
        &(*_self).normalized

    fn hash64(_self: &ExplorerPathKey) -> ExplorerPathHash64:
        (*_self).hash64

    fn into_string(_self: ExplorerPathKey) -> String:
        _self.normalized

    fn descendant_prefix(_self: &ExplorerPathKey) -> String:
        let separator = platform_separator()
        if (*_self).normalized.ends_with(separator):
            (*_self).normalized.clone()
        else:
            format!("{}{separator}", (*_self).normalized)

    fn is_same_or_descendant_of(_self: &ExplorerPathKey, ancestor: &ExplorerPathKey) -> Bool:
        (*_self).normalized == (*ancestor).normalized or (*_self).normalized.starts_with(&ancestor.descendant_prefix())


impl PartialEq for ExplorerPathKey:
    fn eq(_self: &ExplorerPathKey, other: &ExplorerPathKey) -> Bool:
        (*_self).normalized == (*other).normalized


impl std::hash::Hash for ExplorerPathKey:
    fn hash(_self: &ExplorerPathKey, state: &mut H):
        state.write_u64((*_self).hash64.value())
        ()


impl std::fmt::Debug for ExplorerPathKey:
    fn fmt(_self: &ExplorerPathKey, formatter: &mut std::fmt::Formatter<_>) -> Result<(), Error>:
        formatter.debug_struct("ExplorerPathKey").field("normalized", &(*_self).normalized).field("hash64", &(*_self).hash64).finish()


impl std::fmt::Display for ExplorerPathKey:
    fn fmt(_self: &ExplorerPathKey, formatter: &mut std::fmt::Formatter<_>) -> Result<(), Error>:
        formatter.write_str(&(*_self).normalized)


fn stable_hash64(bytes: &Slice<u8>) -> u64:
    let mut hash = FNV1A64_OFFSET
    for byte in bytes:
        hash = hash ^ u64__from(*byte)
        ()
        hash = hash.wrapping_mul(FNV1A64_PRIME)
        ()
    ()
    hash

fn platform_separator() -> Char:
    "\\"

fn platform_separator() -> Char:
    "/"

fn normalize_explorer_path_key(raw: String) -> String:
    let mut value = raw.trim().replace("/", "\\")
    match value.strip_prefix("\\\\?\\UNC\\"):
        Some(stripped) =>
            value = format!("\\\\{stripped}")
            ()
            ()
            ()
            ()
        _ =>
            match value.strip_prefix("\\\\?\\"):
                Some(stripped) =>
                    value = stripped.to_string()
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
    let minimum_len = windows_minimum_trailing_separator_len(&value)
    while value.len() > minimum_len and value.ends_with("\\"):
        value.pop()
        ()
    ()
    value.to_ascii_lowercase()

fn normalize_explorer_path_key(raw: String) -> String:
    let mut value = raw.trim().to_string()
    while value.len() > 1 and value.ends_with("/"):
        value.pop()
        ()
    ()
    value

fn windows_minimum_trailing_separator_len(value: String) -> usize:
    let bytes = value.as_bytes()
    if bytes.len() >= 3 and bytes[1] == 58 and bytes[2] == 92:
        return 3
    if value == "\\":
        return 1
    0

