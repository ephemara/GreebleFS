struct NativeTaskGraphManager:
    inner: NativeTaskGraphInner

impl NativeTaskGraphManager:
    fn new_(policy: NativeTaskGraphPolicy) -> NativeTaskGraphManager:
        NativeTaskGraphManager { inner: Arc__new_(NativeTaskGraphInner { policy: policy, state: Mutex__new_(NativeTaskGraphState__new_()) }) }

    fn from_app(app: &tauri::AppHandle) -> NativeTaskGraphManager:
        let manifest_text = usr__read_usr_text_file(app, "profiles/default/explorer-performance/greeblefs-core/explorer-performance.json").ok()
        let policy = manifest_text.map(NativeTaskGraphPolicy__from_explorer_performance_json).unwrap_or_default()
        NativeTaskGraphManager__new_(policy)

    fn policy(_self: &NativeTaskGraphManager) -> NativeTaskGraphPolicy:
        (*_self).inner.policy.clone()

    fn telemetry_snapshot(_self: &NativeTaskGraphManager) -> NativeTaskGraphTelemetry:
        let state = (*_self).inner.state.lock().unwrap()
        state.telemetry.snapshot(&state.active_by_lane)

    fn cancel(_self: &NativeTaskGraphManager, task_id: String) -> Bool:
        let mut queued_to_cancel = Vec__new_()
        let mut cancelled = false
        let mut state = (*_self).inner.state.lock().unwrap()
        let related_ids: Array<NativeTaskId> = state.records.iter().filter_map(
            |__kain_closure_arg0| if __kain_closure_arg0.__kain_tuple_0 == task_id or __kain_closure_arg0.__kain_tuple_1.parent_task_id == Option::Some(task_id) or __kain_closure_arg0.__kain_tuple_1.ancestor_task_ids.iter().any(|ancestor| ancestor == task_id):
                Option::Some(__kain_closure_arg0.__kain_tuple_0.clone())
            else:
                none
        ).collect()
        for related_id in related_ids:
            match state.records.get(&related_id):
                Some(record) =>
                    record.token.cancel()
                    ()
                    cancelled = true
                    ()
                _ => ()
        ()
        let mut retained = |__kain_ctor_arg0| Vec::new()(state.queue.len())
        let mut cancelled_queued_records = Vec__new_()
        for task in state.queue.drain(..):
            if task.token.is_cancelled():
                cancelled_queued_records.push((task.id.clone(), task.lane))
                ()
                queued_to_cancel.push(task)
                ()
            else:
                retained.push(task)
                ()
        ()
        state.queue = retained
        ()
        for (task_id, lane) in cancelled_queued_records:
            state.finish_queued_cancelled_by_id(&task_id, lane)
            ()
        ()
        state.refresh_queue_depth()
        ()
        ()
        ()
        ()
        for task in queued_to_cancel:
            task.complete_queued_cancelled(NATIVE_TASK_CANCELLED_ERROR.to_string())
            ()
        ()
        (*_self).dispatch_ready()
        ()
        cancelled

    fn cancel_work_key(_self: &NativeTaskGraphManager, work_key: &NativeTaskWorkKey) -> usize:
        let mut queued_to_cancel = Vec__new_()
        let mut cancelled_count = 0
        let mut state = (*_self).inner.state.lock().unwrap()
        let related_ids: Array<NativeTaskId> = state.records.iter().filter_map(
            |__kain_closure_arg1| if __kain_closure_arg1.__kain_tuple_1.work_key == Option::Some(work_key):
                Option::Some(__kain_closure_arg1.__kain_tuple_0.clone())
            else:
                none
        ).collect()
        for task_id in related_ids:
            match state.records.get(&task_id):
                Some(record) =>
                    record.token.cancel()
                    ()
                    cancelled_count = cancelled_count + 1
                    ()
                _ => ()
        ()
        let mut retained = |__kain_ctor_arg0| Vec::new()(state.queue.len())
        let mut cancelled_queued_records = Vec__new_()
        for task in state.queue.drain(..):
            if task.token.is_cancelled():
                cancelled_queued_records.push((task.id.clone(), task.lane))
                ()
                queued_to_cancel.push(task)
                ()
            else:
                retained.push(task)
                ()
        ()
        state.queue = retained
        ()
        for (task_id, lane) in cancelled_queued_records:
            state.finish_queued_cancelled_by_id(&task_id, lane)
            ()
        ()
        state.refresh_queue_depth()
        ()
        ()
        ()
        ()
        for task in queued_to_cancel:
            task.complete_queued_cancelled(NATIVE_TASK_CANCELLED_ERROR.to_string())
            ()
        ()
        (*_self).dispatch_ready()
        ()
        cancelled_count

    fn submit_blocking(_self: &NativeTaskGraphManager, request: NativeTaskRequest, work: F) -> Result<NativeTaskSubmission<T>, String>:
        let (sender, receiver) = tokio__sync__oneshot__channel()
        let sender_slot = Arc__new_(Mutex__new_(Option::Some(sender)))
        let cancel_sender_slot = Arc__clone(&sender_slot)
        let execute_sender_slot = Arc__clone(&sender_slot)
        let execute = Box__new_(
            fn(token: NativeTaskCancellationToken): Box__pin(
                async:
                    if token.is_cancelled():
                        send_task_result(&execute_sender_slot, Result::Err(NATIVE_TASK_CANCELLED_ERROR.to_string()))
                        ()
                        return NativeTaskRunStatus::Cancelled
                    let token_for_work = token.clone()
                    let joined = await tokio__task__spawn_blocking(|| work(token_for_work))
                    let mut result = joined.unwrap_or_else(|join_error| Result::Err(format!("Native blocking task failed to join: {join_error}")))
                    if token.is_cancelled() and result.is_ok():
                        result = Result::Err(NATIVE_TASK_CANCELLED_ERROR.to_string())
                        ()
                        ()
                        ()
                        ()
                    let status = NativeTaskRunStatus__from_result(&result)
                    send_task_result(&execute_sender_slot, result)
                    ()
                    status
            ) as NativeTaskFuture
        ) as NativeTaskExecutor
        let cancel_queued = Box__new_(
            fn(reason: String):
                send_task_result(&cancel_sender_slot, Result::Err(reason))
                ()
        ) as NativeTaskQueuedCancel
        (*_self).enqueue(request, execute, cancel_queued, receiver)

    fn submit_async(_self: &NativeTaskGraphManager, request: NativeTaskRequest, work: F) -> Result<NativeTaskSubmission<T>, String>:
        let (sender, receiver) = tokio__sync__oneshot__channel()
        let sender_slot = Arc__new_(Mutex__new_(Option::Some(sender)))
        let cancel_sender_slot = Arc__clone(&sender_slot)
        let execute_sender_slot = Arc__clone(&sender_slot)
        let execute = Box__new_(
            fn(token: NativeTaskCancellationToken): Box__pin(
                async:
                    if token.is_cancelled():
                        send_task_result(&execute_sender_slot, Result::Err(NATIVE_TASK_CANCELLED_ERROR.to_string()))
                        ()
                        return NativeTaskRunStatus::Cancelled
                    let mut result = await work(token.clone())
                    if token.is_cancelled() and result.is_ok():
                        result = Result::Err(NATIVE_TASK_CANCELLED_ERROR.to_string())
                        ()
                        ()
                        ()
                        ()
                    let status = NativeTaskRunStatus__from_result(&result)
                    send_task_result(&execute_sender_slot, result)
                    ()
                    status
            ) as NativeTaskFuture
        ) as NativeTaskExecutor
        let cancel_queued = Box__new_(
            fn(reason: String):
                send_task_result(&cancel_sender_slot, Result::Err(reason))
                ()
        ) as NativeTaskQueuedCancel
        (*_self).enqueue(request, execute, cancel_queued, receiver)

    fn enqueue(_self: &NativeTaskGraphManager, request: NativeTaskRequest, execute: NativeTaskExecutor, cancel_queued: NativeTaskQueuedCancel, receiver: tokio::sync::oneshot::Receiver<Result<T, String>>) -> Result<NativeTaskSubmission<T>, String>:
        let task_id = request.task_id.clone().unwrap_or_else(|| Uuid__new_v4().to_string())
        let token = NativeTaskCancellationToken__new_()
        let queued_task = NativeQueuedTask { id: task_id.clone(), lane: request.lane, priority: request.priority, sequence: 0, work_key: request.work_key.clone(), generation: request.generation, parent_task_id: request.parent_task_id.clone(), label: request.label.clone(), user_visible: request.user_visible, token: token.clone(), queued_at: Instant__now(), execute: execute, cancel_queued: cancel_queued }
        let mut stale_queued_tasks = Vec__new_()
        let mut overflow_queued_tasks = Vec__new_()
        let mut state = (*_self).inner.state.lock().unwrap()
        if (*_self).inner.policy.stale_cancellation_enabled and request.cancel_stale:
            stale_queued_tasks.extend(state.cancel_stale_tasks_for_request(&request))
            ()
            ()
            ()
            ()
        overflow_queued_tasks.extend(state.remove_cancelled_queued_tasks())
        ()
        if (*_self).inner.policy.enabled and state.queue.len() >= (*_self).inner.policy.max_queued_tasks:
            state.telemetry.rejected_tasks = state.telemetry.rejected_tasks + 1
            ()
            return Result::Err(format!("Native task graph queue is full ({} queued, max {}). Try again after current Explorer work settles.", state.queue.len(), (*_self).inner.policy.max_queued_tasks))
        let sequence = state.next_sequence
        state.next_sequence = state.next_sequence + 1
        ()
        let mut queued_task = queued_task
        queued_task.sequence = sequence
        ()
        let ancestor_task_ids = state.ancestors_for(&queued_task.parent_task_id)
        state.records.insert(task_id.clone(), NativeTaskRecord { lane: queued_task.lane, priority: queued_task.priority, work_key: queued_task.work_key.clone(), generation: queued_task.generation, parent_task_id: queued_task.parent_task_id.clone(), ancestor_task_ids: ancestor_task_ids, label: queued_task.label.clone(), user_visible: queued_task.user_visible, token: token, status: NativeTaskStatus::Queued, queued_at: queued_task.queued_at, started_at: none, finished_at: none })
        ()
        state.telemetry.queued_tasks = state.telemetry.queued_tasks + 1
        ()
        state.lane_mut(queued_task.lane).queued = state.lane_mut(queued_task.lane).queued + 1
        ()
        if (*_self).inner.policy.enabled:
            state.queue.push(queued_task)
            ()
            state.refresh_queue_depth()
            ()
            ()
            ()
            ()
        else:
            state.mark_task_running(&queued_task.id)
            ()
            let inner = Arc__clone(&(*_self).inner)
            spawn_native_task(inner, queued_task)
            ()
            ()
            ()
            ()
        ()
        for task in stale_queued_tasks.into_iter().chain(overflow_queued_tasks):
            task.complete_queued_cancelled(NATIVE_TASK_CANCELLED_ERROR.to_string())
            ()
        ()
        (*_self).dispatch_ready()
        ()
        Result::Ok(NativeTaskSubmission { task_id: task_id, receiver: receiver })

    fn dispatch_ready(_self: &NativeTaskGraphManager):
        loop:
            let next_task = block:
                let mut state = (*_self).inner.state.lock().unwrap()
                let Some(next_index) = state.select_next_ready_index(&(*_self).inner.policy)
                let task = state.queue.remove(next_index)
                state.mark_task_running(&task.id)
                ()
                state.refresh_queue_depth()
                ()
                task
            let inner = Arc__clone(&(*_self).inner)
            spawn_native_task(inner, next_task)
            ()


impl Default for NativeTaskGraphManager:
    fn default_() -> NativeTaskGraphManager:
        NativeTaskGraphManager__new_(NativeTaskGraphPolicy__default_())


struct NativeTaskGraphInner:
    policy: NativeTaskGraphPolicy
    state: NativeTaskGraphState

struct NativeTaskGraphState:
    queue: Array<NativeQueuedTask>
    records: Map<NativeTaskId, NativeTaskRecord>
    active_by_lane: Map<NativeTaskLane, usize>
    next_sequence: u64
    telemetry: NativeTaskGraphTelemetryAccumulator

impl NativeTaskGraphState:
    fn new_() -> NativeTaskGraphState:
        let mut active_by_lane = HashMap__new_()
        for lane in NativeTaskLane__all():
            active_by_lane.insert(*lane, 0)
            ()
        ()
        NativeTaskGraphState { queue: Vec__new_(), records: HashMap__new_(), active_by_lane: active_by_lane, next_sequence: 0, telemetry: NativeTaskGraphTelemetryAccumulator__default_() }

    fn ancestors_for(_self: &NativeTaskGraphState, parent_task_id: &Option<NativeTaskId>) -> Array<NativeTaskId>:
        let Some(parent_task_id) = parent_task_id
        let mut ancestors = vec!(parent_task_id.clone())
        match (*_self).records.get(parent_task_id):
            Some(parent) =>
                ancestors.extend(parent.ancestor_task_ids.iter().cloned())
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ancestors

    fn cancel_stale_tasks_for_request(_self: &mut NativeTaskGraphState, request: &NativeTaskRequest) -> Array<NativeQueuedTask>:
        let Some(work_key) = (*request).work_key
        let Some(new_generation) = (*request).generation
        let stale_task_ids = (*_self).records.iter().filter_map(
            |__kain_closure_arg2| if __kain_closure_arg2.__kain_tuple_1.work_key == Option::Some(work_key) and __kain_closure_arg2.__kain_tuple_1.generation.unwrap_or(0) < new_generation and matches!(__kain_closure_arg2.__kain_tuple_1.status, NativeTaskStatus::Queued | NativeTaskStatus::Running):
                Option::Some(__kain_closure_arg2.__kain_tuple_0.clone())
            else:
                none
        ).collect()
        for task_id in stale_task_ids:
            match (*_self).records.get(&task_id):
                Some(record) =>
                    record.token.cancel()
                    ()
                    (*_self).telemetry.stale_cancelled_tasks = (*_self).telemetry.stale_cancelled_tasks + 1
                    ()
                _ => ()
        ()
        (*_self).remove_cancelled_queued_tasks()

    fn remove_cancelled_queued_tasks(_self: &mut NativeTaskGraphState) -> Array<NativeQueuedTask>:
        let mut cancelled = Vec__new_()
        let mut retained = |__kain_ctor_arg0| Vec::new()((*_self).queue.len())
        let mut cancelled_queued_records = Vec__new_()
        for task in (*_self).queue.drain(..):
            if task.token.is_cancelled():
                cancelled_queued_records.push((task.id.clone(), task.lane))
                ()
                cancelled.push(task)
                ()
            else:
                retained.push(task)
                ()
        ()
        (*_self).queue = retained
        ()
        for (task_id, lane) in cancelled_queued_records:
            (*_self).finish_queued_cancelled_by_id(&task_id, lane)
            ()
        ()
        (*_self).refresh_queue_depth()
        ()
        cancelled

    fn finish_queued_cancelled_by_id(_self: &mut NativeTaskGraphState, task_id: String, lane: NativeTaskLane):
        let mut marked = false
        match (*_self).records.get_mut(task_id):
            Some(record) =>
                if matches!(record.status, NativeTaskStatus::Queued):
                    record.status = NativeTaskStatus::Cancelled
                    ()
                    record.finished_at = Option::Some(Instant__now())
                    ()
                    marked = true
                    ()
                    ()
                    ()
                    ()
                ()
            _ =>
                ()
                ()
        if marked:
            (*_self).telemetry.cancelled_tasks = (*_self).telemetry.cancelled_tasks + 1
            ()
            (*_self).lane_mut(lane).cancelled = (*_self).lane_mut(lane).cancelled + 1
            ()

    fn mark_task_running(_self: &mut NativeTaskGraphState, task_id: String):
        let Some(record) = (*_self).records.get_mut(task_id)
        if !matches!(record.status, NativeTaskStatus::Queued):
            return
        record.status = NativeTaskStatus::Running
        ()
        record.started_at = Option::Some(Instant__now())
        ()
        *(*_self).active_by_lane.entry(record.lane).or_insert(0) = *(*_self).active_by_lane.entry(record.lane).or_insert(0) + 1
        ()

    fn finish_running_task(_self: &mut NativeTaskGraphState, task_id: String, lane: NativeTaskLane, status: NativeTaskRunStatus, wait: std::time::Duration, run: std::time::Duration):
        match (*_self).active_by_lane.get_mut(&lane):
            Some(active) =>
                *active = active.saturating_sub(1)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match (*_self).records.get_mut(task_id):
            Some(record) =>
                record.status = match status:
                    NativeTaskRunStatus::Succeeded => NativeTaskStatus::Completed
                    NativeTaskRunStatus::Failed => NativeTaskStatus::Failed
                    NativeTaskRunStatus::Cancelled => NativeTaskStatus::Cancelled
                ()
                record.finished_at = Option::Some(Instant__now())
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).telemetry.record_finished(lane, status, wait, run)
        ()

    fn select_next_ready_index(_self: &NativeTaskGraphState, policy: &NativeTaskGraphPolicy) -> Option<usize>:
        (*_self).queue.iter().enumerate().filter(|__kain_closure_arg3| (*policy).lane_concurrency.cap_for(__kain_closure_arg3.__kain_tuple_1.lane) > 0 and (*_self).active_by_lane.get(&__kain_closure_arg3.__kain_tuple_1.lane).copied().unwrap_or_default() < (*policy).lane_concurrency.cap_for(__kain_closure_arg3.__kain_tuple_1.lane)).min_by(
            |__kain_closure_arg4, __kain_closure_arg5| match __kain_closure_arg4.__kain_tuple_1.priority.rank().cmp(&__kain_closure_arg5.__kain_tuple_1.priority.rank()):
                std::cmp::Ordering::Equal => __kain_closure_arg4.__kain_tuple_1.sequence.cmp(&__kain_closure_arg5.__kain_tuple_1.sequence)
                ordering => ordering
        ).map(|__kain_closure_arg6| __kain_closure_arg6.__kain_tuple_0)

    fn refresh_queue_depth(_self: &mut NativeTaskGraphState):
        (*_self).telemetry.queue_depth = (*_self).queue.len()
        ()
        (*_self).telemetry.max_queue_depth = (*_self).telemetry.max_queue_depth.max((*_self).queue.len())
        ()

    fn lane_mut(_self: &mut NativeTaskGraphState, lane: NativeTaskLane) -> &mut NativeTaskLaneTelemetryAccumulator:
        (*_self).telemetry.lane_counts.entry(lane).or_insert_with(NativeTaskLaneTelemetryAccumulator__default_)


struct NativeQueuedTask:
    id: NativeTaskId
    lane: NativeTaskLane
    priority: NativeTaskPriority
    sequence: u64
    work_key: Option<NativeTaskWorkKey>
    generation: Option<NativeTaskGeneration>
    parent_task_id: Option<NativeTaskId>
    label: String
    user_visible: Bool
    token: NativeTaskCancellationToken
    queued_at: std::time::Instant
    execute: NativeTaskExecutor
    cancel_queued: NativeTaskQueuedCancel

impl NativeQueuedTask:
    fn complete_queued_cancelled(_self: NativeQueuedTask, reason: String):
        _self.cancel_queued(reason)
        ()


struct NativeTaskRecord:
    lane: NativeTaskLane
    priority: NativeTaskPriority
    work_key: Option<NativeTaskWorkKey>
    generation: Option<NativeTaskGeneration>
    parent_task_id: Option<NativeTaskId>
    ancestor_task_ids: Array<NativeTaskId>
    label: String
    user_visible: Bool
    token: NativeTaskCancellationToken
    status: NativeTaskStatus
    queued_at: std::time::Instant
    started_at: Option<std::time::Instant>
    finished_at: Option<std::time::Instant>

enum NativeTaskStatus:
    Queued
    Running
    Completed
    Failed
    Cancelled

enum NativeTaskRunStatus:
    Succeeded
    Failed
    Cancelled

impl NativeTaskRunStatus:
    fn from_result(result: &Result<T, String>) -> NativeTaskRunStatus:
        match result:
            Ok(_) => NativeTaskRunStatus::Succeeded
            Err(error) if is_native_task_cancelled_error(error) => NativeTaskRunStatus::Cancelled
            Err(_) => NativeTaskRunStatus::Failed


struct NativeTaskGraphTelemetryAccumulator:
    queued_tasks: u64
    queue_depth: usize
    max_queue_depth: usize
    completed_tasks: u64
    failed_tasks: u64
    cancelled_tasks: u64
    rejected_tasks: u64
    stale_cancelled_tasks: u64
    total_wait_ms: u128
    total_run_ms: u128
    wait_samples: u64
    run_samples: u64
    lane_counts: Map<NativeTaskLane, NativeTaskLaneTelemetryAccumulator>

impl Default for NativeTaskGraphTelemetryAccumulator:
    fn default_() -> NativeTaskGraphTelemetryAccumulator:
        NativeTaskGraphTelemetryAccumulator { queued_tasks: 0, queue_depth: 0, max_queue_depth: 0, completed_tasks: 0, failed_tasks: 0, cancelled_tasks: 0, rejected_tasks: 0, stale_cancelled_tasks: 0, total_wait_ms: 0, total_run_ms: 0, wait_samples: 0, run_samples: 0, lane_counts: HashMap__new_() }


impl NativeTaskGraphTelemetryAccumulator:
    fn record_finished(_self: &mut NativeTaskGraphTelemetryAccumulator, lane: NativeTaskLane, status: NativeTaskRunStatus, wait: std::time::Duration, run: std::time::Duration):
        (*_self).total_wait_ms = (*_self).total_wait_ms + wait.as_millis()
        ()
        (*_self).total_run_ms = (*_self).total_run_ms + run.as_millis()
        ()
        (*_self).wait_samples = (*_self).wait_samples + 1
        ()
        (*_self).run_samples = (*_self).run_samples + 1
        ()
        let lane_counts = (*_self).lane_counts.entry(lane).or_insert_with(NativeTaskLaneTelemetryAccumulator__default_)
        match status:
            NativeTaskRunStatus::Succeeded =>
                (*_self).completed_tasks = (*_self).completed_tasks + 1
                ()
                lane_counts.completed = lane_counts.completed + 1
                ()
            NativeTaskRunStatus::Failed =>
                (*_self).failed_tasks = (*_self).failed_tasks + 1
                ()
                lane_counts.failed = lane_counts.failed + 1
                ()
            NativeTaskRunStatus::Cancelled =>
                (*_self).cancelled_tasks = (*_self).cancelled_tasks + 1
                ()
                lane_counts.cancelled = lane_counts.cancelled + 1
                ()

    fn snapshot(_self: &NativeTaskGraphTelemetryAccumulator, active_by_lane: &Map<NativeTaskLane, usize>) -> NativeTaskGraphTelemetry:
        let mut lane_counts = HashMap__new_()
        for lane in NativeTaskLane__all():
            let mut lane_snapshot = (*_self).lane_counts.get(lane).map(|counts| NativeTaskLaneTelemetry { queued: counts.queued, active: 0, completed: counts.completed, failed: counts.failed, cancelled: counts.cancelled }).unwrap_or_default()
            lane_snapshot.active = active_by_lane.get(lane).copied().unwrap_or_default() as u64
            ()
            lane_counts.insert(lane.as_str().to_string(), lane_snapshot)
            ()
        ()
        NativeTaskGraphTelemetry { queued_tasks: (*_self).queued_tasks, queue_depth: (*_self).queue_depth, max_queue_depth: (*_self).max_queue_depth, active_tasks: active_by_lane.values().copied().sum(), completed_tasks: (*_self).completed_tasks, failed_tasks: (*_self).failed_tasks, cancelled_tasks: (*_self).cancelled_tasks, rejected_tasks: (*_self).rejected_tasks, stale_cancelled_tasks: (*_self).stale_cancelled_tasks, average_wait_ms: average_ms((*_self).total_wait_ms, (*_self).wait_samples), average_run_ms: average_ms((*_self).total_run_ms, (*_self).run_samples), lane_counts: lane_counts }


struct NativeTaskLaneTelemetryAccumulator:
    queued: u64
    completed: u64
    failed: u64
    cancelled: u64

impl Default for NativeTaskLaneTelemetryAccumulator:
    fn default_() -> NativeTaskLaneTelemetryAccumulator:
        NativeTaskLaneTelemetryAccumulator { queued: 0, completed: 0, failed: 0, cancelled: 0 }


fn spawn_native_task(inner: NativeTaskGraphInner, task: NativeQueuedTask):
    tokio__spawn_(
        async:
            let queued_at = task.queued_at
            let task_id = task.id.clone()
            let lane = task.lane
            let run_started = Instant__now()
            let wait = run_started.saturating_duration_since(queued_at)
            let status = await task.execute(task.token.clone())
            let run = run_started.elapsed()
            let mut state = inner.state.lock().unwrap()
            state.finish_running_task(&task_id, lane, status, wait, run)
            ()
            ()
            ()
            ()
            NativeTaskGraphManager { inner: inner }.dispatch_ready()
            ()
    )
    ()

fn send_task_result(sender_slot: &Option<tokio::sync::oneshot::Sender<Result<T, String>>>, result: Result<T, String>):
    match sender_slot.lock().unwrap().take():
        Some(sender) =>
            let _ = sender.send_(result)
        _ => ()

fn average_ms(total_ms: u128, samples: u64) -> f64:
    if samples == 0:
        0.0
    else:
        total_ms as f64 / samples as f64

fn is_native_task_cancelled_error(error: String) -> Bool:
    error == NATIVE_TASK_CANCELLED_ERROR or error.to_ascii_lowercase().contains("cancelled")

fn clamp_usize(value: Option<usize>, default_value: usize, min: usize, max: usize) -> usize:
    value.unwrap_or(default_value).clamp(min, max)

fn clamp_u64(value: Option<u64>, default_value: u64, min: u64, max: u64) -> u64:
    value.unwrap_or(default_value).clamp(min, max)

struct ExplorerPerformanceManifest:
    native_task_graph: Option<ShippedNativeTaskGraphPolicy>

struct ShippedNativeTaskGraphPolicy:
    enabled: Option<Bool>
    max_queued_tasks: Option<usize>
    stale_cancellation_enabled: Option<Bool>
    telemetry_enabled: Option<Bool>
    progress_emit_interval_ms: Option<u64>
    overflow_policy: Option<NativeTaskQueueOverflowPolicy>
    lane_concurrency: Option<ShippedNativeTaskLaneConcurrency>

impl Default for ShippedNativeTaskGraphPolicy:
    fn default_() -> ShippedNativeTaskGraphPolicy:
        ShippedNativeTaskGraphPolicy { enabled: none, max_queued_tasks: none, stale_cancellation_enabled: none, telemetry_enabled: none, progress_emit_interval_ms: none, overflow_policy: none, lane_concurrency: none }


struct ShippedNativeTaskLaneConcurrency:
    directory_scan: Option<usize>
    recursive_search: Option<usize>
    checksum: Option<usize>
    thumbnail_decode: Option<usize>
    preview_read: Option<usize>
    archive: Option<usize>
    indexing: Option<usize>
    maintenance: Option<usize>

impl Default for ShippedNativeTaskLaneConcurrency:
    fn default_() -> ShippedNativeTaskLaneConcurrency:
        ShippedNativeTaskLaneConcurrency { directory_scan: none, recursive_search: none, checksum: none, thumbnail_decode: none, preview_read: none, archive: none, indexing: none, maintenance: none }


enum NativeTerminalCursorStyle:
    Bar
    Block
    Underline

struct NativeTerminalOpenRequest:
    working_dir: String
    shell: Option<String>
    font_family: Option<String>
    font_size: Option<u32>
    scrollback: Option<u64>
    cursor_blink: Option<Bool>
    cursor_style: Option<NativeTerminalCursorStyle>
    width: Option<u32>
    height: Option<u32>
    title: Option<String>

fn terminal_open_native(window: tauri::WebviewWindow, request: NativeTerminalOpenRequest) -> Result<(), String>:
    terminal_open_native_linux(&window, request)
    ()
    ()
    let _ = window
    let _ = request
    Result::Err("Native terminal windows are only supported on Linux.".to_string())

mod linux:
    struct VteApi:
        terminal_new: fn() -> GtkWidgetPtr
        terminal_set_scrollback_lines: fn(GtkWidgetPtr, i64) -> ()
        terminal_set_cursor_blink_mode: fn(GtkWidgetPtr, i32) -> ()
        terminal_set_cursor_shape: fn(GtkWidgetPtr, i32) -> ()
        terminal_set_font: SetFontFn
        terminal_spawn_sync: SpawnSyncFn
        terminal_watch_child: WatchChildFn

    fn terminal_open_native_linux(window: &tauri::WebviewWindow, request: NativeTerminalOpenRequest) -> Result<(), String>:
        let request = normalize_request(request)
        run_on_window_main_thread(
            window,
            block:
                let window = window.clone()
                || open_native_terminal_on_main_thread(&window, &request)
        )?

    fn open_native_terminal_on_main_thread(parent_window: &tauri::WebviewWindow, request: &NativeTerminalOpenRequest) -> Result<(), String>:
        let vte = load_vte_api()?
        let working_dir = resolve_native_working_dir(&(*request).working_dir)?
        let shell = resolve_native_shell((*request).shell)?
        let parent_gtk_window = parent_window.gtk_window().map_err(|error| format!("Failed to access GTK host window: {error}"))?
        let native_window = Window__new_(gtk::WindowType::Toplevel)
        native_window.set_title(&resolve_window_title(request))
        ()
        native_window.set_default_size(clamp_window_dimension((*request).width, DEFAULT_NATIVE_TERMINAL_WIDTH, MIN_NATIVE_TERMINAL_WIDTH), clamp_window_dimension((*request).height, DEFAULT_NATIVE_TERMINAL_HEIGHT, MIN_NATIVE_TERMINAL_HEIGHT))
        ()
        native_window.set_transient_for(Option::Some(parent_gtk_window.upcast_ref()))
        ()
        native_window.set_destroy_with_parent(false)
        ()
        let terminal_ptr = vte.terminal_new()
        if terminal_ptr.is_null():
            return Result::Err("VTE returned a null terminal widget.".to_string())
        let terminal_widget: gtk::Widget = gtk__glib__translate__from_glib_none(terminal_ptr)
        let scrolled_window = ScrolledWindow__new_(none, none)
        scrolled_window.set_hexpand(true)
        ()
        scrolled_window.set_vexpand(true)
        ()
        scrolled_window.add(&terminal_widget)
        ()
        let container = Box__new_(gtk::Orientation::Vertical, 0)
        container.set_hexpand(true)
        ()
        container.set_vexpand(true)
        ()
        container.pack_start(&scrolled_window, true, true, 0)
        ()
        native_window.add(&container)
        ()
        match (*request).scrollback:
            Some(scrollback) =>
                let scrollback = scrollback.min(i64__MAX as u64) as i64
                vte.terminal_set_scrollback_lines(terminal_ptr, scrollback)
                ()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match resolve_cursor_blink_mode((*request).cursor_blink):
            Some(cursor_blink_mode) =>
                vte.terminal_set_cursor_blink_mode(terminal_ptr, cursor_blink_mode)
                ()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match (*request).cursor_style:
            Some(cursor_style) =>
                let cursor_shape = resolve_cursor_shape(cursor_style)?
                vte.terminal_set_cursor_shape(terminal_ptr, cursor_shape)
                ()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match build_native_font_description(request):
            Some(font_description) =>
                vte.terminal_set_font(terminal_ptr, font_description.to_glib_none().field_0)
                ()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        spawn_terminal_process(vte, terminal_ptr, &working_dir, &shell)?
        ()
        native_window.set_icon_name(Option::Some("utilities-terminal"))
        ()
        let native_window_for_exit = native_window.clone()
        terminal_widget.connect_closure(
            "child-exited",
            false,
            glib::closure_local!(fn(_terminal: gtk::Widget, _status: i32):
                native_window_for_exit.close()
                ())
        )
        ()
        native_window.show_all()
        ()
        native_window.present()
        ()
        terminal_widget.grab_focus()
        ()
        Result::Ok(())

    fn build_native_font_description(request: &NativeTerminalOpenRequest) -> Option<gtk::pango::FontDescription>:
        let family = (*request).font_family.and_then(resolve_native_font_family).or_else(|| Option::Some("monospace".to_string()))?
        let mut font_description = FontDescription__new_()
        font_description.set_family(&family)
        ()
        match (*request).font_size:
            Some(font_size) =>
                font_description.set_size(font_size.max(1) as i32 * gtk__pango__SCALE)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        Option::Some(font_description)

    fn spawn_terminal_process(vte: &VteApi, terminal_ptr: GtkWidgetPtr, working_dir: &std::path::Path, shell: String) -> Result<(), String>:
        let working_dir = path_to_cstring(working_dir)?
        let shell_display = shell.to_string()
        let shell = CString__new_(shell).map_err(|error| format!("Native shell path contains an interior null byte: {error}"))?
        let mut argv_strings = vec!(shell)
        let mut argv = argv_strings.iter_mut().map(|value| value.as_ptr() as PtrMut<std::os::raw::c_char>).collect()
        argv.push(std__ptr__null_mut())
        ()
        let mut child_pid = 0 as gtk::glib::ffi::GPid
        let mut spawn_error = std__ptr__null_mut()
        let spawn_result = (*vte).terminal_spawn_sync(terminal_ptr, 0, working_dir.as_ptr(), argv.as_mut_ptr(), std__ptr__null_mut(), 0, none, std__ptr__null_mut(), &mut child_pid, std__ptr__null_mut(), &mut spawn_error)
        if spawn_result == gtk__glib__ffi__GFALSE:
            let error_message = if spawn_error.is_null():
                format!("Failed to spawn native terminal shell: {shell_display}")
            else:
                let error: gtk::glib::Error = gtk__glib__translate__from_glib_full(spawn_error)
                error.to_string()
            return Result::Err(error_message)
        (*vte).terminal_watch_child(terminal_ptr, child_pid)
        ()
        ()
        ()
        ()
        Result::Ok(())

    fn resolve_window_title(request: &NativeTerminalOpenRequest) -> String:
        (*request).title.map(str__trim).filter(|value| !value.is_empty()).unwrap_or(DEFAULT_NATIVE_TERMINAL_TITLE).to_string()

    fn normalize_request(request: NativeTerminalOpenRequest) -> NativeTerminalOpenRequest:
        request.working_dir = request.working_dir.trim().to_string()
        ()
        request.shell = normalize_optional_text(request.shell)
        ()
        request.font_family = normalize_optional_text(request.font_family)
        ()
        request.title = normalize_optional_text(request.title)
        ()
        request

    fn normalize_optional_text(value: Option<String>) -> Option<String>:
        value.map(|entry| entry.trim().to_string()).filter(|entry| !entry.is_empty())

    fn resolve_native_font_family(font_family: String) -> Option<String>:
        font_family.split(",").map(str__trim).find(|entry| !entry.is_empty()).map(ToOwned__to_owned)

    fn resolve_native_working_dir(path: String) -> Result<std::path::PathBuf, String>:
        if path.trim().is_empty():
            return std__env__current_dir().or_else(|_| dirs__home_dir().ok_or_else(|| Error__from(io::ErrorKind::NotFound))).map_err(|error| format!("Unable to resolve a working directory for the native terminal: {error}"))
        let requested = PathBuf__from(path)
        if requested.is_dir():
            return Result::Ok(requested)
        if requested.is_file():
            return requested.parent().map(Path__to_path_buf).ok_or_else(|| format!("Working directory does not have a parent directory: {path}"))
        Result::Err(format!("Working directory does not exist: {path}"))

    fn resolve_native_shell(shell: Option<String>) -> Result<String, String>:
        let requested_shell = shell.map(str__trim).filter(|value| !value.is_empty()).map(ToOwned__to_owned)
        let env_shell = std__env__var_("SHELL").ok().map(|value| value.trim().to_string()).filter(|value| !value.is_empty())
        for candidate in requested_shell.into_iter().chain(env_shell.into_iter()).chain(["/bin/bash".to_string(), "/bin/sh".to_string()]):
            if is_shell_candidate_usable(&candidate):
                return Result::Ok(candidate)
        ()
        Result::Err("Unable to resolve a Linux shell for the native terminal window.".to_string())

    fn is_shell_candidate_usable(candidate: String) -> Bool:
        if candidate.contains(std__path__MAIN_SEPARATOR):
            Path__new_(candidate).exists()
        else:
            !candidate.trim().is_empty()

    fn resolve_cursor_blink_mode(cursor_blink: Option<Bool>) -> Option<i32>:
        let blink_mode_nick = if cursor_blink.unwrap_or(true):
            "on"
        else:
            "off"
        resolve_gobject_enum_value("VteCursorBlinkMode", blink_mode_nick).ok()

    fn resolve_cursor_shape(cursor_style: &NativeTerminalCursorStyle) -> Result<i32, String>:
        let shape_nick = match cursor_style:
            NativeTerminalCursorStyle::Bar => "ibeam"
            NativeTerminalCursorStyle::Block => "block"
            NativeTerminalCursorStyle::Underline => "underline"
        resolve_gobject_enum_value("VteCursorShape", shape_nick)

    fn resolve_gobject_enum_value(type_name: String, value_nick: String) -> Result<i32, String>:
        let type_name = CString__new_(type_name).map_err(|error| format!("Invalid GObject enum type name: {error}"))?
        let value_nick = CString__new_(value_nick).map_err(|error| format!("Invalid GObject enum value nick: {error}"))?
        let enum_type = gtk__glib__gobject_ffi__g_type_from_name(type_name.as_ptr())
        if enum_type == 0:
            return Result::Err(format!("GObject enum type is unavailable: {}", type_name.to_string_lossy()))
        let enum_class_ptr = gtk__glib__gobject_ffi__g_type_class_ref(enum_type)
        if enum_class_ptr.is_null():
            return Result::Err(format!("Failed to access GObject enum class for {}.", type_name.to_string_lossy()))
        let value = block:
            let enum_class = enum_class_ptr as PtrMut<gtk::glib::gobject_ffi::GEnumClass>
            let enum_value = gtk__glib__gobject_ffi__g_enum_get_value_by_nick(enum_class, value_nick.as_ptr())
            let resolved_value = if enum_value.is_null():
                none
            else:
                Option::Some((*enum_value).value)
            gtk__glib__gobject_ffi__g_type_class_unref(enum_class_ptr)
            ()
            resolved_value
        value.ok_or_else(|| format!("GObject enum value {value_nick:?} is unavailable on {}.", type_name.to_string_lossy()))

    fn clamp_window_dimension(value: Option<u32>, fallback: u32, min: u32) -> i32:
        value.unwrap_or(fallback).max(min).min(i32__MAX as u32) as i32

    fn path_to_cstring(path: &std::path::Path) -> Result<std::ffi::CString, String>:
        CString__new_(path.as_os_str().as_bytes().to_vec()).map_err(|error| format!("Path contains an interior null byte: {error}"))

    fn load_vte_api() -> Result<&VteApi, String>:
        VTE_API.get_or_try_init(
            || block:
                let library = load_vte_library()?
                Result::Ok(VteApi { terminal_new: load_symbol(library, [118, 116, 101, 95, 116, 101, 114, 109, 105, 110, 97, 108, 95, 110, 101, 119, 0])?, terminal_set_scrollback_lines: load_symbol(library, [118, 116, 101, 95, 116, 101, 114, 109, 105, 110, 97, 108, 95, 115, 101, 116, 95, 115, 99, 114, 111, 108, 108, 98, 97, 99, 107, 95, 108, 105, 110, 101, 115, 0])?, terminal_set_cursor_blink_mode: load_symbol(library, [118, 116, 101, 95, 116, 101, 114, 109, 105, 110, 97, 108, 95, 115, 101, 116, 95, 99, 117, 114, 115, 111, 114, 95, 98, 108, 105, 110, 107, 95, 109, 111, 100, 101, 0])?, terminal_set_cursor_shape: load_symbol(library, [118, 116, 101, 95, 116, 101, 114, 109, 105, 110, 97, 108, 95, 115, 101, 116, 95, 99, 117, 114, 115, 111, 114, 95, 115, 104, 97, 112, 101, 0])?, terminal_set_font: load_symbol(library, [118, 116, 101, 95, 116, 101, 114, 109, 105, 110, 97, 108, 95, 115, 101, 116, 95, 102, 111, 110, 116, 0])?, terminal_spawn_sync: load_symbol(library, [118, 116, 101, 95, 116, 101, 114, 109, 105, 110, 97, 108, 95, 115, 112, 97, 119, 110, 95, 115, 121, 110, 99, 0])?, terminal_watch_child: load_symbol(library, [118, 116, 101, 95, 116, 101, 114, 109, 105, 110, 97, 108, 95, 119, 97, 116, 99, 104, 95, 99, 104, 105, 108, 100, 0])? })
        )

    fn load_vte_library() -> Result<&libloading::Library, String>:
        for candidate in VTE_LIBRARY_CANDIDATES:
            let library = Library__new_(*candidate)
            match library:
                Ok(library) =>
                    return Result::Ok(Box__leak(Box__new_(library)))
                _ => ()
        ()
        Result::Err("Unable to load libvte-2.91 at runtime. Install the VTE GTK3 runtime package to use native terminal windows.".to_string())

    fn load_symbol(library: &libloading::Library, symbol_name: &Slice<u8>) -> Result<T, String>:
        let symbol = library.get(symbol_name).map_err(|error| format!("Failed to load {:?} from libvte: {error}", symbol_name))?
        Result::Ok(*symbol)

    fn run_on_window_main_thread(window: &tauri::WebviewWindow, task: F) -> Result<T, String>:
        let (sender, receiver) = std__sync__mpsc__sync_channel(1)
        window.run_on_main_thread(|| let _ = sender.send_(task())).map_err(|error| error.to_string())?
        ()
        receiver.recv().map_err(|error| format!("Failed to receive GTK main-thread result: {error}"))


struct GioMimeInfo:
    default_app: Option<String>
    recommended_apps: Array<String>
    registered_apps: Array<String>

struct MimeappsEntries:
    default_app: Option<String>
    recommended_apps: Array<String>
    other_apps: Array<String>

struct DesktopEntry:
    name: Option<String>
    exec: Option<String>
    icon: Option<String>

fn get_gio_mime_info(mime_type: String) -> Option<GioMimeInfo>:
    let mut command = Command__new_("gio")
    command.args(["mime", mime_type]).env("LC_ALL", "C").env("LANG", "C")
    ()
    let output = open_with__utils__run_command_with_timeout(command, OPEN_WITH_LINUX_COMMAND_TIMEOUT, "gio mime").map_err(|command_error| log::warn!("Open With Linux: gio mime failed for {}: {}", mime_type, command_error)).ok()?
    if !output.status.success():
        log::warn!("Open With Linux: gio mime exited non-zero for {}", mime_type)
        return none
    let content = String__from_utf8_lossy(&output.stdout).to_string()
    let parsed = parse_gio_mime_output(&content)
    log::info!("Open With Linux: gio parsed default={} recommended={} registered={}", parsed.default_app.is_some(), parsed.recommended_apps.len(), parsed.registered_apps.len())
    Option::Some(parsed)

fn parse_gio_mime_output(content: String) -> GioMimeInfo:
    let mut info = GioMimeInfo { default_app: none, recommended_apps: Vec__new_(), registered_apps: Vec__new_() }
    enum GioSection:
        None
        Recommended
        Registered

    let mut current_section = GioSection::None
    for line_ in content.lines():
        let trimmed = line_.trim()
        if trimmed.is_empty():
            continue
        if trimmed.starts_with("Default application for"):
            match trimmed.split_once(":"):
                Some((_, value)) =>
                    let default_value = value.trim()
                    if !default_value.is_empty() and default_value.to_lowercase() != "none" and default_value.to_lowercase() != "no":
                        info.default_app = Option::Some(default_value.to_string())
                        ()
                        ()
                        ()
                        ()
                    ()
                _ =>
                    ()
                    ()
            continue
        if trimmed.starts_with("Recommended applications:"):
            current_section = GioSection::Recommended
            ()
            let inline_ = trimmed.trim_start_matches("Recommended applications:").trim()
            if !inline_.is_empty():
                for entry in parse_desktop_list(inline_):
                    info.recommended_apps.push(entry)
                    ()
                ()
                ()
            continue
        if trimmed.starts_with("Registered applications:") or trimmed.starts_with("Other applications:"):
            current_section = GioSection::Registered
            ()
            let inline_ = trimmed.trim_start_matches("Registered applications:").trim_start_matches("Other applications:").trim()
            if !inline_.is_empty():
                for entry in parse_desktop_list(inline_):
                    info.registered_apps.push(entry)
                    ()
                ()
                ()
            continue
        let entry = trimmed.trim_end_matches(";").trim()
        if entry.is_empty():
            continue
        match current_section:
            GioSection::Recommended => info.recommended_apps.push(entry.to_string())
            GioSection::Registered => info.registered_apps.push(entry.to_string())
            GioSection::None =>
                ()
    ()
    info

fn get_mimeapps_entries(mime_type: String) -> MimeappsEntries:
    let mut entries = MimeappsEntries { default_app: none, recommended_apps: Vec__new_(), other_apps: Vec__new_() }
    let config_home = std__env__var_("XDG_CONFIG_HOME").ok().map(PathBuf__from).or_else(|| std__env__var_("HOME").ok().map(|home| PathBuf__from(home).join(".config")))
    match config_home:
        Some(base) =>
            read_mimeapps_file(&base.join("mimeapps.list"), mime_type, &mut entries)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let data_home = std__env__var_("XDG_DATA_HOME").ok().map(PathBuf__from).or_else(|| std__env__var_("HOME").ok().map(|home| PathBuf__from(home).join(".local/share")))
    match data_home:
        Some(base) =>
            read_mimeapps_file(&base.join("applications").join("mimeapps.list"), mime_type, &mut entries)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let config_dirs = std__env__var_("XDG_CONFIG_DIRS").unwrap_or_else(|_| "/etc/xdg".to_string())
    for base in config_dirs.split(":").map(PathBuf__from):
        read_mimeapps_file(&base.join("mimeapps.list"), mime_type, &mut entries)
        ()
    ()
    let data_dirs = std__env__var_("XDG_DATA_DIRS").unwrap_or_else(|_| "/usr/local/share:/usr/share".to_string())
    for base in data_dirs.split(":").map(PathBuf__from):
        read_mimeapps_file(&base.join("applications").join("mimeapps.list"), mime_type, &mut entries)
        ()
    ()
    merge_desktop_ids(&mut entries.other_apps, &get_mimeinfo_cache_apps(mime_type))
    ()
    log::info!("Open With Linux: mimeapps entries default={} recommended={} other={}", entries.default_app.is_some(), entries.recommended_apps.len(), entries.other_apps.len())
    entries

fn get_xdg_default_app(mime_type: String) -> Option<String>:
    let mut command = Command__new_("xdg-mime")
    command.args(["query", "default", mime_type])
    ()
    let output = open_with__utils__run_command_with_timeout(command, OPEN_WITH_LINUX_COMMAND_TIMEOUT, "xdg-mime query default").map_err(|command_error| log::warn!("Open With Linux: xdg-mime default failed for {}: {}", mime_type, command_error)).ok()?
    if !output.status.success():
        let stderr_value = String__from_utf8_lossy(&output.stderr)
        log::warn!("Open With Linux: xdg-mime default exited non-zero for {}: {}", mime_type, stderr_value.trim())
        return none
    let value = String__from_utf8_lossy(&output.stdout).trim().to_string()
    if value.is_empty():
        none
    else:
        Option::Some(value)

fn get_mimeinfo_cache_apps(mime_type: String) -> Array<String>:
    let mut results: Array<String> = Vec__new_()
    let data_home = std__env__var_("XDG_DATA_HOME").ok().map(PathBuf__from).or_else(|| std__env__var_("HOME").ok().map(|home| PathBuf__from(home).join(".local/share")))
    match data_home:
        Some(base) =>
            let cache_path = base.join("applications").join("mimeinfo.cache")
            merge_desktop_ids(&mut results, &read_mimeinfo_cache(&cache_path, mime_type))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let data_dirs = std__env__var_("XDG_DATA_DIRS").unwrap_or_else(|_| "/usr/local/share:/usr/share".to_string())
    for base in data_dirs.split(":").map(PathBuf__from):
        let cache_path = base.join("applications").join("mimeinfo.cache")
        merge_desktop_ids(&mut results, &read_mimeinfo_cache(&cache_path, mime_type))
        ()
    ()
    results

fn read_mimeinfo_cache(file_path: &std::path::Path, mime_type: String) -> Array<String>:
    if !file_path.exists():
        return Vec__new_()
    let content = match std__fs__read_to_string(file_path):
        Ok(value) => value
        Err(_) => return Vec__new_()
    for line_ in content.lines():
        let trimmed = line_.trim()
        if trimmed.is_empty() or trimmed.starts_with("#"):
            continue
        let (key, value) = match trimmed.split_once("="):
            Some(pair) => pair
            None => continue
        if key.trim() != mime_type:
            continue
        return parse_desktop_list(value)
    ()
    Vec__new_()

fn read_mimeapps_file(file_path: &std::path::Path, mime_type: String, entries: &mut MimeappsEntries):
    if !file_path.exists():
        return
    let content = match std__fs__read_to_string(file_path):
        Ok(value) => value
        Err(_) => return
    let mut section_name: Option<String> = none
    for line_ in content.lines():
        let trimmed = line_.trim()
        if trimmed.is_empty() or trimmed.starts_with("#"):
            continue
        if trimmed.starts_with("[") and trimmed.ends_with("]"):
            section_name = Option::Some(trimmed.trim_matches(|character| character == "[" or character == "]").to_string())
            ()
            continue
        if !trimmed.contains("="):
            continue
        let (key, value) = match trimmed.split_once("="):
            Some(pair) => pair
            None => continue
        if key.trim() != mime_type:
            continue
        let desktop_ids = parse_desktop_list(value)
        match section_name:
            Some("Default Applications") =>
                if (*entries).default_app.is_none():
                    (*entries).default_app = desktop_ids.first().cloned()
                    ()
            Some("Recommended Applications") =>
                merge_desktop_ids(&mut (*entries).recommended_apps, &desktop_ids)
                ()
            Some("Added Associations") =>
                merge_desktop_ids(&mut (*entries).other_apps, &desktop_ids)
                ()
            _ =>
                ()

fn parse_desktop_list(value: String) -> Array<String>:
    value.split(";").filter_map(
        |entry| block:
            let trimmed = entry.trim()
            if trimmed.is_empty():
                none
            else:
                Option::Some(trimmed.to_string())
    ).collect()

fn merge_desktop_ids(target: &mut Array<String>, incoming: &Slice<String>):
    let mut seen_ids: Set<String> = target.iter().map(|item| item.to_lowercase()).collect()
    for desktop_id in incoming:
        if seen_ids.insert(desktop_id.to_lowercase()):
            target.push(desktop_id.to_string())
            ()

fn desktop_id_to_program(desktop_id: String, is_default: Bool) -> Option<AssociatedProgram>:
    let desktop_file_path = find_desktop_file(desktop_id)
    let entry = desktop_file_path.and_then(|path| read_desktop_entry(path))
    let name = entry.and_then(|value| value.name.clone()).unwrap_or_else(|| desktop_id.trim_end_matches(".desktop").to_string())
    let exec_path = entry.and_then(|value| value.exec).and_then(|value| parse_exec_command(value)).and_then(|value| resolve_executable_path(&value))
    let icon = if RESOLVE_ASSOCIATED_PROGRAM_ICONS:
        entry.and_then(|value| value.icon).and_then(|value| resolve_icon_path(value, desktop_file_path)).or_else(|| exec_path.and_then(|value| open_with__utils__get_program_icon(value)))
    else:
        none
    if desktop_file_path.is_none():
        log::warn!("Open With Linux: desktop file not found {}", desktop_id)
        ()
        ()
    Option::Some(AssociatedProgram { name: name, path: desktop_id.to_string(), launch_id: Option::Some(desktop_id.to_string()), launch_kind: Option::Some(AssociatedProgramLaunchKind::DesktopId), executable_path: exec_path, icon: icon, is_default: is_default })

fn read_desktop_entry(file_path: &std::path::Path) -> Option<DesktopEntry>:
    let content = std__fs__read_to_string(file_path).ok()?
    let mut in_desktop_entry = false
    let mut name: Option<String> = none
    let mut exec: Option<String> = none
    let mut icon: Option<String> = none
    for line_ in content.lines():
        let trimmed = line_.trim()
        if trimmed.starts_with("[") and trimmed.ends_with("]"):
            in_desktop_entry = trimmed == "[Desktop Entry]"
            ()
            continue
        if !in_desktop_entry or trimmed.starts_with("#"):
            continue
        match trimmed.split_once("="):
            Some((key, value)) =>
                match key:
                    "Name" => name = Option::Some(value.trim().to_string())
                    "Exec" => exec = Option::Some(value.trim().to_string())
                    "Icon" => icon = Option::Some(value.trim().to_string())
                    _ =>
                        ()
            _ => ()
    ()
    Option::Some(DesktopEntry { name: name, exec: exec, icon: icon })

fn parse_exec_command(value: String) -> Option<String>:
    let mut token = String__new_()
    let mut in_quotes = false
    let mut quote_char = "\0"
    for char_value in value.chars():
        if !in_quotes and char_value.is_whitespace():
            if !token.is_empty():
                break
            continue
        if (char_value == "\"" or char_value == "'") and !in_quotes:
            in_quotes = true
            ()
            quote_char = char_value
            ()
            continue
        if in_quotes and char_value == quote_char:
            in_quotes = false
            ()
            continue
        token.push(char_value)
        ()
    ()
    if token.is_empty():
        none
    else:
        Option::Some(token)

fn resolve_executable_path(command: String) -> Option<String>:
    if command.contains("/"):
        let path = Path__new_(command)
        if path.exists():
            return Option::Some(command.to_string())
        ()
    let path_var = std__env__var_("PATH").ok()?
    for path_entry in path_var.split(":"):
        let candidate = Path__new_(path_entry).join(command)
        if candidate.exists():
            return Option::Some(candidate.to_string_lossy().to_string())
    ()
    none

fn resolve_icon_path(icon_value: String, desktop_file: Option<&std::path::PathBuf>) -> Option<String>:
    let icon_path = Path__new_(icon_value)
    if icon_path.is_absolute() and icon_path.exists():
        return open_with__utils__load_png_as_base64(icon_path)
    let icon_name = icon_value.trim_end_matches(".png")
    match desktop_file:
        Some(desktop_path) =>
            match desktop_path.parent():
                Some(parent) =>
                    let local_icon = parent.join(format!("{}.png", icon_name))
                    if local_icon.exists():
                        match open_with__utils__load_png_as_base64(&local_icon):
                            Some(value) =>
                                return Option::Some(value)
                            _ =>
                                ()
                                ()
                        ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    let search_sizes = ["32x32", "48x48", "24x24", "16x16", "64x64", "128x128"]
    for base in get_icon_dirs():
        for size in &search_sizes:
            let candidate = base.join("icons").join("hicolor").join(size).join("apps").join(format!("{}.png", icon_name))
            if candidate.exists():
                match open_with__utils__load_png_as_base64(&candidate):
                    Some(value) =>
                        return Option::Some(value)
                    _ => ()
        ()
        let pixmap_candidate = base.join("pixmaps").join(format!("{}.png", icon_name))
        if pixmap_candidate.exists():
            match open_with__utils__load_png_as_base64(&pixmap_candidate):
                Some(value) =>
                    return Option::Some(value)
                _ => ()
    ()
    none

fn get_icon_dirs() -> Array<std::path::PathBuf>:
    let mut dirs: Array<std::path::PathBuf> = Vec__new_()
    match std__env__var_("XDG_DATA_HOME"):
        Ok(data_home) =>
            dirs.push(PathBuf__from(data_home))
            ()
            ()
            ()
            ()
        _ =>
            match std__env__var_("HOME"):
                Ok(home) =>
                    dirs.push(PathBuf__from(home).join(".local/share"))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
    match std__env__var_("XDG_DATA_DIRS"):
        Ok(data_dirs) =>
            for entry in data_dirs.split(":"):
                dirs.push(PathBuf__from(entry))
                ()
            ()
            ()
        _ =>
            dirs.push(PathBuf__from("/usr/local/share"))
            ()
            dirs.push(PathBuf__from("/usr/share"))
            ()
            ()
            ()
            ()
    dirs

fn find_desktop_file(desktop_id: String) -> Option<std::path::PathBuf>:
    let mut search_dirs: Array<std::path::PathBuf> = Vec__new_()
    match std__env__var_("XDG_DATA_HOME"):
        Ok(data_home) =>
            search_dirs.push(PathBuf__from(data_home).join("applications"))
            ()
            ()
            ()
            ()
        _ =>
            match std__env__var_("HOME"):
                Ok(home) =>
                    search_dirs.push(PathBuf__from(home).join(".local/share/applications"))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
    match std__env__var_("XDG_DATA_DIRS"):
        Ok(data_dirs) =>
            for entry in data_dirs.split(":"):
                search_dirs.push(PathBuf__from(entry).join("applications"))
                ()
            ()
            ()
        _ =>
            search_dirs.push(PathBuf__from("/usr/local/share/applications"))
            ()
            search_dirs.push(PathBuf__from("/usr/share/applications"))
            ()
            ()
            ()
            ()
    match std__env__var_("HOME"):
        Ok(home) =>
            search_dirs.push(PathBuf__from(home).join(".local/share/flatpak/exports/share/applications"))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    search_dirs.push(PathBuf__from("/var/lib/flatpak/exports/share/applications"))
    ()
    let target_name = if desktop_id.ends_with(".desktop"):
        desktop_id.to_string()
    else:
        format!("{}.desktop", desktop_id)
    for base in search_dirs:
        let candidate = base.join(&target_name)
        if candidate.exists():
            return Option::Some(candidate)
    ()
    none

fn get_mime_type(path: &std::path::Path) -> Result<String, String>:
    if path.is_dir():
        return Result::Ok("inode/directory".to_string())
    let file_path = path.to_string_lossy()
    match get_mime_type_via_xdg_mime(&file_path):
        Some(mime_type) =>
            return Result::Ok(mime_type)
        _ =>
            ()
            ()
    match get_mime_type_via_gio(&file_path):
        Some(mime_type) =>
            return Result::Ok(mime_type)
        _ =>
            ()
            ()
    match get_mime_type_via_file_command(&file_path):
        Some(mime_type) =>
            return Result::Ok(mime_type)
        _ =>
            ()
            ()
    match get_mime_type_from_extension(path):
        Some(mime_type) =>
            log::info!("Open With Linux: using extension-based mime type for {}", file_path)
            return Result::Ok(mime_type)
        _ =>
            ()
            ()
    Result::Err("Could not determine file type. Please install xdg-utils, gio, or file command.".to_string())

fn get_mime_type_via_xdg_mime(file_path: String) -> Option<String>:
    let mut command = Command__new_("xdg-mime")
    command.args(["query", "filetype", file_path])
    ()
    let output = open_with__utils__run_command_with_timeout(command, OPEN_WITH_LINUX_COMMAND_TIMEOUT, "xdg-mime query filetype").ok()?
    if !output.status.success():
        return none
    let mime_type = String__from_utf8_lossy(&output.stdout).trim().to_string()
    if mime_type.is_empty():
        return none
    log::info!("Open With Linux: xdg-mime resolved {}", mime_type)
    Option::Some(mime_type)

fn get_mime_type_via_gio(file_path: String) -> Option<String>:
    let mut command = Command__new_("gio")
    command.args(["info", "--attributes=standard::content-type", file_path])
    ()
    let output = open_with__utils__run_command_with_timeout(command, OPEN_WITH_LINUX_COMMAND_TIMEOUT, "gio info --attributes=standard::content-type").ok()?
    if !output.status.success():
        return none
    let content = String__from_utf8_lossy(&output.stdout)
    for line_ in content.lines():
        let trimmed = line_.trim()
        if trimmed.starts_with("standard::content-type:"):
            let mime_type = trimmed.trim_start_matches("standard::content-type:").trim().to_string()
            if !mime_type.is_empty():
                log::info!("Open With Linux: gio info resolved {}", mime_type)
                return Option::Some(mime_type)
    ()
    none

fn get_mime_type_via_file_command(file_path: String) -> Option<String>:
    let mut command = Command__new_("file")
    command.args(["--mime-type", "-b", file_path])
    ()
    let output = open_with__utils__run_command_with_timeout(command, OPEN_WITH_LINUX_COMMAND_TIMEOUT, "file --mime-type").ok()?
    if !output.status.success():
        return none
    let mime_type = String__from_utf8_lossy(&output.stdout).trim().to_string()
    if mime_type.is_empty() or mime_type == "application/octet-stream":
        return none
    log::info!("Open With Linux: file command resolved {}", mime_type)
    Option::Some(mime_type)

fn get_mime_type_from_extension(path: &std::path::Path) -> Option<String>:
    let extension = open_with__utils__path_extension_lowercase(path)?
    let mime_type = match extension.as_str():
        "txt" | "log" | "md" | "markdown" => "text/plain"
        "html" | "htm" => "text/html"
        "css" => "text/css"
        "js" | "mjs" => "application/javascript"
        "json" => "application/json"
        "xml" => "application/xml"
        "pdf" => "application/pdf"
        "zip" => "application/zip"
        "tar" => "application/x-tar"
        "gz" | "gzip" => "application/gzip"
        "7z" => "application/x-7z-compressed"
        "rar" => "application/vnd.rar"
        "jpg" | "jpeg" => "image/jpeg"
        "png" => "image/png"
        "gif" => "image/gif"
        "webp" => "image/webp"
        "svg" => "image/svg+xml"
        "ico" => "image/x-icon"
        "bmp" => "image/bmp"
        "tiff" | "tif" => "image/tiff"
        "mp3" => "audio/mpeg"
        "wav" => "audio/wav"
        "ogg" => "audio/ogg"
        "flac" => "audio/flac"
        "m4a" => "audio/mp4"
        "mp4" => "video/mp4"
        "mkv" => "video/x-matroska"
        "webm" => "video/webm"
        "avi" => "video/x-msvideo"
        "mov" => "video/quicktime"
        "wmv" => "video/x-ms-wmv"
        "doc" => "application/msword"
        "docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        "xls" => "application/vnd.ms-excel"
        "xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        "ppt" => "application/vnd.ms-powerpoint"
        "pptx" => "application/vnd.openxmlformats-officedocument.presentationml.presentation"
        "odt" => "application/vnd.oasis.opendocument.text"
        "ods" => "application/vnd.oasis.opendocument.spreadsheet"
        "odp" => "application/vnd.oasis.opendocument.presentation"
        "sh" | "bash" => "application/x-shellscript"
        "py" => "text/x-python"
        "rs" => "text/x-rust"
        "c" | "h" => "text/x-c"
        "cpp" | "hpp" | "cc" | "cxx" => "text/x-c++"
        "java" => "text/x-java"
        "ts" => "text/typescript"
        "tsx" | "jsx" => "text/javascript"
        "vue" => "text/x-vue"
        "yaml" | "yml" => "application/x-yaml"
        "toml" => "application/toml"
        "ini" | "conf" | "cfg" => "text/plain"
        "csv" => "text/csv"
        "sql" => "application/sql"
        "exe" => "application/x-executable"
        "deb" => "application/vnd.debian.binary-package"
        "rpm" => "application/x-rpm"
        "appimage" => "application/x-executable"
        "iso" => "application/x-iso9660-image"
        "ttf" => "font/ttf"
        "otf" => "font/otf"
        "woff" => "font/woff"
        "woff2" => "font/woff2"
        _ => return none
    Option::Some(mime_type.to_string())

fn get_associated_programs_impl(file_path: String) -> GetAssociatedProgramsResult:
    let path = Path__new_(file_path)
    if !path.exists():
        return GetAssociatedProgramsResult { success: false, recommended_programs: vec!(), other_programs: vec!(), default_program: none, error: Option::Some(format!("Path not found: {}", file_path)) }
    log::info!("Open With Linux: resolving apps for {}", file_path)
    let mime_type = match mime__get_mime_type(path):
        Ok(value) => value
        Err(message) =>
            log::warn!("Open With Linux: failed to resolve mime type for {}: {}", file_path, message)
            return GetAssociatedProgramsResult { success: false, recommended_programs: vec!(), other_programs: vec!(), default_program: none, error: Option::Some(message) }
    log::info!("Open With Linux: mime type {}", mime_type)
    let gio_info = desktop__get_gio_mime_info(&mime_type).unwrap_or(GioMimeInfo { default_app: none, recommended_apps: vec!(), registered_apps: vec!() })
    let mimeapps_entries = desktop__get_mimeapps_entries(&mime_type)
    let xdg_default_app = desktop__get_xdg_default_app(&mime_type)
    let default_desktop_id = gio_info.default_app.or_(mimeapps_entries.default_app).or_(xdg_default_app)
    match default_desktop_id:
        Some(default_id) =>
            log::info!("Open With Linux: default desktop id {}", default_id)
            ()
            ()
        _ =>
            log::info!("Open With Linux: default desktop id not found")
            ()
            ()
    let mut default_program: Option<AssociatedProgram> = none
    match default_desktop_id:
        Some(desktop_id) =>
            match desktop__desktop_id_to_program(desktop_id, true):
                Some(program) =>
                    default_program = Option::Some(program)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    log::warn!("Open With Linux: default desktop id not resolved {}", desktop_id)
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    let mut seen_ids: Set<String> = HashSet__new_()
    match default_desktop_id:
        Some(desktop_id) =>
            seen_ids.insert(desktop_id.to_lowercase())
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let mut recommended_programs: Array<AssociatedProgram> = Vec__new_()
    let mut other_programs: Array<AssociatedProgram> = Vec__new_()
    let mut recommended_ids: Array<String> = Vec__new_()
    let mut other_ids: Array<String> = Vec__new_()
    desktop__merge_desktop_ids(&mut recommended_ids, &gio_info.recommended_apps)
    ()
    desktop__merge_desktop_ids(&mut recommended_ids, &mimeapps_entries.recommended_apps)
    ()
    desktop__merge_desktop_ids(&mut other_ids, &gio_info.registered_apps)
    ()
    desktop__merge_desktop_ids(&mut other_ids, &mimeapps_entries.other_apps)
    ()
    log::info!("Open With Linux: candidates default={} recommended={} other={}", default_desktop_id.is_some(), recommended_ids.len(), other_ids.len())
    for desktop_id in recommended_ids:
        if seen_ids.contains(&desktop_id.to_lowercase()):
            continue
        match desktop__desktop_id_to_program(&desktop_id, false):
            Some(program) =>
                seen_ids.insert(desktop_id.to_lowercase())
                ()
                recommended_programs.push(program)
                ()
            _ =>
                log::warn!("Open With Linux: recommended desktop id not resolved {}", desktop_id)
    ()
    for desktop_id in other_ids:
        if seen_ids.contains(&desktop_id.to_lowercase()):
            continue
        match desktop__desktop_id_to_program(&desktop_id, false):
            Some(program) =>
                seen_ids.insert(desktop_id.to_lowercase())
                ()
                other_programs.push(program)
                ()
            _ =>
                log::warn!("Open With Linux: other desktop id not resolved {}", desktop_id)
    ()
    log::info!("Open With Linux: resolved default={} recommended={} other={}", default_program.is_some(), recommended_programs.len(), other_programs.len())
    GetAssociatedProgramsResult { success: true, recommended_programs: recommended_programs, other_programs: other_programs, default_program: default_program, error: none }

fn open_with_desktop_id(program_id: String, file_path: String) -> Option<OpenWithResult>:
    log::info!("Open With Linux: launch request program={} file={}", program_id, file_path)
    let mut candidate_ids: Array<String> = Vec__new_()
    if program_id.ends_with(".desktop"):
        candidate_ids.push(program_id.to_string())
        ()
        ()
        ()
        ()
    else:
        candidate_ids.push(format!("{}.desktop", program_id))
        ()
        candidate_ids.push(program_id.to_string())
        ()
        ()
        ()
        ()
    let mut desktop_path: Option<String> = none
    for candidate_id in &candidate_ids:
        match desktop__find_desktop_file(candidate_id):
            Some(found_path) =>
                desktop_path = Option::Some(found_path.to_string_lossy().to_string())
                ()
                break
            _ => ()
    ()
    if desktop_path.is_none() and !program_id.ends_with(".desktop"):
        log::warn!("Open With Linux: no desktop file found for {}", program_id)
        return none
    let launch_target = desktop_path.unwrap_or_else(|| program_id.to_string())
    match Command__new_("gio").args(["launch", &launch_target, file_path]).spawn_():
        Ok(_) =>
            log::info!("Open With Linux: launched via gio {}", launch_target)
            return Option::Some(OpenWithResult { success: true, error: none })
        Err(command_error) =>
            log::warn!("Open With Linux: gio launch failed for {}: {}", launch_target, command_error)
            ()
            ()
    let launch_id = launch_target.trim_end_matches(".desktop")
    match Command__new_("gtk-launch").arg(launch_id).arg(file_path).spawn_():
        Ok(_) =>
            log::info!("Open With Linux: launched via gtk-launch {}", launch_id)
            return Option::Some(OpenWithResult { success: true, error: none })
        Err(command_error) =>
            log::warn!("Open With Linux: gtk-launch failed for {}: {}", launch_id, command_error)
            ()
            ()
    Option::Some(OpenWithResult { success: false, error: Option::Some(format!("Failed to launch application: {}", program_id)) })

fn get_associated_programs_impl(file_path: String) -> GetAssociatedProgramsResult:
    let path = Path__new_(file_path)
    if !path.exists():
        return GetAssociatedProgramsResult { success: false, recommended_programs: vec!(), other_programs: vec!(), default_program: none, error: Option::Some(format!("Path not found: {}", file_path)) }
    let opener = file_opening_macos__MacFileOpener
    match opener.get_apps_for_file(path):
        Ok(apps) => GetAssociatedProgramsResult { success: true, recommended_programs: apps.into_iter().map(
            |app| block:
                let launch_id = app.id
                AssociatedProgram { name: app.name, path: launch_id.clone(), launch_id: Option::Some(launch_id), launch_kind: Option::Some(AssociatedProgramLaunchKind::BundleId), executable_path: none, icon: app.icon, is_default: false }
        ).collect(), other_programs: vec!(), default_program: none, error: none }
        Err(error) => GetAssociatedProgramsResult { success: false, recommended_programs: vec!(), other_programs: vec!(), default_program: none, error: Option::Some(error) }

fn open_with_application(program_id: String, file_path: String) -> OpenWithResult:
    let path = Path__new_(file_path)
    if !path.exists():
        return OpenWithResult { success: false, error: Option::Some(format!("File not found: {}", file_path)) }
    let opener = file_opening_macos__MacFileOpener
    match opener.open_with_app(path, program_id):
        Ok(result) => map_open_result(result)
        Err(error) => OpenWithResult { success: false, error: Option::Some(error) }

fn open_native_open_with_dialog_impl(file_path: String) -> OpenWithResult:
    let path = Path__new_(file_path)
    if !path.exists():
        return OpenWithResult { success: false, error: Option::Some(format!("File not found: {}", file_path)) }
    let script = format!("set targetFile to POSIX file \"{}\"\nset chosenApp to choose application with prompt \"Open With\"\ntell application chosenApp\n  activate\n  open targetFile\nend tell", escape_applescript_string(file_path))
    match Command__new_("osascript").arg("-e").arg(script).spawn_():
        Ok(_) => OpenWithResult { success: true, error: none }
        Err(spawn_error) => OpenWithResult { success: false, error: Option::Some(format!("Failed to open dialog: {}", spawn_error)) }

fn map_open_result(result: file_opening::OpenResult) -> OpenWithResult:
    match result:
        file_opening::OpenResult::Success => OpenWithResult { success: true, error: none }
        file_opening::OpenResult::FileNotFound { path: path } => OpenWithResult { success: false, error: Option::Some(format!("File not found: {}", path)) }
        file_opening::OpenResult::AppNotFound { app_id: app_id } => OpenWithResult { success: false, error: Option::Some(format!("Application not found: {}", app_id)) }
        file_opening::OpenResult::PermissionDenied { path: path } => OpenWithResult { success: false, error: Option::Some(format!("Permission denied while opening: {}", path)) }
        file_opening::OpenResult::PlatformError { message: message } => OpenWithResult { success: false, error: Option::Some(message) }

fn escape_applescript_string(value: String) -> String:
    value.replace("\\", "\\\\").replace("\"", "\\\"")

fn build_legacy_shell_context_menu_request(file_path: String) -> types::ShellContextMenuRequest:
    let current_directory_path = Path__new_(file_path).parent().map(|parent| parent.to_string_lossy().into_owned()).unwrap_or_else(|| file_path.to_string())
    types::ShellContextMenuRequest { target_kind: types::ShellContextMenuTargetKind::Entry, current_directory_path: current_directory_path, target_paths: vec!(file_path.to_string()) }

fn get_associated_programs(file_path: String) -> types::GetAssociatedProgramsResult:
    windows__get_associated_programs_impl(&file_path)
    ()
    ()
    linux__get_associated_programs_impl(&file_path)
    ()
    ()
    macos__get_associated_programs_impl(&file_path)
    ()
    ()
    let _ = file_path
    types::GetAssociatedProgramsResult { success: false, recommended_programs: vec!(), other_programs: vec!(), default_program: none, error: Option::Some("Open With functionality is only supported on Windows, macOS, and Linux currently".to_string()) }

fn open_with_get_associated_programs(file_path: String) -> Result<types::AssociatedProgramsCatalog, String>:
    get_associated_programs(file_path).into_result()

fn open_with_program(file_path: String, program_path: String, launch_arguments: Array<String>) -> types::OpenWithResult:
    let file = Path__new_(&file_path)
    if !file.exists():
        return types::OpenWithResult { success: false, error: Option::Some(format!("File not found: {}", file_path)) }
    let absolute_file_path = utils__canonicalize_path(file)
    if launch_arguments.is_empty():
        let handler_result = windows__invoke_handler_for_file(&program_path, &absolute_file_path)
        if handler_result.success or !Path__new_(&program_path).exists():
            return handler_result
        ()
    ()
    if launch_arguments.is_empty():
        match linux__open_with_desktop_id(&program_path, &absolute_file_path):
            Some(result) =>
                return result
            _ =>
                ()
                ()
        ()
    ()
    if launch_arguments.is_empty():
        return macos__open_with_application(&program_path, &absolute_file_path)
    ()
    let program = Path__new_(&program_path)
    if !program.exists():
        return types::OpenWithResult { success: false, error: Option::Some(format!("Program not found: {}", program_path)) }
    let mut command = Command__new_(&program_path)
    if launch_arguments.is_empty():
        command.arg(&absolute_file_path)
        ()
        ()
        ()
        ()
    else:
        let mut file_arg_added = false
        for arg in &launch_arguments:
            if arg.contains("%1"):
                command.arg(arg.replace("%1", &absolute_file_path))
                ()
                file_arg_added = true
                ()
            else if arg.contains("\"%1\""):
                command.arg(arg.replace("\"%1\"", &absolute_file_path))
                ()
                file_arg_added = true
                ()
            else:
                command.arg(arg)
                ()
        ()
        if !file_arg_added:
            command.arg(&absolute_file_path)
            ()
            ()
            ()
            ()
        ()
    command.creation_flags(DETACHED_PROCESS)
    ()
    ()
    ()
    ()
    match command.spawn_():
        Ok(_) => types::OpenWithResult { success: true, error: none }
        Err(spawn_error) => types::OpenWithResult { success: false, error: Option::Some(format!("Failed to start program: {}", spawn_error)) }

fn open_with_launch_program(file_path: String, program_path: String, launch_arguments: Array<String>) -> Result<(), String>:
    open_with_program(file_path, program_path, launch_arguments).into_result()

fn open_with_default(file_path: String) -> types::OpenWithResult:
    match Command__new_("cmd").args(["/C", "start", "", &file_path]).creation_flags(CREATE_NO_WINDOW).spawn_():
        Ok(_) =>
            types::OpenWithResult { success: true, error: none }
            ()
        Err(spawn_error) =>
            types::OpenWithResult { success: false, error: Option::Some(format!("Failed to open file: {}", spawn_error)) }
            ()
    ()
    match Command__new_("open").arg(&file_path).spawn_():
        Ok(_) =>
            types::OpenWithResult { success: true, error: none }
            ()
        Err(spawn_error) =>
            types::OpenWithResult { success: false, error: Option::Some(format!("Failed to open file: {}", spawn_error)) }
            ()
    ()
    match Command__new_("xdg-open").arg(&file_path).spawn_():
        Ok(_) => types::OpenWithResult { success: true, error: none }
        Err(spawn_error) => types::OpenWithResult { success: false, error: Option::Some(format!("Failed to open file: {}", spawn_error)) }

fn open_native_open_with_dialog(file_path: String) -> types::OpenWithResult:
    windows__open_native_open_with_dialog_impl(&file_path)
    ()
    ()
    macos__open_native_open_with_dialog_impl(&file_path)
    ()
    ()
    let _ = file_path
    types::OpenWithResult { success: false, error: Option::Some("Native Open With dialog is only supported on Windows and macOS".to_string()) }

fn get_shell_context_menu(file_path: String) -> types::GetShellContextMenuResult:
    windows__get_shell_context_menu_impl(&build_legacy_shell_context_menu_request(&file_path))
