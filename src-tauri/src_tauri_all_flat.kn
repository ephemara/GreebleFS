fn extract_bitmap_to_base64(hbitmap: windows::Win32::Graphics::Gdi::HBITMAP) -> Option<String>:
    let hdc = windows::Win32::Graphics::Gdi::CreateCompatibleDC(none)
    if hdc.is_invalid():
        return none
    let mut bmp: windows::Win32::Graphics::Gdi::BITMAP = std__mem__zeroed()
    if windows::Win32::Graphics::Gdi::GetObjectW(hbitmap, std__mem__size_of() as i32, Option::Some(&mut bmp as PtrMut<_> as PtrMut<_>)) == 0:
        let _ = windows::Win32::Graphics::Gdi::DeleteDC(hdc)
        return none
    let width = bmp.bmWidth
    let height = bmp.bmHeight.abs()
    if width <= 0 or height <= 0 or width > 256 or height > 256:
        let _ = windows::Win32::Graphics::Gdi::DeleteDC(hdc)
        return none
    let mut bitmap_info: windows::Win32::Graphics::Gdi::BITMAPINFO = std__mem__zeroed()
    bitmap_info.bmiHeader.biSize = std__mem__size_of() as u32
    ()
    bitmap_info.bmiHeader.biWidth = width
    ()
    bitmap_info.bmiHeader.biHeight = -height
    ()
    bitmap_info.bmiHeader.biPlanes = 1
    ()
    bitmap_info.bmiHeader.biBitCount = 32
    ()
    bitmap_info.bmiHeader.biCompression = windows::Win32::Graphics::Gdi::BI_RGB.field_0
    ()
    let pixel_count = (width * height) as usize
    let mut pixels = vec!()
    let old_bitmap = windows::Win32::Graphics::Gdi::SelectObject(hdc, hbitmap)
    let result = windows::Win32::Graphics::Gdi::GetDIBits(hdc, hbitmap, 0, height as u32, Option::Some(pixels.as_mut_ptr() as PtrMut<_>), &mut bitmap_info, windows::Win32::Graphics::Gdi::DIB_RGB_COLORS)
    windows::Win32::Graphics::Gdi::SelectObject(hdc, old_bitmap)
    ()
    let _ = windows::Win32::Graphics::Gdi::DeleteDC(hdc)
    if result == 0:
        return none
    let mut rgba_pixels = |__kain_ctor_arg0| Vec::new()(pixel_count * 4)
    for pixel_index in 0..pixel_count:
        let byte_index = pixel_index * 4
        let blue = pixels[byte_index]
        let green = pixels[byte_index + 1]
        let red = pixels[byte_index + 2]
        let alpha = pixels[byte_index + 3]
        rgba_pixels.push(red)
        ()
        rgba_pixels.push(green)
        ()
        rgba_pixels.push(blue)
        ()
        rgba_pixels.push(alpha)
        ()
    ()
    let mut png_data = Vec__new_()
    let encoder = PngEncoder__new_(&mut png_data)
    if encoder.write_image(&rgba_pixels, width as u32, height as u32, image::ExtendedColorType::Rgba8).is_err():
