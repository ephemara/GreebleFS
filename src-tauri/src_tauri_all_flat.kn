fn default_true() -> Bool:
    true

struct RuntimeManifestRaw:
    id: String
    display_name: Option<String>
    language: Option<String>
    kind: RuntimeKind
    compiler: RuntimeCompiler
    module_dir: Option<String>
    entry: Option<String>
    watch_globs: Array<String>
    env: Map<String, String>
    args: Array<String>
    working_directory: Option<String>
    permissions: RuntimePackagePermissions
    panel: Option<RuntimePanelConfig>
    command: Option<RuntimeCommandConfig>
    sidecar: Option<RuntimeSidecarConfig>
    tui: Option<RuntimeTuiConfig>

struct RuntimeManifest:
    id: String
    display_name: String
    language: String
    kind: RuntimeKind
    compiler: RuntimeCompiler
    manifest_dir: String
    module_dir: String
    entry: Option<String>
    watch_globs: Array<String>
    env: Map<String, String>
    args: Array<String>
    working_directory: Option<String>
    permissions: RuntimePackagePermissions
    panel: Option<RuntimePanelConfig>
    command: Option<RuntimeCommandConfig>
    sidecar: Option<RuntimeSidecarConfig>
    tui: Option<RuntimeTuiConfig>
    source_signature: String

impl RuntimeManifest:
    fn from_dir(manifest_dir: &std::path::Path) -> Result<RuntimeManifest, String>:
        let manifest_path = manifest_dir.join(RuntimeManifest::FILE_NAME)
        let raw_text = std__fs__read_to_string(&manifest_path).map_err(|error| format!("Failed to read runtime manifest {}: {error}", manifest_path.to_string_lossy()))?
        RuntimeManifest__from_raw_text(manifest_dir, &raw_text)

    fn from_raw_text(manifest_dir: &std::path::Path, raw_text: String) -> Result<RuntimeManifest, String>:
        let raw: RuntimeManifestRaw = toml__from_str(raw_text).map_err(|error| format!("Failed to parse runtime.toml in {}: {error}", manifest_dir.to_string_lossy()))?
        RuntimeManifest__from_raw(manifest_dir, raw)

    fn from_raw(manifest_dir: &std::path::Path, raw: RuntimeManifestRaw) -> Result<RuntimeManifest, String>:
        validate_kind_compiler_pairing(raw.kind, raw.compiler)?
        ()
        let canonical_manifest_dir = manifest_dir.canonicalize().unwrap_or_else(|_| manifest_dir.to_path_buf())
        let module_dir = raw.module_dir.map(|relative| resolve_within(&canonical_manifest_dir, relative)).unwrap_or_else(|| canonical_manifest_dir.clone())
        let entry = raw.entry.map(|relative| resolve_within(&canonical_manifest_dir, relative))
        let working_directory = raw.working_directory.map(|relative| resolve_within(&canonical_manifest_dir, relative))
        let display_name = raw.display_name.unwrap_or_else(|| raw.id.clone())
        let language = raw.language.unwrap_or_else(
            || match raw.compiler:
                RuntimeCompiler::PythonSidecar => "python".to_string()
                RuntimeCompiler::KainScript => "kain".to_string()
                RuntimeCompiler::NodeScript => "node".to_string()
                RuntimeCompiler::CargoNative | RuntimeCompiler::CargoWasmBindgen => "rust".to_string()
                RuntimeCompiler::CNative => "c".to_string()
                _ => "go".to_string()
        )
        let source_signature = runtime_pipeline__cache__compute_source_signature(&module_dir).unwrap_or_else(|_| "unsigned".to_string())
        Result::Ok(RuntimeManifest { id: raw.id, display_name: display_name, language: language, kind: raw.kind, compiler: raw.compiler, manifest_dir: path_to_string(&canonical_manifest_dir), module_dir: path_to_string(&module_dir), entry: entry.map(|p| path_to_string(&p)), watch_globs: raw.watch_globs, env: raw.env, args: raw.args, working_directory: working_directory.map(|p| path_to_string(&p)), permissions: raw.permissions, panel: raw.panel, command: raw.command, sidecar: raw.sidecar, tui: raw.tui, source_signature: source_signature })


fn resolve_within(base: &std::path::Path, relative: String) -> std::path::PathBuf:
    let candidate = Path__new_(relative)
    if candidate.is_absolute():
        candidate.to_path_buf()
    else:
        base.join(candidate)

fn path_to_string(path: &std::path::Path) -> String:
    let raw = path.to_string_lossy().to_string()
    match raw.strip_prefix("\\\\?\\UNC\\"):
        Some(stripped_unc) =>
            return format!("\\\\{}", stripped_unc)
        _ =>
            ()
            ()
    raw.strip_prefix("\\\\?\\").unwrap_or(&raw).to_string()

fn validate_kind_compiler_pairing(kind: RuntimeKind, compiler: RuntimeCompiler) -> Result<(), String>:
    let ok = match (kind, compiler):
        (RuntimeKind::NativeSidecar, RuntimeCompiler::GoNative) | (RuntimeKind::NativeSidecar, RuntimeCompiler::CargoNative) | (RuntimeKind::NativeSidecar, RuntimeCompiler::CNative) | (RuntimeKind::NativeSidecar, RuntimeCompiler::PythonSidecar) | (RuntimeKind::NativeSidecar, RuntimeCompiler::KainScript) | (RuntimeKind::NativeSidecar, RuntimeCompiler::NodeScript) | (RuntimeKind::VscodeBridge, RuntimeCompiler::NodeScript) | (RuntimeKind::NativeCommand, RuntimeCompiler::GoNative) | (RuntimeKind::NativeCommand, RuntimeCompiler::CargoNative) | (RuntimeKind::NativeCommand, RuntimeCompiler::CNative) | (RuntimeKind::NativeTui, RuntimeCompiler::GoNative) | (RuntimeKind::NativeTui, RuntimeCompiler::CargoNative) | (RuntimeKind::NativeTui, RuntimeCompiler::CNative) | (RuntimeKind::WasmPanel, RuntimeCompiler::GoJsWasm) | (RuntimeKind::WasmPanel, RuntimeCompiler::TinygoWasm) | (RuntimeKind::WasmPanel, RuntimeCompiler::GoNative) | (RuntimeKind::WasmPanel, RuntimeCompiler::CargoWasmBindgen) | (RuntimeKind::WasmWorker, RuntimeCompiler::GoJsWasm) | (RuntimeKind::WasmWorker, RuntimeCompiler::TinygoWasm) | (RuntimeKind::WasmWorker, RuntimeCompiler::CargoWasmBindgen) => true
        _ => false
    if ok:
        Result::Ok(())
    else:
        Result::Err(format!("runtime.toml uses unsupported kind/compiler pairing: kind={}, compiler={}", kind.as_str(), compiler.as_str()))

struct RuntimeRegistry:
    inner: RegistryState

impl Default for RuntimeRegistry:
    fn default_() -> RuntimeRegistry:
        RuntimeRegistry { inner: RegistryState__default_() }


struct RegistryState:
    by_id: Map<String, DiscoveredRuntimePackage>
    last_roots: Array<RuntimeDiscoveryRoot>

impl Default for RegistryState:
    fn default_() -> RegistryState:
        RegistryState { by_id: HashMap__new_(), last_roots: Vec__new_() }


impl RuntimeRegistry:
    fn refresh_from_roots(_self: &RuntimeRegistry, roots: Array<RuntimeDiscoveryRoot>) -> Array<DiscoveredRuntimePackage>:
        let packages = runtime_pipeline__discovery__discover_runtime_packages(&roots)
        let mut by_id = |__kain_ctor_arg0| std::collections::HashMap::new()(packages.len())
        for package in &packages:
            by_id.insert(package.manifest.id.clone(), package.clone())
            ()
        ()
        match (*_self).inner.write():
            Ok(mut state) =>
                state.by_id = by_id
                ()
                state.last_roots = roots
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        packages

    fn snapshot(_self: &RuntimeRegistry) -> Array<DiscoveredRuntimePackage>:
        (*_self).inner.read().map(|state| state.by_id.values().cloned().collect()).unwrap_or_default()

    fn get_by_id(_self: &RuntimeRegistry, id: String) -> Option<DiscoveredRuntimePackage>:
        (*_self).inner.read().ok().and_then(|state| state.by_id.get(id).cloned())

    fn last_roots(_self: &RuntimeRegistry) -> Array<RuntimeDiscoveryRoot>:
        (*_self).inner.read().map(|state| state.last_roots.clone()).unwrap_or_default()


struct ExternalRuntimeSidecarStatus:
    runtime_id: String
    running: Bool
    pid: Option<u32>
    last_error: Option<String>
    action_ids: Array<String>
    manifest_dir: String

struct ExternalSidecarManager:
    sessions: Map<String, ExternalSidecarSession>
    last_errors: Map<String, String>

impl Default for ExternalSidecarManager:
    fn default_() -> ExternalSidecarManager:
        ExternalSidecarManager { sessions: HashMap__new_(), last_errors: HashMap__new_() }


struct ExternalSidecarSession:
    runtime_id: String
    transport: String
    child: std::process::Child
    pid: u32
    request_counter: u64
    manifest_dir: std::path::PathBuf
    action_ids: Array<String>
    outbound_tx: std::sync::mpsc::Sender<ExternalSidecarPacket>
    pending_responses: Map<String, std::sync::mpsc::Sender<ExternalSidecarPacket>>
    current_execution_context: Option<ExecutionContextSnapshot>
    owned_subscription_ids: Array<String>

struct ExternalSidecarPacket:
    request_id: String
    kind: String
    action_id: Option<String>
    method_id: Option<String>
    payload_json: Option<String>
    execution_context_json: Option<String>
    cwd: Option<String>
    environment: Option<Map<String, String>>
    ok: Option<Bool>
    result_json: Option<String>
    error: Option<String>
    subscription_id: Option<String>

impl Default for ExternalSidecarPacket:
    fn default_() -> ExternalSidecarPacket:
        ExternalSidecarPacket { request_id: String__new_(), kind: String__new_(), action_id: none, method_id: none, payload_json: none, execution_context_json: none, cwd: none, environment: none, ok: none, result_json: none, error: none, subscription_id: none }


struct ExternalSidecarSubscriptionEnvelope:
    subscription_id: String

struct ExternalRuntimeSidecarCallResponse:
    runtime_id: String
    request_id: String
    action_id: String
    result_json: String

impl ExternalSidecarManager:
    fn sessions_guard(_self: &ExternalSidecarManager) -> std::sync::MutexGuard<_, Map<String, ExternalSidecarSession>>:
        (*_self).sessions.lock().unwrap_or_else(|poisoned| poisoned.into_inner())

    fn last_errors_guard(_self: &ExternalSidecarManager) -> std::sync::MutexGuard<_, Map<String, String>>:
        (*_self).last_errors.lock().unwrap_or_else(|poisoned| poisoned.into_inner())

    fn status(_self: &ExternalSidecarManager, runtime_id: String) -> ExternalRuntimeSidecarStatus:
        let last_error = (*_self).last_errors_guard().get(runtime_id).cloned()
        let session_info = (*_self).sessions_guard().get(runtime_id).map(|session| (session.pid, session.manifest_dir.clone(), session.action_ids.clone()))
        match session_info:
            Some((pid, manifest_dir, action_ids)) => ExternalRuntimeSidecarStatus { runtime_id: runtime_id.to_string(), running: true, pid: Option::Some(pid), last_error: last_error, action_ids: action_ids, manifest_dir: manifest_dir.to_string_lossy().to_string() }
            None => ExternalRuntimeSidecarStatus { runtime_id: runtime_id.to_string(), running: false, pid: none, last_error: last_error, action_ids: Vec__new_(), manifest_dir: String__new_() }

    fn start(_self: &ExternalSidecarManager, app: &tauri::AppHandle, manifest: &RuntimeManifest, binary_path: &std::path::PathBuf) -> Result<ExternalRuntimeSidecarStatus, String>:
        if !matches!((*manifest).kind, RuntimeKind::NativeSidecar | RuntimeKind::VscodeBridge):
            return Result::Err(format!("runtime {} is not a long-lived sidecar runtime (kind = {})", (*manifest).id, (*manifest).kind.as_str()))
        if (*manifest).compiler == RuntimeCompiler::PythonSidecar:
            return Result::Err("Python sidecars stay on the legacy python_sidecar lane; do not start through external runtime manager".to_string())
        let sessions = (*_self).sessions_guard()
        if sessions.contains_key(&(*manifest).id):
            return Result::Ok((*_self).status(&(*manifest).id))
        ()
        let mut command = if (*manifest).compiler == RuntimeCompiler::NodeScript:
            let mut command = Command__new_(resolve_node_executable_for_sidecar(&app))
            command.arg(binary_path)
            ()
            command
        else:
            Command__new_(binary_path)
        if (*manifest).compiler == RuntimeCompiler::KainScript:
            apply_kain_sidecar_environment(&app, &mut command)
            ()
            ()
            ()
            ()
        command.args(&(*manifest).args).stdin(Stdio__piped()).stdout(Stdio__piped()).stderr(Stdio__piped()).envs((*manifest).env.iter())
        ()
        match (*manifest).working_directory:
            Some(cwd) =>
                command.current_dir(cwd)
                ()
                ()
                ()
                ()
            _ =>
                command.current_dir(&(*manifest).module_dir)
                ()
                ()
                ()
                ()
        let mut child = command.spawn_().map_err(|error| format!("Failed to spawn sidecar {}: {error}", (*manifest).id))?
        let pid = child.id()
        let stdin = child.stdin.take().ok_or_else(|| format!("sidecar {} did not expose stdin", (*manifest).id))?
        let stdout = child.stdout.take().ok_or_else(|| format!("sidecar {} did not expose stdout", (*manifest).id))?
        let transport = (*manifest).sidecar.map(|sidecar| sidecar.transport.trim().to_string()).filter(|value| !value.is_empty()).unwrap_or_else(|| SIDECAR_TRANSPORT_V1.to_string())
        let action_ids = (*manifest).sidecar.map(|cfg| cfg.actions.iter().map(|action| action.id.clone()).collect()).unwrap_or_default()
        let (outbound_tx, outbound_rx) = std__sync__mpsc__channel()
        let pending_responses = Arc__new_(Mutex__new_(HashMap__new_()))
        let current_execution_context = Arc__new_(Mutex__new_(none))
        let owned_subscription_ids = Arc__new_(Mutex__new_(Vec__new_()))
        spawn_sidecar_writer_thread((*manifest).id.clone(), transport.clone(), stdin, outbound_rx)
        ()
        spawn_sidecar_reader_thread(app.clone(), (*manifest).id.clone(), transport.clone(), stdout, outbound_tx.clone(), Arc__clone(&pending_responses), Arc__clone(&current_execution_context), Arc__clone(&owned_subscription_ids), (*manifest).compiler == RuntimeCompiler::KainScript)
        ()
        let session = ExternalSidecarSession { runtime_id: (*manifest).id.clone(), transport: transport, child: child, pid: pid, request_counter: 0, manifest_dir: PathBuf__from(&(*manifest).manifest_dir), action_ids: action_ids, outbound_tx: outbound_tx, pending_responses: pending_responses, current_execution_context: current_execution_context, owned_subscription_ids: owned_subscription_ids }
        let mut sessions = (*_self).sessions_guard()
        sessions.insert((*manifest).id.clone(), session)
        ()
        drop(sessions)
        ()
        (*_self).last_errors_guard().remove(&(*manifest).id)
        ()
        Result::Ok((*_self).status(&(*manifest).id))

    fn stop(_self: &ExternalSidecarManager, app: &tauri::AppHandle, runtime_id: String) -> ExternalRuntimeSidecarStatus:
        let mut sessions = (*_self).sessions_guard()
        match sessions.remove(runtime_id):
            Some(mut session) =>
                let _ = session.outbound_tx.send_(ExternalSidecarPacket { request_id: format!("{runtime_id}-shutdown"), kind: SIDECAR_KIND_SHUTDOWN.to_string(), ..ExternalSidecarPacket__default_() })
                cleanup_sidecar_subscriptions(app, &session)
                ()
                let _ = session.child.kill()
                let _ = session.child.wait()
                ()
            _ =>
                ()
                ()
        drop(sessions)
        ()
        (*_self).status(runtime_id)

    fn call(_self: &ExternalSidecarManager, runtime_id: String, action_id: String, payload_json: Option<String>, cwd: Option<String>, environment: Option<Map<String, String>>, execution_context: Option<ExecutionContextSnapshot>) -> Result<ExternalRuntimeSidecarCallResponse, String>:
        let (request_id, outbound_tx, pending_responses, current_execution_context) = block:
            let mut sessions = (*_self).sessions_guard()
            let session = sessions.get_mut(runtime_id).ok_or_else(|| format!("runtime {} sidecar is not running", runtime_id))?
            session.request_counter = session.request_counter + 1
            ()
            (format!("{}-{}", session.runtime_id, session.request_counter), session.outbound_tx.clone(), Arc__clone(&session.pending_responses), Arc__clone(&session.current_execution_context))
        let execution_context_json = match execution_context:
            Option::Some(__kain_option_as_ref_value) => Option::Some(&__kain_option_as_ref_value)
            Option::None => none.and_then(|snapshot| serde_json__to_string(snapshot).ok())
        let mut guard = current_execution_context.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
        *guard = execution_context
        ()
        ()
        ()
        ()
        let (response_tx, response_rx) = std__sync__mpsc__channel()
        pending_responses.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).insert(request_id.clone(), response_tx)
        ()
        let send_result = outbound_tx.send_(ExternalSidecarPacket { request_id: request_id.clone(), kind: SIDECAR_KIND_CALL.to_string(), action_id: Option::Some(action_id.to_string()), payload_json: payload_json, execution_context_json: execution_context_json, cwd: cwd, environment: environment, ..ExternalSidecarPacket__default_() })
        match send_result:
            Err(error) =>
                pending_responses.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).remove(&request_id)
                ()
                (*_self).last_errors_guard().insert(runtime_id.to_string(), error.to_string())
                ()
                return Result::Err(format!("failed to send sidecar call packet: {error}"))
            _ =>
                ()
                ()
        let response = response_rx.recv().map_err(|error| format!("sidecar {} did not respond: {error}", runtime_id))?
        let mut guard = current_execution_context.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
        *guard = none
        ()
        ()
        ()
        ()
        if response.ok != Option::Some(true):
            let message = response.error.clone().unwrap_or_else(|| "sidecar reported failure with no message".to_string())
            (*_self).last_errors_guard().insert(runtime_id.to_string(), message.clone())
            ()
            return Result::Err(message)
        Result::Ok(ExternalRuntimeSidecarCallResponse { runtime_id: runtime_id.to_string(), request_id: request_id, action_id: action_id.to_string(), result_json: response.result_json.unwrap_or_else(|| "null".to_string()) })


fn spawn_sidecar_writer_thread(runtime_id: String, transport: String, stdin: std::process::ChildStdin, outbound_rx: std::sync::mpsc::Receiver<ExternalSidecarPacket>):
    std__thread__spawn_(
        || loop:
            match outbound_rx.recv():
                Ok(packet) =>
                    match write_packet_line(&mut stdin, &packet):
                        Err(error) =>
                            eprintln!("[greeblefs-runtime] failed to write {} sidecar packet for {}: {}", transport, runtime_id, error)
                            break
                        _ =>
                            ()
                            ()
                    if packet.kind == SIDECAR_KIND_SHUTDOWN:
                        break
                _ => break
    )
    ()

fn spawn_sidecar_reader_thread(app: tauri::AppHandle, runtime_id: String, transport: String, stdout: std::process::ChildStdout, outbound_tx: std::sync::mpsc::Sender<ExternalSidecarPacket>, pending_responses: Map<String, std::sync::mpsc::Sender<ExternalSidecarPacket>>, current_execution_context: Option<ExecutionContextSnapshot>, owned_subscription_ids: Array<String>, allow_stdout_noise: Bool):
    std__thread__spawn_(
        || block:
            let mut stdout_reader = BufReader__new_(stdout)
            loop:
                let mut line_ = String__new_()
                let bytes = match stdout_reader.read_line(&mut line_):
                    Ok(bytes) => bytes
                    Err(error) =>
                        resolve_pending_sidecar_failures(&pending_responses, format!("failed to read sidecar stdout: {error}"))
                        ()
                        break
                if bytes == 0:
                    resolve_pending_sidecar_failures(&pending_responses, "sidecar exited before returning a response".to_string())
                    ()
                    break
                let trimmed = line_.trim()
                if trimmed.is_empty():
                    continue
                let packet: ExternalSidecarPacket = match serde_json__from_str(trimmed):
                    Ok(packet) => packet
                    Err(error) =>
                        if allow_stdout_noise:
                            eprintln!("[greeblefs-runtime] ignored non-protocol stdout from {} sidecar: {}", runtime_id, trimmed)
                            continue
                        resolve_pending_sidecar_failures(&pending_responses, format!("failed to parse sidecar packet: {error}"))
                        ()
                        break
                match packet.kind.as_str():
                    SIDECAR_KIND_HOST_CALL =>
                        let execution_context = current_execution_context.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).clone().or_else(
                            || block:
                                let host_event_bus = app.state()
                                host_event_bus.active_execution_context_snapshot()
                        )
                        let runtime_registry = app.state()
                        let result = runtime_pipeline__commands__dispatch_runtime_sidecar_host_call(&app, &runtime_registry, runtime_id.as_str(), packet.method_id.unwrap_or_default(), packet.payload_json.clone(), execution_context)
                        let response_packet = match result:
                            Ok(result_json) => ExternalSidecarPacket { request_id: packet.request_id.clone(), kind: SIDECAR_KIND_HOST_RESPONSE.to_string(), ok: Option::Some(true), result_json: Option::Some(result_json), ..ExternalSidecarPacket__default_() }
                            Err(error) => ExternalSidecarPacket { request_id: packet.request_id.clone(), kind: SIDECAR_KIND_HOST_RESPONSE.to_string(), ok: Option::Some(false), error: Option::Some(error), ..ExternalSidecarPacket__default_() }
                        let _ = outbound_tx.send_(response_packet)
                    SIDECAR_KIND_SUBSCRIBE =>
                        handle_runtime_sidecar_subscription_packet(&app, &runtime_id, &transport, packet, &outbound_tx, &owned_subscription_ids)
                        ()
                    SIDECAR_KIND_UNSUBSCRIBE =>
                        handle_runtime_sidecar_unsubscribe_packet(&app, &runtime_id, packet, &outbound_tx, &owned_subscription_ids)
                        ()
                    SIDECAR_KIND_PUBLISH =>
                        handle_runtime_sidecar_publish_packet(&app, &runtime_id, packet, &outbound_tx)
                        ()
                    SIDECAR_KIND_ACK | SIDECAR_KIND_HOST_RESPONSE | SIDECAR_KIND_RESPONSE | SIDECAR_KIND_READY | SIDECAR_KIND_ERROR | "" =>
                        resolve_pending_sidecar_response(&pending_responses, packet)
                        ()
                    _ =>
                        resolve_pending_sidecar_response(&pending_responses, packet)
                        ()
    )
    ()

fn apply_kain_sidecar_environment(app: &tauri::AppHandle, command: &mut std::process::Command):
    let context = RuntimeToolchainContext { resource_dir: app.path().resource_dir().ok() }
    let payload_root = runtime_pipeline__toolchain__resolve_kain_payload_root(&context)
    runtime_pipeline__toolchain__apply_kain_payload_environment(command, payload_root)
    ()
    match payload_root:
        Some(payload_root) =>
            command.env("GREEBLEFS_KAIN_PAYLOAD_ROOT", payload_root)
            ()
        _ => ()

fn resolve_node_executable_for_sidecar(app: &tauri::AppHandle) -> std::path::PathBuf:
    let context = RuntimeToolchainContext { resource_dir: app.path().resource_dir().ok() }
    runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(&context).node.executable_path.map(PathBuf__from).unwrap_or_else(|| PathBuf__from("node"))

fn resolve_pending_sidecar_response(pending_responses: &Map<String, std::sync::mpsc::Sender<ExternalSidecarPacket>>, packet: ExternalSidecarPacket):
    match pending_responses.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).remove(packet.request_id.as_str()):
        Some(sender) =>
            let _ = sender.send_(packet)
        _ => ()

fn resolve_pending_sidecar_failures(pending_responses: &Map<String, std::sync::mpsc::Sender<ExternalSidecarPacket>>, error: String):
    let mut pending = pending_responses.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
    let senders = pending.drain().map(|__kain_closure_arg0| __kain_closure_arg0.__kain_tuple_1).collect()
    drop(pending)
    ()
    for sender in senders:
        let _ = sender.send_(ExternalSidecarPacket { request_id: "sidecar-failure".to_string(), kind: SIDECAR_KIND_ERROR.to_string(), ok: Option::Some(false), error: Option::Some(error.clone()), ..ExternalSidecarPacket__default_() })

fn handle_runtime_sidecar_subscription_packet(app: &tauri::AppHandle, runtime_id: String, transport: String, packet: ExternalSidecarPacket, outbound_tx: &std::sync::mpsc::Sender<ExternalSidecarPacket>, owned_subscription_ids: &Array<String>):
    if transport != SIDECAR_TRANSPORT_V2:
        let _ = outbound_tx.send_(ExternalSidecarPacket { request_id: packet.request_id, kind: SIDECAR_KIND_ACK.to_string(), ok: Option::Some(false), error: Option::Some("Host subscriptions require `stdio-json-lines-v2` transport.".to_string()), ..ExternalSidecarPacket__default_() })
        return
    let payload_json = packet.payload_json.unwrap_or_else(|| "null".to_string())
    let request: HostSubscriptionRequest = match serde_json__from_str(payload_json.as_str()):
        Ok(request) => request
        Err(error) =>
            let _ = outbound_tx.send_(ExternalSidecarPacket { request_id: packet.request_id, kind: SIDECAR_KIND_ACK.to_string(), ok: Option::Some(false), error: Option::Some(format!("Invalid subscribe payload: {error}")), ..ExternalSidecarPacket__default_() })
            return
    let host_event_bus = app.state()
    let runtime_id_for_scope = runtime_id.to_string()
    let sender = outbound_tx.clone()
    let subscription = host_event_bus.subscribe_callback(
        request.clone(),
        format!("runtime-sidecar:{runtime_id}"),
        Arc__new_(
            |event| block:
                let payload_json = serde_json__to_string(&event).ok()
                let _ = sender.send_(
                    ExternalSidecarPacket { request_id: event.event_id.clone(), kind: if event.snapshot:
                        SIDECAR_KIND_SNAPSHOT.to_string()
                    else:
                        SIDECAR_KIND_EVENT.to_string(), payload_json: payload_json, subscription_id: event.subscription_id.clone(), ..ExternalSidecarPacket__default_() }
                )
        )
    )
    match subscription:
        Ok(subscription) =>
            owned_subscription_ids.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).push(subscription.subscription_id.clone())
            ()
            let _ = outbound_tx.send_(ExternalSidecarPacket { request_id: packet.request_id.clone(), kind: SIDECAR_KIND_ACK.to_string(), ok: Option::Some(true), result_json: serde_json__to_string(&subscription).ok(), subscription_id: Option::Some(subscription.subscription_id.clone()), ..ExternalSidecarPacket__default_() })
            if request.include_snapshot or request.replay_from.is_some():
                let snapshots = host_event_bus.snapshots_for_request(&request)
                for mut snapshot in snapshots:
                    snapshot.subscription_id = Option::Some(subscription.subscription_id.clone())
                    ()
                    snapshot.scope.runtime_id = Option::Some(runtime_id_for_scope.clone())
                    ()
                    let _ = outbound_tx.send_(ExternalSidecarPacket { request_id: snapshot.event_id.clone(), kind: SIDECAR_KIND_SNAPSHOT.to_string(), payload_json: serde_json__to_string(&snapshot).ok(), subscription_id: Option::Some(subscription.subscription_id.clone()), ..ExternalSidecarPacket__default_() })
        Err(error) =>
            let _ = outbound_tx.send_(ExternalSidecarPacket { request_id: packet.request_id, kind: SIDECAR_KIND_ACK.to_string(), ok: Option::Some(false), error: Option::Some(error), ..ExternalSidecarPacket__default_() })

fn handle_runtime_sidecar_unsubscribe_packet(app: &tauri::AppHandle, _runtime_id: String, packet: ExternalSidecarPacket, outbound_tx: &std::sync::mpsc::Sender<ExternalSidecarPacket>, owned_subscription_ids: &Array<String>):
    let subscription_id = packet.subscription_id.clone().or_else(|| packet.payload_json.and_then(|payload_json| serde_json__from_str(payload_json).ok().map(|payload| payload.subscription_id))).unwrap_or_default()
    if subscription_id.trim().is_empty():
        let _ = outbound_tx.send_(ExternalSidecarPacket { request_id: packet.request_id, kind: SIDECAR_KIND_ACK.to_string(), ok: Option::Some(false), error: Option::Some("unsubscribe requires a subscriptionId".to_string()), ..ExternalSidecarPacket__default_() })
        return
    let host_event_bus = app.state()
    let removed = host_event_bus.unsubscribe(app, subscription_id.as_str())
    owned_subscription_ids.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).retain(|value| value != subscription_id.as_str())
    ()
    let _ = outbound_tx.send_(ExternalSidecarPacket { request_id: packet.request_id, kind: SIDECAR_KIND_ACK.to_string(), ok: Option::Some(true), result_json: serde_json__to_string(&removed).ok(), subscription_id: Option::Some(subscription_id), ..ExternalSidecarPacket__default_() })

fn handle_runtime_sidecar_publish_packet(app: &tauri::AppHandle, runtime_id: String, packet: ExternalSidecarPacket, outbound_tx: &std::sync::mpsc::Sender<ExternalSidecarPacket>):
    let payload_json = packet.payload_json.unwrap_or_else(|| "null".to_string())
    let payload: HostPublishEventRequest = match serde_json__from_str(payload_json.as_str()):
        Ok(payload) => payload
        Err(error) =>
            let _ = outbound_tx.send_(ExternalSidecarPacket { request_id: packet.request_id, kind: SIDECAR_KIND_ACK.to_string(), ok: Option::Some(false), error: Option::Some(format!("Invalid publish payload: {error}")), ..ExternalSidecarPacket__default_() })
            return
    let host_event_bus = app.state()
    let execution_context = host_event_bus.active_execution_context_snapshot()
    let result = host_event_bus.publish_extension_event(payload.topic.as_str(), payload.payload_json, execution_context, Option::Some(runtime_id))
    match result:
        Ok(envelope) =>
            let _ = outbound_tx.send_(ExternalSidecarPacket { request_id: packet.request_id, kind: SIDECAR_KIND_ACK.to_string(), ok: Option::Some(true), result_json: serde_json__to_string(&envelope).ok(), ..ExternalSidecarPacket__default_() })
        Err(error) =>
            let _ = outbound_tx.send_(ExternalSidecarPacket { request_id: packet.request_id, kind: SIDECAR_KIND_ACK.to_string(), ok: Option::Some(false), error: Option::Some(error), ..ExternalSidecarPacket__default_() })

fn cleanup_sidecar_subscriptions(app: &tauri::AppHandle, session: &ExternalSidecarSession):
    let subscription_ids = (*session).owned_subscription_ids.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).clone()
    if subscription_ids.is_empty():
        return
    let host_event_bus = app.state()
    for subscription_id in subscription_ids:
        host_event_bus.unsubscribe(app, subscription_id.as_str())
        ()

fn write_packet_line(stdin: &mut std::process::ChildStdin, packet: &ExternalSidecarPacket) -> Result<(), String>:
    let serialized = serde_json__to_string(packet).map_err(|error| format!("failed to encode sidecar packet: {error}"))?
    stdin.write_all(serialized.as_bytes()).and_then(|_| stdin.write_all([10])).and_then(|_| stdin.flush()).map_err(|error| format!("failed to write to sidecar stdin: {error}"))?
    ()
    Result::Ok(())

struct RuntimeToolchainStatus:
    go: ToolchainProbe
    tinygo: ToolchainProbe
    cargo: ToolchainProbe
    rustc: ToolchainProbe
    wasm_bindgen: ToolchainProbe
    cc: ToolchainProbe
    python: ToolchainProbe
    kain: ToolchainProbe
    node: ToolchainProbe
    manifest_path: Option<String>
    kain_manifest_path: Option<String>

struct ToolchainProbe:
    id: String
    installed: Bool
    version: Option<String>
    executable_path: Option<String>
    error: Option<String>

struct RuntimeToolchainContext:
    resource_dir: Option<std::path::PathBuf>

impl Default for RuntimeToolchainContext:
    fn default_() -> RuntimeToolchainContext:
        RuntimeToolchainContext { resource_dir: none }


impl ToolchainProbe:
    fn missing(id: impl Into<String>, error: impl Into<String>) -> ToolchainProbe:
        ToolchainProbe { id: id.into(), installed: false, version: none, executable_path: none, error: Option::Some(error.into()) }


fn probe_runtime_toolchains() -> RuntimeToolchainStatus:
    probe_runtime_toolchains_with_context(&RuntimeToolchainContext__default_())

fn probe_runtime_toolchains_with_context(context: &RuntimeToolchainContext) -> RuntimeToolchainStatus:
    RuntimeToolchainStatus { go: probe_simple_command("go", &["version"], parse_go_version), tinygo: probe_simple_command("tinygo", &["version"], parse_tinygo_version), cargo: probe_simple_command("cargo", &["--version"], parse_cargo_version), rustc: probe_simple_command("rustc", &["--version"], parse_rustc_version), wasm_bindgen: probe_simple_command("wasm-bindgen", &["--version"], parse_wasm_bindgen_version), cc: probe_simple_command("cc", &["--version"], parse_cc_version), python: probe_simple_command("python3", &["--version"], parse_python_version), kain: probe_kain_toolchain(context), node: probe_simple_command("node", &["--version"], parse_node_version), manifest_path: locate_pinned_toolchain_manifest(), kain_manifest_path: locate_pinned_kain_toolchain_manifest() }

fn locate_pinned_toolchain_manifest() -> Option<String>:
    let manifest_dir = std__env__var_("CARGO_MANIFEST_DIR").ok()?
    let candidate = Path__new_(&manifest_dir).join("../toolchains/go/toolchains.json")
    if candidate.exists():
        Option::Some(candidate.to_string_lossy().to_string())
    else:
        none

fn locate_pinned_kain_toolchain_manifest() -> Option<String>:
    let manifest_dir = std__env__var_("CARGO_MANIFEST_DIR").ok()?
    let candidate = Path__new_(&manifest_dir).join("../toolchains/kain/toolchains.json")
    if candidate.exists():
        Option::Some(candidate.to_string_lossy().to_string())
    else:
        none

fn resolve_kain_payload_root(context: &RuntimeToolchainContext) -> Option<std::path::PathBuf>:
    match std__env__var_("GREEBLEFS_KAIN_PAYLOAD_ROOT"):
        Ok(override_root) =>
            if !override_root.trim().is_empty():
                let candidate = PathBuf__from(override_root)
                if candidate.exists():
                    return Option::Some(candidate)
                ()
            ()
        _ =>
            ()
            ()
    match std__env__var_("CARGO_MANIFEST_DIR"):
        Ok(manifest_dir) =>
            let candidate = Path__new_(&manifest_dir).join("../toolchains/kain/payload")
            if candidate.exists():
                return Option::Some(candidate)
            ()
        _ =>
            ()
            ()
    match (*context).resource_dir:
        Some(resource_dir) =>
            let candidate = resource_dir.join("toolchains/kain")
            if candidate.exists():
                return Option::Some(candidate)
            ()
        _ =>
            ()
            ()
    none

fn probe_kain_toolchain(context: &RuntimeToolchainContext) -> ToolchainProbe:
    let payload_root = resolve_kain_payload_root(context)
    let mut candidates = Vec__new_()
    match std__env__var_("GREEBLEFS_KAIN_EXE"):
        Ok(override_executable) =>
            if !override_executable.trim().is_empty():
                candidates.push(PathBuf__from(override_executable))
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    match std__env__var_("KAIN_EXE"):
        Ok(override_executable) =>
            if !override_executable.trim().is_empty():
                candidates.push(PathBuf__from(override_executable))
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    match payload_root:
        Some(root) =>
            candidates.push(root.join("bin").join(kain_executable_name()))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match which__which("kain"):
        Ok(path_executable) =>
            candidates.push(path_executable)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let executable_path = candidates.into_iter().find(|candidate| candidate.exists())
    let Some(executable_path) = executable_path
    let mut command = Command__new_(&executable_path)
    command.arg("--version")
    ()
    apply_kain_payload_environment(&mut command, payload_root)
    ()
    let output = match command.output():
        Ok(output) => output
        Err(error) =>
            return ToolchainProbe__missing("kain", format!("failed to execute kain: {error}"))
    if !output.status.success():
        let stderr = String__from_utf8_lossy(&output.stderr)
        return ToolchainProbe { id: "kain".to_string(), installed: true, version: none, executable_path: Option::Some(executable_path.to_string_lossy().to_string()), error: Option::Some(format!("kain --version exited with status {}: {}", output.status, stderr.trim())) }
    let stdout = String__from_utf8_lossy(&output.stdout).to_string()
    let stderr = String__from_utf8_lossy(&output.stderr).to_string()
    let combined = if stdout.trim().is_empty():
        stderr
    else:
        stdout
    ToolchainProbe { id: "kain".to_string(), installed: true, version: parse_kain_version(&combined), executable_path: Option::Some(executable_path.to_string_lossy().to_string()), error: none }

fn apply_kain_payload_environment(command: &mut std::process::Command, payload_root: Option<&std::path::Path>):
    let Some(payload_root) = payload_root
    let stdlib_path = payload_root.join("stdlib")
    if stdlib_path.exists():
        command.env("KAIN_STDLIB_PATH", stdlib_path)
        ()
        ()
        ()
        ()
    let runtime_manifest_path = payload_root.join("runtime/native_runtime.toml")
    if runtime_manifest_path.exists():
        command.env("KAIN_RUNTIME_MANIFEST_PATH", runtime_manifest_path)
        ()
        ()
        ()
        ()
    let runtime_c_path = payload_root.join("runtime/kain_runtime.c")
    if runtime_c_path.exists():
        command.env("KAIN_RUNTIME_C_PATH", runtime_c_path)
        ()
        ()
        ()
        ()
    let mut path_entries = Vec__new_()
    let bin_dir = payload_root.join("bin")
    if bin_dir.exists():
        path_entries.push(bin_dir)
        ()
        ()
        ()
        ()
    let llvm_bin_dir = payload_root.join("toolchain/llvm/bin")
    if llvm_bin_dir.exists():
        path_entries.push(llvm_bin_dir)
        ()
        ()
        ()
        ()
    if path_entries.is_empty():
        return
    match std__env__var_os("PATH"):
        Some(existing_path) =>
            path_entries.extend(std__env__split_paths(&existing_path))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match std__env__join_paths(path_entries):
        Ok(joined_path) =>
            command.env("PATH", joined_path)
            ()
        _ => ()

fn kain_executable_name() -> String:
    if cfg!(target_os = "windows"):
        "kain.exe"
    else:
        "kain"

fn probe_simple_command(program: String, args: &Slice<String>, parse_version: fn(String) -> Option<String>) -> ToolchainProbe:
    let executable_path = which__which(program).ok().map(|path| path.to_string_lossy().to_string())
    let output = match Command__new_(program).args(args).output():
        Ok(output) => output
        Err(error) =>
            return ToolchainProbe__missing(program, format!("not found on PATH: {error}"))
    if !output.status.success():
        let stderr = String__from_utf8_lossy(&output.stderr)
        return ToolchainProbe { id: program.to_string(), installed: true, version: none, executable_path: executable_path, error: Option::Some(format!("{} {} exited with status {}: {}", program, args.join(" "), output.status, stderr.trim())) }
    let stdout = String__from_utf8_lossy(&output.stdout).to_string()
    let stderr = String__from_utf8_lossy(&output.stderr).to_string()
    let combined = if stdout.trim().is_empty():
        stderr
    else:
        stdout
    let version = parse_version(&combined)
    ToolchainProbe { id: program.to_string(), installed: true, version: version, executable_path: executable_path, error: none }

fn parse_go_version(output: String) -> Option<String>:
    output.split_whitespace().find(|token| token.starts_with("go1.") or token.starts_with("go2.")).map(|token| token.trim_start_matches("go").to_string())

fn parse_tinygo_version(output: String) -> Option<String>:
    let trimmed = output.trim()
    let mut iterator = trimmed.split_whitespace()
    loop:
        match iterator.next():
            Some(token) =>
                if token == "version":
                    return iterator.next().map(|raw| raw.to_string())
            _ => break
    ()
    none

fn parse_python_version(output: String) -> Option<String>:
    output.split_whitespace().find(|token| token.chars().next().map(|c| c.is_ascii_digit()).unwrap_or(false)).map(|token| token.to_string())

fn parse_node_version(output: String) -> Option<String>:
    output.split_whitespace().find_map(|token| token.strip_prefix("v").or_(Option::Some(token))).map(|token| token.to_string()).filter(|token| !token.is_empty())

fn parse_cargo_version(output: String) -> Option<String>:
    output.split_whitespace().find(|token| token.chars().next().is_some_and(|character| character.is_ascii_digit())).map(|token| token.to_string())

fn parse_rustc_version(output: String) -> Option<String>:
    parse_cargo_version(output)

fn parse_cc_version(output: String) -> Option<String>:
    output.lines().next().map(|line| line_.trim().to_string()).filter(|line| !line_.is_empty())

fn parse_wasm_bindgen_version(output: String) -> Option<String>:
    parse_cargo_version(output)

fn parse_kain_version(output: String) -> Option<String>:
    output.split_whitespace().skip_while(|token| *token != "kain" and *token != "Version:").nth(1).map(|token| token.to_string()).or_else(|| parse_cargo_version(output))

struct ExternalRuntimeTuiLaunch:
    runtime_id: String
    command: String
    args: Array<String>
    working_directory: String
    label: String
    treat_zero_exit_as_success: Bool

fn build_tui_launch(manifest: &RuntimeManifest, binary_path: String) -> Result<ExternalRuntimeTuiLaunch, String>:
    if !matches!((*manifest).kind, RuntimeKind::NativeTui):
        return Result::Err(format!("runtime {} is not a native-tui (kind = {})", (*manifest).id, (*manifest).kind.as_str()))
    let label = (*manifest).tui.and_then(|cfg| cfg.label.clone()).unwrap_or_else(|| (*manifest).display_name.clone())
    let treat_zero_exit_as_success = (*manifest).tui.map(|cfg| cfg.treat_zero_exit_as_success).unwrap_or(true)
    let working_directory = (*manifest).working_directory.clone().unwrap_or_else(|| (*manifest).module_dir.clone())
    Result::Ok(ExternalRuntimeTuiLaunch { runtime_id: (*manifest).id.clone(), command: binary_path, args: (*manifest).args.clone(), working_directory: working_directory, label: label, treat_zero_exit_as_success: treat_zero_exit_as_success })

struct SavedScreenshot:
    path: String
    file_name: String
    created_at: u128

struct ScreenshotRegion:
    x: u32
    y: u32
    width: u32
    height: u32

struct ScreenshotStage:
    path: String
    image_width: u32
    image_height: u32

fn screenshot_prepare_image_stage(app: tauri::AppHandle, path: String, crop: Option<ScreenshotRegion>) -> Result<ScreenshotStage, String>:
    let source_path = PathBuf__from(&path)
    if !source_path.exists():
        return Result::Err(format!("Screenshot source '{}' does not exist.", source_path.display()))
    let stage_root = resolve_screenshot_stage_root(&app)?
    let stage_path = create_screenshot_stage_path(&stage_root, &source_path)?
    match crop:
        Some(region) =>
            validate_capture_region(region.width, region.height)?
            ()
            let source_image = read_image_from_disk(&source_path)?
            validate_crop_region(&source_image, region.x, region.y, region.width, region.height)?
            ()
            let cropped = image__imageops__crop_imm(&source_image, region.x, region.y, region.width, region.height).to_image()
            cropped.save(&stage_path).map_err(|error| format!("Failed to write cropped screenshot stage '{}': {error}", stage_path.display()))?
            ()
            return Result::Ok(ScreenshotStage { path: stage_path.to_string_lossy().into_owned(), image_width: cropped.width(), image_height: cropped.height() })
        _ =>
            ()
            ()
    std__fs__copy(&source_path, &stage_path).map_err(|error| format!("Failed to copy screenshot stage from '{}' to '{}': {error}", source_path.display(), stage_path.display()))?
    ()
    let (image_width, image_height) = image__image_dimensions(&source_path).map_err(|error| format!("Failed to measure screenshot stage source '{}': {error}", source_path.display()))?
    Result::Ok(ScreenshotStage { path: stage_path.to_string_lossy().into_owned(), image_width: image_width, image_height: image_height })

fn screenshot_finalize_image(path: String, directory: String, file_prefix: Option<String>, copy_to_clipboard: Option<Bool>) -> Result<SavedScreenshot, String>:
    let source_path = PathBuf__from(&path)
    if !source_path.exists():
        return Result::Err(format!("Screenshot stage '{}' does not exist.", source_path.display()))
    let created_at = current_timestamp_millis()?
    let prefix = sanitize_file_prefix(file_prefix)
    let file_extension = sanitize_file_extension(source_path.extension().and_then(|value| value.to_str()).unwrap_or("png"))
    let output_directory = PathBuf__from(&directory)
    std__fs__create_dir_all(&output_directory).map_err(|error| format!("Failed to create screenshot output directory '{}': {error}", output_directory.display()))?
    ()
    let file_name = format!("{prefix}-{created_at}.{file_extension}")
    let output_path = output_directory.join(&file_name)
    std__fs__copy(&source_path, &output_path).map_err(|error| format!("Failed to finalize screenshot from '{}' to '{}': {error}", source_path.display(), output_path.display()))?
    ()
    if copy_to_clipboard.unwrap_or(false):
        let image = read_image_from_disk(&source_path)?
        copy_rgba_image_to_clipboard(image)?
        ()
        ()
        ()
        ()
    Result::Ok(SavedScreenshot { path: output_path.to_string_lossy().into_owned(), file_name: file_name, created_at: created_at })

fn screenshot_copy_image_to_clipboard(path: String) -> Result<(), String>:
    let image = read_image_from_disk(Path__new_(&path))?
    copy_rgba_image_to_clipboard(image)

fn screenshot_delete_image_stage(app: tauri::AppHandle, path: String) -> Result<(), String>:
    let stage_root = resolve_screenshot_stage_root(&app)?
    let candidate_path = PathBuf__from(&path)
    if !candidate_path.exists():
        return Result::Ok(())
    let canonical_stage_root = stage_root.canonicalize().map_err(|error| format!("Failed to resolve screenshot stage directory '{}': {error}", stage_root.display()))?
    let canonical_candidate = candidate_path.canonicalize().map_err(|error| format!("Failed to resolve screenshot stage path '{}': {error}", candidate_path.display()))?
    if !canonical_candidate.starts_with(&canonical_stage_root):
        return Result::Err(format!("Refusing to delete screenshot stage outside '{}'.", canonical_stage_root.display()))
    std__fs__remove_file(&canonical_candidate).map_err(|error| format!("Failed to delete screenshot stage '{}': {error}", canonical_candidate.display()))?
    ()
    Result::Ok(())

fn resolve_screenshot_stage_root(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let root = app.path().app_local_data_dir().map(|path| path.join(SCREENSHOT_STAGE_DIR)).map_err(|error| format!("Failed to resolve app local data directory: {error}"))?
    std__fs__create_dir_all(&root).map_err(|error| format!("Failed to create screenshot stage directory '{}': {error}", root.display()))?
    ()
    Result::Ok(root)

fn create_screenshot_stage_path(stage_root: &std::path::Path, source_path: &std::path::Path) -> Result<std::path::PathBuf, String>:
    let created_at = current_timestamp_millis()?
    let sequence = SCREENSHOT_STAGE_SEQUENCE.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
    let file_stem = sanitize_file_stem(source_path.file_stem().and_then(|value| value.to_str()).unwrap_or("capture"))
    let file_extension = sanitize_file_extension(source_path.extension().and_then(|value| value.to_str()).unwrap_or("png"))
    Result::Ok(stage_root.join(format!("{file_stem}-{created_at}-{sequence}.{file_extension}")))

fn read_image_from_disk(path: &std::path::Path) -> Result<image::RgbaImage, String>:
    (ImageReader__open(path).map_err(|error| format!("Failed to open screenshot '{}': {error}", path.display()))?).decode().map_err(|error| format!("Failed to decode screenshot '{}': {error}", path.display())).map(|image| image.to_rgba8())

fn copy_rgba_image_to_clipboard(image: image::RgbaImage) -> Result<(), String>:
    let image_width = image.width() as usize
    let image_height = image.height() as usize
    let image_data = image.into_raw()
    let clipboard_image = arboard::ImageData { width: image_width, height: image_height, bytes: std::borrow::Cow::Owned(image_data) }
    let mut clipboard = Clipboard__new_().map_err(|error| format!("Failed to access system clipboard: {error}"))?
    clipboard.set_image(clipboard_image).map_err(|error| format!("Failed to copy screenshot image to clipboard: {error}"))

fn validate_capture_region(width: u32, height: u32) -> Result<(), String>:
    if width == 0 or height == 0:
        return Result::Err("Capture region must be at least 1 pixel wide and tall.".to_string())
    if width > 16384 or height > 16384:
        return Result::Err("Capture region is too large.".to_string())
    Result::Ok(())

fn validate_crop_region(image: &image::RgbaImage, x: u32, y: u32, width: u32, height: u32) -> Result<(), String>:
    let image_width = image.width()
    let image_height = image.height()
    if x >= image_width or y >= image_height:
        return Result::Err(format!("Selection origin falls outside the captured image bounds (image: {}x{}, requested origin: {}, {}).", image_width, image_height, x, y))
    let right = x.checked_add(width).ok_or_else(|| "Selection overflowed the captured image bounds while computing crop width.".to_string())?
    let bottom = y.checked_add(height).ok_or_else(|| "Selection overflowed the captured image bounds while computing crop height.".to_string())?
    if right > image_width or bottom > image_height:
        return Result::Err(format!("Selection falls outside the captured image bounds (image: {}x{}, requested crop: {}, {} size: {}x{}).", image_width, image_height, x, y, width, height))
    Result::Ok(())

fn current_timestamp_millis() -> Result<u128, String>:
    Result::Ok((SystemTime__now().duration_since(std__time__UNIX_EPOCH).map_err(|error| format!("Failed to measure current time: {error}"))?).as_millis())

fn sanitize_file_prefix(prefix: Option<String>) -> String:
    let sanitized = prefix.map(|value| sanitize_token(value, "overlayterm-shot")).unwrap_or_else(|| "overlayterm-shot".to_string())
    if sanitized.is_empty():
        "overlayterm-shot".to_string()
    else:
        sanitized

fn sanitize_file_stem(value: String) -> String:
    let sanitized = sanitize_token(value, "capture")
    if sanitized.is_empty():
        "capture".to_string()
    else:
        sanitized

fn sanitize_file_extension(value: String) -> String:
    let filtered: String = value.chars().filter(|character| character.is_ascii_alphanumeric()).collect().to_ascii_lowercase()
    if filtered.is_empty():
        "png".to_string()
    else:
        filtered

fn sanitize_token(value: String, fallback: String) -> String:
    let sanitized = value.chars().map(
        |character| if character.is_ascii_alphanumeric():
            character.to_ascii_lowercase()
        else if character == "-" or character == "_":
            character
        else:
            "-"
    ).collect().split("-").filter(|segment| !segment.is_empty()).collect().join("-")
    if sanitized.is_empty():
        fallback.to_string()
    else:
        sanitized

enum SecondaryWindowSurfaceKind:
    ExplorerPicker
    FileOperations
    Panel
    PluginPanel
    ActionWidget
    Lookdev

enum SecondaryWindowPresentation:
    FramelessWidget
    ToolWindow

struct SecondaryWindowSize:
    width: u32
    height: u32

struct SecondaryWindowDockTarget:
    surface_id: String
    restore_placement: Option<String>

struct SecondaryWindowOpenRequest:
    window_id: String
    surface_kind: SecondaryWindowSurfaceKind
    presentation: SecondaryWindowPresentation
    title: String
    initial_size: Option<SecondaryWindowSize>
    min_size: Option<SecondaryWindowSize>
    source_window_label: Option<String>
    dock_target: Option<SecondaryWindowDockTarget>
    payload_json: Option<String>

struct SecondaryWindowDescriptor:
    window_id: String
    window_label: String
    surface_kind: SecondaryWindowSurfaceKind
    presentation: SecondaryWindowPresentation
    title: String
    initial_size: SecondaryWindowSize
    min_size: SecondaryWindowSize
    remember_bounds: Bool
    source_window_label: Option<String>
    dock_target: Option<SecondaryWindowDockTarget>
    payload_json: Option<String>

enum SecondaryWindowClosedReason:
    Closed
    OpenFailed
    StaleDescriptor

struct SecondaryWindowDragSessionRequest:
    source_window_id: String
    source_window_label: Option<String>
    surface_id: Option<String>
    payload_json: Option<String>

struct SecondaryWindowClosedEvent:
    window_id: String
    window_label: String
    close_reason: SecondaryWindowClosedReason
    descriptor: SecondaryWindowDescriptor

struct SecondaryWindowDockBackEvent:
    window_id: String
    window_label: String
    dock_target: SecondaryWindowDockTarget
    descriptor: SecondaryWindowDescriptor

struct SecondaryWindowManagerState:
    descriptors_by_window_id: Map<String, SecondaryWindowDescriptor>
    pending_window_labels: Set<String>
    suppressed_closed_window_ids: Set<String>
    active_drag_session: Option<SecondaryWindowDragSessionRequest>

impl Default for SecondaryWindowManagerState:
    fn default_() -> SecondaryWindowManagerState:
        SecondaryWindowManagerState { descriptors_by_window_id: HashMap__new_(), pending_window_labels: HashSet__new_(), suppressed_closed_window_ids: HashSet__new_(), active_drag_session: none }


struct SecondaryWindowPolicy:
    initial_size: SecondaryWindowSize
    min_size: SecondaryWindowSize
    skip_taskbar: Bool
    transparent: Bool
    always_on_top: Bool
    remember_bounds: Bool

fn secondary_window_open(app: tauri::AppHandle, state: tauri::State<_, SecondaryWindowManagerState>, request: SecondaryWindowOpenRequest) -> Result<SecondaryWindowDescriptor, String>:
    let descriptor = normalize_secondary_window_descriptor(request)?
    state.store_descriptor(descriptor.clone())
    ()
    let existing_window = app.get_webview_window(&descriptor.window_label).is_some()
    if existing_window:
        schedule_secondary_window_activation(&app, descriptor.window_label.clone())?
        ()
        ()
        ()
        ()
    else if state.mark_window_label_pending(&descriptor.window_label):
        match schedule_secondary_window_launch(&app, descriptor.window_label.clone()):
            Err(error) =>
                state.clear_pending_window_label(&descriptor.window_label)
                ()
                state.remove_descriptor_by_window_label(&descriptor.window_label)
                ()
                return Result::Err(error)
            _ =>
                ()
                ()
        ()
    emit_optional_event(&app, SECONDARY_WINDOW_DESCRIPTOR_EVENT, descriptor.clone())
    ()
    Result::Ok(descriptor)

fn secondary_window_focus(app: tauri::AppHandle, window_id: String) -> Result<(), String>:
    let descriptor = resolve_descriptor_for_window_id(&app, &window_id)?
    let state = app.state()
    let Some(window) = app.get_webview_window(&descriptor.window_label)
    window.show().map_err(|error| format!("failed to show secondary window: {error}"))?
    ()
    match window.set_focus():
        Err(error) =>
            warn!("failed to focus secondary window {}: {error}", descriptor.window_label)
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn secondary_window_close(app: tauri::AppHandle, window_id: String) -> Result<(), String>:
    let Ok(descriptor) = resolve_descriptor_for_window_id(&app, &window_id)
    let Some(window) = app.get_webview_window(&descriptor.window_label)
    window.close().map_err(|error| format!("failed to close secondary window {}: {error}", descriptor.window_id))?
    ()
    Result::Ok(())

fn secondary_window_dock_back(app: tauri::AppHandle, state: tauri::State<_, SecondaryWindowManagerState>, window_id: String) -> Result<(), String>:
    let descriptor = resolve_descriptor_for_window_id(&app, &window_id)?
    let dock_target = descriptor.dock_target.clone().filter(|target| !target.surface_id.trim().is_empty()).ok_or_else(|| "secondary window is not dock-back capable".to_string())?
    match descriptor.surface_kind:
        SecondaryWindowSurfaceKind::Panel | SecondaryWindowSurfaceKind::PluginPanel =>
            ()
        _ => return Result::Err("secondary window is not dock-back capable".to_string())
    state.suppress_closed_event(&descriptor.window_id)
    ()
    state.remove_descriptor(&descriptor.window_id)
    ()
    state.clear_pending_window_label(&descriptor.window_label)
    ()
    emit_optional_event(&app, SECONDARY_WINDOW_DOCK_BACK_EVENT, SecondaryWindowDockBackEvent { window_id: descriptor.window_id.clone(), window_label: descriptor.window_label.clone(), dock_target: dock_target, descriptor: descriptor.clone() })
    ()
    match app.get_webview_window(&descriptor.window_label):
        Some(window) =>
            window.close().map_err(|error| format!("failed to close dock-back window: {error}"))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn secondary_window_begin_drag_session(state: tauri::State<_, SecondaryWindowManagerState>, request: SecondaryWindowDragSessionRequest) -> SecondaryWindowDragSessionRequest:
    state.set_drag_session(request.clone())
    ()
    request

fn secondary_window_complete_drag_session(state: tauri::State<_, SecondaryWindowManagerState>, window_id: String) -> Option<SecondaryWindowDragSessionRequest>:
    state.take_drag_session_matching_window_id(&window_id)

fn secondary_window_get_current_descriptor(window: tauri::WebviewWindow, state: tauri::State<_, SecondaryWindowManagerState>) -> Option<SecondaryWindowDescriptor>:
    state.find_descriptor_by_window_label(window.label())

fn secondary_window_list_descriptors(state: tauri::State<_, SecondaryWindowManagerState>) -> Array<SecondaryWindowDescriptor>:
    state.list_descriptors()

impl SecondaryWindowManagerState:
    fn store_descriptor(_self: &SecondaryWindowManagerState, descriptor: SecondaryWindowDescriptor):
        let mut descriptors_by_window_id = (*_self).descriptors_by_window_id.lock().expect("secondary window descriptor registry poisoned")
        descriptors_by_window_id.retain(|_, existing_descriptor| existing_descriptor.window_label != descriptor.window_label)
        ()
        descriptors_by_window_id.insert(descriptor.window_id.clone(), descriptor)
        ()

    fn mark_window_label_pending(_self: &SecondaryWindowManagerState, window_label: String) -> Bool:
        (*_self).pending_window_labels.lock().expect("secondary window pending registry poisoned").insert(window_label.to_string())

    fn clear_pending_window_label(_self: &SecondaryWindowManagerState, window_label: String):
        (*_self).pending_window_labels.lock().expect("secondary window pending registry poisoned").remove(window_label)
        ()

    fn is_window_label_pending(_self: &SecondaryWindowManagerState, window_label: String) -> Bool:
        (*_self).pending_window_labels.lock().expect("secondary window pending registry poisoned").contains(window_label)

    fn remove_descriptor(_self: &SecondaryWindowManagerState, window_id: String) -> Option<SecondaryWindowDescriptor>:
        (*_self).descriptors_by_window_id.lock().expect("secondary window descriptor registry poisoned").remove(window_id)

    fn remove_descriptor_by_window_label(_self: &SecondaryWindowManagerState, window_label: String) -> Option<SecondaryWindowDescriptor>:
        let mut descriptors_by_window_id = (*_self).descriptors_by_window_id.lock().expect("secondary window descriptor registry poisoned")
        let matching_window_ids = descriptors_by_window_id.iter().filter_map(|__kain_closure_arg0| (__kain_closure_arg0.__kain_tuple_1.window_label == window_label).then(|| __kain_closure_arg0.__kain_tuple_0.clone())).collect()
        let mut removed_descriptor = none
        for window_id in matching_window_ids:
            removed_descriptor = descriptors_by_window_id.remove(&window_id)
            ()
        ()
        removed_descriptor

    fn list_descriptors(_self: &SecondaryWindowManagerState) -> Array<SecondaryWindowDescriptor>:
        (*_self).descriptors_by_window_id.lock().expect("secondary window descriptor registry poisoned").values().cloned().collect()

    fn find_descriptor_by_window_id(_self: &SecondaryWindowManagerState, window_id: String) -> Option<SecondaryWindowDescriptor>:
        (*_self).descriptors_by_window_id.lock().expect("secondary window descriptor registry poisoned").get(window_id).cloned()

    fn find_descriptor_by_window_label(_self: &SecondaryWindowManagerState, window_label: String) -> Option<SecondaryWindowDescriptor>:
        (*_self).descriptors_by_window_id.lock().expect("secondary window descriptor registry poisoned").values().find(|descriptor| descriptor.window_label == window_label).cloned()

    fn suppress_closed_event(_self: &SecondaryWindowManagerState, window_id: String):
        (*_self).suppressed_closed_window_ids.lock().expect("secondary window suppression registry poisoned").insert(window_id.to_string())
        ()

    fn should_emit_closed_event(_self: &SecondaryWindowManagerState, window_id: String) -> Bool:
        !(*_self).suppressed_closed_window_ids.lock().expect("secondary window suppression registry poisoned").remove(window_id)

    fn set_drag_session(_self: &SecondaryWindowManagerState, request: SecondaryWindowDragSessionRequest):
        *(*_self).active_drag_session.lock().expect("secondary window drag session registry poisoned") = Option::Some(request)
        ()

    fn take_drag_session_matching_window_id(_self: &SecondaryWindowManagerState, window_id: String) -> Option<SecondaryWindowDragSessionRequest>:
        let mut guard = (*_self).active_drag_session.lock().expect("secondary window drag session registry poisoned")
        if guard.is_some_and(|session| session.source_window_id == window_id):
            return guard.take()
        none


fn normalize_secondary_window_descriptor(request: SecondaryWindowOpenRequest) -> Result<SecondaryWindowDescriptor, String>:
    let trimmed_window_id = request.window_id.trim()
    if trimmed_window_id.is_empty():
        return Result::Err("secondary window id is required".to_string())
    let title = request.title.trim()
    if title.is_empty():
        return Result::Err("secondary window title is required".to_string())
    let sanitized_window_id = sanitize_secondary_window_id(trimmed_window_id)
    if sanitized_window_id.is_empty():
        return Result::Err("secondary window id must contain at least one ASCII letter or digit".to_string())
    let policy = resolve_secondary_window_policy(&request.surface_kind, &request.presentation, request.initial_size, request.min_size)
    let window_label = resolve_secondary_window_label(&sanitized_window_id, &request.surface_kind)
    Result::Ok(SecondaryWindowDescriptor { window_id: trimmed_window_id.to_string(), window_label: window_label, surface_kind: request.surface_kind, presentation: request.presentation, title: title.to_string(), initial_size: policy.initial_size, min_size: policy.min_size, remember_bounds: policy.remember_bounds, source_window_label: request.source_window_label.and_then(|value| trim_to_option(&value)), dock_target: request.dock_target.and_then(normalize_dock_target), payload_json: request.payload_json })

fn build_secondary_window(app: &tauri::AppHandle, descriptor: &SecondaryWindowDescriptor) -> Result<tauri::WebviewWindow, String>:
    let policy = resolve_secondary_window_policy(&(*descriptor).surface_kind, &(*descriptor).presentation, Option::Some((*descriptor).initial_size), Option::Some((*descriptor).min_size))
    let window = WebviewWindowBuilder__new_(app, &(*descriptor).window_label, tauri::WebviewUrl::App("index.html".into())).title(&(*descriptor).title).inner_size((*descriptor).initial_size.width as f64, (*descriptor).initial_size.height as f64).min_inner_size((*descriptor).min_size.width as f64, (*descriptor).min_size.height as f64).visible(false).focused(true).focusable(true).decorations(false).transparent(policy.transparent).always_on_top(policy.always_on_top).skip_taskbar(policy.skip_taskbar).shadow(false).resizable(true).build().map_err(|error| format!("failed to build secondary window: {error}"))?
    let app_handle = app.clone()
    let descriptor_window_label = (*descriptor).window_label.clone()
    let descriptor_for_event = descriptor.clone()
    window.on_window_event(
        |event| block:
            if !matches!(event, tauri::WindowEvent::Destroyed):
                return
            let state = app_handle.state()
            state.clear_pending_window_label(&descriptor_window_label)
            ()
            let removed_descriptor = state.remove_descriptor_by_window_label(&descriptor_window_label).unwrap_or_else(|| descriptor_for_event.clone())
            if !state.should_emit_closed_event(&removed_descriptor.window_id):
                return
            emit_secondary_window_closed_event(&app_handle, removed_descriptor, SecondaryWindowClosedReason::Closed)
            ()
    )
    ()
    Result::Ok(window)

fn schedule_secondary_window_launch(app: &tauri::AppHandle, window_label: String) -> Result<(), String>:
    let app_handle = app.clone()
    Builder__new_().name("greeblefs-secondary-window-launch".to_string()).spawn_(
        || block:
            std__thread__sleep(Duration__from_millis(SECONDARY_WINDOW_MAIN_THREAD_DEFER_MS))
            ()
            let app_for_error = app_handle.clone()
            let app_for_main_thread = app_handle.clone()
            let window_label_for_error = window_label.clone()
            match app_handle.run_on_main_thread(
                || block:
                    let state = app_for_main_thread.state()
                    let Some(descriptor) = state.find_descriptor_by_window_label(&window_label)
                    let result = open_or_focus_secondary_window_on_main_thread(&app_for_main_thread, &state, &descriptor)
                    state.clear_pending_window_label(&window_label)
                    ()
                    match result:
                        Err(error) =>
                            warn!("failed to open secondary window {}: {error}", descriptor.window_label)
                            let removed_descriptor = state.remove_descriptor_by_window_label(&descriptor.window_label).unwrap_or_else(|| descriptor.clone())
                            emit_secondary_window_closed_event(&app_for_main_thread, removed_descriptor, SecondaryWindowClosedReason::OpenFailed)
                            ()
                        _ => ()
            ):
                Err(error) =>
                    warn!("failed to schedule secondary window launch on main thread: {error}")
                    let state = app_for_error.state()
                    state.clear_pending_window_label(&window_label_for_error)
                    ()
                    match state.remove_descriptor_by_window_label(&window_label_for_error):
                        Some(removed_descriptor) =>
                            emit_secondary_window_closed_event(&app_for_error, removed_descriptor, SecondaryWindowClosedReason::OpenFailed)
                            ()
                        _ => ()
                _ => ()
    ).map(|_| ()).map_err(|error| format!("failed to spawn secondary window launcher: {error}"))

fn schedule_secondary_window_activation(app: &tauri::AppHandle, window_label: String) -> Result<(), String>:
    let app_handle = app.clone()
    Builder__new_().name("greeblefs-secondary-window-activation".to_string()).spawn_(
        || block:
            std__thread__sleep(Duration__from_millis(SECONDARY_WINDOW_MAIN_THREAD_DEFER_MS))
            ()
            let app_for_main_thread = app_handle.clone()
            match app_handle.run_on_main_thread(
                || block:
                    let state = app_for_main_thread.state()
                    let Some(descriptor) = state.find_descriptor_by_window_label(&window_label)
                    match open_or_focus_secondary_window_on_main_thread(&app_for_main_thread, &state, &descriptor):
                        Err(error) =>
                            warn!("failed to activate secondary window {}: {error}", descriptor.window_label)
                            let removed_descriptor = state.remove_descriptor_by_window_label(&descriptor.window_label).unwrap_or_else(|| descriptor.clone())
                            emit_secondary_window_closed_event(&app_for_main_thread, removed_descriptor, SecondaryWindowClosedReason::StaleDescriptor)
                            ()
                        _ => ()
            ):
                Err(error) =>
                    warn!("failed to schedule secondary window activation on main thread: {error}")
                _ => ()
    ).map(|_| ()).map_err(|error| format!("failed to spawn secondary window activator: {error}"))

fn open_or_focus_secondary_window_on_main_thread(app: &tauri::AppHandle, state: &SecondaryWindowManagerState, descriptor: &SecondaryWindowDescriptor) -> Result<(), String>:
    let window = match app.get_webview_window(&(*descriptor).window_label):
        Some(existing_window) =>
            existing_window
        _ =>
            build_secondary_window(app, descriptor)?
    match window.set_title(&(*descriptor).title):
        Err(error) =>
            warn!("failed to set secondary window title for {}: {error}", (*descriptor).window_label)
            ()
            ()
        _ =>
            ()
            ()
    match window.show():
        Err(error) =>
            state.suppress_closed_event(&(*descriptor).window_id)
            ()
            let _ = window.close()
            return Result::Err(format!("failed to show secondary window: {error}"))
        _ =>
            ()
            ()
    match window.set_focus():
        Err(error) =>
            warn!("failed to focus secondary window {} after open: {error}", (*descriptor).window_label)
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn resolve_secondary_window_policy(surface_kind: &SecondaryWindowSurfaceKind, presentation: &SecondaryWindowPresentation, requested_initial_size: Option<SecondaryWindowSize>, requested_min_size: Option<SecondaryWindowSize>) -> SecondaryWindowPolicy:
    let defaults = match surface_kind:
        SecondaryWindowSurfaceKind::ExplorerPicker => SecondaryWindowPolicy { initial_size: SecondaryWindowSize { width: 760, height: 520 }, min_size: SecondaryWindowSize { width: 520, height: 360 }, skip_taskbar: true, transparent: false, always_on_top: false, remember_bounds: false }
        SecondaryWindowSurfaceKind::FileOperations => SecondaryWindowPolicy { initial_size: SecondaryWindowSize { width: 880, height: 620 }, min_size: SecondaryWindowSize { width: 640, height: 420 }, skip_taskbar: true, transparent: false, always_on_top: false, remember_bounds: true }
        SecondaryWindowSurfaceKind::Panel | SecondaryWindowSurfaceKind::PluginPanel =>
            SecondaryWindowPolicy { initial_size: SecondaryWindowSize { width: 1040, height: 760 }, min_size: SecondaryWindowSize { width: 720, height: 480 }, skip_taskbar: matches!(presentation, SecondaryWindowPresentation::FramelessWidget), transparent: false, always_on_top: false, remember_bounds: true }
        SecondaryWindowSurfaceKind::ActionWidget => SecondaryWindowPolicy { initial_size: SecondaryWindowSize { width: 440, height: 340 }, min_size: SecondaryWindowSize { width: 320, height: 220 }, skip_taskbar: true, transparent: true, always_on_top: true, remember_bounds: false }
        SecondaryWindowSurfaceKind::Lookdev => SecondaryWindowPolicy { initial_size: SecondaryWindowSize { width: 1240, height: 860 }, min_size: SecondaryWindowSize { width: 760, height: 560 }, skip_taskbar: false, transparent: false, always_on_top: false, remember_bounds: true }
    let requested_min_size = requested_min_size.unwrap_or(defaults.min_size)
    let min_size = SecondaryWindowSize { width: requested_min_size.width.max(240), height: requested_min_size.height.max(180) }
    let requested_initial_size = requested_initial_size.unwrap_or(defaults.initial_size)
    let initial_size = SecondaryWindowSize { width: requested_initial_size.width.max(min_size.width), height: requested_initial_size.height.max(min_size.height) }
    SecondaryWindowPolicy { initial_size: initial_size, min_size: min_size, ..defaults }

fn resolve_secondary_window_label(sanitized_window_id: String, surface_kind: &SecondaryWindowSurfaceKind) -> String:
    match sanitized_window_id:
        EXPLORER_PICKER_WINDOW_ID => EXPLORER_PICKER_WINDOW_LABEL.to_string()
        FILE_OPERATIONS_WINDOW_ID => FILE_OPERATIONS_WINDOW_LABEL.to_string()
        _ =>
            let prefix = match surface_kind:
                SecondaryWindowSurfaceKind::Panel => SECONDARY_PANEL_WINDOW_LABEL_PREFIX
                SecondaryWindowSurfaceKind::PluginPanel =>
                    SECONDARY_PLUGIN_PANEL_WINDOW_LABEL_PREFIX
                SecondaryWindowSurfaceKind::ActionWidget =>
                    SECONDARY_ACTION_WIDGET_WINDOW_LABEL_PREFIX
                SecondaryWindowSurfaceKind::Lookdev => SECONDARY_LOOKDEV_WINDOW_LABEL_PREFIX
                _ => SECONDARY_WINDOW_LABEL_PREFIX
            format!("{prefix}{sanitized_window_id}")

fn normalize_dock_target(value: SecondaryWindowDockTarget) -> Option<SecondaryWindowDockTarget>:
    let surface_id = value.surface_id.trim()
    if surface_id.is_empty():
        return none
    Option::Some(SecondaryWindowDockTarget { surface_id: surface_id.to_string(), restore_placement: value.restore_placement.and_then(trim_to_option) })

fn sanitize_secondary_window_id(value: String) -> String:
    let mut normalized = |__kain_ctor_arg0| String::new()(value.len())
    let mut last_was_dash = false
    for character in value.chars():
        let normalized_character = character.to_ascii_lowercase()
        if normalized_character.is_ascii_alphanumeric():
            normalized.push(normalized_character)
            ()
            last_was_dash = false
            ()
            continue
        if !last_was_dash:
            normalized.push("-")
            ()
            last_was_dash = true
            ()
    ()
    normalized.trim_matches("-").to_string()

fn trim_to_option(value: String) -> Option<String>:
    let trimmed = value.trim()
    (!trimmed.is_empty()).then(|| trimmed.to_string())

fn resolve_descriptor_for_window_id(app: &tauri::AppHandle, window_id: String) -> Result<SecondaryWindowDescriptor, String>:
    let state = app.state()
    state.find_descriptor_by_window_id(window_id).ok_or_else(|| format!("secondary window descriptor not found: {window_id}"))

fn emit_optional_event(app: &tauri::AppHandle, event: String, payload: T):
    let _ = app.emit_(event, payload)

fn emit_secondary_window_closed_event(app: &tauri::AppHandle, descriptor: SecondaryWindowDescriptor, close_reason: SecondaryWindowClosedReason):
    emit_optional_event(app, SECONDARY_WINDOW_CLOSED_EVENT, SecondaryWindowClosedEvent { window_id: descriptor.window_id.clone(), window_label: descriptor.window_label.clone(), close_reason: close_reason, descriptor: descriptor })
    ()

fn should_window_label_remember_bounds(label: String) -> Bool:
    let is_primary_shell_label = label == window_commands__MAIN_WINDOW_LABEL or label == wayland_dock__WAYLAND_DOCK_WINDOW_LABEL
    let is_primary_shell_label = label == "main" or label == "dock"
    is_primary_shell_label or label == FILE_OPERATIONS_WINDOW_LABEL or label.starts_with(SECONDARY_PANEL_WINDOW_LABEL_PREFIX) or label.starts_with(SECONDARY_PLUGIN_PANEL_WINDOW_LABEL_PREFIX) or label.starts_with(SECONDARY_LOOKDEV_WINDOW_LABEL_PREFIX)

