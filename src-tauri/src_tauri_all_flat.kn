                        let mut shell_integration_parser = TerminalShellIntegrationOutputParser__default_()
                        let mut hidden_host_command_echo_suppressor = TerminalHostCommandEchoSuppressor__default_()
                        loop:
                            match reader.read(&mut buffer):
                                Ok(0) => break
                                Ok(n) =>
                                    let parsed_chunk = shell_integration_parser.consume(&buffer[..n])
                                    let terminal_manager = app.state()
                                    hidden_host_command_echo_suppressor.enqueue_pending_command_echoes(terminal_manager.drain_hidden_host_command_echoes(&terminal_id))
                                    ()
                                    let visible_output = hidden_host_command_echo_suppressor.consume(&parsed_chunk.visible_output)
                                    if !visible_output.is_empty():
                                        match tauri__native_stream__publish_byte_stream(&app, &stream_handle.id, "terminal-output", &visible_output):
                                            Err(error) =>
                                                log::trace!("native terminal stream publish skipped for {}: {}", terminal_id, error)
                                                ()
                                                ()
                                            _ =>
                                                ()
                                                ()
                                        let data = String__from_utf8_lossy(&visible_output).to_string()
                                        let host_event_packet = match tauri__transport__publish_stream_payload(&app, &stream_handle.id, data.clone()):
                                            Ok((payload_2, outcome)) => TerminalOutputStreamPacket { terminal_id: terminal_id.clone(), metadata: to_ipc_stream_packet_metadata(outcome.metadata), data: data }
                                            Err(error) =>
                                                log::warn!("failed to publish terminal stream packet for {}: {}", terminal_id, error)
                                                continue
                                        publish_terminal_output_host_event(&app, &host_event_packet)
                                        ()
                                        ()
                                        ()
                                        ()
                                    for reported_cwd in parsed_chunk.reported_cwds:
                                        match terminal_manager.report_prompt_ready_cwd(&terminal_id, &reported_cwd):
                                            Ok(Some((state, applied_cwd))) =>
                                                emit_terminal_shell_integration_state_event(&app, terminal_id.clone(), state, applied_cwd)
                                                ()
                                            Ok(None) =>
                                                ()
                                            Err(error) =>
                                                log::warn!("failed to apply reported cwd for {}: {}", terminal_id, error)
                                Err(e) =>
                                    log::error!("Terminal read error: {}", e)
                                    break
                )
                ()
            _ => ()


fn terminal_shell_kind_from_executable(shell: String) -> TerminalShellKind:
    let executable = shell_executable_name(shell).to_ascii_lowercase()
    if executable.contains("pwsh") or executable.contains("powershell"):
        TerminalShellKind::PowerShell
    else if executable.ends_with("cmd") or executable.ends_with("cmd.exe"):
        TerminalShellKind::Cmd
    else if executable.ends_with("fish"):
        TerminalShellKind::Fish
    else if executable.ends_with("zsh"):
        TerminalShellKind::Zsh
    else if executable.ends_with("bash"):
        TerminalShellKind::Bash
    else:
        TerminalShellKind::Unknown

fn terminal_auto_cd_command(shell_kind: &TerminalShellKind, cwd: String) -> Option<String>:
    match shell_kind:
        TerminalShellKind::Cmd => Option::Some(format!("cd /d \"{}\"\r\n", cwd.replace("\"", "\"\"")))
        TerminalShellKind::PowerShell => Option::Some(format!("Set-Location -LiteralPath '{}'\r\n", cwd.replace("'", "''")))
        TerminalShellKind::Fish | TerminalShellKind::Zsh | TerminalShellKind::Bash =>
            Option::Some(format!("builtin cd -- {}\n", shell_quote_single(cwd)))
        TerminalShellKind::Unknown => Option::Some(format!("cd -- {}\n", shell_quote_single(cwd)))

fn terminal_shell_integration_bootstrap_command(shell_kind: &TerminalShellKind) -> Option<String>:
    match shell_kind:
        TerminalShellKind::Bash => Option::Some(concat!("__greeblefs_prompt_cwd(){ printf '\\033]633;GreebleFS;Cwd=%s\\a' \"$PWD\"; }; ", "case \";${PROMPT_COMMAND};\" in ", "*\";__greeblefs_prompt_cwd;\"*) ;; ", "*) PROMPT_COMMAND=\"__greeblefs_prompt_cwd${PROMPT_COMMAND:+;${PROMPT_COMMAND}}\" ;; ", "esac\n").to_string())
        TerminalShellKind::Zsh => Option::Some(concat!("__greeblefs_precmd(){ printf '\\033]633;GreebleFS;Cwd=%s\\a' \"$PWD\"; }; ", "typeset -ga precmd_functions; ", "(( ${precmd_functions[(Ie)__greeblefs_precmd]} )) || precmd_functions=(__greeblefs_precmd $precmd_functions)\n").to_string())
        TerminalShellKind::Fish => Option::Some(concat!("functions -q __greeblefs_original_fish_prompt; or functions -c fish_prompt __greeblefs_original_fish_prompt; ", "function fish_prompt; printf '\\e]633;GreebleFS;Cwd=%s\\a' \"$PWD\"; __greeblefs_original_fish_prompt; end\n").to_string())
        TerminalShellKind::PowerShell => Option::Some(concat!("if (-not (Test-Path function:__GreebleFSOriginalPrompt)) { Copy-Item function:prompt function:__GreebleFSOriginalPrompt -ErrorAction SilentlyContinue }; ", "function global:prompt { ", "$cwd = $executionContext.SessionState.Path.CurrentLocation.Path; ", "[Console]::Out.Write(\"`e]633;GreebleFS;Cwd=$cwd`a\"); ", "if (Test-Path function:__GreebleFSOriginalPrompt) { & __GreebleFSOriginalPrompt } else { \"PS $cwd> \" } ", "}\r\n").to_string())
        TerminalShellKind::Cmd => Option::Some(format!("prompt $E]633;GreebleFS;Cwd=$P{}$P$G\r\n", "\u{7}"))
        TerminalShellKind::Unknown => none

fn normalize_reported_terminal_cwd(_shell_kind: &TerminalShellKind, reported_cwd: String) -> String:
    let trimmed = reported_cwd.trim()
    if trimmed.is_empty():
        return String__new_()
    let supports_posix_windows_paths = matches!(shell_kind_2, TerminalShellKind::Bash | TerminalShellKind::Zsh | TerminalShellKind::Fish)
    if supports_posix_windows_paths:
        match convert_posix_windows_shell_path(trimmed):
            Some(converted) =>
                return converted
            _ =>
                ()
                ()
        ()
    match normalize_windows_drive_path(trimmed):
        Some(converted) =>
            return converted
        _ =>
            ()
            ()
    ()
    trimmed.to_string()

fn convert_posix_windows_shell_path(path: String) -> Option<String>:
    let stripped = path.strip_prefix("/")?
    let bytes = stripped.as_bytes()
    let drive_letter = (*bytes.first()?).to_ascii_uppercase()
    if !drive_letter.is_ascii_alphabetic():
        return none
    if bytes.len() == 1:
        return Option::Some(format!("{}:\\", drive_letter as Char))
    if bytes[1] != 47:
        return none
    let remainder = stripped[2..].replace("/", "\\")
    if remainder.is_empty():
        Option::Some(format!("{}:\\", drive_letter as Char))
    else:
        Option::Some(format!("{}:\\{}", drive_letter as Char, remainder))

fn normalize_windows_drive_path(path: String) -> Option<String>:
    let bytes = path.as_bytes()
    if bytes.len() < 2 or !bytes[0].is_ascii_alphabetic() or bytes[1] != 58:
        return none
    let drive_letter = bytes[0].to_ascii_uppercase() as Char
    if bytes.len() == 2:
        return Option::Some(format!("{}:\\", drive_letter))
    let remainder = path[2..].replace("/", "\\")
    if remainder.starts_with("\\"):
        Option::Some(format!("{}:{}", drive_letter, remainder))
    else:
        Option::Some(format!("{}:\\{}", drive_letter, remainder))

fn parse_shell_command(shell: String) -> (String, Array<String>):
    let trimmed = shell.trim()
    if trimmed.is_empty():
        return (String__new_(), Vec__new_())
    let mut tokens = Vec__new_()
    let mut current = String__new_()
    let mut active_quote: Option<Char> = none
    let mut chars = trimmed.chars()
    loop:
        match chars.next():
            Some(ch) =>
                match active_quote:
                    Some(quote) =>
                        if quote == "\"" and ch == "\\":
                            match chars.next():
                                Some(next) =>
                                    if next == "\"" or next == "\\":
                                        current.push(next)
                                        ()
                                        ()
                                        ()
                                        ()
                                    else:
                                        current.push("\\")
                                        ()
                                        current.push(next)
                                        ()
                                        ()
                                        ()
                                        ()
                                    ()
                                _ =>
                                    current.push("\\")
                                    ()
                                    ()
                                    ()
                                    ()
                            continue
                        if ch == quote:
                            active_quote = none
                            ()
                            continue
                        current.push(ch)
                        ()
                        continue
                    _ =>
                        ()
                        ()
                match ch:
                    "\"" | "'" =>
                        active_quote = Option::Some(ch)
                        ()
                    ch if ch.is_whitespace() =>
                        if !current.is_empty():
                            tokens.push(std__mem__take(&mut current))
                            ()
                    _ => current.push(ch)
            _ => break
    ()
    if !current.is_empty():
        tokens.push(current)
        ()
        ()
        ()
        ()
    let executable = tokens.first().cloned().unwrap_or_default()
    let args = tokens.into_iter().skip(1).collect()
    (executable, args)

fn shell_executable_name(shell: String) -> String:
    parse_shell_command(shell).field_0

fn command_looks_like_path(command: String) -> Bool:
    let command_path = Path__new_(command)
    command_path.components().count() > 1 or command_path.is_absolute()

fn command_exists(command: String) -> Bool:
    if command.trim().is_empty():
        return false
    let command_path = Path__new_(command)
    if command_looks_like_path(command):
        return command_path.exists()
    let path_env = match std__env__var_os("PATH"):
        Some(value) => value
        None => return false
    let extensions: Array<String> = std__env__var_("PATHEXT").unwrap_or_else(|_| ".EXE;.CMD;.BAT;.COM".to_string()).split(";").map(|value| value.trim().to_ascii_lowercase()).filter(|value| !value.is_empty()).collect()
    for dir in std__env__split_paths(&path_env):
        let direct = dir.join(command)
        if direct.exists():
            return true
        let has_extension = Path__new_(command).extension().is_some()
        if !has_extension:
            for ext in &extensions:
                let candidate = dir.join(format!("{}{}", command, ext))
                if candidate.exists():
                    return true
    ()
    false

fn normalize_working_dir(path: String) -> String:
    path.replace("/", "\\")
    ()
    ()
    path.to_string()

fn resolve_working_dir(path: String) -> Result<std::path::PathBuf, String>:
    let normalized = normalize_working_dir(path)
    let directory = PathBuf__from(normalized)
    if directory.exists():
        Result::Ok(directory)
    else:
        Result::Err(format!("Working directory does not exist: {}", path))

fn optional_args(args: &Option<Array<String>>) -> Array<String>:
    args.clone().unwrap_or_default()

fn applescript_escape(value: String) -> String:
    value.replace("\\", "\\\\").replace("\"", "\\\"")

fn shell_quote_single(value: String) -> String:
    format!("'{}'", value.replace("'", "'\\\"'\\\"'"))

fn app_exists(app_name: String) -> Bool:
    let candidates = [format!("/Applications/{}.app", app_name), format!("{}/Applications/{}.app", dirs__home_dir().unwrap_or_default().to_string_lossy(), app_name)]
    candidates.iter().any(|path| Path__new_(path).exists())

fn build_windows_external_command(request: &ExternalTerminalRequest, working_dir: &std::path::Path) -> Result<std::process::Command, String>:
    let requested_profile = (*request).profile.unwrap_or("auto")
    let resolved_profile = match requested_profile:
        "auto" =>
            if command_exists("wt.exe"):
                "windows-terminal"
            else if command_exists("pwsh.exe"):
                "pwsh"
            else:
                "powershell"
        other => other
    let user_args = optional_args(&(*request).args)
    let shell = (*request).shell.clone().filter(|value| !value.trim().is_empty()).unwrap_or_else(|| TerminalManager__get_shell(none).field_0)
    let working_dir_string = working_dir.to_string_lossy().to_string()
    let mut command = match resolved_profile:
        "windows-terminal" =>
            let executable = (*request).executable.clone().filter(|value| !value.trim().is_empty()).unwrap_or_else(|| "wt.exe".to_string())
            let mut command = Command__new_(executable)
            command.arg("-d").arg(&working_dir_string)
            ()
            command.arg(&shell)
            ()
            for arg in user_args:
                command.arg(arg)
                ()
            ()
            command
        "pwsh" =>
            let executable = (*request).executable.clone().filter(|value| !value.trim().is_empty()).unwrap_or_else(|| "pwsh.exe".to_string())
            let mut command = Command__new_(executable)
            if user_args.is_empty():
                command.arg("-NoLogo")
                ()
                ()
                ()
                ()
            else:
                for arg in user_args:
                    command.arg(arg)
                    ()
                ()
                ()
            command
        "powershell" =>
            let executable = (*request).executable.clone().filter(|value| !value.trim().is_empty()).unwrap_or_else(|| "powershell.exe".to_string())
            let mut command = Command__new_(executable)
            if user_args.is_empty():
                command.arg("-NoLogo").arg("-NoExit")
                ()
                ()
                ()
                ()
            else:
                for arg in user_args:
                    command.arg(arg)
                    ()
                ()
                ()
            command
        "cmd" =>
            let executable = (*request).executable.clone().filter(|value| !value.trim().is_empty()).unwrap_or_else(|| "cmd.exe".to_string())
            let mut command = Command__new_(executable)
            if user_args.is_empty():
                command.arg("/K")
                ()
                ()
                ()
                ()
            else:
                for arg in user_args:
                    command.arg(arg)
                    ()
                ()
                ()
            command
        "custom" =>
            let executable = (*request).executable.clone().filter(|value| !value.trim().is_empty()).ok_or_else(|| "Custom external terminal profile requires an executable.".to_string())?
            let mut command = Command__new_(executable)
            for arg in user_args:
                command.arg(arg)
                ()
            ()
            command
        other =>
            return Result::Err(format!("Unsupported external terminal profile: {}", other))
    command.current_dir(working_dir)
    ()
    command.stdin(Stdio__null())
    ()
    command.stdout(Stdio__null())
    ()
    command.stderr(Stdio__null())
    ()
    command.creation_flags(CREATE_NEW_CONSOLE)
    ()
    Result::Ok(command)

fn build_unix_external_command(request: &ExternalTerminalRequest, working_dir: &std::path::Path) -> Result<std::process::Command, String>:
    let requested_profile = (*request).profile.unwrap_or("auto")
    let resolved_profile = match requested_profile:
        "auto" =>
            if app_exists("iTerm"):
                "iterm"
            else:
                "terminal"
        "system" => "terminal"
        other => other
    if resolved_profile == "custom":
        let user_args = optional_args(&(*request).args)
        let executable = (*request).executable.clone().filter(|value| !value.trim().is_empty()).ok_or_else(|| "Custom external terminal profile requires an executable.".to_string())?
        let mut command = Command__new_(executable)
        for arg in user_args:
            command.arg(arg)
            ()
        ()
        command.current_dir(working_dir)
        ()
        command.stdin(Stdio__null())
        ()
        command.stdout(Stdio__null())
        ()
        command.stderr(Stdio__null())
        ()
        return Result::Ok(command)
    let shell = (*request).shell.clone().filter(|value| !value.trim().is_empty()).unwrap_or_else(|| TerminalManager__get_shell(none).field_0)
    let user_args = optional_args(&(*request).args).join(" ")
    let shell_command = if user_args.trim().is_empty():
        format!("cd {}", shell_quote_single(&working_dir.to_string_lossy()))
    else:
        format!("cd {} && {} {}", shell_quote_single(&working_dir.to_string_lossy()), shell, user_args)
    let script = match resolved_profile:
        "iterm" => format!("tell application \"iTerm\"\nactivate\nif (count of windows) = 0 then\n  create window with default profile\nend if\ntell current session of current window\n  write text \"{}\"\nend tell\nend tell", applescript_escape(&shell_command))
        "terminal" => format!("tell application \"Terminal\"\nactivate\ndo script \"{}\"\nend tell", applescript_escape(&shell_command))
        other => return Result::Err(format!("Unsupported external terminal profile: {}", other))
    let mut command = Command__new_("osascript")
    command.arg("-e").arg(script)
    ()
    command.current_dir(working_dir)
    ()
    command.stdin(Stdio__null())
    ()
    command.stdout(Stdio__null())
    ()
    command.stderr(Stdio__null())
    ()
    return Result::Ok(command)
    let requested_profile = (*request).profile.unwrap_or("auto")
    let resolved_profile = match requested_profile:
        "auto" =>
            if command_exists("x-terminal-emulator"):
                "system"
            else if command_exists("gnome-terminal"):
                "gnome-terminal"
            else if command_exists("konsole"):
                "konsole"
            else:
                "xterm"
        other => other
    let user_args = optional_args(&(*request).args)
    let executable_override = (*request).executable.clone().filter(|value| !value.trim().is_empty())
    let mut command = match resolved_profile:
        "system" => Command__new_(executable_override.unwrap_or_else(|| "x-terminal-emulator".to_string()))
        "gnome-terminal" =>
            let mut command = Command__new_(executable_override.unwrap_or_else(|| "gnome-terminal".to_string()))
            command.arg("--working-directory").arg(working_dir)
            ()
            command
        "konsole" =>
            let mut command = Command__new_(executable_override.unwrap_or_else(|| "konsole".to_string()))
            command.arg("--workdir").arg(working_dir)
            ()
            command
        "xterm" =>
            let shell = (*request).shell.clone().filter(|value| !value.trim().is_empty()).unwrap_or_else(|| TerminalManager__get_shell(none).field_0)
            let mut command = Command__new_(executable_override.unwrap_or_else(|| "xterm".to_string()))
            command.arg("-e").arg(format!("cd {} && exec {}", shell_quote_single(&working_dir.to_string_lossy()), shell))
            ()
            command
        "custom" =>
            let executable = executable_override.ok_or_else(|| "Custom external terminal profile requires an executable.".to_string())?
            Command__new_(executable)
        other => return Result::Err(format!("Unsupported external terminal profile: {}", other))
    for arg in user_args:
        command.arg(arg)
        ()
    ()
    command.current_dir(working_dir)
    ()
    command.stdin(Stdio__null())
    ()
    command.stdout(Stdio__null())
    ()
    command.stderr(Stdio__null())
    ()
    return Result::Ok(command)

fn terminal_spawn(terminal_manager: tauri::State<_, TerminalManager>, app: tauri::AppHandle, id: String, working_dir: Option<String>, shell: Option<String>, rows: Option<u16>, cols: Option<u16>) -> Result<(), String>:
    let span = telemetry__start_native_span(&app, "rust", "terminal_spawn", BTreeMap__from([("terminalId".to_string(), id.clone()), ("workingDir".to_string(), working_dir.clone().unwrap_or_default()), ("rows".to_string(), rows.unwrap_or(24).to_string()), ("cols".to_string(), cols.unwrap_or(80).to_string())]))
    let rows = rows.unwrap_or(24)
    let cols = cols.unwrap_or(80)
    let result = terminal_manager.spawn_(&id, working_dir, shell, rows, cols)
    if result.is_ok():
        match terminal_manager.open_output_stream(&id, &app):
            Err(error) =>
                log::warn!("failed to prime terminal output stream for {id}: {error}")
                ()
                ()
            _ =>
                ()
                ()
        terminal_manager.start_reader_thread(id, app.clone())
        ()
        ()
        ()
        ()
    let status = if result.is_ok():
        "ok"
    else:
        "error"
    let error = result.err().cloned()
    telemetry__finish_native_span(&app, span, status, BTreeMap__new_(), error)
    ()
    result

fn terminal_open_output_stream(app: tauri::AppHandle, terminal_manager: tauri::State<_, TerminalManager>, id: String) -> Result<greeble_ipc_contracts::IpcStreamHandle, String>:
    terminal_manager.open_output_stream(&id, &app)

fn terminal_write(terminal_manager: tauri::State<_, TerminalManager>, id: String, data: String) -> Result<(), String>:
    terminal_manager.write(&id, data.as_bytes())

fn terminal_write_many(terminal_manager: tauri::State<_, TerminalManager>, writes: Array<TerminalWriteRequest>) -> Result<(), String>:
    if writes.is_empty():
        return Result::Ok(())
    terminal_manager.write_many(&writes)

fn terminal_resize(terminal_manager: tauri::State<_, TerminalManager>, id: String, rows: u16, cols: u16) -> Result<(), String>:
    terminal_manager.resize(&id, rows, cols)

fn terminal_kill(app: tauri::AppHandle, terminal_manager: tauri::State<_, TerminalManager>, id: String) -> Result<(), String>:
    terminal_manager.kill(&id, &app)

fn terminal_register_shell_integration(app: tauri::AppHandle, terminal_manager: tauri::State<_, TerminalManager>, request: TerminalShellIntegrationRequest) -> Result<TerminalShellIntegrationState, String>:
    let state = terminal_manager.register_shell_integration(&request)?
    emit_terminal_shell_integration_state_event(&app, request.id, state.clone(), state.last_synced_cwd.clone())
    ()
    Result::Ok(state)

fn terminal_sync_cwd(app: tauri::AppHandle, terminal_manager: tauri::State<_, TerminalManager>, id: String, cwd: String) -> Result<TerminalShellIntegrationState, String>:
    let (state, applied_cwd) = terminal_manager.request_cwd_sync(&id, &cwd)?
    emit_terminal_shell_integration_state_event(&app, id, state.clone(), applied_cwd)
    ()
    Result::Ok(state)

fn terminal_set_prompt_state(app: tauri::AppHandle, terminal_manager: tauri::State<_, TerminalManager>, id: String, at_prompt: Bool, reported_cwd: Option<String>) -> Result<TerminalShellIntegrationState, String>:
    let (state, applied_cwd) = terminal_manager.set_prompt_state(&id, at_prompt, reported_cwd)?
    emit_terminal_shell_integration_state_event(&app, id, state.clone(), applied_cwd)
    ()
    Result::Ok(state)

fn terminal_open_external(request: ExternalTerminalRequest) -> Result<(), String>:
    let working_dir = resolve_working_dir(&request.working_dir)?
    let mut command = build_windows_external_command(&request, &working_dir)?
    let mut command = build_unix_external_command(&request, &working_dir)?
    command.spawn_().map_err(|error| format!("Failed to open external terminal: {}", error))?
    ()
    Result::Ok(())

enum ExplorerThumbnailKind:
    Image
    Code
    Shader
    Audio
    Video

struct ExplorerVideoHoverFrame:
    image_data_url: String
    timestamp_seconds: f64

struct ExplorerEntryThumbnail:
    kind: ExplorerThumbnailKind
    poster_data_url: String
    hover_frames: Array<ExplorerVideoHoverFrame>
    hover_frame_delay_ms: Option<u32>

struct ExplorerEntryThumbnailRequest:
    path: String
    max_width: u32
    max_height: u32
    include_video_hover_scrub: Option<Bool>
    video_hover_frame_count: Option<u32>
    entity_id: Option<String>
    content_revision: Option<String>

struct ExplorerThumbnailArtifact:
    entity_id: String
    content_revision: String
    kind: ExplorerThumbnailKind
    poster: greeble_ipc_contracts::IpcArtifactDescriptor
    hover_frames: Array<greeble_ipc_contracts::IpcArtifactDescriptor>
    hover_frame_delay_ms: Option<u32>

enum ThumbnailRenderKind:
    Image
    Code
    Shader
    Audio
    Video

struct NormalizedThumbnailRequest:
    input_path: std::path::PathBuf
    max_width: u32
    max_height: u32
    include_video_hover_scrub: Bool
    video_hover_frame_count: u32
    entity_id: String
    content_revision: String

struct ThumbnailFontSpec:
    family: fontdb::Family<static>

struct CodeThumbnailTextLayout:
    page_left: u32
    page_top: u32
    page_right: u32
    page_bottom: u32
    text_left: u32
    text_top: u32
    text_scale: f32
    line_height: u32
    max_lines: usize
    max_chars: usize

struct ShaderProfile:
    palette: Array<image::Rgba<u8>>
    stripe_frequency: f32
    stripe_mix: f32
    fresnel_strength: f32
    highlight_strength: f32

fn fs_read_entry_thumbnail(app: tauri::AppHandle, request: ExplorerEntryThumbnailRequest) -> Result<ExplorerEntryThumbnail, String>:
    (await tauri__async_runtime__spawn_blocking(
        || block:
            let normalized = normalize_thumbnail_request(request)?
            let artifact = build_entry_thumbnail_artifact(&app, gpu_runtime__global_gpu_runtime(), &normalized)?
            build_entry_thumbnail_from_artifact(&app, &normalized, artifact)
    )).map_err(|error| format!("Thumbnail generation task failed to join: {error}"))?

fn fs_read_entry_thumbnail_artifact(app: tauri::AppHandle, request: ExplorerEntryThumbnailRequest) -> Result<ExplorerThumbnailArtifact, String>:
    (await tauri__async_runtime__spawn_blocking(
        || block:
            let normalized = normalize_thumbnail_request(request)?
            build_entry_thumbnail_artifact(&app, gpu_runtime__global_gpu_runtime(), &normalized)
    )).map_err(|error| format!("Thumbnail artifact generation task failed to join: {error}"))?

fn build_image_thumbnail_data_url(path: &std::path::Path, max_width: u32, max_height: u32) -> Result<String, String>:
    build_image_thumbnail_data_url_with_runtime(none, path, max_width, max_height)

fn build_image_thumbnail_data_url_with_runtime(gpu_runtime: Option<&gpu_runtime::GpuRuntimeManager>, path: &std::path::Path, max_width: u32, max_height: u32) -> Result<String, String>:
    let extension = normalized_extension(path)
    if extension == "svg":
        let bytes = std__fs__read(path).map_err(|error| format!("Failed to read SVG image '{}': {error}", path.display()))?
        return Result::Ok(format!("data:image/svg+xml;base64,{}", base64__engine__general_purpose__STANDARD.encode(bytes)))
    let png = build_image_thumbnail_png_with_runtime(gpu_runtime, path, max_width, max_height)?
    Result::Ok(png_bytes_to_data_url(&png))

fn build_image_thumbnail_png_with_runtime(gpu_runtime: Option<&gpu_runtime::GpuRuntimeManager>, path: &std::path::Path, max_width: u32, max_height: u32) -> Result<Array<u8>, String>:
    validate_thumbnail_bounds(max_width, max_height)?
    ()
    let metadata = std__fs__metadata(path).map_err(|error| format!("Failed to read image metadata '{}': {error}", path.display()))?
    if metadata.len() > THUMBNAIL_IMAGE_MAX_BYTES:
        return Result::Err("Image is too large to thumbnail (> 64 MB)".to_string())
    let image = read_image_file_as_rgba(path)?
    let thumbnail = match gpu_runtime:
        Some(gpu_runtime) =>
            let (target_width, target_height) = resolve_image_fit_dimensions(image.width(), image.height(), max_width, max_height)
            gpu_runtime.render_image_thumbnail(&image, target_width, target_height).unwrap_or_else(|_| resize_image_to_fit(&image, max_width, max_height))
        _ =>
            resize_image_to_fit(&image, max_width, max_height)
    encode_rgba_image_as_png(&thumbnail)

fn build_entry_thumbnail_from_artifact(app: &tauri::AppHandle, request: &NormalizedThumbnailRequest, artifact: ExplorerThumbnailArtifact) -> Result<ExplorerEntryThumbnail, String>:
    let poster_path = resolve_registered_thumbnail_artifact_path(app, &artifact.poster)?
    let poster_data_url = artifact_path_to_data_url(poster_path.as_path())?
    let hover_timestamps = sample_thumbnail_hover_timestamps(request, artifact.kind.clone(), artifact.hover_frames.len())
    let hover_frames = artifact.hover_frames.iter().enumerate().map(
        |__kain_closure_arg0| block:
            let hover_frame_path = resolve_registered_thumbnail_artifact_path(app, __kain_closure_arg0.__kain_tuple_1)?
            Result::Ok(ExplorerVideoHoverFrame { image_data_url: artifact_path_to_data_url(hover_frame_path.as_path())?, timestamp_seconds: *hover_timestamps.get(__kain_closure_arg0.__kain_tuple_0).unwrap_or(&0.0) })
    ).collect()?
    Result::Ok(ExplorerEntryThumbnail { kind: artifact.kind, poster_data_url: poster_data_url, hover_frames: hover_frames, hover_frame_delay_ms: artifact.hover_frame_delay_ms })

fn resolve_registered_thumbnail_artifact_path(app: &tauri::AppHandle, descriptor: &greeble_ipc_contracts::IpcArtifactDescriptor) -> Result<std::path::PathBuf, String>:
    let ipc_runtime = app.state()
    (ipc_runtime.artifact_path(&(*descriptor).id)?).ok_or_else(|| format!("Thumbnail artifact path is no longer registered: {}", (*descriptor).id))

fn build_entry_thumbnail_artifact(app: &tauri::AppHandle, gpu_runtime: Option<&gpu_runtime::GpuRuntimeManager>, request: &NormalizedThumbnailRequest) -> Result<ExplorerThumbnailArtifact, String>:
    let kind = classify_thumbnail_kind(&(*request).input_path)?
    match kind:
        ThumbnailRenderKind::Image => build_static_thumbnail_artifact(app, request, ExplorerThumbnailKind::Image, "image-v1", gpu_runtime, ensure_image_thumbnail_artifact_path)
        ThumbnailRenderKind::Code => build_static_thumbnail_artifact(app, request, ExplorerThumbnailKind::Code, "code-v4", none, |artifact_app, _, artifact_request, variant| ensure_cached_static_thumbnail_path(artifact_app, artifact_request, variant, "png", || render_code_thumbnail_png(&artifact_request.input_path, artifact_request.max_width, artifact_request.max_height)))
        ThumbnailRenderKind::Shader => build_static_thumbnail_artifact(app, request, ExplorerThumbnailKind::Shader, "shader-v2", none, |artifact_app, _, artifact_request, variant| ensure_cached_static_thumbnail_path(artifact_app, artifact_request, variant, "png", || render_shader_thumbnail_png(&artifact_request.input_path, artifact_request.max_width, artifact_request.max_height)))
        ThumbnailRenderKind::Audio => build_static_thumbnail_artifact(app, request, ExplorerThumbnailKind::Audio, "audio-v2", gpu_runtime, |artifact_app, artifact_gpu_runtime, artifact_request, variant| ensure_cached_static_thumbnail_path(artifact_app, artifact_request, variant, "png", || render_audio_thumbnail_png_with_runtime(artifact_gpu_runtime, &artifact_request.input_path, artifact_request.max_width, artifact_request.max_height)))
        ThumbnailRenderKind::Video => build_video_thumbnail_artifact(app, request)

fn build_static_thumbnail_artifact(app: &tauri::AppHandle, request: &NormalizedThumbnailRequest, kind: ExplorerThumbnailKind, variant: String, gpu_runtime: Option<&gpu_runtime::GpuRuntimeManager>, ensure_poster_path: F) -> Result<ExplorerThumbnailArtifact, String>:
    let poster_path = ensure_poster_path(app, gpu_runtime, request, variant)?
    let poster = register_thumbnail_artifact_descriptor(app, request, "thumbnail.poster", &poster_path)?
    let artifact = ExplorerThumbnailArtifact { entity_id: (*request).entity_id.clone(), content_revision: (*request).content_revision.clone(), kind: kind.clone(), poster: poster, hover_frames: Vec__new_(), hover_frame_delay_ms: none }
    persist_thumbnail_artifact_record(app, request, &artifact, variant)?
    ()
    Result::Ok(artifact)

fn artifact_path_to_data_url(path: &std::path::Path) -> Result<String, String>:
    let bytes = std__fs__read(path).map_err(|error| format!("Failed to read thumbnail artifact '{}': {error}", path.display()))?
    let mime = if normalized_extension(path) == "svg":
        "image/svg+xml"
    else:
        "image/png"
    Result::Ok(format!("data:{mime};base64,{}", base64__engine__general_purpose__STANDARD.encode(bytes)))

fn sample_thumbnail_hover_timestamps(request: &NormalizedThumbnailRequest, kind: ExplorerThumbnailKind, frame_count: usize) -> Array<f64>:
    if kind != ExplorerThumbnailKind::Video or frame_count == 0:
        return vec!()
    let duration = probe_video_duration_seconds(&(*request).input_path).unwrap_or(0.0)
    sample_video_timestamps(duration, frame_count as u32)

fn persist_thumbnail_artifact_record(app: &tauri::AppHandle, request: &NormalizedThumbnailRequest, artifact: &ExplorerThumbnailArtifact, variant: String) -> Result<(), String>:
    explorer_identity__record_thumbnail_artifact(
        app,
        PersistedThumbnailArtifactRecordInput { entity_id: (*request).entity_id.clone(), content_revision: (*request).content_revision.clone(), kind: thumbnail_kind_storage_label(&(*artifact).kind).to_string(), variant_key: build_thumbnail_variant_key(
            variant,
            (*request).max_width,
            (*request).max_height,
            if (*request).include_video_hover_scrub:
                Option::Some((*request).video_hover_frame_count)
            else:
                none
        ), poster_path: (resolve_registered_thumbnail_artifact_path(app, &(*artifact).poster)?).to_string_lossy().to_string(), hover_frame_paths: (*artifact).hover_frames.iter().map(|descriptor| resolve_registered_thumbnail_artifact_path(app, descriptor).map(|path| path.to_string_lossy().to_string())).collect()?, hover_frame_delay_ms: (*artifact).hover_frame_delay_ms }
    )

fn register_thumbnail_artifact_descriptor(app: &tauri::AppHandle, request: &NormalizedThumbnailRequest, artifact_kind: String, artifact_path: &std::path::Path) -> Result<greeble_ipc_contracts::IpcArtifactDescriptor, String>:
    let media_type = mime_guess__from_path(artifact_path).first_raw().map(str__to_string)
    let ipc_runtime = app.state()
    ipc_runtime.register_artifact_path(app, RegisterArtifactPathRequest { kind: artifact_kind.to_string(), file_path: artifact_path.to_path_buf(), media_type: media_type, retention: greeble_ipc_contracts::IpcArtifactRetention::Persistent, identity_key: Option::Some((*request).entity_id.clone()), content_revision: Option::Some((*request).content_revision.clone()), delete_on_release: false })

fn thumbnail_kind_storage_label(kind: &ExplorerThumbnailKind) -> String:
    match kind:
        ExplorerThumbnailKind::Image => "image"
        ExplorerThumbnailKind::Code => "code"
        ExplorerThumbnailKind::Shader => "shader"
        ExplorerThumbnailKind::Audio => "audio"
        ExplorerThumbnailKind::Video => "video"

fn normalize_thumbnail_request(request: ExplorerEntryThumbnailRequest) -> Result<NormalizedThumbnailRequest, String>:
    validate_thumbnail_bounds(request.max_width, request.max_height)?
    ()
    let trimmed_path = request.path.trim()
    if trimmed_path.is_empty():
        return Result::Err("Thumbnail path cannot be empty.".to_string())
    let input_path = PathBuf__from(trimmed_path)
    if !input_path.exists():
        return Result::Err(format!("Thumbnail path does not exist: {}", input_path.display()))
    if !input_path.is_file():
        return Result::Err(format!("Thumbnail path is not a file: {}", input_path.display()))
    let metadata = std__fs__symlink_metadata(&input_path).map_err(|error| format!("Failed to inspect thumbnail source '{}': {error}", input_path.display()))?
    let is_symlink = metadata.file_type().is_symlink()
    let is_dir = metadata.is_dir()
    let size = if is_dir:
        0
    else:
        metadata.len()
    let modified = metadata.modified().ok().and_then(|value| value.duration_since(std__time__UNIX_EPOCH).ok()).map(|value| value.as_millis() as u64).unwrap_or(0)
    let fallback_content_revision = explorer_identity__build_content_revision(size, modified, is_dir, is_symlink)
    let content_revision = request.content_revision.unwrap_or(fallback_content_revision)
    let entity_id = request.entity_id.unwrap_or_else(|| explorer_identity__build_virtual_identity("thumbnail-path", &input_path.to_string_lossy(), &content_revision).entity_id)
    Result::Ok(NormalizedThumbnailRequest { input_path: input_path, max_width: request.max_width, max_height: request.max_height, include_video_hover_scrub: request.include_video_hover_scrub.unwrap_or(false), video_hover_frame_count: request.video_hover_frame_count.unwrap_or(THUMBNAIL_VIDEO_FRAME_COUNT_DEFAULT).clamp(1, THUMBNAIL_VIDEO_FRAME_COUNT_MAX), entity_id: entity_id, content_revision: content_revision })

fn validate_thumbnail_bounds(max_width: u32, max_height: u32) -> Result<(), String>:
    if max_width == 0 or max_height == 0:
        return Result::Err("Thumbnail bounds must be greater than zero.".to_string())
    if max_width > THUMBNAIL_MAX_DIMENSION or max_height > THUMBNAIL_MAX_DIMENSION:
        return Result::Err(format!("Thumbnail bounds must be <= {} px.", THUMBNAIL_MAX_DIMENSION))
    Result::Ok(())

fn classify_thumbnail_kind(path: &std::path::Path) -> Result<ThumbnailRenderKind, String>:
    let extension = normalized_extension(path)
    if extension == "svg":
        return Result::Ok(ThumbnailRenderKind::Image)
    if (std__fs__metadata(path).map_err(|error| format!("Failed to read file metadata '{}': {error}", path.display()))?).len() <= THUMBNAIL_IMAGE_MAX_BYTES and read_image_file_as_rgba(path).is_ok():
        return Result::Ok(ThumbnailRenderKind::Image)
    if is_video_extension(&extension):
        return Result::Ok(ThumbnailRenderKind::Video)
    if is_audio_extension(&extension):
        return Result::Ok(ThumbnailRenderKind::Audio)
    if is_shader_extension(&extension):
        return Result::Ok(ThumbnailRenderKind::Shader)
    if is_code_extension(&extension) or file_looks_like_text(path)?:
        return Result::Ok(ThumbnailRenderKind::Code)
    Result::Err(format!("No thumbnail renderer is available for '{}'.", path.display()))

fn normalized_extension(path: &std::path::Path) -> String:
    path.extension().and_then(|value| value.to_str()).unwrap_or_default().trim().trim_start_matches(".").to_ascii_lowercase()

fn is_video_extension(extension: String) -> Bool:
    matches!(extension, "3g2" | "3gp" | "asf" | "avi" | "flv" | "m2ts" | "m2v" | "m4v" | "mkv" | "mov" | "mp4" | "mpe" | "mpeg" | "mpg" | "mts" | "ogv" | "qt" | "webm" | "wmv")

fn is_audio_extension(extension: String) -> Bool:
    matches!(extension, "aac" | "aif" | "aiff" | "aifc" | "alac" | "amr" | "caf" | "flac" | "m4a" | "m4b" | "mid" | "midi" | "mka" | "mp3" | "oga" | "ogg" | "opus" | "wav" | "wave" | "weba" | "wma")

fn is_shader_extension(extension: String) -> Bool:
    matches!(extension, "glsl" | "hlsl" | "wgsl")

fn is_code_extension(extension: String) -> Bool:
    matches!(extension, "txt" | "md" | "mdx" | "log" | "json" | "yaml" | "yml" | "toml" | "xml" | "ini" | "cfg" | "csv" | "ts" | "tsx" | "js" | "jsx" | "mjs" | "cjs" | "rs" | "py" | "go" | "c" | "h" | "cpp" | "hpp" | "cc" | "cxx" | "cs" | "java" | "kt" | "kts" | "rb" | "php" | "swift" | "dart" | "lua" | "zig" | "html" | "htm" | "css" | "scss" | "sass" | "less" | "sh" | "bash" | "zsh" | "ps1" | "bat" | "cmd" | "env" | "sql" | "kain" | "ink")

fn file_looks_like_text(path: &std::path::Path) -> Result<Bool, String>:
    let metadata = std__fs__metadata(path).map_err(|error| format!("Failed to inspect file '{}': {error}", path.display()))?
    if metadata.len() > THUMBNAIL_TEXT_MAX_BYTES:
        return Result::Ok(false)
    let bytes = std__fs__read(path).map_err(|error| format!("Failed to read text thumbnail source '{}': {error}", path.display()))?
    Result::Ok(std__str__from_utf8(&bytes).is_ok())

fn read_image_file_as_rgba(path: &std::path::Path) -> Result<image::RgbaImage, String>:
    ((ImageReader__open(path).map_err(|error| format!("Failed to open image '{}': {error}", path.display()))?).with_guessed_format().map_err(|error| format!("Failed to detect image format for '{}': {error}", path.display()))?).decode().map(|image| image.to_rgba8()).map_err(|error| format!("Failed to decode image '{}': {error}", path.display()))

fn resize_image_to_fit(image: &image::RgbaImage, max_width: u32, max_height: u32) -> image::RgbaImage:
    let (width, height) = resolve_image_fit_dimensions(image.width(), image.height(), max_width, max_height)
    if width == image.width() and height == image.height():
        return image.clone()
    image__imageops__resize(image, width, height, image::imageops::FilterType::Lanczos3)

fn resolve_image_fit_dimensions(image_width: u32, image_height: u32, max_width: u32, max_height: u32) -> (u32, u32):
    if image_width <= max_width and image_height <= max_height:
        return (image_width.max(1), image_height.max(1))
    let scale = f32__min(max_width as f32 / image_width as f32, max_height as f32 / image_height as f32)
    (((image_width as f32) * scale).round().max(1.0) as u32, ((image_height as f32) * scale).round().max(1.0) as u32)

fn encode_rgba_image_as_png(image: &image::RgbaImage) -> Result<Array<u8>, String>:
    let mut bytes = Vec__new_()
    PngEncoder__new_(&mut bytes).write_image(image.as_raw(), image.width(), image.height(), image::ColorType::Rgba8.into()).map_err(|error| format!("Failed to encode thumbnail as PNG: {error}"))?
    ()
    Result::Ok(bytes)

fn png_bytes_to_data_url(bytes: &Slice<u8>) -> String:
    format!("data:image/png;base64,{}", base64__engine__general_purpose__STANDARD.encode(bytes))

fn ensure_cached_static_thumbnail_path(app: &tauri::AppHandle, request: &NormalizedThumbnailRequest, variant: String, output_extension: String, render_png: F) -> Result<std::path::PathBuf, String>:
    let cache_path = thumbnail_artifact_cache_path(app, request, variant, output_extension, none, none)?
    if !cache_path.exists():
        let png = render_png()?
        match cache_path.parent():
            Some(parent) =>
                std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create thumbnail cache directory '{}': {error}", parent.display()))?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        std__fs__write(&cache_path, &png).map_err(|error| format!("Failed to write cached thumbnail '{}': {error}", cache_path.display()))?
        ()
        ()
        ()
        ()
    Result::Ok(cache_path)

fn resolve_thumbnail_runtime_root(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let root = app.path().app_local_data_dir().map(|path| path.join(THUMBNAIL_RUNTIME_DIR)).map_err(|error| format!("Failed to resolve app local data directory: {error}"))?
    std__fs__create_dir_all(&root).map_err(|error| format!("Failed to create thumbnail runtime directory '{}': {error}", root.display()))?
    ()
    Result::Ok(root)

fn thumbnail_artifact_cache_path(app: &tauri::AppHandle, request: &NormalizedThumbnailRequest, variant: String, output_extension: String, extra_number: Option<u32>, frame_index: Option<u32>) -> Result<std::path::PathBuf, String>:
    let root = (resolve_thumbnail_runtime_root(app)?).join("artifacts")
    let digest = thumbnail_artifact_digest(request, variant, extra_number, frame_index, output_extension)
    let digest_prefix = &digest[..16]
    let stem = sanitize_thumbnail_file_stem((*request).input_path.file_stem().and_then(|value| value.to_str()).unwrap_or("thumb"))
    let variant_key = build_thumbnail_variant_key(variant, (*request).max_width, (*request).max_height, extra_number)
    let index_suffix = frame_index.map(|index| format!(".{:02}", index + 1)).unwrap_or_default()
    Result::Ok(root.join(format!("{stem}.{digest_prefix}.{variant_key}{index_suffix}.{output_extension}")))

fn build_video_hover_frame_artifact_paths(app: &tauri::AppHandle, request: &NormalizedThumbnailRequest, frame_count: u32) -> Result<Array<std::path::PathBuf>, String>:
    Result::Ok(0..frame_count.map(|index| thumbnail_artifact_cache_path(app, request, "video-hover", "png", Option::Some(frame_count), Option::Some(index))).collect()?)

fn thumbnail_artifact_digest(request: &NormalizedThumbnailRequest, variant: String, extra_number: Option<u32>, frame_index: Option<u32>, output_extension: String) -> String:
    let mut hasher = Sha256__new_()
    hasher.update((*request).entity_id.as_bytes())
    ()
    hasher.update((*request).content_revision.as_bytes())
    ()
    hasher.update((*request).max_width.to_le_bytes())
    ()
    hasher.update((*request).max_height.to_le_bytes())
    ()
    hasher.update(variant.as_bytes())
    ()
    match extra_number:
        Some(extra_number) =>
            hasher.update(extra_number.to_le_bytes())
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match frame_index:
        Some(frame_index) =>
            hasher.update(frame_index.to_le_bytes())
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    hasher.update(output_extension.as_bytes())
    ()
    format!("{:x}", hasher.finalize())

fn build_thumbnail_variant_key(variant: String, max_width: u32, max_height: u32, extra_number: Option<u32>) -> String:
    match extra_number:
        Some(extra_number) => format!("{variant}-{max_width}x{max_height}-{extra_number}")
        None => format!("{variant}-{max_width}x{max_height}")

fn ensure_image_thumbnail_artifact_path(app: &tauri::AppHandle, gpu_runtime: Option<&gpu_runtime::GpuRuntimeManager>, request: &NormalizedThumbnailRequest, variant: String) -> Result<std::path::PathBuf, String>:
    if normalized_extension(&(*request).input_path) == "svg":
        let cache_path = thumbnail_artifact_cache_path(app, request, variant, "svg", none, none)?
        if !cache_path.exists():
            match cache_path.parent():
                Some(parent) =>
                    std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create thumbnail cache directory '{}': {error}", parent.display()))?
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            std__fs__copy(&(*request).input_path, &cache_path).map_err(|error| format!("Failed to copy SVG thumbnail artifact '{}' to '{}': {error}", (*request).input_path.display(), cache_path.display()))?
            ()
            ()
            ()
            ()
        return Result::Ok(cache_path)
    ensure_cached_static_thumbnail_path(app, request, variant, "png", || build_image_thumbnail_png_with_runtime(gpu_runtime, &(*request).input_path, (*request).max_width, (*request).max_height))

fn sanitize_thumbnail_file_stem(value: String) -> String:
    let sanitized: String = value.chars().map(
        |character| if character.is_ascii_alphanumeric() or character == "-" or character == "_":
            character
        else:
            "-"
    ).collect()
    let collapsed = sanitized.trim_matches("-")
    if collapsed.is_empty():
        "thumbnail".to_string()
    else:
        collapsed.to_string()

fn render_code_thumbnail_png(input_path: &std::path::Path, max_width: u32, max_height: u32) -> Result<Array<u8>, String>:
    render_text_thumbnail_png(input_path, max_width, max_height, false)

fn render_shader_thumbnail_png(input_path: &std::path::Path, max_width: u32, max_height: u32) -> Result<Array<u8>, String>:
    render_text_thumbnail_png(input_path, max_width, max_height, true)

fn render_text_thumbnail_png(input_path: &std::path::Path, max_width: u32, max_height: u32, shader_mode: Bool) -> Result<Array<u8>, String>:
    let metadata = std__fs__metadata(input_path).map_err(|error| format!("Failed to read text thumbnail metadata '{}': {error}", input_path.display()))?
    if metadata.len() > THUMBNAIL_TEXT_MAX_BYTES:
        return Result::Err("Text source is too large to thumbnail.".to_string())
    let bytes = std__fs__read(input_path).map_err(|error| format!("Failed to read text thumbnail source '{}': {error}", input_path.display()))?
    let content = String__from_utf8_lossy(&bytes).to_string()
    let extension = normalized_extension(input_path)
    let accent = extension_accent_color(&extension)
    if !shader_mode:
        return render_code_thumbnail_card_png(input_path, &content, accent, max_width, max_height)
    let mut image = RgbaImage__from_pixel(max_width, max_height, THUMBNAIL_DEFAULT_BACKGROUND)
    let secondary = tint_color(accent, 0.55, 40)
    draw_vertical_gradient(&mut image, THUMBNAIL_DEFAULT_BACKGROUND, tint_color(accent, 0.15, 0))
    ()
    fill_rect(&mut image, 0, 0, max_width, max_height.min(44), tint_color(accent, 0.22, 10))
    ()
    fill_rect(&mut image, 0, 44, 6, max_height, accent)
    ()
    let preview_panel_top = 52
    let preview_panel_bottom = max_height.saturating_sub(16)
    fill_rect(&mut image, 12, preview_panel_top, max_width.saturating_sub(12), preview_panel_bottom, image__Rgba([11, 15, 22, 232]))
    ()
    fill_rect(&mut image, 12, preview_panel_top, max_width.saturating_sub(12), preview_panel_top + 18, tint_color(accent, 0.16, 10))
    ()
    fill_rect(&mut image, 12, preview_panel_top, 16, preview_panel_bottom, accent)
    ()
    let sans_font = load_thumbnail_font(ThumbnailFontSpec { family: fontdb::Family::SansSerif }).ok()
    let mono_font = load_thumbnail_font(ThumbnailFontSpec { family: fontdb::Family::Monospace }).ok()
    match sans_font:
        Some(font) =>
            let title = input_path.file_name().and_then(|value| value.to_str()).unwrap_or("code")
            let title_scale = if shader_mode:
                15.5
            else:
                16.5
            draw_text_with_shadow(&mut image, font, PxScale__from(title_scale), (16.0, 10.0), &truncate_text(title, 24), THUMBNAIL_TEXT_COLOR)
            ()
            let subtitle = if shader_mode:
                "Shader material preview"
            else:
                "Source snapshot"
            draw_text_with_shadow(&mut image, font, PxScale__from(10.5), (16.0, 28.0), subtitle, THUMBNAIL_MUTED_TEXT_COLOR)
            ()
            let badge_text = if extension.is_empty():
                "text".to_string()
            else:
                extension.to_ascii_uppercase()
            let badge_width = 14 + (badge_text.len() as u32 * 8)
            fill_rounded_badge(&mut image, max_width.saturating_sub(badge_width + 12), 10, badge_width, 22, secondary)
            ()
            draw_text_with_shadow(&mut image, font, PxScale__from(11.0), (max_width.saturating_sub(badge_width + 2) as f32, 15.0), &badge_text, THUMBNAIL_TEXT_COLOR)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    if shader_mode:
        let profile = build_shader_profile(&content)
        let sphere_size = max_width.min(max_height).saturating_mul(30) / 100
        let sphere_left = max_width.saturating_sub(sphere_size + 18)
        let sphere_top = 64
        draw_shader_sphere(&mut image, sphere_left, sphere_top.min(max_height.saturating_sub(sphere_size + 12)), sphere_size, &profile)
        ()
        ()
        ()
        ()
    let preview_lines = block:
        let lines = collect_text_thumbnail_preview_lines(&content, 4)
        if lines.is_empty():
            vec!(if shader_mode:
                "Shader source preview".to_string()
            else:
                "Empty source file".to_string())
        else:
            lines
    match mono_font:
        Some(font) =>
            let line_height = if shader_mode:
                24
            else:
                22
            let text_scale = if shader_mode:
                13.0
            else:
                13.5
            let text_max_chars = if shader_mode:
                16
            else:
                22
            let preview_text_left = 42
            let preview_line_left = 22
            let preview_start_y = preview_panel_top + 26
            for (index, line_) in preview_lines.iter().enumerate():
                let y = preview_start_y + (index as u32 * line_height)
                if y + line_height as u32 >= preview_panel_bottom:
                    break
                let line_color = text_thumbnail_line_color(line_, accent)
                fill_rect(&mut image, preview_line_left, y + 6, preview_line_left + 10, y + 16, line_color)
                ()
                draw_text_with_shadow(&mut image, font, PxScale__from(text_scale), (preview_text_left as f32, y as f32), &truncate_text(line_, text_max_chars), line_color)
                ()
            ()
            ()
        _ =>
            draw_text_thumbnail_fallback_bars(&mut image, preview_panel_top, accent, shader_mode)
            ()
            ()
            ()
            ()
    encode_rgba_image_as_png(&image)

fn render_code_thumbnail_card_png(input_path: &std::path::Path, content: String, accent: image::Rgba<u8>, max_width: u32, max_height: u32) -> Result<Array<u8>, String>:
    let mut image = RgbaImage__from_pixel(max_width, max_height, image__Rgba([0, 0, 0, 0]))
    let layout = resolve_code_thumbnail_text_layout(max_width, max_height)
    fill_rect(&mut image, layout.page_left.saturating_add(4), layout.page_top.saturating_add(5), layout.page_right.saturating_add(4), layout.page_bottom.saturating_add(5), THUMBNAIL_TEXT_PAGE_SHADOW)
    ()
    fill_rect(&mut image, layout.page_left, layout.page_top, layout.page_right, layout.page_bottom, THUMBNAIL_TEXT_PAGE_BACKGROUND)
    ()
    draw_rect_outline(&mut image, layout.page_left, layout.page_top, layout.page_right, layout.page_bottom, THUMBNAIL_TEXT_PAGE_BORDER)
    ()
    fill_rect(&mut image, layout.page_left, layout.page_top, layout.page_left.saturating_add(4).min(layout.page_right), layout.page_bottom, accent)
    ()
    let mono_font = load_thumbnail_font(ThumbnailFontSpec { family: fontdb::Family::Monospace }).ok()
    let preview_lines = block:
        let lines = collect_text_thumbnail_preview_lines(content, layout.max_lines)
        if lines.is_empty():
            vec!("Empty text file".to_string(), "".to_string(), input_path.file_name().and_then(|value| value.to_str()).unwrap_or("text").to_string())
        else:
            lines
    match mono_font:
        Some(font) =>
            for (index, line_) in preview_lines.iter().enumerate():
                let y = layout.text_top + (index as u32 * layout.line_height)
                if y + layout.line_height >= layout.page_bottom:
                    break
                let line_color = code_thumbnail_syntax_color(line_)
                if index % 2 == 1:
                    fill_rect(&mut image, layout.page_left.saturating_add(5), y.saturating_sub(2), layout.page_right.saturating_sub(5), (y + layout.line_height).min(layout.page_bottom.saturating_sub(2)), THUMBNAIL_TEXT_PAGE_ROW_BACKGROUND)
                    ()
                    ()
                    ()
                    ()
                draw_text_plain(&mut image, font, PxScale__from(layout.text_scale), (layout.text_left as f32, y as f32), &truncate_code_thumbnail_line(line_, layout.max_chars), line_color)
                ()
            ()
            ()
        _ =>
            draw_text_thumbnail_fallback_bars(&mut image, layout.page_top, accent, false)
            ()
            ()
            ()
            ()
    encode_rgba_image_as_png(&image)

fn resolve_code_thumbnail_text_layout(max_width: u32, max_height: u32) -> CodeThumbnailTextLayout:
    let shortest_edge = max_width.min(max_height).max(1)
    let page_margin = (shortest_edge as f32 * 0.045).round().clamp(4.0, 14.0) as u32
    let page_left = page_margin
    let page_top = page_margin
    let page_right = max_width.saturating_sub(page_margin).max(page_left + 1)
    let page_bottom = max_height.saturating_sub(page_margin).max(page_top + 1)
    let text_inset = (shortest_edge as f32 * 0.055).round().clamp(8.0, 18.0) as u32
    let text_left = page_left.saturating_add(text_inset).saturating_add(4).min(page_right.saturating_sub(1))
    let text_top = page_top.saturating_add(text_inset).min(page_bottom.saturating_sub(1))
    let text_scale = (shortest_edge as f32 * 0.072).clamp(13.5, 22.5)
    let line_height = (text_scale * 1.38).round().max(text_scale + 4.0) as u32
    let text_width = page_right.saturating_sub(text_left.saturating_add(text_inset / 2))
    let text_height = page_bottom.saturating_sub(text_top.saturating_add(4))
    let max_lines = (text_height / line_height).max(1) as usize
    let average_mono_glyph_width = (text_scale * 0.57).max(7.4)
    let max_chars = ((text_width as f32) / average_mono_glyph_width).floor().clamp(8.0, 36.0) as usize
    CodeThumbnailTextLayout { page_left: page_left, page_top: page_top, page_right: page_right, page_bottom: page_bottom, text_left: text_left, text_top: text_top, text_scale: text_scale, line_height: line_height, max_lines: max_lines, max_chars: max_chars }

fn render_audio_thumbnail_png(input_path: &std::path::Path, max_width: u32, max_height: u32) -> Result<Array<u8>, String>:
    let analysis = audio_engine__analyze_audio_file_native(input_path)?
    let mut image = RgbaImage__from_pixel(max_width, max_height, THUMBNAIL_DEFAULT_BACKGROUND)
    draw_vertical_gradient(&mut image, image__Rgba([7, 10, 16, 255]), image__Rgba([14, 24, 36, 255]))
    ()
    fill_rect(&mut image, 0, 0, max_width, max_height.min(38), image__Rgba([12, 18, 27, 235]))
    ()
    match load_thumbnail_font(ThumbnailFontSpec { family: fontdb::Family::SansSerif }):
        Ok(font) =>
            let title = input_path.file_name().and_then(|value| value.to_str()).unwrap_or("audio")
            draw_text_with_shadow(&mut image, &font, PxScale__from(14.0), (14.0, 9.0), &truncate_text(title, 26), THUMBNAIL_TEXT_COLOR)
            ()
            let subtitle = format!("{:.1}s · {} ch · {} Hz", analysis.duration_seconds, analysis.channels.unwrap_or(0), analysis.sample_rate_hz.unwrap_or(0))
            draw_text_with_shadow(&mut image, &font, PxScale__from(9.5), (14.0, 24.0), &subtitle, THUMBNAIL_MUTED_TEXT_COLOR)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let waveform_top = 46
    let waveform_height = max_height.saturating_sub(waveform_top + 16)
    let baseline = waveform_top + waveform_height / 2
    let bucket_count = analysis.waveform_buckets.len().max(1) as u32
    let spectral_len = analysis.spectral_bands.len().max(1) as u32
    for (index, bucket) in analysis.waveform_buckets.iter().enumerate():
        let x = 10 + (index as u32 * max_width.saturating_sub(20)) / bucket_count
        let band_index = ((index as u32 * spectral_len) / bucket_count) as usize
        let energy = analysis.spectral_bands.get(band_index.min(analysis.spectral_bands.len().saturating_sub(1))).copied().unwrap_or(0.15).clamp(0.0, 1.0)
        let color = lerp_rgba(image__Rgba([69, 153, 255, 210]), image__Rgba([255, 107, 107, 230]), band_index as f32 / spectral_len.max(1) as f32)
        let peak_height = ((waveform_height as f64 * 0.42) * bucket.peak_level.clamp(0.0, 1.0)).round().max(1.0) as i32
        let rms_height = ((waveform_height as f64 * 0.32) * bucket.rms_level.clamp(0.0, 1.0)).round().max(1.0) as i32
        imageproc__drawing__draw_line_segment_mut(&mut image, (x as f32, (baseline as i32 - peak_height) as f32), (x as f32, (baseline as i32 + peak_height) as f32), with_alpha(color, (110.0 + energy as f32 * 90.0) as u8))
        ()
        imageproc__drawing__draw_line_segment_mut(&mut image, (x as f32, (baseline as i32 - rms_height) as f32), (x as f32, (baseline as i32 + rms_height) as f32), with_alpha(THUMBNAIL_WAVEFORM_COLOR, 220))
        ()
    ()
    imageproc__drawing__draw_line_segment_mut(&mut image, (10.0, baseline as f32), (max_width.saturating_sub(10) as f32, baseline as f32), image__Rgba([255, 255, 255, 30]))
    ()
    encode_rgba_image_as_png(&image)

fn render_audio_thumbnail_png_with_runtime(gpu_runtime: Option<&gpu_runtime::GpuRuntimeManager>, input_path: &std::path::Path, max_width: u32, max_height: u32) -> Result<Array<u8>, String>:
    match gpu_runtime:
        Some(gpu_runtime) =>
            match audio_engine__decode_audio_preview_mono_samples(input_path):
                Ok((mono_samples, sample_rate_hz)) =>
                    match gpu_runtime.render_audio_thumbnail(&mono_samples, max_width, max_height):
                        Ok(image) =>
                            return encode_rgba_image_as_png(&image)
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    render_audio_thumbnail_png(input_path, max_width, max_height)

fn build_video_thumbnail_artifact(app: &tauri::AppHandle, request: &NormalizedThumbnailRequest) -> Result<ExplorerThumbnailArtifact, String>:
    let poster_path = ensure_cached_static_thumbnail_path(app, request, "video-poster", "png", || render_video_poster_png(&(*request).input_path, (*request).max_width, (*request).max_height))?
    let poster = register_thumbnail_artifact_descriptor(app, request, "thumbnail.poster", &poster_path)?
    let mut hover_frames = Vec__new_()
    let mut hover_frame_delay_ms = none
    if (*request).include_video_hover_scrub:
        let frame_paths = build_and_render_video_hover_frame_paths(app, request, (*request).video_hover_frame_count)?
        hover_frame_delay_ms = Option::Some(150)
        ()
        hover_frames = frame_paths.into_iter().map(|path| register_thumbnail_artifact_descriptor(app, request, "thumbnail.hover-frame", &path)).collect()?
        ()
        ()
        ()
        ()
    let artifact = ExplorerThumbnailArtifact { entity_id: (*request).entity_id.clone(), content_revision: (*request).content_revision.clone(), kind: ExplorerThumbnailKind::Video, poster: poster, hover_frames: hover_frames, hover_frame_delay_ms: hover_frame_delay_ms }
    persist_thumbnail_artifact_record(app, request, &artifact, "video-poster")?
    ()
    Result::Ok(artifact)

fn render_video_poster_png(input_path: &std::path::Path, max_width: u32, max_height: u32) -> Result<Array<u8>, String>:
    let duration = probe_video_duration_seconds(input_path).unwrap_or(0.0)
    let timestamp = if duration > 0.15:
        (duration * THUMBNAIL_VIDEO_POSTER_RATIO).clamp(0.0, duration.max(0.15))
    else:
        0.0
    let temp = tempfile_path_for_render("video-poster.png")
    generate_video_frame_png(input_path, &temp, max_width, max_height, timestamp)?
    ()
    let png = std__fs__read(&temp).map_err(|error| format!("Failed to read generated video poster '{}': {error}", temp.display()))?
    let _ = std__fs__remove_file(temp)
    Result::Ok(png)

fn build_and_render_video_hover_frame_paths(app: &tauri::AppHandle, request: &NormalizedThumbnailRequest, frame_count: u32) -> Result<Array<std::path::PathBuf>, String>:
    let frame_paths = build_video_hover_frame_artifact_paths(app, request, frame_count)?
    let duration = probe_video_duration_seconds(&(*request).input_path).unwrap_or(0.0)
    let timestamps = sample_video_timestamps(duration, frame_count)
    for (index, frame_path) in frame_paths.iter().enumerate():
        if frame_path.exists():
            continue
        match frame_path.parent():
            Some(parent) =>
                std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create video hover cache directory '{}': {error}", parent.display()))?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        generate_video_frame_png(&(*request).input_path, frame_path, (*request).max_width, (*request).max_height, *timestamps.get(index).unwrap_or(&0.0))?
        ()
    ()
    Result::Ok(frame_paths)

fn sample_video_timestamps(duration_seconds: f64, frame_count: u32) -> Array<f64>:
    if frame_count <= 1:
        return vec!((duration_seconds * THUMBNAIL_VIDEO_POSTER_RATIO).max(0.0))
    if duration_seconds <= 0.1:
        return 0..frame_count.map(|_| 0.0).collect()
    let start = duration_seconds * THUMBNAIL_VIDEO_TIMESTAMPS_START_RATIO
    let end = duration_seconds * THUMBNAIL_VIDEO_TIMESTAMPS_END_RATIO
    let span = (end - start).max(0.01)
    0..frame_count.map(
        |index| block:
            let alpha = index as f64 / (frame_count - 1) as f64
            (start + (span * alpha)).clamp(0.0, duration_seconds)
    ).collect()

fn resolve_ffmpeg_binary() -> String:
    std__env__var_("GREEBLEFS_FFMPEG_BINARY").or_else(|_| std__env__var_("OVERLAYTERM_FFMPEG_BINARY")).ok().map(|value| value.trim().to_string()).filter(|value| !value.is_empty()).unwrap_or_else(|| DEFAULT_FFMPEG_BINARY.to_string())

fn resolve_ffprobe_binary() -> String:
    std__env__var_("GREEBLEFS_FFPROBE_BINARY").or_else(|_| std__env__var_("OVERLAYTERM_FFPROBE_BINARY")).ok().map(|value| value.trim().to_string()).filter(|value| !value.is_empty()).unwrap_or_else(|| DEFAULT_FFPROBE_BINARY.to_string())

fn probe_video_duration_seconds(input_path: &std::path::Path) -> Option<f64>:
    let ffprobe_binary = resolve_ffprobe_binary()
    let ffprobe_output = Command__new_(&ffprobe_binary).args(["-v", "error", "-show_entries", "format=duration", "-of", "default=noprint_wrappers=1:nokey=1", &input_path.to_string_lossy()]).output()
    match ffprobe_output:
        Ok(output) =>
            if output.status.success():
                let value = String__from_utf8_lossy(&output.stdout).trim().to_string()
                match value.parse():
                    Ok(parsed) =>
                        if parsed.is_finite() and parsed >= 0.0:
                            return Option::Some(parsed)
                        ()
                    _ =>
                        ()
                        ()
                ()
            ()
        _ =>
            ()
            ()
    let ffmpeg_binary = resolve_ffmpeg_binary()
    let ffmpeg_output = Command__new_(&ffmpeg_binary).args(["-i", &input_path.to_string_lossy()]).output().ok()?
    let stderr = String__from_utf8_lossy(&ffmpeg_output.stderr)
    parse_ffmpeg_duration(stderr)

fn parse_ffmpeg_duration(stderr: String) -> Option<f64>:
    let marker = "Duration:"
    let index = stderr.find(marker)?
    let duration = (stderr[index + marker.len()..].split(",").next()?).trim()
    let mut parts = duration.split(":")
    let hours = (parts.next()?).trim().parse().ok()?
    let minutes = (parts.next()?).trim().parse().ok()?
    let seconds = (parts.next()?).trim().parse().ok()?
    Option::Some((hours * 3600.0) + (minutes * 60.0) + seconds)

fn generate_video_frame_png(input_path: &std::path::Path, output_path: &std::path::Path, max_width: u32, max_height: u32, timestamp_seconds: f64) -> Result<(), String>:
    let ffmpeg_binary = resolve_ffmpeg_binary()
    let filter = VIDEO_FRAME_FILTER_TEMPLATE.replace("{width}", &max_width.to_string()).replace("{height}", &max_height.to_string())
    let mut command = Command__new_(&ffmpeg_binary)
    command.args(["-hide_banner", "-loglevel", "error", "-y"])
    ()
    if timestamp_seconds > 0.0:
        command.args(["-ss", &format!("{timestamp_seconds:.3}")])
        ()
        ()
        ()
        ()
    command.args(["-i", &input_path.to_string_lossy()])
    ()
    command.args(["-frames:v", "1", "-vf", &filter, &output_path.to_string_lossy()])
    ()
    command.creation_flags(CREATE_NO_WINDOW)
    ()
    ()
    ()
    ()
    let output = command.output().map_err(|error| format!("Failed to launch ffmpeg at '{ffmpeg_binary}': {error}"))?
    if !output.status.success():
        let stderr = String__from_utf8_lossy(&output.stderr).trim().to_string()
        let stdout = String__from_utf8_lossy(&output.stdout).trim().to_string()
        let message = if !stderr.is_empty():
            stderr
        else if !stdout.is_empty():
            stdout
        else:
            format!("ffmpeg exited with status {}", output.status)
        return Result::Err(format!("Video thumbnail generation failed: {message}"))
    Result::Ok(())

fn tempfile_path_for_render(file_name: String) -> std::path::PathBuf:
    std__env__temp_dir().join(format!("greeblefs-thumbnail-{}-{}", Uuid__new_v4(), file_name))

fn extension_accent_color(extension: String) -> image::Rgba<u8>:
    let normalized = if extension.is_empty():
        "txt"
    else:
        extension
    let mut hasher = Sha256__new_()
    hasher.update(normalized.as_bytes())
    ()
    let digest = hasher.finalize()
    image__Rgba([72.saturating_add(digest[0] % 120), 92.saturating_add(digest[1] % 100), 110.saturating_add(digest[2] % 100), 255])

fn build_shader_profile(source: String) -> ShaderProfile:
    let mut hasher = Sha256__new_()
    hasher.update(source.as_bytes())
    ()
    let digest = hasher.finalize()
    let keyword_weight = [source.matches("time").count() as f32, source.matches("texture").count() as f32, source.matches("sin").count() as f32 + source.matches("cos").count() as f32]
    let palette = [image__Rgba([58 + digest[0] % 90, 82 + digest[1] % 110, 120 + digest[2] % 100, 255]), image__Rgba([90 + digest[3] % 120, 60 + digest[4] % 90, 120 + digest[5] % 110, 255]), image__Rgba([40 + digest[6] % 120, 110 + digest[7] % 110, 90 + digest[8] % 120, 255])]
    ShaderProfile { palette: palette, stripe_frequency: 3.0 + (digest[9] as f32 / 255.0 * 8.0) + keyword_weight[2].min(6.0), stripe_mix: 0.25 + (digest[10] as f32 / 255.0 * 0.45), fresnel_strength: 0.22 + (keyword_weight[1].min(5.0) * 0.03), highlight_strength: 0.36 + (digest[11] as f32 / 255.0 * 0.4) }

fn draw_shader_sphere(image: &mut image::RgbaImage, left: u32, top: u32, size: u32, profile: &ShaderProfile):
    if size < 24:
        return
    let radius = size as f32 / 2.0
    let center_x = left as f32 + radius
    let center_y = top as f32 + radius
    let shadow_color = image__Rgba([0, 0, 0, 120])
    imageproc__drawing__draw_filled_circle_mut(image, (center_x.round() as i32 + 6, center_y.round() as i32 + 8), radius.round() as i32, shadow_color)
    ()
    for y in top..top.saturating_add(size).min(image.height()):
        for x in left..left.saturating_add(size).min(image.width()):
            let nx = (x as f32 + 0.5 - center_x) / radius
            let ny = (y as f32 + 0.5 - center_y) / radius
            let distance_sq = nx * nx + ny * ny
            if distance_sq > 1.0:
                continue
            let nz = (1.0 - distance_sq).sqrt()
            let stripe = (((nx * (*profile).stripe_frequency) + (ny * 1.4) + (nz * 1.8)) * std__f32__consts__PI).sin()
            let stripe_mix = (stripe * 0.5 + 0.5).clamp(0.0, 1.0)
            let fresnel = (1.0 - nz).powf(3.2) * (*profile).fresnel_strength
            let diffuse = (0.25 + (nz * 0.75)).clamp(0.0, 1.0)
            let light_dir = normalize_vec3((0.48, -0.58, 0.66))
            let view_dir = (0.0, 0.0, 1.0)
            let normal = normalize_vec3((nx, ny, nz))
            let ndotl = dot_vec3(normal, light_dir).max(0.0)
            let reflected = reflect_vec3((-light_dir.field_0, -light_dir.field_1, -light_dir.field_2), normal)
            let specular = dot_vec3(reflected, view_dir).max(0.0).powf(24.0) * (*profile).highlight_strength
            let base = lerp_rgba((*profile).palette[0], (*profile).palette[1], stripe_mix)
            let shaded = lerp_rgba(base, (*profile).palette[2], fresnel + (*profile).stripe_mix * 0.1)
            let lit = brighten_color(shaded, diffuse * 0.28 + ndotl * 0.42 + specular * 0.6)
            image.put_pixel(x, y, lit)
            ()

fn draw_text_thumbnail_fallback_bars(image: &mut image::RgbaImage, top: u32, accent: image::Rgba<u8>, shader_mode: Bool):
    let line_count = if shader_mode:
        6
    else:
        6
    for index in 0..line_count:
        let y = top + 14 + index * 20
        if y + 10 >= image.height():
            break
        let width = image.width().saturating_sub(64 + (index as u32 * 11 % 56))
        let text_color = if shader_mode:
            if index % 2 == 0:
                THUMBNAIL_TEXT_COLOR
            else:
                THUMBNAIL_MUTED_TEXT_COLOR
        else if index % 2 == 0:
            THUMBNAIL_TEXT_PAGE_TEXT
        else:
            THUMBNAIL_TEXT_PAGE_COMMENT
        fill_rect(
            image,
            18,
            y,
            30,
            y + 10,
            if shader_mode:
                tint_color(accent, 0.24, 42)
            else:
                accent
        )
        ()
        fill_rect(image, 42, y, 42 + width, y + 10, text_color)
        ()

fn code_thumbnail_syntax_color(line: String) -> image::Rgba<u8>:
    let trimmed = line_.trim_start()
    let lower = trimmed.to_ascii_lowercase()
    if trimmed.is_empty():
        return THUMBNAIL_TEXT_PAGE_COMMENT
    if trimmed.starts_with("//") or trimmed.starts_with("/*") or trimmed.starts_with("*") or trimmed.starts_with("<!--") or trimmed.starts_with("#") or lower.starts_with("rem ") or lower.starts_with("@rem ") or lower.starts_with("::"):
        return THUMBNAIL_TEXT_PAGE_COMMENT
    if lower.starts_with("@echo") or lower.starts_with("echo ") or lower.starts_with("set ") or lower.starts_with("setlocal") or lower.starts_with("endlocal") or lower.starts_with("title ") or lower.starts_with("if ") or lower.starts_with("for ") or lower.starts_with("do ") or lower.starts_with("goto ") or lower.starts_with("call ") or lower.starts_with("powershell") or lower.starts_with("pwsh") or lower.starts_with("cmd") or lower.starts_with("use ") or lower.starts_with("import ") or lower.starts_with("from ") or lower.starts_with("const ") or lower.starts_with("let ") or lower.starts_with("var ") or lower.starts_with("pub ") or lower.starts_with("fn ") or lower.starts_with("def ") or lower.starts_with("class ") or lower.starts_with("export ") or lower.starts_with("type ") or lower.starts_with("interface ") or lower.starts_with("struct ") or lower.starts_with("enum ") or lower.starts_with("function ") or lower.starts_with("param") or lower.starts_with("return ") or lower.starts_with("fn("):
        return THUMBNAIL_TEXT_PAGE_KEYWORD
    if trimmed.contains("\"") or trimmed.contains("'"):
        return THUMBNAIL_TEXT_PAGE_STRING
    if trimmed.chars().any(|character| character.is_ascii_digit()):
        return THUMBNAIL_TEXT_PAGE_NUMBER
    if trimmed.contains(":") or trimmed.contains("=>") or trimmed.contains("->") or trimmed.contains("%") or trimmed.contains("$"):
        return THUMBNAIL_TEXT_PAGE_PROPERTY
    THUMBNAIL_TEXT_PAGE_TEXT

fn collect_text_thumbnail_preview_lines(content: String, max_lines: usize) -> Array<String>:
    content.lines().map(|line| line_.replace("\t", "    ").trim_end().to_string()).filter(|line| !line_.trim().is_empty()).take(max_lines).collect()

fn text_thumbnail_line_color(line: String, accent: image::Rgba<u8>) -> image::Rgba<u8>:
    let trimmed = line_.trim_start()
    if trimmed.is_empty():
        return THUMBNAIL_MUTED_TEXT_COLOR
    if trimmed.starts_with("//") or trimmed.starts_with("/*") or trimmed.starts_with("*") or trimmed.starts_with("<!--"):
        return THUMBNAIL_MUTED_TEXT_COLOR
    if trimmed.starts_with("#"):
        return accent
    if trimmed.starts_with("use ") or trimmed.starts_with("import ") or trimmed.starts_with("from ") or trimmed.starts_with("const ") or trimmed.starts_with("let ") or trimmed.starts_with("pub ") or trimmed.starts_with("fn ") or trimmed.starts_with("def ") or trimmed.starts_with("class ") or trimmed.starts_with("export ") or trimmed.starts_with("return "):
        return THUMBNAIL_TEXT_COLOR
    tint_color(THUMBNAIL_TEXT_COLOR, 0.08, 0)

fn load_thumbnail_font(spec: ThumbnailFontSpec) -> Result<ab_glyph::FontArc, String>:
    let cache = match spec.family:
        fontdb::Family::Monospace => &THUMBNAIL_MONO_FONT_CACHE
        _ => &THUMBNAIL_SANS_FONT_CACHE
    let mut cache_guard = cache.lock().map_err(|_| "Failed to lock thumbnail font cache.".to_string())?
    match cache_guard:
        Some(font) =>
            return Result::Ok(font.clone())
        _ =>
            ()
            ()
    let mut database = Database__new_()
    database.load_system_fonts()
    ()
    let query = fontdb::Query { families: &[spec.family], ..Query__default_() }
    let face_id = database.query(&query).ok_or_else(|| "Failed to locate a system font for thumbnail rendering.".to_string())?
    let face = database.face(face_id).ok_or_else(|| "Resolved thumbnail font face is unavailable.".to_string())?
    let bytes = match &face.source:
        fontdb::Source::Binary(data) => data.to_vec()
        fontdb::Source::File(path) => std__fs__read(path).map_err(|error| format!("Failed to read thumbnail font '{}': {error}", path.display()))?
        fontdb::Source::SharedFile(path, _) => std__fs__read(path).map_err(|error| format!("Failed to read thumbnail font '{}': {error}", path.display()))?
    let font = FontArc__try_from_vec(bytes).map_err(|_| "Failed to decode the system font used for thumbnails.".to_string())?
    *cache_guard = Option::Some(font.clone())
    ()
    Result::Ok(font)

fn draw_text_with_shadow(image: &mut image::RgbaImage, font: &ab_glyph::FontArc, scale: ab_glyph::PxScale, origin: (f32, f32), text: String, color: image::Rgba<u8>):
    let x = origin.field_0.round() as i32
    let y = origin.field_1.round() as i32
    imageproc__drawing__draw_text_mut(image, THUMBNAIL_SHADOW_TEXT_COLOR, x + 1, y + 1, scale, font, text)
    ()
    imageproc__drawing__draw_text_mut(image, color, x, y, scale, font, text)
    ()

fn draw_text_plain(image: &mut image::RgbaImage, font: &ab_glyph::FontArc, scale: ab_glyph::PxScale, origin: (f32, f32), text: String, color: image::Rgba<u8>):
    imageproc__drawing__draw_text_mut(image, color, origin.field_0.round() as i32, origin.field_1.round() as i32, scale, font, text)
    ()

fn draw_rect_outline(image: &mut image::RgbaImage, left: u32, top: u32, right: u32, bottom: u32, color: image::Rgba<u8>):
    fill_rect(image, left, top, right, top.saturating_add(1), color)
    ()
    fill_rect(image, left, bottom.saturating_sub(1), right, bottom, color)
    ()
    fill_rect(image, left, top, left.saturating_add(1), bottom, color)
    ()
    fill_rect(image, right.saturating_sub(1), top, right, bottom, color)
    ()

fn fill_rect(image: &mut image::RgbaImage, left: u32, top: u32, right: u32, bottom: u32, color: image::Rgba<u8>):
    let bounded_right = right.min(image.width())
    let bounded_bottom = bottom.min(image.height())
    for y in top.min(image.height())..bounded_bottom:
        for x in left.min(image.width())..bounded_right:
            image.put_pixel(x, y, color)
            ()

fn draw_vertical_gradient(image: &mut image::RgbaImage, top_color: image::Rgba<u8>, bottom_color: image::Rgba<u8>):
    let height = image.height().max(1)
    for y in 0..image.height():
        let alpha = y as f32 / height as f32
        let row_color = lerp_rgba(top_color, bottom_color, alpha)
        for x in 0..image.width():
            image.put_pixel(x, y, row_color)
            ()

fn fill_rounded_badge(image: &mut image::RgbaImage, left: u32, top: u32, width: u32, height: u32, color: image::Rgba<u8>):
    let radius = (height / 2) as i32
    fill_rect(image, left.saturating_add(radius as u32), top, left.saturating_add(width).saturating_sub(radius as u32), top.saturating_add(height), color)
    ()
    imageproc__drawing__draw_filled_circle_mut(image, (left.saturating_add(radius as u32) as i32, top.saturating_add(radius as u32) as i32), radius, color)
    ()
    imageproc__drawing__draw_filled_circle_mut(image, (left.saturating_add(width).saturating_sub(radius as u32) as i32, top.saturating_add(radius as u32) as i32), radius, color)
    ()

fn truncate_text(text: String, max_chars: usize) -> String:
    let trimmed = text.trim()
    if trimmed.chars().count() <= max_chars:
        return trimmed.to_string()
    let mut output = trimmed.chars().take(max_chars.saturating_sub(1)).collect()
    output.push("…")
    ()
    output

fn truncate_code_thumbnail_line(text: String, max_chars: usize) -> String:
    if max_chars == 0:
        return String__new_()
    let line_ = text.trim_end()
    let char_count = line_.chars().count()
    if char_count <= max_chars:
        return line_.to_string()
    if max_chars == 1:
        return "…".to_string()
    let mut output = line_.chars().take(max_chars - 1).collect()
    output.push("…")
    ()
    output

fn tint_color(color: image::Rgba<u8>, mix: f32, lift: u8) -> image::Rgba<u8>:
    let clamped_mix = mix.clamp(0.0, 1.0)
    let mix_channel = fn(channel: u8) -> u8:
        let mixed = channel as f32 * (1.0 - clamped_mix) + 255.0 * clamped_mix
        mixed.round().clamp(0.0, 255.0) as u8
    image__Rgba([mix_channel(color[0]).saturating_add(lift), mix_channel(color[1]).saturating_add(lift), mix_channel(color[2]).saturating_add(lift), color[3]])

fn brighten_color(color: image::Rgba<u8>, amount: f32) -> image::Rgba<u8>:
    let clamped = amount.clamp(0.0, 1.2)
    image__Rgba([((color[0] as f32) * (1.0 + clamped)).clamp(0.0, 255.0) as u8, ((color[1] as f32) * (1.0 + clamped)).clamp(0.0, 255.0) as u8, ((color[2] as f32) * (1.0 + clamped)).clamp(0.0, 255.0) as u8, color[3]])

fn with_alpha(color: image::Rgba<u8>, alpha: u8) -> image::Rgba<u8>:
    image__Rgba([color[0], color[1], color[2], alpha])

fn lerp_rgba(start: image::Rgba<u8>, end: image::Rgba<u8>, amount: f32) -> image::Rgba<u8>:
    let alpha = amount.clamp(0.0, 1.0)
    let lerp_channel = fn(a: u8, b: u8) -> u8: ((a as f32) + ((b as f32 - a as f32) * alpha)).round().clamp(0.0, 255.0) as u8
    image__Rgba([lerp_channel(start[0], end[0]), lerp_channel(start[1], end[1]), lerp_channel(start[2], end[2]), lerp_channel(start[3], end[3])])

fn dot_vec3(left: (f32, f32, f32), right: (f32, f32, f32)) -> f32:
    (left.field_0 * right.field_0) + (left.field_1 * right.field_1) + (left.field_2 * right.field_2)

fn normalize_vec3(input: (f32, f32, f32)) -> (f32, f32, f32):
    let length = (input.field_0 * input.field_0 + input.field_1 * input.field_1 + input.field_2 * input.field_2).sqrt()
    if length <= f32__EPSILON:
        return (0.0, 0.0, 1.0)
    (input.field_0 / length, input.field_1 / length, input.field_2 / length)

fn reflect_vec3(input: (f32, f32, f32), normal: (f32, f32, f32)) -> (f32, f32, f32):
    let dot = dot_vec3(input, normal)
    (input.field_0 - 2.0 * dot * normal.field_0, input.field_1 - 2.0 * dot * normal.field_1, input.field_2 - 2.0 * dot * normal.field_2)

struct DragPosition:
    x: f64
    y: f64

struct DragEnterPayload:
    paths: Array<String>
    position: DragPosition

struct DragOverPayload:
    position: DragPosition

struct DragDropPayload:
    paths: Array<String>
    position: DragPosition

struct UrlDropPayload:
    urls: Array<String>
    position: DragPosition

fn emit_event(event_name: String, payload: impl Serialize):
    match APP_HANDLE.get():
        Some(app) =>
            let _ = app.emit_to("main", event_name, payload)
        _ => ()

fn to_client_position(hwnd: windows::Win32::Foundation::HWND, pt: &windows::Win32::Foundation::POINTL) -> DragPosition:
    let mut point = windows::Win32::Foundation::POINT { x: (*pt).x, y: (*pt).y }
    let _ = windows::Win32::Graphics::Gdi::ScreenToClient(hwnd, &mut point)
    DragPosition { x: point.x as f64, y: point.y as f64 }

fn extract_file_paths(data_obj: &windows::Win32::System::Com::IDataObject) -> Array<String>:
    let format = windows::Win32::System::Com::FORMATETC { cfFormat: windows::Win32::System::Ole::CF_HDROP.field_0, ptd: std__ptr__null_mut(), dwAspect: windows::Win32::System::Com::DVASPECT_CONTENT.field_0, lindex: -1, tymed: windows::Win32::System::Com::TYMED_HGLOBAL.field_0 as u32 }
    match data_obj.GetData(&format):
        Ok(mut medium) =>
            let hdrop = windows::Win32::UI::Shell::HDROP(medium.u.hGlobal.field_0 as _)
            let item_count = windows::Win32::UI::Shell::DragQueryFileW(hdrop, 4294967295, none)
            let mut paths = Vec__new_()
            for index in 0..item_count:
                let char_count = windows::Win32::UI::Shell::DragQueryFileW(hdrop, index, none) as usize
                let mut buffer = vec!()
                windows::Win32::UI::Shell::DragQueryFileW(hdrop, index, Option::Some(&mut buffer))
                ()
                ()
                let path: std::path::PathBuf = OsString__from_wide(&buffer[0..char_count]).into()
                paths.push(path.to_string_lossy().to_string())
                ()
            ()
            windows::Win32::System::Ole::ReleaseStgMedium(&mut medium)
            ()
            ()
            paths
        Err(_) => Vec__new_()

fn extract_urls(data_obj: &windows::Win32::System::Com::IDataObject) -> Array<String>:
    let mut urls = Vec__new_()
    let format = windows::Win32::System::Com::FORMATETC { cfFormat: windows::Win32::System::Ole::CF_UNICODETEXT.field_0, ptd: std__ptr__null_mut(), dwAspect: windows::Win32::System::Com::DVASPECT_CONTENT.field_0, lindex: -1, tymed: windows::Win32::System::Com::TYMED_HGLOBAL.field_0 as u32 }
    match data_obj.GetData(&format):
        Ok(mut medium) =>
            let hglobal = medium.u.hGlobal
            let ptr = windows::Win32::System::Memory::GlobalLock(hglobal)
            if !std__ptr.is_null():
                let wide_ptr = std__ptr as Ptr<u16>
                let mut len = 0
                while *wide_ptr.add(len) != 0:
                    len = len + 1
                    ()
                ()
                ()
                let slice = std__slice__from_raw_parts(wide_ptr, len)
                let text = String__from_utf16_lossy(slice)
                let _ = windows::Win32::System::Memory::GlobalUnlock(hglobal)
                for line_ in text.lines():
                    let trimmed = line_.trim()
                    if trimmed.starts_with("http://") or trimmed.starts_with("https://"):
                        urls.push(trimmed.to_string())
                        ()
                ()
                ()
            windows::Win32::System::Ole::ReleaseStgMedium(&mut medium)
            ()
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    urls

struct UrlAwareDropTarget:
    hwnd: windows::Win32::Foundation::HWND
    cursor_effect: std::cell::UnsafeCell<windows::Win32::System::Ole::DROPEFFECT>
    is_valid_drag: std::cell::UnsafeCell<Bool>

impl UrlAwareDropTarget:
    fn new_(hwnd: windows::Win32::Foundation::HWND) -> UrlAwareDropTarget:
        UrlAwareDropTarget { hwnd: hwnd, cursor_effect: UnsafeCell__new_(windows::Win32::System::Ole::DROPEFFECT_NONE), is_valid_drag: UnsafeCell__new_(false) }


impl windows::Win32::System::Ole::IDropTarget_Impl for UrlAwareDropTarget_Impl:
    fn DragEnter(_self: &UrlAwareDropTarget_Impl, pDataObj: Option<&windows::Win32::System::Com::IDataObject>, _grfKeyState: windows::Win32::System::SystemServices::MODIFIERKEYS_FLAGS, pt: &windows::Win32::Foundation::POINTL, pdwEffect: PtrMut<windows::Win32::System::Ole::DROPEFFECT>) -> Result<(), Error>:
        let Some(data_obj) = pDataObj
        let position = to_client_position((*_self).hwnd, pt)
        let paths = extract_file_paths(data_obj)
        let urls = extract_urls(data_obj)
        let is_valid = !paths.is_empty() or !urls.is_empty()
        *(*_self).is_valid_drag.get() = is_valid
        ()
        ()
        ()
        ()
        if !is_valid:
            *pdwEffect = windows::Win32::System::Ole::DROPEFFECT_NONE
            ()
            *(*_self).cursor_effect.get() = windows::Win32::System::Ole::DROPEFFECT_NONE
            ()
            ()
            ()
            ()
            return Result::Ok(())
        emit_event("tauri://drag-enter", DragEnterPayload { paths: paths, position: position.clone() })
        ()
        if !urls.is_empty():
            emit_event("app://url-drag-enter", UrlDropPayload { urls: urls, position: position })
            ()
            ()
            ()
            ()
        *pdwEffect = windows::Win32::System::Ole::DROPEFFECT_COPY
        ()
        *(*_self).cursor_effect.get() = windows::Win32::System::Ole::DROPEFFECT_COPY
        ()
        ()
        ()
        ()
        Result::Ok(())

    fn DragOver(_self: &UrlAwareDropTarget_Impl, _grfKeyState: windows::Win32::System::SystemServices::MODIFIERKEYS_FLAGS, pt: &windows::Win32::Foundation::POINTL, pdwEffect: PtrMut<windows::Win32::System::Ole::DROPEFFECT>) -> Result<(), Error>:
        if *(*_self).is_valid_drag.get():
            let position = to_client_position((*_self).hwnd, pt)
            emit_event("tauri://drag-over", DragOverPayload { position: position })
            ()
            ()
            ()
            ()
        *pdwEffect = *(*_self).cursor_effect.get()
        ()
        ()
        Result::Ok(())

    fn DragLeave(_self: &UrlAwareDropTarget_Impl) -> Result<(), Error>:
        if *(*_self).is_valid_drag.get():
            emit_event("tauri://drag-leave", ())
            ()
            ()
            ()
            ()
        Result::Ok(())

    fn Drop(_self: &UrlAwareDropTarget_Impl, pDataObj: Option<&windows::Win32::System::Com::IDataObject>, _grfKeyState: windows::Win32::System::SystemServices::MODIFIERKEYS_FLAGS, pt: &windows::Win32::Foundation::POINTL, _pdwEffect: PtrMut<windows::Win32::System::Ole::DROPEFFECT>) -> Result<(), Error>:
        if !*(*_self).is_valid_drag.get():
            return Result::Ok(())
        let Some(data_obj) = pDataObj
        let position = to_client_position((*_self).hwnd, pt)
        let paths = extract_file_paths(data_obj)
        let urls = extract_urls(data_obj)
        emit_event("tauri://drag-drop", DragDropPayload { paths: paths, position: position.clone() })
        ()
        if !urls.is_empty():
            emit_event("app://url-drop", UrlDropPayload { urls: urls, position: position })
            ()
            ()
            ()
            ()
        Result::Ok(())


fn replace_drop_handlers(container_hwnd: windows::Win32::Foundation::HWND):
    fn enum_callback(hwnd: windows::Win32::Foundation::HWND, _lparam: windows::Win32::Foundation::LPARAM) -> windows::Win32::Foundation::BOOL:
        let target: windows::Win32::System::Ole::IDropTarget = UrlAwareDropTarget__new_(hwnd).into()
        let _ = windows::Win32::System::Ole::RevokeDragDrop(hwnd)
        let _ = windows::Win32::System::Ole::RegisterDragDrop(hwnd, &target)
        true.into()

    let _ = windows::Win32::UI::WindowsAndMessaging::EnumChildWindows(container_hwnd, Option::Some(enum_callback), windows::Win32::Foundation::LPARAM(0))

fn setup(app_handle: &tauri::AppHandle):
    let _ = APP_HANDLE.set(app_handle.clone())
    let window = match app_handle.get_webview_window("main"):
        Some(window) => window
        None => return
    let _ = window.with_webview(
        |webview| block:
            let controller = webview.controller()
            let mut parent_ptr: PtrMut<ffi::c_void> = std__ptr__null_mut()
            if controller.ParentWindow((&mut parent_ptr) as PtrMut<_> as PtrMut<_>).is_ok() and !parent_ptr.is_null():
                let parent_hwnd = windows::Win32::Foundation::HWND(parent_ptr)
                replace_drop_handlers(parent_hwnd)
                ()
    )

enum UsrProfileLaneMode:
    SharedRoot
    ProfileOverlay

impl Default for UsrProfileLaneMode:
    fn default_() -> UsrProfileLaneMode:
        UsrProfileLaneMode::SharedRoot


struct UsrManifestEntry:
    id: String
    relative_directory: String
    env_var_suffix: Option<String>
    bundled: Bool
    bootstrap_to_managed_root: Bool
    profile_mode: UsrProfileLaneMode

struct UsrManifest:
    version: u32
    entries: Array<UsrManifestEntry>

struct ManagedContentRoots:
    bundled_usr_root: String
    writable_root: String

struct InstallerManagedContentProfile:
    managed_content_root: Option<String>
    plugins_directory: Option<String>

fn normalize_env_path(value: Option<String>) -> Option<std::path::PathBuf>:
    value.map(|entry| entry.trim().to_string()).filter(|entry| !entry.is_empty()).map(PathBuf__from)

fn read_first_env_path(var_names: &Slice<String>) -> Option<std::path::PathBuf>:
    for var_name in var_names:
        match normalize_env_path(std__env__var_(var_name).ok()):
            Some(path) =>
                return Option::Some(path)
            _ => ()
    ()
    none

fn resolve_install_root_from_current_executable() -> Option<std::path::PathBuf>:
    std__env__current_exe().ok().and_then(|path| path.parent().map(Path__to_path_buf))

fn resolve_install_profile_path(install_root: &std::path::Path) -> std::path::PathBuf:
    install_root.join(INSTALL_PROFILE_FILE_NAME)

fn resolve_profile_path_value(raw_value: Option<String>, install_root: &std::path::Path) -> Option<std::path::PathBuf>:
    let normalized_value = raw_value.map(str__trim).filter(|value| !value.is_empty())?
    let candidate_path = PathBuf__from(normalized_value)
    if candidate_path.is_absolute():
        Option::Some(candidate_path)
    else:
        Option::Some(install_root.join(candidate_path))

fn resolve_managed_content_root_from_profile_text(profile_text: String, install_root: &std::path::Path) -> Option<std::path::PathBuf>:
    let profile = toml__from_str(profile_text).ok()?
    match resolve_profile_path_value(profile.managed_content_root, install_root):
        Some(explicit_root) =>
            return Option::Some(explicit_root)
        _ =>
            ()
            ()
    let plugins_directory = resolve_profile_path_value(profile.plugins_directory, install_root)?
    plugins_directory.parent().map(Path__to_path_buf)

fn resolve_managed_content_root_from_install_profile() -> Option<std::path::PathBuf>:
    let install_root = resolve_install_root_from_current_executable()?
    let install_profile_path = resolve_install_profile_path(&install_root)
    let install_profile_text = std__fs__read_to_string(install_profile_path).ok()?
    resolve_managed_content_root_from_profile_text(&install_profile_text, &install_root)

fn load_usr_manifest() -> Result<UsrManifest, String>:
    serde_json__from_str(REPO_USR_MANIFEST_TEXT).map_err(|error| format!("Failed to parse usr manifest: {error}"))

fn build_usr_profile_relative_directory(profile_id: String, relative_directory: String) -> std::path::PathBuf:
    PathBuf__from(USR_PROFILES_DIRECTORY_NAME).join(profile_id).join(relative_directory)

fn resolve_shipped_usr_entry_relative_directory(entry: &UsrManifestEntry) -> std::path::PathBuf:
    match (*entry).profile_mode:
        UsrProfileLaneMode::SharedRoot => PathBuf__from(&(*entry).relative_directory)
        UsrProfileLaneMode::ProfileOverlay =>
            build_usr_profile_relative_directory(DEFAULT_USR_PROFILE_ID, &(*entry).relative_directory)

fn resolve_bundled_usr_root(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    match read_first_env_path(&["GREEBLEFS_USR_DIR", "OVERLAYTERM_USR_DIR", "VITE_GREEBLEFS_USR_DIR", "VITE_OVERLAYTERM_USR_DIR"]):
        Some(explicit_root) =>
            return Result::Ok(explicit_root)
        _ =>
            ()
            ()
    match app.path().resource_dir():
        Ok(resource_root) =>
            let bundled_root = resource_root.join("usr")
            if bundled_root.exists():
                return Result::Ok(bundled_root)
            ()
        _ =>
            ()
            ()
    let repo_root = PathBuf__from(env!("CARGO_MANIFEST_DIR")).join("../usr")
    Result::Ok(repo_root)

fn resolve_managed_content_root(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    match read_first_env_path(&["GREEBLEFS_MANAGED_CONTENT_ROOT", "OVERLAYTERM_MANAGED_CONTENT_ROOT"]):
        Some(explicit_root) =>
            return Result::Ok(explicit_root)
        _ =>
            ()
            ()
    match resolve_managed_content_root_from_install_profile():
        Some(installer_managed_root) =>
            return Result::Ok(installer_managed_root)
        _ =>
            ()
            ()
    let app_local_data_root = app.path().app_local_data_dir().map_err(|error| format!("Failed to resolve app local data directory: {error}"))?
    Result::Ok(app_local_data_root.join("usr"))

fn resolve_shared_usr_root(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    if read_first_env_path(&["GREEBLEFS_MANAGED_CONTENT_ROOT", "OVERLAYTERM_MANAGED_CONTENT_ROOT"]).is_some():
        return resolve_managed_content_root(app)
    if cfg!(debug_assertions):
        return resolve_bundled_usr_root(app)
    resolve_managed_content_root(app)

fn copy_missing_entries(source: &std::path::Path, target: &std::path::Path) -> Result<(), String>:
    let metadata = std__fs__metadata(source).map_err(|error| format!("Failed to inspect {}: {error}", source.display()))?
    if metadata.is_dir():
        std__fs__create_dir_all(target).map_err(|error| format!("Failed to create {}: {error}", target.display()))?
        ()
        for child in std__fs__read_dir(source).map_err(|error| format!("Failed to read {}: {error}", source.display()))?:
            let child = child.map_err(|error| format!("Failed to read directory entry: {error}"))?
            let child_source = child.path()
            let child_target = target.join(child.file_name())
            copy_missing_entries(&child_source, &child_target)?
            ()
        ()
        return Result::Ok(())
    if target.exists():
        return Result::Ok(())
    match target.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create {}: {error}", parent.display()))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    std__fs__copy(source, target).map_err(|error| format!("Failed to copy shipped usr file {} -> {}: {error}", source.display(), target.display()))?
    ()
    Result::Ok(())

fn bootstrap_usr_content(app: &tauri::AppHandle) -> Result<(), String>:
    let manifest = load_usr_manifest()?
    let source_root = resolve_bundled_usr_root(app)?
    let target_root = resolve_managed_content_root(app)?
    std__fs__create_dir_all(&target_root).map_err(|error| format!("Failed to create {}: {error}", target_root.display()))?
    ()
    let source_manifest_path = source_root.join("manifest.json")
    let target_manifest_path = target_root.join("manifest.json")
    if source_manifest_path.exists():
        copy_missing_entries(&source_manifest_path, &target_manifest_path)?
        ()
        ()
        ()
        ()
    for entry in manifest.entries.iter().filter(|entry| entry.bundled and entry.bootstrap_to_managed_root):
        let relative_path = resolve_shipped_usr_entry_relative_directory(entry)
        let source_path = source_root.join(&relative_path)
        if !source_path.exists():
            continue
        let target_path = target_root.join(&relative_path)
        copy_missing_entries(&source_path, &target_path)?
        ()
    ()
    Result::Ok(())

fn resolve_usr_relative_path(app: &tauri::AppHandle, relative_path: String) -> Result<std::path::PathBuf, String>:
    let writable_path = (resolve_managed_content_root(app)?).join(relative_path)
    if writable_path.exists():
        return Result::Ok(writable_path)
    let bundled_path = (resolve_bundled_usr_root(app)?).join(relative_path)
    if bundled_path.exists():
        return Result::Ok(bundled_path)
    Result::Err(format!("Managed usr path was not found in either the writable root or bundled usr payload: {relative_path}"))

fn read_usr_text_file(app: &tauri::AppHandle, relative_path: String) -> Result<String, String>:
    let path = resolve_usr_relative_path(app, relative_path)?
    std__fs__read_to_string(&path).map_err(|error| format!("Failed to read {}: {error}", path.display()))

struct UsrProfileSummary:
