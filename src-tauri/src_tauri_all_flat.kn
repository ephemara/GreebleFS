struct AudioTaskRuntime:
    cancelled: std::sync::atomic::AtomicBool
    child: Option<std::process::Child>

struct NormalizedAudioTransformRequest:
    input_path: std::path::PathBuf
    final_output_path: std::path::PathBuf
    overwrite_existing: Bool
    mode: AudioTransformMode
    trim_start_seconds: Option<f64>
    trim_end_seconds: Option<f64>
    fade_in_seconds: Option<f64>
    fade_out_seconds: Option<f64>
    pitch_shift_cents: Option<f64>
    gain_linear: Option<f64>
    rate_multiplier: Option<f64>
    normalize: Bool
    output_format: String
    generate_spectrogram: Bool
    overwrite_original: Bool

fn audio_tasks() -> &Map<String, AudioTaskRuntime>:
    AUDIO_TASKS.get_or_init(|| Mutex__new_(HashMap__new_()))

fn path_to_string(path: &std::path::Path) -> String:
    path.to_string_lossy().to_string()

fn normalize_optional_string(value: Option<String>) -> Option<String>:
    value.map(str__trim).filter(|candidate| !candidate.is_empty()).map(ToOwned__to_owned)

fn normalize_audio_format(value: String) -> String:
    match value.trim().trim_start_matches(".").to_ascii_lowercase().as_str():
        "wave" => "wav".to_string()
        "vorbis" => "ogg".to_string()
        other => other.to_string()

fn input_audio_extension(input_path: &std::path::Path) -> Option<String>:
    input_path.extension().and_then(|value| value.to_str()).map(normalize_audio_format).filter(|value| !value.is_empty())

fn resolve_ffmpeg_binary() -> String:
    std__env__var_("FFMPEG_BIN").ok().map(|value| value.trim().to_string()).filter(|value| !value.is_empty()).unwrap_or_else(|| DEFAULT_FFMPEG_BINARY.to_string())

fn ffmpeg_command() -> std::process::Command:
    Command__new_(resolve_ffmpeg_binary())

fn spawn_ffmpeg_and_wait(task_runtime: Option<&AudioTaskRuntime>, command: std::process::Command) -> Result<process::Output, String>:
    command.stdout(Stdio__piped()).stderr(Stdio__piped())
    ()
    command.creation_flags(CREATE_NO_WINDOW)
    ()
    ()
    ()
    ()
    let child = command.spawn_().map_err(|error| format!("Failed to launch ffmpeg at '{}': {error}", resolve_ffmpeg_binary()))?
    match task_runtime:
        Some(task_runtime) =>
            let mut child_guard = task_runtime.child.lock().unwrap()
            *child_guard = none
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let output = child.wait_with_output().map_err(|error| format!("Failed to launch ffmpeg at '{}': {error}", resolve_ffmpeg_binary()))?
    match task_runtime:
        Some(task_runtime) =>
            if task_runtime.cancelled.load(std::sync::atomic::Ordering::SeqCst):
                return Result::Err("Cancelled".to_string())
            ()
        _ =>
            ()
            ()
    Result::Ok(output)

fn build_audio_temp_path(input_path: &std::path::Path, suffix: String, output_format: String) -> std::path::PathBuf:
    let parent = input_path.parent().unwrap_or_else(|| Path__new_(""))
    let stem = input_path.file_stem().and_then(|value| value.to_str()).unwrap_or("audio")
    parent.join(format!("{stem}.greeblefs-{suffix}.{}", normalize_audio_format(output_format)))

fn normalize_audio_transform_request(request: AudioTransformRequest) -> Result<NormalizedAudioTransformRequest, String>:
    let input_path = PathBuf__from(request.input_path.trim())
    if request.input_path.trim().is_empty():
        return Result::Err("Input audio path cannot be empty.".to_string())
    if !input_path.exists():
        return Result::Err(format!("Input audio does not exist: {}", input_path.display()))
    if !input_path.is_file():
        return Result::Err(format!("Input audio path is not a file: {}", input_path.display()))
    let trim_start_seconds = request.trim_start_seconds.filter(|value| value.is_finite() and *value >= 0.0)
    let trim_end_seconds = request.trim_end_seconds.filter(|value| value.is_finite() and *value > 0.0)
    match (trim_start_seconds, trim_end_seconds):
        (Some(start), Some(end)) =>
            if end <= start:
                return Result::Err("Trim end must be greater than trim start.".to_string())
            ()
        _ =>
            ()
            ()
    let fade_in_seconds = request.fade_in_seconds.filter(|value| value.is_finite() and *value >= 0.0)
    let fade_out_seconds = request.fade_out_seconds.filter(|value| value.is_finite() and *value >= 0.0)
    let pitch_shift_cents = request.pitch_shift_cents.and_then(
        |value| if value.is_finite() and value.abs() <= 2400.0:
            Option::Some(value)
        else:
            none
    )
    let mode = request.mode.clone()
    let overwrite_original = matches!(mode, AudioTransformMode::OverwriteOriginal)
    let source_extension = input_audio_extension(&input_path)
    let mut output_format = normalize_optional_string(request.output_format).map(|value| normalize_audio_format(&value)).unwrap_or_else(
        || match mode:
            AudioTransformMode::OverwriteOriginal =>
                input_audio_extension(&input_path).unwrap_or_else(|| "wav".to_string())
            _ => "wav".to_string()
    )
    if overwrite_original:
        match source_extension:
            Some(source_extension) =>
                output_format = source_extension.to_string()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    let requested_output_path = request.output_path.map(str__trim).filter(|candidate| !candidate.is_empty()).map(PathBuf__from)
    let final_output_path = requested_output_path.unwrap_or_else(
        || block:
            let parent = input_path.parent().unwrap_or_else(|| Path__new_(""))
            let stem = input_path.file_stem().and_then(|value| value.to_str()).unwrap_or("audio")
            let suffix = match mode:
                AudioTransformMode::ExportClip => "clip"
                AudioTransformMode::ExportNormalized => "normalized"
                AudioTransformMode::ConvertFormat => "converted"
                AudioTransformMode::OverwriteOriginal => "edited"
            parent.join(format!("{stem}.{suffix}.{output_format}"))
    )
    let output_path = if overwrite_original:
        build_audio_temp_path(&input_path, "overwrite-stage", output_format.as_str())
    else:
        final_output_path.clone()
    if !overwrite_original and std__fs__canonicalize(&input_path).ok() == std__fs__canonicalize(&output_path).ok():
        return Result::Err("Audio export must write to a different output path unless overwrite-original is selected.".to_string())
    match output_path.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create output directory '{}': {error}", parent.display()))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    if !overwrite_original and output_path.exists() and !request.overwrite_existing:
        return Result::Err(format!("Output path already exists and overwrite is disabled: {}", output_path.display()))
    Result::Ok(NormalizedAudioTransformRequest { input_path: input_path, final_output_path: final_output_path, overwrite_existing: request.overwrite_existing, mode: mode.clone(), trim_start_seconds: trim_start_seconds, trim_end_seconds: trim_end_seconds, fade_in_seconds: fade_in_seconds, fade_out_seconds: fade_out_seconds, pitch_shift_cents: pitch_shift_cents, gain_linear: request.gain_linear.filter(|value| value.is_finite() and *value > 0.0), rate_multiplier: request.rate_multiplier.filter(|value| value.is_finite() and *value > 0.0), normalize: request.normalize.unwrap_or(matches!(mode, AudioTransformMode::ExportNormalized)), output_format: output_format, generate_spectrogram: request.generate_spectrogram.unwrap_or(false), overwrite_original: overwrite_original })

fn build_audio_transform_registration(request: &NormalizedAudioTransformRequest) -> ExplorerTaskRegistration:
    let title = match (*request).mode:
        AudioTransformMode::ExportClip => "Export Audio Clip"
        AudioTransformMode::ExportNormalized => "Export Normalized Audio"
        AudioTransformMode::ConvertFormat => "Convert Audio Format"
        AudioTransformMode::OverwriteOriginal => "Overwrite Audio Original"
    let fallback_name = path_to_string(&(*request).input_path)
    let file_name = (*request).input_path.file_name().and_then(|value| value.to_str()).map(ToOwned__to_owned).unwrap_or(fallback_name)
    ExplorerTaskRegistration { kind: ExplorerTaskKind::AudioTransform, title: title.to_string(), detail: format!("Processing {file_name}"), source_paths: vec!(path_to_string(&(*request).input_path)), destination_path: Option::Some(path_to_string(&(*request).final_output_path)), retry_context: Option::Some(ExplorerTaskRetryContext::AudioTransform { request: AudioTransformRequest { input_path: path_to_string(&(*request).input_path), output_path: Option::Some(path_to_string(&(*request).final_output_path)), overwrite_existing: (*request).overwrite_existing, mode: (*request).mode.clone(), trim_start_seconds: (*request).trim_start_seconds, trim_end_seconds: (*request).trim_end_seconds, fade_in_seconds: (*request).fade_in_seconds, fade_out_seconds: (*request).fade_out_seconds, pitch_shift_cents: (*request).pitch_shift_cents, gain_linear: (*request).gain_linear, rate_multiplier: (*request).rate_multiplier, normalize: Option::Some((*request).normalize), output_format: Option::Some((*request).output_format.clone()), generate_spectrogram: Option::Some((*request).generate_spectrogram) } }), can_undo: false }

fn register_audio_runtime(task_id: String) -> Result<AudioTaskRuntime, String>:
    let runtime = Arc__new_(AudioTaskRuntime { cancelled: AtomicBool__new_(false), child: Mutex__new_(none) })
    let mut tasks = audio_tasks().lock().map_err(|_| "Audio task registry lock was poisoned.".to_string())?
    tasks.insert(task_id.to_string(), runtime.clone())
    ()
    Result::Ok(runtime)

fn unregister_audio_runtime(task_id: String):
    match audio_tasks().lock():
        Ok(mut tasks) =>
            tasks.remove(task_id)
            ()
        _ => ()

fn cancel_audio_task(task_id: String) -> Result<(), String>:
    let runtime = (audio_tasks().lock().map_err(|_| "Audio task registry lock was poisoned.".to_string())?).get(task_id).cloned().ok_or_else(|| format!("Audio task runtime not found: {task_id}"))?
    runtime.cancelled.store(true, std::sync::atomic::Ordering::SeqCst)
    ()
    match runtime.child.lock():
        Ok(mut child_guard) =>
            match child_guard:
                Some(child) =>
                    let _ = child.kill()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn execute_audio_transform(_app: &tauri::AppHandle, task_id: String, request: NormalizedAudioTransformRequest) -> Result<AudioTransformResult, String>:
    let task_runtime = register_audio_runtime(task_id)?
    let run_result = || block:
        fs_commands__update_manual_explorer_task(task_id, Option::Some("Preparing FFmpeg transform…".to_string()), Option::Some(0), Option::Some(3))?
        ()
        let mut command = ffmpeg_command()
        command.args(["-hide_banner", "-loglevel", "error"])
        ()
        command.arg(
            if request.overwrite_existing or request.overwrite_original:
                "-y"
            else:
                "-n"
        )
        ()
        match request.trim_start_seconds:
            Some(start) =>
                command.args(["-ss", &format!("{start:.6}")])
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match request.trim_end_seconds:
            Some(end) =>
                command.args(["-to", &format!("{end:.6}")])
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        command.args(["-i", &path_to_string(&request.input_path)])
        ()
        let mut filters = Vec__new_()
        if request.normalize:
            match audio_engine__analyze_audio_file_native(&request.input_path):
                Ok(analysis) =>
                    if analysis.peak_level > 0.0:
                        let mut gain = 1.0 / analysis.peak_level
                        match request.gain_linear:
                            Some(linear) =>
                                gain = gain * linear
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        filters.push(format!("volume={gain:.6}"))
                        ()
                        ()
                        ()
                        ()
                    ()
                _ =>
                    ()
                    ()
            ()
        else:
            match request.gain_linear:
                Some(gain_linear) =>
                    if (gain_linear - 1.0).abs() > 0.001:
                        filters.push(format!("volume={gain_linear:.6}"))
                        ()
                        ()
                        ()
                        ()
                    ()
                _ =>
                    ()
                    ()
            ()
        match request.rate_multiplier:
            Some(rate) =>
                if (rate - 1.0).abs() > 0.001:
                    filters.push(format!("atempo={rate:.6}"))
                    ()
                    ()
                    ()
                    ()
                ()
            _ =>
                ()
                ()
        match request.pitch_shift_cents.filter(|value| value.abs() > f64__EPSILON):
            Some(pitch_shift_cents) =>
                let ratio = 2.0.powf(pitch_shift_cents / 1200.0)
                match audio_engine__analyze_audio_file_native(&request.input_path):
                    Ok(analysis) =>
                        match analysis.sample_rate_hz:
                            Some(sr) =>
                                filters.push(format!("asetrate={}*{}", sr, ratio))
                                ()
                                filters.push(format!("aresample={}", sr))
                                ()
                                filters.push(format!("atempo={}", 1.0 / ratio))
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        if request.fade_in_seconds.is_some() or request.fade_out_seconds.is_some():
            let fade_in = request.fade_in_seconds.unwrap_or(0.0)
            let fade_out = request.fade_out_seconds.unwrap_or(0.0)
            if fade_in > 0.0:
                filters.push(format!("afade=t=in:ss=0:d={fade_in:.6}"))
                ()
                ()
                ()
                ()
            if fade_out > 0.0:
                match request.trim_end_seconds:
                    Some(end) =>
                        let trim_start = request.trim_start_seconds.unwrap_or(0.0)
                        let clip_dur = end - trim_start
                        filters.push(format!("afade=t=out:st={}:d={}", clip_dur - fade_out, fade_out))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        match audio_engine__analyze_audio_file_native(&request.input_path):
                            Ok(analysis) =>
                                filters.push(format!("afade=t=out:st={}:d={}", analysis.duration_seconds - fade_out, fade_out))
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                ()
            ()
        if !filters.is_empty():
            command.arg("-af").arg(filters.join(","))
            ()
            ()
            ()
            ()
        if request.output_format == "mp3":
            command.args(["-codec:a", "libmp3lame", "-q:a", "2"])
            ()
            ()
            ()
            ()
        else if request.output_format == "ogg" or request.output_format == "vorbis":
            command.args(["-codec:a", "libvorbis", "-q:a", "4"])
            ()
            ()
            ()
            ()
        else if request.output_format == "wav":
            command.args(["-codec:a", "pcm_s16le"])
            ()
            ()
            ()
            ()
        let working_output_path = if request.overwrite_original:
            build_audio_temp_path(&request.input_path, "overwrite-working", &request.output_format)
        else:
            request.final_output_path.clone()
        command.arg(&working_output_path)
        ()
        let output = spawn_ffmpeg_and_wait(Option::Some(&task_runtime), command)?
        if !output.status.success():
            let message = String__from_utf8_lossy(&output.stderr).trim().to_string()
            return Result::Err(if message.is_empty():
                format!("FFmpeg exited with status {}", output.status)
            else:
                format!("Audio transform failed: {message}"))
        fs_commands__update_manual_explorer_task(task_id, Option::Some("Writing transform output…".to_string()), Option::Some(2), Option::Some(3))?
        ()
        if request.overwrite_original:
            if request.final_output_path.exists():
                let _ = std__fs__remove_file(&request.final_output_path)
                ()
            std__fs__rename(&working_output_path, &request.final_output_path).or_else(|_| std__fs__copy(&working_output_path, &request.final_output_path).map(|_| ()).and_then(|_| std__fs__remove_file(&working_output_path))).map_err(|e| format!("Failed to overwrite original file: {e}"))?
            ()
            ()
            ()
            ()
        let spectrogram_path = if request.generate_spectrogram:
            let path = request.final_output_path.with_extension(format!("{}.spectrogram.png", request.output_format))
            let gpu_spectrogram = gpu_runtime__global_gpu_runtime().and_then(|gpu_runtime| audio_engine__decode_audio_preview_mono_samples(&request.final_output_path).ok().and_then(|__kain_closure_arg0| gpu_runtime.render_audio_spectrogram(&__kain_closure_arg0.__kain_tuple_0, 1024, 256).ok()))
            match gpu_spectrogram:
                Some(spectrogram_image) =>
                    image::DynamicImage::ImageRgba8(spectrogram_image).save_with_format(&path, image::ImageFormat::Png).map_err(|error| format!("Spectrogram export failed: {error}"))?
                    ()
                    ()
                    ()
                    ()
                _ =>
                    let mut spectrogram = ffmpeg_command()
                    spectrogram.args(["-hide_banner", "-loglevel", "error", "-y"])
                    ()
                    spectrogram.args(["-i", &path_to_string(&request.final_output_path)])
                    ()
                    spectrogram.args(["-lavfi", "showspectrumpic=s=1024x256"])
                    ()
                    spectrogram.arg(&path)
                    ()
                    let spectrogram_output = spawn_ffmpeg_and_wait(Option::Some(&task_runtime), spectrogram)?
                    if !spectrogram_output.status.success():
                        let message = String__from_utf8_lossy(&spectrogram_output.stderr).trim().to_string()
                        return Result::Err(format!("Spectrogram export failed: {message}"))
                    ()
            Option::Some(path_to_string(&path))
        else:
            none
        fs_commands__update_manual_explorer_task(task_id, Option::Some("Finalizing audio transform…".to_string()), Option::Some(3), Option::Some(3))?
        ()
        let mut out_duration = none
        match audio_engine__analyze_audio_file_native(&request.final_output_path):
            Ok(analysis) =>
                out_duration = Option::Some(analysis.duration_seconds)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let result = AudioTransformResult { task_id: task_id.to_string(), output_path: path_to_string(&request.final_output_path), spectrogram_path: spectrogram_path, duration_seconds: out_duration, output_format: request.output_format.clone(), overwritten_original: request.overwrite_original, sox_binary: resolve_ffmpeg_binary() }
        fs_commands__complete_manual_explorer_task(task_id, Option::Some(format!("Saved audio output to {}", request.final_output_path.display())), none)?
        ()
        Result::Ok(result)()
    unregister_audio_runtime(task_id)
    ()
    match &run_result:
        Err(error) =>
            if error == "Cancelled":
                let _ = fs_commands__cancel_manual_explorer_task(task_id, Option::Some("Cancelled audio transform.".to_string()))
                ()
            else:
                let _ = fs_commands__fail_manual_explorer_task(task_id, error.clone())
                ()
            ()
        _ =>
            ()
            ()
    run_result

fn execute_audio_batch_process(_app: &tauri::AppHandle, _task_id: String, _request: AudioBatchProcessRequest) -> Result<AudioBatchProcessResult, String>:
    Result::Err("Batch Process over FFmpeg is not yet fully implemented in this phase.".to_string())

fn audio_analyze_preview(app: tauri::AppHandle, input_path: String) -> Result<AudioPreviewAnalysis, String>:
    (await tauri__async_runtime__spawn_blocking(
        || block:
            let trimmed = input_path.trim()
            if trimmed.is_empty():
                return Result::Err("Input audio path cannot be empty.".to_string())
            let input = PathBuf__from(trimmed)
            if !input.exists() or !input.is_file():
                return Result::Err(format!("Input audio does not exist: {}", input.display()))
            audio_engine__analyze_audio_preview_for_app(&app, &input, gpu_runtime__global_gpu_runtime())
    )).map_err(|error| format!("Audio preview analysis task failed to join: {error}"))?

fn audio_export_transform(app: tauri::AppHandle, request: AudioTransformRequest) -> Result<AudioTransformResult, String>:
    let normalized_request = normalize_audio_transform_request(request)?
    let task_id = format!("audio-transform-{}", Uuid__new_v4())
    fs_commands__create_manual_explorer_task_with_id(task_id.clone(), build_audio_transform_registration(&normalized_request))
    ()
    fs_commands__set_manual_explorer_task_cancel_context(&task_id, ExplorerTaskCancelContext::AudioOperation { operation_id: task_id.clone() })?
    ()
    (await tauri__async_runtime__spawn_blocking(|| execute_audio_transform(&app, &task_id, normalized_request))).map_err(|error| format!("Audio transform task failed to join: {error}"))?

fn audio_batch_process(app: tauri::AppHandle, request: AudioBatchProcessRequest) -> Result<AudioBatchProcessResult, String>:
    let task_id = format!("audio-batch-{}", Uuid__new_v4())
    (await tauri__async_runtime__spawn_blocking(|| execute_audio_batch_process(&app, &task_id, request))).map_err(|error| format!("Audio batch task failed to join: {error}"))?

enum AudioDeckId:
    A
    B

struct AudioEngineLoopRegion:
    start_seconds: f64
    end_seconds: f64
    enabled: Bool

struct AudioDeckState:
    deck_id: AudioDeckId
    loaded_path: Option<String>
    loaded_name: Option<String>
    duration_seconds: f64
    current_time_seconds: f64
    gain_linear: f64
    rate: f64
    is_playing: Bool
    is_loading: Bool
    is_buffering: Bool
    peak_meter_linear: f64
    rms_meter_linear: f64
    loop_region: AudioEngineLoopRegion
    error: Option<String>
    active_plugin_path: Option<String>
    vst_parameters: Array<VstParameterState>

struct VstParameterState:
    id: u32
    title: String
    short_title: String
    units: String
    default_normalized: f64
    min: f64
    max: f64
    value_normalized: f64

struct AudioEngineStateSnapshot:
    ready: Bool
    engine_error: Option<String>
    armed_deck: AudioDeckId
    output_sample_rate_hz: Option<u32>
    output_channels: Option<u16>
    decks: Array<AudioDeckState>

struct AudioEngineStateEvent:
    state: AudioEngineStateSnapshot

struct AudioEngineLoadDeckRequest:
    deck_id: AudioDeckId
    input_path: String

struct AudioEngineLoadPluginRequest:
    deck_id: AudioDeckId
    plugin_path: String

struct AudioEngineSetPluginParameterRequest:
    deck_id: AudioDeckId
    parameter_id: u32
    value_normalized: f64

struct AudioEngineDeckRequest:
    deck_id: AudioDeckId

struct AudioEngineSeekRequest:
    deck_id: AudioDeckId
    position_seconds: f64

struct AudioEngineLoopRegionRequest:
    deck_id: AudioDeckId
    start_seconds: f64
    end_seconds: f64
    enabled: Bool

struct AudioEngineGainRequest:
    deck_id: AudioDeckId
    gain_linear: f64

struct AudioEngineRateRequest:
    deck_id: AudioDeckId
    rate: f64

struct AudioEngineSetArmedDeckRequest:
    deck_id: AudioDeckId

struct AudioEngineSyncSelectionRequest:
    input_path: String

struct AudioEngineManager:
    runtime: Option<AudioEngineRuntimeHost>

impl Default for AudioEngineManager:
    fn default_() -> AudioEngineManager:
        AudioEngineManager { runtime: none }


struct AudioEngineRuntimeHost:
    shared_: AudioEngineSharedState
    stream: cpal::Stream

struct AudioEngineSharedState:
    app_handle: tauri::AppHandle
    device_sample_rate_hz: u32
    output_channels: u16
    ready: std::sync::atomic::AtomicBool
    armed_deck: std::sync::atomic::AtomicU8
    engine_error: Option<String>
    decks: Array<AudioDeckRuntime>

struct AudioDeckRuntime:
    deck_id: AudioDeckId
    clip: arc_swap::ArcSwapOption<AudioClip>
    metadata: AudioDeckMetadata
    vst_host: Option<DeckVstRuntime>
    is_playing: std::sync::atomic::AtomicBool
    is_loading: std::sync::atomic::AtomicBool
    position_frames: std::sync::atomic::AtomicU64
    gain_linear: std::sync::atomic::AtomicU64
    playback_rate: std::sync::atomic::AtomicU64
    loop_enabled: std::sync::atomic::AtomicBool
    loop_start_frames: std::sync::atomic::AtomicU64
    loop_end_frames: std::sync::atomic::AtomicU64
    peak_meter_linear: std::sync::atomic::AtomicU64
    rms_meter_linear: std::sync::atomic::AtomicU64
    load_generation: std::sync::atomic::AtomicU64

struct AudioDeckMetadata:
    loaded_path: Option<String>
    loaded_name: Option<String>
    duration_seconds: f64
    is_buffering: Bool
    error: Option<String>
    active_plugin_path: Option<String>
    vst_parameters: Array<VstParameterState>

impl Default for AudioDeckMetadata:
    fn default_() -> AudioDeckMetadata:
        AudioDeckMetadata { loaded_path: none, loaded_name: none, duration_seconds: 0.0, is_buffering: false, error: none, active_plugin_path: none, vst_parameters: Vec__new_() }


struct DeckVstRuntime:
    plugin_path: String
    host: vst_host::HeadlessVstHost

struct AudioClip:
    path: String
    name: String
    sample_rate_hz: u32
    channels: usize
    frames: usize
    samples: Array<f32>

struct DecodedAudioData:
    sample_rate_hz: u32
    channels: usize
    frames: usize
    samples: Array<f32>

struct TemporaryAudioFile:
    path: std::path::PathBuf

impl TemporaryAudioFile:
    fn new_(path: std::path::PathBuf) -> TemporaryAudioFile:
        TemporaryAudioFile { path: path }


impl Drop for TemporaryAudioFile:
    fn drop(_self: &mut TemporaryAudioFile):
        let _ = std__fs__remove_file(&(*_self).path)


fn resolve_audio_ffmpeg_binary() -> String:
    std__env__var_("FFMPEG_BIN").ok().map(|value| value.trim().to_string()).filter(|value| !value.is_empty()).unwrap_or_else(|| DEFAULT_AUDIO_FFMPEG_BINARY.to_string())

fn build_vst_parameter_state_snapshot_from_host(host: &vst_host::HeadlessVstHost) -> Result<Array<VstParameterState>, String>:
    Result::Ok((host.parameter_snapshot()?).iter().map(|parameter| VstParameterState { id: parameter.id, title: parameter.title.clone(), short_title: parameter.short_title.clone(), units: parameter.units.clone(), default_normalized: parameter.default_normalized, min: parameter.min, max: parameter.max, value_normalized: parameter.value_normalized }).collect())

impl AudioDeckRuntime:
    fn new_(deck_id: AudioDeckId) -> AudioDeckRuntime:
        AudioDeckRuntime { deck_id: deck_id, clip: ArcSwapOption__default_(), metadata: Mutex__new_(AudioDeckMetadata__default_()), vst_host: Mutex__new_(none), is_playing: AtomicBool__new_(false), is_loading: AtomicBool__new_(false), position_frames: AtomicU64__new_(0.0.to_bits()), gain_linear: AtomicU64__new_(DEFAULT_GAIN_LINEAR.to_bits()), playback_rate: AtomicU64__new_(DEFAULT_RATE.to_bits()), loop_enabled: AtomicBool__new_(false), loop_start_frames: AtomicU64__new_(0.0.to_bits()), loop_end_frames: AtomicU64__new_(0.0.to_bits()), peak_meter_linear: AtomicU64__new_(0.0.to_bits()), rms_meter_linear: AtomicU64__new_(0.0.to_bits()), load_generation: AtomicU64__new_(0) }

    fn clear_loaded_clip(_self: &AudioDeckRuntime):
        (*_self).clip.store(none)
        ()
        (*_self).is_playing.store(false, std::sync::atomic::Ordering::Relaxed)
        ()
        set_atomic_f64(&(*_self).position_frames, 0.0)
        ()
        (*_self).loop_enabled.store(false, std::sync::atomic::Ordering::Relaxed)
        ()
        set_atomic_f64(&(*_self).loop_start_frames, 0.0)
        ()
        set_atomic_f64(&(*_self).loop_end_frames, 0.0)
        ()
        set_atomic_f64(&(*_self).peak_meter_linear, 0.0)
        ()
        set_atomic_f64(&(*_self).rms_meter_linear, 0.0)
        ()


impl AudioEngineSharedState:
    fn new_(app_handle: tauri::AppHandle, device_sample_rate_hz: u32, output_channels: u16) -> AudioEngineSharedState:
        AudioEngineSharedState { app_handle: app_handle, device_sample_rate_hz: device_sample_rate_hz, output_channels: output_channels, ready: AtomicBool__new_(false), armed_deck: AtomicU8__new_(AudioDeckId::A.as_index() as u8), engine_error: Mutex__new_(none), decks: [AudioDeckRuntime__new_(AudioDeckId::A), AudioDeckRuntime__new_(AudioDeckId::B)] }

    fn deck(_self: &AudioEngineSharedState, deck_id: AudioDeckId) -> &AudioDeckRuntime:
        &(*_self).decks[deck_id.as_index()]

    fn armed_deck(_self: &AudioEngineSharedState) -> AudioDeckId:
        AudioDeckId__from_index((*_self).armed_deck.load(std::sync::atomic::Ordering::Relaxed) as usize)

    fn emit_state(_self: &AudioEngineSharedState):
        let _ = AudioEngineStateEvent { state: (*_self).snapshot() }.emit_(&(*_self).app_handle)

    fn snapshot(_self: &AudioEngineSharedState) -> AudioEngineStateSnapshot:
        AudioEngineStateSnapshot { ready: (*_self).ready.load(std::sync::atomic::Ordering::Relaxed), engine_error: (*_self).engine_error.lock().ok().and_then(|message| message.clone()), armed_deck: (*_self).armed_deck(), output_sample_rate_hz: Option::Some((*_self).device_sample_rate_hz), output_channels: Option::Some((*_self).output_channels), decks: (*_self).decks.iter().map(|deck| (*_self).deck_snapshot(deck)).collect() }

    fn deck_snapshot(_self: &AudioEngineSharedState, deck: &AudioDeckRuntime) -> AudioDeckState:
        let metadata = (*deck).metadata.lock().map(|guard| guard.clone()).unwrap_or_default()
        let current_time_seconds = atomic_f64(&(*deck).position_frames) / (*_self).device_sample_rate_hz as f64
        let loop_region = AudioEngineLoopRegion { start_seconds: atomic_f64(&(*deck).loop_start_frames) / (*_self).device_sample_rate_hz as f64, end_seconds: atomic_f64(&(*deck).loop_end_frames) / (*_self).device_sample_rate_hz as f64, enabled: (*deck).loop_enabled.load(std::sync::atomic::Ordering::Relaxed) }
        AudioDeckState { deck_id: (*deck).deck_id, loaded_path: metadata.loaded_path, loaded_name: metadata.loaded_name, duration_seconds: metadata.duration_seconds, current_time_seconds: current_time_seconds, gain_linear: atomic_f64(&(*deck).gain_linear), rate: atomic_f64(&(*deck).playback_rate), is_playing: (*deck).is_playing.load(std::sync::atomic::Ordering::Relaxed), is_loading: (*deck).is_loading.load(std::sync::atomic::Ordering::Relaxed), is_buffering: metadata.is_buffering, peak_meter_linear: atomic_f64(&(*deck).peak_meter_linear), rms_meter_linear: atomic_f64(&(*deck).rms_meter_linear), loop_region: loop_region, error: metadata.error, active_plugin_path: metadata.active_plugin_path, vst_parameters: metadata.vst_parameters }


impl AudioDeckId:
    fn as_index(_self: AudioDeckId) -> usize:
        match _self:
            AudioDeckId::A => 0
            AudioDeckId::B => 1

    fn from_index(value: usize) -> AudioDeckId:
        match value:
            1 => AudioDeckId::B
            _ => AudioDeckId::A


fn atomic_f64(value: &std::sync::atomic::AtomicU64) -> f64:
    f64__from_bits(value.load(std::sync::atomic::Ordering::Relaxed))

fn set_atomic_f64(target: &std::sync::atomic::AtomicU64, value: f64):
    target.store(value.to_bits(), std::sync::atomic::Ordering::Relaxed)
    ()

fn default_audio_engine_state_snapshot() -> AudioEngineStateSnapshot:
    AudioEngineStateSnapshot { ready: false, engine_error: none, armed_deck: AudioDeckId::A, output_sample_rate_hz: none, output_channels: none, decks: vec!(AudioDeckState { deck_id: AudioDeckId::A, loaded_path: none, loaded_name: none, duration_seconds: 0.0, current_time_seconds: 0.0, gain_linear: DEFAULT_GAIN_LINEAR, rate: DEFAULT_RATE, is_playing: false, is_loading: false, is_buffering: false, peak_meter_linear: 0.0, rms_meter_linear: 0.0, loop_region: AudioEngineLoopRegion { start_seconds: 0.0, end_seconds: 0.0, enabled: false }, error: none, active_plugin_path: none, vst_parameters: Vec__new_() }, AudioDeckState { deck_id: AudioDeckId::B, loaded_path: none, loaded_name: none, duration_seconds: 0.0, current_time_seconds: 0.0, gain_linear: DEFAULT_GAIN_LINEAR, rate: DEFAULT_RATE, is_playing: false, is_loading: false, is_buffering: false, peak_meter_linear: 0.0, rms_meter_linear: 0.0, loop_region: AudioEngineLoopRegion { start_seconds: 0.0, end_seconds: 0.0, enabled: false }, error: none, active_plugin_path: none, vst_parameters: Vec__new_() }) }

fn ensure_audio_engine_shared(app: &tauri::AppHandle) -> Result<AudioEngineSharedState, String>:
    let manager = app.state()
    let mut runtime = manager.runtime.lock().map_err(|_| "Audio engine runtime lock was poisoned.".to_string())?
    match runtime:
        Some(runtime_host) =>
            return Result::Ok(runtime_host.shared_.clone())
        _ =>
            ()
            ()
    let runtime_host = build_audio_engine_runtime(app)?
    let shared_ = runtime_host.shared_.clone()
    *runtime = Option::Some(runtime_host)
    ()
    Result::Ok(shared_)

fn existing_audio_engine_shared(app: &tauri::AppHandle) -> Option<AudioEngineSharedState>:
    let manager = app.state()
    let runtime = manager.runtime.lock().ok()?
    runtime.map(|value| value.shared_.clone())

fn build_audio_engine_runtime(app: &tauri::AppHandle) -> Result<AudioEngineRuntimeHost, String>:
    let host = cpal__default_host()
    let device = host.default_output_device().ok_or_else(|| "No default output audio device is available.".to_string())?
    let supported_config = device.default_output_config().map_err(|error| format!("Failed to query default audio output config: {error}"))?
    let sample_format = supported_config.sample_format()
    let output_sample_rate_hz = supported_config.sample_rate()
    let stream_config: cpal::StreamConfig = supported_config.config()
    let shared_ = Arc__new_(AudioEngineSharedState__new_(app.clone(), output_sample_rate_hz, stream_config.channels))
    let error_shared = shared_.clone()
    let err_fn = |error| match error_shared.engine_error.lock():
        Ok(mut engine_error) =>
            *engine_error = Option::Some(format!("Audio output stream error: {error}"))
            ()
        _ => ()
    let stream = match sample_format:
        cpal::SampleFormat::F32 =>
            build_output_stream(&device, &stream_config, shared_.clone(), err_fn)?
        cpal::SampleFormat::I16 =>
            build_output_stream(&device, &stream_config, shared_.clone(), err_fn)?
        cpal::SampleFormat::U16 =>
            build_output_stream(&device, &stream_config, shared_.clone(), err_fn)?
        unsupported =>
            return Result::Err(format!("Unsupported output sample format: {unsupported:?}"))
    stream.play().map_err(|error| format!("Failed to start audio output stream: {error}"))?
    ()
    shared_.ready.store(true, std::sync::atomic::Ordering::Relaxed)
    ()
    start_audio_engine_event_emitter(shared_.clone())
    ()
    shared_.emit_state()
    ()
    Result::Ok(AudioEngineRuntimeHost { shared_: shared_, stream: stream })

fn build_output_stream(device: &cpal::Device, config: &cpal::StreamConfig, shared: AudioEngineSharedState, err_fn: impl FnMut) -> Result<cpal::Stream, String>:
    let channels = (*config).channels as usize
    device.build_output_stream(config, fn(data: &mut Slice<T>, _: _): write_output_data(data, channels, &shared_), err_fn, none).map_err(|error| format!("Failed to build audio output stream: {error}"))

fn write_output_data(output: &mut Slice<T>, output_channels: usize, shared: &AudioEngineSharedState):
    let mut contexts = [DeckRenderContext__from_runtime(&shared_.decks[0]), DeckRenderContext__from_runtime(&shared_.decks[1])]
    for frame in output.chunks_mut(output_channels):
        for sample in frame.iter_mut():
            *sample = T__from_sample(0.0)
            ()
        ()
        for channel_index in 0..output_channels:
            let mut mixed_sample = 0.0
            for context in &mut contexts:
                mixed_sample = mixed_sample + context.sample_channel(channel_index)
                ()
            ()
            frame[channel_index] = T__from_sample(mixed_sample.clamp(-1.0, 1.0))
            ()
        ()
        for context in &mut contexts:
            context.advance_frame()
            ()
    ()
    for context in &contexts:
        context.commit()
        ()

struct DeckRenderContext:
    runtime: &AudioDeckRuntime
    clip: Option<AudioClip>
    position_frames: f64
    gain_linear: f32
    playback_rate: f64
    loop_enabled: Bool
    loop_start_frames: f64
    loop_end_frames: f64
    is_playing: Bool
    peak_meter_linear: f64
    rms_sum_squares: f64
    rms_count: u64

impl DeckRenderContext<a>:
    fn from_runtime(runtime: &AudioDeckRuntime) -> DeckRenderContext<a>:
        DeckRenderContext { runtime: runtime, clip: (*runtime).clip.load_full(), position_frames: atomic_f64(&(*runtime).position_frames), gain_linear: atomic_f64(&(*runtime).gain_linear) as f32, playback_rate: atomic_f64(&(*runtime).playback_rate).clamp(0.25, 4.0), loop_enabled: (*runtime).loop_enabled.load(std::sync::atomic::Ordering::Relaxed), loop_start_frames: atomic_f64(&(*runtime).loop_start_frames), loop_end_frames: atomic_f64(&(*runtime).loop_end_frames), is_playing: (*runtime).is_playing.load(std::sync::atomic::Ordering::Relaxed), peak_meter_linear: 0.0, rms_sum_squares: 0.0, rms_count: 0 }

    fn sample_channel(_self: &mut DeckRenderContext<a>, output_channel: usize) -> f32:
        if !(*_self).is_playing:
            return 0.0
        let Some(clip) = (*_self).clip
        if clip.frames == 0:
            (*_self).is_playing = false
            ()
            return 0.0
        let loop_end = if (*_self).loop_enabled:
            (*_self).loop_end_frames.clamp((*_self).loop_start_frames + 1.0, clip.frames as f64)
        else:
            clip.frames as f64
        if !(*_self).loop_enabled and (*_self).position_frames >= clip.frames as f64:
            (*_self).is_playing = false
            ()
            (*_self).position_frames = clip.frames as f64
            ()
            return 0.0
        let fade_frames = if (*_self).loop_enabled:
            let region_frames = (loop_end - (*_self).loop_start_frames).max(0.0)
            LOOP_CROSSFADE_FRAMES.min((region_frames / 2.0).floor() as usize).max(0)
        else:
            0
        let channel_sample = if (*_self).loop_enabled and fade_frames > 0 and (*_self).position_frames >= loop_end - fade_frames as f64:
            let alpha = (((*_self).position_frames - (loop_end - fade_frames as f64)) / fade_frames as f64).clamp(0.0, 1.0) as f32
            let tail_sample = interpolated_clip_sample(clip, output_channel, (*_self).position_frames)
            let head_position = (*_self).loop_start_frames + ((*_self).position_frames - (loop_end - fade_frames as f64))
            let head_sample = interpolated_clip_sample(clip, output_channel, head_position)
            (tail_sample * (1.0 - alpha)) + (head_sample * alpha)
        else:
            interpolated_clip_sample(clip, output_channel, (*_self).position_frames)
        let scaled_sample = channel_sample * (*_self).gain_linear
        let absolute = scaled_sample.abs() as f64
        if absolute > (*_self).peak_meter_linear:
            (*_self).peak_meter_linear = absolute
            ()
            ()
            ()
            ()
        (*_self).rms_sum_squares = (*_self).rms_sum_squares + (scaled_sample as f64) * (scaled_sample as f64)
        ()
        (*_self).rms_count = (*_self).rms_count + 1
        ()
        scaled_sample

    fn advance_frame(_self: &mut DeckRenderContext<a>):
        if !(*_self).is_playing:
            return
        let Some(clip) = (*_self).clip
        (*_self).position_frames = (*_self).position_frames + (*_self).playback_rate
        ()
        let total_frames = clip.frames as f64
        if (*_self).loop_enabled:
            let loop_start = (*_self).loop_start_frames.clamp(0.0, total_frames)
            let loop_end = (*_self).loop_end_frames.clamp(loop_start + 1.0, total_frames)
            while (*_self).position_frames >= loop_end:
                (*_self).position_frames = loop_start + ((*_self).position_frames - loop_end)
                ()
        else if (*_self).position_frames >= total_frames:
            (*_self).position_frames = total_frames
            ()
            (*_self).is_playing = false
            ()

    fn commit(_self: &DeckRenderContext<a>):
        (*_self).runtime.is_playing.store((*_self).is_playing, std::sync::atomic::Ordering::Relaxed)
        ()
        set_atomic_f64(&(*_self).runtime.position_frames, (*_self).position_frames)
        ()
        set_atomic_f64(&(*_self).runtime.peak_meter_linear, (*_self).peak_meter_linear)
        ()
        let rms_value = if (*_self).rms_count > 0:
            ((*_self).rms_sum_squares / (*_self).rms_count as f64).sqrt()
        else:
            0.0
        set_atomic_f64(&(*_self).runtime.rms_meter_linear, rms_value)
        ()


fn interpolated_clip_sample(clip: &AudioClip, output_channel: usize, frame_position: f64) -> f32:
    if (*clip).frames == 0:
        return 0.0
    let clamped_position = frame_position.clamp(0.0, ((*clip).frames.saturating_sub(1)) as f64)
    let base_frame = clamped_position.floor() as usize
    let next_frame = (base_frame + 1).min((*clip).frames.saturating_sub(1))
    let alpha = (clamped_position - base_frame as f64) as f32
    let base_sample = clip_sample_at_frame(clip, base_frame, output_channel)
    let next_sample = clip_sample_at_frame(clip, next_frame, output_channel)
    (base_sample * (1.0 - alpha)) + (next_sample * alpha)

fn clip_sample_at_frame(clip: &AudioClip, frame_index: usize, output_channel: usize) -> f32:
    if (*clip).channels == 0:
        return 0.0
    if output_channel == 0 and (*clip).channels > 1:
        let mut total = 0.0
        let count = (*clip).channels.min(2)
        for channel_index in 0..count:
            total = total + (*clip).samples[(frame_index * (*clip).channels) + channel_index]
            ()
        ()
        return total / count as f32
    let source_channel = if (*clip).channels == 1:
        0
    else:
        output_channel.min((*clip).channels - 1)
    (*clip).samples[(frame_index * (*clip).channels) + source_channel]

fn start_audio_engine_event_emitter(shared: AudioEngineSharedState):
    std__thread__spawn_(
        || loop:
            shared_.emit_state()
            ()
            std__thread__sleep(Duration__from_millis(AUDIO_ENGINE_EVENT_INTERVAL_MS))
            ()
    )
    ()

fn analyze_audio_file_native(input_path: &std::path::Path) -> Result<AudioPreviewAnalysis, String>:
    analyze_audio_file_with_runtime(input_path, none)

fn analyze_audio_preview_with_runtime(input_path: &std::path::Path, gpu_runtime: Option<&GpuRuntimeManager>, shared: Option<&AudioEngineSharedState>) -> Result<AudioPreviewAnalysis, String>:
    match shared_:
        Some(shared_) =>
            match find_loaded_clip_for_path(shared_, input_path):
                Some(clip) =>
                    return analyze_audio_samples_with_runtime(input_path, clip.sample_rate_hz, clip.channels, &clip.samples, "Native deck cache", gpu_runtime)
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    analyze_audio_file_with_runtime(input_path, gpu_runtime)

fn analyze_audio_preview_for_app(app: &tauri::AppHandle, input_path: &std::path::Path, gpu_runtime: Option<&GpuRuntimeManager>) -> Result<AudioPreviewAnalysis, String>:
    let shared_ = existing_audio_engine_shared(app)
    analyze_audio_preview_with_runtime(input_path, gpu_runtime, shared_)

fn analyze_audio_file_with_runtime(input_path: &std::path::Path, gpu_runtime: Option<&GpuRuntimeManager>) -> Result<AudioPreviewAnalysis, String>:
    let decoded = decode_audio_file(input_path)?
    analyze_audio_samples_with_runtime(input_path, decoded.sample_rate_hz, decoded.channels, &decoded.samples, "Decoded via Symphonia", gpu_runtime)

fn decode_audio_preview_mono_samples(input_path: &std::path::Path) -> Result<(Array<f32>, u32), String>:
    let decoded = decode_audio_file(input_path)?
    Result::Ok((mix_to_mono(&decoded.samples, decoded.channels), decoded.sample_rate_hz))

fn decode_audio_clip_for_device(input_path: &std::path::Path, output_sample_rate_hz: u32) -> Result<AudioClip, String>:
    let decoded = decode_audio_file(input_path)?
    let resampled = if decoded.sample_rate_hz == output_sample_rate_hz:
        decoded
    else:
        resample_audio_data(decoded, output_sample_rate_hz)?
    let name = input_path.file_name().and_then(|value| value.to_str()).unwrap_or("Audio Clip").to_string()
    Result::Ok(AudioClip { path: input_path.to_string_lossy().to_string(), name: name, sample_rate_hz: resampled.sample_rate_hz, channels: resampled.channels, frames: resampled.frames, samples: resampled.samples })

fn decode_audio_file(input_path: &std::path::Path) -> Result<DecodedAudioData, String>:
    match decode_audio_file_with_symphonia(input_path):
        Ok(decoded) => Result::Ok(decoded)
        Err(primary_error) => decode_audio_file_via_ffmpeg(input_path).map_err(|fallback_error| format!("{primary_error}; ffmpeg fallback failed: {fallback_error}"))

fn decode_audio_file_with_symphonia(input_path: &std::path::Path) -> Result<DecodedAudioData, String>:
    let file = File__open(input_path).map_err(|error| format!("Failed to open audio file '{}': {error}", input_path.display()))?
    let media_source_stream = MediaSourceStream__new_(Box__new_(file), Default__default_())
    let mut hint = Hint__new_()
    match input_path.extension().and_then(|value| value.to_str()):
        Some(extension) =>
            hint.with_extension(extension)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let probed = symphonia__default__get_probe().format(&hint, media_source_stream, &FormatOptions__default_(), &MetadataOptions__default_()).map_err(|error| format!("Failed to probe audio file '{}': {error}", input_path.display()))?
    let mut format = probed.format
    let track = select_audio_track(format)?
    let track_id = track.id
    let codec_params = track.codec_params.clone()
    let mut decoder = symphonia__default__get_codecs().make(&codec_params, &DecoderOptions__default_()).map_err(|error| format!("Failed to create audio decoder for '{}': {error}", input_path.display()))?
    let mut interleaved_samples = Vec__new_()
    let mut sample_rate_hz = codec_params.sample_rate
    let mut channels = codec_params.channels.map(|channels| channels.count())
    loop:
        let packet = match format.next_packet():
            Ok(packet) => packet
            Err(_) => break
        if packet.track_id() != track_id:
            continue
        match decoder.decode(&packet):
            Ok(decoded) =>
                let decoded_spec = decoded.spec()
                sample_rate_hz.get_or_insert(decoded_spec.rate)
                ()
                channels.get_or_insert(decoded_spec.channels.count())
                ()
                let mut sample_buffer = SampleBuffer__new_(decoded.capacity() as u64, *decoded_spec)
                sample_buffer.copy_interleaved_ref(decoded)
                ()
                interleaved_samples.extend_from_slice(sample_buffer.samples())
                ()
            Err(symphonia::core::errors::Error::DecodeError(_)) =>
                continue
            Err(_) =>
                break
    ()
    let sample_rate_hz = sample_rate_hz.ok_or_else(|| format!("Audio file '{}' is missing a sample rate.", input_path.display()))?
    let channels = channels.ok_or_else(|| format!("Audio file '{}' is missing channel metadata.", input_path.display()))?
    let frames = interleaved_samples.len() / channels.max(1)
    Result::Ok(DecodedAudioData { sample_rate_hz: sample_rate_hz, channels: channels, frames: frames, samples: interleaved_samples })

fn decode_audio_file_via_ffmpeg(input_path: &std::path::Path) -> Result<DecodedAudioData, String>:
    let temp_path = std__env__temp_dir().join(format!("greeblefs-audio-decode-{}.wav", Uuid__new_v4()))
    let cleanup_guard = TemporaryAudioFile__new_(temp_path.clone())
    let output = Command__new_(resolve_audio_ffmpeg_binary()).args(["-hide_banner", "-loglevel", "error", "-y", "-i"]).arg(input_path).args(["-vn", "-sn", "-dn", "-acodec", "pcm_s16le"]).arg(&temp_path).output().map_err(|error| format!("Failed to launch ffmpeg at '{}': {error}", resolve_audio_ffmpeg_binary()))?
    if !output.status.success():
        return Result::Err(String__from_utf8_lossy(&output.stderr).trim().to_string())
    let decoded = decode_audio_file_with_symphonia(&temp_path)
    drop(cleanup_guard)
    ()
    decoded

fn select_audio_track(format: &impl FormatReader) -> Result<symphonia::core::formats::Track, String>:
    format.default_track().cloned().or_else(|| format.tracks().iter().find(|track| track.codec_params.sample_rate.is_some()).cloned()).ok_or_else(|| "No decodable audio track was found in the selected file.".to_string())

fn resample_audio_data(decoded: DecodedAudioData, output_sample_rate_hz: u32) -> Result<DecodedAudioData, String>:
    if decoded.frames == 0 or decoded.channels == 0:
        return Result::Ok(DecodedAudioData { sample_rate_hz: output_sample_rate_hz, ..decoded })
    let input = InterleavedSlice__new_(decoded.samples.as_slice(), decoded.channels, decoded.frames).map_err(|error| format!("Failed to wrap decoded audio for resampling: {error}"))?
    let mut resampler = Fft__new_(decoded.sample_rate_hz as usize, output_sample_rate_hz as usize, decoded.frames.max(1024), 1, decoded.channels, rubato::FixedSync::Input).map_err(|error| format!("Failed to construct audio resampler: {error}"))?
    let output_frames = resampler.process_all_needed_output_len(decoded.frames)
    let mut output_samples = vec!()
    let resampled_frames = block:
        let mut output = InterleavedSlice__new_mut(output_samples.as_mut_slice(), decoded.channels, output_frames).map_err(|error| format!("Failed to allocate resampled audio buffer: {error}"))?
        let (_, written_frames) = resampler.process_all_into_buffer(&input, &mut output, decoded.frames, none).map_err(|error| format!("Failed to resample audio: {error}"))?
        written_frames
    output_samples.truncate(resampled_frames * decoded.channels)
    ()
    Result::Ok(DecodedAudioData { sample_rate_hz: output_sample_rate_hz, channels: decoded.channels, frames: resampled_frames, samples: output_samples })

fn analyze_decoded_waveform(samples: &Slice<f32>, bucket_count: usize) -> (f64, f64, Array<AudioWaveformBucket>):
    if samples.is_empty():
        return (0.0, 0.0, Vec__new_())
    let peak_level = samples.iter().fold(0.0, |peak, sample| peak.max(sample.abs() as f64))
    let rms_level = ((samples.iter().map(
        |sample| block:
            let value = *sample as f64
            value * value
    ).sum()) / samples.len() as f64).sqrt()
    let chunk_size = (samples.len() / bucket_count.max(1)).max(1)
    let mut buckets = Vec__new_()
    for (index, chunk) in samples.chunks(chunk_size).enumerate():
        let chunk_peak = chunk.iter().fold(0.0, |peak, sample| peak.max(sample.abs() as f64))
        let chunk_rms = ((chunk.iter().map(
            |sample| block:
                let value = *sample as f64
                value * value
        ).sum()) / chunk.len().max(1) as f64).sqrt()
        buckets.push(AudioWaveformBucket { index: index as u32, peak_level: chunk_peak, rms_level: chunk_rms })
        ()
    ()
    (peak_level, rms_level, buckets)

fn compute_peak_and_rms(samples: &Slice<f32>) -> (f64, f64):
    if samples.is_empty():
        return (0.0, 0.0)
    let peak_level = samples.iter().fold(0.0, |peak, sample| peak.max(sample.abs() as f64))
    let rms_level = ((samples.iter().map(
        |sample| block:
            let value = *sample as f64
            value * value
    ).sum()) / samples.len() as f64).sqrt()
    (peak_level, rms_level)

fn prepare_fft_analysis_samples(mono: &Slice<f32>) -> Array<f32>:
    let fft_size = mono.len().min(4096).next_power_of_two().max(256)
    let mut output = vec!()
    let copy_len = mono.len().min(fft_size)
    output[..copy_len].copy_from_slice(&mono[..copy_len])
    ()
    output

fn compute_spectral_bands_from_mono(mono: &Slice<f32>, band_count: usize) -> Array<f64>:
    if mono.is_empty() or band_count == 0:
        return Vec__new_()
    let fft_size = mono.len().min(4096).next_power_of_two().max(256)
    let mut planner = FftPlanner__new_()
    let fft = planner.plan_fft_forward(fft_size)
    let mut buffer = vec!()
    for (index, sample) in mono.iter().take(fft_size).enumerate():
        buffer[index].re = *sample
        ()
    ()
    fft.process(&mut buffer)
    ()
    let half_ = fft_size / 2
    let band_width = (half_ / band_count.max(1)).max(1)
    let mut bands = |__kain_ctor_arg0| Vec::new()(band_count)
    for band_index in 0..band_count:
        let start = band_index * band_width
        let end = ((band_index + 1) * band_width).min(half_)
        if start >= end:
            bands.push(0.0)
            ()
            continue
        let mut magnitude_sum = 0.0
        for bin in &buffer[start..end]:
            magnitude_sum = magnitude_sum + bin.norm() as f64
            ()
        ()
        bands.push(magnitude_sum / (end - start) as f64)
        ()
    ()
    let max_value = bands.iter().copied().fold(0.0, f64__max)
    if max_value > 0.0:
        bands.iter_mut().for_each(|value| *value = *value / max_value)
        ()
        ()
        ()
        ()
    bands

fn analyze_audio_samples_with_runtime(input_path: &std::path::Path, sample_rate_hz: u32, channels: usize, samples: &Slice<f32>, encoding_label: String, gpu_runtime: Option<&GpuRuntimeManager>) -> Result<AudioPreviewAnalysis, String>:
    let normalized_channels = channels.max(1)
    let mono = mix_to_mono(samples, normalized_channels)
    let (peak_level, rms_level) = compute_peak_and_rms(samples)
    let waveform_buckets = gpu_runtime.and_then(|runtime| runtime.reduce_audio_waveform(&mono, DEFAULT_ANALYSIS_WAVEFORM_BUCKET_COUNT).ok()).unwrap_or_else(|| analyze_decoded_waveform(samples, DEFAULT_ANALYSIS_WAVEFORM_BUCKET_COUNT).field_2)
    let spectral_fft_samples = prepare_fft_analysis_samples(&mono)
    let spectral_bands = gpu_runtime.and_then(|runtime| runtime.reduce_audio_spectral_bands(&spectral_fft_samples, 24).ok()).unwrap_or_else(|| compute_spectral_bands_from_mono(&mono, 24))
    let silence_regions = detect_silence_regions(&mono, sample_rate_hz, peak_level)
    let estimated_bpm = estimate_bpm(&mono, sample_rate_hz)
    let duration_seconds = if sample_rate_hz == 0 or channels == 0:
        0.0
    else:
        (samples.len() / channels) as f64 / sample_rate_hz as f64
    Result::Ok(AudioPreviewAnalysis { input_path: input_path.to_string_lossy().to_string(), duration_seconds: duration_seconds, sample_rate_hz: Option::Some(sample_rate_hz), channels: Option::Some(channels as u32), encoding: Option::Some(encoding_label.to_string()), bits_per_sample: Option::Some(32), container_type: input_path.extension().and_then(|value| value.to_str()).map(|value| value.to_ascii_lowercase()), peak_level: peak_level, rms_level: rms_level, loudness_db: decibels_from_linear(rms_level), headroom_db: headroom_from_peak(peak_level), waveform_buckets: waveform_buckets, spectral_bands: spectral_bands, estimated_bpm: estimated_bpm, silence_regions: silence_regions })

fn find_loaded_clip_for_path(shared: &AudioEngineSharedState, input_path: &std::path::Path) -> Option<AudioClip>:
    let target_path = input_path.to_string_lossy()
    shared_.decks.iter().find_map(
        |deck| block:
            let clip = deck.clip.load_full()?
            (clip.path == target_path).then_some(clip)
    )

fn detect_silence_regions(mono: &Slice<f32>, sample_rate_hz: u32, peak_level: f64) -> Array<AudioSilenceRegion>:
    if mono.is_empty() or sample_rate_hz == 0:
        return Vec__new_()
    let window_size = ((sample_rate_hz as f64 * DEFAULT_SILENCE_WINDOW_SECONDS).round() as usize).max(1)
    let min_region_windows = ((DEFAULT_MIN_SILENCE_SECONDS / DEFAULT_SILENCE_WINDOW_SECONDS).ceil() as usize).max(1)
    let threshold = DEFAULT_SILENCE_FLOOR_LINEAR.max(peak_level * 0.01)
    let mut regions = Vec__new_()
    let mut current_start_window: Option<usize> = none
    for (window_index, chunk) in mono.chunks(window_size).enumerate():
        let rms = ((chunk.iter().map(
            |sample| block:
                let value = *sample as f64
                value * value
        ).sum()) / chunk.len().max(1) as f64).sqrt()
        if rms <= threshold:
            current_start_window.get_or_insert(window_index)
            ()
            continue
        match current_start_window.take():
            Some(start_window) =>
                let end_window = window_index
                if end_window.saturating_sub(start_window) >= min_region_windows:
                    let start_seconds = start_window as f64 * DEFAULT_SILENCE_WINDOW_SECONDS
                    let end_seconds = (end_window as f64 * DEFAULT_SILENCE_WINDOW_SECONDS).min(mono.len() as f64 / sample_rate_hz as f64)
                    if end_seconds > start_seconds:
                        regions.push(AudioSilenceRegion { start_seconds: start_seconds, end_seconds: end_seconds, duration_seconds: end_seconds - start_seconds })
                        ()
            _ => ()
    ()
    match current_start_window:
        Some(start_window) =>
            let total_windows = mono.len().div_ceil(window_size)
            if total_windows.saturating_sub(start_window) >= min_region_windows:
                let start_seconds = start_window as f64 * DEFAULT_SILENCE_WINDOW_SECONDS
                let end_seconds = mono.len() as f64 / sample_rate_hz as f64
                if end_seconds > start_seconds:
                    regions.push(AudioSilenceRegion { start_seconds: start_seconds, end_seconds: end_seconds, duration_seconds: end_seconds - start_seconds })
                    ()
                    ()
                    ()
                    ()
                ()
            ()
        _ =>
            ()
            ()
    regions

fn estimate_bpm(mono: &Slice<f32>, sample_rate_hz: u32) -> Option<f64>:
    if mono.is_empty() or sample_rate_hz == 0:
        return none
    let frame_size = 1024.min(mono.len()).max(256)
    let hop_size = (frame_size / 2).max(128)
    let frames = mono.len().saturating_sub(frame_size) / hop_size + 1
    if frames < 8:
        return none
    let mut onset_envelope = |__kain_ctor_arg0| Vec::new()(frames)
    let mut previous_energy = 0.0
    for frame_index in 0..frames:
        let start = frame_index * hop_size
        let end = (start + frame_size).min(mono.len())
        let frame = &mono[start..end]
        let energy = frame.iter().map(|sample| sample.abs() as f64).sum() / frame.len() as f64
        let onset = (energy - previous_energy).max(0.0)
        onset_envelope.push(onset)
        ()
        previous_energy = energy
        ()
    ()
    let max_onset = onset_envelope.iter().copied().fold(0.0, f64__max)
    if max_onset <= f64__EPSILON:
        return none
    onset_envelope.iter_mut().for_each(|value| *value = *value / max_onset)
    ()
    let envelope_rate_hz = sample_rate_hz as f64 / hop_size as f64
    let min_lag = (envelope_rate_hz * 60.0 / DEFAULT_BPM_MAX).floor() as usize
    let max_lag = (envelope_rate_hz * 60.0 / DEFAULT_BPM_MIN).ceil() as usize
    if min_lag == 0 or max_lag <= min_lag or onset_envelope.len() <= max_lag:
        return none
    let mut best_lag = 0
    let mut best_score = 0.0
    for lag in min_lag..=max_lag:
        let mut score = 0.0
        for index in lag..onset_envelope.len():
            score = score + onset_envelope[index] * onset_envelope[index - lag]
            ()
        ()
        if score > best_score:
            best_score = score
            ()
            best_lag = lag
            ()
    ()
    if best_lag == 0 or best_score <= 0.0:
        return none
    let bpm = 60.0 * envelope_rate_hz / best_lag as f64
    if bpm.is_finite() and DEFAULT_BPM_MIN..=DEFAULT_BPM_MAX * 2.0.contains(&bpm):
        Option::Some((bpm * 10.0).round() / 10.0)
    else:
        none

fn mix_to_mono(interleaved: &Slice<f32>, channels: usize) -> Array<f32>:
    if channels <= 1:
        return interleaved.to_vec()
    interleaved.chunks(channels).map(|frame| frame.iter().copied().sum() / channels as f32).collect()

fn decibels_from_linear(value: f64) -> Option<f64>:
    if !value.is_finite() or value <= 0.0:
        return none
    Option::Some(20.0 * value.log10())

fn headroom_from_peak(peak_level: f64) -> Option<f64>:
    if !peak_level.is_finite() or peak_level <= 0.0:
        return none
    Option::Some(-20.0 * peak_level.log10())

fn validate_audio_file_path(input_path: String) -> Result<std::path::PathBuf, String>:
    let trimmed = input_path.trim()
    if trimmed.is_empty():
        return Result::Err("Input audio path cannot be empty.".to_string())
    let path = PathBuf__from(trimmed)
    if !path.exists() or !path.is_file():
        return Result::Err(format!("Input audio does not exist: {}", path.display()))
    Result::Ok(path)

fn normalize_seek_seconds(value: f64) -> f64:
    if value.is_finite():
        value.max(0.0)
    else:
        0.0

fn clamp_loop_duration(start_seconds: f64, end_seconds: f64) -> Result<(f64, f64), String>:
    if !start_seconds.is_finite() or !end_seconds.is_finite():
        return Result::Err("Loop region values must be finite numbers.".to_string())
    let start = start_seconds.max(0.0)
    let end = end_seconds.max(0.0)
    if end - start < MIN_LOOP_DURATION_SECONDS:
        return Result::Err(format!("Loop region must be at least {:.2} seconds long.", MIN_LOOP_DURATION_SECONDS))
    Result::Ok((start, end))

fn update_deck_metadata(deck: &AudioDeckRuntime, update: F) -> Result<(), String>:
    let mut metadata = (*deck).metadata.lock().map_err(|_| "Audio deck metadata lock was poisoned.".to_string())?
    update(&mut metadata)
    ()
    Result::Ok(())

fn apply_loaded_clip(shared: &AudioEngineSharedState, deck_id: AudioDeckId, clip: AudioClip, generation: u64) -> Result<AudioEngineStateSnapshot, String>:
    let deck = shared_.deck(deck_id)
    if deck.load_generation.load(std::sync::atomic::Ordering::Relaxed) != generation:
        return Result::Ok(shared_.snapshot())
    let clip_duration_seconds = if clip.sample_rate_hz == 0:
        0.0
    else:
        clip.frames as f64 / clip.sample_rate_hz as f64
    let clip_frames = clip.frames as f64
    deck.clip.store(Option::Some(Arc__new_(clip)))
    ()
    deck.is_loading.store(false, std::sync::atomic::Ordering::Relaxed)
    ()
    deck.is_playing.store(false, std::sync::atomic::Ordering::Relaxed)
    ()
    set_atomic_f64(&deck.position_frames, 0.0)
    ()
    deck.loop_enabled.store(false, std::sync::atomic::Ordering::Relaxed)
    ()
    set_atomic_f64(&deck.loop_start_frames, 0.0)
    ()
    set_atomic_f64(&deck.loop_end_frames, clip_frames)
    ()
    set_atomic_f64(&deck.peak_meter_linear, 0.0)
    ()
    set_atomic_f64(&deck.rms_meter_linear, 0.0)
    ()
    update_deck_metadata(
        deck,
        |metadata| block:
            metadata.loaded_path = deck.clip.load_full().map(|loaded| loaded.path.clone())
            ()
            metadata.loaded_name = deck.clip.load_full().map(|loaded| loaded.name.clone())
            ()
            metadata.duration_seconds = clip_duration_seconds
            ()
            metadata.is_buffering = false
            ()
            metadata.error = none
            ()
    )?
    ()
    Result::Ok(shared_.snapshot())

fn begin_deck_load(shared: &AudioEngineSharedState, deck_id: AudioDeckId) -> Result<u64, String>:
    let deck = shared_.deck(deck_id)
    let generation = deck.load_generation.fetch_add(1, std::sync::atomic::Ordering::Relaxed) + 1
    deck.is_loading.store(true, std::sync::atomic::Ordering::Relaxed)
    ()
    deck.is_playing.store(false, std::sync::atomic::Ordering::Relaxed)
    ()
    set_atomic_f64(&deck.position_frames, 0.0)
    ()
    set_atomic_f64(&deck.peak_meter_linear, 0.0)
    ()
    set_atomic_f64(&deck.rms_meter_linear, 0.0)
    ()
    update_deck_metadata(
        deck,
        |metadata| block:
            metadata.is_buffering = true
            ()
            metadata.error = none
            ()
    )?
    ()
    shared_.emit_state()
    ()
    Result::Ok(generation)

fn fail_deck_load(shared: &AudioEngineSharedState, deck_id: AudioDeckId, generation: u64, error_message: String) -> Result<AudioEngineStateSnapshot, String>:
    let deck = shared_.deck(deck_id)
    if deck.load_generation.load(std::sync::atomic::Ordering::Relaxed) != generation:
        return Result::Ok(shared_.snapshot())
    deck.clear_loaded_clip()
    ()
    deck.is_loading.store(false, std::sync::atomic::Ordering::Relaxed)
    ()
    update_deck_metadata(
        deck,
        |metadata| block:
            metadata.loaded_path = none
            ()
            metadata.loaded_name = none
            ()
            metadata.duration_seconds = 0.0
            ()
            metadata.is_buffering = false
            ()
            metadata.error = Option::Some(error_message)
            ()
    )?
    ()
    Result::Ok(shared_.snapshot())

fn unload_deck_internal(shared: &AudioEngineSharedState, deck_id: AudioDeckId) -> Result<AudioEngineStateSnapshot, String>:
    let deck = shared_.deck(deck_id)
    deck.load_generation.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
    ()
    deck.clear_loaded_clip()
    ()
    (deck.vst_host.lock().map_err(|e| format!("lock error: {e}"))?).take()
    ()
    deck.is_loading.store(false, std::sync::atomic::Ordering::Relaxed)
    ()
    update_deck_metadata(
        deck,
        |metadata| block:
            *metadata = AudioDeckMetadata__default_()
            ()
    )?
    ()
    Result::Ok(shared_.snapshot())

fn audio_engine_prepare(app: tauri::AppHandle) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_get_state(app: tauri::AppHandle) -> Result<AudioEngineStateSnapshot, String>:
    Result::Ok(existing_audio_engine_shared(&app).map(|shared| shared_.snapshot()).unwrap_or_else(default_audio_engine_state_snapshot))

fn audio_engine_load_deck(app: tauri::AppHandle, request: AudioEngineLoadDeckRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    let input_path = validate_audio_file_path(&request.input_path)?
    let generation = begin_deck_load(&shared_, request.deck_id)?
    let shared_for_task = shared_.clone()
    let sample_rate_hz = shared_.device_sample_rate_hz
    let deck_id = request.deck_id
    let input_path_for_task = input_path.clone()
    let result = (await tauri__async_runtime__spawn_blocking(|| decode_audio_clip_for_device(&input_path_for_task, sample_rate_hz))).map_err(|error| format!("Audio deck load task failed to join: {error}"))?
    let snapshot = match result:
        Ok(clip) => apply_loaded_clip(&shared_for_task, deck_id, clip, generation)?
        Err(error) => fail_deck_load(&shared_for_task, deck_id, generation, error)?
    shared_for_task.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_sync_selection_to_armed_deck(app: tauri::AppHandle, request: AudioEngineSyncSelectionRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    await audio_engine_load_deck(app, AudioEngineLoadDeckRequest { deck_id: shared_.armed_deck(), input_path: request.input_path })

fn audio_engine_unload_deck(app: tauri::AppHandle, request: AudioEngineDeckRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    let snapshot = unload_deck_internal(&shared_, request.deck_id)?
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_set_armed_deck(app: tauri::AppHandle, request: AudioEngineSetArmedDeckRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    shared_.armed_deck.store(request.deck_id.as_index() as u8, std::sync::atomic::Ordering::Relaxed)
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_play(app: tauri::AppHandle, request: AudioEngineDeckRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    let deck = shared_.deck(request.deck_id)
    if deck.clip.load_full().is_none():
        return Result::Err("Load an audio file into this deck before starting playback.".to_string())
    deck.is_playing.store(true, std::sync::atomic::Ordering::Relaxed)
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_pause(app: tauri::AppHandle, request: AudioEngineDeckRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    shared_.deck(request.deck_id).is_playing.store(false, std::sync::atomic::Ordering::Relaxed)
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_stop(app: tauri::AppHandle, request: AudioEngineDeckRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    let deck = shared_.deck(request.deck_id)
    deck.is_playing.store(false, std::sync::atomic::Ordering::Relaxed)
    ()
    let stop_position = if deck.loop_enabled.load(std::sync::atomic::Ordering::Relaxed):
        atomic_f64(&deck.loop_start_frames)
    else:
        0.0
    set_atomic_f64(&deck.position_frames, stop_position)
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_seek(app: tauri::AppHandle, request: AudioEngineSeekRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    let deck = shared_.deck(request.deck_id)
    let clip = deck.clip.load_full().ok_or_else(|| "Load an audio file before seeking.".to_string())?
    let target_frames = normalize_seek_seconds(request.position_seconds) * shared_.device_sample_rate_hz as f64
    let bounded_frames = target_frames.clamp(0.0, clip.frames as f64)
    set_atomic_f64(&deck.position_frames, bounded_frames)
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_set_loop_region(app: tauri::AppHandle, request: AudioEngineLoopRegionRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    let deck = shared_.deck(request.deck_id)
    let clip = deck.clip.load_full().ok_or_else(|| "Load an audio file before setting a loop region.".to_string())?
    let (start_seconds, end_seconds) = clamp_loop_duration(request.start_seconds, request.end_seconds)?
    let start_frames = (start_seconds * shared_.device_sample_rate_hz as f64).clamp(0.0, clip.frames as f64)
    let end_frames = (end_seconds * shared_.device_sample_rate_hz as f64).clamp(start_frames + 1.0, clip.frames as f64)
    set_atomic_f64(&deck.loop_start_frames, start_frames)
    ()
    set_atomic_f64(&deck.loop_end_frames, end_frames)
    ()
    deck.loop_enabled.store(request.enabled, std::sync::atomic::Ordering::Relaxed)
    ()
    let current_position = atomic_f64(&deck.position_frames)
    if request.enabled and current_position >= end_frames:
        set_atomic_f64(&deck.position_frames, start_frames)
        ()
        ()
        ()
        ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_set_gain(app: tauri::AppHandle, request: AudioEngineGainRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    set_atomic_f64(&shared_.deck(request.deck_id).gain_linear, request.gain_linear.clamp(0.0, 4.0))
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_set_rate(app: tauri::AppHandle, request: AudioEngineRateRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    set_atomic_f64(&shared_.deck(request.deck_id).playback_rate, request.rate.clamp(0.25, 4.0))
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_load_plugin(app: tauri::AppHandle, request: AudioEngineLoadPluginRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    let deck = shared_.deck(request.deck_id)
    let plugin_load_result = HeadlessVstHost__load_plugin(&request.plugin_path).and_then(|host| build_vst_parameter_state_snapshot_from_host(&host).map(|state| (host, state)))
    let mut meta = deck.metadata.lock().map_err(|e| format!("lock error: {e}"))?
    let mut host_state = deck.vst_host.lock().map_err(|e| format!("lock error: {e}"))?
    match plugin_load_result:
        Ok((host, parameter_state)) =>
            *host_state = Option::Some(DeckVstRuntime { plugin_path: request.plugin_path.clone(), host: host })
            ()
            meta.active_plugin_path = Option::Some(request.plugin_path.clone())
            ()
            meta.vst_parameters = parameter_state
            ()
            meta.error = none
            ()
            ()
            ()
            ()
        Err(error) =>
            host_state.take()
            ()
            meta.active_plugin_path = none
            ()
            meta.vst_parameters.clear()
            ()
            meta.error = Option::Some(format!("VST load failed: {error}"))
            ()
            ()
            ()
            ()
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_clear_deck_plugin(app: tauri::AppHandle, request: AudioEngineDeckRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    (shared_.deck(request.deck_id).vst_host.lock().map_err(|e| format!("lock error: {e}"))?).take()
    ()
    let mut meta = shared_.deck(request.deck_id).metadata.lock().map_err(|e| format!("lock error: {e}"))?
    meta.active_plugin_path = none
    ()
    meta.vst_parameters.clear()
    ()
    meta.error = none
    ()
    ()
    ()
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn audio_engine_set_plugin_parameter(app: tauri::AppHandle, request: AudioEngineSetPluginParameterRequest) -> Result<AudioEngineStateSnapshot, String>:
    let shared_ = ensure_audio_engine_shared(&app)?
    let deck = shared_.deck(request.deck_id)
    let mut host_state = deck.vst_host.lock().map_err(|e| format!("lock error: {e}"))?
    let active_host = host_state.ok_or_else(|| "Load a VST3 plugin before editing its parameters.".to_string())?
    active_host.host.set_parameter_value(request.parameter_id, request.value_normalized)?
    ()
    let parameter_state = build_vst_parameter_state_snapshot_from_host(&active_host.host)?
    let mut meta = shared_.deck(request.deck_id).metadata.lock().map_err(|e| format!("lock error: {e}"))?
    meta.active_plugin_path = Option::Some(active_host.plugin_path.clone())
    ()
    meta.vst_parameters = parameter_state
    ()
    ()
    ()
    ()
    let snapshot = shared_.snapshot()
    shared_.emit_state()
    ()
    Result::Ok(snapshot)

fn main():
    let output = greeble_lib__specta_bindings__export_bindings().expect("failed to export Tauri Specta bindings")
    println!("Exported Specta bindings to {}", output.display())

struct ExtensionDevInspection:
    inspection: greeble_lib::runtime_pipeline::ExtensionInspection
    default_build_directory: String
    default_bundle_path: String

struct ExtensionInstallSummary:
    managed_content_root: String
    install_root: String
    result: greeble_lib::runtime_pipeline::ExtensionInstallResult

fn main():
    match run():
        Err(error) =>
            eprintln!("{error}")
            std__process__exit(1)
            ()
        _ => ()

fn run() -> Result<(), String>:
    let mut args = std__env__args().skip(1).collect()
    let Some(command) = args.first().cloned()
    if command != "ext":
        return Result::Err(format!("Unsupported greeble command `{command}`.\n\n{}", root_usage()))
    args.remove(0)
    ()
    let Some(subcommand) = args.first().cloned()
    args.remove(0)
    ()
    match subcommand.as_str():
        "dev" => run_extension_dev(args)
        "inspect" => run_extension_inspect(args)
        "build" => run_extension_build(args)
        "pack" => run_extension_pack(args)
        "install" => run_extension_install(args)
        _ => Result::Err(format!("Unsupported greeble ext subcommand `{subcommand}`.\n\n{}", extension_usage()))

fn run_extension_dev(args: Array<String>) -> Result<(), String>:
    let json = take_flag(&mut args, "--json")
    reject_unknown_flags(&args)?
    ()
    if args.len() != 1:
        return Result::Err(format!("`greeble ext dev` expects exactly one <source-directory>.\n\n{}", extension_usage()))
    let source_directory = PathBuf__from(&args[0])
    if !source_directory.is_dir():
        return Result::Err(format!("`greeble ext dev` expects a source directory, got {}", source_directory.display()))
    let inspection = greeble_lib__runtime_pipeline__inspect_extension_source(&source_directory)?
    let summary = ExtensionDevInspection { inspection: inspection, default_build_directory: resolve_default_build_directory(&source_directory).to_string_lossy().to_string(), default_bundle_path: greeble_lib__runtime_pipeline__resolve_default_bundle_output_path(&source_directory).to_string_lossy().to_string() }
    if json:
        print_json(&summary)?
        ()
        ()
        ()
        ()
    else:
        println!("extension id: {}", summary.inspection.manifest.id)
        println!("manifest: {}", summary.inspection.manifest_path)
        println!("entries: {}", summary.inspection.entry_count)
        println!("default build directory: {}", summary.default_build_directory)
        println!("default bundle path: {}", summary.default_bundle_path)
        ()
        ()
    Result::Ok(())

fn run_extension_inspect(args: Array<String>) -> Result<(), String>:
    let json = take_flag(&mut args, "--json")
    reject_unknown_flags(&args)?
    ()
    if args.len() != 1:
        return Result::Err(format!("`greeble ext inspect` expects exactly one <path>.\n\n{}", extension_usage()))
    let inspection = greeble_lib__runtime_pipeline__inspect_extension_source(Path__new_(&args[0]))?
    if json:
        print_json(&inspection)?
        ()
        ()
        ()
        ()
    else:
        println!("source kind: {}", inspection.source_kind)
        println!("manifest: {}", inspection.manifest_path)
        println!("extension id: {}", inspection.manifest.id)
        println!("api version: {}", inspection.manifest.api_version.unwrap_or("unspecified"))
        println!("entries: {}", inspection.entry_count)
        ()
        ()
    Result::Ok(())

fn run_extension_build(args: Array<String>) -> Result<(), String>:
    let include_debug_sources = take_flag(&mut args, "--include-debug-sources")
    let json = take_flag(&mut args, "--json")
    reject_unknown_flags(&args)?
    ()
    if args.is_empty() or args.len() > 2:
        return Result::Err(format!("`greeble ext build` expects <source-directory> and an optional [output-directory].\n\n{}", extension_usage()))
    let source_directory = PathBuf__from(&args[0])
    let output_directory = args.get(1).map(PathBuf__from).unwrap_or_else(|| resolve_default_build_directory(&source_directory))
    let result = greeble_lib__runtime_pipeline__build_extension_source(&source_directory, &output_directory, include_debug_sources)?
    print_build_result(&result, json)?
    ()
    Result::Ok(())

fn run_extension_pack(args: Array<String>) -> Result<(), String>:
    let include_debug_sources = take_flag(&mut args, "--include-debug-sources")
    let json = take_flag(&mut args, "--json")
    reject_unknown_flags(&args)?
    ()
    if args.is_empty() or args.len() > 2:
        return Result::Err(format!("`greeble ext pack` expects <source-directory> and an optional [output-bundle].\n\n{}", extension_usage()))
    let source_directory = PathBuf__from(&args[0])
    let output_path = args.get(1).map(PathBuf__from).unwrap_or_else(|| greeble_lib__runtime_pipeline__resolve_default_bundle_output_path(&source_directory))
    let result = greeble_lib__runtime_pipeline__pack_extension_source(&source_directory, &output_path, include_debug_sources)?
    print_pack_result(&result, json)?
    ()
    Result::Ok(())

fn run_extension_install(args: Array<String>) -> Result<(), String>:
    let replace_existing = take_flag(&mut args, "--replace-existing")
    let json = take_flag(&mut args, "--json")
    reject_unknown_flags(&args)?
    ()
    if args.is_empty() or args.len() > 2:
        return Result::Err(format!("`greeble ext install` expects <bundle-path> and an optional [managed-content-root].\n\n{}", extension_usage()))
    let bundle_path = PathBuf__from(&args[0])
    let managed_content_root = match args.get(1):
        Some(path) => PathBuf__from(path)
        None => default_managed_content_root()?
    let install_root = greeble_lib__runtime_pipeline__resolve_extension_install_root(&managed_content_root)
    let result = greeble_lib__runtime_pipeline__install_extension_bundle_into(&bundle_path, &install_root, replace_existing)?
    let summary = ExtensionInstallSummary { managed_content_root: managed_content_root.to_string_lossy().to_string(), install_root: install_root.to_string_lossy().to_string(), result: result }
    if json:
        print_json(&summary)?
        ()
        ()
        ()
        ()
    else:
        println!("bundle: {}", summary.result.bundle_path)
        println!("managed content root: {}", summary.managed_content_root)
        println!("install root: {}", summary.install_root)
        println!("installed extension id: {}", summary.result.manifest.id)
        println!("install directory: {}", summary.result.install_directory)
        ()
        ()
    Result::Ok(())

fn resolve_default_build_directory(source_directory: &std::path::Path) -> std::path::PathBuf:
    source_directory.join(".greeble-build")

fn default_managed_content_root() -> Result<std::path::PathBuf, String>:
    std__env__current_dir().map(|current_directory| current_directory.join("usr")).map_err(|error| format!("Failed to resolve current directory for default usr root: {error}"))

fn take_flag(args: &mut Array<String>, flag: String) -> Bool:
    match args.iter().position(|candidate| candidate == flag):
        Some(index) =>
            args.remove(index)
            ()
            true
        _ =>
            false

fn reject_unknown_flags(args: &Slice<String>) -> Result<(), String>:
    match args.iter().find(|argument| argument.starts_with("-")):
        Some(flag) =>
            return Result::Err(format!("Unsupported flag `{flag}`.\n\n{}", extension_usage()))
        _ =>
            ()
            ()
    Result::Ok(())

fn print_build_result(result: &greeble_lib::runtime_pipeline::ExtensionBuildResult, json: Bool) -> Result<(), String>:
    if json:
        print_json(result)
    else:
        println!("source directory: {}", (*result).source_directory)
        println!("staging directory: {}", (*result).staging_directory)
        println!("manifest: {}", (*result).manifest_path)
        println!("extension id: {}", (*result).manifest.id)
        Result::Ok(())

fn print_pack_result(result: &greeble_lib::runtime_pipeline::ExtensionPackResult, json: Bool) -> Result<(), String>:
    if json:
        print_json(result)
    else:
        println!("source directory: {}", (*result).source_directory)
        println!("bundle path: {}", (*result).bundle_path)
        println!("extension id: {}", (*result).manifest.id)
        Result::Ok(())

fn print_json(value: &T) -> Result<(), String>:
    let json = serde_json__to_string_pretty(value).map_err(|error| format!("Failed to serialize CLI output: {error}"))?
    println!("{json}")
    Result::Ok(())

fn root_usage() -> String:
    ["Usage:", "  greeble ext <dev|inspect|build|pack|install> ...", "", "Run `greeble ext` for extension-platform subcommands."].join("\n")

fn extension_usage() -> String:
    ["Usage:", "  greeble ext dev <source-directory> [--json]", "  greeble ext inspect <path> [--json]", "  greeble ext build <source-directory> [output-directory] [--include-debug-sources] [--json]", "  greeble ext pack <source-directory> [output-bundle.gfsx] [--include-debug-sources] [--json]", "  greeble ext install <bundle-path> [managed-content-root] [--replace-existing] [--json]", "", "Notes:", "  - `install` defaults the managed-content root to `<cwd>/usr` when omitted.", "  - installed bundles land under `<managed-content-root>/plugins/<extension-id>`."].join("\n")

enum CloudProviderId:
    GoogleDrive
    Dropbox

enum CloudProviderConfigurationSource:
    None
    Settings
    Environment

enum CloudAccountStatus:
    Connected
    Expired
    Error

struct CloudProviderConfigurationStatus:
    provider: CloudProviderId
    configured: Bool
    missing_configuration: Array<String>
    configuration_source: CloudProviderConfigurationSource
    client_id: Option<String>
    client_secret_present: Bool

struct CloudAccountSummary:
    id: String
    provider: CloudProviderId
    display_name: String
    email: String
    avatar_url: Option<String>
    connected_at: u64
    status: CloudAccountStatus
    drive_label: String
    root_path: String

struct CloudAccountsSnapshot:
    accounts: Array<CloudAccountSummary>
    providers: Array<CloudProviderConfigurationStatus>

struct CloudAuthSession:
    request_id: String
    provider: CloudProviderId
    authorization_url: String

struct CloudAuthStatus:
    status: String
    account: Option<CloudAccountSummary>
    error: Option<String>

struct CloudBreadcrumb:
    label: String
    path: String

struct CloudDirectoryListing:
    path: String
    parent_path: Option<String>
    breadcrumbs: Array<CloudBreadcrumb>
    entries: Array<FileEntry>

struct ProviderConfig:
    provider: CloudProviderId
    client_id: String
    client_secret: Option<String>

struct PersistedCloudAccounts:
    accounts: Array<PersistedCloudAccount>

struct PersistedCloudProviderConfigurations:
    providers: Array<PersistedCloudProviderConfiguration>

impl Default for PersistedCloudProviderConfigurations:
    fn default_() -> PersistedCloudProviderConfigurations:
        PersistedCloudProviderConfigurations { providers: Vec__new_() }


struct PersistedCloudProviderConfiguration:
    provider: CloudProviderId
    client_id: String

struct PersistedCloudAccount:
    id: String
    provider: CloudProviderId
    display_name: String
    email: String
    avatar_url: Option<String>
    connected_at: u64
    status: CloudAccountStatus
    drive_label: String

impl PersistedCloudAccount:
    fn summary(_self: &PersistedCloudAccount) -> CloudAccountSummary:
        CloudAccountSummary { id: (*_self).id.clone(), provider: (*_self).provider, display_name: (*_self).display_name.clone(), email: (*_self).email.clone(), avatar_url: (*_self).avatar_url.clone(), connected_at: (*_self).connected_at, status: (*_self).status.clone(), drive_label: (*_self).drive_label.clone(), root_path: build_cloud_root_path((*_self).provider, &(*_self).id) }


struct AccessTokenCacheEntry:
    access_token: String
    expires_at_ms: u64

struct PendingAuthSession:
    provider: CloudProviderId
    redirect_uri: String
    code_verifier: String
    callback: Option<AuthCallbackPayload>
    completed: Option<CloudAccountSummary>
    error: Option<String>

struct AuthCallbackPayload:
    code: Option<String>
    error: Option<String>

struct AuthCallbackListener:
    redirect_uri: String
    listeners: Array<std::net::TcpListener>

struct ResolvedProviderConfiguration:
    source: CloudProviderConfigurationSource
    client_id: Option<String>
    client_secret: Option<String>

struct CloudRuntimeState:
    auth_sessions: Map<String, PendingAuthSession>
    access_tokens: Map<String, AccessTokenCacheEntry>

impl Default for CloudRuntimeState:
    fn default_() -> CloudRuntimeState:
        CloudRuntimeState { auth_sessions: Arc__new_(Mutex__new_(HashMap__new_())), access_tokens: Arc__new_(Mutex__new_(HashMap__new_())) }


enum CloudPathRef:
    Root { provider: CloudProviderId, account_id: String }
    Item { provider: CloudProviderId, account_id: String, item_id: String }

struct GoogleTokenResponse:
    access_token: String
    expires_in: u64
    refresh_token: Option<String>

struct GoogleUserInfoResponse:
    name: Option<String>
    email: Option<String>
    picture: Option<String>

struct GoogleFileListResponse:
    files: Array<GoogleDriveFile>
    next_page_token: Option<String>

struct GoogleDriveFile:
    id: String
    name: String
    mime_type: String
    size: Option<String>
    modified_time: Option<String>
    parents: Option<Array<String>>

struct DropboxTokenResponse:
    access_token: String
    expires_in: u64
    refresh_token: Option<String>

struct DropboxAccountResponse:
    name: DropboxDisplayName
    email: Option<String>
    profile_photo_url: Option<String>

struct DropboxDisplayName:
    display_name: String

impl Default for DropboxDisplayName:
    fn default_() -> DropboxDisplayName:
        DropboxDisplayName { display_name: String__new_() }


struct DropboxListFolderResponse:
    entries: Array<DropboxMetadataEntry>

struct DropboxMetadataEntry:
    tag: String
    name: String
    path_display: Option<String>
    path_lower: Option<String>
    server_modified: Option<String>
    size: Option<u64>

struct CloudFilePayload:
    bytes: Array<u8>
    name: String

fn cloud_list_accounts(app: tauri::AppHandle) -> Result<CloudAccountsSnapshot, String>:
    let accounts = (read_accounts(&app)?).accounts.into_iter().map(|account| account.summary()).collect()
    Result::Ok(CloudAccountsSnapshot { accounts: accounts, providers: provider_configuration_statuses(&app)? })

fn cloud_set_provider_configuration(app: tauri::AppHandle, provider: CloudProviderId, client_id: String, client_secret: Option<String>) -> Result<CloudProviderConfigurationStatus, String>:
    let trimmed_client_id = client_id.trim().to_string()
    if trimmed_client_id.is_empty():
        return Result::Err(format!("{} client ID is required.", provider_label(provider)))
    upsert_provider_configuration(&app, provider, &trimmed_client_id)?
    ()
    let trimmed_client_secret = client_secret.map(str__trim).filter(|value| !value.is_empty())
    match trimmed_client_secret:
        Some(secret) =>
            write_provider_client_secret(provider, secret)?
            ()
            ()
            ()
            ()
        _ =>
            delete_provider_client_secret(provider)?
            ()
            ()
            ()
            ()
    provider_configuration_status(&app, provider)

fn cloud_clear_provider_configuration(app: tauri::AppHandle, provider: CloudProviderId) -> Result<CloudProviderConfigurationStatus, String>:
    remove_provider_configuration(&app, provider)?
    ()
    delete_provider_client_secret(provider)?
    ()
    provider_configuration_status(&app, provider)

fn cloud_begin_auth(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, provider: CloudProviderId) -> Result<CloudAuthSession, String>:
    let config = provider_config(&app, provider)?
    let request_id = Uuid__new_v4().to_string()
    let state_token = random_token(48)
    let code_verifier = random_token(96)
    let code_challenge = pkce_challenge(&code_verifier)
    let callback_listener = create_auth_callback_listener(provider)?
    let redirect_uri = callback_listener.redirect_uri.clone()
    let authorization_url = build_authorization_url(&config, &redirect_uri, &state_token, &code_challenge)?
    let mut sessions = state.auth_sessions.lock().map_err(|_| "cloud auth session state lock poisoned".to_string())?
    sessions.insert(request_id.clone(), PendingAuthSession { provider: provider, redirect_uri: redirect_uri.clone(), code_verifier: code_verifier.clone(), callback: none, completed: none, error: none })
    ()
    ()
    ()
    ()
    let sessions = state.auth_sessions.clone()
    let request_id_for_thread = request_id.clone()
    let listeners = callback_listener.listeners
    std__thread__spawn_(
        || block:
            let deadline = Instant__now() + Duration__from_secs(300)
            loop:
                if Instant__now() >= deadline:
                    update_auth_callback(&sessions, &request_id_for_thread, AuthCallbackPayload { code: none, error: Option::Some("Timed out waiting for browser sign-in.".to_string()) })
                    ()
                    break
                let mut received_callback = false
                for listener in &listeners:
                    match listener.accept():
                        Ok((mut stream, _)) =>
                            let result = read_callback_payload(&mut stream, &state_token)
                            let _ = write_callback_response(&mut stream, result.is_ok())
                            match result:
                                Ok(payload) =>
                                    update_auth_callback(&sessions, &request_id_for_thread, payload)
                                    ()
                                    ()
                                Err(error) =>
                                    update_auth_callback(&sessions, &request_id_for_thread, AuthCallbackPayload { code: none, error: Option::Some(error) })
                                    ()
                            received_callback = true
                            ()
                            break
                        Err(error) if error.kind() == io::ErrorKind::WouldBlock =>
                            ()
                        Err(error) =>
                            update_auth_callback(&sessions, &request_id_for_thread, AuthCallbackPayload { code: none, error: Option::Some(format!("OAuth callback listener failed: {error}")) })
                            ()
                            received_callback = true
                            ()
                            break
                ()
                if received_callback:
                    break
                std__thread__sleep(Duration__from_millis(120))
                ()
    )
    ()
    Result::Ok(CloudAuthSession { request_id: request_id, provider: provider, authorization_url: authorization_url })

fn cloud_poll_auth(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, request_id: String) -> Result<CloudAuthStatus, String>:
    let pending = block:
        let sessions = state.auth_sessions.lock().map_err(|_| "cloud auth session state lock poisoned".to_string())?
        sessions.get(&request_id).cloned().ok_or_else(|| "Unknown cloud auth request.".to_string())?
    match pending.completed:
        Some(account) =>
            return Result::Ok(CloudAuthStatus { status: "completed".to_string(), account: Option::Some(account), error: none })
        _ =>
            ()
            ()
    match pending.error:
        Some(error) =>
            return Result::Ok(CloudAuthStatus { status: "failed".to_string(), account: none, error: Option::Some(error) })
        _ =>
            ()
            ()
    let Some(callback) = pending.callback
    match callback.error:
        Some(error) =>
            let mut sessions = state.auth_sessions.lock().map_err(|_| "cloud auth session state lock poisoned".to_string())?
            match sessions.get_mut(&request_id):
                Some(session) =>
                    session.error = Option::Some(error.clone())
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            return Result::Ok(CloudAuthStatus { status: "failed".to_string(), account: none, error: Option::Some(error) })
        _ =>
            ()
            ()
    let code = callback.code.ok_or_else(|| "Missing authorization code from browser callback.".to_string())?
    let config = provider_config(&app, pending.provider)?
    let client = cloud_http_client()?
    let token = (await exchange_authorization_code(&client, &config, &pending.redirect_uri, &pending.code_verifier, &code))?
    let refresh_token = token.refresh_token.clone().ok_or_else(|| "Provider did not return a refresh token. Reconnect and ensure offline access is enabled.".to_string())?
    let account = (await fetch_account_profile(&client, pending.provider, &token.access_token))?
    write_refresh_token(account.provider, &account.id, &refresh_token)?
    ()
    upsert_account(&app, PersistedCloudAccount { id: account.id.clone(), provider: account.provider, display_name: account.display_name.clone(), email: account.email.clone(), avatar_url: account.avatar_url.clone(), connected_at: account.connected_at, status: CloudAccountStatus::Connected, drive_label: account.drive_label.clone() })?
    ()
    store_access_token(&state, account.provider, &account.id, &token.access_token, token.expires_in)?
    ()
    let account_id = account.id.clone()
    let summary = CloudAccountSummary { id: account_id.clone(), provider: account.provider, display_name: account.display_name, email: account.email, avatar_url: account.avatar_url, connected_at: account.connected_at, status: CloudAccountStatus::Connected, drive_label: account.drive_label, root_path: build_cloud_root_path(account.provider, &account_id) }
    let mut sessions = state.auth_sessions.lock().map_err(|_| "cloud auth session state lock poisoned".to_string())?
    match sessions.get_mut(&request_id):
        Some(session) =>
            session.completed = Option::Some(summary.clone())
            ()
            session.error = none
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(CloudAuthStatus { status: "completed".to_string(), account: Option::Some(summary), error: none })

fn cloud_disconnect_account(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, account_id: String) -> Result<(), String>:
    let accounts = read_accounts(&app)?
    let account = accounts.accounts.iter().find(|entry| entry.id == account_id).cloned().ok_or_else(|| "Cloud account was not found.".to_string())?
    let next_accounts = accounts.accounts.into_iter().filter(|entry| entry.id != account_id).collect()
    write_accounts(&app, &PersistedCloudAccounts { accounts: next_accounts })?
    ()
    clear_access_token(&state, account.provider, &account.id)?
    ()
    delete_refresh_token(account.provider, &account.id)?
    ()
    Result::Ok(())

fn cloud_list_dir(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, path: String) -> Result<CloudDirectoryListing, String>:
    let parsed = parse_cloud_path(&path)?
    let account = load_account(&app, parsed.account_id())?
    let client = cloud_http_client()?
    match parsed:
        CloudPathRef::Root { provider: provider, account_id: account_id } =>
            await list_cloud_root_directory(&app, &state, &client, provider, &account_id, &account)
        CloudPathRef::Item { provider: provider, account_id: account_id, item_id: item_id } =>
            await list_cloud_item_directory(&app, &state, &client, provider, &account_id, &item_id, &account)

fn cloud_open_file(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, path: String) -> Result<(), String>:
    let local_path = (await cloud_download_to_temp(&app, &state, &path))?
    await fs_commands__fs_open_file(local_path)

fn cloud_read_text_file(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, path: String) -> Result<String, String>:
    let payload = (await download_cloud_file(&app, &state, &path))?
    if payload.bytes.len() > CLOUD_TEXT_PREVIEW_MAX_BYTES:
        return Result::Err("Cloud file is too large to preview as text (> 10 MB).".to_string())
    String__from_utf8(payload.bytes).map_err(|error| format!("Cloud file is not valid UTF-8: {error}"))

fn cloud_read_file_base64(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, path: String) -> Result<String, String>:
    let payload = (await download_cloud_file(&app, &state, &path))?
    if payload.bytes.len() > CLOUD_BASE64_PREVIEW_MAX_BYTES:
        return Result::Err("Cloud file is too large to preview (> 12 MB).".to_string())
    let extension = Path__new_(&payload.name).extension().and_then(|value| value.to_str()).unwrap_or_default()
    let mime = mime_from_extension(extension)
    Result::Ok(format!("data:{};base64,{}", mime, base64__engine__general_purpose__URL_SAFE_NO_PAD.encode(payload.bytes)))

fn cloud_read_preview_bytes(app: tauri::AppHandle, path: String, max_bytes: Option<u64>) -> Result<tauri::transport::BinaryResponse, String>:
    let state = app.state()
    let payload = (await download_cloud_file(&app, &state, &path))?
    let allowed_bytes = resolve_cloud_preview_byte_limit(max_bytes)
    if payload.bytes.len() as u64 > allowed_bytes:
        return Result::Err(format!("Cloud file is too large for native preview transport (> {}).", format_cloud_preview_byte_limit(allowed_bytes)))
    Result::Ok(BinaryResponse__new_(payload.bytes))

fn resolve_cloud_preview_byte_limit(requested_bytes: Option<u64>) -> u64:
    requested_bytes.unwrap_or(CLOUD_PREVIEW_BYTES_MAX_BYTES as u64).max(1).min(CLOUD_PREVIEW_BYTES_MAX_BYTES as u64)

fn format_cloud_preview_byte_limit(limit_bytes: u64) -> String:
    let limit_mebibytes = limit_bytes.div_ceil(1024 * 1024)
    format!("{limit_mebibytes} MB")

fn cloud_write_file(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, path: String, content: FsWriteFileContent) -> Result<(), String>:
    let parsed = parse_cloud_path(&path)?
    let account = load_account(&app, parsed.account_id())?
    let client = cloud_http_client()?
    let access_token = (await access_token_for_account(&app, &state, &client, &account))?
    let bytes = match content:
        FsWriteFileContent::Text(value) => value.into_bytes()
        FsWriteFileContent::Bytes(value) => value
    match parsed:
        CloudPathRef::Root {  } => Result::Err("Cannot write to a cloud drive root.".to_string())
        CloudPathRef::Item { provider: provider, item_id: item_id } => await overwrite_cloud_file(&client, provider, &access_token, &item_id, bytes)

fn cloud_create_file(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, parent_path: String, name: String, content: FsWriteFileContent) -> Result<(), String>:
    let parent = parse_cloud_path(&parent_path)?
    let account = load_account(&app, parent.account_id())?
    let client = cloud_http_client()?
    let access_token = (await access_token_for_account(&app, &state, &client, &account))?
    let bytes = match content:
        FsWriteFileContent::Text(value) => value.into_bytes()
        FsWriteFileContent::Bytes(value) => value
    await create_cloud_file(&client, &parent, &access_token, &name, bytes)

fn cloud_create_directory(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, parent_path: String, name: String) -> Result<(), String>:
    let parent = parse_cloud_path(&parent_path)?
    let account = load_account(&app, parent.account_id())?
    let client = cloud_http_client()?
    let access_token = (await access_token_for_account(&app, &state, &client, &account))?
    await create_cloud_directory_impl(&client, &parent, &access_token, &name)

fn cloud_rename_path(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, path: String, new_name: String) -> Result<(), String>:
    let parsed = parse_cloud_path(&path)?
    let account = load_account(&app, parsed.account_id())?
    let client = cloud_http_client()?
    let access_token = (await access_token_for_account(&app, &state, &client, &account))?
    await rename_cloud_path_impl(&client, &parsed, &access_token, &new_name)

fn cloud_delete_path(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, path: String) -> Result<(), String>:
    let parsed = parse_cloud_path(&path)?
    let account = load_account(&app, parsed.account_id())?
    let client = cloud_http_client()?
    let access_token = (await access_token_for_account(&app, &state, &client, &account))?
    await delete_cloud_path_impl(&client, &parsed, &access_token)

fn cloud_transfer_items(app: tauri::AppHandle, state: tauri::State<_, CloudRuntimeState>, target_dir: String, sources: Array<String>, operation: FileTransferOperation) -> Result<Array<FileTransferResult>, String>:
    if sources.is_empty():
        return Result::Ok(Vec__new_())
    let client = cloud_http_client()?
    let mut results = Vec__new_()
    for source in sources:
        if source.starts_with("cloud://") or target_dir.starts_with("cloud://"):
            (await transfer_between_local_and_cloud(&app, &state, &client, &target_dir, &source, operation))?
            ()
            let content_revision = explorer_identity__build_content_revision(0, 0, false, false)
            let identity = explorer_identity__build_virtual_identity("cloud-transfer", &format!("{source}->{target_dir}::{operation:?}"), &content_revision)
            results.push(FileTransferResult { source_path: source.clone(), destination_path: target_dir.clone(), operation: operation, collision_policy: FileTransferCollisionPolicy::KeepBoth, disposition: FileTransferDisposition::Transferred, entity_id: identity.entity_id, identity_kind: identity.identity_kind, content_revision: identity.content_revision })
            ()
    ()
    Result::Ok(results)

impl CloudPathRef:
    fn provider(_self: &CloudPathRef) -> CloudProviderId:
        match *_self:
            CloudPathRef::Root { provider: provider } | CloudPathRef::Item { provider: provider } => *provider

    fn account_id(_self: &CloudPathRef) -> String:
        match *_self:
            CloudPathRef::Root { account_id: account_id } | CloudPathRef::Item { account_id: account_id } =>
                account_id.as_str()

    fn item_id(_self: &CloudPathRef) -> Option<String>:
        match *_self:
            CloudPathRef::Root {  } => none
            CloudPathRef::Item { item_id: item_id } => Option::Some(item_id.as_str())


fn cloud_http_client() -> Result<reqwest::Client, String>:
    Client__builder().user_agent("GreebleFS Cloud Explorer/1.0").build().map_err(|error| format!("Failed to create cloud HTTP client: {error}"))

fn provider_configuration_statuses(app: &tauri::AppHandle) -> Result<Array<CloudProviderConfigurationStatus>, String>:
    [CloudProviderId::GoogleDrive, CloudProviderId::Dropbox].into_iter().map(|provider| provider_configuration_status(app, provider)).collect()

fn provider_configuration_status(app: &tauri::AppHandle, provider: CloudProviderId) -> Result<CloudProviderConfigurationStatus, String>:
    let resolved = resolved_provider_configuration(app, provider)?
    let mut missing_configuration = Vec__new_()
    if resolved.client_id.is_none():
        missing_configuration.push("client ID".to_string())
        ()
        ()
        ()
        ()
    Result::Ok(CloudProviderConfigurationStatus { provider: provider, configured: missing_configuration.is_empty(), missing_configuration: missing_configuration, configuration_source: resolved.source, client_id: resolved.client_id, client_secret_present: resolved.client_secret.is_some() })

fn provider_config(app: &tauri::AppHandle, provider: CloudProviderId) -> Result<ProviderConfig, String>:
    let resolved = resolved_provider_configuration(app, provider)?
    let Some(client_id) = resolved.client_id
    Result::Ok(ProviderConfig { provider: provider, client_id: client_id, client_secret: resolved.client_secret })

fn env_trimmed(key: String) -> Option<String>:
    std__env__var_(key).ok().map(|value| value.trim().to_string()).filter(|value| !value.is_empty())

fn bundled_provider_client_id(provider: CloudProviderId) -> Option<String>:
    match provider:
        CloudProviderId::GoogleDrive => option_env!("GREEBLE_GOOGLE_DRIVE_CLIENT_ID")
        CloudProviderId::Dropbox => option_env!("GREEBLE_DROPBOX_CLIENT_ID").map(|value| value.trim().to_string()).filter(|value| !value.is_empty())

fn bundled_provider_client_secret(provider: CloudProviderId) -> Option<String>:
    match provider:
        CloudProviderId::GoogleDrive => option_env!("GREEBLE_GOOGLE_DRIVE_CLIENT_SECRET")
        CloudProviderId::Dropbox => option_env!("GREEBLE_DROPBOX_CLIENT_SECRET").map(|value| value.trim().to_string()).filter(|value| !value.is_empty())

fn random_token(length: usize) -> String:
    rand__thread_rng().sample_iter(&rand__distributions__Alphanumeric).take(length).map(char__from).collect()

fn pkce_challenge(code_verifier: String) -> String:
    let mut hash = Sha256__new_()
    hash.update(code_verifier.as_bytes())
    ()
    base64__engine__general_purpose__URL_SAFE_NO_PAD.encode(hash.finalize())

fn provider_label(provider: CloudProviderId) -> String:
    match provider:
        CloudProviderId::GoogleDrive => "Google Drive"
        CloudProviderId::Dropbox => "Dropbox"

fn provider_client_id_env_key(provider: CloudProviderId) -> String:
    match provider:
        CloudProviderId::GoogleDrive => "GREEBLE_GOOGLE_DRIVE_CLIENT_ID"
        CloudProviderId::Dropbox => "GREEBLE_DROPBOX_CLIENT_ID"

fn provider_client_secret_env_key(provider: CloudProviderId) -> String:
    match provider:
        CloudProviderId::GoogleDrive => "GREEBLE_GOOGLE_DRIVE_CLIENT_SECRET"
        CloudProviderId::Dropbox => "GREEBLE_DROPBOX_CLIENT_SECRET"

fn build_cloud_root_path(provider: CloudProviderId, account_id: String) -> String:
    format!("cloud://{}/{}/root", provider_host(provider), account_id)

fn build_cloud_item_path(provider: CloudProviderId, account_id: String, item_id: String) -> String:
    format!("cloud://{}/{}/item/{}", provider_host(provider), account_id, base64__engine__general_purpose__URL_SAFE_NO_PAD.encode(item_id.as_bytes()))

fn provider_host(provider: CloudProviderId) -> String:
    match provider:
        CloudProviderId::GoogleDrive => "google-drive"
        CloudProviderId::Dropbox => "dropbox"

fn parse_provider_host(value: String) -> Result<CloudProviderId, String>:
    match value:
        "google-drive" => Result::Ok(CloudProviderId::GoogleDrive)
        "dropbox" => Result::Ok(CloudProviderId::Dropbox)
        _ => Result::Err(format!("Unsupported cloud provider in path: {value}"))

fn parse_cloud_path(path: String) -> Result<CloudPathRef, String>:
    let url = Url__parse(path).map_err(|error| format!("Invalid cloud path: {error}"))?
    if url.scheme() != "cloud":
        return Result::Err("Not a cloud path.".to_string())
    let provider = parse_provider_host(url.host_str().ok_or_else(|| "Missing cloud provider in path.".to_string())?)?
    let segments = url.path_segments().map(|value| value.collect())
    let segments = segments.ok_or_else(|| "Cloud path is missing segments.".to_string())?
    if segments.len() == 2 and segments[1] == "root":
        return Result::Ok(CloudPathRef::Root { provider: provider, account_id: segments[0].to_string() })
    if segments.len() == 3 and segments[1] == "item":
        let item_id_bytes = base64__engine__general_purpose__URL_SAFE_NO_PAD.decode(segments[2]).map_err(|error| format!("Invalid cloud item identifier: {error}"))?
        let item_id = String__from_utf8(item_id_bytes).map_err(|error| format!("Invalid UTF-8 cloud item identifier: {error}"))?
        return Result::Ok(CloudPathRef::Item { provider: provider, account_id: segments[0].to_string(), item_id: item_id })
    Result::Err("Unsupported cloud path shape.".to_string())

fn accounts_file_path(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let base = (app.path().app_local_data_dir().map_err(|error| format!("Failed to resolve app local data directory: {error}"))?).join(CLOUD_ROOT_DIRECTORY)
    std__fs__create_dir_all(&base).map_err(|error| format!("Failed to create cloud account directory: {error}"))?
    ()
    Result::Ok(base.join(CLOUD_ACCOUNTS_FILE))

fn provider_config_file_path(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let base = (app.path().app_local_data_dir().map_err(|error| format!("Failed to resolve app local data directory: {error}"))?).join(CLOUD_ROOT_DIRECTORY)
    std__fs__create_dir_all(&base).map_err(|error| format!("Failed to create cloud configuration directory: {error}"))?
    ()
    Result::Ok(base.join(CLOUD_PROVIDER_CONFIG_FILE))

fn temp_root_path(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let root = (app.path().app_local_data_dir().map_err(|error| format!("Failed to resolve app local data directory: {error}"))?).join(CLOUD_ROOT_DIRECTORY).join(CLOUD_TEMP_DIRECTORY)
    std__fs__create_dir_all(&root).map_err(|error| format!("Failed to create cloud temp directory: {error}"))?
    ()
    Result::Ok(root)

fn read_accounts(app: &tauri::AppHandle) -> Result<PersistedCloudAccounts, String>:
    let path = accounts_file_path(app)?
    if !path.exists():
        return Result::Ok(PersistedCloudAccounts { accounts: Vec__new_() })
    let content = std__fs__read_to_string(&path).map_err(|error| format!("Failed to read persisted cloud accounts: {error}"))?
    serde_json__from_str(&content).map_err(|error| format!("Failed to parse persisted cloud accounts: {error}"))

fn read_provider_configurations(app: &tauri::AppHandle) -> Result<PersistedCloudProviderConfigurations, String>:
    let path = provider_config_file_path(app)?
    if !path.exists():
        return Result::Ok(PersistedCloudProviderConfigurations__default_())
    let content = std__fs__read_to_string(&path).map_err(|error| format!("Failed to read persisted cloud provider settings: {error}"))?
    serde_json__from_str(&content).map_err(|error| format!("Failed to parse persisted cloud provider settings: {error}"))

fn write_accounts(app: &tauri::AppHandle, accounts: &PersistedCloudAccounts) -> Result<(), String>:
    let path = accounts_file_path(app)?
    let content = serde_json__to_string_pretty(accounts).map_err(|error| format!("Failed to serialize persisted cloud accounts: {error}"))?
    std__fs__write(&path, content).map_err(|error| format!("Failed to persist cloud accounts: {error}"))

fn write_provider_configurations(app: &tauri::AppHandle, configurations: &PersistedCloudProviderConfigurations) -> Result<(), String>:
    let path = provider_config_file_path(app)?
    let content = serde_json__to_string_pretty(configurations).map_err(|error| format!("Failed to serialize persisted cloud provider settings: {error}"))?
    std__fs__write(&path, content).map_err(|error| format!("Failed to persist cloud provider settings: {error}"))

fn upsert_account(app: &tauri::AppHandle, next: PersistedCloudAccount) -> Result<(), String>:
    let mut accounts = read_accounts(app)?
    match accounts.accounts.iter_mut().find(|entry| entry.provider == next.provider and entry.email.eq_ignore_ascii_case(&next.email)):
        Some(existing) =>
            *existing = next
            ()
            ()
            ()
            ()
        _ =>
            accounts.accounts.push(next)
            ()
            ()
            ()
            ()
    accounts.accounts.sort_by(|left, right| left.drive_label.to_lowercase().cmp(&right.drive_label.to_lowercase()))
    ()
    write_accounts(app, &accounts)

fn upsert_provider_configuration(app: &tauri::AppHandle, provider: CloudProviderId, client_id: String) -> Result<(), String>:
    let mut configurations = read_provider_configurations(app)?
    match configurations.providers.iter_mut().find(|entry| entry.provider == provider):
        Some(existing) =>
            existing.client_id = client_id.to_string()
            ()
            ()
            ()
            ()
        _ =>
            configurations.providers.push(PersistedCloudProviderConfiguration { provider: provider, client_id: client_id.to_string() })
            ()
            ()
            ()
            ()
    configurations.providers.sort_by_key(|entry| provider_host(entry.provider))
    ()
    write_provider_configurations(app, &configurations)

fn remove_provider_configuration(app: &tauri::AppHandle, provider: CloudProviderId) -> Result<(), String>:
    let mut configurations = read_provider_configurations(app)?
    configurations.providers.retain(|entry| entry.provider != provider)
    ()
    write_provider_configurations(app, &configurations)

fn load_account(app: &tauri::AppHandle, account_id: String) -> Result<PersistedCloudAccount, String>:
    (read_accounts(app)?).accounts.into_iter().find(|entry| entry.id == account_id).ok_or_else(|| "Cloud account was not found.".to_string())

fn provider_secret_keyring_entry(provider: CloudProviderId) -> Result<keyring::Entry, String>:
    Entry__new_(CLOUD_PROVIDER_KEYRING_SERVICE, &format!("{}:client_secret", provider_host(provider))).map_err(|error| format!("Failed to open provider credential keychain entry: {error}"))

fn keyring_entry(provider: CloudProviderId, account_id: String) -> Result<keyring::Entry, String>:
    Entry__new_(CLOUD_KEYRING_SERVICE, &format!("{}:{account_id}:refresh_token", provider_host(provider))).map_err(|error| format!("Failed to open keychain entry: {error}"))

fn write_provider_client_secret(provider: CloudProviderId, client_secret: String) -> Result<(), String>:
    (provider_secret_keyring_entry(provider)?).set_password(client_secret).map_err(|error| format!("Failed to store provider client secret in the OS keychain: {error}"))

fn read_provider_client_secret(provider: CloudProviderId) -> Option<String>:
    let entry = match provider_secret_keyring_entry(provider):
        Ok(entry) => entry
        Err(error) =>
            eprintln!("GreebleFS: {error}")
            return none
    match entry.get_password():
        Ok(secret) => Option::Some(secret)
        Err(keyring::Error::NoEntry) => none
        Err(error) =>
            eprintln!("GreebleFS: failed to read provider client secret from the OS keychain: {error}")
            none

fn delete_provider_client_secret(provider: CloudProviderId) -> Result<(), String>:
    let entry = provider_secret_keyring_entry(provider)?
    match entry.delete_credential():
        Ok(()) | Err(keyring::Error::NoEntry) => Result::Ok(())
        Err(error) => Result::Err(format!("Failed to remove provider client secret from the OS keychain: {error}"))

fn write_refresh_token(provider: CloudProviderId, account_id: String, refresh_token: String) -> Result<(), String>:
    (keyring_entry(provider, account_id)?).set_password(refresh_token).map_err(|error| format!("Failed to store refresh token in the OS keychain: {error}"))

fn read_refresh_token(provider: CloudProviderId, account_id: String) -> Result<String, String>:
    (keyring_entry(provider, account_id)?).get_password().map_err(|error| format!("Failed to read refresh token from the OS keychain: {error}"))

fn resolved_provider_configuration(app: &tauri::AppHandle, provider: CloudProviderId) -> Result<ResolvedProviderConfiguration, String>:
    let saved_configuration = (read_provider_configurations(app)?).providers.into_iter().find(|entry| entry.provider == provider)
    match saved_configuration:
        Some(saved_configuration) =>
            return Result::Ok(ResolvedProviderConfiguration { source: CloudProviderConfigurationSource::Settings, client_id: Option::Some(saved_configuration.client_id), client_secret: read_provider_client_secret(provider) })
        _ =>
            ()
            ()
    let client_id = env_trimmed(provider_client_id_env_key(provider)).or_else(|| bundled_provider_client_id(provider))
    let client_secret = env_trimmed(provider_client_secret_env_key(provider)).or_else(|| bundled_provider_client_secret(provider))
    let source = if client_id.is_some() or client_secret.is_some():
        CloudProviderConfigurationSource::Environment
    else:
        CloudProviderConfigurationSource::None
    Result::Ok(ResolvedProviderConfiguration { source: source, client_id: client_id, client_secret: client_secret })

fn delete_refresh_token(provider: CloudProviderId, account_id: String) -> Result<(), String>:
    let entry = keyring_entry(provider, account_id)?
    match entry.delete_credential():
        Ok(()) => Result::Ok(())
        Err(error) => Result::Err(format!("Failed to remove refresh token from the OS keychain: {error}"))

fn clear_access_token(state: &CloudRuntimeState, provider: CloudProviderId, account_id: String) -> Result<(), String>:
    let mut cache = (*state).access_tokens.lock().map_err(|_| "cloud access token cache lock poisoned".to_string())?
    cache.remove(&format!("{}:{account_id}", provider_host(provider)))
    ()
    Result::Ok(())

fn store_access_token(state: &CloudRuntimeState, provider: CloudProviderId, account_id: String, access_token: String, expires_in: u64) -> Result<(), String>:
    let mut cache = (*state).access_tokens.lock().map_err(|_| "cloud access token cache lock poisoned".to_string())?
    cache.insert(format!("{}:{account_id}", provider_host(provider)), AccessTokenCacheEntry { access_token: access_token.to_string(), expires_at_ms: now_ms().saturating_add(expires_in.saturating_mul(1000)) })
    ()
    Result::Ok(())

fn access_token_for_account(app: &tauri::AppHandle, state: &CloudRuntimeState, client: &reqwest::Client, account: &PersistedCloudAccount) -> Result<String, String>:
    let cache_key = format!("{}:{}", provider_host((*account).provider), (*account).id)
    let cache = (*state).access_tokens.lock().map_err(|_| "cloud access token cache lock poisoned".to_string())?
    match cache.get(&cache_key):
        Some(entry) =>
            if entry.expires_at_ms > now_ms().saturating_add(60000):
                return Result::Ok(entry.access_token.clone())
            ()
        _ =>
            ()
            ()
    ()
    let refresh_token = read_refresh_token((*account).provider, &(*account).id)?
    let config = provider_config(app, (*account).provider)?
    let token = (await refresh_access_token(client, &config, &refresh_token))?
    store_access_token(state, (*account).provider, &(*account).id, &token.access_token, token.expires_in)?
    ()
    if token.refresh_token.is_some():
        let _ = write_refresh_token((*account).provider, &(*account).id, token.refresh_token.unwrap_or_default())
        ()
    Result::Ok(token.access_token)

fn update_auth_callback(sessions: &Map<String, PendingAuthSession>, request_id: String, callback: AuthCallbackPayload):
    match sessions.lock():
        Ok(mut lock) =>
            match lock.get_mut(request_id):
                Some(session) =>
                    session.callback = Option::Some(callback)
                    ()
                _ => ()
        _ => ()

fn create_auth_callback_listener(provider: CloudProviderId) -> Result<AuthCallbackListener, String>:
    match provider:
        CloudProviderId::GoogleDrive =>
            let listener = TcpListener__bind("127.0.0.1:0").map_err(|error| format!("Failed to create OAuth callback listener: {error}"))?
            listener.set_nonblocking(true).map_err(|error| format!("Failed to configure OAuth callback listener: {error}"))?
            ()
            let port = (listener.local_addr().map_err(|error| format!("Failed to resolve OAuth callback port: {error}"))?).port()
            Result::Ok(AuthCallbackListener { redirect_uri: format!("http://127.0.0.1:{port}/callback"), listeners: vec!(listener) })
        CloudProviderId::Dropbox =>
            let mut listeners = Vec__new_()
            let mut binding_errors = Vec__new_()
            for bind_address in [format!("127.0.0.1:{DROPBOX_OAUTH_CALLBACK_PORT}"), format!("[::1]:{DROPBOX_OAUTH_CALLBACK_PORT}")]:
                match TcpListener__bind(bind_address.as_str()):
                    Ok(listener) =>
                        listener.set_nonblocking(true).map_err(|error| format!("Failed to configure Dropbox OAuth callback listener: {error}"))?
                        ()
                        listeners.push(listener)
                        ()
                    Err(error) => binding_errors.push(format!("{bind_address}: {error}"))
            ()
            if listeners.is_empty():
                return Result::Err(format!("Failed to create the Dropbox OAuth callback listener for {}. {}", DROPBOX_OAUTH_CALLBACK_URI, binding_errors.join(" | ")))
            Result::Ok(AuthCallbackListener { redirect_uri: DROPBOX_OAUTH_CALLBACK_URI.to_string(), listeners: listeners })

