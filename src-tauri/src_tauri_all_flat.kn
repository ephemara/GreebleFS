    loop:
        match stream.read(&mut buffer):
            Ok(0) => break
            Ok(bytes_read) =>
                let chunk = String__from_utf8_lossy(&buffer[..bytes_read]).to_string()
                publish_host_bus_event(app, "tasks.output", serde_json__to_string(&ExtensionHostTaskOutputEvent { task_id: task_id.to_string(), stream: stream_name.to_string(), chunk: chunk }).ok(), execution_context.clone(), scope.clone(), false)
                ()
            Err(error) =>
                publish_host_bus_event(app, "tasks.progress", serde_json__to_string(&ExtensionHostTaskProgressEvent { task_id: task_id.to_string(), phase: "stream-error".to_string(), program: none, working_directory: none, exit_code: none, stream: Option::Some(stream_name.to_string()), error: Option::Some(error.to_string()) }).ok(), execution_context.clone(), scope.clone(), false)
                ()
                break

fn start_host_file_watch(app: tauri::AppHandle, request: ExtensionHostFileWatchRequest, execution_context: Option<ExecutionContextSnapshot>) -> Result<ExtensionHostFileWatchHandle, String>:
    let path = request.path.trim().to_string()
    if path.is_empty():
        return Result::Err("files.watch requires a non-empty path.".to_string())
    let watch_id = Uuid__new_v4().to_string()
    let app_for_watch = app.clone()
    let watch_id_for_events = watch_id.clone()
    let watched_path = path.clone()
    let recursive = request.recursive
    let execution_context_for_events = execution_context.clone()
    let mut watcher = notify__recommended_watcher(
        fn(result: Result<notify::Event, notify::Error>): match result:
            Ok(event) =>
                let change_kind = classify_file_watch_event_kind(&event.kind)
                publish_host_bus_event(&app_for_watch, "files.watch", serde_json__to_string(&ExtensionHostFileWatchEvent { watch_id: watch_id_for_events.clone(), kind: change_kind.to_string(), paths: event.paths.iter().map(fn(value: &std::path::PathBuf): value.to_string_lossy().to_string()).collect(), error: none }).ok(), execution_context_for_events.clone(), HostEventScope { path: Option::Some(watched_path.clone()), ..HostEventScope__default_() }, false)
                ()
            Err(error) =>
                publish_host_bus_event(&app_for_watch, "files.watch", serde_json__to_string(&ExtensionHostFileWatchEvent { watch_id: watch_id_for_events.clone(), kind: "error".to_string(), paths: Vec__new_(), error: Option::Some(error.to_string()) }).ok(), execution_context_for_events.clone(), HostEventScope { path: Option::Some(watched_path.clone()), ..HostEventScope__default_() }, false)
                ()
    ).map_err(|error| format!("Failed to create filesystem watcher: {error}"))?
    watcher.watch(
        Path__new_(&path),
        if recursive:
            notify::RecursiveMode::Recursive
        else:
            notify::RecursiveMode::NonRecursive
    ).map_err(|error| format!("Failed to start filesystem watcher: {error}"))?
    ()
    let watch_manager = app.state()
    watch_manager.insert(watch_id.clone(), RuntimeFileWatchRecord { watcher: watcher, path: path.clone(), recursive: recursive })
    ()
    Result::Ok(ExtensionHostFileWatchHandle { watch_id: watch_id, path: path, recursive: recursive })

fn classify_file_watch_event_kind(kind: &notify::EventKind) -> String:
    match kind:
        notify::EventKind::Create(_) => "create"
        notify::EventKind::Modify(_) => "modify"
        notify::EventKind::Remove(_) => "remove"
        notify::EventKind::Any => "any"
        notify::EventKind::Access(_) => "access"
        notify::EventKind::Other => "other"

fn extension_host_stat_path(path: String) -> Result<ExtensionHostFileStat, String>:
    let metadata = match std__fs__metadata(&path):
        Ok(metadata) => metadata
        Err(error) if error.kind() == io::ErrorKind::NotFound =>
            return Result::Ok(ExtensionHostFileStat { path: path.clone(), exists: false, is_directory: false, size: 0, modified_ms: none, extension: PathBuf__from(&path).extension().and_then(|value| value.to_str()).map(|value| value.to_string()) })
        Err(error) =>
            return Result::Err(format!("Failed to inspect extension host path {}: {error}", path))
    let modified_ms = metadata.modified().ok().and_then(|timestamp| timestamp.duration_since(std__time__UNIX_EPOCH).ok()).map(|duration| duration.as_millis() as u64)
    Result::Ok(ExtensionHostFileStat { path: path.clone(), exists: true, is_directory: metadata.is_dir(), size: metadata.len(), modified_ms: modified_ms, extension: PathBuf__from(&path).extension().and_then(|value| value.to_str()).map(|value| value.to_string()) })

fn dispatch_extension_host_call(app: tauri::AppHandle, registry: &RuntimeRegistry, request: ExtensionHostCallRequest, dispatch_transport: ExtensionHostDispatchTransport) -> Result<String, String>:
    let caller = resolve_extension_host_caller_permissions(&app, registry, request.caller_runtime_id, request.caller_plugin_id)?
    let caller_label = caller.map(|__kain_closure_arg3| __kain_closure_arg3.__kain_tuple_0.as_str())
    let caller_permissions = caller.map(|__kain_closure_arg4| __kain_closure_arg4.__kain_tuple_1)
    match request.method_id.as_str():
        "host.get_api_schema" =>
            encode_runtime_host_bridge_result(&runtime_pipeline__extension_host__build_extension_host_api_schema())
        "context.sync_snapshot" =>
            let payload: HostContextSyncRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let host_event_bus = app.state()
            host_event_bus.sync_execution_context(payload)?
            ()
            Result::Ok("null".to_string())
        "selection.get_snapshot" =>
            let host_event_bus = app.state()
            let snapshot = request.execution_context.or_else(|| host_event_bus.active_execution_context_snapshot()).unwrap_or_default()
            encode_runtime_host_bridge_result(&snapshot)
        "preview.get_session" =>
            let preview_session: Option<ExecutionContextPreviewSession> = request.execution_context.and_then(|context| context.preview_session.clone()).or_else(
                || block:
                    let host_event_bus = app.state()
                    host_event_bus.active_execution_context_snapshot().and_then(|context| context.preview_session)
            )
            encode_runtime_host_bridge_result(&preview_session)
        "index.init" =>
            let status_2 = global_search__global_search_init(app.clone())?
            encode_runtime_host_bridge_result(&status_2)
        "index.get_status" =>
            let status_2 = global_search__global_search_get_status()?
            encode_runtime_host_bridge_result(&status_2)
        "index.start_scan" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_read, "fsRead")?
            ()
            let payload: GlobalSearchScanSettings = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            (await global_search__global_search_start_scan(app.clone(), payload))?
            ()
            Result::Ok("null".to_string())
        "index.cancel_scan" =>
            global_search__global_search_cancel_scan()?
            ()
            Result::Ok("null".to_string())
        "index.search" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_read, "fsRead")?
            ()
            let payload: GlobalSearchIndexQueryRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let results = (await global_search__global_search_query_index(app.clone(), payload))?
            encode_runtime_host_bridge_result(&results)
        "semantic.get_summary" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_read, "fsRead")?
            ()
            let payload: ExtensionHostSemanticRootRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let summary = (await semantic_search__explorer_semantic_index_get_summary(app.clone(), payload.root_path))?
            encode_runtime_host_bridge_result(&summary)
        "semantic.build" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_read, "fsRead")?
            ()
            let payload: ExplorerSemanticIndexBuildRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let started = (await semantic_search__explorer_semantic_index_build(app.clone(), payload))?
            encode_runtime_host_bridge_result(&started)
        "semantic.search" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_read, "fsRead")?
            ()
            let payload: ExplorerSemanticSearchRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let response = (await semantic_search__explorer_semantic_search(app.clone(), payload))?
            encode_runtime_host_bridge_result(&response)
        "semantic.find_similar" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_read, "fsRead")?
            ()
            let payload: ExplorerSemanticFindSimilarRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let response = (await semantic_search__explorer_semantic_find_similar(app.clone(), payload))?
            encode_runtime_host_bridge_result(&response)
        "events.describe_topics" =>
            encode_runtime_host_bridge_result(&runtime_pipeline__host_events__builtin_host_topic_catalog())
        "events.subscribe" =>
            let payload: HostSubscriptionRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let host_event_bus = app.state()
            match dispatch_transport:
                ExtensionHostDispatchTransport::BrowserIpc =>
                    let subscription = host_event_bus.subscribe_browser(app.clone(), payload)?
                    encode_runtime_host_bridge_result(&subscription)
                ExtensionHostDispatchTransport::RuntimeSidecar => Result::Err("Sidecars must use the stdio-json-lines-v2 `subscribe` packet instead of host-call `events.subscribe`.".to_string())
        "events.unsubscribe" =>
            let payload: ExtensionHostUnsubscribeRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let host_event_bus = app.state()
            let subscription = host_event_bus.unsubscribe(&app, payload.subscription_id.as_str())
            encode_runtime_host_bridge_result(&subscription)
        "events.get_snapshot" =>
            let payload: HostSubscriptionRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let host_event_bus = app.state()
            let events = host_event_bus.snapshots_for_request(&payload)
            encode_runtime_host_bridge_result(&events)
        "events.publish" =>
            let payload: HostPublishEventRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let host_event_bus = app.state()
            let caller_extension_id = request.caller_plugin_id.clone().or_else(|| request.caller_runtime_id.clone())
            let envelope = host_event_bus.publish_extension_event(payload.topic.as_str(), payload.payload_json, request.execution_context.clone().or_else(|| host_event_bus.active_execution_context_snapshot()), caller_extension_id)?
            encode_runtime_host_bridge_result(&envelope)
        "files.read_text" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_read, "fsRead")?
            ()
            let payload: ExtensionHostReadTextRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let native_task_graph = app.state()
            let preview_streaming = app.state()
            let content = (await fs_commands__fs_read_text_file(native_task_graph, preview_streaming, payload.path))?
            encode_runtime_host_bridge_result(&content)
        "files.write_text" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_write, "fsWrite")?
            ()
            let payload: ExtensionHostWriteTextRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            (await fs_commands__fs_write_file(payload.path, FsWriteFileContent::Text(payload.content)))?
            ()
            Result::Ok("null".to_string())
        "files.create_directory" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_write, "fsWrite")?
            ()
            let payload: ExtensionHostCreateDirectoryRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            (await fs_commands__fs_create_dir(payload.path))?
            ()
            Result::Ok("null".to_string())
        "files.delete" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_write, "fsWrite")?
            ()
            let payload: ExtensionHostDeleteRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            (await fs_commands__fs_delete(payload.path, payload.recursive))?
            ()
            Result::Ok("null".to_string())
        "files.delete_many" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_write, "fsWrite")?
            ()
            let payload: ExtensionHostDeleteManyRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            (await fs_commands__fs_delete_many(payload.paths))?
            ()
            Result::Ok("null".to_string())
        "files.rename" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_write, "fsWrite")?
            ()
            let payload: ExtensionHostRenameRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let identity_manager = app.state()
            (await fs_commands__fs_rename(app.clone(), identity_manager, payload.old_path, payload.new_path))?
            ()
            Result::Ok("null".to_string())
        "files.move" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_write, "fsWrite")?
            ()
            let payload: ExtensionHostTransferRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let identity_manager = app.state()
            (await fs_commands__fs_move(app.clone(), identity_manager, payload.src, payload.dst))?
            ()
            Result::Ok("null".to_string())
        "files.copy" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_write, "fsWrite")?
            ()
            let payload: ExtensionHostTransferRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            (await fs_commands__fs_copy(payload.src, payload.dst))?
            ()
            Result::Ok("null".to_string())
        "files.trash" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_write, "fsWrite")?
            ()
            let payload: ExtensionHostTrashRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let record = (await explorer_pro_commands__fs_trash(app.clone(), payload.paths))?
            encode_runtime_host_bridge_result(&record)
        "files.list_directory" | "explorer.list_location" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_read, "fsRead")?
            ()
            let payload: ExtensionHostListDirectoryRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let listing = (await runtime_host_list_explorer_location(app.clone(), RuntimeHostExplorerListLocationRequest { path: payload.path, show_hidden: payload.show_hidden }))?
            encode_runtime_host_bridge_result(&listing)
        "files.stat" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_read, "fsRead")?
            ()
            let payload: ExtensionHostFileStatRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let stat = (await extension_host_stat_path(payload.path))?
            encode_runtime_host_bridge_result(&stat)
        "files.watch" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_watch, "fsWatch")?
            ()
            let payload: ExtensionHostFileWatchRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let handle = start_host_file_watch(app.clone(), payload, request.execution_context.clone())?
            encode_runtime_host_bridge_result(&handle)
        "files.unwatch" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.fs_watch, "fsWatch")?
            ()
            let payload: ExtensionHostFileUnwatchRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let watch_manager = app.state()
            let removed = watch_manager.remove(payload.watch_id.as_str()).map(|record| ExtensionHostFileWatchHandle { watch_id: payload.watch_id.clone(), path: record.path, recursive: record.recursive })
            encode_runtime_host_bridge_result(&removed)
        "explorer.open_path" =>
            ensure_extension_host_launch_intent(caller_label, caller_permissions, "open-explorer")?
            ()
            let payload: RuntimeHostExplorerOpenPathRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            (await runtime_host_open_explorer_path(app.clone(), payload))?
            ()
            Result::Ok("null".to_string())
        "repo.exec" =>
            let payload: ExtensionHostRepoExecRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let repo_path = payload.repo_path.clone().or_else(|| request.execution_context.and_then(|context| context.repo_context).map(|context| context.root_path.clone())).or_else(|| request.execution_context.and_then(|context| context.cwd.clone())).map(|value| value.trim().to_string()).filter(|value| !value.is_empty()).ok_or_else(|| "repo.exec requires a repository path or execution context repo root.".to_string())?
            let requires_write = extension_host_repo_command_requires_write(&payload.args)
            if requires_write:
                ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.repo_write, "repoWrite")?
                ()
                ()
                ()
                ()
            else:
                ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.repo_read or permissions.repo_write, "repoRead")?
                ()
                ()
                ()
                ()
            let result = (await fs_commands__git_exec(repo_path, payload.args))?
            encode_runtime_host_bridge_result(&result)
        "tasks.run_command" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.task_execution or permissions.spawn_processes, "taskExecution")?
            ()
            let payload: ExtensionHostTaskRunCommandRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let result = run_extension_host_task_command(payload, request.execution_context)?
            encode_runtime_host_bridge_result(&result)
        "tasks.start_process" =>
            let payload: ExtensionHostTaskStartProcessRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let handle = spawn_streamed_task_process(app.clone(), payload, request.execution_context.clone())?
            encode_runtime_host_bridge_result(&handle)
        "tasks.stop_process" =>
            let payload: ExtensionHostTaskStopProcessRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let task_processes = app.state()
            let stopped = task_processes.stop(payload.task_id.as_str())?
            if stopped:
                task_processes.remove(payload.task_id.as_str())
                ()
                publish_host_bus_event(&app, "tasks.progress", serde_json__to_string(&ExtensionHostTaskProgressEvent { task_id: payload.task_id.clone(), phase: "stopped".to_string(), program: none, working_directory: none, exit_code: none, stream: none, error: none }).ok(), request.execution_context.clone(), HostEventScope { task_id: Option::Some(payload.task_id), ..HostEventScope__default_() }, false)
                ()
                ()
                ()
                ()
            encode_runtime_host_bridge_result(&stopped)
        "terminal.spawn" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.terminal_interaction, "terminalInteraction")?
            ()
            let mut payload: RuntimeHostTerminalSpawnRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            if payload.working_dir.map(|value| value.trim().is_empty()) != Option::Some(false):
                payload.working_dir = resolve_extension_context_path(none, request.execution_context)
                ()
                ()
                ()
                ()
            (await terminal__terminal_spawn(app.state(), app.clone(), payload.id, payload.working_dir, payload.shell, payload.rows, payload.cols))?
            ()
            Result::Ok("null".to_string())
        "terminal.write" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.terminal_interaction, "terminalInteraction")?
            ()
            let payload: TerminalWriteRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            (await terminal__terminal_write(app.state(), payload.id, payload.data))?
            ()
            Result::Ok("null".to_string())
        "terminal.write_many" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.terminal_interaction, "terminalInteraction")?
            ()
            let payload: Array<TerminalWriteRequest> = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            (await terminal__terminal_write_many(app.state(), payload))?
            ()
            Result::Ok("null".to_string())
        "terminal.resize" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.terminal_interaction, "terminalInteraction")?
            ()
            let payload: RuntimeHostTerminalResizeRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            (await terminal__terminal_resize(app.state(), payload.id, payload.rows, payload.cols))?
            ()
            Result::Ok("null".to_string())
        "terminal.kill" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.terminal_interaction, "terminalInteraction")?
            ()
            let payload: RuntimeHostTerminalKillRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            (await terminal__terminal_kill(app.clone(), app.state(), payload.id))?
            ()
            Result::Ok("null".to_string())
        "terminal.open_output_stream" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.terminal_interaction, "terminalInteraction")?
            ()
            let payload: RuntimeHostTerminalOpenOutputStreamRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let stream = (await terminal__terminal_open_output_stream(app.clone(), app.state(), payload.id))?
            encode_runtime_host_bridge_result(&stream)
        "terminal.register_shell_integration" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.terminal_interaction, "terminalInteraction")?
            ()
            let payload: TerminalShellIntegrationRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let state = (await terminal__terminal_register_shell_integration(app.clone(), app.state(), payload))?
            encode_runtime_host_bridge_result(&state)
        "terminal.sync_cwd" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.terminal_interaction, "terminalInteraction")?
            ()
            let payload: RuntimeHostTerminalSyncCwdRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let state = (await terminal__terminal_sync_cwd(app.clone(), app.state(), payload.id, payload.cwd))?
            encode_runtime_host_bridge_result(&state)
        "terminal.set_prompt_state" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.terminal_interaction, "terminalInteraction")?
            ()
            let payload: RuntimeHostTerminalSetPromptStateRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            let state = (await terminal__terminal_set_prompt_state(app.clone(), app.state(), payload.id, payload.at_prompt, payload.reported_cwd))?
            encode_runtime_host_bridge_result(&state)
        "terminal.open_external" =>
            ensure_extension_host_permission(caller_label, caller_permissions, |permissions| permissions.terminal_interaction, "terminalInteraction")?
            ()
            ensure_extension_host_launch_intent(caller_label, caller_permissions, "open-terminal")?
            ()
            let mut payload: ExternalTerminalRequest = decode_runtime_host_bridge_payload(&request.method_id, request.payload_json)?
            if payload.working_dir.trim().is_empty():
                payload.working_dir = resolve_extension_context_path(none, request.execution_context).ok_or_else(|| "terminal.open_external requires a working directory or execution context cwd.".to_string())?
                ()
                ()
                ()
                ()
            (await terminal__terminal_open_external(payload))?
            ()
            Result::Ok("null".to_string())
        _ => Result::Err(format!("Extension host requested unknown method {}.", request.method_id))

fn dispatch_runtime_sidecar_host_call(app: &tauri::AppHandle, registry: &RuntimeRegistry, runtime_id: String, method_id: String, payload_json: Option<String>, execution_context: Option<ExecutionContextSnapshot>) -> Result<String, String>:
    tauri__async_runtime__block_on(dispatch_extension_host_call(app.clone(), registry, ExtensionHostCallRequest { caller_plugin_id: none, caller_runtime_id: Option::Some(runtime_id.to_string()), method_id: method_id.to_string(), payload_json: payload_json, execution_context: execution_context }, ExtensionHostDispatchTransport::RuntimeSidecar))

struct RuntimeListPackagesRequest:
    additional_roots: Array<RuntimeDiscoveryRootDto>

struct RuntimeDiscoveryRootDto:
    root_id: String
    origin: RuntimePackageOrigin
    directory: String

struct RuntimeListPackagesResponse:
    packages: Array<DiscoveredRuntimePackage>
    builtin_root: Option<String>
    managed_root: Option<String>

struct RuntimePreparePackageRequest:
    runtime_id: String
    mode: String
    target: Option<String>
    force_rebuild: Bool

fn default_release_mode() -> String:
    "release".to_string()

struct RuntimePreparePackageResponse:
    runtime_id: String
    artifact_path: String
    artifact_kind: String
    cache_key: String
    cache_hit: Bool
    toolchain_version: String
    mode: String
    target: String
    source_signature: String
    stdout: String
    stderr: String

struct RuntimeReadArtifactBytesRequest:
    runtime_id: String
    cache_key: String
    artifact_kind: String

struct RuntimeStartSidecarRequest:
    runtime_id: String

struct RuntimeStopSidecarRequest:
    runtime_id: String

struct RuntimeCallRequest:
    runtime_id: String
    action_id: String
    payload_json: Option<String>
    working_directory: Option<String>
    environment: Option<Map<String, String>>
    execution_context: Option<ExecutionContextSnapshot>
    start_if_needed: Option<Bool>

struct RuntimeOpenTuiRequest:
    runtime_id: String

fn runtime_list_packages(app: tauri::AppHandle, registry: tauri::State<_, RuntimeRegistry>, request: Option<RuntimeListPackagesRequest>) -> Result<RuntimeListPackagesResponse, String>:
    let request = request.unwrap_or(RuntimeListPackagesRequest__default_empty())
    let mut roots = build_default_discovery_roots(&app)
    let builtin_root = roots.iter().find(|root| root.root_id == BUILTIN_RUNTIMES_ROOT_ID).map(|root| root.directory.to_string_lossy().to_string())
    let managed_root = roots.iter().find(|root| root.root_id == MANAGED_RUNTIMES_ROOT_ID).map(|root| root.directory.to_string_lossy().to_string())
    for additional in request.additional_roots:
        roots.push(RuntimeDiscoveryRoot__new_(additional.root_id, additional.origin, PathBuf__from(additional.directory)))
        ()
    ()
    let packages = registry.refresh_from_roots(roots)
    Result::Ok(RuntimeListPackagesResponse { packages: packages, builtin_root: builtin_root, managed_root: managed_root })

impl RuntimeListPackagesRequest:
    fn default_empty() -> RuntimeListPackagesRequest:
        RuntimeListPackagesRequest { additional_roots: Vec__new_() }


fn runtime_get_toolchain_status(app: tauri::AppHandle) -> Result<RuntimeToolchainStatus, String>:
    let context = runtime_toolchain_context(&app)
    Result::Ok(runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(&context))

fn runtime_prepare_package(app: tauri::AppHandle, registry: tauri::State<_, RuntimeRegistry>, request: RuntimePreparePackageRequest) -> Result<RuntimePreparePackageResponse, String>:
    let package = require_package(&registry, &app, &request.runtime_id)?
    let manifest = &package.manifest
    let target = request.target.clone().unwrap_or_else(|| runtime_pipeline__driver__default_target_for_compiler(manifest.compiler))
    let mode = request.mode.clone()
    let toolchain_context = runtime_toolchain_context(&app)
    let toolchain_version = runtime_pipeline__driver__resolve_toolchain_version(manifest.compiler, &toolchain_context)?
    let layout = CompileCacheLayout__from_app(&app)?
    let cache_key = CacheKeyParts { runtime_id: &manifest.id, compiler: manifest.compiler.as_str(), toolchain_version: &toolchain_version, target: &target, mode: &mode, source_signature: &manifest.source_signature }.finalize()
    let entry = layout.entry_for(&cache_key)
    entry.ensure_dir()?
    ()
    let artifact_name = runtime_pipeline__driver__artifact_name_for_compiler(manifest.compiler, &manifest.id)
    let artifact_path = entry.artifact_path(&artifact_name)
    let cache_hit = !request.force_rebuild and artifact_path.exists()
    let mut stdout = String__new_()
    let mut stderr = String__new_()
    if !cache_hit:
        let build_result = runtime_pipeline__driver__invoke_build_script(manifest, &artifact_path, &target, &mode, &toolchain_context)?
        stdout = build_result.stdout
        ()
        stderr = build_result.stderr
        ()
        ()
        ()
        ()
    Result::Ok(RuntimePreparePackageResponse { runtime_id: manifest.id.clone(), artifact_path: artifact_path.to_string_lossy().to_string(), artifact_kind: artifact_name, cache_key: cache_key, cache_hit: cache_hit, toolchain_version: toolchain_version, mode: mode, target: target, source_signature: manifest.source_signature.clone(), stdout: stdout, stderr: stderr })

fn validate_runtime_artifact_cache_key(cache_key: String) -> Result<(), String>:
    if cache_key.len() == 64 and cache_key.chars().all(|character| character.is_ascii_hexdigit()):
        return Result::Ok(())
    Result::Err("Runtime artifact cache keys must be 64-character SHA-256 hex digests.".to_string())

fn validate_runtime_artifact_file_name(artifact_kind: String) -> Result<(), String>:
    if artifact_kind.trim().is_empty():
        return Result::Err("Runtime artifact kind cannot be empty.".to_string())
    if artifact_kind.contains("/") or artifact_kind.contains("\\"):
        return Result::Err("Runtime artifact kind must be a file name, not a path.".to_string())
    if artifact_kind == "." or artifact_kind == "..":
        return Result::Err("Runtime artifact kind cannot be a relative path segment.".to_string())
    Result::Ok(())

fn resolve_runtime_artifact_cache_path(layout: &CompileCacheLayout, request: &RuntimeReadArtifactBytesRequest) -> Result<std::path::PathBuf, String>:
    validate_runtime_artifact_cache_key(&(*request).cache_key)?
    ()
    validate_runtime_artifact_file_name(&(*request).artifact_kind)?
    ()
    Result::Ok(layout.entry_for(&(*request).cache_key).artifact_path(&(*request).artifact_kind))

fn canonicalize_runtime_artifact_inside_cache(layout: &CompileCacheLayout, artifact_path: &std::path::Path) -> Result<std::path::PathBuf, String>:
    let cache_root = std__fs__canonicalize(&(*layout).root_dir).map_err(|error| format!("Failed to resolve runtime cache root '{}': {error}", (*layout).root_dir.display()))?
    let artifact = std__fs__canonicalize(artifact_path).map_err(|error| format!("Failed to resolve runtime artifact '{}': {error}", artifact_path.display()))?
    if !artifact.starts_with(&cache_root):
        return Result::Err(format!("Runtime artifact '{}' is outside the runtime cache root.", artifact.display()))
    Result::Ok(artifact)

fn runtime_read_artifact_bytes(app: tauri::AppHandle, registry: tauri::State<_, RuntimeRegistry>, request: RuntimeReadArtifactBytesRequest) -> Result<tauri::transport::BinaryResponse, String>:
    let package = require_package(&registry, &app, &request.runtime_id)?
    if !package.manifest.kind.is_wasm() or !package.manifest.compiler.produces_wasm():
        return Result::Err(format!("runtime_read_artifact_bytes requires a wasm runtime (got kind = {}, compiler = {})", package.manifest.kind.as_str(), package.manifest.compiler.as_str()))
    let expected_artifact_kind = runtime_pipeline__driver__artifact_name_for_compiler(package.manifest.compiler, &package.manifest.id)
    if request.artifact_kind != expected_artifact_kind:
        return Result::Err(format!("Runtime artifact kind '{}' does not match expected artifact '{}' for runtime '{}'.", request.artifact_kind, expected_artifact_kind, package.manifest.id))
    let layout = CompileCacheLayout__from_app(&app)?
    let artifact_path = resolve_runtime_artifact_cache_path(&layout, &request)?
    let artifact_path = canonicalize_runtime_artifact_inside_cache(&layout, &artifact_path)?
    let metadata = (await tokio__fs__metadata(&artifact_path)).map_err(|error| format!("Failed to inspect runtime artifact '{}': {error}", artifact_path.display()))?
    if !metadata.is_file():
        return Result::Err(format!("Runtime artifact '{}' is not a file.", artifact_path.display()))
    if metadata.len() > RUNTIME_ARTIFACT_BYTES_MAX_BYTES:
        return Result::Err(format!("Runtime artifact '{}' is too large to load into a wasm panel (> {} MB).", artifact_path.display(), RUNTIME_ARTIFACT_BYTES_MAX_BYTES / (1024 * 1024)))
    let bytes = (await tokio__fs__read(&artifact_path)).map_err(|error| format!("Failed to read runtime artifact '{}': {error}", artifact_path.display()))?
    Result::Ok(BinaryResponse__new_(bytes))

fn runtime_start_sidecar(app: tauri::AppHandle, registry: tauri::State<_, RuntimeRegistry>, sidecar_state: tauri::State<_, ExternalSidecarManager>, request: RuntimeStartSidecarRequest) -> Result<ExternalRuntimeSidecarStatus, String>:
    let package = require_package(&registry, &app, &request.runtime_id)?
    if matches!(package.manifest.compiler, RuntimeCompiler::PythonSidecar):
        return Result::Err("Use the legacy `python_*` Tauri commands for Python sidecars; this lane is for external native/Wasm/Kain runtimes.".to_string())
    let prepared = (await runtime_prepare_package(app.clone(), registry.clone(), RuntimePreparePackageRequest { runtime_id: package.manifest.id.clone(), mode: "release".to_string(), target: none, force_rebuild: false }))?
    let binary_path = PathBuf__from(prepared.artifact_path)
    sidecar_state.start(&app, &package.manifest, &binary_path)

fn runtime_stop_sidecar(app: tauri::AppHandle, sidecar_state: tauri::State<_, ExternalSidecarManager>, request: RuntimeStopSidecarRequest) -> Result<ExternalRuntimeSidecarStatus, String>:
    Result::Ok(sidecar_state.stop(&app, &request.runtime_id))

fn runtime_call(app: tauri::AppHandle, registry: tauri::State<_, RuntimeRegistry>, sidecar_state: tauri::State<_, ExternalSidecarManager>, request: RuntimeCallRequest) -> Result<ExternalRuntimeSidecarCallResponse, String>:
    let package = require_package(&registry, &app, &request.runtime_id)?
    if !matches!(package.manifest.kind, RuntimeKind::NativeSidecar | RuntimeKind::VscodeBridge):
        return Result::Err(format!("runtime_call requires a long-lived sidecar runtime (got kind = {})", package.manifest.kind.as_str()))
    if request.start_if_needed.unwrap_or(true):
        let status_2 = sidecar_state.status_2(&request.runtime_id)
        if !status_2.running:
            let _ = (await runtime_start_sidecar(app.clone(), registry.clone(), sidecar_state.clone(), RuntimeStartSidecarRequest { runtime_id: request.runtime_id.clone() }))?
            ()
        ()
    let request_for_sidecar_call = request.clone()
    let app_for_sidecar_call = app.clone()
    (await tauri__async_runtime__spawn_blocking(
        || block:
            let sidecar_state = app_for_sidecar_call.state()
            sidecar_state.call(&request_for_sidecar_call.runtime_id, &request_for_sidecar_call.action_id, request_for_sidecar_call.payload_json, request_for_sidecar_call.working_directory, request_for_sidecar_call.environment, request_for_sidecar_call.execution_context.clone())
    )).map_err(|error| format!("Runtime sidecar call task failed to join: {error}"))?

fn runtime_run_command(app: tauri::AppHandle, registry: tauri::State<_, RuntimeRegistry>, request: ExternalRuntimeCommandRequest) -> Result<ExternalRuntimeCommandResult, String>:
    let package = require_package(&registry, &app, &request.runtime_id)?
    if !matches!(package.manifest.kind, RuntimeKind::NativeCommand):
        return Result::Err(format!("runtime_run_command requires a native-command runtime (got kind = {})", package.manifest.kind.as_str()))
    let prepared = (await runtime_prepare_package(app, registry, RuntimePreparePackageRequest { runtime_id: package.manifest.id.clone(), mode: "release".to_string(), target: none, force_rebuild: false }))?
    let binary_path = PathBuf__from(prepared.artifact_path)
    runtime_pipeline__command_runtime__run_native_command(&package.manifest, &binary_path, request)

fn runtime_open_tui(app: tauri::AppHandle, registry: tauri::State<_, RuntimeRegistry>, request: RuntimeOpenTuiRequest) -> Result<ExternalRuntimeTuiLaunch, String>:
    let package = require_package(&registry, &app, &request.runtime_id)?
    if !matches!(package.manifest.kind, RuntimeKind::NativeTui):
        return Result::Err(format!("runtime_open_tui requires a native-tui runtime (got kind = {})", package.manifest.kind.as_str()))
    let prepared = (await runtime_prepare_package(app, registry, RuntimePreparePackageRequest { runtime_id: package.manifest.id.clone(), mode: "release".to_string(), target: none, force_rebuild: false }))?
    runtime_pipeline__tui__build_tui_launch(&package.manifest, prepared.artifact_path)

fn extension_host_get_api_schema() -> Result<ExtensionHostApiSchema, String>:
    Result::Ok(runtime_pipeline__extension_host__build_extension_host_api_schema())

fn extension_host_call(app: tauri::AppHandle, registry: tauri::State<_, RuntimeRegistry>, request: ExtensionHostCallRequest) -> Result<ExtensionHostCallResponse, String>:
    let method_id = request.method_id.clone()
    let result_json = (await dispatch_extension_host_call(app, &registry, request, ExtensionHostDispatchTransport::BrowserIpc))?
    Result::Ok(ExtensionHostCallResponse { method_id: method_id, result_json: result_json })

fn extension_inspect(request: ExtensionInspectRequest) -> Result<ExtensionInspection, String>:
    let source_path = PathBuf__from(request.path)
    runtime_pipeline__extension_host__inspect_extension_source(source_path.as_path())

fn extension_build(request: ExtensionBuildRequest) -> Result<ExtensionBuildResult, String>:
    let source_directory = PathBuf__from(&request.source_directory)
    let output_directory = request.output_directory.clone().map(PathBuf__from).unwrap_or_else(|| source_directory.join(".greeble-build"))
    runtime_pipeline__extension_host__build_extension_source(&source_directory, &output_directory, request.include_debug_sources)

fn extension_pack(request: ExtensionPackRequest) -> Result<ExtensionPackResult, String>:
    let source_directory = PathBuf__from(&request.source_directory)
    let output_path = request.output_path.clone().map(PathBuf__from).unwrap_or_else(|| runtime_pipeline__extension_host__resolve_default_bundle_output_path(&source_directory))
    runtime_pipeline__extension_host__pack_extension_source(&source_directory, &output_path, request.include_debug_sources)

fn extension_install(app: tauri::AppHandle, request: ExtensionInstallRequest) -> Result<ExtensionInstallResult, String>:
    let managed_root = usr__resolve_managed_content_root(&app)?
    let install_root = runtime_pipeline__extension_host__resolve_extension_install_root(&managed_root)
    let bundle_path = PathBuf__from(&request.bundle_path)
    runtime_pipeline__extension_host__install_extension_bundle_into(bundle_path.as_path(), &install_root, request.replace_existing)

fn require_package(registry: &RuntimeRegistry, app: &tauri::AppHandle, runtime_id: String) -> Result<DiscoveredRuntimePackage, String>:
    match registry.get_by_id(runtime_id):
        Some(pkg) =>
            return Result::Ok(pkg)
        _ =>
            ()
            ()
    let roots = build_default_discovery_roots(app)
    registry.refresh_from_roots(roots)
    ()
    registry.get_by_id(runtime_id).ok_or_else(|| format!("runtime package {} is not registered", runtime_id))

fn build_default_discovery_roots(app: &tauri::AppHandle) -> Array<RuntimeDiscoveryRoot>:
    let mut roots = Vec__new_()
    match repo_builtin_runtimes_root():
        Some(builtin) =>
            if builtin.exists():
                roots.push(RuntimeDiscoveryRoot__new_(BUILTIN_RUNTIMES_ROOT_ID, RuntimePackageOrigin::Builtin, builtin))
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    for node_root in builtin_node_runtimes_roots(app):
        if node_root.exists():
            roots.push(RuntimeDiscoveryRoot__new_(BUILTIN_RUNTIMES_ROOT_ID, RuntimePackageOrigin::Builtin, node_root))
            ()
    ()
    for kain_root in builtin_kain_runtimes_roots(app):
        if kain_root.exists():
            roots.push(RuntimeDiscoveryRoot__new_(BUILTIN_RUNTIMES_ROOT_ID, RuntimePackageOrigin::Builtin, kain_root))
            ()
    ()
    match repo_python_sidecar_root():
        Some(python_root) =>
            if python_root.join("runtime.toml").exists():
                roots.push(RuntimeDiscoveryRoot__new_(BUILTIN_RUNTIMES_ROOT_ID, RuntimePackageOrigin::Builtin, python_root))
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    match managed_runtimes_root(app):
        Some(managed) =>
            if managed.exists():
                roots.push(RuntimeDiscoveryRoot__new_(MANAGED_RUNTIMES_ROOT_ID, RuntimePackageOrigin::ManagedContent, managed))
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    roots

fn runtime_toolchain_context(app: &tauri::AppHandle) -> RuntimeToolchainContext:
    RuntimeToolchainContext { resource_dir: app.path().resource_dir().ok() }

fn repo_python_sidecar_root() -> Option<std::path::PathBuf>:
    let manifest_dir = std__env__var_("CARGO_MANIFEST_DIR").ok()?
    Option::Some(PathBuf__from(manifest_dir).join("../src-python"))

fn repo_builtin_runtimes_root() -> Option<std::path::PathBuf>:
    let manifest_dir = std__env__var_("CARGO_MANIFEST_DIR").ok()?
    Option::Some(PathBuf__from(manifest_dir).join(BUILTIN_RUNTIMES_REPO_RELATIVE))

fn builtin_node_runtimes_roots(app: &tauri::AppHandle) -> Array<std::path::PathBuf>:
    let mut roots = Vec__new_()
    match std__env__var_("CARGO_MANIFEST_DIR"):
        Ok(manifest_dir) =>
            roots.push(PathBuf__from(manifest_dir).join(BUILTIN_NODE_RUNTIMES_REPO_RELATIVE))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match app.path().resource_dir():
        Ok(resource_dir) =>
            roots.push(resource_dir.join(BUILTIN_NODE_RUNTIMES_RESOURCE_RELATIVE))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    roots

fn builtin_kain_runtimes_roots(app: &tauri::AppHandle) -> Array<std::path::PathBuf>:
    let mut roots = Vec__new_()
    match std__env__var_("CARGO_MANIFEST_DIR"):
        Ok(manifest_dir) =>
            roots.push(PathBuf__from(manifest_dir).join(BUILTIN_KAIN_RUNTIMES_REPO_RELATIVE))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match app.path().resource_dir():
        Ok(resource_dir) =>
            roots.push(resource_dir.join(BUILTIN_KAIN_RUNTIMES_RESOURCE_RELATIVE))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    roots

fn managed_runtimes_root(app: &tauri::AppHandle) -> Option<std::path::PathBuf>:
    if cfg!(debug_assertions):
        match std__env__var_("CARGO_MANIFEST_DIR"):
            Ok(manifest_dir) =>
                let candidate = PathBuf__from(manifest_dir).join("../runtimes")
                if candidate.exists():
                    return Option::Some(candidate)
                ()
            _ =>
                ()
                ()
        ()
    let local = app.path().app_local_data_dir().ok()?
    Option::Some(local.join(RUNTIMES_MANAGED_DIR_NAME))

enum RuntimePackageOrigin:
    Builtin
    ManagedContent

struct DiscoveredRuntimePackage:
    manifest: RuntimeManifest
    origin: RuntimePackageOrigin
    root_id: String

struct RuntimeDiscoveryRoot:
    root_id: String
    origin: RuntimePackageOrigin
    directory: std::path::PathBuf

impl RuntimeDiscoveryRoot:
    fn new_(root_id: impl Into<String>, origin: RuntimePackageOrigin, directory: impl Into<std::path::PathBuf>) -> RuntimeDiscoveryRoot:
        RuntimeDiscoveryRoot { root_id: root_id.into(), origin: origin, directory: directory.into() }


fn discover_runtime_packages(roots: &Slice<RuntimeDiscoveryRoot>) -> Array<DiscoveredRuntimePackage>:
    let mut out_ = Vec__new_()
    for root in roots:
        if !root.directory.exists():
            continue
        let entries = match std__fs__read_dir(&root.directory):
            Ok(entries) => entries
            Err(_) => continue
        for entry in entries.flatten():
            let metadata = match entry.metadata():
                Ok(metadata) => metadata
                Err(_) => continue
            if !metadata.is_dir():
                continue
            let path = entry.path()
            if !is_potential_runtime_package(&path):
                continue
            match RuntimeManifest__from_dir(&path):
                Ok(manifest) =>
                    if root.origin == RuntimePackageOrigin::ManagedContent:
                        match enforce_managed_path_sandbox(&path, &manifest):
                            Err(error) =>
                                log::warn!("GreebleFS: rejecting managed runtime package at {}: {error}", path.to_string_lossy())
                                continue
                            _ =>
                                ()
                                ()
                        ()
                    out_.push(DiscoveredRuntimePackage { manifest: manifest, origin: root.origin, root_id: root.root_id.clone() })
                    ()
                Err(error) =>
                    log::warn!("GreebleFS: skipping runtime package at {}: {error}", path.to_string_lossy())
    ()
    out_

fn is_potential_runtime_package(dir: &std::path::Path) -> Bool:
    dir.join(RuntimeManifest::FILE_NAME).exists()

fn enforce_managed_path_sandbox(package_dir: &std::path::Path, manifest: &RuntimeManifest) -> Result<(), String>:
    ensure_path_inside_root(Path__new_(&(*manifest).module_dir), package_dir)?
    ()
    match (*manifest).entry:
        Some(entry) =>
            let entry_path = Path__new_(entry)
            if entry_path.exists():
                ensure_path_inside_root(entry_path, package_dir)?
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    match (*manifest).working_directory:
        Some(working_directory) =>
            ensure_path_inside_root(Path__new_(working_directory), package_dir)?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn ensure_path_inside_root(candidate: &std::path::Path, containing_root: &std::path::Path) -> Result<std::path::PathBuf, String>:
    let canonical_candidate = candidate.canonicalize().map_err(|error| format!("failed to canonicalize {}: {error}", candidate.to_string_lossy()))?
    let canonical_root = containing_root.canonicalize().map_err(|error| format!("failed to canonicalize root {}: {error}", containing_root.to_string_lossy()))?
    if !canonical_candidate.starts_with(&canonical_root):
        return Result::Err(format!("path {} is outside the allowed root {}", canonical_candidate.to_string_lossy(), canonical_root.to_string_lossy()))
    Result::Ok(canonical_candidate)

struct RuntimeCompilerBuildOutput:
    stdout: String
    stderr: String

impl Default for RuntimeCompilerBuildOutput:
    fn default_() -> RuntimeCompilerBuildOutput:
        RuntimeCompilerBuildOutput { stdout: String__new_(), stderr: String__new_() }


struct RuntimeCompilerDriver:
    default_target_resolver: fn() -> String
    toolchain_version_resolver: ToolchainVersionResolver
    artifact_name_builder: fn(String) -> String
    build_invoker: RuntimeBuildInvoker

impl RuntimeCompilerDriver:
    fn default_target(_self: &RuntimeCompilerDriver) -> String:
        (*_self).default_target_resolver()

    fn resolve_toolchain_version(_self: &RuntimeCompilerDriver, context: &RuntimeToolchainContext) -> Result<String, String>:
        (*_self).toolchain_version_resolver(context)

    fn artifact_name(_self: &RuntimeCompilerDriver, runtime_id: String) -> String:
        (*_self).artifact_name_builder(runtime_id)

    fn invoke_build(_self: &RuntimeCompilerDriver, manifest: &RuntimeManifest, artifact_path: &std::path::Path, target: String, mode: String, context: &RuntimeToolchainContext) -> Result<RuntimeCompilerBuildOutput, String>:
        (*_self).build_invoker(manifest, artifact_path, target, mode, context)


fn default_target_for_compiler(compiler: RuntimeCompiler) -> String:
    require_runtime_compiler_driver(compiler).default_target()

fn resolve_toolchain_version(compiler: RuntimeCompiler, context: &RuntimeToolchainContext) -> Result<String, String>:
    require_runtime_compiler_driver(compiler).resolve_toolchain_version(context)

fn artifact_name_for_compiler(compiler: RuntimeCompiler, runtime_id: String) -> String:
    require_runtime_compiler_driver(compiler).artifact_name(runtime_id)

fn invoke_build_script(manifest: &RuntimeManifest, artifact_path: &std::path::Path, target: String, mode: String, context: &RuntimeToolchainContext) -> Result<RuntimeCompilerBuildOutput, String>:
    require_runtime_compiler_driver((*manifest).compiler).invoke_build(manifest, artifact_path, target, mode, context)

fn require_runtime_compiler_driver(compiler: RuntimeCompiler) -> &RuntimeCompilerDriver:
    match compiler:
        RuntimeCompiler::GoNative => &GO_NATIVE_DRIVER
        RuntimeCompiler::CargoNative => &CARGO_NATIVE_DRIVER
        RuntimeCompiler::CNative => &C_NATIVE_DRIVER
        RuntimeCompiler::GoJsWasm => &GO_JS_WASM_DRIVER
        RuntimeCompiler::TinygoWasm => &TINYGO_WASM_DRIVER
        RuntimeCompiler::CargoWasmBindgen => &CARGO_WASM_BINDGEN_DRIVER
        RuntimeCompiler::PythonSidecar => &PYTHON_SIDECAR_DRIVER
        RuntimeCompiler::KainScript => &KAIN_SCRIPT_DRIVER
        RuntimeCompiler::NodeScript => &NODE_SCRIPT_DRIVER

fn host_target_triple() -> String:
    format!("{}-{}", std__env__consts__OS, std__env__consts__ARCH)

fn default_js_wasm_target() -> String:
    "js-wasm".to_string()

fn default_cargo_host_target() -> String:
    "cargo-host".to_string()

fn default_cargo_wasm_bindgen_target() -> String:
    "wasm-bindgen-web".to_string()

fn default_c_host_target() -> String:
    "c-host".to_string()

fn default_tinygo_wasm_target() -> String:
    "tinygo-wasm".to_string()

fn default_python_host_target() -> String:
    "python-host".to_string()

fn default_kain_host_target() -> String:
    "kain-host".to_string()

fn default_node_host_target() -> String:
    "node-host".to_string()

fn resolve_probe_version(probe: &ToolchainProbe) -> Result<String, String>:
    resolve_installed_toolchain_version(probe)

fn resolve_go_toolchain_version(context: &RuntimeToolchainContext) -> Result<String, String>:
    let probe = runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(context)
    resolve_probe_version(&probe.go)

fn resolve_cargo_toolchain_version(context: &RuntimeToolchainContext) -> Result<String, String>:
    let probe = runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(context)
    resolve_probe_version(&probe.cargo)

fn resolve_c_toolchain_version(context: &RuntimeToolchainContext) -> Result<String, String>:
    let probe = runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(context)
    resolve_probe_version(&probe.cc)

fn resolve_tinygo_toolchain_version(context: &RuntimeToolchainContext) -> Result<String, String>:
    let probe = runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(context)
    resolve_probe_version(&probe.tinygo)

fn resolve_python_toolchain_version(context: &RuntimeToolchainContext) -> Result<String, String>:
    let probe = runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(context)
    resolve_probe_version(&probe.python)

fn resolve_kain_toolchain_version(context: &RuntimeToolchainContext) -> Result<String, String>:
    let probe = runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(context)
    resolve_probe_version(&probe.kain)

fn resolve_node_toolchain_version(context: &RuntimeToolchainContext) -> Result<String, String>:
    let probe = runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(context)
    resolve_probe_version(&probe.node)

fn resolve_cargo_wasm_bindgen_toolchain_version(context: &RuntimeToolchainContext) -> Result<String, String>:
    let probe = runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(context)
    let cargo_version = resolve_probe_version(&probe.cargo)?
    let wasm_bindgen_version = resolve_probe_version(&probe.wasm_bindgen)?
    Result::Ok(format!("cargo-{cargo_version}+wasm-bindgen-{wasm_bindgen_version}"))

fn resolve_installed_toolchain_version(probe: &ToolchainProbe) -> Result<String, String>:
    if !(*probe).installed:
        return Result::Err(format!("toolchain {} is not installed: {}", (*probe).id, (*probe).error.clone().unwrap_or_else(|| "missing".to_string())))
    Result::Ok((*probe).version.clone().unwrap_or_else(|| "unknown".to_string()))

fn build_native_binary_artifact_name(runtime_id: String) -> String:
    if cfg!(target_os = "windows"):
        format!("{runtime_id}.exe")
    else:
        runtime_id.to_string()

fn build_wasm_artifact_name(runtime_id: String) -> String:
    format!("{runtime_id}.wasm")

fn build_javascript_artifact_name(runtime_id: String) -> String:
    format!("{runtime_id}.js")

fn build_python_sidecar_artifact_name(_: String) -> String:
    "python-sidecar.entry".to_string()

fn build_node_launcher_artifact_name(runtime_id: String) -> String:
    format!("{runtime_id}.cjs")

fn skip_host_build(_: &RuntimeManifest, _: &std::path::Path, _: String, _: String, _: &RuntimeToolchainContext) -> Result<RuntimeCompilerBuildOutput, String>:
    Result::Ok(RuntimeCompilerBuildOutput__default_())

fn invoke_kain_script_build(_: &RuntimeManifest, artifact_path: &std::path::Path, _: String, _: String, context: &RuntimeToolchainContext) -> Result<RuntimeCompilerBuildOutput, String>:
    let probe = runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(context).kain
    resolve_probe_version(&probe)?
    ()
    let executable_path = probe.executable_path.ok_or_else(|| "Kain probe did not report an executable path".to_string())?
    let executable_path = PathBuf__from(executable_path)
    if executable_path.file_name().and_then(|name| name.to_str()) != Option::Some(runtime_pipeline__toolchain__kain_executable_name()):
        return Result::Err(format!("Kain probe resolved {}, expected {}", executable_path.display(), runtime_pipeline__toolchain__kain_executable_name()))
    match artifact_path.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("failed to create Kain runtime artifact directory {}: {error}", parent.display()))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    std__fs__copy(&executable_path, artifact_path).map_err(|error| format!("failed to stage Kain launcher {} -> {}: {error}", executable_path.display(), artifact_path.display()))?
    ()
    Result::Ok(RuntimeCompilerBuildOutput { stdout: format!("staged Kain launcher {} -> {}", executable_path.display(), artifact_path.display()), stderr: String__new_() })

fn invoke_node_script_build(manifest: &RuntimeManifest, artifact_path: &std::path::Path, _: String, _: String, context: &RuntimeToolchainContext) -> Result<RuntimeCompilerBuildOutput, String>:
    let probe = runtime_pipeline__toolchain__probe_runtime_toolchains_with_context(context).node
    resolve_probe_version(&probe)?
    ()
    let entry = (*manifest).entry.ok_or_else(|| format!("node-script runtime {} must declare an entry script.", (*manifest).id))?
    let entry_path = PathBuf__from(entry)
    if !entry_path.exists():
        return Result::Err(format!("node-script runtime entry {} does not exist.", entry_path.display()))
    match artifact_path.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("failed to create Node runtime artifact directory {}: {error}", parent.display()))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let escaped_entry = entry_path.to_string_lossy().replace("\\", "\\\\").replace("'", "\\'")
    let launcher = format!("'use strict';\nprocess.env.GREEBLEFS_NODE_RUNTIME_ENTRY = '{escaped_entry}';\nrequire('{escaped_entry}');\n")
    std__fs__write(artifact_path, launcher).map_err(|error| format!("failed to stage Node launcher {}: {error}", artifact_path.display()))?
    ()
    Result::Ok(RuntimeCompilerBuildOutput { stdout: format!("staged Node launcher {} -> {}", entry_path.display(), artifact_path.display()), stderr: String__new_() })

fn invoke_go_build_script(manifest: &RuntimeManifest, artifact_path: &std::path::Path, target: String, mode: String, _: &RuntimeToolchainContext) -> Result<RuntimeCompilerBuildOutput, String>:
    let script_path = resolve_go_build_script_path().ok_or_else(|| "scripts/go/build.sh could not be located. Set GREEBLEFS_GO_BUILD_SCRIPT or reinstall the app so app-local data contains scripts/go/build.sh.".to_string())?
    let mut command = Command__new_("bash")
    command.arg(&script_path).arg("--runtime-id").arg(&(*manifest).id).arg("--module-dir").arg(&(*manifest).module_dir).arg("--entry").arg((*manifest).entry.unwrap_or(".")).arg("--compiler").arg((*manifest).compiler.as_str()).arg("--target").arg(target).arg("--mode").arg(mode).arg("--output").arg(artifact_path)
    ()
    let output = command.output().map_err(|error| format!("failed to run go build script: {error}"))?
    let stdout = String__from_utf8_lossy(&output.stdout).to_string()
    let stderr = String__from_utf8_lossy(&output.stderr).to_string()
    if !output.status.success():
        return Result::Err(format!("go build script exited with status {}: {}", output.status, if stderr.is_empty():
            stdout.as_str()
        else:
            stderr.as_str()))
    Result::Ok(RuntimeCompilerBuildOutput { stdout: stdout, stderr: stderr })

fn invoke_cargo_build(manifest: &RuntimeManifest, artifact_path: &std::path::Path, target: String, mode: String, _: &RuntimeToolchainContext) -> Result<RuntimeCompilerBuildOutput, String>:
    let module_dir = PathBuf__from(&(*manifest).module_dir)
    let cargo_manifest_path = resolve_cargo_manifest_path(&module_dir)?
    let binary_name = resolve_cargo_binary_name(&cargo_manifest_path, manifest)?
    let mut command = Command__new_("cargo")
    command.arg("build").arg("--manifest-path").arg(&cargo_manifest_path).arg("--bin").arg(&binary_name)
    ()
    if mode == "release":
        command.arg("--release")
        ()
        ()
        ()
        ()
    let cargo_target_directory = module_dir.join("target")
    command.arg("--target-dir").arg(&cargo_target_directory)
    ()
    if !target.trim().is_empty() and target != "cargo-host":
        command.arg("--target").arg(target)
        ()
        ()
        ()
        ()
    command.current_dir(&module_dir)
    ()
    let output = command.output().map_err(|error| format!("failed to run cargo build: {error}"))?
    let stdout = String__from_utf8_lossy(&output.stdout).to_string()
    let stderr = String__from_utf8_lossy(&output.stderr).to_string()
    if !output.status.success():
        return Result::Err(format!("cargo build exited with status {}: {}", output.status, if stderr.is_empty():
            stdout.as_str()
        else:
            stderr.as_str()))
    let built_artifact = resolve_cargo_built_artifact_path(&cargo_target_directory, target, mode, &binary_name)
    match artifact_path.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| format!("failed to create runtime artifact directory {}: {error}", parent.display()))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    std__fs__copy(&built_artifact, artifact_path).map_err(|error| format!("failed to stage cargo artifact {} -> {}: {error}", built_artifact.display(), artifact_path.display()))?
    ()
    Result::Ok(RuntimeCompilerBuildOutput { stdout: stdout, stderr: stderr })

fn invoke_cargo_wasm_bindgen_build(manifest: &RuntimeManifest, artifact_path: &std::path::Path, target: String, mode: String, _: &RuntimeToolchainContext) -> Result<RuntimeCompilerBuildOutput, String>:
    let module_dir = PathBuf__from(&(*manifest).module_dir)
    let cargo_manifest_path = resolve_cargo_manifest_path(&module_dir)?
    let crate_stem = resolve_cargo_library_stem(&cargo_manifest_path, manifest)?
    let cargo_target_directory = module_dir.join("target")
    let cargo_target = resolve_cargo_wasm_bindgen_cargo_target(target)?
    let bindgen_target = resolve_cargo_wasm_bindgen_bindgen_target(target)?
    let mut cargo_command = Command__new_("cargo")
    cargo_command.arg("build").arg("--manifest-path").arg(&cargo_manifest_path).arg("--lib").arg("--target").arg(&cargo_target).arg("--target-dir").arg(&cargo_target_directory)
    ()
    if mode == "release":
        cargo_command.arg("--release")
        ()
        ()
        ()
        ()
    cargo_command.current_dir(&module_dir)
    ()
    let cargo_output = cargo_command.output().map_err(|error| format!("failed to run cargo wasm build: {error}"))?
    let cargo_stdout = String__from_utf8_lossy(&cargo_output.stdout).to_string()
    let cargo_stderr = String__from_utf8_lossy(&cargo_output.stderr).to_string()
    if !cargo_output.status.success():
        return Result::Err(format!("cargo wasm build exited with status {}: {}", cargo_output.status, if cargo_stderr.is_empty():
            cargo_stdout.as_str()
        else:
            cargo_stderr.as_str()))
    let built_wasm_path = resolve_cargo_built_wasm_path(&cargo_target_directory, &cargo_target, mode, &crate_stem)
    let output_directory = artifact_path.parent().ok_or_else(|| format!("runtime artifact {} has no parent directory", artifact_path.display()))?
    std__fs__create_dir_all(output_directory).map_err(|error| format!("failed to create wasm-bindgen output directory {}: {error}", output_directory.display()))?
    ()
    let out_name = artifact_path.file_stem().and_then(|value| value.to_str()).ok_or_else(|| format!("runtime artifact {} has no valid JS file stem", artifact_path.display()))?
    let mut bindgen_command = Command__new_("wasm-bindgen")
    bindgen_command.arg("--target").arg(bindgen_target).arg("--out-dir").arg(output_directory).arg("--out-name").arg(out_name).arg(&built_wasm_path).current_dir(&module_dir)
    ()
    let bindgen_output = bindgen_command.output().map_err(|error| format!("failed to run wasm-bindgen: {error}"))?
    let bindgen_stdout = String__from_utf8_lossy(&bindgen_output.stdout).to_string()
    let bindgen_stderr = String__from_utf8_lossy(&bindgen_output.stderr).to_string()
    if !bindgen_output.status.success():
        return Result::Err(format!("wasm-bindgen exited with status {}: {}", bindgen_output.status, if bindgen_stderr.is_empty():
            bindgen_stdout.as_str()
        else:
            bindgen_stderr.as_str()))
    if !artifact_path.exists():
        return Result::Err(format!("wasm-bindgen did not produce expected entry module {}", artifact_path.display()))
    Result::Ok(RuntimeCompilerBuildOutput { stdout: format!("{cargo_stdout}{bindgen_stdout}"), stderr: format!("{cargo_stderr}{bindgen_stderr}") })

fn invoke_unsupported_c_build(_: &RuntimeManifest, _: &std::path::Path, _: String, _: String, _: &RuntimeToolchainContext) -> Result<RuntimeCompilerBuildOutput, String>:
    Result::Err("The `c-native` runtime compiler is not implemented yet. Use `cargo-native`, `go-native`, or a wasm compiler for now.".to_string())

fn resolve_cargo_manifest_path(module_dir: &std::path::Path) -> Result<std::path::PathBuf, String>:
    let direct = module_dir.join("Cargo.toml")
    if direct.exists():
        return Result::Ok(direct)
    Result::Err(format!("Cargo runtime module {} does not contain Cargo.toml.", module_dir.display()))

fn resolve_cargo_binary_name(cargo_manifest_path: &std::path::Path, manifest: &RuntimeManifest) -> Result<String, String>:
    let parsed = read_cargo_manifest_document(cargo_manifest_path)?
    match parsed.get("bin").and_then(|value| value.as_array()):
        Some(bins) =>
            match bins.iter().find_map(
                |entry| entry.as_table().and_then(
                    |table| block:
                        let name = (table.get("name")?).as_str()?
                        if name == (*manifest).id:
                            Option::Some(name.to_string())
                        else:
                            none
                )
            ):
                Some(configured_bin) =>
                    return Result::Ok(configured_bin)
                _ =>
                    ()
                    ()
            match bins.iter().find_map(|entry| entry.as_table().and_then(|table| table.get("name")).and_then(|value| value.as_str()).map(|value| value.to_string())):
                Some(first_bin) =>
                    return Result::Ok(first_bin)
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match parsed.get("package").and_then(|value| value.as_table()).and_then(|table| table.get("name")).and_then(|value| value.as_str()):
        Some(package_name) =>
            return Result::Ok(package_name.to_string())
        _ =>
            ()
            ()
    Result::Ok((*manifest).id.clone())

fn resolve_cargo_library_stem(cargo_manifest_path: &std::path::Path, manifest: &RuntimeManifest) -> Result<String, String>:
    let parsed = read_cargo_manifest_document(cargo_manifest_path)?
    match parsed.get("lib").and_then(|value| value.as_table()).and_then(|table| table.get("name")).and_then(|value| value.as_str()):
        Some(lib_name) =>
            return Result::Ok(lib_name.replace("-", "_"))
        _ =>
            ()
            ()
    match parsed.get("package").and_then(|value| value.as_table()).and_then(|table| table.get("name")).and_then(|value| value.as_str()):
        Some(package_name) =>
            return Result::Ok(package_name.replace("-", "_"))
        _ =>
            ()
            ()
    Result::Ok((*manifest).id.replace("-", "_"))

fn read_cargo_manifest_document(cargo_manifest_path: &std::path::Path) -> Result<toml::Value, String>:
    let text = std__fs__read_to_string(cargo_manifest_path).map_err(|error| format!("Failed to read cargo manifest {}: {error}", cargo_manifest_path.display()))?
    toml__from_str(&text).map_err(|error| format!("Failed to parse {}: {error}", cargo_manifest_path.display()))

fn resolve_cargo_built_artifact_path(cargo_target_directory: &std::path::Path, target: String, mode: String, binary_name: String) -> std::path::PathBuf:
    let profile_directory = if mode == "release":
        "release"
    else:
        "debug"
    let mut path = cargo_target_directory.to_path_buf()
    if !target.trim().is_empty() and target != "cargo-host":
        path.push(target)
        ()
        ()
        ()
        ()
    path.push(profile_directory)
    ()
    if cfg!(target_os = "windows"):
        path.push(format!("{binary_name}.exe"))
        ()
        ()
        ()
        ()
    else:
        path.push(binary_name)
        ()
        ()
        ()
        ()
    path

fn resolve_cargo_built_wasm_path(cargo_target_directory: &std::path::Path, cargo_target: String, mode: String, crate_stem: String) -> std::path::PathBuf:
    let profile_directory = if mode == "release":
        "release"
    else:
        "debug"
    cargo_target_directory.join(cargo_target).join(profile_directory).join(format!("{crate_stem}.wasm"))

fn resolve_cargo_wasm_bindgen_cargo_target(target: String) -> Result<String, String>:
    match target.trim():
        "" | "wasm-bindgen-web" => Result::Ok("wasm32-unknown-unknown".to_string())
        "wasm32-unknown-unknown" => Result::Ok("wasm32-unknown-unknown".to_string())
        other => Result::Err(format!("unsupported cargo-wasm-bindgen target {other}; use wasm-bindgen-web or wasm32-unknown-unknown"))

fn resolve_cargo_wasm_bindgen_bindgen_target(target: String) -> Result<String, String>:
    match target.trim():
        "" | "wasm-bindgen-web" | "wasm32-unknown-unknown" => Result::Ok("web")
        other => Result::Err(format!("unsupported wasm-bindgen output target {other}; use wasm-bindgen-web"))

fn resolve_go_build_script_path() -> Option<std::path::PathBuf>:
    for candidate in candidate_go_build_script_paths():
        if candidate.exists():
            return Option::Some(candidate)
    ()
    none

fn candidate_go_build_script_paths() -> Array<std::path::PathBuf>:
    let mut candidates = Vec__new_()
    match std__env__var_("GREEBLEFS_GO_BUILD_SCRIPT"):
        Ok(override_path) =>
            if !override_path.is_empty():
                candidates.push(PathBuf__from(override_path))
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    match app_local_data_dir_for_resolution():
        Some(app_local) =>
            candidates.push(app_local.join("scripts/go/build.sh"))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match std__env__var_("CARGO_MANIFEST_DIR"):
        Ok(manifest_dir) =>
            candidates.push(PathBuf__from(manifest_dir).join("../scripts/go/build.sh"))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    candidates

fn app_local_data_dir_for_resolution() -> Option<std::path::PathBuf>:
    match std__env__var_("GREEBLEFS_APP_LOCAL_DATA_DIR"):
        Ok(env_root) =>
            if !env_root.is_empty():
                return Option::Some(PathBuf__from(env_root))
            ()
        _ =>
            ()
            ()
    let base = std__env__var_os("XDG_DATA_HOME").map(PathBuf__from).or_else(|| std__env__var_os("HOME").map(|home| PathBuf__from(home).join(".local/share")))?
    return Option::Some(base.join("co.greeblefs.app"))
    let home = std__env__var_os("HOME").map(PathBuf__from)?
    return Option::Some(home.join("Library/Application Support/co.greeblefs.app"))
    let appdata = std__env__var_os("LOCALAPPDATA").or_else(|| std__env__var_os("APPDATA")).map(PathBuf__from)?
    return Option::Some(appdata.join("co.greeblefs.app"))
    none

