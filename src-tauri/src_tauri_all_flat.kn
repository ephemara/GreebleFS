fn extract_bitmap_to_png(hbitmap: windows::Win32::Graphics::Gdi::HBITMAP) -> Option<String>:
    let mut bitmap_info: windows::Win32::Graphics::Gdi::BITMAP = std__mem__zeroed()
    let bitmap_size = std__mem__size_of() as i32
    if windows::Win32::Graphics::Gdi::GetObjectW(hbitmap, bitmap_size, Option::Some(&mut bitmap_info as PtrMut<_> as PtrMut<_>)) == 0:
        let _ = windows::Win32::Graphics::Gdi::DeleteObject(hbitmap)
        return none
    let width = bitmap_info.bmWidth
    let height = bitmap_info.bmHeight.abs()
    let hdc = windows::Win32::Graphics::Gdi::CreateCompatibleDC(none)
    if hdc.is_invalid():
        let _ = windows::Win32::Graphics::Gdi::DeleteObject(hbitmap)
        return none
    let old_bitmap = windows::Win32::Graphics::Gdi::SelectObject(hdc, hbitmap)
    let mut bmi: windows::Win32::Graphics::Gdi::BITMAPINFO = std__mem__zeroed()
    bmi.bmiHeader.biSize = std__mem__size_of() as u32
    ()
    bmi.bmiHeader.biWidth = width
    ()
    bmi.bmiHeader.biHeight = -height
    ()
    bmi.bmiHeader.biPlanes = 1
    ()
    bmi.bmiHeader.biBitCount = 32
    ()
    bmi.bmiHeader.biCompression = windows::Win32::Graphics::Gdi::BI_RGB.field_0
    ()
    let mut pixels: Array<u8> = vec!()
    let scan_result = windows::Win32::Graphics::Gdi::GetDIBits(hdc, hbitmap, 0, height as u32, Option::Some(pixels.as_mut_ptr() as PtrMut<_>), &mut bmi, windows::Win32::Graphics::Gdi::DIB_RGB_COLORS)
    windows::Win32::Graphics::Gdi::SelectObject(hdc, old_bitmap)
    ()
    let _ = windows::Win32::Graphics::Gdi::DeleteDC(hdc)
    let _ = windows::Win32::Graphics::Gdi::DeleteObject(hbitmap)
    if scan_result == 0:
        return none
    for pixel_chunk in pixels.chunks_exact_mut(4):
        pixel_chunk.swap(0, 2)
        ()
    ()
    let mut png_bytes: Array<u8> = Vec__new_()
    let png_encoder = PngEncoder__new_(&mut png_bytes)
    if png_encoder.write_image(&pixels, width as u32, height as u32, image::ExtendedColorType::Rgba8).is_err():
        return none
    let base64_png = base64__engine__general_purpose__STANDARD.encode(png_bytes)
    Option::Some(format!("data:image/png;base64,{base64_png}"))

fn get_uwp_app_icon(app_user_model_id: String) -> Option<String>:
    match get_uwp_app_icon_from_shell(app_user_model_id):
        Some(icon) =>
            return Option::Some(icon)
        _ =>
            ()
            ()
    let assets_patterns = ["Square44x44Logo.scale-100.png", "Square44x44Logo.png", "AppList.scale-100.png", "AppList.png", "Logo.scale-100.png", "Logo.png", "StoreLogo.scale-100.png", "StoreLogo.png"]
