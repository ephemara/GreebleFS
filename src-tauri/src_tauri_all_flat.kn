struct RuntimeTaskProcessManager:
    tasks: Map<String, std::process::Child>

impl Default for RuntimeTaskProcessManager:
    fn default_() -> RuntimeTaskProcessManager:
        RuntimeTaskProcessManager { tasks: HashMap__new_() }


impl RuntimeTaskProcessManager:
    fn tasks_guard(_self: &RuntimeTaskProcessManager) -> std::sync::MutexGuard<_, Map<String, std::process::Child>>:
        (*_self).tasks.lock().unwrap_or_else(|poisoned| poisoned.into_inner())

    fn insert(_self: &RuntimeTaskProcessManager, task_id: String, child: std::process::Child):
        (*_self).tasks_guard().insert(task_id, child)
        ()

    fn remove(_self: &RuntimeTaskProcessManager, task_id: String):
        (*_self).tasks_guard().remove(task_id)
        ()

    fn stop(_self: &RuntimeTaskProcessManager, task_id: String) -> Result<Bool, String>:
        let Some(child) = (*_self).tasks_guard().get(task_id).cloned()
        let mut guard = child.lock().map_err(|_| "task child lock poisoned".to_string())?
        guard.kill().map_err(|error| format!("Failed to kill task {task_id}: {error}"))?
        ()
        Result::Ok(true)


