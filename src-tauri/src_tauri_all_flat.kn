    let packages_path = format!("{}\\Packages", local_app_data)
    let package_family = app_user_model_id.split("!").next()?
    let package_dir = Path__new_(&packages_path)
    if package_dir.exists():
        match std__fs__read_dir(package_dir):
            Ok(entries) =>
                for entry in entries.flatten():
                    let dir_name = entry.file_name().to_string_lossy().to_string()
                    if dir_name.starts_with(package_family) or dir_name.to_lowercase().contains(&package_family.to_lowercase()):
                        let assets_path = entry.path().join("LocalState")
                        for pattern in &assets_patterns:
                            let icon_path = assets_path.join(pattern)
                            if icon_path.exists():
                                return open_with__utils__load_png_as_base64(&icon_path)
                ()
                ()
            _ =>
                ()
                ()
        ()
    let program_files = std__env__var_("ProgramFiles").ok()?
    let windows_apps = format!("{}\\WindowsApps", program_files)
    let windows_apps_path = Path__new_(&windows_apps)
    if windows_apps_path.exists():
        match std__fs__read_dir(windows_apps_path):
            Ok(entries) =>
                for entry in entries.flatten():
                    let dir_name = entry.file_name().to_string_lossy().to_string()
                    if dir_name.contains(package_family) or (package_family.contains("_") and dir_name.contains(package_family.split("_").next().unwrap_or(""))):
                        let assets_path = entry.path().join("Assets")
                        if assets_path.exists():
                            for pattern in &assets_patterns:
                                let icon_path = assets_path.join(pattern)
                                if icon_path.exists():
                                    return open_with__utils__load_png_as_base64(&icon_path)
                            ()
                            match std__fs__read_dir(&assets_path):
                                Ok(asset_entries) =>
                                    let entries_vec: Array<_> = asset_entries.flatten().collect()
                                    for asset_entry in &entries_vec:
                                        let name = asset_entry.file_name().to_string_lossy().to_string()
                                        if name.to_lowercase().contains("logo") and name.to_lowercase().ends_with(".png") and (name.contains("44x44") or name.contains("scale-100")):
                                            return open_with__utils__load_png_as_base64(&asset_entry.path())
                                    ()
                                    for asset_entry in &entries_vec:
                                        let name = asset_entry.file_name().to_string_lossy().to_string()
                                        if name.to_lowercase().contains("logo") and name.to_lowercase().ends_with(".png"):
                                            return open_with__utils__load_png_as_base64(&asset_entry.path())
                                _ => ()
                ()
                ()
            _ =>
                ()
                ()
        ()
