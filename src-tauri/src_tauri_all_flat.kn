    id: String
    label: String
    command: String
    args: Array<String>
    source: String
    preferred: Bool

struct PythonInterpreterDescriptor:
    id: String
    label: String
    command: String
    args: Array<String>
    source: String
    preferred: Bool
    recommended: Bool
    executable: String
    version: String
    major: u8
    minor: u8
    micro: u8

struct DetectedInterpreter:
    descriptor: PythonInterpreterDescriptor

struct RuntimePaths:
    root_dir: std::path::PathBuf
    env_dir: std::path::PathBuf
    scripts_dir: std::path::PathBuf
    package_dir: std::path::PathBuf
    temp_dir: std::path::PathBuf
    logs_dir: std::path::PathBuf
    requirements_path: std::path::PathBuf
    readme_path: std::path::PathBuf
    hello_script_path: std::path::PathBuf
    probe_script_path: std::path::PathBuf

