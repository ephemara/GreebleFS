fn pdf_close_preview_document(manager: tauri::State<_, PdfPreviewManager>, session_id: String) -> Result<(), String>:
    manager.close_preview_document(session_id)

impl PdfPreviewManager:
    fn open_preview_document(_self: &PdfPreviewManager, input_path: String) -> Result<PdfPreviewDocument, String>:
        let source_path = normalize_pdf_source_path(&input_path)?
        let session_id = format!("pdf-preview-{}", (*_self).inner.next_session_id.fetch_add(1, std::sync::atomic::Ordering::Relaxed) + 1)
        let document = build_pdf_preview_document(&source_path, session_id.clone())?
        let session = PdfPreviewSession { source_path: source_path, document: document.clone(), render_cache: HashMap__new_() }
        ((*_self).inner.sessions.lock().map_err(|_| "PDF preview session map was poisoned.".to_string())?).insert(session_id, session)
        ()
        Result::Ok(document)

    fn render_preview_page(_self: &PdfPreviewManager, request: PdfPageRenderRequest) -> Result<PdfPageRenderResult, String>:
        validate_pdf_render_request(&request)?
        ()
        let (source_path, page_count) = block:
            let sessions = (*_self).inner.sessions.lock().map_err(|_| "PDF preview session map was poisoned.".to_string())?
            let session = sessions.get(&request.session_id).ok_or_else(|| format!("PDF preview session was not found: {}", request.session_id))?
            (session.source_path.clone(), session.document.page_count)
        if request.page_index >= page_count:
            return Result::Err(format!("PDF preview page index {} is outside document page count {}.", request.page_index, page_count))
        let cache_key = build_pdf_render_cache_key(&request)
        match (*_self).get_cached_render(&request.session_id, &cache_key)?:
            Some(cached) =>
                return Result::Ok(cached)
            _ =>
                ()
                ()
        let render_result = render_pdf_preview_page(&source_path, request.clone(), cache_key.clone())?
        (*_self).store_cached_render(&request.session_id, cache_key, render_result.clone())?
        ()
        Result::Ok(render_result)

    fn save_preview_edits(_self: &PdfPreviewManager, request: PdfSaveEditsRequest) -> Result<PdfSaveEditsResult, String>:
        let (source_path, session_id) = block:
            let sessions = (*_self).inner.sessions.lock().map_err(|_| "PDF preview session map was poisoned.".to_string())?
            let session = sessions.get(&request.session_id).ok_or_else(|| format!("PDF preview session was not found: {}", request.session_id))?
            (session.source_path.clone(), session.document.session_id.clone())
        save_pdf_preview_edits_to_file(&source_path, &request)?
        ()
        let refreshed_document = build_pdf_preview_document(&source_path, session_id.clone())?
        let saved_at_epoch_ms = current_epoch_millis()
        let mut sessions = (*_self).inner.sessions.lock().map_err(|_| "PDF preview session map was poisoned.".to_string())?
        let session = sessions.get_mut(&request.session_id).ok_or_else(|| format!("PDF preview session was not found: {}", request.session_id))?
        session.document = refreshed_document.clone()
        ()
        session.render_cache.clear()
        ()
        Result::Ok(PdfSaveEditsResult { session_id: session_id, saved_at_epoch_ms: saved_at_epoch_ms, document: refreshed_document })

    fn close_preview_document(_self: &PdfPreviewManager, session_id: String) -> Result<(), String>:
        ((*_self).inner.sessions.lock().map_err(|_| "PDF preview session map was poisoned.".to_string())?).remove(session_id.as_str())
        ()
        Result::Ok(())

    fn get_cached_render(_self: &PdfPreviewManager, session_id: String, cache_key: String) -> Result<Option<PdfPageRenderResult>, String>:
        Result::Ok(((*_self).inner.sessions.lock().map_err(|_| "PDF preview session map was poisoned.".to_string())?).get(session_id).and_then(|session| session.render_cache.get(cache_key).cloned()))

    fn store_cached_render(_self: &PdfPreviewManager, session_id: String, cache_key: String, render_result: PdfPageRenderResult) -> Result<(), String>:
        let mut sessions = (*_self).inner.sessions.lock().map_err(|_| "PDF preview session map was poisoned.".to_string())?
        match sessions.get_mut(session_id):
            Some(session) =>
                session.render_cache.insert(cache_key, render_result)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        Result::Ok(())


fn build_pdf_preview_document(source_path: &std::path::Path, session_id: String) -> Result<PdfPreviewDocument, String>:
    let pdfium = pdfium_auto__bind_pdfium_silent().map_err(|error| format!("Failed to initialize PDFium runtime: {error}"))?
    let pdfium_document = pdfium.load_pdf_from_file(source_path, none).map_err(|error| map_pdfium_open_error(source_path, error))?
    let mut pages = Vec__new_()
    for page_index in 0..pdfium_document.pages().len():
        let page = pdfium_document.pages().get(page_index).map_err(|error| format!("Failed to inspect PDF page {}: {error}", page_index + 1))?
        pages.push(PdfPreviewPageDescriptor { page_index: page_index as u32, width_points: page.width().value, height_points: page.height().value })
        ()
    ()
    let lopdf_document = Document__load(source_path).map_err(|error| format!("Failed to load PDF document '{}': {error}", source_path.display()))?
    ensure_pdf_edit_supported(&lopdf_document, source_path)?
    ()
    let page_context = build_pdf_page_context(&lopdf_document, &pages)?
    let form_fields = extract_pdf_form_fields(&lopdf_document, &page_context)?
    Result::Ok(PdfPreviewDocument { session_id: session_id, path: source_path.to_string_lossy().into_owned(), name: source_path.file_name().and_then(|value| value.to_str()).unwrap_or("PDF").to_string(), page_count: pages.len() as u32, pages: pages, form_fields: form_fields })

fn save_pdf_preview_edits_to_file(source_path: &std::path::Path, request: &PdfSaveEditsRequest) -> Result<(), String>:
    let mut document = Document__load(source_path).map_err(|error| format!("Failed to load PDF document '{}': {error}", source_path.display()))?
    ensure_pdf_edit_supported(&document, source_path)?
    ()
    let page_descriptors = collect_lopdf_page_descriptors(&source_path.to_string_lossy(), &document)?
    let page_context = build_pdf_page_context(&document, &page_descriptors)?
    set_need_appearances(&mut document)?
    ()
    apply_pdf_form_updates(&mut document, &(*request).form_updates)?
    ()
    replace_pdf_overlay_annotations(&mut document, &page_context, &(*request).page_overlays)?
    ()
    document.save(source_path).map_err(|error| format!("Failed to save PDF document '{}': {error}", source_path.display()))?
    ()
    Result::Ok(())

fn render_pdf_preview_page(source_path: &std::path::Path, request: PdfPageRenderRequest, cache_key: String) -> Result<PdfPageRenderResult, String>:
    let pdfium = pdfium_auto__bind_pdfium_silent().map_err(|error| format!("Failed to initialize PDFium runtime: {error}"))?
    let pdfium_document = pdfium.load_pdf_from_file(source_path, none).map_err(|error| map_pdfium_open_error(source_path, error))?
    let page_index = u16__try_from(request.page_index).map_err(|_| format!("PDF preview page index {} exceeds PDFium page index limits.", request.page_index))?
    let page = pdfium_document.pages().get(page_index).map_err(|error| format!("Failed to load PDF page {}: {error}", request.page_index + 1))?
    let render_config = build_pdf_render_config(&request)
    let rendered_page = page.render_with_config(&render_config).map_err(|error| format!("Failed to render PDF page {}: {error}", request.page_index + 1))?
    let rendered_image = rendered_page.as_image()
    let image_data_url = png_data_url_from_dynamic_image(&rendered_image)?
    Result::Ok(PdfPageRenderResult { session_id: request.session_id, page_index: request.page_index, image_data_url: image_data_url, rendered_width_px: rendered_image.width(), rendered_height_px: rendered_image.height(), applied_zoom_scale: request.zoom_scale, fit_mode: request.fit_mode, cache_key: cache_key })

fn validate_pdf_render_request(request: &PdfPageRenderRequest) -> Result<(), String>:
    if (*request).session_id.trim().is_empty():
        return Result::Err("PDF preview render request session id cannot be empty.".to_string())
    if !(*request).zoom_scale.is_finite() or (*request).zoom_scale <= 0.0:
        return Result::Err(format!("PDF preview render request zoom scale must be greater than zero. Received {}.", (*request).zoom_scale))
    if (*request).viewport_width_px == 0 or (*request).viewport_height_px == 0:
        return Result::Err("PDF preview render viewport must be greater than zero.".to_string())
    Result::Ok(())

fn build_pdf_render_cache_key(request: &PdfPageRenderRequest) -> String:
    format!("{}:{}:{}:{}:{}", (*request).page_index, (*request).fit_mode as u8, (*request).viewport_width_px, (*request).viewport_height_px, ((*request).zoom_scale * 1000.0).round() as i32)

fn build_pdf_render_config(request: &PdfPageRenderRequest) -> pdfium_render::prelude::PdfRenderConfig:
    let base = PdfRenderConfig__new_().render_form_data(true).render_annotations(true)
    match (*request).fit_mode:
        PdfPageRenderFitMode::FitWidth => base.set_target_width((*request).viewport_width_px as i32)
        PdfPageRenderFitMode::FitPage => base.scale_page_to_display_size((*request).viewport_width_px as i32, (*request).viewport_height_px as i32)
        PdfPageRenderFitMode::None => base.scale_page_by_factor((*request).zoom_scale)

fn normalize_pdf_source_path(input_path: String) -> Result<std::path::PathBuf, String>:
    let trimmed = input_path.trim()
    if trimmed.is_empty():
        return Result::Err("PDF preview input path cannot be empty.".to_string())
    let path = PathBuf__from(trimmed)
    if !path.exists():
        return Result::Err(format!("PDF preview input does not exist: {}", path.display()))
    if !path.is_file():
        return Result::Err(format!("PDF preview input is not a file: {}", path.display()))
    Result::Ok(path)

fn map_pdfium_open_error(path: &std::path::Path, error: pdfium_render::prelude::PdfiumError) -> String:
    match error:
        pdfium_render::prelude::PdfiumError::PdfiumLibraryInternalError(pdfium_render::prelude::PdfiumInternalError::PasswordError) => format!("PDF preview does not support password-locked files right now: {}", path.display())
        other => format!("Failed to open PDF document '{}': {other}", path.display())

fn png_data_url_from_dynamic_image(image: &image::DynamicImage) -> Result<String, String>:
    let mut bytes = Vec__new_()
    image.write_to(&mut Cursor__new_(&mut bytes), image::ImageFormat::Png).map_err(|error| format!("Failed to encode rendered PDF page to PNG: {error}"))?
    ()
    Result::Ok(format!("data:image/png;base64,{}", base64__engine__general_purpose__STANDARD.encode(bytes)))

fn current_epoch_millis() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_millis() as u64).unwrap_or_default()

fn ensure_pdf_edit_supported(document: &lopdf::Document, source_path: &std::path::Path) -> Result<(), String>:
    if document.is_encrypted():
        return Result::Err(format!("PDF preview edit mode does not support encrypted or password-locked files right now: {}", source_path.display()))
    if pdf_document_has_xfa(document)?:
        return Result::Err(format!("PDF preview edit mode does not support XFA forms right now: {}", source_path.display()))
    Result::Ok(())

fn collect_lopdf_page_descriptors(source_path_label: String, document: &lopdf::Document) -> Result<Array<PdfPreviewPageDescriptor>, String>:
    let mut page_descriptors = Vec__new_()
    for (page_index, (_, page_object_id)) in document.get_pages().into_iter().enumerate():
        let page_dictionary = document.get_dictionary(page_object_id).map_err(|error| format!("Failed to inspect PDF page {}: {error}", page_index + 1))?
        let media_box = page_dictionary.get([77, 101, 100, 105, 97, 66, 111, 120]).map_err(|error| format!("PDF page {} is missing MediaBox: {error}", page_index + 1))?
        let rect = parse_pdf_rect_array(document, media_box).map_err(|error| format!("Failed to parse PDF page MediaBox for '{}', page {}: {error}", source_path_label, page_index + 1))?
        page_descriptors.push(PdfPreviewPageDescriptor { page_index: page_index as u32, width_points: rect.width, height_points: rect.height })
        ()
    ()
    Result::Ok(page_descriptors)

fn build_pdf_page_context(document: &lopdf::Document, page_descriptors: &Slice<PdfPreviewPageDescriptor>) -> Result<PdfPageContext, String>:
    let mut page_object_ids = Vec__new_()
    let mut page_index_by_object_id = HashMap__new_()
    let mut page_height_by_index = HashMap__new_()
    let mut page_index_by_annotation_id = HashMap__new_()
    for (page_index, (_, page_object_id)) in document.get_pages().into_iter().enumerate():
        let page_index_u32 = page_index as u32
        page_object_ids.push(page_object_id)
        ()
        page_index_by_object_id.insert(page_object_id, page_index_u32)
        ()
        match page_descriptors.get(page_index):
            Some(page_descriptor) =>
                page_height_by_index.insert(page_index_u32, page_descriptor.height_points)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let page_dictionary = document.get_dictionary(page_object_id).map_err(|error| format!("Failed to inspect PDF page {}: {error}", page_index + 1))?
        match page_dictionary.get([65, 110, 110, 111, 116, 115]).and_then(Object__as_array):
            Ok(annotation_list) =>
                for annotation_object in annotation_list:
                    match annotation_object.as_reference():
                        Ok(annotation_id) =>
                            page_index_by_annotation_id.insert(annotation_id, page_index_u32)
                            ()
                        _ => ()
            _ => ()
    ()
    Result::Ok(PdfPageContext { page_object_ids: page_object_ids, page_index_by_object_id: page_index_by_object_id, page_height_by_index: page_height_by_index, page_index_by_annotation_id: page_index_by_annotation_id })

fn extract_pdf_form_fields(document: &lopdf::Document, page_context: &PdfPageContext) -> Result<Array<PdfFormFieldDescriptor>, String>:
    let Some(acro_form_dictionary) = get_pdf_acro_form_dictionary(document)?
    let Some(field_objects) = acro_form_dictionary.get([70, 105, 101, 108, 100, 115]).ok().and_then(|object| resolve_object_array(document, object).ok())
    let mut descriptors = Vec__new_()
    for field_object in field_objects:
        let field_id = field_object.as_reference().map_err(|error| format!("PDF form field reference was invalid: {error}"))?
        collect_pdf_form_field_descriptors(document, page_context, field_id, &PdfFieldContext__default_(), &mut descriptors)?
        ()
    ()
    descriptors.sort_by(|left, right| left.page_index.cmp(&right.page_index).then_with(|| left.field_name.cmp(&right.field_name)).then_with(|| left.field_id.cmp(&right.field_id)))
    ()
    Result::Ok(descriptors)

fn collect_pdf_form_field_descriptors(document: &lopdf::Document, page_context: &PdfPageContext, field_object_id: lopdf::ObjectId, inherited_context: &PdfFieldContext, descriptors: &mut Array<PdfFormFieldDescriptor>) -> Result<(), String>:
    let field_dictionary = document.get_dictionary(field_object_id).map_err(|error| format!("Failed to inspect PDF form field {:?}: {error}", field_object_id))?
    let field_type = field_dictionary.get([70, 84]).ok().and_then(object_name_string).or_else(|| (*inherited_context).field_type.clone())
    let flags = field_dictionary.get([70, 102]).ok().and_then(|object| object.as_i64().ok()).map(|value| value.max(0) as u32).unwrap_or((*inherited_context).flags)
    let field_name = combine_pdf_field_name((*inherited_context).field_name.clone(), field_dictionary.get([84]).ok().and_then(object_text_string))
    let field_value = field_dictionary.get([86]).ok().and_then(object_text_or_name_string).or_else(|| (*inherited_context).value.clone())
    let field_context = PdfFieldContext { field_type: field_type.clone(), flags: flags, field_name: field_name.clone(), value: field_value.clone() }
    let is_widget = field_dictionary.get([83, 117, 98, 116, 121, 112, 101]).ok().and_then(object_name_string) == Option::Some("Widget")
    if is_widget:
        match build_pdf_form_field_descriptor(document, page_context, field_object_id, field_dictionary, &field_context)?:
            Some(descriptor) =>
                descriptors.push(descriptor)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    match field_dictionary.get([75, 105, 100, 115]).and_then(Object__as_array):
        Ok(kid_objects) =>
            for kid_object in kid_objects:
                let kid_id = kid_object.as_reference().map_err(|error| format!("PDF form kid reference was invalid: {error}"))?
                let kid_dictionary = document.get_dictionary(kid_id).map_err(|error| format!("Failed to inspect PDF form kid {:?}: {error}", kid_id))?
                let kid_is_widget = kid_dictionary.get([83, 117, 98, 116, 121, 112, 101]).ok().and_then(object_name_string) == Option::Some("Widget")
                if kid_is_widget:
                    match build_pdf_form_field_descriptor(document, page_context, kid_id, kid_dictionary, &field_context)?:
                        Some(descriptor) =>
                            descriptors.push(descriptor)
                            ()
                        _ => ()
                else:
                    collect_pdf_form_field_descriptors(document, page_context, kid_id, &field_context, descriptors)?
                    ()
            ()
            ()
        _ =>
            if !is_widget:
                match build_pdf_form_field_descriptor(document, page_context, field_object_id, field_dictionary, &field_context)?:
                    Some(descriptor) =>
                        descriptors.push(descriptor)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
    Result::Ok(())

fn build_pdf_form_field_descriptor(document: &lopdf::Document, page_context: &PdfPageContext, widget_object_id: lopdf::ObjectId, widget_dictionary: &lopdf::Dictionary, field_context: &PdfFieldContext) -> Result<Option<PdfFormFieldDescriptor>, String>:
    let Some(field_type) = (*field_context).field_type
    let Some(page_index) = resolve_pdf_widget_page_index(document, page_context, widget_object_id, widget_dictionary)
    let page_height = (*page_context).page_height_by_index.get(&page_index).copied().ok_or_else(|| format!("Missing page height for PDF page index {}.", page_index))?
    let rect_object = widget_dictionary.get([82, 101, 99, 116]).map_err(|error| format!("PDF form field is missing Rect: {error}"))?
    let rect = parse_pdf_widget_rect(document, rect_object, page_height)?
    let field_name = (*field_context).field_name.clone().unwrap_or_else(|| format!("Field {}", object_id_to_string(widget_object_id)))
    let group_name = if field_name.contains("."):
        field_name.split(".").rev().skip(1).last().map(str__to_string)
    else:
        none
    let required = ((*field_context).flags & PDF_WIDGET_FLAG_REQUIRED) != 0
    let read_only = ((*field_context).flags & PDF_WIDGET_FLAG_READ_ONLY) != 0
    let descriptor = match field_type:
        "Tx" => PdfFormFieldDescriptor { field_id: object_id_to_string(widget_object_id), field_name: field_name, group_name: group_name, page_index: page_index, rect: rect, kind: if ((*field_context).flags & PDF_TEXT_FLAG_MULTILINE) != 0:
            PdfFormFieldKind::Multiline
        else:
            PdfFormFieldKind::Text, string_value: (*field_context).value.clone(), bool_value: none, selected_values: Vec__new_(), options: Vec__new_(), read_only: read_only, required: required, widget_export_value: none }
        "Btn" =>
            if ((*field_context).flags & PDF_BUTTON_FLAG_PUSHBUTTON) != 0:
                return Result::Ok(none)
            let widget_export_value = resolve_pdf_widget_export_value(widget_dictionary)
            let current_state = widget_dictionary.get([65, 83]).ok().and_then(object_name_string).or_else(|| (*field_context).value.clone())
            let bool_value = current_state.map(|value| value != "Off").or_(Option::Some(false))
            PdfFormFieldDescriptor { field_id: object_id_to_string(widget_object_id), field_name: field_name, group_name: group_name, page_index: page_index, rect: rect, kind: if ((*field_context).flags & PDF_BUTTON_FLAG_RADIO) != 0:
                PdfFormFieldKind::Radio
            else:
                PdfFormFieldKind::Checkbox, string_value: current_state, bool_value: bool_value, selected_values: Vec__new_(), options: Vec__new_(), read_only: read_only, required: required, widget_export_value: widget_export_value }
        "Ch" =>
            let options = (widget_dictionary.get([79, 112, 116]).ok().or_else(|| document.get_dictionary(widget_object_id).ok().and_then(|dict| dict.get([79, 112, 116]).ok())).map(|object| parse_pdf_choice_options(document, object)).transpose()?).unwrap_or_default()
            let selected_value = (*field_context).value.clone()
            PdfFormFieldDescriptor { field_id: object_id_to_string(widget_object_id), field_name: field_name, group_name: group_name, page_index: page_index, rect: rect, kind: if ((*field_context).flags & PDF_CHOICE_FLAG_COMBO) != 0:
                PdfFormFieldKind::Dropdown
            else:
                PdfFormFieldKind::Listbox, string_value: selected_value.clone(), bool_value: none, selected_values: selected_value.into_iter().collect(), options: options, read_only: read_only, required: required, widget_export_value: none }
        _ => return Result::Ok(none)
    Result::Ok(Option::Some(descriptor))

fn resolve_pdf_widget_page_index(document: &lopdf::Document, page_context: &PdfPageContext, widget_object_id: lopdf::ObjectId, widget_dictionary: &lopdf::Dictionary) -> Option<u32>:
    match widget_dictionary.get([80]).ok().and_then(|object| object.as_reference().ok()):
        Some(page_object_id) =>
            match (*page_context).page_index_by_object_id.get(&page_object_id).copied():
                Some(page_index) =>
                    return Option::Some(page_index)
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match (*page_context).page_index_by_annotation_id.get(&widget_object_id).copied():
        Some(page_index) =>
            return Option::Some(page_index)
        _ =>
            ()
            ()
    match widget_dictionary.get([80, 97, 114, 101, 110, 116]).ok().and_then(|object| object.as_reference().ok()):
        Some(parent_id) =>
            match (*page_context).page_index_by_annotation_id.get(&parent_id).copied():
                Some(page_index) =>
                    return Option::Some(page_index)
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    document.get_object_page(widget_object_id).ok().and_then(|page_object_id| (*page_context).page_index_by_object_id.get(&page_object_id).copied())

fn parse_pdf_widget_rect(document: &lopdf::Document, rect_object: &lopdf::Object, page_height: f32) -> Result<PdfPageRect, String>:
    let rect = parse_pdf_rect_array(document, rect_object)?
    Result::Ok(PdfPageRect { x: rect.x, y: page_height - (rect.y + rect.height), width: rect.width, height: rect.height })

fn parse_pdf_rect_array(document: &lopdf::Document, rect_object: &lopdf::Object) -> Result<PdfPageRect, String>:
    let coordinates = resolve_object_array(document, rect_object)?
    if coordinates.len() < 4:
        return Result::Err(format!("PDF rectangle expected 4 coordinates but found {}.", coordinates.len()))
    let left = coordinates[0].as_float().map_err(|error| format!("Failed to parse PDF rectangle left coordinate: {error}"))?
    let bottom = coordinates[1].as_float().map_err(|error| format!("Failed to parse PDF rectangle bottom coordinate: {error}"))?
    let right = coordinates[2].as_float().map_err(|error| format!("Failed to parse PDF rectangle right coordinate: {error}"))?
    let top = coordinates[3].as_float().map_err(|error| format!("Failed to parse PDF rectangle top coordinate: {error}"))?
    Result::Ok(PdfPageRect { x: left.min(right), y: bottom.min(top), width: (right - left).abs(), height: (top - bottom).abs() })

fn parse_pdf_choice_options(document: &lopdf::Document, option_object: &lopdf::Object) -> Result<Array<PdfFormFieldOptionDescriptor>, String>:
    let option_entries = resolve_object_array(document, option_object)?
    let mut options = Vec__new_()
    for option_entry in option_entries:
        match option_entry.as_array():
            Ok(option_pair) =>
                let value = option_pair.first().and_then(object_text_or_name_string).unwrap_or_default()
                let label = option_pair.get(1).and_then(object_text_or_name_string).unwrap_or_else(|| value.clone())
                options.push(PdfFormFieldOptionDescriptor { value: value, label: label })
                ()
                continue
            _ =>
                ()
                ()
        match object_text_or_name_string(option_entry):
            Some(value) =>
                options.push(PdfFormFieldOptionDescriptor { value: value.clone(), label: value })
                ()
            _ => ()
    ()
    Result::Ok(options)

fn pdf_document_has_xfa(document: &lopdf::Document) -> Result<Bool, String>:
    Result::Ok((get_pdf_acro_form_dictionary(document)?).and_then(|dictionary| lopdf__dictionary.get([88, 70, 65]).ok()).is_some())

fn get_pdf_acro_form_dictionary(document: &lopdf::Document) -> Result<Option<&lopdf::Dictionary>, String>:
    let root_object = (*document).trailer.get([82, 111, 111, 116]).map_err(|error| format!("PDF document is missing catalog root: {error}"))?
    let root_dictionary = resolve_object_dictionary(document, root_object)?
    let Some(acro_form_object) = root_dictionary.get([65, 99, 114, 111, 70, 111, 114, 109]).ok()
    let acro_form_dictionary = resolve_object_dictionary(document, acro_form_object)?
    Result::Ok(Option::Some(acro_form_dictionary))

fn resolve_object_dictionary(document: &lopdf::Document, object: &lopdf::Object) -> Result<&lopdf::Dictionary, String>:
    match object:
        lopdf::Object::Dictionary(dictionary) => Result::Ok(lopdf__dictionary)
        lopdf::Object::Reference(object_id) => document.get_dictionary(*object_id).map_err(|error| format!("Failed to resolve PDF dictionary reference {:?}: {error}", object_id))
        _ => Result::Err("Expected PDF dictionary object.".to_string())

fn resolve_object_array(document: &lopdf::Document, object: &lopdf::Object) -> Result<&Array<lopdf::Object>, String>:
    match object:
        lopdf::Object::Array(array) => Result::Ok(array)
        lopdf::Object::Reference(object_id) => (document.get_object(*object_id).map_err(|error| format!("Failed to resolve PDF array reference {:?}: {error}", object_id))?).as_array().map_err(|error| format!("Resolved PDF object was not an array: {error}"))
        _ => Result::Err("Expected PDF array object.".to_string())

fn object_name_string(object: &lopdf::Object) -> Option<String>:
    object.as_name_str().ok().map(str__to_string)

fn object_text_string(object: &lopdf::Object) -> Option<String>:
    object.as_string().ok().map(|value| value.into_owned())

fn object_text_or_name_string(object: &lopdf::Object) -> Option<String>:
    object_text_string(object).or_else(|| object_name_string(object))

fn combine_pdf_field_name(parent_name: Option<String>, partial_name: Option<String>) -> Option<String>:
    match (parent_name, partial_name):
        (Some(parent), Some(child)) if !parent.is_empty() and !child.is_empty() =>
            Option::Some(format!("{parent}.{child}"))
        (Some(parent), None) => Option::Some(parent)
        (None, Some(child)) => Option::Some(child)
        (Some(parent), Some(_)) => Option::Some(parent)
        (None, None) => none

fn object_id_to_string(object_id: lopdf::ObjectId) -> String:
    format!("{}:{}", object_id.field_0, object_id.field_1)

fn parse_object_id(value: String) -> Result<lopdf::ObjectId, String>:
    let mut segments = value.split(":")
    let object_number = (segments.next().ok_or_else(|| format!("PDF object id was empty: {value}"))?).parse().map_err(|error| format!("Failed to parse PDF object number from '{value}': {error}"))?
    let generation_number = (segments.next().ok_or_else(|| format!("PDF object generation was missing: {value}"))?).parse().map_err(|error| format!("Failed to parse PDF object generation from '{value}': {error}"))?
    if segments.next().is_some():
        return Result::Err(format!("PDF object id had too many segments: {value}"))
    Result::Ok((object_number, generation_number))

fn set_need_appearances(document: &mut lopdf::Document) -> Result<(), String>:
    let root_id = ((*document).trailer.get([82, 111, 111, 116]).map_err(|error| format!("PDF document is missing catalog root: {error}"))?).as_reference().map_err(|error| format!("PDF catalog root reference was invalid: {error}"))?
    let acro_form_id = block:
        let root_dictionary = document.get_dictionary(root_id).map_err(|error| format!("Failed to inspect PDF catalog: {error}"))?
        root_dictionary.get([65, 99, 114, 111, 70, 111, 114, 109]).ok().and_then(|object| object.as_reference().ok())
    match acro_form_id:
        Some(acro_form_id) =>
            let acro_form_dictionary = document.get_dictionary_mut(acro_form_id).map_err(|error| format!("Failed to inspect PDF AcroForm dictionary: {error}"))?
            acro_form_dictionary.set("NeedAppearances", true)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn apply_pdf_form_updates(document: &mut lopdf::Document, updates: &Slice<PdfFormValueUpdate>) -> Result<(), String>:
    for update in updates:
        let widget_object_id = parse_object_id(&update.field_id)?
        let owner_object_id = resolve_pdf_field_owner_id(document, widget_object_id)?
        let field_type = (resolve_pdf_field_type(document, owner_object_id)?).ok_or_else(|| format!("PDF field {:?} is missing field type.", owner_object_id))?
        let flags = resolve_pdf_field_flags(document, owner_object_id)?
        match field_type.as_str():
            "Tx" =>
                set_pdf_field_string_value(document, owner_object_id, update.string_value.clone().unwrap_or_default())?
                ()
            "Ch" =>
                let selected_value = update.selected_values.first().cloned().or_else(|| update.string_value.clone()).unwrap_or_default()
                set_pdf_field_string_value(document, owner_object_id, selected_value)?
                ()
            "Btn" =>
                if (flags & PDF_BUTTON_FLAG_PUSHBUTTON) != 0:
                    continue
                if (flags & PDF_BUTTON_FLAG_RADIO) != 0:
                    if update.bool_value.unwrap_or(true):
                        apply_pdf_radio_update(document, owner_object_id, widget_object_id)?
                        ()
                else:
                    apply_pdf_checkbox_update(document, owner_object_id, widget_object_id, update.bool_value.unwrap_or(false))?
                    ()
            _ =>
                ()
    ()
    Result::Ok(())

fn resolve_pdf_field_owner_id(document: &lopdf::Document, widget_object_id: lopdf::ObjectId) -> Result<lopdf::ObjectId, String>:
    let widget_dictionary = document.get_dictionary(widget_object_id).map_err(|error| format!("Failed to inspect PDF widget {:?}: {error}", widget_object_id))?
    if widget_dictionary.get([70, 84]).is_ok():
        return Result::Ok(widget_object_id)
    (widget_dictionary.get([80, 97, 114, 101, 110, 116]).map_err(|error| format!("PDF widget {:?} is missing Parent: {error}", widget_object_id))?).as_reference().map_err(|error| format!("PDF widget {:?} parent reference was invalid: {error}", widget_object_id))

fn resolve_pdf_field_type(document: &lopdf::Document, object_id: lopdf::ObjectId) -> Result<Option<String>, String>:
    let dictionary = document.get_dictionary(object_id).map_err(|error| format!("Failed to inspect PDF field {:?}: {error}", object_id))?
    match lopdf__dictionary.get([70, 84]).ok().and_then(object_name_string):
        Some(field_type) =>
            return Result::Ok(Option::Some(field_type))
        _ =>
            ()
            ()
    match lopdf__dictionary.get([80, 97, 114, 101, 110, 116]).ok().and_then(|object| object.as_reference().ok()):
        Some(parent_id) =>
            return resolve_pdf_field_type(document, parent_id)
        _ =>
            ()
            ()
    Result::Ok(none)

fn resolve_pdf_field_flags(document: &lopdf::Document, object_id: lopdf::ObjectId) -> Result<u32, String>:
    let dictionary = document.get_dictionary(object_id).map_err(|error| format!("Failed to inspect PDF field {:?}: {error}", object_id))?
    match lopdf__dictionary.get([70, 102]).ok().and_then(|object| object.as_i64().ok()).map(|value| value.max(0) as u32):
        Some(flags) =>
            return Result::Ok(flags)
        _ =>
            ()
            ()
    match lopdf__dictionary.get([80, 97, 114, 101, 110, 116]).ok().and_then(|object| object.as_reference().ok()):
        Some(parent_id) =>
            return resolve_pdf_field_flags(document, parent_id)
        _ =>
            ()
            ()
    Result::Ok(0)

fn set_pdf_field_string_value(document: &mut lopdf::Document, field_object_id: lopdf::ObjectId, value: String) -> Result<(), String>:
    let field_dictionary = document.get_dictionary_mut(field_object_id).map_err(|error| format!("Failed to inspect PDF field {:?}: {error}", field_object_id))?
    field_dictionary.set("V", Object__string_literal(value))
    ()
    Result::Ok(())

fn apply_pdf_checkbox_update(document: &mut lopdf::Document, owner_object_id: lopdf::ObjectId, widget_object_id: lopdf::ObjectId, is_checked: Bool) -> Result<(), String>:
    let export_value = block:
        let widget_dictionary = document.get_dictionary(widget_object_id).map_err(|error| format!("Failed to inspect PDF checkbox widget {:?}: {error}", widget_object_id))?
        resolve_pdf_widget_export_value(widget_dictionary).unwrap_or_else(|| "Yes".to_string())
    let state_name = if is_checked:
        export_value
    else:
        "Off".to_string()
    let owner_dictionary = document.get_dictionary_mut(owner_object_id).map_err(|error| format!("Failed to inspect PDF checkbox field {:?}: {error}", owner_object_id))?
    owner_dictionary.set("V", lopdf::Object::Name(state_name.as_bytes().to_vec()))
    ()
    let widget_dictionary = document.get_dictionary_mut(widget_object_id).map_err(|error| format!("Failed to inspect PDF checkbox widget {:?}: {error}", widget_object_id))?
    widget_dictionary.set("AS", lopdf::Object::Name(state_name.into_bytes()))
    ()
    Result::Ok(())

fn apply_pdf_radio_update(document: &mut lopdf::Document, owner_object_id: lopdf::ObjectId, selected_widget_object_id: lopdf::ObjectId) -> Result<(), String>:
    let selected_name = block:
        let widget_dictionary = document.get_dictionary(selected_widget_object_id).map_err(|error| format!("Failed to inspect PDF radio widget {:?}: {error}", selected_widget_object_id))?
        resolve_pdf_widget_export_value(widget_dictionary).unwrap_or_else(|| "Yes".to_string())
    let sibling_widget_ids = block:
        let owner_dictionary = document.get_dictionary(owner_object_id).map_err(|error| format!("Failed to inspect PDF radio field {:?}: {error}", owner_object_id))?
        owner_dictionary.get([75, 105, 100, 115]).ok().and_then(|object| object.as_array().ok()).map(|widgets| widgets.iter().filter_map(|widget| widget.as_reference().ok()).collect()).unwrap_or_else(|| vec!(selected_widget_object_id))
    for sibling_widget_id in sibling_widget_ids:
        let sibling_export_value = block:
            let sibling_dictionary = document.get_dictionary(sibling_widget_id).map_err(|error| format!("Failed to inspect PDF radio widget {:?}: {error}", sibling_widget_id))?
            resolve_pdf_widget_export_value(sibling_dictionary).unwrap_or_else(|| "Off".to_string())
        let state_name = if sibling_widget_id == selected_widget_object_id:
            selected_name.clone()
        else if sibling_export_value == selected_name:
            "Off".to_string()
        else:
            "Off".to_string()
        let sibling_dictionary = document.get_dictionary_mut(sibling_widget_id).map_err(|error| format!("Failed to inspect PDF radio widget {:?}: {error}", sibling_widget_id))?
        sibling_dictionary.set("AS", lopdf::Object::Name(state_name.into_bytes()))
        ()
    ()
    let owner_dictionary = document.get_dictionary_mut(owner_object_id).map_err(|error| format!("Failed to inspect PDF radio field {:?}: {error}", owner_object_id))?
    owner_dictionary.set("V", lopdf::Object::Name(selected_name.into_bytes()))
    ()
    Result::Ok(())

fn resolve_pdf_widget_export_value(widget_dictionary: &lopdf::Dictionary) -> Option<String>:
    match widget_dictionary.get([65, 83]).ok().and_then(object_name_string):
        Some(state_name) =>
            if state_name != "Off":
                return Option::Some(state_name)
            ()
        _ =>
            ()
            ()
    widget_dictionary.get([65, 80]).ok().and_then(|object| object.as_dict().ok()).and_then(|appearance_dictionary| appearance_dictionary.get([78]).ok()).and_then(|object| object.as_dict().ok()).and_then(|normal_appearance_dictionary| normal_appearance_dictionary.iter().filter_map(|__kain_closure_arg0| std__str__from_utf8(__kain_closure_arg0.__kain_tuple_0).ok()).find(|name| *name != "Off").map(str__to_string))

fn replace_pdf_overlay_annotations(document: &mut lopdf::Document, page_context: &PdfPageContext, page_overlays: &Slice<PdfPageOverlayEdits>) -> Result<(), String>:
    remove_existing_pdf_overlay_annotations(document, page_context)?
    ()
    for page_overlay in page_overlays:
        let page_object_id = (*page_context).page_object_ids.get(page_overlay.page_index as usize).copied().ok_or_else(|| format!("PDF overlay page index {} is invalid.", page_overlay.page_index))?
        let page_height = (*page_context).page_height_by_index.get(&page_overlay.page_index).copied().ok_or_else(|| format!("Missing PDF page height for page index {}.", page_overlay.page_index))?
        let mut new_annotation_refs = Vec__new_()
        for annotation in &page_overlay.annotations:
            let annotation_dictionary = build_pdf_overlay_annotation_dictionary(annotation, page_object_id, page_height)?
            let annotation_object_id = document.add_object(annotation_dictionary)
            new_annotation_refs.push(lopdf::Object::Reference(annotation_object_id))
            ()
        ()
        if new_annotation_refs.is_empty():
            continue
        let mut combined_annotations = block:
            let page_dictionary = document.get_dictionary(page_object_id).map_err(|error| format!("Failed to inspect PDF page {:?}: {error}", page_object_id))?
            page_dictionary.get([65, 110, 110, 111, 116, 115]).ok().and_then(|object| object.as_array().ok()).cloned().unwrap_or_default()
        combined_annotations.extend(new_annotation_refs)
        ()
        let page_dictionary = document.get_dictionary_mut(page_object_id).map_err(|error| format!("Failed to inspect PDF page {:?}: {error}", page_object_id))?
        page_dictionary.set("Annots", lopdf::Object::Array(combined_annotations))
        ()
    ()
    Result::Ok(())

fn remove_existing_pdf_overlay_annotations(document: &mut lopdf::Document, page_context: &PdfPageContext) -> Result<(), String>:
    for page_object_id in &(*page_context).page_object_ids:
        let annotation_objects = block:
            let page_dictionary = document.get_dictionary(*page_object_id).map_err(|error| format!("Failed to inspect PDF page {:?}: {error}", page_object_id))?
            page_dictionary.get([65, 110, 110, 111, 116, 115]).ok().and_then(|object| object.as_array().ok()).cloned().unwrap_or_default()
        let filtered_annotations = annotation_objects.into_iter().filter(
            |annotation_object| match annotation_object.as_reference():
                Ok(annotation_object_id) =>
                    !pdf_annotation_is_greeble_overlay(document, annotation_object_id)
                Err(_) => true
        ).collect()
        let page_dictionary = document.get_dictionary_mut(*page_object_id).map_err(|error| format!("Failed to inspect PDF page {:?}: {error}", page_object_id))?
        if filtered_annotations.is_empty():
            page_dictionary.remove([65, 110, 110, 111, 116, 115])
            ()
        else:
            page_dictionary.set("Annots", lopdf::Object::Array(filtered_annotations))
            ()
    ()
    Result::Ok(())

fn pdf_annotation_is_greeble_overlay(document: &lopdf::Document, annotation_object_id: lopdf::ObjectId) -> Bool:
    document.get_dictionary(annotation_object_id).ok().and_then(|dictionary| lopdf__dictionary.get([78, 77]).ok()).and_then(object_text_string).map(|value| value.starts_with(PDF_PREVIEW_OVERLAY_NAME_PREFIX)).unwrap_or(false)

fn build_pdf_overlay_annotation_dictionary(annotation: &PdfOverlayAnnotation, page_object_id: lopdf::ObjectId, page_height: f32) -> Result<lopdf::Dictionary, String>:
    let pdf_rect = preview_rect_to_pdf_rect(&(*annotation).bounds, page_height)
    let pdf_color = pdf_color_array(&(*annotation).color)
    let opacity = (*annotation).opacity.unwrap_or(1.0).clamp(0.0, 1.0)
    let stroke_width = (*annotation).stroke_width.unwrap_or(2.0).max(0.5)
    let annotation_name = format!("{PDF_PREVIEW_OVERLAY_NAME_PREFIX}{}", (*annotation).id)
    let mut dictionary = match (*annotation).kind:
        PdfOverlayAnnotationKind::Text =>
            let text = (*annotation).text.clone().unwrap_or_default()
            let (red, green, blue) = pdf_text_rgb_components(&(*annotation).color)
            dictionary!()
        PdfOverlayAnnotationKind::Rect => dictionary!()
        PdfOverlayAnnotationKind::Highlight => dictionary!()
        PdfOverlayAnnotationKind::Arrow => dictionary!()
        PdfOverlayAnnotationKind::Signature => dictionary!()
    lopdf__dictionary.set("M", Object__string_literal(pdf_modification_timestamp()))
    ()
    Result::Ok(lopdf__dictionary)

fn preview_rect_to_pdf_rect(rect: &PdfPageRect, page_height: f32) -> PdfPageRect:
    PdfPageRect { x: (*rect).x, y: page_height - ((*rect).y + (*rect).height), width: (*rect).width, height: (*rect).height }

fn pdf_rect_to_object_array(rect: &PdfPageRect) -> lopdf::Object:
    lopdf::Object::Array(vec!((*rect).x.into(), (*rect).y.into(), ((*rect).x + (*rect).width).into(), ((*rect).y + (*rect).height).into()))

fn pdf_color_array(color: &PdfColorValue) -> Array<lopdf::Object>:
    vec!((f32__from((*color).red) / 255.0).into(), (f32__from((*color).green) / 255.0).into(), (f32__from((*color).blue) / 255.0).into())

fn pdf_text_rgb_components(color: &PdfColorValue) -> (f32, f32, f32):
    (f32__from((*color).red) / 255.0, f32__from((*color).green) / 255.0, f32__from((*color).blue) / 255.0)

fn pdf_highlight_quad_points(rect: &PdfPageRect, page_height: f32) -> Array<lopdf::Object>:
    let pdf_rect = preview_rect_to_pdf_rect(rect, page_height)
    let left = pdf_rect.x
    let right = pdf_rect.x + pdf_rect.width
    let bottom = pdf_rect.y
    let top = pdf_rect.y + pdf_rect.height
    vec!(left.into(), top.into(), right.into(), top.into(), left.into(), bottom.into(), right.into(), bottom.into())

fn pdf_signature_ink_points(annotation: &PdfOverlayAnnotation, page_height: f32) -> Array<lopdf::Object>:
    let points = if (*annotation).points.is_empty():
        vec!(PdfPoint { x: (*annotation).bounds.x, y: (*annotation).bounds.y }, PdfPoint { x: (*annotation).bounds.x + (*annotation).bounds.width, y: (*annotation).bounds.y + (*annotation).bounds.height })
    else:
        (*annotation).points.clone()
    points.into_iter().flat_map(
        |point| block:
            let pdf_y = page_height - point.y
            [Object__from(point.x), Object__from(pdf_y)]
    ).collect()

fn pdf_arrow_ink_paths(annotation: &PdfOverlayAnnotation, page_height: f32) -> Array<lopdf::Object>:
    let points = if (*annotation).points.len() >= 2:
        (*annotation).points.clone()
    else:
        vec!(PdfPoint { x: (*annotation).bounds.x, y: (*annotation).bounds.y + (*annotation).bounds.height }, PdfPoint { x: (*annotation).bounds.x + (*annotation).bounds.width, y: (*annotation).bounds.y })
    let start = points.first().cloned().unwrap_or(PdfPoint { x: 0.0, y: 0.0 })
    let end = points.last().cloned().unwrap_or(PdfPoint { x: 0.0, y: 0.0 })
    let dx = end.x - start.x
    let dy = end.y - start.y
    let length = (dx * dx + dy * dy).sqrt().max(1.0)
    let unit_x = dx / length
    let unit_y = dy / length
    let head_length = ((*annotation).stroke_width.unwrap_or(2.0).max(2.0) * 4.0).max(10.0)
    let left_head = PdfPoint { x: end.x - head_length * (unit_x * 0.866 - unit_y * 0.5), y: end.y - head_length * (unit_y * 0.866 + unit_x * 0.5) }
    let right_head = PdfPoint { x: end.x - head_length * (unit_x * 0.866 + unit_y * 0.5), y: end.y - head_length * (unit_y * 0.866 - unit_x * 0.5) }
    vec!(lopdf::Object::Array(pdf_point_path_to_object_array(&points, page_height)), lopdf::Object::Array(pdf_point_path_to_object_array(&[end.clone(), left_head], page_height)), lopdf::Object::Array(pdf_point_path_to_object_array(&[end, right_head], page_height)))

fn pdf_point_path_to_object_array(points: &Slice<PdfPoint>, page_height: f32) -> Array<lopdf::Object>:
    points.iter().flat_map(|point| [Object__from(point.x), Object__from(page_height - point.y)]).collect()

fn pdf_modification_timestamp() -> String:
    let epoch_seconds = SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_secs()).unwrap_or_default()
    format!("D:{epoch_seconds}")

struct PluginBackendResult:
    stdout: String
    stderr: String
    status: i32

struct PluginDirectoryWatchEvent:
    root: String
    kind: String
    paths: Array<String>

struct ActivePluginWatcher:
    root: std::path::PathBuf
    watcher: notify::RecommendedWatcher

struct PluginWatcherState:
    active: Option<ActivePluginWatcher>

impl Default for PluginWatcherState:
    fn default_() -> PluginWatcherState:
        PluginWatcherState { active: none }


fn plugin_run_backend(app: tauri::AppHandle, plugins_root: String, plugin_id: String, entry: String, args: Array<String>) -> Result<PluginBackendResult, String>:
    let span = telemetry__start_native_span(&app, "plugin", "plugin_run_backend", BTreeMap__from([("pluginId".to_string(), plugin_id.clone()), ("entry".to_string(), entry.clone()), ("argCount".to_string(), args.len().to_string())]))
    let backend_entry = resolve_backend_entry(&plugins_root, &plugin_id, &entry)?
    let result = (await tokio__task__spawn_blocking(|| run_backend_command(&backend_entry, &args))).map_err(|e| format!("Plugin backend task failed to join: {e}"))?
    let status = if result.is_ok():
        "ok"
    else:
        "error"
    let error = result.err().cloned()
    let exit_status = result.ok().map(|value| value.status.to_string()).unwrap_or_default()
    telemetry__finish_native_span(&app, span, status, BTreeMap__from([("exitStatus".to_string(), exit_status)]), error)
    ()
    result

fn plugin_watch_directory(app: tauri::AppHandle, state: tauri::State<_, PluginWatcherState>, path: String, ignored_directories: Array<String>) -> Result<(), String>:
    let trimmed = path.trim()
    if trimmed.is_empty():
        return Result::Err("path cannot be empty".to_string())
    std__fs__create_dir_all(trimmed).map_err(|e| format!("Could not create plugin watch directory: {e}"))?
    ()
    let root = std__fs__canonicalize(trimmed).map_err(|e| format!("Could not resolve plugin watch directory: {e}"))?
    let event_root = root.to_string_lossy().to_string()
    let ignored_directory_names = normalize_ignored_directory_names(ignored_directories)
    let app_handle = app.clone()
    let mut watcher = notify__recommended_watcher(
        fn(res: Result<notify::Event, notify::Error>): match res:
            Ok(event) =>
                match map_watch_event_kind(&event.kind):
                    Some(kind) =>
                        let paths = event.paths.iter().filter(|path| !path_contains_ignored_directory(path, &ignored_directory_names)).map(|path| path.to_string_lossy().to_string()).collect()
                        if paths.is_empty():
                            return
                        let payload = PluginDirectoryWatchEvent { root: event_root.clone(), kind: kind.to_string(), paths: paths }
                        let _ = app_handle.emit_(PLUGIN_WATCH_EVENT, payload)
                    _ => ()
            Err(error) =>
                eprintln!("plugin watcher error: {error}")
    ).map_err(|e| format!("Could not create plugin watcher: {e}"))?
    watcher.watch(&root, notify::RecursiveMode::Recursive).map_err(|e| format!("Could not watch plugin directory '{}': {e}", root.display()))?
    ()
    let mut active = state.active.lock().map_err(|_| "plugin watcher state lock poisoned".to_string())?
    match active.take():
        Some(mut previous) =>
            let _ = previous.watcher.unwatch(&previous.root)
            ()
        _ =>
            ()
            ()
    *active = Option::Some(ActivePluginWatcher { root: root, watcher: watcher })
    ()
    Result::Ok(())

fn plugin_unwatch_directory(state: tauri::State<_, PluginWatcherState>) -> Result<(), String>:
    let mut active = state.active.lock().map_err(|_| "plugin watcher state lock poisoned".to_string())?
    match active.take():
        Some(mut current) =>
            let _ = current.watcher.unwatch(&current.root)
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn resolve_backend_entry(plugins_root: String, plugin_id: String, entry: String) -> Result<std::path::PathBuf, String>:
    if plugin_id.trim().is_empty():
        return Result::Err("plugin_id cannot be empty".to_string())
    if entry.trim().is_empty():
        return Result::Err("entry cannot be empty".to_string())
    let root = std__fs__canonicalize(plugins_root).map_err(|e| format!("Could not open plugins root: {}", e))?
    let plugin_dir = root.join(plugin_id)
    let backend_dir = plugin_dir.join("backend")
    let backend_dir = std__fs__canonicalize(&backend_dir).map_err(|e| format!("Could not open backend dir for plugin '{}': {}", plugin_id, e))?
    let candidate = backend_dir.join(entry)
    let canonical = std__fs__canonicalize(&candidate).map_err(|e| format!("Could not resolve backend entry '{}': {}", candidate.display(), e))?
    if !canonical.starts_with(&backend_dir):
        return Result::Err("Backend entry must stay inside the plugin backend directory".to_string())
    Result::Ok(canonical)

fn run_backend_command(executable: &std::path::Path, args: &Slice<String>) -> Result<PluginBackendResult, String>:
    let extension = executable.extension().map(|ext| ext.to_string_lossy().to_lowercase()).unwrap_or_default()
    if extension != "ps1" and extension != "cmd" and extension != "bat":
        ensure_unix_executable_permissions_if_present(executable)?
        ()
        ()
        ()
        ()
    let mut command = if extension == "ps1":
        let mut cmd = Command__new_("powershell")
        cmd.args(["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File"])
        ()
        cmd.arg(executable)
        ()
        cmd
    else if extension == "cmd" or extension == "bat":
        let mut cmd = Command__new_("cmd")
        cmd.arg("/C")
        ()
        cmd.arg("call")
        ()
        cmd.arg(normalize_windows_command_path(executable))
        ()
        cmd
    else:
        Command__new_(executable)
    command.args(args)
    ()
    match executable.parent():
        Some(parent) =>
            command.current_dir(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    command.creation_flags(CREATE_NO_WINDOW)
    ()
    ()
    ()
    ()
    command.stdout(Stdio__piped())
    ()
    command.stderr(Stdio__piped())
    ()
    run_command_with_timeout(command, executable, PLUGIN_BACKEND_TIMEOUT)

fn run_command_with_timeout(command: std::process::Command, executable: &std::path::Path, timeout: std::time::Duration) -> Result<PluginBackendResult, String>:
    let mut child = command.spawn_().map_err(|e| format!("Failed to run plugin backend '{}': {}", executable.display(), e))?
    let start = Instant__now()
    loop:
        match child.try_wait():
            Ok(Some(status)) =>
                let mut stdout = Vec__new_()
                let mut stderr = Vec__new_()
                match child.stdout.take():
                    Some(mut handle) =>
                        let _ = handle.read_to_end(&mut stdout)
                        ()
                    _ =>
                        ()
                        ()
                match child.stderr.take():
                    Some(mut handle) =>
                        let _ = handle.read_to_end(&mut stderr)
                        ()
                    _ =>
                        ()
                        ()
                return Result::Ok(PluginBackendResult { stdout: String__from_utf8_lossy(&stdout).to_string(), stderr: String__from_utf8_lossy(&stderr).to_string(), status: status.code().unwrap_or(-1) })
            Ok(None) =>
                if start.elapsed() >= timeout:
                    let _ = child.kill()
                    let _ = child.wait()
                    return Result::Err(format!("Plugin backend '{}' timed out after {} seconds", executable.display(), timeout.as_secs()))
                std__thread__sleep(Duration__from_millis(20))
                ()
            Err(e) =>
                let _ = child.kill()
                let _ = child.wait()
                return Result::Err(format!("Failed while waiting for plugin backend '{}': {}", executable.display(), e))

fn map_watch_event_kind(kind: &notify::EventKind) -> Option<String>:
    match kind:
        notify::EventKind::Create(_) => Option::Some("create")
        notify::EventKind::Modify(_) => Option::Some("modify")
        notify::EventKind::Remove(_) => Option::Some("remove")
        notify::EventKind::Any => Option::Some("any")
        _ => none

fn normalize_ignored_directory_names(ignored_directories: Array<String>) -> Array<String>:
    ignored_directories.into_iter().map(|value| value.trim().to_ascii_lowercase()).filter(|value| !value.is_empty()).collect()

fn path_contains_ignored_directory(path: &std::path::Path, ignored_directories: &Slice<String>) -> Bool:
    path.to_string_lossy().split(["/", "\\"]).any(
        |segment| block:
            let segment = segment.trim().to_ascii_lowercase()
            !segment.is_empty() and ignored_directories.iter().any(|ignored| ignored == &segment)
    )

fn normalize_windows_command_path(path: &std::path::Path) -> std::path::PathBuf:
    let path_str = path.as_os_str().to_string_lossy()
    match path_str.strip_prefix("\\\\?\\"):
        Some(stripped) =>
            PathBuf__from(stripped)
        _ =>
            path.to_path_buf()

fn normalize_windows_command_path(path: &std::path::Path) -> std::path::PathBuf:
    path.to_path_buf()

fn ensure_unix_executable_permissions(executable: &std::path::Path) -> Result<(), String>:
    let metadata = std__fs__metadata(executable).map_err(|e| format!("Failed to inspect plugin backend '{}': {}", executable.display(), e))?
    let mut permissions = metadata.permissions()
    let mode = permissions.mode()
    if (mode & 73) != 0:
        return Result::Ok(())
    permissions.set_mode(mode | 73)
    ()
    std__fs__set_permissions(executable, permissions).map_err(|e| format!("Failed to make plugin backend '{}' executable: {}", executable.display(), e))

fn ensure_unix_executable_permissions_if_present(executable: &std::path::Path) -> Result<(), String>:
    if executable.exists():
        ensure_unix_executable_permissions(executable)
    else:
        Result::Ok(())

fn ensure_unix_executable_permissions_if_present(_executable: &std::path::Path) -> Result<(), String>:
    Result::Ok(())

struct PreviewStreamingPolicy:
    enabled: Bool
    chunk_bytes: usize
    text_max_bytes: u64
    data_uri_max_bytes: u64
    binary_max_bytes: u64
    archive_entry_max_bytes: u64

impl PreviewStreamingPolicy:
    fn from_app(app: &tauri::AppHandle) -> PreviewStreamingPolicy:
        usr__read_usr_text_file(app, "profiles/default/explorer-performance/greeblefs-core/explorer-performance.json").ok().map(PreviewStreamingPolicy__from_explorer_performance_json).unwrap_or_default()

    fn from_explorer_performance_json(source: String) -> PreviewStreamingPolicy:
        let Ok(document) = serde_json__from_str(source)
        PreviewStreamingPolicy__from_authored(document.preview_streaming)

    fn from_authored(authored: Option<AuthoredPreviewStreamingPolicy>) -> PreviewStreamingPolicy:
        let defaults = PreviewStreamingPolicy__default_()
        let Some(authored) = authored
        PreviewStreamingPolicy { enabled: authored.enabled.unwrap_or(defaults.enabled), chunk_bytes: clamp_usize(authored.chunk_bytes, defaults.chunk_bytes, 4 * 1024, 1024 * 1024), text_max_bytes: clamp_u64(authored.text_max_bytes, defaults.text_max_bytes, 1024, 64 * 1024 * 1024), data_uri_max_bytes: clamp_u64(authored.data_uri_max_bytes, defaults.data_uri_max_bytes, 1024, 64 * 1024 * 1024), binary_max_bytes: clamp_u64(authored.binary_max_bytes, defaults.binary_max_bytes, 1024, 512 * 1024 * 1024), archive_entry_max_bytes: clamp_u64(authored.archive_entry_max_bytes, defaults.archive_entry_max_bytes, 1024, 512 * 1024 * 1024) }


impl Default for PreviewStreamingPolicy:
    fn default_() -> PreviewStreamingPolicy:
        PreviewStreamingPolicy { enabled: true, chunk_bytes: DEFAULT_CHUNK_BYTES, text_max_bytes: DEFAULT_TEXT_MAX_BYTES, data_uri_max_bytes: DEFAULT_DATA_URI_MAX_BYTES, binary_max_bytes: DEFAULT_BINARY_MAX_BYTES, archive_entry_max_bytes: DEFAULT_ARCHIVE_ENTRY_MAX_BYTES }


struct PreviewStreamingManager:
    policy: PreviewStreamingPolicy

impl PreviewStreamingManager:
    fn new_(policy: PreviewStreamingPolicy) -> PreviewStreamingManager:
        PreviewStreamingManager { policy: Arc__new_(policy) }

    fn from_app(app: &tauri::AppHandle) -> PreviewStreamingManager:
        PreviewStreamingManager__new_(PreviewStreamingPolicy__from_app(app))

    fn policy(_self: &PreviewStreamingManager) -> &PreviewStreamingPolicy:
        &(*_self).policy


impl Default for PreviewStreamingManager:
    fn default_() -> PreviewStreamingManager:
        PreviewStreamingManager__new_(PreviewStreamingPolicy__default_())


fn read_local_preview_bytes(path: &std::path::Path, requested_max_bytes: Option<u64>, policy: &PreviewStreamingPolicy, token: &NativeTaskCancellationToken) -> Result<Array<u8>, String>:
    let allowed_bytes = resolve_preview_byte_limit(requested_max_bytes, (*policy).binary_max_bytes)
    read_local_file_bytes_with_limit(path, allowed_bytes, (*policy).chunk_bytes, token, "native preview transport")

fn read_local_text_file(path: &std::path::Path, policy: &PreviewStreamingPolicy, token: &NativeTaskCancellationToken) -> Result<String, String>:
    let bytes = read_local_file_bytes_with_limit(path, (*policy).text_max_bytes, (*policy).chunk_bytes, token, "text preview")?
    String__from_utf8(bytes).map_err(|error| format!("File is not valid UTF-8: {error}"))

fn read_local_file_data_url(path: &std::path::Path, policy: &PreviewStreamingPolicy, token: &NativeTaskCancellationToken) -> Result<String, String>:
    let bytes = read_local_file_bytes_with_limit(path, (*policy).data_uri_max_bytes, (*policy).chunk_bytes, token, "data-URI preview")?
    Result::Ok(format!("data:{};base64,{}", preview_mime_type(path), base64_encode(&bytes)))

fn read_reader_to_bounded_vec(reader: &mut R, known_size: Option<u64>, max_bytes: u64, chunk_bytes: usize, token: &NativeTaskCancellationToken, subject: String) -> Result<Array<u8>, String>:
    let chunk_bytes = chunk_bytes.max(1)
    match known_size:
        Some(known_size) =>
            ensure_size_within_limit(known_size, max_bytes, subject)?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let capacity = known_size.map(|size| size.min(max_bytes) as usize).unwrap_or_else(|| chunk_bytes.min(max_bytes as usize))
    let mut output = |__kain_ctor_arg0| Vec::new()(capacity)
    let mut buffer = vec!()
    loop:
        token.throw_if_cancelled()?
        ()
        let read = reader.read(&mut buffer).map_err(|error| format!("Failed to read {subject}: {error}"))?
        if read == 0:
            break
        if output.len() as u64 + read as u64 > max_bytes:
            return Result::Err(limit_error(subject, max_bytes))
        output.extend_from_slice(&buffer[..read])
        ()
        token.throw_if_cancelled()?
        ()
    ()
    Result::Ok(output)

fn resolve_preview_byte_limit(requested_bytes: Option<u64>, hard_limit_bytes: u64) -> u64:
    requested_bytes.unwrap_or(hard_limit_bytes).max(1).min(hard_limit_bytes)

fn format_preview_byte_limit(limit_bytes: u64) -> String:
    let limit_mebibytes = limit_bytes.div_ceil(1024 * 1024)
    format!("{limit_mebibytes} MB")

fn read_local_file_bytes_with_limit(path: &std::path::Path, max_bytes: u64, chunk_bytes: usize, token: &NativeTaskCancellationToken, subject: String) -> Result<Array<u8>, String>:
    let metadata = std__fs__metadata(path).map_err(|error| error.to_string())?
    if !metadata.is_file():
        return Result::Err(format!("Path is not a file: {}", path.display()))
    ensure_size_within_limit(metadata.len(), max_bytes, subject)?
    ()
    let mut file = File__open(path).map_err(|error| error.to_string())?
    read_reader_to_bounded_vec(&mut file, Option::Some(metadata.len()), max_bytes, chunk_bytes, token, subject)

fn ensure_size_within_limit(size: u64, max_bytes: u64, subject: String) -> Result<(), String>:
    if size > max_bytes:
        return Result::Err(limit_error(subject, max_bytes))
    Result::Ok(())

fn limit_error(subject: String, max_bytes: u64) -> String:
    format!("File is too large for {subject} (> {})", format_preview_byte_limit(max_bytes))

fn preview_mime_type(path: &std::path::Path) -> String:
    match path.extension().map(|extension| extension.to_string_lossy().to_lowercase()).unwrap_or_default().as_str():
        "png" => "image/png"
        "jpg" | "jpeg" => "image/jpeg"
        "gif" => "image/gif"
        "webp" => "image/webp"
        "bmp" => "image/bmp"
        "ico" => "image/x-icon"
        "svg" => "image/svg+xml"
        "tiff" | "tif" => "image/tiff"
        "avif" => "image/avif"
        "glb" => "model/gltf-binary"
        "gltf" => "model/gltf+json"
        "obj" => "text/plain"
        "stl" => "model/stl"
        "fbx" => "application/octet-stream"
        _ => "application/octet-stream"

fn base64_encode(input: &Slice<u8>) -> String:
    let mut output = |__kain_ctor_arg0| String::new()(input.len().div_ceil(3) * 4)
    for chunk in input.chunks(3):
        let first = chunk[0]
        let second = *chunk.get(1).unwrap_or(&0)
        let third = *chunk.get(2).unwrap_or(&0)
        output.push(CHARS[(first >> 2) as usize] as Char)
        ()
        output.push(CHARS[(((first & 3) << 4) | (second >> 4)) as usize] as Char)
        ()
        if chunk.len() > 1:
            output.push(CHARS[(((second & 15) << 2) | (third >> 6)) as usize] as Char)
            ()
            ()
            ()
            ()
        else:
            output.push("=")
            ()
            ()
            ()
            ()
        if chunk.len() > 2:
            output.push(CHARS[(third & 63) as usize] as Char)
            ()
        else:
            output.push("=")
            ()
    ()
    output

struct AuthoredExplorerPerformanceManifest:
    preview_streaming: Option<AuthoredPreviewStreamingPolicy>

struct AuthoredPreviewStreamingPolicy:
    enabled: Option<Bool>
    chunk_bytes: Option<usize>
    text_max_bytes: Option<u64>
    data_uri_max_bytes: Option<u64>
    binary_max_bytes: Option<u64>
    archive_entry_max_bytes: Option<u64>

fn clamp_usize(value: Option<usize>, fallback: usize, minimum: usize, maximum: usize) -> usize:
    value.unwrap_or(fallback).clamp(minimum, maximum)

fn clamp_u64(value: Option<u64>, fallback: u64, minimum: u64, maximum: u64) -> u64:
    value.unwrap_or(fallback).clamp(minimum, maximum)

struct PythonRuntimeConfig:
    preferred_interpreter_path: Option<String>
    runtime_root: Option<String>
    bootstrap_packages: Option<String>
    auto_upgrade_pip: Option<Bool>
    create_boilerplate: Option<Bool>

impl Default for PythonRuntimeConfig:
    fn default_() -> PythonRuntimeConfig:
        PythonRuntimeConfig { preferred_interpreter_path: none, runtime_root: none, bootstrap_packages: none, auto_upgrade_pip: none, create_boilerplate: none }


struct PythonPackageInstallRequest:
    config: Option<PythonRuntimeConfig>
    package_input: String
    persist_to_requirements: Option<Bool>

enum PythonExecutionMode:
    Inline
    Script
    Module

struct PythonExecutionRequest:
