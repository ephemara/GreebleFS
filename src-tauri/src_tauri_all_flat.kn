struct ResolvedMobilePluginContext:
    absolute_path: std::path::PathBuf
    relative_path: String

fn mobile_plugin_catalog_handler(_: axum::extract::State<ShareState>) -> axum::response::Response:
    let snapshot = (await types__ACTIVE_MOBILE_THEME_SNAPSHOT.read()).clone()
    match build_mobile_plugin_catalog(&state, &snapshot):
        Ok(catalog) => (axum::http::StatusCode::OK, axum__Json(catalog)).into_response()
        Err(error) => (axum::http::StatusCode::INTERNAL_SERVER_ERROR, error).into_response()

fn mobile_plugin_backend_handler(_: axum::extract::State<ShareState>, _: axum::extract::Path<String>, _: axum::Json<MobilePluginBackendRunRequest>) -> axum::response::Response:
    let plugin_route_id = match normalize_safe_path_segment(&plugin_id):
        Some(value) => value
        None => return (axum::http::StatusCode::BAD_REQUEST, "Invalid plugin id").into_response()
    let backend_entry = match normalize_safe_relative_path(&request.entry):
        Some(value) => value
        None => return (axum::http::StatusCode::BAD_REQUEST, "Invalid backend entry").into_response()
    let plugins_root = match resolve_mobile_plugins_root(&state):
        Ok(path) => path
        Err(error) => return (axum::http::StatusCode::INTERNAL_SERVER_ERROR, error).into_response()
    if !plugins_root.join(&plugin_route_id).exists():
        return (axum::http::StatusCode::NOT_FOUND, "Plugin not found").into_response()
    let context = match resolve_mobile_plugin_context(&state, request.context_path):
        Ok(context) => context
        Err(status) => return (status, "Invalid plugin context path").into_response()
    let template_values = build_backend_template_values(&state, &plugin_route_id, &context.relative_path, &context.absolute_path, request.pane_id.unwrap_or_default(), request.action_id.unwrap_or_default())
    let resolved_args = request.args.unwrap_or_default().into_iter().map(|arg| replace_mobile_plugin_template_tokens(&arg, &template_values)).collect()
    let result = match await plugin_commands__plugin_run_backend(state.app_handle.clone(), plugins_root.to_string_lossy().into_owned(), plugin_route_id.clone(), backend_entry.clone(), resolved_args):
        Ok(result) => result
        Err(error) => return (axum::http::StatusCode::BAD_REQUEST, error).into_response()
    let response = MobilePluginBackendRunResponse { plugin_id: plugin_route_id, entry: backend_entry, context_path: context.relative_path, context_absolute_path: context.absolute_path.to_string_lossy().into_owned(), pane_id: request.pane_id.unwrap_or_default(), action_id: request.action_id.unwrap_or_default(), stdout: result.stdout, stderr: result.stderr, status: result.status }
    (axum::http::StatusCode::OK, axum__Json(response)).into_response()

fn mobile_plugin_asset_handler(_: axum::extract::State<ShareState>, _: axum::extract::Path<(String, String)>, headers: axum::http::HeaderMap) -> axum::response::Response:
    let plugin_route_id = match normalize_safe_path_segment(&plugin_id):
        Some(value) => value
        None => return (axum::http::StatusCode::BAD_REQUEST, "Invalid plugin id").into_response()
    let safe_asset_path = match normalize_safe_relative_path(&asset_path):
        Some(value) => value
        None => return (axum::http::StatusCode::BAD_REQUEST, "Invalid asset path").into_response()
    let plugins_root = match resolve_mobile_plugins_root(&state):
        Ok(path) => path
        Err(error) => return (axum::http::StatusCode::INTERNAL_SERVER_ERROR, error).into_response()
    let plugin_dir = plugins_root.join(&plugin_route_id)
    let canonical_plugin_dir = match std__fs__canonicalize(&plugin_dir):
        Ok(path) => path
        Err(_) => return (axum::http::StatusCode::NOT_FOUND, "Plugin not found").into_response()
    let candidate = plugin_dir.join(&safe_asset_path)
    let canonical_asset = match std__fs__canonicalize(&candidate):
        Ok(path) => path
        Err(_) => return (axum::http::StatusCode::NOT_FOUND, "Plugin asset not found").into_response()
    if !canonical_asset.starts_with(&canonical_plugin_dir) or !canonical_asset.is_file():
        return (axum::http::StatusCode::FORBIDDEN, "Plugin asset must stay inside the plugin").into_response()
    await streaming__stream_file_response(&canonical_asset, &headers)

fn build_mobile_plugin_catalog(state: &ShareState, snapshot: &MobileThemeSnapshot) -> Result<MobilePluginCatalogResponse, String>:
    let plugins_root = resolve_mobile_plugins_root(state)?
    let plugin_root_display = plugins_root.to_string_lossy().into_owned()
    let mut warnings = Vec__new_()
    let mut plugins = Vec__new_()
    let mut panes = Vec__new_()
    let directory_entries = std__fs__read_dir(&plugins_root).map_err(|error| format!("Failed to read mobile plugin root: {error}"))?
    for directory_entry in directory_entries:
        let directory_entry = match directory_entry:
            Ok(value) => value
            Err(error) =>
                warnings.push(format!("Failed to read plugin directory entry: {error}"))
                ()
                continue
        let plugin_dir = directory_entry.path()
        if !plugin_dir.is_dir():
            continue
        let directory_name = directory_entry.file_name().to_string_lossy().into_owned()
        let Some(plugin_route_id) = normalize_safe_path_segment(&directory_name)
        let Some(manifest_path) = find_mobile_plugin_manifest(&plugin_dir)
        match parse_mobile_plugin_manifest(&plugin_route_id, &manifest_path):
            Ok(mut parsed) =>
                parsed.summary.settings_values = (*snapshot).plugin_settings_by_id.get(&plugin_route_id).or_else(|| (*snapshot).plugin_settings_by_id.get(&parsed.summary.manifest_id)).cloned().unwrap_or_default()
                ()
                warnings.extend(parsed.warnings)
                ()
                panes.extend(parsed.panes)
                ()
                plugins.push(parsed.summary)
                ()
            Err(error) =>
                warnings.push(format!("Failed to parse mobile plugin manifest '{}': {error}", manifest_path.display()))
                ()
    ()
    plugins.sort_by(|left, right| left.name.cmp(&right.name).then(left.id.cmp(&right.id)))
    ()
    panes.sort_by(|left, right| left.order.cmp(&right.order).then(left.title.cmp(&right.title)).then(left.id.cmp(&right.id)))
    ()
    Result::Ok(MobilePluginCatalogResponse { plugin_root: plugin_root_display, refreshed_at_ms: now_ms(), plugins: plugins, panes: panes, warnings: warnings })

fn parse_mobile_plugin_manifest(plugin_route_id: String, manifest_path: &std::path::Path) -> Result<ParsedMobilePluginManifest, String>:
    let manifest_value = read_manifest_as_json_value(manifest_path)?
    let manifest_id = as_string(manifest_value.get("id")).unwrap_or_else(|| plugin_route_id.to_string())
    let plugin_name = as_string(manifest_value.get("name")).or_else(|| as_string(manifest_value.get("displayName"))).unwrap_or_else(|| derive_display_name(plugin_route_id))
    let description = as_string(manifest_value.get("description")).unwrap_or_default()
    let category = as_string(manifest_value.get("category")).unwrap_or_else(|| "Plugins".to_string())
    let tags = as_string_array(manifest_value.get("tags"))
    let contributions = manifest_value.get("contributions")
    let mobile_pane_values = as_array(contributions.and_then(|value| value.get("mobilePanes")))
    let mobile_panes = mobile_pane_values.iter().enumerate().filter_map(|__kain_closure_arg0| normalize_mobile_plugin_pane(plugin_route_id, &manifest_id, &plugin_name, &category, __kain_closure_arg0.__kain_tuple_0, __kain_closure_arg0.__kain_tuple_1)).collect()
    let backend_action_count = mobile_panes.iter().map(|pane| pane.actions.iter().filter(|action| action.backend.is_some()).count()).sum()
    let can_run_backend = manifest_path.parent().map(|plugin_dir| plugin_dir.join(MOBILE_PLUGIN_BACKEND_DIRECTORY_NAME).is_dir()).unwrap_or(false)
    let root_access = MobilePluginRootAccess { same_root_as_desktop_plugins: true, usr_relative_root: MOBILE_PLUGIN_USR_RELATIVE_ROOT.to_string(), plugin_directory_name: plugin_route_id.to_string(), backend_directory_name: MOBILE_PLUGIN_BACKEND_DIRECTORY_NAME.to_string(), can_run_backend: can_run_backend, backend_route: format!("/api/plugins/{plugin_route_id}/backend"), asset_route_prefix: format!("/api/plugins/{plugin_route_id}/assets") }
    let summary = MobilePluginSummary { id: plugin_route_id.to_string(), manifest_id: manifest_id, directory_name: plugin_route_id.to_string(), name: plugin_name, description: description, category: category, tags: tags, settings_values: BTreeMap__new_(), capabilities: MobilePluginCapabilitySummary { desktop_panel: as_string(manifest_value.get("entry")).is_some(), mobile_panes: mobile_panes.len(), backend_actions: backend_action_count, themes: as_array(contributions.and_then(|value| value.get("themes"))).len(), shaders: as_array(contributions.and_then(|value| value.get("shaders"))).len(), fonts: as_array(contributions.and_then(|value| value.get("fonts"))).len(), commands: as_array(contributions.and_then(|value| value.get("commands"))).len(), preview_lanes: as_array(contributions.and_then(|value| value.get("previewLanes"))).len(), settings_slots: as_array(contributions.and_then(|value| value.get("settingsSlots"))).len(), context_menu_items: as_array(contributions.and_then(|value| value.get("contextMenuItems"))).len() }, root_access: root_access }
    Result::Ok(ParsedMobilePluginManifest { summary: summary, panes: mobile_panes, warnings: Vec__new_() })

fn normalize_mobile_plugin_pane(plugin_route_id: String, manifest_id: String, plugin_name: String, fallback_category: String, index: usize, value: &serde_json::Value) -> Option<MobilePluginPane>:
    let record = value.as_object()?
    let title = as_string(record.get("title")).or_else(|| as_string(record.get("name"))).unwrap_or_else(|| format!("{} Mobile", plugin_name))
    let local_id = as_string(record.get("id")).and_then(|id| normalize_safe_id(&id)).unwrap_or_else(|| derive_safe_id(&title, &format!("pane-{index}")))
    let pane_id = format!("{plugin_route_id}.mobile-pane.{local_id}")
    let description = as_string(record.get("description")).unwrap_or_default()
    let icon_name = as_string(record.get("iconName")).or_else(|| as_string(record.get("icon"))).unwrap_or_else(|| "Puzzle".to_string())
    let icon_id = as_string(record.get("iconId")).unwrap_or_default()
    let order = as_i32(record.get("order")).unwrap_or((index as i32) * 10 + 200)
    let category = as_string(record.get("category")).unwrap_or_else(|| fallback_category.to_string())
    let kind = normalize_pane_kind(as_string(record.get("kind")))
    let renderer = as_string(record.get("renderer")).or_else(|| as_string(record.get("rendererEntry"))).and_then(|path| normalize_safe_relative_path(&path)).unwrap_or_default()
    let renderer_url = if renderer.is_empty():
        String__new_()
    else:
        build_mobile_plugin_asset_url(plugin_route_id, &renderer)
    let styles = as_string_array(record.get("styles")).into_iter().filter_map(|path| normalize_safe_relative_path(&path)).collect()
    let style_urls = styles.iter().map(|path| build_mobile_plugin_asset_url(plugin_route_id, path)).collect()
    let theme = normalize_mobile_plugin_pane_theme(record.get("theme"))
    let sections = as_array(record.get("sections")).iter().enumerate().filter_map(|__kain_closure_arg1| normalize_mobile_plugin_pane_section(plugin_route_id, __kain_closure_arg1.__kain_tuple_0, __kain_closure_arg1.__kain_tuple_1)).collect()
    let actions = as_array(record.get("actions")).iter().enumerate().filter_map(|__kain_closure_arg2| normalize_mobile_plugin_pane_action(__kain_closure_arg2.__kain_tuple_0, __kain_closure_arg2.__kain_tuple_1)).collect()
    Option::Some(MobilePluginPane { id: pane_id, local_id: local_id, plugin_id: plugin_route_id.to_string(), manifest_id: manifest_id.to_string(), plugin_name: plugin_name.to_string(), title: title, description: description, icon_name: icon_name, icon_id: icon_id, order: order, category: category, kind: kind, renderer: renderer, renderer_url: renderer_url, styles: styles, style_urls: style_urls, theme: theme, sections: sections, actions: actions })

fn normalize_mobile_plugin_pane_theme(value: Option<&serde_json::Value>) -> MobilePluginPaneTheme:
    let record = value.and_then(Value__as_object)
    let accent = record.and_then(|theme| as_string(theme.get("accent"))).unwrap_or_default()
    let css_vars = record.and_then(|theme| theme.get("cssVars")).and_then(Value__as_object).map(
        |entries| entries.iter().filter_map(
            |__kain_closure_arg3| block:
                let normalized_key = __kain_closure_arg3.__kain_tuple_0.trim()
                if !normalized_key.starts_with("--"):
                    return none
                as_string(Option::Some(__kain_closure_arg3.__kain_tuple_1)).map(|css_value| (normalized_key.to_string(), css_value))
        ).collect()
    ).unwrap_or_default()
    MobilePluginPaneTheme { accent: accent, css_vars: css_vars }

fn normalize_mobile_plugin_pane_section(plugin_route_id: String, index: usize, value: &serde_json::Value) -> Option<MobilePluginPaneSection>:
    let record = value.as_object()?
    let title = as_string(record.get("title")).unwrap_or_else(|| format!("Section {}", index + 1))
    let id = as_string(record.get("id")).and_then(|id| normalize_safe_id(&id)).unwrap_or_else(|| derive_safe_id(&title, &format!("section-{index}")))
    let body = as_string(record.get("body")).or_else(|| as_string(record.get("description"))).unwrap_or_default()
    let asset_path = as_string(record.get("assetPath")).and_then(|path| normalize_safe_relative_path(&path)).unwrap_or_default()
    let asset_url = if asset_path.is_empty():
        String__new_()
    else:
        build_mobile_plugin_asset_url(plugin_route_id, &asset_path)
    Option::Some(MobilePluginPaneSection { id: id, title: title, body: body, asset_path: asset_path, asset_url: asset_url })

fn normalize_mobile_plugin_pane_action(index: usize, value: &serde_json::Value) -> Option<MobilePluginPaneAction>:
    let record = value.as_object()?
    let label = as_string(record.get("label")).or_else(|| as_string(record.get("title"))).unwrap_or_else(|| format!("Action {}", index + 1))
    let id = as_string(record.get("id")).and_then(|id| normalize_safe_id(&id)).unwrap_or_else(|| derive_safe_id(&label, &format!("action-{index}")))
    let backend_record = record.get("backend").and_then(Value__as_object)
    let backend_entry = backend_record.and_then(|backend| as_string(backend.get("entry")))
    let kind = normalize_action_kind(as_string(record.get("kind")), backend_entry)
    let backend = backend_entry.and_then(|entry| normalize_safe_relative_path(&entry)).map(|entry| MobilePluginPaneBackendAction { entry: entry, args: as_string_array(backend_record.and_then(|backend| backend.get("args"))), success_message: backend_record.and_then(|backend| as_string(backend.get("successMessage"))).unwrap_or_else(|| "Plugin action finished.".to_string()) })
    Option::Some(MobilePluginPaneAction { id: id, label: label, description: as_string(record.get("description")).unwrap_or_default(), icon_name: as_string(record.get("iconName")).or_else(|| as_string(record.get("icon"))).unwrap_or_else(
        || match kind.as_str():
            "backend" => "Play".to_string()
            "link" => "ExternalLink".to_string()
            "copy" => "Copy".to_string()
            _ => "Puzzle".to_string()
    ), tone: normalize_action_tone(as_string(record.get("tone"))), kind: kind, href: as_string(record.get("href")).unwrap_or_default(), copy_text: as_string(record.get("copyText")).unwrap_or_default(), backend: backend })

fn read_manifest_as_json_value(path: &std::path::Path) -> Result<serde_json::Value, String>:
    let text = std__fs__read_to_string(path).map_err(|error| format!("Failed to read manifest '{}': {error}", path.display()))?
    let extension = path.extension().map(|value| value.to_string_lossy().to_ascii_lowercase()).unwrap_or_default()
    if extension == "json":
        serde_json__from_str(&text).map_err(|error| format!("Failed to parse JSON manifest: {error}"))
    else:
        let value = toml__from_str(&text).map_err(|error| format!("Failed to parse TOML manifest: {error}"))?
        serde_json__to_value(value).map_err(|error| format!("Failed to normalize manifest: {error}"))

fn find_mobile_plugin_manifest(plugin_dir: &std::path::Path) -> Option<std::path::PathBuf>:
    MOBILE_PLUGIN_MANIFEST_NAMES.iter().map(|name| plugin_dir.join(name)).find(|path| path.is_file())

fn resolve_mobile_plugins_root(state: &ShareState) -> Result<std::path::PathBuf, String>:
    usr__resolve_usr_relative_path(&(*state).app_handle, MOBILE_PLUGIN_USR_RELATIVE_ROOT)

fn resolve_mobile_plugin_context(state: &ShareState, context_path: Option<String>) -> Result<ResolvedMobilePluginContext, axum::http::StatusCode>:
    match &(*state).file_hub:
        Some(hub) =>
            let index = context_path.unwrap_or_default().trim().parse().unwrap_or(0)
            let target = hub.get(index).ok_or(axum::http::StatusCode::NOT_FOUND)?
            return Result::Ok(ResolvedMobilePluginContext { absolute_path: target.clone(), relative_path: index.to_string() })
        _ =>
            ()
            ()
    let relative_path = context_path.unwrap_or_default().trim()
    let absolute_path = streaming__resolve_sub_path(&(*state).share_path, Option::Some(relative_path))?
    let normalized_relative_path = compute_relative_path(&(*state).share_path, &absolute_path)
    Result::Ok(ResolvedMobilePluginContext { absolute_path: absolute_path, relative_path: normalized_relative_path })

fn compute_relative_path(base: &std::path::Path, path: &std::path::Path) -> String:
    path.strip_prefix(base).ok().map(
        |relative| relative.components().filter_map(
            |component| match component_:
                std::path::Component::Normal(segment) => Option::Some(segment.to_string_lossy().into_owned())
                _ => none
        ).collect().join("/")
    ).unwrap_or_default()

fn build_backend_template_values(state: &ShareState, plugin_route_id: String, context_path: String, context_absolute_path: &std::path::Path, pane_id: String, action_id: String) -> Map<String, String>:
    BTreeMap__from([("{actionId}".to_string(), action_id.to_string()), ("{contextAbsolutePath}".to_string(), context_absolute_path.to_string_lossy().into_owned()), ("{contextPath}".to_string(), context_path.to_string()), ("{currentAbsolutePath}".to_string(), context_absolute_path.to_string_lossy().into_owned()), ("{currentPath}".to_string(), context_path.to_string()), ("{paneId}".to_string(), pane_id.to_string()), ("{path}".to_string(), context_path.to_string()), ("{pluginId}".to_string(), plugin_route_id.to_string()), ("{shareRoot}".to_string(), (*state).share_path.to_string_lossy().into_owned())])

fn replace_mobile_plugin_template_tokens(value: String, replacements: &Map<String, String>) -> String:
    replacements.iter().fold(value.to_string(), |current, __kain_closure_arg4| current.replace(__kain_closure_arg4.__kain_tuple_0, __kain_closure_arg4.__kain_tuple_1))

fn build_mobile_plugin_asset_url(plugin_route_id: String, asset_path: String) -> String:
    format!("{MOBILE_PLUGIN_ASSET_ROUTE_PREFIX}/{}/assets/{}", urlencoding__encode(plugin_route_id), encode_relative_path(asset_path))

fn encode_relative_path(path: String) -> String:
    path.split("/").filter(|segment| !segment.is_empty()).map(urlencoding__encode).collect().join("/")

fn normalize_safe_path_segment(value: String) -> Option<String>:
    let trimmed = value.trim()
    if trimmed.is_empty() or trimmed == "." or trimmed == ".." or trimmed.contains("/") or trimmed.contains("\\") or trimmed.contains(":"):
        return none
    Option::Some(trimmed.to_string())

fn normalize_safe_relative_path(value: String) -> Option<String>:
    let normalized = value.trim().replace("\\", "/")
    if normalized.is_empty() or normalized.starts_with("/") or normalized.contains(":") or normalized.split("/").any(|segment| segment.is_empty() or segment == "." or segment == ".."):
        return none
    Option::Some(normalized)

fn normalize_safe_id(value: String) -> Option<String>:
    let normalized = derive_safe_id(value, "")
    if normalized.is_empty():
        none
    else:
        Option::Some(normalized)

fn derive_safe_id(value: String, fallback: String) -> String:
    let mut output = String__new_()
    let mut last_dash = false
    for character in value.chars():
        let normalized = character.to_ascii_lowercase()
        if normalized.is_ascii_alphanumeric():
            output.push(normalized)
            ()
            last_dash = false
            ()
        else if !last_dash:
            output.push("-")
            ()
            last_dash = true
            ()
    ()
    let output = output.trim_matches("-").to_string()
    if output.is_empty():
        fallback.to_string()
    else:
        output

fn derive_display_name(value: String) -> String:
    value.replace("-", " ").replace("_", " ").split_whitespace().map(
        |part| block:
            let mut chars = part.chars()
            match chars.next():
                Some(first) => format!("{}{}", first.to_uppercase(), chars.as_str())
                None => String__new_()
    ).collect().join(" ")

fn normalize_pane_kind(value: Option<String>) -> String:
    match value.unwrap_or_default():
        "dashboard" | "tool" | "inspector" | "viewer" => value.unwrap_or_default().to_string()
        _ => "dashboard".to_string()

fn normalize_action_kind(value: Option<String>, backend_entry: Option<String>) -> String:
    match value.unwrap_or_default():
        "backend" | "link" | "copy" => value.unwrap_or_default().to_string()
        _ if backend_entry.is_some() => "backend".to_string()
        _ => "link".to_string()

fn normalize_action_tone(value: Option<String>) -> String:
    match value.unwrap_or_default():
        "accent" | "danger" | "success" | "warning" => value.unwrap_or_default().to_string()
        _ => "neutral".to_string()

fn as_array(value: Option<&serde_json::Value>) -> Array<serde_json::Value>:
    value.and_then(Value__as_array).cloned().unwrap_or_default()

fn as_string(value: Option<&serde_json::Value>) -> Option<String>:
    value.and_then(Value__as_str).map(str__trim).filter(|value| !value.is_empty()).map(str__to_string)

fn as_string_array(value: Option<&serde_json::Value>) -> Array<String>:
    value.and_then(Value__as_array).map(|entries| entries.iter().filter_map(|entry| as_string(Option::Some(entry))).collect()).unwrap_or_default()

fn as_i32(value: Option<&serde_json::Value>) -> Option<i32>:
    value.and_then(Value__as_i64).and_then(|value| i32__try_from(value).ok())

fn now_ms() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_millis().min(u128__from(u64__MAX)) as u64).unwrap_or_default()

fn get_local_ipv4() -> Result<std::net::Ipv4Addr, String>:
    let interfaces = local_ip_address__list_afinet_netifas().map_err(|err| format!("Failed to enumerate network interfaces: {err}"))?
    let default_route_ipv4 = match local_ip_address__local_ip():
        Ok(std::net::IpAddr::V4(ipv4)) => Option::Some(ipv4)
        _ => none
    select_local_ipv4_from_sources(default_route_ipv4, &interfaces).ok_or_else(|| "No suitable LAN IPv4 address found. Make sure you are connected to a local network.".into())

fn select_local_ipv4_from_sources(default_route_ipv4: Option<std::net::Ipv4Addr>, interfaces: &Slice<(String, std::net::IpAddr)>) -> Option<std::net::Ipv4Addr>:
    match default_route_ipv4.filter(is_shareable_ipv4):
        Some(ipv4) =>
            return Option::Some(ipv4)
        _ =>
            ()
            ()
    let mut best_ip: Option<std::net::Ipv4Addr> = none
    let mut best_priority: u8 = 0
    for (name, ip) in interfaces:
        match ip:
            std::net::IpAddr::V4(ipv4) =>
                if !is_shareable_ipv4(ipv4):
                    continue
                let priority = lan_ip_priority(ipv4)
                if priority > best_priority:
                    best_priority = priority
                    ()
                    best_ip = Option::Some(*ipv4)
                    ()
            _ => ()
    ()
    best_ip

fn is_shareable_ipv4(ip: &std::net::Ipv4Addr) -> Bool:
    !ip.is_loopback() and !ip.is_link_local() and !ip.is_unspecified() and !is_tailscale_cgnat_ipv4(ip)

fn is_tailscale_cgnat_ipv4(ip: &std::net::Ipv4Addr) -> Bool:
    let octets = ip.octets()
    matches!(octets, [100, 64..=127, ..])

fn is_private_lan_ip(ip: &std::net::Ipv4Addr) -> Bool:
    let octets = ip.octets()
    matches!(octets, [192, 168, ..] | [10, ..] | [172, 16..=31, ..])

fn lan_ip_priority(ip: &std::net::Ipv4Addr) -> u8:
    let octets = ip.octets()
    match octets:
        [192, 168, _] => 4
        [10, _] => 3
        [172, 16..=31, _] => 3
        _ if is_private_lan_ip(ip) => 2
        _ => 1

fn find_available_port(preferred: u16, exclude: &Slice<u16>) -> Result<u16, String>:
    if !exclude.contains(&preferred) and TcpListener__bind(SocketAddr__from(([0, 0, 0, 0], preferred))).is_ok():
        return Result::Ok(preferred)
    for port in types__PORT_RANGE_START..=types__PORT_RANGE_END:
        if exclude.contains(&port):
            continue
        if TcpListener__bind(SocketAddr__from(([0, 0, 0, 0], port))).is_ok():
            return Result::Ok(port)
    ()
    Result::Err("No available port found".into())

fn format_http_url(host: String, port: u16) -> String:
    if port == types__HTTP_DEFAULT_PORT:
        format!("http://{host}")
    else:
        format!("http://{host}:{port}")

fn format_host_port(host: String, port: u16) -> String:
    if port == types__HTTP_DEFAULT_PORT:
        host.to_string()
    else:
        format!("{host}:{port}")

fn format_https_url(host: String, port: u16) -> String:
    if port == types__HTTPS_DEFAULT_PORT:
        format!("https://{host}")
    else:
        format!("https://{host}:{port}")

struct MobilePushSubscriptionKeysInput:
    p256dh: String
    auth: String

struct MobilePushSubscriptionInput:
    endpoint: String
    keys: MobilePushSubscriptionKeysInput
    expiration_time: Option<i64>
    device_label: Option<String>
    user_agent: Option<String>
    standalone: Bool

struct MobilePushSubscriptionRemovalRequest:
    endpoint: String

struct MobilePushPairedDeviceSummary:
    endpoint: String
    device_label: String
    user_agent: Option<String>
    standalone: Bool
    updated_at_ms: u64

struct MobilePushConfigResponse:
    supported: Bool
    vapid_public_key: String
    subscription_count: usize
    paired_devices: Array<MobilePushPairedDeviceSummary>

struct MobilePushDispatchResult:
    delivered_count: usize
    failed_count: usize
    subscription_count: usize

struct MobilePushDownloadNotificationRequest:
    absolute_path: String
    share_url: String

struct StoredMobilePushSubscription:
    endpoint: String
    p256dh: String
    auth: String
    expiration_time: Option<i64>
    device_label: String
    user_agent: Option<String>
    standalone: Bool
    created_at_ms: u64
    updated_at_ms: u64

struct StoredMobilePushState:
    version: u32
    private_key_base64url: String
    subscriptions: Array<StoredMobilePushSubscription>

struct MobilePushNotificationEnvelope:
    title: String
    body: String
    tag: String
    require_interaction: Bool
    badge_count: Option<u32>
    data: MobilePushNotificationData

struct MobilePushNotificationData:
    url: String
    relative_path: String
    parent_path: String
    display_name: String
    kind: String

fn now_epoch_ms() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_millis() as u64).unwrap_or(0)

fn normalize_mobile_push_endpoint(value: String) -> Result<String, String>:
    let trimmed = value.trim()
    if trimmed.is_empty():
        return Result::Err("Push subscription endpoint is missing.".to_string())
    let parsed = Url__parse(trimmed).map_err(|error| format!("Invalid push subscription endpoint: {error}"))?
    match parsed.scheme():
        "https" => Result::Ok(parsed.to_string())
        _ => Result::Err("Push subscription endpoint must use HTTPS.".to_string())

fn normalize_mobile_push_key(value: String, label: String) -> Result<String, String>:
    let trimmed = value.trim()
    if trimmed.is_empty():
        return Result::Err(format!("Push subscription {label} key is missing."))
    Result::Ok(trimmed.to_string())

fn normalize_mobile_push_device_label(value: Option<String>) -> String:
    let trimmed = value.unwrap_or_default().trim()
    if trimmed.is_empty():
        "Paired iPhone".to_string()
    else:
        trimmed.to_string()

fn build_mobile_push_state_directory(app_handle: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    let app_data_dir = app_handle.path().app_data_dir().map_err(|error| format!("Failed to resolve app data directory: {error}"))?
    Result::Ok(app_data_dir.join(MOBILE_PUSH_DIRECTORY_NAME))

fn build_mobile_push_state_path(app_handle: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    Result::Ok((build_mobile_push_state_directory(app_handle)?).join(MOBILE_PUSH_REGISTRY_FILE_NAME))

fn generate_mobile_push_private_key_base64url() -> String:
    let secret_key = SecretKey__random(&mut rand__rngs__OsRng)
    base64__engine__general_purpose__URL_SAFE_NO_PAD.encode(secret_key.to_bytes())

fn create_mobile_push_partial_signature_builder(private_key_base64url: String) -> Result<web_push::PartialVapidSignatureBuilder, String>:
    VapidSignatureBuilder__from_base64_no_sub(private_key_base64url).map_err(|error| format!("Failed to initialize the mobile push VAPID signer: {error}"))

fn create_mobile_push_public_key(private_key_base64url: String) -> Result<String, String>:
    let builder = create_mobile_push_partial_signature_builder(private_key_base64url)?
    Result::Ok(base64__engine__general_purpose__URL_SAFE_NO_PAD.encode(builder.get_public_key()))

fn persist_mobile_push_state(app_handle: &tauri::AppHandle, state: &StoredMobilePushState) -> Result<(), String>:
    let state_directory = build_mobile_push_state_directory(app_handle)?
    std__fs__create_dir_all(&state_directory).map_err(|error| format!("Failed to create the mobile push data directory: {error}"))?
    ()
    let state_path = state_directory.join(MOBILE_PUSH_REGISTRY_FILE_NAME)
    let serialized = serde_json__to_vec_pretty(state).map_err(|error| format!("Failed to encode the mobile push registry: {error}"))?
    std__fs__write(&state_path, serialized).map_err(|error| format!("Failed to write the mobile push registry: {error}"))

fn load_mobile_push_state_from_disk(app_handle: &tauri::AppHandle) -> Result<StoredMobilePushState, String>:
    let state_path = build_mobile_push_state_path(app_handle)?
    if !state_path.exists():
        let state = StoredMobilePushState { version: MOBILE_PUSH_STATE_VERSION, private_key_base64url: generate_mobile_push_private_key_base64url(), subscriptions: Vec__new_() }
        persist_mobile_push_state(app_handle, &state)?
        ()
        return Result::Ok(state)
    let bytes = std__fs__read(&state_path).map_err(|error| format!("Failed to read the mobile push registry: {error}"))?
    let mut state: StoredMobilePushState = serde_json__from_slice(&bytes).map_err(|error| format!("Failed to decode the mobile push registry: {error}"))?
    if state.private_key_base64url.trim().is_empty():
        state.private_key_base64url = generate_mobile_push_private_key_base64url()
        ()
        ()
        ()
        ()
    if state.version != MOBILE_PUSH_STATE_VERSION:
        state.version = MOBILE_PUSH_STATE_VERSION
        ()
        ()
        ()
        ()
    state.subscriptions.retain(|subscription| !subscription.endpoint.trim().is_empty())
    ()
    persist_mobile_push_state(app_handle, &state)?
    ()
    Result::Ok(state)

fn load_mobile_push_state_cached(app_handle: &tauri::AppHandle) -> Result<StoredMobilePushState, String>:
    let mut state_guard = await ACTIVE_MOBILE_PUSH_STATE.lock()
    match state_guard:
        Some(state) =>
            return Result::Ok(state.clone())
        _ =>
            ()
            ()
    let state = load_mobile_push_state_from_disk(app_handle)?
    *state_guard = Option::Some(state.clone())
    ()
    Result::Ok(state)

fn write_mobile_push_state_cached(app_handle: &tauri::AppHandle, next_state: StoredMobilePushState) -> Result<(), String>:
    persist_mobile_push_state(app_handle, &next_state)?
    ()
    let mut state_guard = await ACTIVE_MOBILE_PUSH_STATE.lock()
    *state_guard = Option::Some(next_state)
    ()
    Result::Ok(())

fn summarize_mobile_push_devices(subscriptions: &Slice<StoredMobilePushSubscription>) -> Array<MobilePushPairedDeviceSummary>:
    let mut paired_devices = subscriptions.iter().map(|subscription| MobilePushPairedDeviceSummary { endpoint: subscription.endpoint.clone(), device_label: subscription.device_label.clone(), user_agent: subscription.user_agent.clone(), standalone: subscription.standalone, updated_at_ms: subscription.updated_at_ms }).collect()
    paired_devices.sort_by(|left, right| right.updated_at_ms.cmp(&left.updated_at_ms))
    ()
    paired_devices

fn get_mobile_push_config(app_handle: &tauri::AppHandle) -> Result<MobilePushConfigResponse, String>:
    let state = (await load_mobile_push_state_cached(app_handle))?
    Result::Ok(MobilePushConfigResponse { supported: true, vapid_public_key: create_mobile_push_public_key(&state.private_key_base64url)?, subscription_count: state.subscriptions.len(), paired_devices: summarize_mobile_push_devices(&state.subscriptions) })

fn get_mobile_push_config(app_handle: &tauri::AppHandle) -> Result<MobilePushConfigResponse, String>:
    let state = (await load_mobile_push_state_cached(app_handle))?
    Result::Ok(MobilePushConfigResponse { supported: false, vapid_public_key: String__new_(), subscription_count: state.subscriptions.len(), paired_devices: summarize_mobile_push_devices(&state.subscriptions) })

fn register_mobile_push_subscription(app_handle: &tauri::AppHandle, input: MobilePushSubscriptionInput) -> Result<MobilePushConfigResponse, String>:
    let mut state = (await load_mobile_push_state_cached(app_handle))?
    let endpoint = normalize_mobile_push_endpoint(&input.endpoint)?
    let p256dh = normalize_mobile_push_key(&input.keys.p256dh, "p256dh")?
    let auth = normalize_mobile_push_key(&input.keys.auth, "auth")?
    let now_ms = now_epoch_ms()
    match state.subscriptions.iter_mut().find(|subscription| subscription.endpoint == endpoint):
        Some(existing_subscription) =>
            existing_subscription.p256dh = p256dh
            ()
            existing_subscription.auth = auth
            ()
            existing_subscription.expiration_time = input.expiration_time
            ()
            existing_subscription.device_label = normalize_mobile_push_device_label(input.device_label)
            ()
            existing_subscription.user_agent = input.user_agent.map(str__trim).filter(|value| !value.is_empty()).map(str__to_string)
            ()
            existing_subscription.standalone = input.standalone
            ()
            existing_subscription.updated_at_ms = now_ms
            ()
            ()
            ()
            ()
        _ =>
            state.subscriptions.push(StoredMobilePushSubscription { endpoint: endpoint, p256dh: p256dh, auth: auth, expiration_time: input.expiration_time, device_label: normalize_mobile_push_device_label(input.device_label), user_agent: input.user_agent.map(str__trim).filter(|value| !value.is_empty()).map(str__to_string), standalone: input.standalone, created_at_ms: now_ms, updated_at_ms: now_ms })
            ()
            ()
            ()
            ()
    (await write_mobile_push_state_cached(app_handle, state))?
    ()
    await get_mobile_push_config(app_handle)

fn unregister_mobile_push_subscription(app_handle: &tauri::AppHandle, endpoint: String) -> Result<MobilePushConfigResponse, String>:
    let mut state = (await load_mobile_push_state_cached(app_handle))?
    let normalized_endpoint = normalize_mobile_push_endpoint(endpoint)?
    state.subscriptions.retain(|subscription| subscription.endpoint != normalized_endpoint)
    ()
    (await write_mobile_push_state_cached(app_handle, state))?
    ()
    await get_mobile_push_config(app_handle)

fn build_mobile_download_relative_path(share_root: &std::path::Path, absolute_path: &std::path::Path) -> Result<String, String>:
    let relative_path = absolute_path.strip_prefix(share_root).map_err(|_| "The requested file is outside the active mobile share root.".to_string())?
    let segments = relative_path.components().filter_map(
        |component| match component_:
            path::Component::Normal(value) => Option::Some(value.to_string_lossy().to_string())
            _ => none
    ).collect()
    if segments.is_empty():
        return Result::Err("The selected path is not a downloadable file inside the current mobile share.".to_string())
    Result::Ok(segments.join("/"))

fn build_mobile_download_open_url(share_url: String, relative_path: String) -> Result<String, String>:
    let mut url = Url__parse(share_url).map_err(|error| format!("Invalid active mobile share URL: {error}"))?
    let display_name = Path__new_(relative_path).file_name().map(|value| value.to_string_lossy().to_string()).unwrap_or_else(|| "file".to_string())
    let parent_path = Path__new_(relative_path).parent().and_then(|value| value.to_str()).unwrap_or_default().replace("\\", "/")
    let mut query = url.query_pairs_mut()
    query.clear()
    ()
    query.append_pair("tab", "transfers")
    ()
    if !parent_path.is_empty():
        query.append_pair("path", &parent_path)
        ()
        ()
        ()
        ()
    query.append_pair("intent", "push-download")
    ()
    query.append_pair("download", relative_path)
    ()
    query.append_pair("downloadName", &display_name)
    ()
    ()
    ()
    ()
    Result::Ok(url.to_string())

fn send_mobile_push_notification_payload(app_handle: &tauri::AppHandle, payload: &MobilePushNotificationEnvelope) -> Result<MobilePushDispatchResult, String>:
    let state = (await load_mobile_push_state_cached(app_handle))?
    if state.subscriptions.is_empty():
        return Result::Err("No paired iPhone notifications are registered yet. Open the mobile app and enable notifications first.".to_string())
    let client = IsahcWebPushClient__new_().map_err(|error| format!("Failed to initialize the mobile push client: {error}"))?
    let payload_bytes = serde_json__to_vec(payload).map_err(|error| format!("Failed to encode the mobile push payload: {error}"))?
    let mut delivered_count = 0
    let mut failed_count = 0
    for subscription in &state.subscriptions:
        let subscription_info = SubscriptionInfo__new_(&subscription.endpoint, &subscription.p256dh, &subscription.auth)
        let mut signature_builder = VapidSignatureBuilder__from_base64(&state.private_key_base64url, &subscription_info).map_err(|error| format!("Failed to prepare the mobile push signature: {error}"))?
        signature_builder.add_claim("sub", MOBILE_PUSH_DEFAULT_CONTACT_CLAIM)
        ()
        let signature = signature_builder.build().map_err(|error| format!("Failed to build the mobile push signature: {error}"))?
        let mut message_builder = WebPushMessageBuilder__new_(&subscription_info)
        message_builder.set_ttl(120)
        ()
        message_builder.set_urgency(web_push::Urgency::High)
        ()
        message_builder.set_payload(web_push::ContentEncoding::Aes128Gcm, &payload_bytes)
        ()
        message_builder.set_vapid_signature(signature)
        ()
        let message = message_builder.build().map_err(|error| format!("Failed to build the mobile push message: {error}"))?
        match await client.send_(message):
            Ok(()) =>
                delivered_count = delivered_count + 1
                ()
            Err(error) =>
                failed_count = failed_count + 1
                ()
                log::warn!("GreebleFS mobile push: failed to deliver to {}: {}", subscription.device_label, error)
    ()
    Result::Ok(MobilePushDispatchResult { delivered_count: delivered_count, failed_count: failed_count, subscription_count: state.subscriptions.len() })

fn send_mobile_download_notification(app_handle: &tauri::AppHandle, request: MobilePushDownloadNotificationRequest) -> Result<MobilePushDispatchResult, String>:
    let active_server = await types__ACTIVE_SERVER.lock()
    let Some(active_server) = active_server
    if active_server.file_hub.is_some():
        return Result::Err("Send to iPhone currently needs a directory-based mobile share, not a multi-file hub.".to_string())
    let absolute_path = PathBuf__from(request.absolute_path.trim())
    if !absolute_path.is_file():
        return Result::Err("The selected path is not a regular file.".to_string())
    let relative_path = build_mobile_download_relative_path(&active_server.share_path, &absolute_path)?
    let open_url = build_mobile_download_open_url(&request.share_url, &relative_path)?
    let display_name = absolute_path.file_name().map(|value| value.to_string_lossy().to_string()).unwrap_or_else(|| "file".to_string())
    let parent_path = Path__new_(&relative_path).parent().and_then(|value| value.to_str()).unwrap_or_default().replace("\\", "/")
    let payload = MobilePushNotificationEnvelope { title: format!("Download {display_name}"), body: "Tap to pull it from your paired GreebleFS desktop now.".to_string(), tag: format!("download:{}", relative_path.replace("/", ":")), require_interaction: true, badge_count: Option::Some(1), data: MobilePushNotificationData { url: open_url, relative_path: relative_path, parent_path: parent_path, display_name: display_name, kind: "download".to_string() } }
    await send_mobile_push_notification_payload(app_handle, &payload)

fn send_mobile_download_notification(_app_handle: &tauri::AppHandle, _request: MobilePushDownloadNotificationRequest) -> Result<MobilePushDispatchResult, String>:
    Result::Err("Mobile push notifications are not supported on Windows in this build.".to_string())

enum ShareRemoteAccessMode:
    Lan
    Tailscale

fn normalize_remote_access_mode(value: Option<String>) -> ShareRemoteAccessMode:
    match value.map(str__trim):
        Some("tailscale") => ShareRemoteAccessMode::Tailscale
        _ => ShareRemoteAccessMode::Lan

fn resolve_preferred_share_address(remote_access_mode: ShareRemoteAccessMode, address: String, local_https_address: Option<String>, ios_address: Option<String>, mdns_address: Option<String>, tailscale_address: Option<String>) -> String:
    match remote_access_mode:
        ShareRemoteAccessMode::Tailscale => tailscale_address.cloned().or_else(|| address.starts_with("http://").then(|| address.to_string())).or_else(|| local_https_address.cloned()).or_else(|| mdns_address.map(|host| network__format_http_url(host, types__HTTP_DEFAULT_PORT))).unwrap_or_else(|| address.to_string())
        ShareRemoteAccessMode::Lan => Option::Some(address.to_string()).filter(|address| !address.contains("127.0.0.1")).or_else(|| local_https_address.cloned()).or_else(|| ios_address.cloned()).or_else(|| mdns_address.map(|host| network__format_http_url(host, types__HTTP_DEFAULT_PORT))).unwrap_or_else(|| address.to_string())

fn start_lan_share(app_handle: tauri::AppHandle, path: String, share_mode: String, hub_paths: Option<Array<String>>, remote_access_mode: Option<String>) -> Result<LanShareResult, String>:
    (await stop_lan_share_inner())?
    ()
    let hub_paths = hub_paths.filter(|paths| paths.len() >= 2)
    let remote_access_mode = normalize_remote_access_mode(remote_access_mode)
    let state = match hub_paths:
        Some(paths) =>
            if share_mode != "stream" and share_mode != "mobile":
                return Result::Err("Multi-file share requires stream or mobile mode".into())
            let canonical = streaming__canonicalize_hub_paths(&paths)?
            let share_path = (canonical[0].parent().ok_or_else(|| "Invalid hub path".to_string())?).to_path_buf()
            ShareState { app_handle: app_handle.clone(), share_path: share_path, file_hub: Option::Some(canonical) }
        _ =>
            let share_path = PathBuf__from(&path)
            if !share_path.exists():
                return Result::Err("Path does not exist".into())
            ShareState { app_handle: app_handle.clone(), share_path: share_path, file_hub: none }
    let local_ip = match network__get_local_ipv4():
        Ok(ip) => Option::Some(ip)
        Err(error) if remote_access_mode == ShareRemoteAccessMode::Tailscale => none
        Err(error_2) => return Result::Err(error_2)
    let http_port = network__find_available_port(types__HTTP_DEFAULT_PORT, &[])?
    let tailscale_target = match remote_access_mode:
        ShareRemoteAccessMode::Tailscale => Option::Some(tailscale_commands__get_tailscale_share_target()?)
        ShareRemoteAccessMode::Lan => none
    let is_directory = state.share_path.is_dir()
    let router = match share_mode.as_str():
        "stream" if state.file_hub.is_some() => handlers__build_stream_dir_router(state.clone())
        "stream" if is_directory => handlers__build_stream_dir_router(state.clone())
        "stream" => handlers__build_stream_router(state.clone())
        "ftp" => handlers__build_ftp_router(state.clone())
        "mobile" if state.file_hub.is_some() => mobile__build_mobile_router(state.clone())
        "mobile" if is_directory => mobile__build_mobile_router(state.clone())
        "mobile" => return Result::Err("Mobile share requires a directory or a multi-file hub".to_string())
        _ => return Result::Err(format!("Unknown share mode: {share_mode}"))
    let https_router = router.clone()
    let (http_shutdown_tx, mut http_shutdown_rx) = tokio__sync__watch__channel(false)
    let http_addr = SocketAddr__from(([0, 0, 0, 0], http_port))
    let http_listener = (await TcpListener__bind(http_addr)).map_err(|err| format!("Failed to bind HTTP port {http_port}: {err}"))?
    let http_task = tokio__spawn_(
        async:
            (await axum__serve(http_listener, router).with_graceful_shutdown(
                async:
                    while (await http_shutdown_rx.changed()).is_ok():
                        if *http_shutdown_rx.borrow():
                            break
            )).ok()
            ()
    )
    let (https_handle, https_task, local_https_address) = match network__find_available_port(types__HTTPS_DEFAULT_PORT, &[http_port]):
        Ok(https_port) =>
            let tls_result = match (remote_access_mode, local_ip):
                (ShareRemoteAccessMode::Lan, Some(local_ip)) =>
                    await tls__generate_self_signed_tls(local_ip)
                _ => Result::Err("No HTTPS certificate could be generated for the active mobile share.".to_string())
            match tls_result:
                Ok(tls_config) =>
                    let handle = Handle__new_()
                    let shutdown_handle = handle.clone()
                    let https_addr = SocketAddr__from(([0, 0, 0, 0], https_port))
                    let local_https_address = match (remote_access_mode, local_ip):
                        (ShareRemoteAccessMode::Lan, Some(local_ip)) =>
                            Option::Some(network__format_https_url(&local_ip.to_string(), https_port))
                        _ => none
                    let task = tokio__spawn_(
                        async:
                            (await axum_server__bind_rustls(https_addr, tls_config).handle(handle).serve(https_router.into_make_service())).ok()
                            ()
                    )
                    (Option::Some((shutdown_handle, https_port)), Option::Some(task), local_https_address)
                Err(err) =>
                    log::warn!("TLS setup failed (HTTP still works): {err}")
                    (none, none, none)
        Err(_) => (none, none, none)
    let mdns_daemon = match local_ip:
        Some(local_ip) =>
            match mdns__register_mdns(http_port, local_ip):
                Ok(daemon) => Option::Some(daemon)
                Err(err) =>
                    log::warn!("mDNS registration failed (sharing still works via IP): {err}")
                    none
        None => none
    let has_mdns = mdns_daemon.is_some()
    let mdns_address = if has_mdns:
        Option::Some(network__format_host_port(types__MDNS_DOMAIN, http_port))
    else:
        none
    let ios_address = match (remote_access_mode, &https_handle, has_mdns, local_ip):
        (ShareRemoteAccessMode::Lan, Some((_, https_port)), true, _) =>
            Option::Some(network__format_https_url(types__MDNS_DOMAIN, *https_port))
        (ShareRemoteAccessMode::Lan, Some((_, https_port)), false, Some(local_ip)) =>
            Option::Some(network__format_https_url(&local_ip.to_string(), *https_port))
        _ => local_https_address.clone()
    let tailscale_address = tailscale_target.map(|target| network__format_http_url(&target.preferred_host, http_port))
    let mut server_lock = await types__ACTIVE_SERVER.lock()
    *server_lock = Option::Some(ActiveServer { http_shutdown: http_shutdown_tx, http_task: http_task, https_handle: https_handle.map(|__kain_closure_arg0| __kain_closure_arg0.__kain_tuple_0), https_task: https_task, mdns_daemon: mdns_daemon, share_path: state.share_path.clone(), file_hub: state.file_hub.clone() })
    ()
    let address = match local_ip:
        Some(local_ip) => network__format_http_url(&local_ip.to_string(), http_port)
        None => tailscale_address.clone().unwrap_or_else(|| network__format_http_url("127.0.0.1", http_port))
    let preferred_address = resolve_preferred_share_address(remote_access_mode, &address, local_https_address, ios_address, mdns_address, tailscale_address)
    Result::Ok(LanShareResult { address: address, preferred_address: preferred_address, mdns_address: mdns_address, ios_address: ios_address, tailscale_address: tailscale_address, tailscale_https_ready: false })

fn stop_lan_share_inner() -> Result<(), String>:
    let mut server_lock = await types__ACTIVE_SERVER.lock()
    match server_lock.take():
        Some(server) =>
            let _ = server.http_shutdown.send_(true)
            match server.https_handle:
                Some(handle) =>
                    handle.graceful_shutdown(Option::Some(Duration__from_secs(2)))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match server.mdns_daemon:
                Some(daemon) =>
                    mdns__unregister_mdns(daemon)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            let _ = await server.http_task
            match server.https_task:
                Some(task) =>
                    let _ = await task
                    ()
                _ =>
                    ()
                    ()
            await tokio__time__sleep(Duration__from_millis(50))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn get_local_ip() -> Result<String, String>:
    network__get_local_ipv4().map(|ip| ip.to_string())

fn share_root_label(share_path: &std::path::Path) -> String:
    share_path.file_name().map(|name| name.to_string_lossy().into_owned()).filter(|label| !label.is_empty()).or_else(|| share_path.canonicalize().ok().and_then(|canonical| canonical.file_name().map(|name| name.to_string_lossy().into_owned()).filter(|label| !label.is_empty()))).unwrap_or_else(|| "Shared".to_string())

fn canonicalize_hub_paths(paths: &Slice<String>) -> Result<Array<std::path::PathBuf>, String>:
    let mut seen: Set<std::path::PathBuf> = HashSet__new_()
    let mut out_: Array<std::path::PathBuf> = Vec__new_()
    for path_str in paths:
        let path = PathBuf__from(path_str)
        if !path.exists():
            return Result::Err(format!("Path does not exist: {path_str}"))
        let canonical = path.canonicalize().map_err(|_| format!("Failed to resolve path: {path_str}"))?
        if !canonical.is_file():
            return Result::Err("Multi-file share requires files only".into())
        if seen.insert(canonical.clone()):
            out_.push(canonical)
            ()
    ()
    if out_.len() < 2:
        return Result::Err("Select at least two files for multi-file share".into())
    Result::Ok(out_)

fn resolve_sub_path(base: &std::path::Path, requested: Option<String>) -> Result<std::path::PathBuf, axum::http::StatusCode>:
    let resolved = match requested:
        Some(sub) if !sub.is_empty() =>
            let decoded = urlencoding__decode(sub).map_err(|_| axum::http::StatusCode::BAD_REQUEST)?
            base.join(decoded)
        _ => base.to_path_buf()
    let canonical_base = base.canonicalize().map_err(|_| axum::http::StatusCode::NOT_FOUND)?
    let canonical_resolved = resolved.canonicalize().map_err(|_| axum::http::StatusCode::NOT_FOUND)?
    if !canonical_resolved.starts_with(&canonical_base):
        return Result::Err(axum::http::StatusCode::FORBIDDEN)
    Result::Ok(canonical_resolved)

fn build_content_disposition(file_name: String) -> axum::http::HeaderValue:
    let encoded = urlencoding__encode(file_name)
    let value = format!("inline; filename*=UTF-8''{encoded}")
    HeaderValue__from_str(&value).unwrap_or_else(|_| HeaderValue__from_static("inline"))

fn sanitize_upload_filename(raw_name: String) -> Option<String>:
    let name = (Path__new_(raw_name).file_name()?).to_string_lossy().to_string()
    if name.is_empty():
        return none
    Option::Some(name)

fn parse_range_header(range_value: Option<&axum::http::HeaderValue>, total_size: u64) -> Option<(u64, u64)>:
    let range_str = (range_value?).to_str().ok()?
    let byte_range = range_str.strip_prefix("bytes=")?
    if byte_range.contains(","):
        return none
    let mut parts = byte_range.splitn(2, "-")
    let start_str = (parts.next()?).trim()
    let end_str = (parts.next()?).trim()
    if total_size == 0:
        return none
    if start_str.is_empty():
        let suffix_length: u64 = end_str.parse().ok()?
        if suffix_length == 0:
            return none
        let start = total_size.saturating_sub(suffix_length)
        return Option::Some((start, total_size - 1))
    let start: u64 = start_str.parse().ok()?
    if start >= total_size:
        return none
    let end = if end_str.is_empty():
        total_size - 1
    else:
        (end_str.parse().ok()?).min(total_size - 1)
    if start > end:
        return none
    Option::Some((start, end))

fn stream_file_response(path: &std::path::Path, request_headers: &axum::http::HeaderMap) -> axum::response::Response:
    let mime = mime_guess__from_path(path).first_or_octet_stream().to_string()
    let file_name = path.file_name().unwrap_or_default().to_string_lossy().to_string()
    let file = match await File__open(path):
        Ok(file) => file
        Err(_) =>
            return (axum::http::StatusCode::INTERNAL_SERVER_ERROR, "Failed to read file").into_response()
    let metadata = match await file.metadata():
        Ok(metadata) => metadata
        Err(_) =>
            return (axum::http::StatusCode::INTERNAL_SERVER_ERROR, "Failed to read file").into_response()
    let total_size = metadata.len()
    let content_disposition = build_content_disposition(&file_name)
    let content_type = HeaderValue__from_str(&mime).unwrap()
    match parse_range_header(request_headers.get(axum__http__header__RANGE), total_size):
        Some((range_start, range_end)) =>
            let length = range_end - range_start + 1
            let mut file = file
            if (await file.seek(io::SeekFrom::Start(range_start))).is_err():
                return (axum::http::StatusCode::INTERNAL_SERVER_ERROR, "Failed to seek file").into_response()
            let limited = file.take(length)
            let stream = ReaderStream__new_(limited)
            let body = Body__from_stream(stream)
            let content_range = format!("bytes {range_start}-{range_end}/{total_size}")
            Response__builder().status(axum::http::StatusCode::PARTIAL_CONTENT).header(axum__http__header__CONTENT_TYPE, content_type).header(axum__http__header__CONTENT_LENGTH, length.to_string()).header(axum__http__header__CONTENT_RANGE, content_range).header(axum__http__header__ACCEPT_RANGES, "bytes").header(axum__http__header__CONTENT_DISPOSITION, content_disposition).body(body).unwrap_or_else(|_| (axum::http::StatusCode::INTERNAL_SERVER_ERROR, "Failed to build response").into_response())
        _ =>
            let stream = ReaderStream__new_(file)
            let body = Body__from_stream(stream)
            Response__builder().status(axum::http::StatusCode::OK).header(axum__http__header__CONTENT_TYPE, content_type).header(axum__http__header__CONTENT_LENGTH, total_size.to_string()).header(axum__http__header__ACCEPT_RANGES, "bytes").header(axum__http__header__CONTENT_DISPOSITION, content_disposition).body(body).unwrap_or_else(|_| (axum::http::StatusCode::INTERNAL_SERVER_ERROR, "Failed to build response").into_response())

fn generate_self_signed_tls(ip: std::net::Ipv4Addr) -> Result<axum_server::tls_rustls::RustlsConfig, String>:
    let _ = rustls__crypto__ring__default_provider().install_default()
    let mut params = CertificateParams__new_(vec!(types__MDNS_DOMAIN.to_string())).map_err(|err| format!("Failed to create cert params: {err}"))?
    params.subject_alt_names.push(rcgen::SanType::IpAddress(std::net::IpAddr::V4(ip)))
    ()
    let key_pair = KeyPair__generate().map_err(|err| format!("Failed to generate key pair: {err}"))?
    let cert = params.self_signed(&key_pair).map_err(|err| format!("Failed to generate self-signed cert: {err}"))?
    let cert_der = cert.der().to_vec()
    let key_der = key_pair.serialize_der()
    (await RustlsConfig__from_der(vec!(cert_der), key_der)).map_err(|err| format!("Failed to create TLS config: {err}"))

struct ShareState:
    app_handle: tauri::AppHandle
    share_path: std::path::PathBuf
    file_hub: Option<Array<std::path::PathBuf>>

struct ActiveServer:
    http_shutdown: tokio::sync::watch::Sender<Bool>
    http_task: tokio::task::JoinHandle<()>
    https_handle: Option<axum_server::Handle<std::net::SocketAddr>>
    https_task: Option<tokio::task::JoinHandle<()>>
    mdns_daemon: Option<mdns_sd::ServiceDaemon>
    share_path: std::path::PathBuf
    file_hub: Option<Array<std::path::PathBuf>>

