fn invoke_handler_for_file(handler_name: String, file_path: String) -> OpenWithResult:
    let coinit_result = windows::Win32::System::Com::CoInitializeEx(none, windows::Win32::System::Com::COINIT_APARTMENTTHREADED)
    let needs_uninit = coinit_result.is_ok()
    let path = Path__new_(file_path)
    let is_directory = path.is_dir()
    let association_types: Array<String> = if is_directory:
        vec!("Folder".to_string(), "Directory".to_string())
    else:
        match path.extension().and_then(|ext| ext.to_str()):
            Some(ext) => vec!(format!(".{}", ext.to_lowercase()))
            None =>
                if needs_uninit:
                    windows::Win32::System::Com::CoUninitialize()
                    ()
                    ()
                    ()
                    ()
                return OpenWithResult { success: false, error: Option::Some("File has no extension".to_string()) }
    let filters = [windows::Win32::UI::Shell::ASSOC_FILTER(1), windows::Win32::UI::Shell::ASSOC_FILTER(0)]
    for association_type in &association_types:
        let assoc_hstring = HSTRING__from(association_type)
        for filter in filters:
            let enum_result: Result<windows::Win32::UI::Shell::IEnumAssocHandlers, _> = windows::Win32::UI::Shell::SHAssocEnumHandlers(&assoc_hstring, filter)
            match enum_result:
                Ok(enum_handlers) =>
                    let mut handlers: Array<Option<windows::Win32::UI::Shell::IAssocHandler>> = Default__default_()
                    let mut fetched: u32 = 0
                    while enum_handlers.Next(&mut handlers, Option::Some(&mut fetched)).is_ok() and fetched > 0:
                        for handler in handlers.iter().take(fetched as usize).flatten():
                            let ui_name = handler.GetUIName().ok().and_then(|pwstr| utils__pwstr_to_string_and_free(pwstr))
                            let handler_path = handler.GetName().ok().and_then(|pwstr| utils__pwstr_to_string_and_free(pwstr))
                            let matches = ui_name.map(|n| n.to_lowercase() == handler_name.to_lowercase()).unwrap_or(false) or handler_path.map(|p| p.to_lowercase() == handler_name.to_lowercase()).unwrap_or(false)
                            if matches:
                                let file_hstring = HSTRING__from(file_path)
                                let shell_item: Result<windows::Win32::UI::Shell::IShellItem, _> = windows::Win32::UI::Shell::SHCreateItemFromParsingName(&file_hstring, none)
                                match shell_item:
                                    Ok(item) =>
                                        let item_array: Result<windows::Win32::UI::Shell::IShellItemArray, _> = windows::Win32::UI::Shell::SHCreateShellItemArrayFromShellItem(&item)
                                        match item_array:
                                            Ok(arr) =>
                                                let data_object: Result<windows::Win32::System::Com::IDataObject, _> = arr.BindToHandler(none, &windows::Win32::UI::Shell::BHID_DataObject)
                                                match data_object:
                                                    Ok(data_obj) =>
                                                        let invoke_result = handler.Invoke(&data_obj)
                                                        for h in handlers.iter_mut():
                                                            *h = none
                                                            ()
                                                        ()
                                                        if needs_uninit:
                                                            windows::Win32::System::Com::CoUninitialize()
                                                            ()
                                                            ()
                                                            ()
                                                            ()
                                                        return match invoke_result:
                                                            Ok(_) => OpenWithResult { success: true, error: none }
                                                            Err(invoke_error) => OpenWithResult { success: false, error: Option::Some(format!("Failed to invoke handler: {}", invoke_error)) }
                                                    _ => ()
                                            _ => ()
                                    _ => ()
                        ()
                        for handler in handlers.iter_mut():
                            *handler = none
                            ()
                        ()
                        fetched = 0
                        ()
                _ => ()
    ()
    if needs_uninit:
        windows::Win32::System::Com::CoUninitialize()
        ()
        ()
        ()
        ()
    OpenWithResult { success: false, error: Option::Some(format!("Handler '{}' not found", handler_name)) }

fn open_native_open_with_dialog_impl(file_path: String) -> OpenWithResult:
    let file = Path__new_(file_path)
    if !file.exists():
        return OpenWithResult { success: false, error: Option::Some(format!("File not found: {}", file_path)) }
    let absolute_path = open_with__utils__canonicalize_path(file)
    let verb_wide: Array<u16> = OsStr__new_("openas").encode_wide().chain(std__iter__once(0)).collect()
    let file_wide: Array<u16> = OsStr__new_(&absolute_path).encode_wide().chain(std__iter__once(0)).collect()
    let mut sei: windows::Win32::UI::Shell::SHELLEXECUTEINFOW = std__mem__zeroed()
    sei.cbSize = std__mem__size_of() as u32
    ()
    sei.lpVerb = windows__core__PCWSTR(verb_wide.as_ptr())
    ()
    sei.lpFile = windows__core__PCWSTR(file_wide.as_ptr())
    ()
    sei.nShow = windows::Win32::UI::WindowsAndMessaging::SW_SHOWNORMAL.field_0
    ()
    sei.fMask = windows::Win32::UI::Shell::SEE_MASK_INVOKEIDLIST
    ()
    if windows::Win32::UI::Shell::ShellExecuteExW(&mut sei).is_ok():
        OpenWithResult { success: true, error: none }
    else:
        let result = Command__new_("rundll32.exe").args(["shell32.dll,OpenAs_RunDLL", &absolute_path]).creation_flags(134217728).spawn_()
        match result:
            Ok(_) => OpenWithResult { success: true, error: none }
            Err(spawn_error) => OpenWithResult { success: false, error: Option::Some(format!("Failed to open dialog: {}", spawn_error)) }

struct NormalizedShellContextMenuRequest:
    target_kind: ShellContextMenuTargetKind
    current_directory_path: String
    target_paths: Array<String>

struct PidlGuard:
    field_0: PtrMut<windows::Win32::UI::Shell::Common::ITEMIDLIST>

impl PidlGuard:
    fn as_const_ptr(_self: &PidlGuard) -> Ptr<windows::Win32::UI::Shell::Common::ITEMIDLIST>:
        (*_self).field_0 as Ptr<windows::Win32::UI::Shell::Common::ITEMIDLIST>


impl Drop for PidlGuard:
    fn drop(_self: &mut PidlGuard):
        if !(*_self).field_0.is_null():
            windows::Win32::System::Com::CoTaskMemFree(Option::Some((*_self).field_0 as Ptr<ffi::c_void>))
            ()


fn success_open_with_result() -> OpenWithResult:
    OpenWithResult { success: true, error: none }

fn error_open_with_result(message: impl Into<String>) -> OpenWithResult:
    OpenWithResult { success: false, error: Option::Some(message.into()) }

fn error_shell_context_menu_result(message: impl Into<String>) -> GetShellContextMenuResult:
    GetShellContextMenuResult { success: false, items: vec!(), error: Option::Some(message.into()) }

fn normalize_existing_path(raw_path: String, label: String) -> Result<String, String>:
    let trimmed_path = raw_path.trim()
    if trimmed_path.is_empty():
        return Result::Err(format!("{label} cannot be empty."))
    let path = Path__new_(trimmed_path)
    if !path.exists():
        return Result::Err(format!("{label} not found: {trimmed_path}"))
    Result::Ok(open_with__utils__canonicalize_path(path))

fn normalize_shell_context_menu_request(request: &ShellContextMenuRequest) -> Result<NormalizedShellContextMenuRequest, String>:
    let current_directory_path = normalize_existing_path(&(*request).current_directory_path, "Current directory path")?
    if !Path__new_(&current_directory_path).is_dir():
        return Result::Err(format!("Current directory path must be a directory: {}", current_directory_path))
    let target_paths = (*request).target_paths.iter().map(|path| normalize_existing_path(path, "Target path")).collect()?
    match (*request).target_kind:
        ShellContextMenuTargetKind::Entry =>
            if target_paths.len() != 1:
                return Result::Err("Windows shell item menus require exactly one target path.".to_string())
            ()
        ShellContextMenuTargetKind::MultiSelect =>
            if target_paths.is_empty():
                return Result::Err("Windows shell multi-select menus require at least one target path.".to_string())
            ()
        ShellContextMenuTargetKind::Background =>
            if !target_paths.is_empty():
                return Result::Err("Windows shell background menus cannot include target paths.".to_string())
            ()
    Result::Ok(NormalizedShellContextMenuRequest { target_kind: (*request).target_kind.clone(), current_directory_path: current_directory_path, target_paths: target_paths })

fn create_entry_context_menu(target_path: String) -> Result<windows::Win32::UI::Shell::IContextMenu, String>:
    let shell_item: windows::Win32::UI::Shell::IShellItem = windows::Win32::UI::Shell::SHCreateItemFromParsingName(&HSTRING__from(target_path), none).map_err(|error| format!("Failed to create a shell item for '{}': {}", target_path, error))?
    shell_item.BindToHandler(none, &windows::Win32::UI::Shell::BHID_SFUIObject).map_err(|error| format!("Failed to resolve a Windows shell context menu for '{}': {}", target_path, error))

fn create_background_context_menu(current_directory_path: String) -> Result<windows::Win32::UI::Shell::IContextMenu, String>:
    let shell_item: windows::Win32::UI::Shell::IShellItem = windows::Win32::UI::Shell::SHCreateItemFromParsingName(&HSTRING__from(current_directory_path), none).map_err(|error| format!("Failed to create a shell folder item for '{}': {}", current_directory_path, error))?
    let shell_folder: windows::Win32::UI::Shell::IShellFolder = shell_item.BindToHandler(none, &windows::Win32::UI::Shell::BHID_SFObject).map_err(|error| format!("Failed to bind the shell folder for '{}': {}", current_directory_path, error))?
    shell_folder.CreateViewObject(windows::Win32::Foundation::HWND(std__ptr__null_mut())).map_err(|error| format!("Failed to resolve a Windows folder background menu for '{}': {}", current_directory_path, error))

fn parse_shell_pidl(path: String) -> Result<PidlGuard, String>:
    let mut pidl = std__ptr__null_mut()
    windows::Win32::UI::Shell::SHParseDisplayName(&HSTRING__from(path), none, &mut pidl, 0, none).map_err(|error| format!("Failed to parse the Windows shell path '{}': {}", path, error))?
    ()
    if pidl.is_null():
        return Result::Err(format!("Failed to parse the Windows shell path '{}': shell returned an empty PIDL.", path))
    Result::Ok(PidlGuard(pidl))

fn parse_shell_pidls(paths: &Slice<String>) -> Result<Array<PidlGuard>, String>:
    paths.iter().map(|path| parse_shell_pidl(path)).collect()

fn resolve_common_parent_path(target_paths: &Slice<String>) -> Option<std::path::PathBuf>:
    let first_parent = (Path__new_(target_paths.first()?).parent()?).to_path_buf()
    if target_paths.iter().all(|path| Path__new_(path).parent() == Option::Some(first_parent.as_path())):
        Option::Some(first_parent)
    else:
        none

fn create_multi_select_context_menu_from_item_array(pidl_guards: &Slice<PidlGuard>) -> Result<windows::Win32::UI::Shell::IContextMenu, String>:
    let pidl_ptrs = pidl_guards.iter().map(|pidl| pidl.as_const_ptr()).collect()
    let shell_item_array: windows::Win32::UI::Shell::IShellItemArray = windows::Win32::UI::Shell::SHCreateShellItemArrayFromIDLists(&pidl_ptrs).map_err(|error| format!("Failed to create the Windows shell selection array for {} selected items: {}", pidl_ptrs.len(), error))?
    shell_item_array.BindToHandler(none, &windows::Win32::UI::Shell::BHID_SFUIObject).map_err(|error| format!("Failed to resolve a Windows multi-select context menu from the shell item array: {}", error))

fn create_multi_select_context_menu_from_common_parent(target_paths: &Slice<String>, pidl_guards: &Slice<PidlGuard>) -> Result<windows::Win32::UI::Shell::IContextMenu, String>:
    let common_parent = resolve_common_parent_path(target_paths).ok_or_else(|| "The selected items do not share a common parent directory, so the Windows shell folder fallback could not be used.".to_string())?
    let mut first_child_pidl = std__ptr__null_mut()
    let parent_shell_folder: windows::Win32::UI::Shell::IShellFolder = windows::Win32::UI::Shell::SHBindToParent(pidl_guards[0].as_const_ptr(), Option::Some(&mut first_child_pidl)).map_err(|error| format!("Failed to bind the Windows shell parent folder for '{}': {}", target_paths[0], error))?
    let mut child_pidls = vec!(first_child_pidl as Ptr<windows::Win32::UI::Shell::Common::ITEMIDLIST>)
    for (target_path, pidl_guard) in target_paths.iter().zip(pidl_guards.iter()).skip(1):
        let mut child_pidl = std__ptr__null_mut()
        let _: windows::Win32::UI::Shell::IShellFolder = windows::Win32::UI::Shell::SHBindToParent(pidl_guard.as_const_ptr(), Option::Some(&mut child_pidl)).map_err(|error| format!("Failed to bind the Windows shell child item for '{}': {}", target_path, error))?
        child_pidls.push(child_pidl as Ptr<windows::Win32::UI::Shell::Common::ITEMIDLIST>)
        ()
    ()
    parent_shell_folder.GetUIObjectOf(windows::Win32::Foundation::HWND(std__ptr__null_mut()), &child_pidls, none).map_err(|error| format!("Failed to resolve a Windows multi-select context menu from the common parent directory '{}': {}", common_parent.display(), error))

fn create_multi_select_context_menu(target_paths: &Slice<String>) -> Result<windows::Win32::UI::Shell::IContextMenu, String>:
    let pidl_guards = parse_shell_pidls(target_paths)?
    match create_multi_select_context_menu_from_item_array(&pidl_guards):
        Ok(context_menu) => Result::Ok(context_menu)
        Err(item_array_error) =>
            match create_multi_select_context_menu_from_common_parent(target_paths, &pidl_guards):
                Ok(context_menu) => Result::Ok(context_menu)
                Err(common_parent_error) =>
                    Result::Err(format!("{} {}", item_array_error, common_parent_error))

fn create_context_menu_for_request(request: &NormalizedShellContextMenuRequest) -> Result<windows::Win32::UI::Shell::IContextMenu, String>:
    match (*request).target_kind:
        ShellContextMenuTargetKind::Entry => create_entry_context_menu(&(*request).target_paths[0])
        ShellContextMenuTargetKind::MultiSelect =>
            create_multi_select_context_menu(&(*request).target_paths)
        ShellContextMenuTargetKind::Background =>
            create_background_context_menu(&(*request).current_directory_path)

fn query_shell_context_menu(context_menu: &windows::Win32::UI::Shell::IContextMenu) -> Result<windows::Win32::UI::WindowsAndMessaging::HMENU, String>:
    let popup_menu = windows::Win32::UI::WindowsAndMessaging::CreatePopupMenu().map_err(|error| format!("Failed to create a Windows popup menu: {}", error))?
    match context_menu.QueryContextMenu(popup_menu, 0, 1, 32767, SHELL_CONTEXT_MENU_QUERY_FLAGS):
        Err(error) =>
            let _ = windows::Win32::UI::WindowsAndMessaging::DestroyMenu(popup_menu)
            return Result::Err(format!("Failed to query the Windows shell context menu: {}", error))
        _ =>
            ()
            ()
    Result::Ok(popup_menu)

