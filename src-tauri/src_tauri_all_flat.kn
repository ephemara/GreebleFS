    path: Option<String>

fn configured_kain_runtime_command() -> Option<std::path::PathBuf>:
    for env_name in ["GREEBLEFS_KAIN_EXE", "KAIN_EXE"]:
        match std__env__var_(env_name):
            Ok(value) =>
                let trimmed = value.trim()
                if !trimmed.is_empty():
                    return Option::Some(PathBuf__from(trimmed))
            _ => ()
    ()
    let toolchain_context = RuntimeToolchainContext__default_()
    match runtime_pipeline__toolchain__resolve_kain_payload_root(&toolchain_context):
        Some(payload_root) =>
            let payload_executable = payload_root.join("bin").join(runtime_pipeline__toolchain__kain_executable_name())
            if payload_executable.exists():
                return Option::Some(payload_executable)
            ()
        _ =>
            ()
            ()
    Option::Some(PathBuf__from("kain"))

fn supports_kain_bridge_serve(command_path: &std::path::Path) -> Bool:
    Command__new_(command_path).arg("bridge").arg("serve").arg("--help").stdin(Stdio__null()).stdout(Stdio__null()).stderr(Stdio__null()).status().map(|status| status.success()).unwrap_or(false)

fn kain_ui_runtime_config() -> tauri_plugin_kain::KainRuntimeProcessConfig:
    let mut config = tauri_plugin_kain::KainRuntimeProcessConfig { dispatch_function: "kain_bridge_dispatch".into(), restart_on_reload: true, ..Default__default_() }
    let Some(command_path) = configured_kain_runtime_command()
    if supports_kain_bridge_serve(&command_path):
        config.command = Option::Some(command_path)
        ()
        config.entry = Option::Some("src-kain/app/main.kn".into())
        ()
        ()
        ()
        ()
    else:
        config.enabled = false
        ()
        eprintln!("GreebleFS: Kain bridge runtime disabled because `{}` does not support `bridge serve`.", command_path.display())
        ()
        ()
    config

fn run():
    linux_graphics__apply_linux_graphics_startup_configuration()
    ()
    let builder = specta_bindings__app_specta_builder()
    let specta_invoke_handler = builder.invoke_handler()
    let transport_invoke_handler: fn(tauri::ipc::Invoke<tauri::Wry>) -> Bool = tauri::generate_handler!(fs_commands__fs_read_preview_bytes, fs_commands__fs_read_archive_entry_preview_bytes, cloud_commands__cloud_read_preview_bytes, remote_storage_commands__remote_read_preview_bytes, runtime_pipeline__commands__runtime_read_artifact_bytes, global_search__query__global_search_query_under_path)
    let invoke_handler = fn(invoke: tauri::ipc::Invoke<tauri::Wry>): match invoke.message.command():
        "fs_read_preview_bytes" | "fs_read_archive_entry_preview_bytes" | "cloud_read_preview_bytes" | "remote_read_preview_bytes" | "runtime_read_artifact_bytes" | "global_search_query_under_path" => transport_invoke_handler(invoke)
        _ => specta_invoke_handler(invoke)
    Builder__default_().plugin(tauri_plugin_autostart__init(tauri_plugin_autostart::MacosLauncher::LaunchAgent, none)).plugin(Builder__new_().with_filter(|label| secondary_windows__should_window_label_remember_bounds(label)).build()).plugin(tauri_plugin_shell__init()).plugin(Builder__new_().build()).plugin(tauri_plugin_notification__init()).plugin(tauri_plugin_opener__init()).plugin(tauri_plugin_fs__init()).plugin(Builder__default_().runtime(kain_ui_runtime_config()).build()).plugin(tauri_plugin_screenshots__init()).plugin(Builder__default_().build()).setup(
        |app| block:
            builder.mount_events(app)
            ()
            match usr__bootstrap_usr_content(&app.handle()):
                Err(error) =>
                    eprintln!("GreebleFS: failed to bootstrap bundled usr content: {error}")
                    ()
                    ()
                _ =>
                    ()
                    ()
            fs_commands__initialize_fs_command_events(app.handle().clone())
            ()
            tauri__native_buffer_pool__register_native_control_handlers(&app.handle())?
            ()
            fs_commands__register_native_pool_handlers(&app.handle())?
            ()
            explorer_identity__initialize_explorer_identity_store(app.handle())?
            ()
            let gpu_runtime = GpuRuntimeManager__new_(app.handle().clone())
            gpu_runtime__set_global_gpu_runtime(gpu_runtime.clone())
            ()
            app.manage(IpcRuntimeState__from_app(&app.handle()))
            ()
            app.manage(TerminalManager__new_())
            ()
            app.manage(CloudRuntimeState__default_())
            ()
            app.manage(RemoteStorageState__default_())
            ()
            app.manage(SecondaryWindowManagerState__default_())
            ()
            app.manage(AudioEngineManager__default_())
            ()
            app.manage(ExplorerIdentityManager__default_())
            ()
            app.manage(gpu_runtime)
            ()
            app.manage(ImageCutoutManager__default_())
            ()
            app.manage(ImageEditorManager__default_())
            ()
            app.manage(PdfPreviewManager__default_())
            ()
            app.manage(PythonSidecarManager__default_())
            ()
            app.manage(HostEventBusState__from_app(&app.handle()))
            ()
            app.manage(RuntimeFileWatchManager__default_())
            ()
            app.manage(RuntimeTaskProcessManager__default_())
            ()
            app.manage(RuntimeRegistryState__default_())
            ()
            app.manage(ExternalSidecarManager__default_())
            ()
            app.manage(VideoEngineManager__default_())
            ()
            app.manage(VstHostRuntimeManager__default_())
            ()
            app.manage(TelemetryManager__from_app(&app.handle()))
            ()
            app.manage(NativeTaskGraphManager__from_app(&app.handle()))
            ()
            app.manage(PreviewStreamingManager__from_app(&app.handle()))
            ()
            match dev_observatory__initialize_greeblefs_dev_observatory(&app.handle()):
                Err(error) =>
                    eprintln!("GreebleFS: failed to initialize Tauron dev observatory: {error}")
                    ()
                    ()
                _ =>
                    ()
                    ()
            match dev_mcp_native_automation__start_dev_mcp_native_automation_server(&app.handle())?:
                Some(native_automation_server) =>
                    app.manage(native_automation_server)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            let startup_span = telemetry__start_native_span(&app.handle(), "startup", "tauri.setup", BTreeMap__new_())
            entry_size_cache__initialize_entry_size_cache(app.handle())?
            ()
            app.manage(EntrySizeWatcherState__default_())
            ()
            app.manage(PluginWatcherState__default_())
            ()
            match wayland_dock__initialize_wayland_dock_host(&app.handle()):
                Err(error) =>
                    eprintln!("GreebleFS: failed to initialize Wayland dock host: {error}")
                    ()
                    ()
                _ =>
                    ()
                    ()
            url_drop__setup(&app.handle())
            ()
            app.manage(TrayVisibilityState__new_(true))
