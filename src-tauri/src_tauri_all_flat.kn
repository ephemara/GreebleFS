con_rules: Vec__new_(), default_folder_icon: "folder".to_string(), layout: MobileThemeLayoutSnapshot { view_mode: MobileLayoutViewMode::IconsM, grid_zoom: 1.0, interface_scale: 1.08, chrome_scale: 1.08, page_padding: 16, touch_comfort: "comfortable".to_string(), show_hidden_files: false, sort_by: MobileLayoutSortBy::Name, sort_order: MobileLayoutSortOrder::Asc, directories_first: true, show_tab_labels: true }, plugin_settings_by_id: BTreeMap__new_() }


