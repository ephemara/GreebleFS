            ()
    Result::Ok(())

fn fs_plan_transfer_items(target_dir: String, sources: Array<String>, operation: FileTransferOperation) -> Result<Array<FileTransferCollision>, String>:
    let target_dir_path = Path__new_(&target_dir)
    if !target_dir_path.exists():
        return Result::Err(format!("Target directory does not exist: {}", target_dir))
    if !target_dir_path.is_dir():
        return Result::Err(format!("Target path is not a directory: {}", target_dir))
    let mut collisions = Vec__new_()
    for source in sources:
        let source_path = PathBuf__from(&source)
        if !source_path.exists():
            return Result::Err(format!("Source path does not exist: {}", source))
        let Some(file_name) = source_path.file_name()
        let preferred_destination = target_dir_path.join(file_name)
        if preferred_destination == source_path:
            continue
        if !preferred_destination.exists():
            continue
        collisions.push(FileTransferCollision { source_path: source_path.to_string_lossy().to_string(), source_name: file_name.to_string_lossy().to_string(), destination_path: preferred_destination.to_string_lossy().to_string(), operation: operation, destination_exists: true, destination_is_dir: preferred_destination.is_dir() })
        ()
    ()
    Result::Ok(collisions)

fn fs_transfer_items(app: tauri::AppHandle, identity_manager: tauri::State<_, ExplorerIdentityManager>, target_dir: String, sources: Array<String>, operation: FileTransferOperation, collision_policy: Option<FileTransferCollisionPolicy>) -> Result<Array<FileTransferResult>, String>:
    let target_dir_path = Path__new_(&target_dir)
    if !target_dir_path.exists():
        return Result::Err(format!("Target directory does not exist: {}", target_dir))
    if !target_dir_path.is_dir():
        return Result::Err(format!("Target path is not a directory: {}", target_dir))
    let mut results = Vec__new_()
    let resolved_collision_policy = collision_policy.unwrap_or(FileTransferCollisionPolicy::KeepBoth)
    for source in sources:
        let source_path = PathBuf__from(&source)
        if !source_path.exists():
            return Result::Err(format!("Source path does not exist: {}", source))
        let Some(file_name) = source_path.file_name()
        let preferred_destination = target_dir_path.join(file_name)
        let destination = resolve_transfer_destination(preferred_destination.clone(), operation, &source_path, resolved_collision_policy)
        if source_path == destination:
            continue
        if resolved_collision_policy == FileTransferCollisionPolicy::Skip and preferred_destination.exists() and preferred_destination != source_path:
            results.push(build_transfer_result_from_source(&app, &identity_manager, &source_path, &preferred_destination, operation, resolved_collision_policy, FileTransferDisposition::SkippedExisting)?)
            ()
            continue
        validate_transfer_destination(&source_path, &destination, operation)?
        ()
        let continuity_entity_id = if operation == FileTransferOperation::Move:
            let metadata = std__fs__symlink_metadata(&source_path).map_err(|error| format!("Failed to inspect transfer source '{}': {error}", source_path.display()))?
            let is_symlink = metadata.file_type().is_symlink()
            let is_dir = metadata.is_dir()
            let size = if is_dir:
                0
            else:
                metadata.len()
            let modified = metadata_modified_ms(&metadata).unwrap_or(0)
            let content_revision = build_local_entry_content_revision(size, modified, is_dir, is_symlink)
            explorer_identity__prepare_move_operation_continuity(&app, &identity_manager, &source_path, &content_revision)?
        else:
            none
        let operation_result = match operation:
            FileTransferOperation::Copy => await copy_path(&source_path, &destination, true)
            FileTransferOperation::Move => await move_path(&source_path, &destination, true)
        match operation_result:
            Err(error) =>
                return Result::Err(error)
            _ =>
                ()
                ()
        if operation == FileTransferOperation::Move:
            let _ = explorer_identity__apply_move_operation_continuity(&app, &identity_manager, &source_path, &destination, continuity_entity_id)
            ()
        results.push(build_transfer_result_from_destination(&app, &identity_manager, &source_path, &destination, operation, resolved_collision_policy, FileTransferDisposition::Transferred)?)
        ()
    ()
    for result in &results:
        invalidate_all_fs_caches(Path__new_(&result.source_path))
        ()
        invalidate_all_fs_caches(Path__new_(&result.destination_path))
        ()
        match Path__new_(&result.source_path).parent():
            Some(parent) =>
                invalidate_all_fs_caches(parent)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match Path__new_(&result.destination_path).parent():
            Some(parent) =>
                invalidate_all_fs_caches(parent)
                ()
            _ => ()
    ()
    Result::Ok(results)

fn fs_list_explorer_tasks() -> Result<Array<ExplorerTaskRecord>, String>:
    list_explorer_tasks_snapshot()

fn should_clear_explorer_task(scope: ExplorerTaskHistoryClearScope, status: ExplorerTaskStatus) -> Bool:
    match scope:
        ExplorerTaskHistoryClearScope::Completed => status == ExplorerTaskStatus::Succeeded
        ExplorerTaskHistoryClearScope::Failed =>
            matches!(status, ExplorerTaskStatus::Failed | ExplorerTaskStatus::Cancelled)
        ExplorerTaskHistoryClearScope::Finished => status != ExplorerTaskStatus::Running

fn fs_clear_explorer_task_history(scope: ExplorerTaskHistoryClearScope) -> Result<(), String>:
    let mut registry = explorer_task_registry().lock().map_err(|_| "Explorer task registry lock was poisoned.".to_string())?
    let retained_task_ids = registry.order.iter().filter_map(
        |task_id| registry.entries.get(task_id).and_then(
            |entry| if should_clear_explorer_task(scope, entry.record.status):
                none
            else:
                Option::Some(task_id.clone())
        )
    ).collect()
    registry.order = retained_task_ids
    ()
    registry.entries.retain(|_, entry| !should_clear_explorer_task(scope, entry.record.status))
    ()
    Result::Ok(())

fn retry_context_for_task(task_id: String) -> Result<ExplorerTaskRetryContext, String>:
    let registry = explorer_task_registry().lock().map_err(|_| "Explorer task registry lock was poisoned.".to_string())?
    let entry = registry.entries.get(task_id).ok_or_else(|| format!("Explorer task not found: {task_id}"))?
    if !entry.record.can_retry:
        return Result::Err(format!("Explorer task is not retryable: {task_id}"))
    entry.retry_context.clone().ok_or_else(|| format!("Explorer task has no retry context: {task_id}"))

fn fs_retry_explorer_task(app: tauri::AppHandle, native_task_graph: tauri::State<_, NativeTaskGraphManager>, task_id: String) -> Result<ExplorerTaskRecord, String>:
    let retry_context = retry_context_for_task(&task_id)?
    let next_task_id = match retry_context:
        ExplorerTaskRetryContext::Copy { source_path: source_path, destination_path: destination_path } => (await copy_path(Path__new_(&source_path), Path__new_(&destination_path), true))?
        ExplorerTaskRetryContext::Move { source_path: source_path, destination_path: destination_path } => (await move_path(Path__new_(&source_path), Path__new_(&destination_path), true))?
        ExplorerTaskRetryContext::Delete { path: path, recursive: recursive } =>
            let path_ref = Path__new_(&path)
            ensure_nonrecursive_delete_allowed(path_ref, recursive)?
            ()
            (await delete_path_with_scheduler(path_ref, recursive))?
        ExplorerTaskRetryContext::DeleteMany { paths: paths } => (await run_delete_many_task(paths))?
        ExplorerTaskRetryContext::BatchRename { items: items } =>
            (await explorer_pro_commands__run_batch_rename_task(items))?
        ExplorerTaskRetryContext::DuplicateScan { root_path: root_path } =>
            explorer_pro_commands__start_duplicate_scan_task(app, root_path)?
        ExplorerTaskRetryContext::RecursiveSize { paths: paths, force_refresh: force_refresh } =>
            ((await run_recursive_size_task(&native_task_graph, paths, force_refresh))?).field_0
        ExplorerTaskRetryContext::Checksum { paths: paths } =>
            ((await run_checksum_task(&native_task_graph, paths))?).field_0
        ExplorerTaskRetryContext::ArchiveExtraction { request: request } =>
            (await run_archive_extraction_task(&native_task_graph, request))?
        ExplorerTaskRetryContext::AudioTransform { request: request } =>
            ((await audio_commands__audio_export_transform(app, request))?).task_id
        ExplorerTaskRetryContext::AudioBatchProcess { request: request } =>
            ((await audio_commands__audio_batch_process(app, request))?).task_id
    let tasks = list_explorer_tasks_snapshot()?
    tasks.into_iter().find(|record| record.id == next_task_id).ok_or_else(|| format!("Retried explorer task was not registered: {next_task_id}"))

fn cancel_context_for_task(task_id: String) -> Result<ExplorerTaskCancelContext, String>:
    let mut registry = explorer_task_registry().lock().map_err(|_| "Explorer task registry lock was poisoned.".to_string())?
    let entry = registry.entries.get_mut(task_id).ok_or_else(|| format!("Explorer task not found: {task_id}"))?
    if !entry.record.can_cancel:
        return Result::Err(format!("Explorer task is not cancellable: {task_id}"))
    entry.cancel_requested = true
    ()
    entry.cancel_context.clone().ok_or_else(|| format!("Explorer task has no cancel context: {task_id}"))

fn fs_cancel_explorer_task(native_task_graph: tauri::State<_, NativeTaskGraphManager>, task_id: String) -> Result<ExplorerTaskRecord, String>:
    let cancel_context = cancel_context_for_task(&task_id)?
    match cancel_context:
        ExplorerTaskCancelContext::Yazi { scheduler_task_id: scheduler_task_id } =>
            match fs_command_scheduler():
                Ok(scheduler) =>
                    scheduler.cancel(scheduler_task_id)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        ExplorerTaskCancelContext::NativeTaskGraph { task_id: task_id } =>
            native_task_graph.cancel(&task_id)
            ()
            ()
            ()
            ()
        ExplorerTaskCancelContext::DuplicateScan { scan_id: scan_id } =>
            explorer_pro_commands__cancel_duplicate_scan_task(&scan_id)?
            ()
            ()
            ()
            ()
        ExplorerTaskCancelContext::AudioOperation { operation_id: operation_id } =>
            audio_commands__cancel_audio_task(&operation_id)?
            ()
            ()
            ()
            ()
    cancel_manual_explorer_task(&task_id, none)

fn ensure_nonrecursive_delete_allowed(path: &std::path::Path, recursive: Bool) -> Result<(), String>:
    if recursive or !path.is_dir():
        return Result::Ok(())
    let mut entries = std__fs__read_dir(path).map_err(|error| error.to_string())?
    let has_entries = (entries.next().transpose().map_err(|error| error.to_string())?).is_some()
    if has_entries:
        return Result::Err(format!("Directory is not empty: {}", path.display()))
    Result::Ok(())

fn validate_transfer_destination(source_path: &std::path::Path, destination: &std::path::Path, operation: FileTransferOperation) -> Result<(), String>:
    if !source_path.is_dir():
        return Result::Ok(())
    let normalized_source = if source_path.is_absolute():
        source_path.to_path_buf()
    else:
        std__env__current_dir().map(|cwd| cwd.join(source_path)).unwrap_or_else(|_| source_path.to_path_buf())
    let normalized_destination = if destination.is_absolute():
        destination.to_path_buf()
    else:
        std__env__current_dir().map(|cwd| cwd.join(destination)).unwrap_or_else(|_| destination.to_path_buf())
    if normalized_destination.starts_with(&normalized_source):
        return Result::Err(format!("Cannot {:?} a folder into itself or one of its descendants: {} -> {}", operation, source_path.display(), destination.display()))
    Result::Ok(())

fn ensure_destination_parent_dir(path: &std::path::Path) -> Result<(), String>:
    let Some(parent) = path.parent()
    if parent.as_os_str().is_empty():
        return Result::Ok(())
    std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create destination parent directory {}: {error}", parent.display()))?
    ()
    return Result::Ok(())
    ensure_yazi_runtime()?
    ()
    (await yazi_vfs__provider__create_dir_all(UrlBuf__from(parent))).map_err(|error| format!("Failed to create destination parent directory {} via Yazi VFS: {error}", parent.display()))

fn yazi_task_registration(kind: ExplorerTaskKind, title: String, detail: String, source_paths: Array<String>, destination_path: Option<String>, retry_context: Option<ExplorerTaskRetryContext>) -> ExplorerTaskRegistration:
    ExplorerTaskRegistration { kind: kind, title: title, detail: detail, source_paths: source_paths, destination_path: destination_path, retry_context: retry_context, can_undo: false }

fn archive_task_initial_output_path(request: &FsArchiveExtractionRequest) -> Option<String>:
    match (*request).mode:
        FsArchiveExtractionMode::ExtractHere => Path__new_(&(*request).archive_path).parent().map(|path| path.to_string_lossy().into_owned())
        FsArchiveExtractionMode::ExtractToDirectory => (*request).target_directory.clone()
        FsArchiveExtractionMode::OpenCached | FsArchiveExtractionMode::ExtractToNewFolder => none

fn archive_task_registration(request: &FsArchiveExtractionRequest, output_path: Option<String>) -> ExplorerTaskRegistration:
    let archive_path = Path__new_(&(*request).archive_path)
    let archive_label = task_path_label(archive_path)
    let (title_prefix, detail_suffix) = match (*request).mode:
        FsArchiveExtractionMode::OpenCached => ("Open", "cached contents")
        FsArchiveExtractionMode::ExtractHere => ("Extract", "here")
        FsArchiveExtractionMode::ExtractToDirectory => ("Extract", "to selected folder")
        FsArchiveExtractionMode::ExtractToNewFolder => ("Extract", "to a new folder")
    let detail = match output_path:
        Option::Some(__kain_option_as_ref_value) => Option::Some(&__kain_option_as_ref_value)
        Option::None => none.map(|path| format!("{} -> {}", archive_path.display(), path)).unwrap_or_else(|| format!("{} -> {}", archive_path.display(), detail_suffix))
    ExplorerTaskRegistration { kind: ExplorerTaskKind::ExtractArchive, title: format!("{title_prefix} {archive_label}"), detail: detail, source_paths: vec!((*request).archive_path.clone()), destination_path: output_path, retry_context: Option::Some(ExplorerTaskRetryContext::ArchiveExtraction { request: request.clone() }), can_undo: false }

fn archive_task_success_detail(result: &FsArchiveExtractionResult) -> String:
    if (*result).reused_cached_output:
        return format!("Reused extracted contents at {}", (*result).output_path)
    let item_label = if (*result).extracted_entry_count == 1:
        "item"
    else:
        "items"
    format!("Extracted {} {} to {}", (*result).extracted_entry_count, item_label, (*result).output_path)

fn complete_archive_extraction_task(task_id: String, result: &FsArchiveExtractionResult) -> Result<ExplorerTaskRecord, String>:
    mutate_explorer_task(
        task_id,
        |entry| block:
            entry.record.status = ExplorerTaskStatus::Succeeded
            ()
            entry.record.finished_at = Option::Some(current_epoch_ms())
            ()
            entry.record.detail = archive_task_success_detail(result)
            ()
            entry.record.destination_path = Option::Some((*result).output_path.clone())
            ()
            entry.record.error_message = none
            ()
    )

fn execute_archive_extraction(native_task_graph: &NativeTaskGraphManager, task_id: String, request: FsArchiveExtractionRequest) -> Result<FsArchiveExtractionResult, String>:
    let work_key = format!("archive-extract:{}:{:?}", request.archive_path, request.mode)
    await run_native_blocking_task(
        native_task_graph,
        NativeTaskRequest__new_(NativeTaskLane::Archive, NativeTaskPriority::UserInitiated, "extract archive").with_task_id(task_id.to_string()).with_work_key(NativeTaskWorkKey__new_(work_key)).user_visible(true),
        |token| block:
            token.throw_if_cancelled()?
            ()
            let result = archive_ops__extract_archive(&request)
            token.throw_if_cancelled()?
            ()
            result
    )

fn run_archive_extraction_task_with_result(native_task_graph: &NativeTaskGraphManager, request: FsArchiveExtractionRequest) -> Result<(String, FsArchiveExtractionResult), String>:
    let task_id = create_manual_explorer_task(archive_task_registration(&request, archive_task_initial_output_path(&request)))
    let _ = set_manual_explorer_task_cancel_context(&task_id, ExplorerTaskCancelContext::NativeTaskGraph { task_id: task_id.clone() })
    match await execute_archive_extraction(native_task_graph, &task_id, request):
        Ok(result) =>
            complete_archive_extraction_task(&task_id, &result)?
            ()
            Result::Ok((task_id, result))
        Err(error) =>
            if native_task_graph__is_native_task_cancelled_error(&error):
                let _ = cancel_manual_explorer_task(&task_id, Option::Some("Cancelled".to_string()))
                ()
            else:
                let _ = fail_manual_explorer_task(&task_id, error.clone())
                ()
            Result::Err(error)

fn run_archive_extraction_task(native_task_graph: &NativeTaskGraphManager, request: FsArchiveExtractionRequest) -> Result<String, String>:
    let (task_id, _) = (await run_archive_extraction_task_with_result(native_task_graph, request))?
    Result::Ok(task_id)

fn copy_path(src: &std::path::Path, dst: &std::path::Path, force: Bool) -> Result<String, String>:
    let _ = force
    (await ensure_destination_parent_dir(dst))?
    ()
    copy_path_direct(src, dst)?
    ()
    return Result::Ok(String__new_())
    (await ensure_destination_parent_dir(dst))?
    ()
    let ticket = (fs_command_scheduler()?).file_copy_ticket(UrlBuf__from(src), UrlBuf__from(dst), force, false)
    await await_explorer_yazi_task(ticket, yazi_task_registration(ExplorerTaskKind::Copy, format!("Copy {}", task_path_label(src)), format!("{} -> {}", src.display(), dst.display()), vec!(src.to_string_lossy().to_string()), Option::Some(dst.to_string_lossy().to_string()), Option::Some(ExplorerTaskRetryContext::Copy { source_path: src.to_string_lossy().to_string(), destination_path: dst.to_string_lossy().to_string() })))

fn yazi_path_metadata(path: &std::path::Path) -> Result<Option<yazi_fs::cha::Cha>, String>:
    ensure_yazi_runtime()?
    ()
    match await yazi_vfs__provider__symlink_metadata(UrlBuf__from(path)):
        Ok(metadata) => Result::Ok(Option::Some(metadata))
        Err(error) if error.kind() == io::ErrorKind::NotFound => Result::Ok(none)
        Err(error) => Result::Err(format!("Failed to inspect {} via Yazi VFS: {error}", path.display()))

fn cleanup_residual_move_source(source: &std::path::Path, metadata: yazi_fs::cha::Cha) -> Result<(), String>:
    let url = UrlBuf__from(source)
    let cleanup_result = if metadata.is_dir() and !metadata.is_link():
        await yazi_vfs__provider__remove_dir_all(url)
    else:
        await yazi_vfs__provider__remove_file(url)
    cleanup_result.map_err(|error| format!("Move completed but residual source cleanup failed for {}: {error}", source.display()))

fn move_path(src: &std::path::Path, dst: &std::path::Path, force: Bool) -> Result<String, String>:
    let _ = force
    (await ensure_destination_parent_dir(dst))?
    ()
    move_path_direct(src, dst)?
    ()
    return Result::Ok(String__new_())
    (await ensure_destination_parent_dir(dst))?
    ()
    let ticket = (fs_command_scheduler()?).file_cut_ticket(UrlBuf__from(src), UrlBuf__from(dst), force)
    let task_id = (await await_explorer_yazi_task(ticket, yazi_task_registration(ExplorerTaskKind::Move, format!("Move {}", task_path_label(src)), format!("{} -> {}", src.display(), dst.display()), vec!(src.to_string_lossy().to_string()), Option::Some(dst.to_string_lossy().to_string()), Option::Some(ExplorerTaskRetryContext::Move { source_path: src.to_string_lossy().to_string(), destination_path: dst.to_string_lossy().to_string() }))))?
    let destination_metadata = (await yazi_path_metadata(dst))?
    let source_metadata = (await yazi_path_metadata(src))?
    match (destination_metadata, source_metadata):
        (None, _) => Result::Err(format!("Move completed but destination is missing: {}", dst.display()))
        (Some(_), None) => Result::Ok(())
        (Some(_), Some(metadata)) => await cleanup_residual_move_source(src, metadata)?
    ()
    Result::Ok(task_id)

fn delete_path_with_scheduler(path: &std::path::Path, recursive: Bool) -> Result<String, String>:
    let _ = recursive
    delete_path_direct(path)?
    ()
    return Result::Ok(String__new_())
    let ticket = (fs_command_scheduler()?).file_delete_ticket(UrlBuf__from(path))
    await await_explorer_yazi_task(ticket, yazi_task_registration(ExplorerTaskKind::Delete, format!("Delete {}", task_path_label(path)), path.display().to_string(), vec!(path.to_string_lossy().to_string()), none, Option::Some(ExplorerTaskRetryContext::Delete { path: path.to_string_lossy().to_string(), recursive: recursive })))

fn resolve_transfer_destination(preferred_path: std::path::PathBuf, operation: FileTransferOperation, source_path: &std::path::Path, collision_policy: FileTransferCollisionPolicy) -> std::path::PathBuf:
    match collision_policy:
        FileTransferCollisionPolicy::KeepBoth =>
            collision_free_destination(preferred_path, operation, source_path)
        FileTransferCollisionPolicy::Replace | FileTransferCollisionPolicy::Skip => preferred_path

fn collision_free_destination(preferred_path: std::path::PathBuf, operation: FileTransferOperation, source_path: &std::path::Path) -> std::path::PathBuf:
    if !preferred_path.exists() or preferred_path == source_path:
        return preferred_path
    let parent = preferred_path.parent().map(Path__to_path_buf).unwrap_or_else(|| PathBuf__from("."))
    let file_name = preferred_path.file_name().map(|value| value.to_string_lossy().to_string()).unwrap_or_else(|| "item".to_string())
    if preferred_path.is_dir() or source_path.is_dir():
        return numbered_destination(&parent, &file_name, "", operation)
    let stem = preferred_path.file_stem().map(|value| value.to_string_lossy().to_string()).unwrap_or_else(|| file_name.clone())
    let ext = preferred_path.extension().map(|value| format!(".{}", value.to_string_lossy())).unwrap_or_default()
    numbered_destination(&parent, &stem, &ext, operation)

fn numbered_destination(parent: &std::path::Path, base_name: String, extension: String, operation: FileTransferOperation) -> std::path::PathBuf:
    let copy_suffix = "copy"
    let first_candidate = match operation:
        FileTransferOperation::Copy => format!("{base_name} ({copy_suffix}){extension}")
        FileTransferOperation::Move => format!("{base_name} (moved){extension}")
    let first_path = parent.join(&first_candidate)
    if !first_path.exists():
        return first_path
    for index in 2..10000:
        let candidate = match operation:
            FileTransferOperation::Copy =>
                format!("{base_name} ({copy_suffix} {index}){extension}")
            FileTransferOperation::Move => format!("{base_name} (moved {index}){extension}")
        let candidate_path = parent.join(candidate)
        if !candidate_path.exists():
            return candidate_path
    ()
    parent.join(format!("{base_name}-fallback{extension}"))

fn fs_create_dir(path: String) -> Result<(), String>:
    let path_ref = Path__new_(&path)
    std__fs__create_dir_all(path_ref).map_err(|error| error.to_string())?
    ()
    invalidate_all_fs_caches(path_ref)
    ()
    match path_ref.parent():
        Some(parent) =>
            invalidate_all_fs_caches(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    return Result::Ok(())
    ensure_yazi_runtime()?
    ()
    let result = (await yazi_vfs__provider__create_dir_all(UrlBuf__from(Path__new_(&path)))).map_err(|e| e.to_string())
    if result.is_ok():
        let path_ref = Path__new_(&path)
        invalidate_all_fs_caches(path_ref)
        ()
        match path_ref.parent():
            Some(parent) =>
                invalidate_all_fs_caches(parent)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    result

fn fs_write_file(path: String, content: FsWriteFileContent) -> Result<(), String>:
    let path_ref = Path__new_(&path)
    match path_ref.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| error.to_string())?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let bytes = match content:
        FsWriteFileContent::Text(text) => text.into_bytes()
        FsWriteFileContent::Bytes(bytes) => bytes
    std__fs__write(path_ref, bytes).map_err(|error| error.to_string())?
    ()
    invalidate_all_fs_caches(path_ref)
    ()
    match path_ref.parent():
        Some(parent) =>
            invalidate_all_fs_caches(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    return Result::Ok(())
    match Path__new_(&path).parent():
        Some(parent) =>
            ensure_yazi_runtime()?
            ()
            (await yazi_vfs__provider__create_dir_all(UrlBuf__from(parent))).map_err(|e| e.to_string())?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let bytes = match content:
        FsWriteFileContent::Text(text) => text.into_bytes()
        FsWriteFileContent::Bytes(bytes) => bytes
    let result = (await yazi_vfs__provider__write(UrlBuf__from(Path__new_(&path)), bytes)).map(|_| ()).map_err(|e| e.to_string())
    if result.is_ok():
        let path_ref = Path__new_(&path)
        invalidate_all_fs_caches(path_ref)
        ()
        match path_ref.parent():
            Some(parent) =>
                invalidate_all_fs_caches(parent)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    result

fn git_command_program() -> String:
    std__env__var_("OVERLAYTERM_GIT_EXECUTABLE").ok().map(|value| value.trim().to_string()).filter(|value| !value.is_empty()).unwrap_or_else(|| "git".to_string())

fn run_git_command(repo_path: String, args: &Slice<String>, timeout: std::time::Duration) -> Result<String, String>:
    let program = git_command_program()
    let mut cmd = Command__new_(&program)
    cmd.current_dir(repo_path).args(args).stdout(Stdio__piped()).stderr(Stdio__piped())
    ()
    cmd.creation_flags(CREATE_NO_WINDOW)
    ()
    ()
    ()
    ()
    let mut child = cmd.spawn_().map_err(|e| format!("Failed to run git via '{}': {}", program, e))?
    let started = Instant__now()
    loop:
        match child.try_wait():
            Ok(Some(_)) =>
                let output = child.wait_with_output().map_err(|e| format!("Failed to collect git output: {}", e))?
                return if output.status.success():
                    Result::Ok(String__from_utf8_lossy(&output.stdout).to_string())
                else:
                    let stderr = String__from_utf8_lossy(&output.stderr).trim().to_string()
                    let stdout = String__from_utf8_lossy(&output.stdout).trim().to_string()
                    let exit_code = output.status.code().map(|code| code.to_string()).unwrap_or_else(|| "signal".to_string())
                    let output_detail = if !stderr.is_empty():
                        stderr
                    else if !stdout.is_empty():
                        stdout
                    else:
                        "no output".to_string()
                    Result::Err(format!("Git command failed (exit {}): {}", exit_code, output_detail))
            Ok(None) =>
                if started.elapsed() >= timeout:
                    let _ = child.kill()
                    let _ = child.wait()
                    return Result::Err(format!("Git command timed out after {}s: {} {}", timeout.as_secs(), program, args.join(" ")))
                std__thread__sleep(Duration__from_millis(15))
                ()
            Err(e) => return Result::Err(format!("Failed while waiting for git: {}", e))

fn git_exec(repo_path: String, args: Array<String>) -> Result<String, String>:
    (await tauri__async_runtime__spawn_blocking(|| run_git_command(&repo_path, &args, GIT_EXEC_TIMEOUT))).map_err(|join_error| format!("Git task join failure: {}", join_error))?

fn fs_read_file_base64(native_task_graph: tauri::State<_, NativeTaskGraphManager>, preview_streaming: tauri::State<_, PreviewStreamingManager>, path: String) -> Result<String, String>:
    let target = PathBuf__from(&path)
    let policy = preview_streaming.policy().clone()
    await run_native_blocking_task(&native_task_graph, NativeTaskRequest__new_(NativeTaskLane::PreviewRead, NativeTaskPriority::Visible, "read data uri preview").with_work_key(NativeTaskWorkKey__new_(format!("preview-data-uri:{path}"))), |token| preview_streaming__read_local_file_data_url(&target, &policy, &token))

fn fs_read_preview_bytes_impl(native_task_graph: &NativeTaskGraphManager, preview_streaming: &PreviewStreamingManager, path: String, max_bytes: Option<u64>) -> Result<tauri::transport::BinaryResponse, String>:
    let target = PathBuf__from(&path)
    let policy = preview_streaming.policy().clone()
    let bytes = (await run_native_blocking_task(&native_task_graph, NativeTaskRequest__new_(NativeTaskLane::PreviewRead, NativeTaskPriority::Visible, "read preview bytes").with_work_key(NativeTaskWorkKey__new_(format!("preview-bytes:{path}"))), |token| preview_streaming__read_local_preview_bytes(&target, max_bytes, &policy, &token)))?
    Result::Ok(BinaryResponse__new_(bytes))

fn fs_read_preview_bytes(native_task_graph: tauri::State<_, NativeTaskGraphManager>, preview_streaming: tauri::State<_, PreviewStreamingManager>, path: String, max_bytes: Option<u64>) -> Result<tauri::transport::BinaryResponse, String>:
    await fs_read_preview_bytes_impl(native_task_graph.inner(), preview_streaming.inner(), path, max_bytes)

fn fs_read_archive_entry_preview_bytes_impl(native_task_graph: &NativeTaskGraphManager, preview_streaming: &PreviewStreamingManager, archive_path: String, entry_path: String, max_bytes: Option<u64>) -> Result<tauri::transport::BinaryResponse, String>:
    let target = PathBuf__from(&archive_path)
    let policy = preview_streaming.policy().clone()
    let allowed_bytes = preview_streaming__resolve_preview_byte_limit(max_bytes, policy.archive_entry_max_bytes)
    let chunk_bytes = policy.chunk_bytes
    let work_key = format!("archive-entry-preview:{archive_path}:{entry_path}")
    let bytes = (await run_native_blocking_task(&native_task_graph, NativeTaskRequest__new_(NativeTaskLane::PreviewRead, NativeTaskPriority::Visible, "read archive entry preview bytes").with_work_key(NativeTaskWorkKey__new_(work_key)), |token| archive_ops__read_archive_entry_preview_bytes(&target, &entry_path, allowed_bytes, chunk_bytes, &token)))?
    Result::Ok(BinaryResponse__new_(bytes))

fn fs_read_archive_entry_preview_bytes(native_task_graph: tauri::State<_, NativeTaskGraphManager>, preview_streaming: tauri::State<_, PreviewStreamingManager>, archive_path: String, entry_path: String, max_bytes: Option<u64>) -> Result<tauri::transport::BinaryResponse, String>:
    await fs_read_archive_entry_preview_bytes_impl(native_task_graph.inner(), preview_streaming.inner(), archive_path, entry_path, max_bytes)

fn fs_read_image_thumbnail(path: String, max_width: u32, max_height: u32) -> Result<String, String>:
    thumbnail_commands__build_image_thumbnail_data_url_with_runtime(gpu_runtime__global_gpu_runtime(), Path__new_(&path), max_width, max_height)

fn fs_get_home_dir() -> Result<String, String>:
    dirs__home_dir().map(|p| p.to_string_lossy().to_string()).ok_or_else(|| "Could not determine home directory".to_string())

fn current_process_is_elevated() -> Result<Bool, String>:
    let mut token_handle = std__ptr__null_mut()
    if windows_sys::Win32::System::Threading::OpenProcessToken(windows_sys::Win32::System::Threading::GetCurrentProcess(), windows_sys::Win32::Security::TOKEN_QUERY, &mut token_handle) == 0:
        return Result::Err(Error__last_os_error().to_string())
    struct TokenGuard:
        field_0: isize

    impl Drop for TokenGuard:
        fn drop(_self: &mut TokenGuard):
            windows_sys::Win32::Foundation::CloseHandle((*_self).field_0 as _)
            ()


    let token_guard = TokenGuard(token_handle as isize)
    let mut elevation = windows_sys::Win32::Security::TOKEN_ELEVATION { TokenIsElevated: 0 }
    let mut bytes_returned = 0
    if windows_sys::Win32::Security::GetTokenInformation(token_handle, windows_sys::Win32::Security::TokenElevation, &mut elevation as PtrMut<_> as PtrMut<_>, std__mem__size_of() as u32, &mut bytes_returned) == 0:
        return Result::Err(Error__last_os_error().to_string())
    Result::Ok(elevation.TokenIsElevated != 0)

fn fs_is_process_elevated() -> Result<Bool, String>:
    return current_process_is_elevated()
    Result::Ok(false)

enum FileSearchMatchKind:
    Name
    Content
    NameAndContent

fn normalize_case(value: String) -> String:
    value.trim().to_lowercase()

fn normalize_path_for_match(value: String) -> String:
    value.replace("\\", "/")

fn builtin_ignored_paths() -> &Slice<String>:
    &["/$Recycle.Bin", "/System Volume Information", "/proc", "/sys", "/dev", "/run", "/tmp", "/var/tmp", "/lost+found", "/.Trash", "/.Trashes", "/.Spotlight-V100", "/.fseventsd", "/Volumes/.Trashes", "/node_modules", "/.git", "/target", "/.cache", "/Library/Caches", "/AppData/Local/Temp"]

fn build_ignored_path_list(custom_paths: &Slice<String>) -> Array<String>:
    custom_paths.iter().map(|path| normalize_path_for_match(path).trim().trim_end_matches("/").to_string()).chain(builtin_ignored_paths().iter().map(|path| normalize_path_for_match(path).trim().trim_end_matches("/").to_string())).filter(|path| !path.is_empty()).collect()

fn is_ignored_path(path: String, ignored_paths: &Slice<String>) -> Bool:
    let normalized_path = normalize_path_for_match(path)
    ignored_paths.iter().any(
        |ignored| block:
            let normalized = ignored.trim().trim_end_matches("/")
            if normalized.is_empty():
                return false
            if normalized.starts_with("/"):
                return normalized_path == normalized or normalized_path.ends_with(normalized) or normalized_path.contains(&format!("{normalized}/"))
            normalized_path == normalized or normalized_path.starts_with(normalized) or normalized_path.contains(&format!("/{normalized}/")) or normalized_path.ends_with(&format!("/{normalized}"))
    )

fn build_schema() -> (tantivy::schema::Schema, GlobalSearchIndexFields):
    let mut schema_builder = Schema__builder()
    let name_indexing = TextFieldIndexing__default_().set_tokenizer("default").set_index_option(tantivy::schema::IndexRecordOption::WithFreqsAndPositions)
    let name_options = TextOptions__default_().set_indexing_options(name_indexing).set_stored()
    let path = schema_builder.add_text_field("path", tantivy__schema__STRING | tantivy__schema__STORED)
    let name = schema_builder.add_text_field("name", name_options)
    let name_lower = schema_builder.add_text_field("name_lower", tantivy__schema__STRING | tantivy__schema__STORED)
    let is_file = schema_builder.add_u64_field("is_file", tantivy__schema__FAST | tantivy__schema__STORED)
    let is_dir = schema_builder.add_u64_field("is_dir", tantivy__schema__FAST | tantivy__schema__STORED)
    let modified_time = schema_builder.add_u64_field("modified_time", tantivy__schema__FAST | tantivy__schema__STORED)
    let size = schema_builder.add_u64_field("size", tantivy__schema__FAST | tantivy__schema__STORED)
    let schema = schema_builder.build()
    (schema, GlobalSearchIndexFields { path: path, name: name, name_lower: name_lower, is_file: is_file, is_dir: is_dir, modified_time: modified_time, size: size })

fn global_search_data_dir(base_dir: &std::path::Path) -> std::path::PathBuf:
    base_dir.join(GLOBAL_SEARCH_DIRECTORY)

fn global_search_index_dir(base_dir: &std::path::Path) -> std::path::PathBuf:
    global_search_data_dir(base_dir).join(GLOBAL_SEARCH_INDEX_DIRECTORY)

fn calculate_dir_size(path: &std::path::Path) -> u64:
    if !path.exists():
        return 0
    let mut total_size = 0
    match std__fs__read_dir(path):
        Ok(entries) =>
            for entry in entries.flatten():
                let entry_path = entry.path()
                if entry_path.is_file():
                    match entry.metadata():
                        Ok(metadata) =>
                            total_size = total_size + metadata.len()
                            ()
                        _ => ()
                else if entry_path.is_dir():
                    total_size = total_size + calculate_dir_size(&entry_path)
                    ()
            ()
            ()
        _ =>
            ()
            ()
    total_size

fn meta_file(base_dir: &std::path::Path) -> std::path::PathBuf:
    global_search_data_dir(base_dir).join(GLOBAL_SEARCH_STATUS_FILENAME)

struct GlobalSearchMeta:
    last_scan_time: Option<u64>
    indexed_item_count: u64
    schema_version: u32

fn read_meta(base_dir: &std::path::Path) -> Option<GlobalSearchMeta>:
    let path = meta_file(base_dir)
    let text = std__fs__read_to_string(path).ok()?
    serde_json__from_str(&text).ok()

fn write_meta(base_dir: &std::path::Path, meta: &GlobalSearchMeta) -> Result<(), String>:
    let path = meta_file(base_dir)
    match path.parent():
        Some(parent) =>
            ensure_dir(parent)?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let json = serde_json__to_string(meta).map_err(|error| error.to_string())?
    std__fs__write(path, json).map_err(|error| error.to_string())

fn ensure_dir(path: &std::path::Path) -> Result<(), String>:
    std__fs__create_dir_all(path).map_err(|error| error.to_string())

fn validate_index(index_path: &std::path::Path, base_dir: &std::path::Path) -> Bool:
    let meta = match read_meta(base_dir):
        Some(meta) => meta
        None => return false
    if meta.schema_version != GLOBAL_SEARCH_SCHEMA_VERSION or !index_path.exists():
        return false
    match Index__open_in_dir(index_path):
        Ok(index) =>
            match index.reader_builder().try_into():
                Ok(reader) => reader.searcher().num_docs() > 0
                Err(_) => false
        Err(_) => false

fn clear_index(index_path: &std::path::Path) -> Result<(), String>:
    if index_path.exists():
        std__fs__remove_dir_all(index_path).map_err(|error| error.to_string())?
        ()
        ()
        ()
        ()
    Result::Ok(())

fn open_or_create_index(index_path: &std::path::Path) -> Result<(tantivy::Index, tantivy::IndexReader, GlobalSearchIndexFields), String>:
    ensure_dir(index_path)?
    ()
    let (schema, fields) = build_schema()
    let index = match Index__open_in_dir(index_path):
        Ok(existing) =>
            let existing_schema = existing.schema()
            if existing_schema != schema:
                drop(existing)
                ()
                clear_index(index_path)?
                ()
                ensure_dir(index_path)?
                ()
                Index__create_in_dir(index_path, schema).map_err(|error| error.to_string())?
            else:
                existing
        Err(_) => Index__create_in_dir(index_path, schema).map_err(|error| error.to_string())?
    let reader = index.reader_builder().try_into().map_err(|error| error.to_string())?
    Result::Ok((index, reader, fields))

fn build_query(fields: &GlobalSearchIndexFields, query: String, options: &GlobalSearchQueryOptions) -> impl Query:
    let normalized = ignore__normalize_case(query)
    let normalized_words: Array<String> = normalized.split(fn(character: Char): character.is_whitespace() or character == "." or character == "_" or character == "-").filter(|segment| !segment.is_empty()).map(|segment| segment.to_string()).collect()
    if (*options).exact_match:
        let term = Term__from_field_text((*fields).name_lower, &normalized)
        return Box__new_(TermQuery__new_(term, tantivy::schema::IndexRecordOption::Basic))
    let max_distance = if (*options).typo_tolerance:
        2
    else:
        1
    let mut subqueries: Array<(tantivy::query::Occur, impl Query)> = Vec__new_()
    for word in &normalized_words:
        let term = Term__from_field_text((*fields).name, word)
        let fuzzy = FuzzyTermQuery__new_(term, max_distance, true)
        subqueries.push((tantivy::query::Occur::Should, Box__new_(fuzzy)))
        ()
    ()
    if normalized_words.len() > 1:
        let joined_term = Term__from_field_text((*fields).name, &normalized)
        subqueries.push((tantivy::query::Occur::Should, Box__new_(FuzzyTermQuery__new_(joined_term, max_distance, true))))
        ()
        ()
        ()
        ()
    Box__new_(BooleanQuery__from(subqueries))

fn matches_type(document_is_file: u64, document_is_dir: u64, options: &GlobalSearchQueryOptions) -> Bool:
    let is_file = document_is_file == 1
    let is_dir = document_is_dir == 1
    ((*options).include_files and is_file) or ((*options).include_directories and is_dir)

fn candidate_limit(limit: usize) -> usize:
    limit.saturating_mul(64).clamp(256, 20000)

struct NormalizedGlobalSearchIndexQueryRequest:
    query: String
    limit: usize
    offset: usize
    options: GlobalSearchQueryOptions
    include_hidden: Bool
    extensions: Set<String>
    root_paths: Array<String>
    sort_key: GlobalSearchIndexSortKey
    sort_direction: GlobalSearchIndexSortDirection

fn normalize_index_query_request(request: GlobalSearchIndexQueryRequest) -> NormalizedGlobalSearchIndexQueryRequest:
    let query = request.query.unwrap_or_default().trim().to_string()
    let limit = if request.limit == 0:
        INDEX_QUERY_DEFAULT_LIMIT
    else:
        request.limit.clamp(1, INDEX_QUERY_MAX_LIMIT)
    let offset = request.offset.min(INDEX_QUERY_MAX_OFFSET)
    let include_files = request.include_files or !request.include_directories
    let include_directories = request.include_directories
    let sort_key = request.sort_key.unwrap_or_else(
        || if query.is_empty():
            GlobalSearchIndexSortKey::ModifiedTime
        else:
            GlobalSearchIndexSortKey::Relevance
    )
    NormalizedGlobalSearchIndexQueryRequest { query: query, limit: limit, offset: offset, options: GlobalSearchQueryOptions { limit: offset.saturating_add(limit), include_files: include_files, include_directories: include_directories, exact_match: request.exact_match, typo_tolerance: request.typo_tolerance, min_score_threshold: request.min_score_threshold }, include_hidden: request.include_hidden, extensions: request.extensions.into_iter().map(|extension| normalize_extension_filter_value(&extension)).filter(|extension| !extension.is_empty()).collect(), root_paths: request.root_paths.into_iter().map(|root_path| normalize_scope_root_path(&root_path)).filter(|root_path| !root_path.is_empty()).collect(), sort_key: sort_key, sort_direction: request.sort_direction.unwrap_or(GlobalSearchIndexSortDirection::Desc) }

fn normalize_extension_filter_value(extension: String) -> String:
    extension.trim().trim_start_matches(".").to_lowercase()

fn build_combined_scope_query(fields: &GlobalSearchIndexFields, root_paths: &Slice<String>) -> Option<impl Query>:
    let mut scope_queries: Array<(tantivy::query::Occur, impl Query)> = root_paths.iter().filter_map(|root_path| build_scope_query(fields, root_path)).map(|query| (tantivy::query::Occur::Should, query)).collect()
    match scope_queries.len():
        0 => none
        1 => Option::Some(scope_queries.remove(0).field_1)
        _ => Option::Some(Box__new_(BooleanQuery__from(scope_queries)))

fn normalize_scope_root_path(raw_root_path: String) -> String:
    let trimmed = raw_root_path.trim()
    if trimmed.is_empty():
        return String__new_()
    let without_trailing = trimmed.trim_end_matches(["/", "\\"])
    if without_trailing.len() == 2:
        let bytes = without_trailing.as_bytes()
        if bytes[0].is_ascii_alphabetic() and bytes[1] == 58:
            return format!("{without_trailing}\\")
        ()
    ()
    if trimmed == "/":
        return "/".to_string()
    trimmed.trim_end_matches(["/", "\\"]).to_string()

fn build_scope_query(fields: &GlobalSearchIndexFields, raw_root_path: String) -> Option<impl Query>:
    let normalized_root_path = normalize_scope_root_path(raw_root_path)
    if normalized_root_path.is_empty():
        return none
    let exact_path_query = TermQuery__new_(Term__from_field_text((*fields).path, &normalized_root_path), tantivy::schema::IndexRecordOption::Basic)
    let descendant_pattern = if normalized_root_path == "/":
        "^/.*$".to_string()
    else if normalized_root_path.ends_with("\\") or normalized_root_path.ends_with("/"):
        format!("^{}.*$", regex__escape(&normalized_root_path))
    else if normalized_root_path.contains("\\"):
        format!("^{}(?:$|[\\\\/].*)", regex__escape(&normalized_root_path))
    else:
        format!("^{}(?:$|/.*)", regex__escape(&normalized_root_path))
    let descendant_path_query = match RegexQuery__from_pattern(&descendant_pattern, (*fields).path):
        Ok(query) => query
        Err(_) => return none
    Option::Some(Box__new_(BooleanQuery__from(vec!((tantivy::query::Occur::Should, Box__new_(exact_path_query) as impl Query), (tantivy::query::Occur::Should, Box__new_(descendant_path_query) as impl Query)))))

fn sort_results(results: &mut Slice<GlobalSearchResultEntry>):
    results.sort_by(|left, right| right.score.partial_cmp(&left.score).unwrap_or(cmp::Ordering::Equal).then_with(|| right.modified_time.cmp(&left.modified_time)).then_with(|| left.path.cmp(&right.path)))
    ()

fn compare_index_query_results(left: &GlobalSearchResultEntry, right: &GlobalSearchResultEntry, sort_key: GlobalSearchIndexSortKey) -> std::cmp::Ordering:
    match sort_key:
        GlobalSearchIndexSortKey::Relevance => (*right).score.partial_cmp(&(*left).score).unwrap_or(std::cmp::Ordering::Equal).then_with(|| (*right).modified_time.cmp(&(*left).modified_time)).then_with(|| (*left).path.cmp(&(*right).path))
        GlobalSearchIndexSortKey::ModifiedTime => (*right).modified_time.cmp(&(*left).modified_time).then_with(|| (*right).score.partial_cmp(&(*left).score).unwrap_or(std::cmp::Ordering::Equal)).then_with(|| (*left).path.cmp(&(*right).path))
        GlobalSearchIndexSortKey::Name => (*left).name.to_lowercase().cmp(&(*right).name.to_lowercase()).reverse().then_with(|| (*left).path.cmp(&(*right).path))
        GlobalSearchIndexSortKey::Path => (*right).path.cmp(&(*left).path)
        GlobalSearchIndexSortKey::Size => (*right).size.cmp(&(*left).size).then_with(|| (*left).path.cmp(&(*right).path))

fn sort_index_query_results(results: &mut Slice<GlobalSearchResultEntry>, request: &NormalizedGlobalSearchIndexQueryRequest):
    results.sort_by(
        |left, right| block:
            let ordering = compare_index_query_results(left, right, (*request).sort_key)
            match (*request).sort_direction:
                GlobalSearchIndexSortDirection::Desc => ordering
                GlobalSearchIndexSortDirection::Asc => ordering.reverse()
    )
    ()

fn open_search_reader(app: &tauri::AppHandle) -> Result<(tantivy::IndexReader, GlobalSearchIndexFields), String>:
    let base_dir = app.path().app_data_dir().map_err(fn(error: tauri::Error): error.to_string())?
    let index_path = index__global_search_index_dir(&base_dir)
    let (reader, fields) = block:
        let mut state = state__GLOBAL_SEARCH_STATE.write().map_err(|error| error.to_string())?
        if state.index.is_none() or state.reader.is_none() or state.fields.is_none():
            let (index, reader, fields) = index__open_or_create_index(&index_path)?
            state.index = Option::Some(index)
            ()
            state.reader = Option::Some(reader)
            ()
            state.fields = Option::Some(fields)
            ()
            ()
            ()
            ()
        (state.reader.expect("global search reader initialized").clone(), *state.fields.expect("global search index fields initialized"))
    Result::Ok((reader, fields))

fn execute_index_query(reader: &tantivy::IndexReader, fields: &GlobalSearchIndexFields, query: String, options: &GlobalSearchQueryOptions, scope_root_path: Option<String>) -> Result<Array<GlobalSearchResultEntry>, String>:
    let searcher = reader.searcher()
    let normalized_query = ignore__normalize_case(query)
    let min_score = (*options).min_score_threshold.unwrap_or_else(|| scoring__get_min_score_for_query_length(normalized_query.len()))
    let ignored_paths = ignore__build_ignored_path_list(&[])
    let text_query = build_query(fields, query, options)
    let final_query: impl Query = match scope_root_path.and_then(|value| build_scope_query(fields, value)):
        Some(scope_query) => Box__new_(BooleanQuery__from(vec!((tantivy::query::Occur::Must, text_query), (tantivy::query::Occur::Must, scope_query))))
        None => text_query
    let top_docs = searcher.search(&final_query, &TopDocs__with_limit(candidate_limit((*options).limit))).map_err(|error| error.to_string())?
    let mut results = Vec__new_()
    for (tantivy_score, doc_address) in top_docs:
        let retrieved: tantivy::TantivyDocument = searcher.doc(doc_address).map_err(|error| error.to_string())?
        let path_value = match retrieved.get_first((*fields).path).and_then(|value| value.as_str()):
            Some(path) => path.to_string()
            None => continue
        if ignore__is_ignored_path(&path_value, &ignored_paths):
            continue
        let name_value = match retrieved.get_first((*fields).name).and_then(|value| value.as_str()):
            Some(name) => name.to_string()
            None => continue
        let name_score = scoring__calculate_similarity_score(&normalized_query, &name_value)
        if name_score < min_score:
            continue
        let document_is_file = retrieved.get_first((*fields).is_file).and_then(|value| value.as_u64()).unwrap_or(0)
        let document_is_dir = retrieved.get_first((*fields).is_dir).and_then(|value| value.as_u64()).unwrap_or(0)
        if !matches_type(document_is_file, document_is_dir, options):
            continue
        let modified_time = retrieved.get_first((*fields).modified_time).and_then(|value| value.as_u64()).unwrap_or(0)
        let size = retrieved.get_first((*fields).size).and_then(|value| value.as_u64()).unwrap_or(0)
        results.push(GlobalSearchResultEntry { name: name_value, extension: utils__path_extension_lowercase(Path__new_(&path_value)), path: path_value, size: size, modified_time: modified_time, accessed_time: 0, created_time: 0, is_file: document_is_file == 1, is_dir: document_is_dir == 1, is_symlink: false, is_hidden: false, score: name_score })
        ()
    ()
    sort_results(&mut results)
    ()
    results.truncate((*options).limit)
    ()
    Result::Ok(results)

fn index_query_candidate_limit(searcher_doc_count: usize, request: &NormalizedGlobalSearchIndexQueryRequest) -> usize:
    if (*request).query.is_empty():
        return searcher_doc_count
    candidate_limit((*request).options.limit).min(searcher_doc_count)

fn build_plugin_index_query(fields: &GlobalSearchIndexFields, request: &NormalizedGlobalSearchIndexQueryRequest) -> impl Query:
    let content_query: impl Query = if (*request).query.is_empty():
        Box__new_(tantivy__query__AllQuery)
    else:
        build_query(fields, &(*request).query, &(*request).options)
    match build_combined_scope_query(fields, &(*request).root_paths):
        Some(scope_query) => Box__new_(BooleanQuery__from(vec!((tantivy::query::Occur::Must, content_query), (tantivy::query::Occur::Must, scope_query))))
        None => content_query

fn result_entry_from_index_document(fields: &GlobalSearchIndexFields, retrieved: &tantivy::TantivyDocument, score: f32) -> Option<GlobalSearchResultEntry>:
    let path_value = (retrieved.get_first((*fields).path).and_then(|value| value.as_str())?).to_string()
    let name_value = (retrieved.get_first((*fields).name).and_then(|value| value.as_str())?).to_string()
    let document_is_file = retrieved.get_first((*fields).is_file).and_then(|value| value.as_u64()).unwrap_or(0)
    let document_is_dir = retrieved.get_first((*fields).is_dir).and_then(|value| value.as_u64()).unwrap_or(0)
    let modified_time = retrieved.get_first((*fields).modified_time).and_then(|value| value.as_u64()).unwrap_or(0)
    let size = retrieved.get_first((*fields).size).and_then(|value| value.as_u64()).unwrap_or(0)
    Option::Some(GlobalSearchResultEntry { name: name_value, extension: utils__path_extension_lowercase(Path__new_(&path_value)), path: path_value, size: size, modified_time: modified_time, accessed_time: 0, created_time: 0, is_file: document_is_file == 1, is_dir: document_is_dir == 1, is_symlink: false, is_hidden: false, score: score })

fn matches_index_query_filters(entry: &GlobalSearchResultEntry, request: &NormalizedGlobalSearchIndexQueryRequest, ignored_paths: &Slice<String>) -> Bool:
    if ignore__is_ignored_path(&(*entry).path, ignored_paths):
        return false
    if (*entry).is_hidden and !(*request).include_hidden:
        return false
    if !(((*request).options.include_files and (*entry).is_file) or ((*request).options.include_directories and (*entry).is_dir)):
        return false
    if (*request).extensions.is_empty():
        return true
    (*entry).extension.map(|extension| (*request).extensions.contains(extension)).unwrap_or(false)

fn calculate_index_query_score(entry_name: String, normalized_query: String, min_score: f32) -> Option<f32>:
    if normalized_query.is_empty():
        return Option::Some(1.0)
    let name_score = scoring__calculate_similarity_score(normalized_query, entry_name)
    if name_score < min_score:
        return none
    Option::Some(name_score)

fn retrieve_index_query_entries(reader: &tantivy::IndexReader, fields: &GlobalSearchIndexFields, request: &NormalizedGlobalSearchIndexQueryRequest, query: &impl Query) -> Result<Array<GlobalSearchResultEntry>, String>:
    let searcher = reader.searcher()
    let normalized_query = ignore__normalize_case(&(*request).query)
    let min_score = (*request).options.min_score_threshold.unwrap_or_else(|| scoring__get_min_score_for_query_length(normalized_query.len()))
    let ignored_paths = ignore__build_ignored_path_list(&[])
    let searcher_doc_count = searcher.num_docs() as usize
    let candidate_limit = index_query_candidate_limit(searcher_doc_count, request)
    let doc_addresses: Array<tantivy::DocAddress> = if (*request).query.is_empty():
        (searcher.search(query, &tantivy__collector__DocSetCollector).map_err(|error| error.to_string())?).into_iter().collect()
    else:
        (searcher.search(query, &TopDocs__with_limit(candidate_limit)).map_err(|error| error.to_string())?).into_iter().map(|__kain_closure_arg0| __kain_closure_arg0.__kain_tuple_1).collect()
    let mut results = Vec__new_()
    for doc_address in doc_addresses:
        let retrieved: tantivy::TantivyDocument = searcher.doc(doc_address).map_err(|error| error.to_string())?
        let Some(mut entry) = result_entry_from_index_document(fields, &retrieved, 1.0)
        let Some(score) = calculate_index_query_score(&entry.name, &normalized_query, min_score)
        entry.score = score
        ()
        if !matches_index_query_filters(&entry, request, &ignored_paths):
            continue
        results.push(entry)
        ()
    ()
    Result::Ok(results)

fn execute_plugin_index_query(reader: &tantivy::IndexReader, fields: &GlobalSearchIndexFields, request: &NormalizedGlobalSearchIndexQueryRequest) -> Result<Array<GlobalSearchResultEntry>, String>:
    let query = build_plugin_index_query(fields, request)
    let mut results = retrieve_index_query_entries(reader, fields, request, query)?
    sort_index_query_results(&mut results, request)
    ()
    Result::Ok(results.into_iter().skip((*request).offset).take((*request).limit).collect())

fn global_search_query(app: tauri::AppHandle, query: String, options: GlobalSearchQueryOptions) -> Result<Array<GlobalSearchResultEntry>, String>:
    let trimmed_query = query.trim()
    if trimmed_query.is_empty():
        return Result::Ok(Vec__new_())
    let (reader, fields) = open_search_reader(&app)?
    execute_index_query(&reader, &fields, trimmed_query, &options, none)

fn global_search_query_index(app: tauri::AppHandle, request: GlobalSearchIndexQueryRequest) -> Result<Array<GlobalSearchResultEntry>, String>:
    let normalized_request = normalize_index_query_request(request)
    let (reader, fields) = open_search_reader(&app)?
    execute_plugin_index_query(&reader, &fields, &normalized_request)

fn global_search_query_under_path(app: tauri::AppHandle, root_path: String, query: String, options: GlobalSearchQueryOptions) -> Result<Array<GlobalSearchResultEntry>, String>:
    let trimmed_query = query.trim()
    let normalized_root_path = normalize_scope_root_path(&root_path)
    if trimmed_query.is_empty() or normalized_root_path.is_empty():
        return Result::Ok(Vec__new_())
    let (reader, fields) = open_search_reader(&app)?
    execute_index_query(&reader, &fields, trimmed_query, &options, Option::Some(&normalized_root_path))

fn global_search_query_paths(paths: Array<String>, query: String, options: GlobalSearchQueryOptions) -> Result<Array<GlobalSearchResultEntry>, String>:
    let trimmed_query = query.trim()
    if paths.is_empty() or trimmed_query.is_empty():
        return Result::Ok(Vec__new_())
    let normalized_query = ignore__normalize_case(trimmed_query)
    let min_score = options.min_score_threshold.unwrap_or_else(|| scoring__get_min_score_for_query_length(normalized_query.len()))
    let mut searchable_paths = Vec__new_()
    for path_string in paths:
        let path = Path__new_(path_string.trim())
        if path.as_os_str().is_empty() or !path.exists():
            continue
        if path.is_dir():
            match std__fs__read_dir(path):
                Ok(entries) =>
                    for entry in entries.flatten():
                        searchable_paths.push(entry.path())
                        ()
                _ => ()
        else:
            searchable_paths.push(path.to_path_buf())
            ()
    ()
    let mut unique_results = BTreeMap__new_()
    for path in searchable_paths:
        let path_string = path.to_string_lossy().to_string()
        let name = match path.file_name().and_then(|segment| segment.to_str()):
            Some(name) => name.to_string()
            None => continue
        let name_score = scoring__calculate_similarity_score(&normalized_query, &name)
        if name_score < min_score:
            continue
        let metadata = match std__fs__metadata(&path):
            Ok(metadata) => metadata
            Err(_) => continue
        let is_file = metadata.is_file()
        let is_dir = metadata.is_dir()
        if !matches_type(
            if is_file:
                1
            else:
                0,
            if is_dir:
                1
            else:
                0,
            &options
        ):
            continue
        let (modified_time, accessed_time, created_time) = utils__metadata_times_unix_ms(&metadata)
        let size = if is_file:
            metadata.len()
        else:
            0
        unique_results.insert(path_string.clone(), GlobalSearchResultEntry { name: name, extension: utils__path_extension_lowercase(&path), path: path_string, size: size, modified_time: modified_time, accessed_time: accessed_time, created_time: created_time, is_file: is_file, is_dir: is_dir, is_symlink: metadata.file_type().is_symlink(), is_hidden: utils__is_hidden_path(&path), score: name_score })
        ()
    ()
    let mut results: Array<GlobalSearchResultEntry> = unique_results.into_values().collect()
    sort_results(&mut results)
    ()
    results.truncate(options.limit)
    ()
    Result::Ok(results)

struct CommittedIndexUpdate:
    doc_count: u64
    index_size_bytes: u64
    index: tantivy::Index
    reader: tantivy::IndexReader
    fields: GlobalSearchIndexFields

fn apply_committed_index_status(state: &mut GlobalSearchState, base_dir: &std::path::Path, update: CommittedIndexUpdate, advance_last_scan_time: Bool):
    let CommittedIndexUpdate { doc_count: doc_count, index_size_bytes: index_size_bytes, index: index, reader: reader, fields: fields } = update
    (*state).index = Option::Some(index)
    ()
    (*state).reader = Option::Some(reader)
    ()
    (*state).fields = Option::Some(fields)
    ()
    (*state).status.indexed_item_count = doc_count
    ()
    (*state).status.index_size_bytes = index_size_bytes
    ()
    (*state).status.is_index_valid = doc_count > 0
    ()
    if advance_last_scan_time:
        (*state).status.last_scan_time = Option::Some(state__now_millis())
        ()
        ()
        ()
        ()
    let _ = index__write_meta(base_dir, &GlobalSearchMeta { last_scan_time: (*state).status.last_scan_time, indexed_item_count: doc_count, schema_version: index__GLOBAL_SEARCH_SCHEMA_VERSION })

fn global_search_init(app: tauri::AppHandle) -> Result<GlobalSearchStatus, String>:
    let base_dir = app.path().app_data_dir().map_err(fn(error: tauri::Error): error.to_string())?
    let index_path = index__global_search_index_dir(&base_dir)
    let is_valid = index__validate_index(&index_path, &base_dir)
    if !is_valid:
        let _ = index__clear_index(&index_path)
        ()
    let (index_2, reader, fields_2) = index__open_or_create_index(&index_path)?
    let indexed_item_count = reader.searcher().num_docs()
    let index_size_bytes = index__calculate_dir_size(&index_path)
    let meta = index__read_meta(&base_dir)
    let mut state = state__GLOBAL_SEARCH_STATE.write().map_err(|error| error.to_string())?
    state.status.indexed_item_count = indexed_item_count
    ()
    state.status.index_size_bytes = index_size_bytes
    ()
    state.status.last_scan_time = meta.and_then(|entry| entry.last_scan_time)
    ()
    state.status.is_index_valid = is_valid and indexed_item_count > 0
    ()
    Result::Ok(state.status.clone())

fn add_path_document(writer: &mut tantivy::IndexWriter, fields: &GlobalSearchIndexFields, path: &std::path::Path):
    let metadata = match std__fs__metadata(path):
        Ok(metadata) => metadata
        Err(_) => return
    let is_dir = metadata.is_dir()
    let is_file = metadata.is_file()
    let name = match path.file_name().and_then(|segment| segment.to_str()):
        Some(name) => name.to_string()
        None => return
    let path_string = path.to_string_lossy().to_string()
    let modified_time = utils__metadata_modified_time_unix_ms(&metadata)
    let size = if is_file:
        metadata.len()
    else:
        0
    let _ = writer.add_document(doc!())

fn global_search_get_status() -> Result<GlobalSearchStatus, String>:
    let state = state__GLOBAL_SEARCH_STATE.read().map_err(|error| error.to_string())?
    Result::Ok(state.status.clone())

fn global_search_cancel_scan() -> Result<(), String>:
    let state = state__GLOBAL_SEARCH_STATE.read().map_err(|error| error.to_string())?
    state.cancel_flag.store(true, std::sync::atomic::Ordering::SeqCst)
    ()
    Result::Ok(())

fn build_walker(root_path: &std::path::Path, scan_depth: usize) -> ignore::Walk:
    let mut builder = WalkBuilder__new_(root_path)
    builder.follow_links(false).hidden(false).git_ignore(false).git_exclude(false).git_global(false).parents(false).same_file_system(true).max_depth(Option::Some(scan_depth.max(1)))
    ()
    builder.build()

fn scan_drive(root: String, scan_depth: usize, ignored_paths: &Slice<String>, fields: &GlobalSearchIndexFields, writer: &tantivy::IndexWriter, indexed_count: &std::sync::atomic::AtomicU64, cancel_flag: &std::sync::atomic::AtomicBool) -> Result<(), GlobalSearchDriveScanError>:
    let root_path = PathBuf__from(root)
    match std__fs__read_dir(&root_path):
        Err(error) =>
            return Result::Err(GlobalSearchDriveScanError { drive_root: root.to_string(), message: error.to_string() })
        _ =>
            ()
            ()
    let mut items_since_last_update = 0
    for entry_result in build_walker(&root_path, scan_depth):
        if cancel_flag.load(std::sync::atomic::Ordering::SeqCst):
            break
        let entry = match entry_result:
            Ok(entry) => entry
            Err(_) => continue
        if entry.depth() == 0:
            continue
        let path = entry.path()
        let path_string = path.to_string_lossy().to_string()
        if ignore__is_ignored_path(&path_string, ignored_paths):
            continue
        match writer.lock():
            Ok(mut locked_writer) =>
                add_path_document(&mut locked_writer, fields, path)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        indexed_count.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
        ()
        items_since_last_update = items_since_last_update + 1
        ()
        if items_since_last_update >= STATUS_UPDATE_INTERVAL:
            match state__GLOBAL_SEARCH_STATE.write():
                Ok(mut state) =>
                    state.status.indexed_item_count = indexed_count.load(std::sync::atomic::Ordering::Relaxed)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            items_since_last_update = 0
            ()
    ()
    Result::Ok(())

fn global_search_start_scan(app: tauri::AppHandle, settings: GlobalSearchScanSettings) -> Result<(), String>:
    let mut state = state__GLOBAL_SEARCH_STATE.write().map_err(|error| error.to_string())?
    if state.status.is_scan_in_progress:
        return Result::Ok(())
    state.status.is_scan_in_progress = true
    ()
    state.status.is_parallel_scan = settings.parallel_scan and settings.drive_roots.len() > 1
    ()
    state.status.current_drive_root = none
    ()
    state.status.indexed_item_count = 0
    ()
    state.status.drive_scan_errors = Vec__new_()
    ()
    state.status.scanned_drives_count = 0
    ()
    state.status.total_drives_count = settings.drive_roots.len() as u32
    ()
    state.cancel_flag.store(false, std::sync::atomic::Ordering::SeqCst)
    ()
    ()
    ()
    ()
    let base_dir = app.path().app_data_dir().map_err(fn(error: tauri::Error): error.to_string())?
    let index_path = index__global_search_index_dir(&base_dir)
    let cancel_flag = block:
        let state = state__GLOBAL_SEARCH_STATE.read().map_err(|error| error.to_string())?
        state.cancel_flag.clone()
    tauri__async_runtime__spawn_(
        async:
            let result = fn() -> Result<(u64, tantivy::Index, tantivy::IndexReader, GlobalSearchIndexFields, u64), String>:
                let (index, reader, fields) = index__open_or_create_index(&index_path)?
                let writer = index.writer(100000000).map_err(|error| error.to_string())?
                writer.delete_all_documents().map_err(|error| error.to_string())?
                ()
                let writer = Mutex__new_(writer)
                let ignored_paths = ignore__build_ignored_path_list(&settings.ignored_paths)
                let valid_drive_roots: Array<String> = settings.drive_roots.iter().map(|root| root.trim()).filter(|root| !root.is_empty()).filter(
                    |root| block:
                        let path = Path__new_(root)
                        path.exists() and path.is_dir()
                ).map(|root| root.to_string()).collect()
                if valid_drive_roots.is_empty():
                    match state__GLOBAL_SEARCH_STATE.write():
                        Ok(mut state) =>
                            state.status.is_scan_in_progress = false
                            ()
                            state.status.total_drives_count = 0
                            ()
                            state.status.current_drive_root = none
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    return Result::Err("No valid drive roots were available for global search.".to_string())
                match state__GLOBAL_SEARCH_STATE.write():
                    Ok(mut state) =>
                        state.status.total_drives_count = valid_drive_roots.len() as u32
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                let indexed_count = AtomicU64__new_(0)
                let mut errors = Vec__new_()
                if settings.parallel_scan and valid_drive_roots.len() > 1:
                    std__thread__scope(
                        |scope| block:
                            let handles: Array<_> = valid_drive_roots.iter().map(
                                |root| block:
                                    let root = root.clone()
                                    let ignored_paths = ignored_paths.clone()
                                    let writer_ref = &writer
                                    let indexed_count_ref = &indexed_count
                                    let cancel_flag_ref = &cancel_flag
                                    let scan_depth = settings.scan_depth
                                    scope.spawn_(
                                        || block:
                                            match state__GLOBAL_SEARCH_STATE.write():
                                                Ok(mut state) =>
                                                    state.status.current_drive_root = Option::Some(root.clone())
                                                    ()
                                                    ()
                                                    ()
                                                    ()
                                                _ =>
                                                    ()
                                                    ()
                                            let scan_result = scan_drive(&root, scan_depth, &ignored_paths, &fields, writer_ref, indexed_count_ref, cancel_flag_ref)
                                            match state__GLOBAL_SEARCH_STATE.write():
                                                Ok(mut state) =>
                                                    state.status.scanned_drives_count = state.status.scanned_drives_count + 1
                                                    ()
                                                    state.status.indexed_item_count = indexed_count_ref.load(std::sync::atomic::Ordering::Relaxed)
                                                    ()
                                                    ()
                                                    ()
                                                    ()
                                                _ =>
                                                    ()
                                                    ()
                                            scan_result
                                    )
                            ).collect()
                            for handle in handles:
                                match handle.join():
                                    Ok(Err(error)) =>
                                        errors.push(error)
                                        ()
                                    _ => ()
                    )
                    ()
                    ()
                    ()
                    ()
                else:
                    for (index, root) in valid_drive_roots.iter().enumerate():
                        if cancel_flag.load(std::sync::atomic::Ordering::SeqCst):
                            break
                        match state__GLOBAL_SEARCH_STATE.write():
                            Ok(mut state) =>
                                state.status.current_drive_root = Option::Some(root.clone())
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        match scan_drive(root, settings.scan_depth, &ignored_paths, &fields, &writer, &indexed_count, &cancel_flag):
                            Err(error) =>
                                errors.push(error)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        match state__GLOBAL_SEARCH_STATE.write():
                            Ok(mut state) =>
                                state.status.scanned_drives_count = (index + 1) as u32
                                ()
                                state.status.indexed_item_count = indexed_count.load(std::sync::atomic::Ordering::Relaxed)
                                ()
                            _ => ()
                    ()
                    ()
                match state__GLOBAL_SEARCH_STATE.write():
                    Ok(mut state) =>
                        state.status.drive_scan_errors = errors
                        ()
                        state.status.current_drive_root = none
                        ()
                        state.status.is_committing = true
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                let mut locked_writer = writer.lock().map_err(|error| error.to_string())?
                locked_writer.commit().map_err(|error| error.to_string())?
                ()
                drop(locked_writer)
                ()
                reader.reload().map_err(|error| error.to_string())?
                ()
                match state__GLOBAL_SEARCH_STATE.write():
                    Ok(mut state) =>
                        state.status.is_committing = false
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                let indexed_item_count = indexed_count.load(std::sync::atomic::Ordering::Relaxed)
                let index_size_bytes = index__calculate_dir_size(&index_path)
                Result::Ok((indexed_item_count, index, reader, fields, index_size_bytes))()
            match state__GLOBAL_SEARCH_STATE.write():
                Ok(mut state) =>
                    state.status.is_scan_in_progress = false
                    ()
                    state.status.is_parallel_scan = false
                    ()
                    state.status.current_drive_root = none
                    ()
                    let was_cancelled = state.cancel_flag.load(std::sync::atomic::Ordering::SeqCst)
                    match result:
                        Ok((doc_count, index, reader, fields, index_size_bytes)) =>
                            apply_committed_index_status(&mut state, &base_dir, CommittedIndexUpdate { doc_count: doc_count, index_size_bytes: index_size_bytes, index: index, reader: reader, fields: fields }, !was_cancelled)
                            ()
                        _ => ()
                _ => ()
    )
    ()
    Result::Ok(())

fn calculate_similarity_score(query: String, name: String) -> f32:
    let query_lower = query.to_lowercase()
    let name_lower = name.to_lowercase()
    if name_lower == query_lower:
        return 1.0
    if name_lower.starts_with(&query_lower):
        return 0.95 + (query_lower.len() as f32 / name_lower.len() as f32) * 0.05
    if name_lower.contains(&query_lower):
        return 0.8 + (query_lower.len() as f32 / name_lower.len() as f32) * 0.15
    let query_tokens: Array<String> = query_lower.split(fn(character: Char): character.is_whitespace() or character == "." or character == "_" or character == "-").filter(|segment| !segment.is_empty()).collect()
    let name_tokens: Array<String> = name_lower.split(fn(character: Char): character.is_whitespace() or character == "." or character == "_" or character == "-").filter(|segment| !segment.is_empty()).collect()
    if !query_tokens.is_empty() and !name_tokens.is_empty():
        let mut matched_count = 0
        let mut partial_match_score = 0.0
        for query_token in &query_tokens:
            let mut best_token_score = 0.0
            for name_token in &name_tokens:
                if *name_token == *query_token:
                    best_token_score = 1.0
                    ()
                    break
                else if name_token.starts_with(query_token):
                    best_token_score = best_token_score.max(0.9)
                    ()
                else if name_token.contains(query_token):
                    best_token_score = best_token_score.max(0.8)
                    ()
                else:
                    let query_chars: Array<Char> = query_token.chars().collect()
                    let name_chars: Array<Char> = name_token.chars().collect()
                    if !query_chars.is_empty() and !name_chars.is_empty():
                        let distance = levenshtein_distance(&query_chars, &name_chars)
                        let max_len = query_chars.len().max(name_chars.len())
                        if distance <= 2 and max_len > 0:
                            let similarity = 1.0 - (distance as f32 / max_len as f32)
                            best_token_score = best_token_score.max(similarity * 0.7)
                            ()
            ()
            if best_token_score > 0.5:
                matched_count = matched_count + 1
                ()
                ()
                ()
                ()
            partial_match_score = partial_match_score + best_token_score
            ()
        ()
        let match_ratio = matched_count as f32 / query_tokens.len() as f32
        let average_token_score = partial_match_score / query_tokens.len() as f32
        if match_ratio >= 0.5:
            return 0.6 + (match_ratio * 0.2) + (average_token_score * 0.15)
        ()
    let query_chars: Array<Char> = query_lower.chars().collect()
    let name_chars: Array<Char> = name_lower.chars().collect()
    if query_chars.is_empty() or name_chars.is_empty():
        return 0.0
    let distance = levenshtein_distance(&query_chars, &name_chars)
    let max_len = query_chars.len().max(name_chars.len()) as f32
    let similarity = 1.0 - (distance as f32 / max_len)
    similarity.max(0.0)

fn levenshtein_distance(first: &Slice<Char>, second: &Slice<Char>) -> usize:
    let first_len = first.len()
    let second_len = second.len()
    if first_len == 0:
        return second_len
    if second_len == 0:
        return first_len
    let mut previous_row: Array<usize> = 0..=second_len.collect()
    let mut current_row: Array<usize> = vec!()
    for row_index in 1..=first_len:
        current_row[0] = row_index
        ()
        for column_index in 1..=second_len:
            let cost = if first[row_index - 1] == second[column_index - 1]:
                0
            else:
                1
            current_row[column_index] = (previous_row[column_index] + 1).min(current_row[column_index - 1] + 1).min(previous_row[column_index - 1] + cost)
            ()
        ()
        std__mem__swap(&mut previous_row, &mut current_row)
        ()
    ()
    previous_row[second_len]

fn get_min_score_for_query_length(query_length: usize) -> f32:
    match query_length:
        1..=3 => 0.9
        4..=6 => 0.65
        7..=9 => 0.55
        _ => 0.5

struct GlobalSearchIndexFields:
    path: tantivy::schema::Field
    name: tantivy::schema::Field
    name_lower: tantivy::schema::Field
    is_file: tantivy::schema::Field
    is_dir: tantivy::schema::Field
    modified_time: tantivy::schema::Field
    size: tantivy::schema::Field

struct GlobalSearchState:
    status: GlobalSearchStatus
    index: Option<tantivy::Index>
    reader: Option<tantivy::IndexReader>
    fields: Option<GlobalSearchIndexFields>
    cancel_flag: std::sync::atomic::AtomicBool

fn now_millis() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_millis() as u64).unwrap_or(0)

struct GlobalSearchScanSettings:
    scan_depth: usize
    ignored_paths: Array<String>
    drive_roots: Array<String>
    parallel_scan: Bool

struct GlobalSearchDriveScanError:
    drive_root: String
    message: String

struct GlobalSearchQueryOptions:
    limit: usize
    include_files: Bool
    include_directories: Bool
    exact_match: Bool
    typo_tolerance: Bool
    min_score_threshold: Option<f32>

enum GlobalSearchIndexSortKey:
    Relevance
    ModifiedTime
    Name
    Path
    Size

enum GlobalSearchIndexSortDirection:
    Asc
    Desc

struct GlobalSearchIndexQueryRequest:
    query: Option<String>
    limit: usize
    offset: usize
    include_files: Bool
    include_directories: Bool
    include_hidden: Bool
    extensions: Array<String>
    root_paths: Array<String>
    exact_match: Bool
    typo_tolerance: Bool
    min_score_threshold: Option<f32>
    sort_key: Option<GlobalSearchIndexSortKey>
    sort_direction: Option<GlobalSearchIndexSortDirection>

struct GlobalSearchResultEntry:
    name: String
    extension: Option<String>
    path: String
    size: u64
    modified_time: u64
    accessed_time: u64
    created_time: u64
    is_file: Bool
    is_dir: Bool
    is_symlink: Bool
    is_hidden: Bool
    score: f32

struct GlobalSearchStatus:
    is_scan_in_progress: Bool
    is_committing: Bool
    is_parallel_scan: Bool
    last_scan_time: Option<u64>
    indexed_item_count: u64
    index_size_bytes: u64
    current_drive_root: Option<String>
    drive_scan_errors: Array<GlobalSearchDriveScanError>
    is_index_valid: Bool
    scanned_drives_count: u32
    total_drives_count: u32

fn path_extension_lowercase(path: &std::path::Path) -> Option<String>:
    path.extension().and_then(|extension| extension.to_str()).map(|extension| extension.to_lowercase())

fn is_hidden_path(path: &std::path::Path) -> Bool:
    match std__fs__metadata(path):
        Ok(metadata) =>
            return (metadata.file_attributes() & FILE_ATTRIBUTE_HIDDEN) != 0
        _ =>
            ()
            ()
    false
    ()
    ()
    path.file_name().and_then(|name| name.to_str()).map(|name| name.starts_with(".")).unwrap_or(false)

fn system_time_unix_ms(value: Result<std::time::SystemTime, io::Error>) -> u64:
    value.ok().and_then(|time| time.duration_since(std__time__UNIX_EPOCH).ok()).map(|duration| duration.as_millis() as u64).unwrap_or(0)

fn metadata_modified_time_unix_ms(metadata: &std::fs::Metadata) -> u64:
    system_time_unix_ms(metadata.modified())

fn metadata_times_unix_ms(metadata: &std::fs::Metadata) -> (u64, u64, u64):
    (metadata_modified_time_unix_ms(metadata), system_time_unix_ms(metadata.accessed()), system_time_unix_ms(metadata.created()))

struct GpuCapabilityProfile:
    adapter_name: String
    adapter_type: String
    backend_name: String
    software_renderer: Bool
    compute_available: Bool
    max_texture_dimension_2d: u32
    max_buffer_size: u64
    max_storage_buffer_binding_size: u32
    device_type: wgpu::DeviceType

struct GpuAdapterProbe:
    instance: wgpu::Instance
    adapter: wgpu::Adapter
    profile: GpuCapabilityProfile

fn power_preference_for_mode(mode: GpuTierMode) -> wgpu::PowerPreference:
    match mode:
        GpuTierMode::Auto => wgpu::PowerPreference::None
        GpuTierMode::Safe | GpuTierMode::Integrated => wgpu::PowerPreference::LowPower
        GpuTierMode::Discrete => wgpu::PowerPreference::HighPerformance

fn request_adapter_probe(power_preference: wgpu::PowerPreference) -> Result<Option<GpuAdapterProbe>, String>:
    let instance = Instance__new_(&wgpu::InstanceDescriptor { backends: Backends__all(), ..Default__default_() })
    let adapter = match pollster__block_on(instance.request_adapter(&wgpu::RequestAdapterOptions { power_preference: power_preference, force_fallback_adapter: false, compatible_surface: none })):
        Ok(adapter) => adapter
        Err(_) => return Result::Ok(none)
    let profile = profile_from_adapter(&adapter)
    Result::Ok(Option::Some(GpuAdapterProbe { instance: instance, adapter: adapter, profile: profile }))

fn profile_from_adapter(adapter: &wgpu::Adapter) -> GpuCapabilityProfile:
    let info = adapter.get_info()
    let limits = adapter.limits()
    let software_renderer = matches!(info.device_type, wgpu::DeviceType::Cpu)
    let compute_available = limits.max_storage_buffers_per_shader_stage > 0 and limits.max_compute_workgroup_storage_size > 0
    GpuCapabilityProfile { adapter_name: info.name, adapter_type: device_type_label(info.device_type).to_string(), backend_name: backend_label(info.backend).to_string(), software_renderer: software_renderer, compute_available: compute_available, max_texture_dimension_2d: limits.max_texture_dimension_2d, max_buffer_size: limits.max_buffer_size, max_storage_buffer_binding_size: limits.max_storage_buffer_binding_size, device_type: info.device_type }

fn resolve_effective_tier(configured_mode: GpuTierMode, profile: Option<&GpuCapabilityProfile>) -> GpuEffectiveTier:
    let Some(profile) = profile
    if profile.software_renderer or !profile.compute_available:
        return GpuEffectiveTier::Safe
    match configured_mode:
        GpuTierMode::Safe => GpuEffectiveTier::Safe
        GpuTierMode::Integrated => GpuEffectiveTier::Integrated
        GpuTierMode::Discrete => GpuEffectiveTier::Discrete
        GpuTierMode::Auto =>
            match profile.device_type:
                wgpu::DeviceType::DiscreteGpu => GpuEffectiveTier::Discrete
                wgpu::DeviceType::IntegratedGpu | wgpu::DeviceType::VirtualGpu | wgpu::DeviceType::Other => GpuEffectiveTier::Integrated
                wgpu::DeviceType::Cpu => GpuEffectiveTier::Safe

fn backend_label(backend: wgpu::Backend) -> String:
    match backend:
        wgpu::Backend::Vulkan => "Vulkan"
        wgpu::Backend::Metal => "Metal"
        wgpu::Backend::Dx12 => "DirectX 12"
        wgpu::Backend::Gl => "OpenGL"
        wgpu::Backend::BrowserWebGpu => "Browser WebGPU"
        wgpu::Backend::Noop => "Noop"

fn device_type_label(device_type: wgpu::DeviceType) -> String:
    match device_type:
        wgpu::DeviceType::DiscreteGpu => "discrete-gpu"
        wgpu::DeviceType::IntegratedGpu => "integrated-gpu"
        wgpu::DeviceType::VirtualGpu => "virtual-gpu"
        wgpu::DeviceType::Cpu => "cpu"
        wgpu::DeviceType::Other => "other"

struct GpuRuntimeManager:
    inner: GpuRuntimeManagerInner

struct GpuRuntimeManagerInner:
    app_handle: Option<tauri::AppHandle>
    configuration: GpuRuntimeConfiguration
    effective_tier: GpuEffectiveTier
    capabilities: Option<GpuCapabilityProfile>
    resources: Option<GpuRuntimeResources>
    workload_telemetry: Map<GpuRuntimeWorkloadId, GpuWorkloadTelemetryState>
    queue_depth: std::sync::atomic::AtomicU32
    runtime_error: Option<String>

impl Default for GpuRuntimeManager:
    fn default_() -> GpuRuntimeManager:
        GpuRuntimeManager { inner: Arc__new_(GpuRuntimeManagerInner { app_handle: Mutex__new_(none), configuration: RwLock__new_(GpuRuntimeConfiguration__default_()), effective_tier: RwLock__new_(GpuEffectiveTier::Safe), capabilities: RwLock__new_(none), resources: Mutex__new_(none), workload_telemetry: Mutex__new_(scheduler__default_workload_state_map()), queue_depth: AtomicU32__new_(0), runtime_error: RwLock__new_(none) }) }


impl GpuRuntimeManager:
    fn new_(app_handle: tauri::AppHandle) -> GpuRuntimeManager:
        let runtime = GpuRuntimeManager__default_()
        runtime.attach_app_handle(app_handle)
        ()
        runtime

    fn attach_app_handle(_self: &GpuRuntimeManager, app_handle: tauri::AppHandle):
        *(*_self).inner.app_handle.lock().expect("gpu runtime app handle poisoned") = Option::Some(app_handle)
        ()

    fn status_snapshot(_self: &GpuRuntimeManager) -> GpuRuntimeStatusSnapshot:
        let configured_mode = (*_self).inner.configuration.read().expect("gpu runtime configuration poisoned").tier_override
        let effective_tier = *(*_self).inner.effective_tier.read().expect("gpu runtime effective tier poisoned")
        let capabilities = (*_self).inner.capabilities.read().expect("gpu runtime capabilities poisoned").clone()
        let runtime_error = (*_self).inner.runtime_error.read().expect("gpu runtime error state poisoned").clone()
        let workload_telemetry = (*_self).inner.workload_telemetry.lock().expect("gpu runtime workload telemetry poisoned").clone()
        let resources_ready = (*_self).inner.resources.lock().expect("gpu runtime resources poisoned").is_some()
        let mut snapshot = GpuRuntimeStatusSnapshot { configured_mode: configured_mode, effective_tier: effective_tier, adapter_name: capabilities.map(|value| value.adapter_name.clone()), adapter_type: capabilities.map(|value| value.adapter_type.clone()), backend_name: capabilities.map(|value| value.backend_name.clone()), software_renderer: capabilities.map(|value| value.software_renderer).unwrap_or(false), compute_available: capabilities.map(|value| value.compute_available).unwrap_or(false), queue_depth: (*_self).inner.queue_depth.load(std::sync::atomic::Ordering::Relaxed), runtime_error: runtime_error, workloads: Vec__new_() }
        scheduler__apply_snapshot_workloads(&mut snapshot, effective_tier, resources_ready, &workload_telemetry)
        ()
        snapshot

    fn configure(_self: &GpuRuntimeManager, configuration: GpuRuntimeConfiguration) -> Result<GpuRuntimeStatusSnapshot, String>:
        *(*_self).inner.configuration.write().expect("gpu runtime configuration poisoned") = configuration.clone()
        ()
        let adapter_probe = capabilities__request_adapter_probe(capabilities__power_preference_for_mode(configuration.tier_override))?
        let capability_profile = adapter_probe.map(|probe| probe.profile.clone())
        let effective_tier = capabilities__resolve_effective_tier(configuration.tier_override, capability_profile)
        *(*_self).inner.capabilities.write().expect("gpu runtime capabilities poisoned") = capability_profile.clone()
        ()
        *(*_self).inner.effective_tier.write().expect("gpu runtime effective tier poisoned") = effective_tier
        ()
        let runtime_error = if effective_tier == GpuEffectiveTier::Safe:
            none
        else:
            if capability_profile.is_some_and(|profile| profile.software_renderer):
                Option::Some("Software GPU adapters are blocked for the native GPU runtime.".to_string())
            else if capability_profile.is_some_and(|profile| !profile.compute_available):
                Option::Some("The detected GPU adapter does not expose compute-capable limits.".to_string())
            else:
                match adapter_probe:
                    Some(adapter_probe) =>
                        match GpuRuntimeResources__from_probe(adapter_probe, effective_tier):
                            Ok(resources) =>
                                *(*_self).inner.resources.lock().expect("gpu runtime resources poisoned") = Option::Some(Arc__new_(resources))
                                ()
                                none
                            Err(error) => Option::Some(error)
                    _ =>
                        Option::Some("No hardware GPU adapter was available.".to_string())
        if effective_tier == GpuEffectiveTier::Safe:
            *(*_self).inner.resources.lock().expect("gpu runtime resources poisoned") = none
            ()
            ()
            ()
            ()
        if runtime_error.is_some():
            *(*_self).inner.resources.lock().expect("gpu runtime resources poisoned") = none
            ()
            ()
            ()
            ()
        *(*_self).inner.runtime_error.write().expect("gpu runtime error state poisoned") = runtime_error
        ()
        (*_self).emit_status()
        ()
        Result::Ok((*_self).status_snapshot())

    fn render_image_thumbnail(_self: &GpuRuntimeManager, source: &image::RgbaImage, target_width: u32, target_height: u32) -> Result<image::RgbaImage, String>:
        (*_self).execute_workload(GpuRuntimeWorkloadId::ImageThumbnail, |resources, tier| workloads__thumbnail__render_image_thumbnail(resources, source, target_width, target_height, tier))

    fn render_image_preview(_self: &GpuRuntimeManager, source: &image::RgbaImage, target_width: u32, target_height: u32, effective_state: ImageAdjustmentState) -> Result<image::RgbaImage, String>:
        (*_self).execute_workload(GpuRuntimeWorkloadId::ImagePreview, |resources, tier| workloads__image_preview__render_image_preview(resources, source, target_width, target_height, effective_state, tier))

    fn reduce_audio_waveform(_self: &GpuRuntimeManager, mono_samples: &Slice<f32>, bucket_count: usize) -> Result<Array<AudioWaveformBucket>, String>:
        (*_self).execute_workload(GpuRuntimeWorkloadId::AudioWaveform, |resources, tier| workloads__audio_visuals__reduce_waveform_buckets(resources, mono_samples, bucket_count, tier))

    fn reduce_audio_spectral_bands(_self: &GpuRuntimeManager, fft_samples: &Slice<f32>, band_count: usize) -> Result<Array<f64>, String>:
        (*_self).execute_workload(GpuRuntimeWorkloadId::AudioSpectralBands, |resources, tier| workloads__audio_visuals__reduce_spectral_bands(resources, fft_samples, band_count, tier))

    fn render_audio_spectrogram(_self: &GpuRuntimeManager, mono_samples: &Slice<f32>, width: u32, height: u32) -> Result<image::RgbaImage, String>:
        (*_self).execute_workload(GpuRuntimeWorkloadId::AudioSpectrogram, |resources, tier| workloads__audio_visuals__render_spectrogram(resources, mono_samples, width, height, tier))

    fn render_audio_thumbnail(_self: &GpuRuntimeManager, mono_samples: &Slice<f32>, width: u32, height: u32) -> Result<image::RgbaImage, String>:
        (*_self).execute_workload(GpuRuntimeWorkloadId::AudioThumbnail, |resources, tier| workloads__audio_visuals__render_spectrogram(resources, mono_samples, width, height, tier))

    fn execute_workload(_self: &GpuRuntimeManager, workload_id: GpuRuntimeWorkloadId, workload: F) -> Result<T, String>:
        let effective_tier = *(*_self).inner.effective_tier.read().expect("gpu runtime effective tier poisoned")
        if effective_tier == GpuEffectiveTier::Safe:
            (*_self).record_fallback(workload_id, GpuFallbackReason::SafeTierForcedCpu, none, Option::Some("safe mode".to_string()))
            ()
            return Result::Err("The native GPU runtime is currently running in safe mode.".to_string())
        let Some(resources) = (*_self).inner.resources.lock().expect("gpu runtime resources poisoned").clone()
        let spec = registry__workload_spec(workload_id)
        let Some(execution_tier) = scheduler__resolve_workload_execution_tier(spec, effective_tier)
        (*_self).inner.queue_depth.fetch_add(1, std::sync::atomic::Ordering::SeqCst)
        ()
        (*_self).emit_status()
        ()
        let result = workload(&resources, execution_tier)
        (*_self).inner.queue_depth.fetch_sub(1, std::sync::atomic::Ordering::SeqCst)
        ()
        match result:
            Ok(value) =>
                (*_self).record_execution(workload_id, execution_tier)
                ()
                (*_self).emit_status()
                ()
                Result::Ok(value)
            Err(error) =>
                let fallback_reason = if error.contains("tier budget"):
                    GpuFallbackReason::WorkloadBudgetExceeded
                else:
                    GpuFallbackReason::ExecutionFailed
                (*_self).record_fallback(workload_id, fallback_reason, Option::Some(error.clone()), Option::Some(format!("cpu-fallback({error})")))
                ()
                (*_self).emit_status()
                ()
                Result::Err(error)

    fn record_execution(_self: &GpuRuntimeManager, workload_id: GpuRuntimeWorkloadId, execution_tier: GpuEffectiveTier):
        let mut telemetry = (*_self).inner.workload_telemetry.lock().expect("gpu runtime workload telemetry poisoned")
        let state = telemetry.entry(workload_id).or_default()
        state.executions = state.executions + 1
        ()
        state.last_execution_path = Option::Some(match execution_tier:
            GpuEffectiveTier::Integrated => "gpu-integrated".to_string()
            GpuEffectiveTier::Discrete => "gpu-discrete".to_string()
            GpuEffectiveTier::Safe => "cpu-fallback".to_string())
        ()
        state.last_error = none
        ()
        state.last_fallback_reason = none
        ()

    fn record_fallback(_self: &GpuRuntimeManager, workload_id: GpuRuntimeWorkloadId, reason: GpuFallbackReason, error: Option<String>, execution_path: Option<String>):
        let mut telemetry = (*_self).inner.workload_telemetry.lock().expect("gpu runtime workload telemetry poisoned")
        let state = telemetry.entry(workload_id).or_default()
        state.fallback_count = state.fallback_count + 1
        ()
        state.last_execution_path = execution_path.or_else(|| Option::Some("cpu-fallback".to_string()))
        ()
        state.last_fallback_reason = Option::Some(reason)
        ()
        state.last_error = error
        ()

    fn emit_status(_self: &GpuRuntimeManager):
        match (*_self).inner.app_handle.lock().expect("gpu runtime app handle poisoned").clone():
            Some(app_handle) =>
                let _ = GpuRuntimeStatusEvent { state: (*_self).status_snapshot() }.emit_(&app_handle)
            _ => ()


fn set_global_gpu_runtime(manager: GpuRuntimeManager):
    let _ = GLOBAL_GPU_RUNTIME.set(manager)

fn global_gpu_runtime() -> Option<&GpuRuntimeManager>:
    GLOBAL_GPU_RUNTIME.get()

fn gpu_runtime_configure(manager: tauri::State<_, GpuRuntimeManager>, configuration: GpuRuntimeConfiguration) -> Result<GpuRuntimeStatusSnapshot, String>:
    manager.configure(configuration)

fn gpu_runtime_get_status(manager: tauri::State<_, GpuRuntimeManager>) -> Result<GpuRuntimeStatusSnapshot, String>:
    Result::Ok(manager.status_snapshot())

struct GpuBuiltInWorkloadSpec:
    id: GpuRuntimeWorkloadId
    label: String
    supported_tiers: &Slice<GpuEffectiveTier>
    execution_budget_tier: GpuEffectiveTier
    cache_policy: String
    kernel_labels: &Slice<String>

fn built_in_workload_specs() -> &Slice<GpuBuiltInWorkloadSpec>:
    BUILT_IN_WORKLOADS

fn workload_spec(id: GpuRuntimeWorkloadId) -> &GpuBuiltInWorkloadSpec:
    BUILT_IN_WORKLOADS.iter().find(|spec| spec.id == id).expect("gpu runtime workload spec missing")

struct GpuRuntimeResources:
    instance: wgpu::Instance
    adapter: wgpu::Adapter
    device: wgpu::Device
    queue: wgpu::Queue
    profile: GpuCapabilityProfile
    shader_modules: Map<String, wgpu::ShaderModule>

impl GpuRuntimeResources:
    fn from_probe(probe: GpuAdapterProbe, effective_tier: GpuEffectiveTier) -> Result<GpuRuntimeResources, String>:
        let memory_hints = match effective_tier:
            GpuEffectiveTier::Discrete => wgpu::MemoryHints::Performance
            GpuEffectiveTier::Integrated | GpuEffectiveTier::Safe => wgpu::MemoryHints::MemoryUsage
        let (device, queue) = pollster__block_on(probe.adapter.request_device(&wgpu::DeviceDescriptor { label: Option::Some("greeblefs-native-gpu-runtime"), required_features: Features__empty(), required_limits: probe.adapter.limits(), memory_hints: memory_hints, trace: wgpu::Trace::Off })).map_err(|error| format!("Failed to create GPU device: {error}"))?
        device.on_uncaptured_error(Box__new_(|error| log::error!("GreebleFS GPU runtime uncaptured wgpu error: {error}")))
        ()
        Result::Ok(GpuRuntimeResources { instance: probe.instance, adapter: probe.adapter, device: device, queue: queue, profile: probe.profile, shader_modules: Mutex__new_(HashMap__new_()) })

    fn device(_self: &GpuRuntimeResources) -> &wgpu::Device:
        &(*_self).device

    fn queue(_self: &GpuRuntimeResources) -> &wgpu::Queue:
        &(*_self).queue

    fn shader_module(_self: &GpuRuntimeResources, label: String, source: KernelSource) -> Result<wgpu::ShaderModule, String>:
        match (*_self).shader_modules.lock().expect("gpu shader module cache poisoned").get(label).cloned():
            Some(existing) =>
                return Result::Ok(existing)
            _ =>
                ()
                ()
        let descriptor = match source:
            KernelSource::Wgsl(source) => wgpu::ShaderModuleDescriptor { label: Option::Some(label), source: wgpu::ShaderSource::Wgsl(source.into()) }
            KernelSource::Spirv(words) =>
                return Result::Err("SPIR-V kernel ingestion is reserved for a later runtime revision.".to_string())
        let module = Arc__new_((*_self).device.create_shader_module(descriptor))
        (*_self).shader_modules.lock().expect("gpu shader module cache poisoned").insert(label, module.clone())
        ()
        Result::Ok(module)

    fn create_sampled_rgba_texture(_self: &GpuRuntimeResources, label: String, image: &image::RgbaImage) -> Result<wgpu::Texture, String>:
        (*_self).ensure_texture_extent(label, image.width(), image.height())?
        ()
        let texture = (*_self).device.create_texture(&wgpu::TextureDescriptor { label: Option::Some(label), size: wgpu::Extent3d { width: image.width(), height: image.height(), depth_or_array_layers: 1 }, mip_level_count: 1, sample_count: 1, dimension: wgpu::TextureDimension::D2, format: wgpu::TextureFormat::Rgba8Unorm, usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST, view_formats: &[] })
        (*_self).queue.write_texture(wgpu::TexelCopyTextureInfo { texture: &texture, mip_level: 0, origin: wgpu::Origin3d::ZERO, aspect: wgpu::TextureAspect::All }, image.as_raw(), wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Option::Some(image.width() * 4), rows_per_image: Option::Some(image.height()) }, wgpu::Extent3d { width: image.width(), height: image.height(), depth_or_array_layers: 1 })
        ()
        Result::Ok(texture)

    fn create_storage_rgba_texture(_self: &GpuRuntimeResources, label: String, width: u32, height: u32) -> Result<wgpu::Texture, String>:
        (*_self).ensure_texture_extent(label, width, height)?
        ()
        Result::Ok((*_self).device.create_texture(&wgpu::TextureDescriptor { label: Option::Some(label), size: wgpu::Extent3d { width: width, height: height, depth_or_array_layers: 1 }, mip_level_count: 1, sample_count: 1, dimension: wgpu::TextureDimension::D2, format: wgpu::TextureFormat::Rgba8Unorm, usage: wgpu::TextureUsages::STORAGE_BINDING | wgpu::TextureUsages::COPY_SRC, view_formats: &[] }))

    fn create_linear_sampler(_self: &GpuRuntimeResources, label: String) -> wgpu::Sampler:
        (*_self).device.create_sampler(&wgpu::SamplerDescriptor { label: Option::Some(label), mag_filter: wgpu::FilterMode::Linear, min_filter: wgpu::FilterMode::Linear, mipmap_filter: wgpu::FilterMode::Nearest, address_mode_u: wgpu::AddressMode::ClampToEdge, address_mode_v: wgpu::AddressMode::ClampToEdge, address_mode_w: wgpu::AddressMode::ClampToEdge, ..Default__default_() })

    fn create_uniform_buffer(_self: &GpuRuntimeResources, label: String, data: &T) -> wgpu::Buffer:
        (*_self).device.create_buffer_init(&wgpu::util::BufferInitDescriptor { label: Option::Some(label), contents: bytemuck__bytes_of(data), usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST })

    fn create_storage_buffer_from_bytes(_self: &GpuRuntimeResources, label: String, bytes: &Slice<u8>) -> Result<wgpu::Buffer, String>:
        (*_self).ensure_storage_buffer_size(label, bytes.len() as u64)?
        ()
        Result::Ok((*_self).device.create_buffer_init(&wgpu::util::BufferInitDescriptor { label: Option::Some(label), contents: bytes, usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST }))

    fn create_zeroed_storage_buffer(_self: &GpuRuntimeResources, label: String, size: u64) -> Result<wgpu::Buffer, String>:
        (*_self).ensure_storage_buffer_size(label, size)?
        ()
        Result::Ok((*_self).device.create_buffer(&wgpu::BufferDescriptor { label: Option::Some(label), size: size, usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC, mapped_at_creation: false }))

    fn read_buffer(_self: &GpuRuntimeResources, source: &wgpu::Buffer, size: u64) -> Result<Array<u8>, String>:
        (*_self).ensure_buffer_size("greeblefs-gpu-readback", size)?
        ()
        let staging_buffer = (*_self).device.create_buffer(&wgpu::BufferDescriptor { label: Option::Some("greeblefs-gpu-readback"), size: size, usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ, mapped_at_creation: false })
        let mut encoder = (*_self).device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Option::Some("greeblefs-gpu-readback-encoder") })
        encoder.copy_buffer_to_buffer(source, 0, &staging_buffer, 0, size)
        ()
        (*_self).queue.submit(std__iter__once(encoder.finish()))
        ()
        let slice = staging_buffer.slice(..)
        let (tx, rx) = std__sync__mpsc__channel()
        slice.map_async(wgpu::MapMode::Read, |result| let _ = tx.send_(result))
        ()
        let _ = (*_self).device.poll(wgpu::PollType::Wait)
        (rx.recv().map_err(|error| format!("Failed to receive GPU buffer readback callback: {error}"))?).map_err(|error| format!("Failed to map GPU readback buffer: {error:?}"))?
        ()
        let data = slice.get_mapped_range().to_vec()
        let _ = slice
        staging_buffer.unmap()
        ()
        Result::Ok(data)

    fn read_rgba_texture(_self: &GpuRuntimeResources, texture: &wgpu::Texture, width: u32, height: u32) -> Result<image::RgbaImage, String>:
        (*_self).ensure_texture_extent("greeblefs-gpu-texture-readback", width, height)?
        ()
        let bytes_per_row = width.saturating_mul(4)
        let padded_bytes_per_row = bytes_per_row.div_ceil(wgpu__COPY_BYTES_PER_ROW_ALIGNMENT) * wgpu__COPY_BYTES_PER_ROW_ALIGNMENT
        let readback_size = padded_bytes_per_row as u64 * height as u64
        (*_self).ensure_buffer_size("greeblefs-gpu-texture-readback", readback_size)?
        ()
        let staging_buffer = (*_self).device.create_buffer(&wgpu::BufferDescriptor { label: Option::Some("greeblefs-gpu-texture-readback"), size: readback_size, usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ, mapped_at_creation: false })
        let mut encoder = (*_self).device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Option::Some("greeblefs-gpu-texture-readback-encoder") })
        encoder.copy_texture_to_buffer(wgpu::TexelCopyTextureInfo { texture: texture, mip_level: 0, origin: wgpu::Origin3d::ZERO, aspect: wgpu::TextureAspect::All }, wgpu::TexelCopyBufferInfo { buffer: &staging_buffer, layout: wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Option::Some(padded_bytes_per_row), rows_per_image: Option::Some(height) } }, wgpu::Extent3d { width: width, height: height, depth_or_array_layers: 1 })
        ()
        (*_self).queue.submit(std__iter__once(encoder.finish()))
        ()
        let slice = staging_buffer.slice(..)
        let (tx, rx) = std__sync__mpsc__channel()
        slice.map_async(wgpu::MapMode::Read, |result| let _ = tx.send_(result))
        ()
        let _ = (*_self).device.poll(wgpu::PollType::Wait)
        (rx.recv().map_err(|error| format!("Failed to receive GPU texture readback callback: {error}"))?).map_err(|error| format!("Failed to map GPU texture readback buffer: {error:?}"))?
        ()
        let mapped = slice.get_mapped_range()
        let mut output = |__kain_ctor_arg0| Vec::new()((width * height * 4) as usize)
        for row in 0..height:
            let row_offset = row as usize * padded_bytes_per_row as usize
            output.extend_from_slice(&mapped[row_offset..row_offset + bytes_per_row as usize])
            ()
        ()
        drop(mapped)
        ()
        staging_buffer.unmap()
        ()
        RgbaImage__from_raw(width, height, output).ok_or_else(|| "Failed to reconstruct readback RGBA image.".to_string())

    fn ensure_texture_extent(_self: &GpuRuntimeResources, label: String, width: u32, height: u32) -> Result<(), String>:
        let max_dimension = (*_self).profile.max_texture_dimension_2d
        if width > max_dimension or height > max_dimension:
            return Result::Err(format!("GPU resource '{label}' exceeds adapter texture limit ({width}x{height} > {max_dimension})."))
        Result::Ok(())

    fn ensure_storage_buffer_size(_self: &GpuRuntimeResources, label: String, size: u64) -> Result<(), String>:
        (*_self).ensure_buffer_size(label, size)?
        ()
        let max_storage_binding = (*_self).profile.max_storage_buffer_binding_size as u64
        if size > max_storage_binding:
            return Result::Err(format!("GPU resource '{label}' exceeds adapter storage binding limit ({size} > {max_storage_binding})."))
        Result::Ok(())

    fn ensure_buffer_size(_self: &GpuRuntimeResources, label: String, size: u64) -> Result<(), String>:
        if size > (*_self).profile.max_buffer_size:
            return Result::Err(format!("GPU resource '{label}' exceeds adapter buffer limit ({size} > {}).", (*_self).profile.max_buffer_size))
        Result::Ok(())


struct GpuWorkloadTelemetryState:
    executions: u64
    fallback_count: u64
    last_execution_path: Option<String>
    last_fallback_reason: Option<GpuFallbackReason>
    last_error: Option<String>

impl Default for GpuWorkloadTelemetryState:
    fn default_() -> GpuWorkloadTelemetryState:
        GpuWorkloadTelemetryState { executions: 0, fallback_count: 0, last_execution_path: none, last_fallback_reason: none, last_error: none }


fn default_workload_state_map() -> Map<GpuRuntimeWorkloadId, GpuWorkloadTelemetryState>:
    registry__built_in_workload_specs().iter().map(|spec| (spec.id, GpuWorkloadTelemetryState__default_())).collect()

fn resolve_workload_execution_tier(spec: &GpuBuiltInWorkloadSpec, effective_tier: GpuEffectiveTier) -> Option<GpuEffectiveTier>:
    if effective_tier == GpuEffectiveTier::Safe or !(*spec).supported_tiers.contains(&effective_tier):
        return none
    (tier_rank((*spec).execution_budget_tier) <= tier_rank(effective_tier)).then_some((*spec).execution_budget_tier)

fn tier_rank(tier: GpuEffectiveTier) -> u8:
    match tier:
        GpuEffectiveTier::Safe => 0
        GpuEffectiveTier::Integrated => 1
        GpuEffectiveTier::Discrete => 2

fn build_status_workloads(effective_tier: GpuEffectiveTier, resources_ready: Bool, telemetry: &Map<GpuRuntimeWorkloadId, GpuWorkloadTelemetryState>) -> Array<GpuRuntimeWorkloadStatus>:
    registry__built_in_workload_specs().iter().map(
        |spec| block:
            let counters = telemetry.get(&spec.id).cloned().unwrap_or_default()
            GpuRuntimeWorkloadStatus { workload_id: spec.id, label: spec.label.to_string(), ready: resources_ready and resolve_workload_execution_tier(spec, effective_tier).is_some(), supported_tiers: spec.supported_tiers.to_vec(), executions: counters.executions, fallback_count: counters.fallback_count, cache_policy: spec.cache_policy.to_string(), kernel_labels: spec.kernel_labels.iter().map(|value| (*value).to_string()).collect(), last_execution_path: counters.last_execution_path, last_fallback_reason: counters.last_fallback_reason, last_error: counters.last_error }
    ).collect()

fn apply_snapshot_workloads(snapshot: &mut GpuRuntimeStatusSnapshot, effective_tier: GpuEffectiveTier, resources_ready: Bool, telemetry: &Map<GpuRuntimeWorkloadId, GpuWorkloadTelemetryState>):
    (*snapshot).workloads = build_status_workloads(effective_tier, resources_ready, telemetry)
    ()

enum GpuTierMode:
    Auto
    Safe
    Integrated
    Discrete

enum GpuEffectiveTier:
    Safe
    Integrated
    Discrete

enum GpuFallbackReason:
    SafeTierForcedCpu
    AdapterUnavailable
    SoftwareRendererBlocked
    ComputeUnsupported
    RuntimeUnavailable
    UnsupportedTier
    WorkloadBudgetExceeded
    ExecutionFailed

enum GpuRuntimeWorkloadId:
    ImageThumbnail
    ImagePreview
    AudioThumbnail
    AudioWaveform
    AudioSpectralBands
    AudioSpectrogram

struct GpuRuntimeConfiguration:
    tier_override: GpuTierMode

impl Default for GpuRuntimeConfiguration:
    fn default_() -> GpuRuntimeConfiguration:
        GpuRuntimeConfiguration { tier_override: GpuTierMode::Auto }


struct GpuRuntimeWorkloadStatus:
    workload_id: GpuRuntimeWorkloadId
    label: String
    ready: Bool
    supported_tiers: Array<GpuEffectiveTier>
    executions: u64
    fallback_count: u64
    cache_policy: String
    kernel_labels: Array<String>
    last_execution_path: Option<String>
    last_fallback_reason: Option<GpuFallbackReason>
    last_error: Option<String>

struct GpuRuntimeStatusSnapshot:
    configured_mode: GpuTierMode
    effective_tier: GpuEffectiveTier
    adapter_name: Option<String>
    adapter_type: Option<String>
    backend_name: Option<String>
    software_renderer: Bool
    compute_available: Bool
    queue_depth: u32
    runtime_error: Option<String>
    workloads: Array<GpuRuntimeWorkloadStatus>

impl Default for GpuRuntimeStatusSnapshot:
    fn default_() -> GpuRuntimeStatusSnapshot:
        GpuRuntimeStatusSnapshot { configured_mode: GpuTierMode::Auto, effective_tier: GpuEffectiveTier::Safe, adapter_name: none, adapter_type: none, backend_name: none, software_renderer: false, compute_available: false, queue_depth: 0, runtime_error: none, workloads: Vec__new_() }


struct GpuRuntimeStatusEvent:
    state: GpuRuntimeStatusSnapshot

enum KernelSource:
    Wgsl(String)
    Spirv(&Slice<u32>)

struct AudioWaveformParams:
    sample_count: u32
    bucket_count: u32
    padding0: u32
    padding1: u32

struct AudioWaveformResult:
    peak: f32
    rms: f32

struct AudioSpectralParams:
    sample_count: u32
    band_count: u32
    padding0: u32
    padding1: u32

struct AudioSpectrogramParams:
    sample_count: u32
    image_width: u32
    image_height: u32
    window_size: u32

fn reduce_waveform_buckets(resources: &GpuRuntimeResources, mono_samples: &Slice<f32>, bucket_count: usize, tier: GpuEffectiveTier) -> Result<Array<AudioWaveformBucket>, String>:
    if mono_samples.is_empty() or bucket_count == 0:
        return Result::Ok(Vec__new_())
    let max_samples = match tier:
        GpuEffectiveTier::Integrated => 2000000
        GpuEffectiveTier::Discrete => 8000000
        GpuEffectiveTier::Safe => 0
    if mono_samples.len() > max_samples:
        return Result::Err("GPU waveform workload exceeded the current tier budget.".to_string())
    let shader = resources.shader_module("audio_waveform_reduce", KernelSource::Wgsl(WAVEFORM_SHADER))?
    let bind_group_layout = resources.device().create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor { label: Option::Some("greeblefs-audio-waveform-layout"), entries: &[wgpu::BindGroupLayoutEntry { binding: 0, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Storage { read_only: true }, has_dynamic_offset: false, min_binding_size: none }, count: none }, wgpu::BindGroupLayoutEntry { binding: 1, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Storage { read_only: false }, has_dynamic_offset: false, min_binding_size: none }, count: none }, wgpu::BindGroupLayoutEntry { binding: 2, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Uniform, has_dynamic_offset: false, min_binding_size: none }, count: none }] })
    let pipeline_layout = resources.device().create_pipeline_layout(&wgpu::PipelineLayoutDescriptor { label: Option::Some("greeblefs-audio-waveform-pipeline-layout"), bind_group_layouts: &[&bind_group_layout], push_constant_ranges: &[] })
    let pipeline = resources.device().create_compute_pipeline(&wgpu::ComputePipelineDescriptor { label: Option::Some("greeblefs-audio-waveform-pipeline"), layout: Option::Some(&pipeline_layout), module: &shader, entry_point: Option::Some("main"), compilation_options: Default__default_(), cache: none })
    let input_buffer = resources.create_storage_buffer_from_bytes("greeblefs-audio-waveform-input", bytemuck__cast_slice(mono_samples))?
    let output_size = (bucket_count * std__mem__size_of()) as u64
    let output_buffer = resources.create_zeroed_storage_buffer("greeblefs-audio-waveform-output", output_size)?
    let params = AudioWaveformParams { sample_count: mono_samples.len() as u32, bucket_count: bucket_count as u32, padding0: 0, padding1: 0 }
    let params_buffer = resources.create_uniform_buffer("greeblefs-audio-waveform-params", &params)
    let bind_group = resources.device().create_bind_group(&wgpu::BindGroupDescriptor { label: Option::Some("greeblefs-audio-waveform-bind-group"), layout: &bind_group_layout, entries: &[wgpu::BindGroupEntry { binding: 0, resource: input_buffer.as_entire_binding() }, wgpu::BindGroupEntry { binding: 1, resource: output_buffer.as_entire_binding() }, wgpu::BindGroupEntry { binding: 2, resource: params_buffer.as_entire_binding() }] })
    let mut encoder = resources.device().create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Option::Some("greeblefs-audio-waveform-encoder") })
    let mut pass_ = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor { label: Option::Some("greeblefs-audio-waveform-pass"), timestamp_writes: none })
    pass_.set_pipeline(&pipeline)
    ()
    pass_.set_bind_group(0, &bind_group, &[])
    ()
    pass_.dispatch_workgroups((bucket_count as u32).div_ceil(64), 1, 1)
    ()
    ()
    ()
    ()
    resources.queue().submit(std__iter__once(encoder.finish()))
    ()
    let bytes = resources.read_buffer(&output_buffer, output_size)?
    let results: &Slice<AudioWaveformResult> = bytemuck__cast_slice(&bytes)
    Result::Ok(results.iter().enumerate().map(|__kain_closure_arg0| AudioWaveformBucket { index: __kain_closure_arg0.__kain_tuple_0 as u32, peak_level: __kain_closure_arg0.__kain_tuple_1.peak as f64, rms_level: __kain_closure_arg0.__kain_tuple_1.rms as f64 }).collect())

fn reduce_spectral_bands(resources: &GpuRuntimeResources, fft_samples: &Slice<f32>, band_count: usize, tier: GpuEffectiveTier) -> Result<Array<f64>, String>:
    if fft_samples.is_empty() or band_count == 0:
        return Result::Ok(Vec__new_())
    let max_fft = match tier:
        GpuEffectiveTier::Integrated => 4096
        GpuEffectiveTier::Discrete => 8192
        GpuEffectiveTier::Safe => 0
    if fft_samples.len() > max_fft:
        return Result::Err("GPU spectral workload exceeded the current tier budget.".to_string())
    let shader = resources.shader_module("audio_spectral_bands", KernelSource::Wgsl(SPECTRAL_SHADER))?
    let bind_group_layout = resources.device().create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor { label: Option::Some("greeblefs-audio-spectral-layout"), entries: &[wgpu::BindGroupLayoutEntry { binding: 0, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Storage { read_only: true }, has_dynamic_offset: false, min_binding_size: none }, count: none }, wgpu::BindGroupLayoutEntry { binding: 1, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Storage { read_only: false }, has_dynamic_offset: false, min_binding_size: none }, count: none }, wgpu::BindGroupLayoutEntry { binding: 2, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Uniform, has_dynamic_offset: false, min_binding_size: none }, count: none }] })
    let pipeline_layout = resources.device().create_pipeline_layout(&wgpu::PipelineLayoutDescriptor { label: Option::Some("greeblefs-audio-spectral-pipeline-layout"), bind_group_layouts: &[&bind_group_layout], push_constant_ranges: &[] })
    let pipeline = resources.device().create_compute_pipeline(&wgpu::ComputePipelineDescriptor { label: Option::Some("greeblefs-audio-spectral-pipeline"), layout: Option::Some(&pipeline_layout), module: &shader, entry_point: Option::Some("main"), compilation_options: Default__default_(), cache: none })
    let input_buffer = resources.create_storage_buffer_from_bytes("greeblefs-audio-spectral-input", bytemuck__cast_slice(fft_samples))?
    let output_size = (band_count * std__mem__size_of()) as u64
    let output_buffer = resources.create_zeroed_storage_buffer("greeblefs-audio-spectral-output", output_size)?
    let params = AudioSpectralParams { sample_count: fft_samples.len() as u32, band_count: band_count as u32, padding0: 0, padding1: 0 }
    let params_buffer = resources.create_uniform_buffer("greeblefs-audio-spectral-params", &params)
    let bind_group = resources.device().create_bind_group(&wgpu::BindGroupDescriptor { label: Option::Some("greeblefs-audio-spectral-bind-group"), layout: &bind_group_layout, entries: &[wgpu::BindGroupEntry { binding: 0, resource: input_buffer.as_entire_binding() }, wgpu::BindGroupEntry { binding: 1, resource: output_buffer.as_entire_binding() }, wgpu::BindGroupEntry { binding: 2, resource: params_buffer.as_entire_binding() }] })
    let mut encoder = resources.device().create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Option::Some("greeblefs-audio-spectral-encoder") })
    let mut pass_ = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor { label: Option::Some("greeblefs-audio-spectral-pass"), timestamp_writes: none })
    pass_.set_pipeline(&pipeline)
    ()
    pass_.set_bind_group(0, &bind_group, &[])
    ()
    pass_.dispatch_workgroups((band_count as u32).div_ceil(64), 1, 1)
    ()
    ()
    ()
    ()
    resources.queue().submit(std__iter__once(encoder.finish()))
    ()
    let bytes = resources.read_buffer(&output_buffer, output_size)?
    let raw_values: &Slice<f32> = bytemuck__cast_slice(&bytes)
    let mut values = raw_values.iter().map(|value| *value as f64).collect()
    let max_value = values.iter().copied().fold(0.0, f64__max)
    if max_value > 0.0:
        values.iter_mut().for_each(|value| *value = *value / max_value)
        ()
        ()
        ()
        ()
    Result::Ok(values)

fn render_spectrogram(resources: &GpuRuntimeResources, mono_samples: &Slice<f32>, width: u32, height: u32, tier: GpuEffectiveTier) -> Result<image::RgbaImage, String>:
    if mono_samples.is_empty() or width == 0 or height == 0:
        return Result::Ok(RgbaImage__from_pixel(width.max(1), height.max(1), image__Rgba([0, 0, 0, 255])))
    let window_size = match tier:
        GpuEffectiveTier::Integrated => 512
        GpuEffectiveTier::Discrete => 1024
        GpuEffectiveTier::Safe => 0
    let max_samples = match tier:
        GpuEffectiveTier::Integrated => 2000000
        GpuEffectiveTier::Discrete => 8000000
        GpuEffectiveTier::Safe => 0
    if mono_samples.len() > max_samples:
        return Result::Err("GPU spectrogram workload exceeded the current tier budget.".to_string())
    let shader = resources.shader_module("audio_spectrogram_render", KernelSource::Wgsl(SPECTROGRAM_SHADER))?
    let bind_group_layout = resources.device().create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor { label: Option::Some("greeblefs-audio-spectrogram-layout"), entries: &[wgpu::BindGroupLayoutEntry { binding: 0, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Storage { read_only: true }, has_dynamic_offset: false, min_binding_size: none }, count: none }, wgpu::BindGroupLayoutEntry { binding: 1, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::StorageTexture { access: wgpu::StorageTextureAccess::WriteOnly, format: wgpu::TextureFormat::Rgba8Unorm, view_dimension: wgpu::TextureViewDimension::D2 }, count: none }, wgpu::BindGroupLayoutEntry { binding: 2, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Uniform, has_dynamic_offset: false, min_binding_size: none }, count: none }] })
    let pipeline_layout = resources.device().create_pipeline_layout(&wgpu::PipelineLayoutDescriptor { label: Option::Some("greeblefs-audio-spectrogram-pipeline-layout"), bind_group_layouts: &[&bind_group_layout], push_constant_ranges: &[] })
    let pipeline = resources.device().create_compute_pipeline(&wgpu::ComputePipelineDescriptor { label: Option::Some("greeblefs-audio-spectrogram-pipeline"), layout: Option::Some(&pipeline_layout), module: &shader, entry_point: Option::Some("main"), compilation_options: Default__default_(), cache: none })
    let input_buffer = resources.create_storage_buffer_from_bytes("greeblefs-audio-spectrogram-input", bytemuck__cast_slice(mono_samples))?
    let output_texture = resources.create_storage_rgba_texture("greeblefs-audio-spectrogram-output", width, height)?
    let output_view = output_texture.create_view(&Default__default_())
    let params = AudioSpectrogramParams { sample_count: mono_samples.len() as u32, image_width: width, image_height: height, window_size: window_size }
    let params_buffer = resources.create_uniform_buffer("greeblefs-audio-spectrogram-params", &params)
    let bind_group = resources.device().create_bind_group(&wgpu::BindGroupDescriptor { label: Option::Some("greeblefs-audio-spectrogram-bind-group"), layout: &bind_group_layout, entries: &[wgpu::BindGroupEntry { binding: 0, resource: input_buffer.as_entire_binding() }, wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::TextureView(&output_view) }, wgpu::BindGroupEntry { binding: 2, resource: params_buffer.as_entire_binding() }] })
    let mut encoder = resources.device().create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Option::Some("greeblefs-audio-spectrogram-encoder") })
    let mut pass_ = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor { label: Option::Some("greeblefs-audio-spectrogram-pass"), timestamp_writes: none })
    pass_.set_pipeline(&pipeline)
    ()
    pass_.set_bind_group(0, &bind_group, &[])
    ()
    pass_.dispatch_workgroups(width.div_ceil(8), height.div_ceil(8), 1)
    ()
    ()
    ()
    ()
    resources.queue().submit(std__iter__once(encoder.finish()))
    ()
    resources.read_rgba_texture(&output_texture, width, height)

struct ImagePreviewParams:
    src_width: u32
    src_height: u32
    dst_width: u32
    dst_height: u32
    brightness: f32
    contrast: f32
    saturation: f32
    temperature: f32
    highlights: f32
    shadows: f32
    vignette: f32
    padding0: f32

fn render_image_preview(resources: &GpuRuntimeResources, source: &image::RgbaImage, target_width: u32, target_height: u32, effective_state: ImageAdjustmentState, tier: GpuEffectiveTier) -> Result<image::RgbaImage, String>:
    if target_width == 0 or target_height == 0:
        return Result::Err("GPU image preview target bounds must be greater than zero.".to_string())
    let max_pixels = match tier:
        GpuEffectiveTier::Integrated => 4194304
        GpuEffectiveTier::Discrete => 16777216
        GpuEffectiveTier::Safe => 0
    if (target_width as u64 * target_height as u64) > max_pixels:
        return Result::Err("GPU image preview workload exceeded the current tier budget.".to_string())
    let shader = resources.shader_module("image_preview_filter", KernelSource::Wgsl(IMAGE_PREVIEW_SHADER))?
    let bind_group_layout = resources.device().create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor { label: Option::Some("greeblefs-image-preview-layout"), entries: &[wgpu::BindGroupLayoutEntry { binding: 0, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Texture { sample_type: wgpu::TextureSampleType::Float { filterable: true }, view_dimension: wgpu::TextureViewDimension::D2, multisampled: false }, count: none }, wgpu::BindGroupLayoutEntry { binding: 1, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering), count: none }, wgpu::BindGroupLayoutEntry { binding: 2, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::StorageTexture { access: wgpu::StorageTextureAccess::WriteOnly, format: wgpu::TextureFormat::Rgba8Unorm, view_dimension: wgpu::TextureViewDimension::D2 }, count: none }, wgpu::BindGroupLayoutEntry { binding: 3, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Uniform, has_dynamic_offset: false, min_binding_size: none }, count: none }] })
    let pipeline_layout = resources.device().create_pipeline_layout(&wgpu::PipelineLayoutDescriptor { label: Option::Some("greeblefs-image-preview-pipeline-layout"), bind_group_layouts: &[&bind_group_layout], push_constant_ranges: &[] })
    let pipeline = resources.device().create_compute_pipeline(&wgpu::ComputePipelineDescriptor { label: Option::Some("greeblefs-image-preview-pipeline"), layout: Option::Some(&pipeline_layout), module: &shader, entry_point: Option::Some("main"), compilation_options: Default__default_(), cache: none })
    let input_texture = resources.create_sampled_rgba_texture("greeblefs-image-preview-input", source)?
    let output_texture = resources.create_storage_rgba_texture("greeblefs-image-preview-output", target_width, target_height)?
    let input_view = input_texture.create_view(&Default__default_())
    let output_view = output_texture.create_view(&Default__default_())
    let sampler_ = resources.create_linear_sampler("greeblefs-image-preview-sampler")
    let params = ImagePreviewParams { src_width: source.width(), src_height: source.height(), dst_width: target_width, dst_height: target_height, brightness: effective_state.brightness, contrast: effective_state.contrast, saturation: effective_state.saturation, temperature: effective_state.temperature, highlights: effective_state.highlights, shadows: effective_state.shadows, vignette: effective_state.vignette, padding0: 0.0 }
    let params_buffer = resources.create_uniform_buffer("greeblefs-image-preview-params", &params)
    let bind_group = resources.device().create_bind_group(&wgpu::BindGroupDescriptor { label: Option::Some("greeblefs-image-preview-bind-group"), layout: &bind_group_layout, entries: &[wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(&input_view) }, wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::Sampler(&sampler_) }, wgpu::BindGroupEntry { binding: 2, resource: wgpu::BindingResource::TextureView(&output_view) }, wgpu::BindGroupEntry { binding: 3, resource: params_buffer.as_entire_binding() }] })
    let mut encoder = resources.device().create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Option::Some("greeblefs-image-preview-encoder") })
    let mut pass_ = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor { label: Option::Some("greeblefs-image-preview-pass"), timestamp_writes: none })
    pass_.set_pipeline(&pipeline)
    ()
    pass_.set_bind_group(0, &bind_group, &[])
    ()
    pass_.dispatch_workgroups(target_width.div_ceil(8), target_height.div_ceil(8), 1)
    ()
    ()
    ()
    ()
    resources.queue().submit(std__iter__once(encoder.finish()))
    ()
    resources.read_rgba_texture(&output_texture, target_width, target_height)

struct ThumbnailParams:
    src_width: u32
    src_height: u32
    dst_width: u32
    dst_height: u32

fn render_image_thumbnail(resources: &GpuRuntimeResources, source: &image::RgbaImage, target_width: u32, target_height: u32, tier: GpuEffectiveTier) -> Result<image::RgbaImage, String>:
    if target_width == 0 or target_height == 0:
        return Result::Err("GPU thumbnail target bounds must be greater than zero.".to_string())
    let max_pixels = match tier:
        GpuEffectiveTier::Integrated => 4194304
        GpuEffectiveTier::Discrete => 16777216
        GpuEffectiveTier::Safe => 0
    if (target_width as u64 * target_height as u64) > max_pixels:
        return Result::Err("GPU thumbnail workload exceeded the current tier budget.".to_string())
    let shader = resources.shader_module("thumbnail_resize", KernelSource::Wgsl(THUMBNAIL_SHADER))?
    let bind_group_layout = resources.device().create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor { label: Option::Some("greeblefs-thumbnail-layout"), entries: &[wgpu::BindGroupLayoutEntry { binding: 0, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Texture { sample_type: wgpu::TextureSampleType::Float { filterable: true }, view_dimension: wgpu::TextureViewDimension::D2, multisampled: false }, count: none }, wgpu::BindGroupLayoutEntry { binding: 1, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering), count: none }, wgpu::BindGroupLayoutEntry { binding: 2, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::StorageTexture { access: wgpu::StorageTextureAccess::WriteOnly, format: wgpu::TextureFormat::Rgba8Unorm, view_dimension: wgpu::TextureViewDimension::D2 }, count: none }, wgpu::BindGroupLayoutEntry { binding: 3, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Uniform, has_dynamic_offset: false, min_binding_size: none }, count: none }] })
    let pipeline_layout = resources.device().create_pipeline_layout(&wgpu::PipelineLayoutDescriptor { label: Option::Some("greeblefs-thumbnail-pipeline-layout"), bind_group_layouts: &[&bind_group_layout], push_constant_ranges: &[] })
    let pipeline = resources.device().create_compute_pipeline(&wgpu::ComputePipelineDescriptor { label: Option::Some("greeblefs-thumbnail-pipeline"), layout: Option::Some(&pipeline_layout), module: &shader, entry_point: Option::Some("main"), compilation_options: Default__default_(), cache: none })
    let input_texture = resources.create_sampled_rgba_texture("greeblefs-thumbnail-input", source)?
    let output_texture = resources.create_storage_rgba_texture("greeblefs-thumbnail-output", target_width, target_height)?
    let input_view = input_texture.create_view(&Default__default_())
    let output_view = output_texture.create_view(&Default__default_())
    let sampler_ = resources.create_linear_sampler("greeblefs-thumbnail-sampler")
    let params = ThumbnailParams { src_width: source.width(), src_height: source.height(), dst_width: target_width, dst_height: target_height }
    let params_buffer = resources.create_uniform_buffer("greeblefs-thumbnail-params", &params)
    let bind_group = resources.device().create_bind_group(&wgpu::BindGroupDescriptor { label: Option::Some("greeblefs-thumbnail-bind-group"), layout: &bind_group_layout, entries: &[wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(&input_view) }, wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::Sampler(&sampler_) }, wgpu::BindGroupEntry { binding: 2, resource: wgpu::BindingResource::TextureView(&output_view) }, wgpu::BindGroupEntry { binding: 3, resource: params_buffer.as_entire_binding() }] })
    let mut encoder = resources.device().create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Option::Some("greeblefs-thumbnail-encoder") })
    let mut pass_ = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor { label: Option::Some("greeblefs-thumbnail-pass"), timestamp_writes: none })
    pass_.set_pipeline(&pipeline)
    ()
    pass_.set_bind_group(0, &bind_group, &[])
    ()
    pass_.dispatch_workgroups(target_width.div_ceil(8), target_height.div_ceil(8), 1)
    ()
    ()
    ()
    ()
    resources.queue().submit(std__iter__once(encoder.finish()))
    ()
    resources.read_rgba_texture(&output_texture, target_width, target_height)

struct ImageAdjustmentState:
    brightness: f32
    contrast: f32
    saturation: f32
    temperature: f32
    highlights: f32
    shadows: f32
    vignette: f32

impl Default for ImageAdjustmentState:
    fn default_() -> ImageAdjustmentState:
        ImageAdjustmentState { brightness: 0.0, contrast: 0.0, saturation: 0.0, temperature: 0.0, highlights: 0.0, shadows: 0.0, vignette: 0.0 }


impl ImageAdjustmentState:
    fn normalized(_self: ImageAdjustmentState) -> ImageAdjustmentState:
        ImageAdjustmentState { brightness: _self.brightness.clamp(-100.0, 100.0), contrast: _self.contrast.clamp(-100.0, 100.0), saturation: _self.saturation.clamp(-100.0, 100.0), temperature: _self.temperature.clamp(-100.0, 100.0), highlights: _self.highlights.clamp(-100.0, 100.0), shadows: _self.shadows.clamp(-100.0, 100.0), vignette: _self.vignette.clamp(0.0, 100.0) }


enum ImageFilterPresetId:
    Original
    Mono
    Noir
    Fade
    Chrome
    Warm
    Cool
    Vivid

struct ImageFilterPresetDefinition:
    id: ImageFilterPresetId
    label: String
    state: ImageAdjustmentState

struct ImageEditorSessionCreateRequest:
    input_path: String

struct ImageEditorSessionBootstrap:
    session_id: String
    preview_data_url: String
    output_content_type: String
    source_width: u32
    source_height: u32
    saved_state: ImageAdjustmentState
    presets: Array<ImageFilterPresetDefinition>

struct ImageEditorPreviewRequest:
    session_id: String
    preset_id: Option<ImageFilterPresetId>
    adjustments: ImageAdjustmentState

struct ImageEditorPreviewResult:
    session_id: String
    preview_data_url: String
    rendered_width: u32
    rendered_height: u32
    effective_state: ImageAdjustmentState

struct ImageEditorExportRequest:
    session_id: String
    preset_id: Option<ImageFilterPresetId>
    adjustments: ImageAdjustmentState
    output_content_type: Option<String>

struct ImageEditorExportResult:
    session_id: String
    image_bytes: Array<u8>
    baked_image_data_url: String
    content_type: String
    rendered_width: u32
    rendered_height: u32
    effective_state: ImageAdjustmentState

struct ImageEditorManager:
    inner: ImageEditorManagerInner

impl Default for ImageEditorManager:
    fn default_() -> ImageEditorManager:
        ImageEditorManager { inner: ImageEditorManagerInner__default_() }


struct ImageEditorManagerInner:
    next_session_id: std::sync::atomic::AtomicU64
    sessions: Map<String, ImageEditorSession>

impl Default for ImageEditorManagerInner:
    fn default_() -> ImageEditorManagerInner:
        ImageEditorManagerInner { next_session_id: AtomicU64__default_(), sessions: HashMap__new_() }


struct ImageEditorSession:
    original_image: image::RgbaImage
    output_content_type: String
    saved_state: ImageAdjustmentState

fn image_editor_create_session(manager: tauri::State<_, ImageEditorManager>, request: ImageEditorSessionCreateRequest) -> Result<ImageEditorSessionBootstrap, String>:
    let manager = manager.inner().clone()
    (await tauri__async_runtime__spawn_blocking(|| manager.create_session(request))).map_err(|error| format!("Image editor session bootstrap task failed to join: {error}"))?

fn image_editor_render_preview(manager: tauri::State<_, ImageEditorManager>, request: ImageEditorPreviewRequest) -> Result<ImageEditorPreviewResult, String>:
    let manager = manager.inner().clone()
    (await tauri__async_runtime__spawn_blocking(|| manager.render_preview(request))).map_err(|error| format!("Image editor preview task failed to join: {error}"))?

fn image_editor_export(manager: tauri::State<_, ImageEditorManager>, request: ImageEditorExportRequest) -> Result<ImageEditorExportResult, String>:
    let manager = manager.inner().clone()
    (await tauri__async_runtime__spawn_blocking(|| manager.export_baked_image(request))).map_err(|error| format!("Image editor export task failed to join: {error}"))?

fn image_editor_close_session(manager: tauri::State<_, ImageEditorManager>, session_id: String) -> Result<(), String>:
    manager.close_session(session_id)

impl ImageEditorManager:
    fn create_session(_self: &ImageEditorManager, request: ImageEditorSessionCreateRequest) -> Result<ImageEditorSessionBootstrap, String>:
        let input_path = normalize_image_editor_source_path(&request.input_path)?
        let output_content_type = resolve_supported_image_content_type(&input_path)?
        let original_image = read_image_file_as_rgba(&input_path)?
        let session_id = format!("image-edit-{}", (*_self).inner.next_session_id.fetch_add(1, std::sync::atomic::Ordering::Relaxed) + 1)
        let session = ImageEditorSession { original_image: original_image.clone(), output_content_type: output_content_type.clone(), saved_state: ImageAdjustmentState__default_() }
        let preview_image = resize_image_to_fit(&original_image, IMAGE_EDITOR_PREVIEW_MAX_DIMENSION, IMAGE_EDITOR_PREVIEW_MAX_DIMENSION)
        let preview_data_url = png_bytes_to_data_url(&encode_image_bytes(&preview_image, "image/png")?)
        let source_width = original_image.width()
        let source_height = original_image.height()
        ((*_self).inner.sessions.lock().map_err(|_| "Image editor session map was poisoned.".to_string())?).insert(session_id.clone(), session)
        ()
        Result::Ok(ImageEditorSessionBootstrap { session_id: session_id, preview_data_url: preview_data_url, output_content_type: output_content_type, source_width: source_width, source_height: source_height, saved_state: ImageAdjustmentState__default_(), presets: image_filter_preset_definitions() })

    fn render_preview(_self: &ImageEditorManager, request: ImageEditorPreviewRequest) -> Result<ImageEditorPreviewResult, String>:
        let session = (*_self).get_session(&request.session_id)?
        let effective_state = compose_effective_adjustment_state(request.preset_id, request.adjustments)
        let (preview_width, preview_height) = resolve_image_fit_dimensions(session.original_image.width(), session.original_image.height(), IMAGE_EDITOR_PREVIEW_MAX_DIMENSION, IMAGE_EDITOR_PREVIEW_MAX_DIMENSION)
        let rendered_image = gpu_runtime__global_gpu_runtime().and_then(|gpu_runtime| gpu_runtime.render_image_preview(&session.original_image, preview_width, preview_height, effective_state).ok()).unwrap_or_else(
            || block:
                let preview_source = resize_image_to_fit(&session.original_image, IMAGE_EDITOR_PREVIEW_MAX_DIMENSION, IMAGE_EDITOR_PREVIEW_MAX_DIMENSION)
                apply_image_adjustments(&preview_source, &effective_state)
        )
        let preview_data_url = png_bytes_to_data_url(&encode_image_bytes(&rendered_image, "image/png")?)
        Result::Ok(ImageEditorPreviewResult { session_id: request.session_id, preview_data_url: preview_data_url, rendered_width: rendered_image.width(), rendered_height: rendered_image.height(), effective_state: effective_state })

    fn export_baked_image(_self: &ImageEditorManager, request: ImageEditorExportRequest) -> Result<ImageEditorExportResult, String>:
        let session = (*_self).get_session(&request.session_id)?
        let effective_state = compose_effective_adjustment_state(request.preset_id, request.adjustments)
        let content_type = (request.output_content_type.map(normalize_content_type).transpose()?).unwrap_or_else(|| session.output_content_type.clone())
        let rendered_image = apply_image_adjustments(&session.original_image, &effective_state)
        let image_bytes = encode_image_bytes(&rendered_image, &content_type)?
        let baked_image_data_url = png_bytes_to_data_url(&encode_image_bytes(&rendered_image, "image/png")?)
        (*_self).update_saved_state(&request.session_id, effective_state)?
        ()
        Result::Ok(ImageEditorExportResult { session_id: request.session_id, image_bytes: image_bytes, baked_image_data_url: baked_image_data_url, content_type: content_type, rendered_width: rendered_image.width(), rendered_height: rendered_image.height(), effective_state: effective_state })

    fn close_session(_self: &ImageEditorManager, session_id: String) -> Result<(), String>:
        ((*_self).inner.sessions.lock().map_err(|_| "Image editor session map was poisoned.".to_string())?).remove(session_id.as_str())
        ()
        Result::Ok(())

    fn get_session(_self: &ImageEditorManager, session_id: String) -> Result<ImageEditorSession, String>:
        ((*_self).inner.sessions.lock().map_err(|_| "Image editor session map was poisoned.".to_string())?).get(session_id).cloned().ok_or_else(|| format!("Image editor session was not found: {session_id}"))

    fn update_saved_state(_self: &ImageEditorManager, session_id: String, saved_state: ImageAdjustmentState) -> Result<(), String>:
        let mut sessions = (*_self).inner.sessions.lock().map_err(|_| "Image editor session map was poisoned.".to_string())?
        let session = sessions.get_mut(session_id).ok_or_else(|| format!("Image editor session was not found: {session_id}"))?
        session.saved_state = saved_state
        ()
        Result::Ok(())


fn image_filter_preset_definitions() -> Array<ImageFilterPresetDefinition>:
    [(ImageFilterPresetId::Original, "Original", ImageAdjustmentState__default_()), (ImageFilterPresetId::Mono, "Mono", ImageAdjustmentState { saturation: -100.0, contrast: 10.0, highlights: 8.0, ..ImageAdjustmentState__default_() }), (ImageFilterPresetId::Noir, "Noir", ImageAdjustmentState { saturation: -100.0, contrast: 28.0, highlights: -8.0, shadows: -12.0, vignette: 28.0, ..ImageAdjustmentState__default_() }), (ImageFilterPresetId::Fade, "Fade", ImageAdjustmentState { brightness: 6.0, contrast: -22.0, saturation: -16.0, highlights: 14.0, shadows: 18.0, ..ImageAdjustmentState__default_() }), (ImageFilterPresetId::Chrome, "Chrome", ImageAdjustmentState { contrast: 18.0, saturation: 26.0, highlights: 14.0, temperature: -4.0, ..ImageAdjustmentState__default_() }), (ImageFilterPresetId::Warm, "Warm", ImageAdjustmentState { saturation: 12.0, temperature: 18.0, highlights: 8.0, ..ImageAdjustmentState__default_() }), (ImageFilterPresetId::Cool, "Cool", ImageAdjustmentState { saturation: 6.0, temperature: -20.0, shadows: 8.0, ..ImageAdjustmentState__default_() }), (ImageFilterPresetId::Vivid, "Vivid", ImageAdjustmentState { brightness: 4.0, contrast: 18.0, saturation: 30.0, highlights: 10.0, shadows: 6.0, vignette: 12.0, ..ImageAdjustmentState__default_() })].into_iter().map(|__kain_closure_arg0| ImageFilterPresetDefinition { id: __kain_closure_arg0.__kain_tuple_0, label: __kain_closure_arg0.__kain_tuple_1.to_string(), state: __kain_closure_arg0.__kain_tuple_2 }).collect()

fn compose_effective_adjustment_state(preset_id: Option<ImageFilterPresetId>, adjustments: ImageAdjustmentState) -> ImageAdjustmentState:
    let preset_state = image_filter_preset_definitions().into_iter().find(|definition| Option::Some(definition.id) == preset_id).map(|definition| definition.state).unwrap_or_default()
    ImageAdjustmentState { brightness: preset_state.brightness + adjustments.brightness, contrast: preset_state.contrast + adjustments.contrast, saturation: preset_state.saturation + adjustments.saturation, temperature: preset_state.temperature + adjustments.temperature, highlights: preset_state.highlights + adjustments.highlights, shadows: preset_state.shadows + adjustments.shadows, vignette: preset_state.vignette + adjustments.vignette }.normalized()

fn normalize_image_editor_source_path(input_path: String) -> Result<std::path::PathBuf, String>:
    let trimmed = input_path.trim()
    if trimmed.is_empty():
        return Result::Err("Image editor input path cannot be empty.".to_string())
    let path = PathBuf__from(trimmed)
    if !path.exists():
        return Result::Err(format!("Image editor input does not exist: {}", path.display()))
    if !path.is_file():
        return Result::Err(format!("Image editor input is not a file: {}", path.display()))
    Result::Ok(path)

fn normalize_content_type(content_type: String) -> Result<String, String>:
    match content_type.trim().to_ascii_lowercase().as_str():
        "image/png" => Result::Ok("image/png".to_string())
        "image/jpeg" | "image/jpg" => Result::Ok("image/jpeg".to_string())
        "image/webp" => Result::Ok("image/webp".to_string())
        other => Result::Err(format!("Unsupported image editor content type: {other}. Expected PNG, JPEG, or WebP."))

fn resolve_supported_image_content_type(path: &std::path::Path) -> Result<String, String>:
    let extension = path.extension().and_then(|value| value.to_str()).unwrap_or_default().trim().trim_start_matches(".").to_ascii_lowercase()
    let content_type = match extension.as_str():
        "png" => "image/png"
        "jpg" | "jpeg" => "image/jpeg"
        "webp" => "image/webp"
        _ =>
            return Result::Err(format!("Image editor only supports PNG, JPG, JPEG, and WebP files right now: {}", path.display()))
    Result::Ok(content_type.to_string())

fn read_image_file_as_rgba(path: &std::path::Path) -> Result<image::RgbaImage, String>:
    ((ImageReader__open(path).map_err(|error| format!("Failed to open image '{}': {error}", path.display()))?).with_guessed_format().map_err(|error| format!("Failed to detect image format for '{}': {error}", path.display()))?).decode().map(|image| image.to_rgba8()).map_err(|error| format!("Failed to decode image '{}': {error}", path.display()))

fn resize_image_to_fit(image: &image::RgbaImage, max_width: u32, max_height: u32) -> image::RgbaImage:
    let (width, height) = resolve_image_fit_dimensions(image.width(), image.height(), max_width, max_height)
    if width == image.width() and height == image.height():
        return image.clone()
    image__imageops__resize(image, width, height, image::imageops::FilterType::Lanczos3)

fn resolve_image_fit_dimensions(image_width: u32, image_height: u32, max_width: u32, max_height: u32) -> (u32, u32):
    if image_width <= max_width and image_height <= max_height:
        return (image_width.max(1), image_height.max(1))
    let scale = f32__min(max_width as f32 / image_width as f32, max_height as f32 / image_height as f32)
    (((image_width as f32) * scale).round().max(1.0) as u32, ((image_height as f32) * scale).round().max(1.0) as u32)

fn encode_image_bytes(image: &image::RgbaImage, content_type: String) -> Result<Array<u8>, String>:
    let format = match content_type:
        "image/png" => image::ImageFormat::Png
        "image/jpeg" => image::ImageFormat::Jpeg
        "image/webp" => image::ImageFormat::WebP
        other =>
            return Result::Err(format!("Unsupported image export content type: {other}. Expected PNG, JPEG, or WebP."))
    let mut cursor = Cursor__new_(Vec__new_())
    image::DynamicImage::ImageRgba8(image.clone()).write_to(&mut cursor, format).map_err(|error| format!("Failed to encode image as {content_type}: {error}"))?
    ()
    Result::Ok(cursor.into_inner())

fn png_bytes_to_data_url(bytes: &Slice<u8>) -> String:
    format!("data:image/png;base64,{}", base64__engine__general_purpose__STANDARD.encode(bytes))

fn apply_image_adjustments(image: &image::RgbaImage, state: &ImageAdjustmentState) -> image::RgbaImage:
    let mut output = image.clone()
    let width = output.width().max(1) as f32
    let height = output.height().max(1) as f32
    let brightness_offset = (*state).brightness / 100.0
    let contrast_factor = 1.0 + ((*state).contrast / 100.0)
    let saturation_factor = 1.0 + ((*state).saturation / 100.0)
    let temperature_bias = (*state).temperature / 100.0
    let highlight_amount = (*state).highlights / 100.0
    let shadow_amount = (*state).shadows / 100.0
    let vignette_amount = (*state).vignette / 100.0
    let vignette_max_distance = ((width * width) + (height * height)).sqrt() / 2.0
    for (x, y, pixel) in output.enumerate_pixels_mut():
        let [r, g, b, a] = pixel.field_0
        let mut red = r as f32 / 255.0
        let mut green = g as f32 / 255.0
        let mut blue = b as f32 / 255.0
        red = red + brightness_offset
        ()
        green = green + brightness_offset
        ()
        blue = blue + brightness_offset
        ()
        red = ((red - 0.5) * contrast_factor) + 0.5
        ()
        green = ((green - 0.5) * contrast_factor) + 0.5
        ()
        blue = ((blue - 0.5) * contrast_factor) + 0.5
        ()
        let luminance = rgb_luminance(red, green, blue)
        red = luminance + ((red - luminance) * saturation_factor)
        ()
        green = luminance + ((green - luminance) * saturation_factor)
        ()
        blue = luminance + ((blue - luminance) * saturation_factor)
        ()
        red = red + temperature_bias * 0.18
        ()
        green = green + temperature_bias * 0.03
        ()
        blue = blue - temperature_bias * 0.18
        ()
        let adjusted_luminance = rgb_luminance(red, green, blue)
        let shadow_weight = (1.0 - adjusted_luminance).powf(1.6)
        let highlight_weight = adjusted_luminance.powf(1.8)
        let shadow_lift = shadow_amount * 0.35 * shadow_weight
        let highlight_lift = highlight_amount * 0.28 * highlight_weight
        red = red + (shadow_lift + highlight_lift)
        ()
        green = green + (shadow_lift + highlight_lift)
        ()
        blue = blue + (shadow_lift + highlight_lift)
        ()
        if vignette_amount > 0.0:
            let dx = x as f32 + 0.5 - (width / 2.0)
            let dy = y as f32 + 0.5 - (height / 2.0)
            let radial_distance = ((dx * dx) + (dy * dy)).sqrt()
            let normalized_distance = (radial_distance / vignette_max_distance).clamp(0.0, 1.0)
            let vignette_curve = normalized_distance.powf(1.75)
            let vignette_factor = 1.0 - (vignette_amount * 0.75 * vignette_curve)
            red = red * vignette_factor
            ()
            green = green * vignette_factor
            ()
            blue = blue * vignette_factor
            ()
            ()
            ()
            ()
        *pixel = image__Rgba([normalize_channel(red), normalize_channel(green), normalize_channel(blue), a])
        ()
    ()
    output

fn rgb_luminance(red: f32, green: f32, blue: f32) -> f32:
    (0.2126 * red) + (0.7152 * green) + (0.0722 * blue)

fn normalize_channel(value: f32) -> u8:
    (value.clamp(0.0, 1.0) * 255.0).round() as u8

