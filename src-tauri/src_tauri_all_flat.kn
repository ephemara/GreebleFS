struct AssociatedProgram:
    name: String
    path: String
    launch_id: Option<String>
    launch_kind: Option<AssociatedProgramLaunchKind>
    executable_path: Option<String>
    icon: Option<String>
    is_default: Bool

enum AssociatedProgramLaunchKind:
    ShellHandler
    ExecutablePath
    BundleId
    DesktopId

struct AssociatedProgramsCatalog:
    recommended_programs: Array<AssociatedProgram>
    other_programs: Array<AssociatedProgram>
    default_program: Option<AssociatedProgram>

struct OpenWithResult:
    success: Bool
    error: Option<String>

struct GetAssociatedProgramsResult:
    success: Bool
    recommended_programs: Array<AssociatedProgram>
    other_programs: Array<AssociatedProgram>
    default_program: Option<AssociatedProgram>
    error: Option<String>

struct ShellContextMenuItem:
    id: u32
    name: String
    verb: Option<String>
    icon: Option<String>
    children: Option<Array<ShellContextMenuItem>>

enum ShellContextMenuTargetKind:
    Entry
    MultiSelect
    Background

struct ShellContextMenuRequest:
    target_kind: ShellContextMenuTargetKind
    current_directory_path: String
    target_paths: Array<String>

struct ShellContextMenuInvokeRequest:
    menu_request: ShellContextMenuRequest
    command_id: u32
    command_verb: Option<String>

struct GetShellContextMenuResult:
    success: Bool
    items: Array<ShellContextMenuItem>
    error: Option<String>

impl OpenWithResult:
    fn into_result(_self: OpenWithResult) -> Result<(), String>:
        if _self.success:
            Result::Ok(())
        else:
            Result::Err(_self.error.unwrap_or_else(|| "Open With operation failed.".to_string()))


impl GetAssociatedProgramsResult:
    fn into_result(_self: GetAssociatedProgramsResult) -> Result<AssociatedProgramsCatalog, String>:
        if _self.success:
            Result::Ok(AssociatedProgramsCatalog { recommended_programs: _self.recommended_programs, other_programs: _self.other_programs, default_program: _self.default_program })
        else:
            Result::Err(_self.error.unwrap_or_else(|| "Failed to resolve associated programs.".to_string()))


impl GetShellContextMenuResult:
    fn into_result(_self: GetShellContextMenuResult) -> Result<Array<ShellContextMenuItem>, String>:
        if _self.success:
            Result::Ok(_self.items)
        else:
            Result::Err(_self.error.unwrap_or_else(|| "Failed to resolve shell context menu.".to_string()))


fn canonicalize_path(path: &std::path::Path) -> String:
    match path.canonicalize():
        Ok(canonical) =>
            let path_str = canonical.to_string_lossy().to_string()
            match path_str.strip_prefix("\\\\?\\"):
                Some(stripped) =>
                    stripped.to_string()
                _ =>
                    path_str
        Err(_) => path.to_string_lossy().to_string()

fn get_program_icon(exe_path: String) -> Option<String>:
    let path = Path__new_(exe_path)
    if !path.exists():
        return none
    let icon = file_icon_provider__get_file_icon(path, 32).ok()?
    if icon.width == 0 or icon.height == 0:
        return none
    let expected_len = (icon.width * icon.height * 4) as usize
    if icon.pixels.len() != expected_len:
        return none
    let mut png_bytes: Array<u8> = Vec__new_()
    let png_encoder = PngEncoder__new_(&mut png_bytes)
    png_encoder.write_image(&icon.pixels, icon.width, icon.height, image::ExtendedColorType::Rgba8).ok()?
    ()
    let base64_png = base64__engine__general_purpose__STANDARD.encode(png_bytes)
    Option::Some(format!("data:image/png;base64,{base64_png}"))

fn load_png_as_base64(path: &path::Path) -> Option<String>:
    let data = std__fs__read(path).ok()?
    if data.starts_with(&[137, 80, 78, 71]):
        let base64_png = base64__engine__general_purpose__STANDARD.encode(&data)
        return Option::Some(format!("data:image/png;base64,{base64_png}"))
    none

fn path_extension_lowercase(path: &std::path::Path) -> Option<String>:
    path.extension().and_then(|extension| extension.to_str()).map(|extension| extension.to_ascii_lowercase())

fn run_command_with_timeout(command: std::process::Command, timeout: std::time::Duration, description: String) -> Result<std::process::Output, String>:
    command.stdout(Stdio__piped()).stderr(Stdio__piped())
    ()
    let mut child = command.spawn_().map_err(|error| format!("Failed to run {description}: {error}"))?
    let started = Instant__now()
    loop:
        match child.try_wait():
            Ok(Some(_)) =>
                return child.wait_with_output().map_err(|error| format!("Failed to collect {description} output: {error}"))
            Ok(None) =>
                if started.elapsed() >= timeout:
                    let _ = child.kill()
                    let _ = child.wait()
                    return Result::Err(format!("{description} timed out after {}ms", timeout.as_millis()))
                std__thread__sleep(Duration__from_millis(20))
                ()
            Err(error) =>
                let _ = child.kill()
                let _ = child.wait()
                return Result::Err(format!("Failed while waiting for {description}: {error}"))

fn get_associated_programs_impl(file_path: String) -> GetAssociatedProgramsResult:
    let path = Path__new_(file_path)
    let is_directory = path.is_dir()
    let association_types: Array<String> = if is_directory:
        vec!("Folder".to_string(), "Directory".to_string())
    else:
        match open_with__utils__path_extension_lowercase(path):
            Some(extension) => vec!(format!(".{}", extension))
            None =>
                return GetAssociatedProgramsResult { success: false, recommended_programs: vec!(), other_programs: vec!(), default_program: none, error: Option::Some("File has no extension".to_string()) }
    let mut recommended_programs: Array<AssociatedProgram> = Vec__new_()
    let mut other_programs: Array<AssociatedProgram> = Vec__new_()
    let mut seen_paths: Set<String> = HashSet__new_()
    let mut default_program: Option<AssociatedProgram> = none
    let coinit_result = windows::Win32::System::Com::CoInitializeEx(none, windows::Win32::System::Com::COINIT_APARTMENTTHREADED)
    let needs_uninit = coinit_result.is_ok()
    if !is_directory:
        match get_default_program(&association_types[0], &HashSet__new_()):
            Some(mut def_prog) =>
                def_prog.is_default = true
                ()
                seen_paths.insert(def_prog.name.to_lowercase())
                ()
                seen_paths.insert(def_prog.path.to_lowercase())
                ()
                default_program = Option::Some(def_prog)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    for association_type in &association_types:
        let assoc_hstring = HSTRING__from(association_type)
        let enum_result: Result<windows::Win32::UI::Shell::IEnumAssocHandlers, _> = windows::Win32::UI::Shell::SHAssocEnumHandlers(&assoc_hstring, windows::Win32::UI::Shell::ASSOC_FILTER(1))
        match enum_result:
            Ok(enum_handlers) =>
                let mut handlers: Array<Option<windows::Win32::UI::Shell::IAssocHandler>> = Default__default_()
                let mut fetched: u32 = 0
                while enum_handlers.Next(&mut handlers, Option::Some(&mut fetched)).is_ok() and fetched > 0:
                    for handler in handlers.iter().take(fetched as usize).flatten():
                        match extract_handler_info(handler, &seen_paths):
                            Some(program) =>
                                seen_paths.insert(program.name.to_lowercase())
                                ()
                                seen_paths.insert(program.path.to_lowercase())
                                ()
                                recommended_programs.push(program)
                                ()
                            _ => ()
                    ()
                    for handler in handlers.iter_mut():
                        *handler = none
                        ()
                    ()
                    fetched = 0
                    ()
                ()
                ()
            _ =>
                ()
                ()
        let enum_result: Result<windows::Win32::UI::Shell::IEnumAssocHandlers, _> = windows::Win32::UI::Shell::SHAssocEnumHandlers(&assoc_hstring, windows::Win32::UI::Shell::ASSOC_FILTER(0))
        match enum_result:
            Ok(enum_handlers) =>
                let mut handlers: Array<Option<windows::Win32::UI::Shell::IAssocHandler>> = Default__default_()
                let mut fetched: u32 = 0
                while enum_handlers.Next(&mut handlers, Option::Some(&mut fetched)).is_ok() and fetched > 0:
                    for handler in handlers.iter().take(fetched as usize).flatten():
                        match extract_handler_info(handler, &seen_paths):
                            Some(program) =>
                                seen_paths.insert(program.name.to_lowercase())
                                ()
                                seen_paths.insert(program.path.to_lowercase())
                                ()
                                other_programs.push(program)
                                ()
                            _ => ()
                    ()
                    for handler in handlers.iter_mut():
                        *handler = none
                        ()
                    ()
                    fetched = 0
                    ()
            _ => ()
    ()
    if needs_uninit:
        windows::Win32::System::Com::CoUninitialize()
        ()
        ()
        ()
        ()
    ()
    if is_directory:
        match get_file_explorer_program(&seen_paths):
            Some(explorer_program) =>
                seen_paths.insert(explorer_program.name.to_lowercase())
                ()
                seen_paths.insert(explorer_program.path.to_lowercase())
                ()
                recommended_programs.push(explorer_program)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    GetAssociatedProgramsResult { success: true, recommended_programs: recommended_programs, other_programs: other_programs, default_program: default_program, error: none }

fn get_file_explorer_program(seen_paths: &Set<String>) -> Option<AssociatedProgram>:
    let windows_dir = std__env__var_("WINDIR").unwrap_or_else(|_| "C:\\Windows".to_string())
    let explorer_path = Path__new_(&windows_dir).join("explorer.exe")
    if !explorer_path.exists():
        return none
    let explorer_path = explorer_path.to_string_lossy().into_owned()
    let explorer_path_key = explorer_path.to_lowercase()
    if seen_paths.contains(&explorer_path_key) or seen_paths.contains("file explorer"):
        return none
    Option::Some(AssociatedProgram { name: "File Explorer".to_string(), path: explorer_path.clone(), launch_id: Option::Some(explorer_path.clone()), launch_kind: Option::Some(AssociatedProgramLaunchKind::ExecutablePath), executable_path: Option::Some(explorer_path.clone()), icon: open_with__utils__get_program_icon(&explorer_path), is_default: false })

fn extract_handler_info(handler: &windows::Win32::UI::Shell::IAssocHandler, seen_paths: &Set<String>) -> Option<AssociatedProgram>:
    let display_name = handler.GetUIName().ok().and_then(|pwstr| pwstr_to_string(pwstr))
    let handler_path = handler.GetName().ok().and_then(|pwstr| pwstr_to_string(pwstr))
    let handler_path = handler_path?
    let name_key = display_name.map(|name| name.to_lowercase())
    let path_key = handler_path.to_lowercase()
    match name_key:
        Some(name) =>
            if seen_paths.contains(name):
                return none
            ()
        _ =>
            ()
            ()
    if seen_paths.contains(&path_key):
        return none
    let is_uwp_app = handler_path.contains("AppX") or handler_path.contains("WindowsApps") or handler_path.contains("!") or (!handler_path.to_lowercase().ends_with(".exe") and !handler_path.contains("\\") and !handler_path.contains("/"))
    let exe_path = if is_uwp_app:
        none
    else if handler_path.to_lowercase().ends_with(".exe") and Path__new_(&handler_path).exists():
        Option::Some(handler_path.clone())
    else:
        let mut buffer: Array<u16> = vec!()
        let mut size = buffer.len() as u32
        let prog_hstring = HSTRING__from(&handler_path)
        if windows::Win32::UI::Shell::AssocQueryStringW(windows::Win32::UI::Shell::ASSOCF_NONE, windows::Win32::UI::Shell::ASSOCSTR_EXECUTABLE, &prog_hstring, PCWSTR__null(), windows__core__PWSTR(buffer.as_mut_ptr()), &mut size).is_ok() and size > 1:
            let result = String__from_utf16_lossy(&buffer[..size as usize - 1])
            if Path__new_(&result).exists():
                Option::Some(result)
            else:
                none
        else:
            none
    let final_display_name = display_name.unwrap_or_else(
        || match exe_path:
            Some(exe) =>
                Path__new_(exe).file_stem().and_then(|stem| stem.to_str()).map(|stem| stem.to_string()).unwrap_or_else(|| "Unknown".to_string())
            _ =>
                handler_path.split(&["\\", "/", "!"][..]).next_back().unwrap_or("Unknown").to_string()
    )
    let icon = block:
        let mut icon_path_pwstr: windows::core::PWSTR = PWSTR__null()
        let mut icon_index: i32 = 0
        let handler_icon = handler.GetIconLocation(&mut icon_path_pwstr, &mut icon_index).ok().and_then(
            |_| block:
                if icon_path_pwstr.is_null():
                    return none
                let icon_path_str = pwstr_to_string(icon_path_pwstr)?
                if icon_path_str.starts_with("@{"):
                    match utils__resolve_indirect_string(&icon_path_str):
                        Some(resolved) =>
                            if resolved.to_lowercase().ends_with(".png"):
                                return open_with__utils__load_png_as_base64(Path__new_(&resolved))
                            return utils__get_icon_from_location(&resolved, 0)
                        _ =>
                            ()
                            ()
                    return none
                let expanded_path = if icon_path_str.contains("%"):
                    utils__expand_environment_strings(&icon_path_str).unwrap_or(icon_path_str)
                else:
                    icon_path_str
                if expanded_path.to_lowercase().ends_with(".png"):
                    return open_with__utils__load_png_as_base64(Path__new_(&expanded_path))
                utils__get_icon_from_location(&expanded_path, icon_index)
        )
        let uwp_icon = if is_uwp_app and handler_icon.is_none():
            utils__get_uwp_app_icon(&handler_path)
        else:
            none
        handler_icon.or_(uwp_icon).or_else(|| exe_path.and_then(|path| open_with__utils__get_program_icon(path)))
    let handler_launch_id = handler_path.clone()
    let executable_path = exe_path.clone()
    let actual_path = executable_path.clone().unwrap_or_else(|| handler_path.clone())
    Option::Some(AssociatedProgram { name: final_display_name, path: actual_path, launch_id: Option::Some(handler_launch_id), launch_kind: Option::Some(AssociatedProgramLaunchKind::ShellHandler), executable_path: executable_path, icon: icon, is_default: false })

fn pwstr_to_string(pwstr: windows::core::PWSTR) -> Option<String>:
    utils__pwstr_to_string_and_free(pwstr)

fn get_default_program(extension: String, seen_paths: &Set<String>) -> Option<AssociatedProgram>:
    let mut buffer: Array<u16> = vec!()
    let mut size = buffer.len() as u32
    let ext_hstring = HSTRING__from(extension)
    if windows::Win32::UI::Shell::AssocQueryStringW(windows::Win32::UI::Shell::ASSOCF_NONE, windows::Win32::UI::Shell::ASSOCSTR_EXECUTABLE, &ext_hstring, PCWSTR__null(), windows__core__PWSTR(buffer.as_mut_ptr()), &mut size).is_ok() and size > 1:
