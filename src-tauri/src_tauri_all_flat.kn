        return Option::Some(AssociatedProgram { name: friendly_name, path: exe_path.clone(), launch_id: Option::Some(exe_path.clone()), launch_kind: Option::Some(AssociatedProgramLaunchKind::ExecutablePath), executable_path: Option::Some(exe_path), icon: icon, is_default: false })
