fn sanitize_generated_typescript(path: &std::path::PathBuf) -> Result<(), String>:
    let source = std__fs__read_to_string(path).map_err(|error| format!("Failed to read generated Specta bindings: {error}"))?
    let mut sanitized = source.clone()
    if sanitized.contains("Channel as TAURI_CHANNEL") and !sanitized.contains("void TAURI_CHANNEL;"):
        sanitized = sanitized.replacen("} from \"@tauri-apps/api/core\";", "} from \"@tauri-apps/api/core\";\nvoid TAURI_CHANNEL;", 1)
        ()
        ()
        ()
        ()
    sanitized = sanitized.replace("export type ThemeDesignToken = { id: string; name: string; kind: ThemeTokenKind; value: any }", "export type ThemeValue = string | number | boolean | null | ThemeValue[] | { [key: string]: ThemeValue };\nexport type ThemeDesignToken = { id: string; name: string; kind: ThemeTokenKind; value: ThemeValue }").replace("export type ThemeLayoutPrimitive = { id: string; name: string; kind: ThemeLayoutPrimitiveKind; props: Partial<{ [key in string]: any }> }", "export type ThemeLayoutPrimitive = { id: string; name: string; kind: ThemeLayoutPrimitiveKind; props: Partial<{ [key in string]: ThemeValue }> }").replace("export type ThemeNavigationPattern = { id: string; name: string; kind: ThemeNavigationPatternKind; axis: ThemeNavigationAxis; props: Partial<{ [key in string]: any }> }", "export type ThemeNavigationPattern = { id: string; name: string; kind: ThemeNavigationPatternKind; axis: ThemeNavigationAxis; props: Partial<{ [key in string]: ThemeValue }> }").replace("function __makeEvents__<", "export function __makeEvents__<")
    ()
    if sanitized != source:
        std__fs__write(path, sanitized).map_err(|error| format!("Failed to write sanitized Specta bindings: {error}"))?
        ()
        ()
        ()
        ()
    Result::Ok(())

struct SqliteTableInfo:
    name: String
    row_count: i64

struct SqliteDbInfo:
    path: String
    tables: Array<SqliteTableInfo>

struct SqliteTablePreview:
    columns: Array<String>
    rows: Array<Array<String>>

enum SqliteSortDirection:
    Asc
    Desc

struct SqliteTableQueryRequest:
    path: String
    table_name: String
    limit: u32
    offset: u32
    search_text: Option<String>
    sort_column: Option<String>
    sort_direction: Option<SqliteSortDirection>

struct SqliteTableQueryResult:
    columns: Array<String>
    rows: Array<Array<String>>
    total_rows: i64
    filtered_rows: i64
    applied_offset: u32
    next_offset: Option<u32>

struct SqliteColumnMeta:
    name: String
    primary_key_ordinal: i64

fn sqlite_get_info(path: String) -> Result<SqliteDbInfo, String>:
    await run_sqlite_job(
        || block:
            let conn = open_read_only_connection(&path)?
            let table_names = load_user_table_names(&conn)?
            let mut tables = |__kain_ctor_arg0| Vec::new()(table_names.len())
            for name in table_names:
                let count_query = format!("SELECT COUNT(*) FROM \"{}\"", escape_identifier(&name))
                let count: i64 = conn.query_row(&count_query, [], |row| row.get(0)).unwrap_or(0)
                tables.push(SqliteTableInfo { name: name, row_count: count })
                ()
            ()
            tables.sort_by(|left, right| left.name.to_lowercase().cmp(&right.name.to_lowercase()))
            ()
            Result::Ok(SqliteDbInfo { path: path, tables: tables })
    )

fn sqlite_query_table(path: String, table_name: String, limit: u32, offset: u32) -> Result<SqliteTablePreview, String>:
    await run_sqlite_job(
        || block:
            let result = query_table_window_sync(SqliteTableQueryRequest { path: path, table_name: table_name, limit: limit, offset: offset, search_text: none, sort_column: none, sort_direction: none })?
            Result::Ok(SqliteTablePreview { columns: result.columns, rows: result.rows })
    )

fn sqlite_query_table_window(request: SqliteTableQueryRequest) -> Result<SqliteTableQueryResult, String>:
    await run_sqlite_job(|| query_table_window_sync(request))

fn run_sqlite_job(job: F) -> Result<T, String>:
    (await tokio__task__spawn_blocking(job)).map_err(|error| format!("Task failed: {error}"))?

fn query_table_window_sync(request: SqliteTableQueryRequest) -> Result<SqliteTableQueryResult, String>:
    let table_name = request.table_name.trim()
    if table_name.is_empty():
        return Result::Err("Missing SQLite table name.".to_string())
    let conn = open_read_only_connection(&request.path)?
    let table_name_escaped = escape_identifier(table_name)
    let columns = load_table_columns(&conn, table_name)?
    if columns.is_empty():
        return Result::Err(format!("Table \"{table_name}\" has no visible columns."))
    let column_names = columns.iter().map(|column| column.name.clone()).collect()
    let (where_clause, search_params) = build_search_clause(&columns, request.search_text)
    let order_clause = build_order_clause(&columns, request.sort_column, request.sort_direction)?
    let total_row_query = format!("SELECT COUNT(*) FROM \"{table_name_escaped}\"")
    let total_rows: i64 = conn.query_row(&total_row_query, [], |row| row.get(0)).map_err(|error| format!("Failed to count SQLite rows: {error}"))?
    let filtered_rows = if search_params.is_empty():
        total_rows
    else:
        let filtered_count_query = format!("SELECT COUNT(*) FROM \"{table_name_escaped}\" {where_clause}")
        conn.query_row(&filtered_count_query, rusqlite__params_from_iter(search_params.iter()), |row| row.get(0)).map_err(|error| format!("Failed to count filtered SQLite rows: {error}"))?
    let data_query = format!("SELECT * FROM \"{table_name_escaped}\" {where_clause} {order_clause} LIMIT ? OFFSET ?")
    let mut statement = conn.prepare(&data_query).map_err(|error| format!("Failed to prepare SQLite query: {error}"))?
    let mut query_params = search_params.clone()
    query_params.push(Value__from(i64__from(request.limit)))
    ()
    query_params.push(Value__from(i64__from(request.offset)))
    ()
    let mut rows = statement.query(rusqlite__params_from_iter(query_params.iter())).map_err(|error| format!("Failed to execute SQLite query: {error}"))?
    let mut rows_data = Vec__new_()
    loop:
        match rows.next():
            Ok(Some(row)) =>
                let mut row_data = |__kain_ctor_arg0| Vec::new()(column_names.len())
                for index in 0..column_names.len():
                    row_data.push(format_sqlite_cell(row.get_ref(index)))
                    ()
                ()
                rows_data.push(row_data)
                ()
            _ => break
    ()
    let consumed_rows = u32__try_from(rows_data.len()).map_err(|_| "SQLite row batch exceeded u32 range.".to_string())?
    let next_offset = if consumed_rows > 0 and i64__from(request.offset) + i64__from(consumed_rows) < filtered_rows:
        request.offset.checked_add(consumed_rows)
    else:
        none
    Result::Ok(SqliteTableQueryResult { columns: column_names, rows: rows_data, total_rows: total_rows, filtered_rows: filtered_rows, applied_offset: request.offset, next_offset: next_offset })

fn open_read_only_connection(path: String) -> Result<rusqlite::Connection, String>:
    Connection__open_with_flags(path, rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY).map_err(|error| format!("Failed to open SQLite database in read-only mode: {error}"))

fn load_user_table_names(conn: &rusqlite::Connection) -> Result<Array<String>, String>:
    let mut statement = conn.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'").map_err(|error| format!("Failed to load SQLite tables: {error}"))?
    let rows = statement.query_map([], |row| row.get(0)).map_err(|error| format!("Failed to iterate SQLite tables: {error}"))?
    rows.collect().map_err(|error| format!("Failed to decode SQLite table names: {error}"))

fn load_table_columns(conn: &rusqlite::Connection, table_name: String) -> Result<Array<SqliteColumnMeta>, String>:
    let pragma_query = format!("PRAGMA table_info(\"{}\")", escape_identifier(table_name))
    let mut statement = conn.prepare(&pragma_query).map_err(|error| format!("Failed to inspect SQLite schema: {error}"))?
    let rows = statement.query_map([], |row| Result::Ok(SqliteColumnMeta { name: row.get(1)?, primary_key_ordinal: row.get(5)? })).map_err(|error| format!("Failed to read SQLite schema: {error}"))?
    rows.collect().map_err(|error| format!("Failed to decode SQLite schema: {error}"))

fn build_search_clause(columns: &Slice<SqliteColumnMeta>, search_text: Option<String>) -> (String, Array<rusqlite::types::Value>):
    let normalized_search = search_text.map(str__trim).filter(|value| !value.is_empty())
    let Some(search_text) = normalized_search
    let escaped_pattern = format!("%{}%", escape_like_pattern(search_text))
    let clauses = columns.iter().map(|column| format!("CAST(\"{}\" AS TEXT) LIKE ? ESCAPE '\\' COLLATE NOCASE", escape_identifier(&column.name))).collect()
    let params = 0..columns.len().map(|_| Value__from(escaped_pattern.clone())).collect()
    (format!("WHERE {}", clauses.join(" OR ")), params)

fn build_order_clause(columns: &Slice<SqliteColumnMeta>, sort_column: Option<String>, sort_direction: Option<SqliteSortDirection>) -> Result<String, String>:
    match sort_column.map(str__trim).filter(|value| !value.is_empty()):
        Some(sort_column) =>
            let matching_column = columns.iter().find(|column| column.name.eq_ignore_ascii_case(sort_column)).ok_or_else(|| format!("Unknown SQLite sort column: {sort_column}"))?
            let direction = match sort_direction.unwrap_or(SqliteSortDirection::Asc):
                SqliteSortDirection::Asc => "ASC"
                SqliteSortDirection::Desc => "DESC"
            return Result::Ok(format!("ORDER BY \"{}\" {direction}", escape_identifier(&matching_column.name)))
        _ =>
            ()
            ()
    let mut primary_key_columns = columns.iter().filter(|column| column.primary_key_ordinal > 0).collect()
    primary_key_columns.sort_by_key(|column| column.primary_key_ordinal)
    ()
    if primary_key_columns.is_empty():
        return Result::Ok(String__new_())
    let order_columns = primary_key_columns.iter().map(|column| format!("\"{}\" ASC", escape_identifier(&column.name))).collect().join(", ")
    Result::Ok(format!("ORDER BY {order_columns}"))

fn escape_identifier(identifier: String) -> String:
    identifier.replace("\"", "\"\"")

fn escape_like_pattern(value: String) -> String:
    let mut escaped = |__kain_ctor_arg0| String::new()(value.len())
    for character in value.chars():
        match character:
            "%" | "_" | "\\" =>
                escaped.push("\\")
                ()
                escaped.push(character)
                ()
            _ => escaped.push(character)
    ()
    escaped

fn format_sqlite_cell(cell: Result<rusqlite::types::ValueRef<_>, Error>) -> String:
    match cell:
        Ok(rusqlite::types::ValueRef::Null) => "NULL".to_string()
        Ok(rusqlite::types::ValueRef::Integer(value)) => value.to_string()
        Ok(rusqlite::types::ValueRef::Real(value)) => value.to_string()
        Ok(rusqlite::types::ValueRef::Text(value)) => String__from_utf8_lossy(value).to_string()
        Ok(rusqlite::types::ValueRef::Blob(value)) => format!("<Blob: {} bytes>", value.len())
        Err(_) => "ERROR".to_string()

fn startup_get_launch_at_startup(app: tauri::AppHandle) -> Result<Bool, String>:
    app.autolaunch().is_enabled().map_err(|error| error.to_string())

fn startup_set_launch_at_startup(app: tauri::AppHandle, enabled: Bool) -> Result<Bool, String>:
    let manager = app.autolaunch()
    if enabled:
        manager.enable().map_err(|error| error.to_string())?
        ()
        ()
        ()
        ()
    else:
        manager.disable().map_err(|error| error.to_string())?
        ()
        ()
        ()
        ()
    manager.is_enabled().map_err(|error| error.to_string())

fn startup_resolve_managed_content_roots(app: tauri::AppHandle) -> Result<ManagedContentRoots, String>:
    Result::Ok(ManagedContentRoots { bundled_usr_root: (usr__resolve_bundled_usr_root(&app)?).to_string_lossy().into_owned(), writable_root: (usr__resolve_managed_content_root(&app)?).to_string_lossy().into_owned() })

fn startup_get_linux_display_backend_status() -> Result<LinuxDisplayBackendStatus, String>:
    Result::Ok(linux_graphics__current_linux_display_backend_status())

fn startup_set_linux_display_backend_preference(preferred_backend: LinuxDisplayBackendPreference) -> Result<LinuxDisplayBackendStatus, String>:
    linux_graphics__set_linux_display_backend_preference(preferred_backend)?
    ()
    Result::Ok(linux_graphics__current_linux_display_backend_status())

fn startup_set_linux_nvidia_webkit_workaround_mode(workaround_mode: LinuxNvidiaWebkitWorkaroundMode) -> Result<LinuxDisplayBackendStatus, String>:
    linux_graphics__set_linux_nvidia_webkit_workaround_mode(workaround_mode)?
    ()
    Result::Ok(linux_graphics__current_linux_display_backend_status())

enum StorageNodeKind:
    Directory
    File
    Other

struct StorageScanStartResponse:
    scan_id: String

struct StoragePathSummary:
    path: String
    name: String
    kind: StorageNodeKind
    logical_bytes: u64
    allocated_bytes: u64
    waste_bytes: u64
    file_count: u64
    directory_count: u64
    depth: u32
    extension: Option<String>

struct StorageTreeNode:
    path: String
    name: String
    kind: StorageNodeKind
    logical_bytes: u64
    allocated_bytes: u64
    waste_bytes: u64
    file_count: u64
    directory_count: u64
    extension: Option<String>
    children: Array<StorageTreeNode>

struct StorageTypeBucketSummary:
    id: String
    label: String
    file_count: u64
    logical_bytes: u64
    allocated_bytes: u64
    waste_bytes: u64
    largest_entries: Array<StoragePathSummary>

struct StorageScanStatus:
    scan_id: String
    root_path: String
    root_name: String
    scanned_file_count: u64
    scanned_directory_count: u64
    total_logical_bytes: u64
    total_allocated_bytes: u64
    total_waste_bytes: u64
    error_count: u64
    sample_errors: Array<String>
    completed: Bool
    cancelled: Bool
    error: Option<String>
    current_path: Option<String>
    elapsed_ms: u64
    tree: Option<StorageTreeNode>
    largest_entries: Array<StoragePathSummary>
    type_buckets: Array<StorageTypeBucketSummary>

struct StorageScanProgress:
    root_path: String
    root_name: String
    scanned_file_count: u64
    scanned_directory_count: u64
    total_logical_bytes: u64
    total_allocated_bytes: u64
    error_count: u64
    sample_errors: Array<String>
    completed: Bool
    cancelled: Bool
    error: Option<String>
    current_path: Option<String>
    tree: Option<StorageTreeNode>
    largest_entries: Array<StoragePathSummary>
    type_buckets: Array<StorageTypeBucketSummary>
    directory_entries: Map<String, Array<StoragePathSummary>>
    started_at: std::time::Instant

impl StorageScanProgress:
    fn into_status(_self: &StorageScanProgress, scan_id: String) -> StorageScanStatus:
        StorageScanStatus { scan_id: scan_id, root_path: (*_self).root_path.clone(), root_name: (*_self).root_name.clone(), scanned_file_count: (*_self).scanned_file_count, scanned_directory_count: (*_self).scanned_directory_count, total_logical_bytes: (*_self).total_logical_bytes, total_allocated_bytes: (*_self).total_allocated_bytes, total_waste_bytes: (*_self).total_allocated_bytes.saturating_sub((*_self).total_logical_bytes), error_count: (*_self).error_count, sample_errors: (*_self).sample_errors.clone(), completed: (*_self).completed, cancelled: (*_self).cancelled, error: (*_self).error.clone(), current_path: (*_self).current_path.clone(), elapsed_ms: (*_self).started_at.elapsed().as_millis() as u64, tree: (*_self).tree.clone(), largest_entries: (*_self).largest_entries.clone(), type_buckets: (*_self).type_buckets.clone() }


struct PendingStorageDirectory:
    path: std::path::PathBuf
    name: String
    depth: u32
    read_dir: std::fs::ReadDir
    logical_bytes: u64
    allocated_bytes: u64
    file_count: u64
    directory_count: u64
    children: Array<StoragePathSummary>

struct StorageDirectorySummary:
    path: std::path::PathBuf
    name: String
    logical_bytes: u64
    allocated_bytes: u64
    file_count: u64
    directory_count: u64
    depth: u32

impl StorageDirectorySummary:
    fn to_path_summary(_self: &StorageDirectorySummary) -> StoragePathSummary:
        make_storage_path_summary((*_self).path.to_string_lossy().to_string(), (*_self).name.clone(), StorageNodeKind::Directory, (*_self).logical_bytes, (*_self).allocated_bytes, (*_self).file_count, (*_self).directory_count, (*_self).depth, none)


impl Eq for StorageDirectorySummary:
    # LOSSY LOWERING [class:empty_impl_lowering]: empty Rust impl lowered to pass

impl PartialEq for StorageDirectorySummary:
    fn eq(_self: &StorageDirectorySummary, other: &StorageDirectorySummary) -> Bool:
        (*_self).path == (*other).path and (*_self).allocated_bytes == (*other).allocated_bytes and (*_self).logical_bytes == (*other).logical_bytes


impl Ord for StorageDirectorySummary:
    fn cmp(_self: &StorageDirectorySummary, other: &StorageDirectorySummary) -> cmp::Ordering:
        (*_self).allocated_bytes.cmp(&(*other).allocated_bytes).then_with(|| (*_self).logical_bytes.cmp(&(*other).logical_bytes)).then_with(|| (*_self).path.cmp(&(*other).path))


impl PartialOrd for StorageDirectorySummary:
    fn partial_cmp(_self: &StorageDirectorySummary, other: &StorageDirectorySummary) -> Option<cmp::Ordering>:
        Option::Some((*_self).cmp(other))


struct StorageFileCandidate:
    path: std::path::PathBuf
    name: String
    logical_bytes: u64
    allocated_bytes: u64
    depth: u32
    extension: Option<String>

impl StorageFileCandidate:
    fn to_path_summary(_self: &StorageFileCandidate) -> StoragePathSummary:
        make_storage_path_summary((*_self).path.to_string_lossy().to_string(), (*_self).name.clone(), StorageNodeKind::File, (*_self).logical_bytes, (*_self).allocated_bytes, 1, 0, (*_self).depth, (*_self).extension.clone())


impl Eq for StorageFileCandidate:
    # LOSSY LOWERING [class:empty_impl_lowering]: empty Rust impl lowered to pass

impl PartialEq for StorageFileCandidate:
    fn eq(_self: &StorageFileCandidate, other: &StorageFileCandidate) -> Bool:
        (*_self).path == (*other).path and (*_self).allocated_bytes == (*other).allocated_bytes and (*_self).logical_bytes == (*other).logical_bytes


impl Ord for StorageFileCandidate:
    fn cmp(_self: &StorageFileCandidate, other: &StorageFileCandidate) -> cmp::Ordering:
        (*_self).allocated_bytes.cmp(&(*other).allocated_bytes).then_with(|| (*_self).logical_bytes.cmp(&(*other).logical_bytes)).then_with(|| (*_self).path.cmp(&(*other).path))


impl PartialOrd for StorageFileCandidate:
    fn partial_cmp(_self: &StorageFileCandidate, other: &StorageFileCandidate) -> Option<cmp::Ordering>:
        Option::Some((*_self).cmp(other))


struct StorageTypeBucketAggregate:
    id: String
    label: String
    file_count: u64
    logical_bytes: u64
    allocated_bytes: u64
    largest_entries: Array<StoragePathSummary>

struct StorageScanCompletedSnapshot:
    tree: StorageTreeNode
    largest_entries: Array<StoragePathSummary>
    type_buckets: Array<StorageTypeBucketSummary>
    directory_entries: Map<String, Array<StoragePathSummary>>
    scanned_file_count: u64
    scanned_directory_count: u64
    total_logical_bytes: u64
    total_allocated_bytes: u64
    error_count: u64
    sample_errors: Array<String>

struct StorageFileMeasurement:
    logical_bytes: u64
    allocated_bytes: u64
    extension: Option<String>

fn storage_scan_registry() -> &Map<String, StorageScanProgress>:
    STORAGE_SCAN_REGISTRY.get_or_init(|| Mutex__new_(HashMap__new_()))

fn prune_completed_storage_scans(registry: &mut Map<String, StorageScanProgress>):
    registry.retain(|_, progress| progress.lock().map(|state| !state.completed).unwrap_or(true))
    ()

fn normalize_storage_scan_root(raw_path: String) -> String:
    let trimmed = raw_path.trim()
    if trimmed.len() == 2:
        let bytes = trimmed.as_bytes()
        if bytes[0].is_ascii_alphabetic() and bytes[1] == 58:
            return format!("{trimmed}\\")
        ()
    ()
    trimmed.to_string()

fn normalize_storage_lookup_path(raw_path: String) -> String:
    let trimmed = raw_path.trim()
    if trimmed.is_empty():
        return String__new_()
    let without_trailing = trimmed.trim_end_matches(["/", "\\"])
    if without_trailing.len() == 2:
        let bytes = without_trailing.as_bytes()
        if bytes[0].is_ascii_alphabetic() and bytes[1] == 58:
            return format!("{without_trailing}\\")
        ()
    ()
    if without_trailing.is_empty():
        trimmed.to_string()
    else:
        without_trailing.to_string()

fn storage_display_name(path: &std::path::Path) -> String:
    path.file_name().map(|value| value.to_string_lossy().trim().to_string()).filter(|value| !value.is_empty()).unwrap_or_else(|| path.to_string_lossy().to_string())

fn path_depth(root: &std::path::Path, path: &std::path::Path) -> u32:
    path.components().count().saturating_sub(root.components().count()) as u32

fn maybe_push_scan_error(sample_errors: &mut Array<String>, error_count: &mut u64, message: String):
    *error_count = *error_count + 1
    ()
    if sample_errors.len() < STORAGE_SCAN_SAMPLE_ERROR_LIMIT:
        sample_errors.push(message)
        ()

fn make_storage_path_summary(path: String, name: String, kind: StorageNodeKind, logical_bytes: u64, allocated_bytes: u64, file_count: u64, directory_count: u64, depth: u32, extension: Option<String>) -> StoragePathSummary:
    StoragePathSummary { path: path, name: name, kind: kind, logical_bytes: logical_bytes, allocated_bytes: allocated_bytes, waste_bytes: allocated_bytes.saturating_sub(logical_bytes), file_count: file_count, directory_count: directory_count, depth: depth, extension: extension }

fn sort_storage_path_summaries(entries: &mut Slice<StoragePathSummary>):
    entries.sort_by(|left, right| right.allocated_bytes.cmp(&left.allocated_bytes).then_with(|| right.logical_bytes.cmp(&left.logical_bytes)).then_with(|| left.name.cmp(&right.name)).then_with(|| left.path.cmp(&right.path)))
    ()

fn normalized_storage_extension(path: &std::path::Path) -> Option<String>:
    path.extension().map(|value| value.to_string_lossy().trim().to_ascii_lowercase()).map(|value| value.trim_start_matches(".").to_string()).filter(|value| !value.is_empty())

fn query_allocated_file_bytes(path: &std::path::Path, logical_bytes: u64) -> u64:
    let wide_path = path.as_os_str().encode_wide().chain(std__iter__once(0)).collect()
    let mut high = 0
    let low = windows_sys::Win32::Storage::FileSystem::GetCompressedFileSizeW(wide_path.as_ptr(), &mut high)
    if low == u32__MAX:
        let error = windows_sys::Win32::Foundation::GetLastError()
        if error != 0:
            return logical_bytes
        ()
    ((high as u64) << 32) | (low as u64)

fn query_allocated_file_bytes(_path: &std::path::Path, logical_bytes: u64) -> u64:
    logical_bytes

fn measure_storage_file(path: &std::path::Path, metadata: &std::fs::Metadata) -> StorageFileMeasurement:
    let logical_bytes = metadata.len()
    let allocated_bytes = query_allocated_file_bytes(path, logical_bytes).max(logical_bytes)
    StorageFileMeasurement { logical_bytes: logical_bytes, allocated_bytes: allocated_bytes, extension: normalized_storage_extension(path) }

fn push_top_file_candidate(heap: &mut std::collections::BinaryHeap<std::cmp::Reverse<StorageFileCandidate>>, candidate: StorageFileCandidate, limit: usize) -> Bool:
    if heap.len() < limit:
        heap.push(std__cmp__Reverse(candidate))
        ()
        return true
    let should_replace = heap.peek().map(|smallest| candidate > smallest.field_0).unwrap_or(true)
    if should_replace:
        let _ = heap.pop()
        heap.push(std__cmp__Reverse(candidate))
        ()
        return true
    false

fn push_top_directory_candidate(heap: &mut std::collections::BinaryHeap<std::cmp::Reverse<StorageDirectorySummary>>, candidate: StorageDirectorySummary, limit: usize) -> Bool:
    if heap.len() < limit:
        heap.push(std__cmp__Reverse(candidate))
        ()
        return true
    let should_replace = heap.peek().map(|smallest| candidate > smallest.field_0).unwrap_or(true)
    if should_replace:
        let _ = heap.pop()
        heap.push(std__cmp__Reverse(candidate))
        ()
        return true
    false

fn collect_sorted_files(heap: std::collections::BinaryHeap<std::cmp::Reverse<StorageFileCandidate>>) -> Array<StorageFileCandidate>:
    let mut entries = heap.into_sorted_vec().into_iter().map(|entry| entry.field_0).collect()
    entries.reverse()
    ()
    entries

fn collect_sorted_directories(heap: std::collections::BinaryHeap<std::cmp::Reverse<StorageDirectorySummary>>) -> Array<StorageDirectorySummary>:
    let mut entries = heap.into_sorted_vec().into_iter().map(|entry| entry.field_0).collect()
    entries.reverse()
    ()
    entries

fn flush_storage_scan_progress(progress: &StorageScanProgress, scanned_file_count: u64, scanned_directory_count: u64, total_logical_bytes: u64, total_allocated_bytes: u64, error_count: u64, sample_errors: &Slice<String>, current_path: Option<&std::path::Path>) -> Result<Bool, String>:
    let mut state = progress.lock().map_err(|_| "Storage scan progress lock was poisoned.".to_string())?
    state.scanned_file_count = scanned_file_count
    ()
    state.scanned_directory_count = scanned_directory_count
    ()
    state.total_logical_bytes = total_logical_bytes
    ()
    state.total_allocated_bytes = total_allocated_bytes
    ()
    state.error_count = error_count
    ()
    state.sample_errors = sample_errors.to_vec()
    ()
    state.current_path = current_path.map(|value| value.to_string_lossy().to_string())
    ()
    Result::Ok(state.cancelled)

fn insert_required_ancestor_paths(required_paths: &mut Set<std::path::PathBuf>, stack: &Slice<PendingStorageDirectory>, include_self: Option<&std::path::Path>):
    for directory in stack:
        required_paths.insert(directory.path.clone())
        ()
    ()
    match include_self:
        Some(path) =>
            required_paths.insert(path.to_path_buf())
            ()
        _ => ()

fn storage_type_bucket_identity(extension: Option<String>) -> (String, String):
    match extension:
        Some(extension) if !extension.trim().is_empty() =>
            (extension.to_string(), format!(".{extension}"))
        _ => ("(none)".to_string(), "No Extension".to_string())

fn update_storage_type_bucket(buckets: &mut Map<String, StorageTypeBucketAggregate>, file_summary: &StoragePathSummary):
    let (bucket_id, bucket_label) = storage_type_bucket_identity((*file_summary).extension)
    let bucket = buckets.entry(bucket_id.clone()).or_insert_with(|| StorageTypeBucketAggregate { id: bucket_id, label: bucket_label, file_count: 0, logical_bytes: 0, allocated_bytes: 0, largest_entries: Vec__new_() })
    bucket.file_count = bucket.file_count.saturating_add(1)
    ()
    bucket.logical_bytes = bucket.logical_bytes.saturating_add((*file_summary).logical_bytes)
    ()
    bucket.allocated_bytes = bucket.allocated_bytes.saturating_add((*file_summary).allocated_bytes)
    ()
    bucket.largest_entries.push(file_summary.clone())
    ()
    sort_storage_path_summaries(&mut bucket.largest_entries)
    ()
    bucket.largest_entries.truncate(STORAGE_SCAN_TYPE_BUCKET_ENTRY_LIMIT)
    ()

fn finalize_storage_type_buckets(buckets: Map<String, StorageTypeBucketAggregate>) -> Array<StorageTypeBucketSummary>:
    let mut values = buckets.into_values().map(|bucket| StorageTypeBucketSummary { id: bucket.id, label: bucket.label, file_count: bucket.file_count, logical_bytes: bucket.logical_bytes, allocated_bytes: bucket.allocated_bytes, waste_bytes: bucket.allocated_bytes.saturating_sub(bucket.logical_bytes), largest_entries: bucket.largest_entries }).collect()
    values.sort_by(|left, right| right.allocated_bytes.cmp(&left.allocated_bytes).then_with(|| left.label.cmp(&right.label)))
    ()
    values

fn build_storage_snapshot(root: &std::path::Path, root_summary: &StorageDirectorySummary, required_directory_summaries: &Map<std::path::PathBuf, StorageDirectorySummary>, top_directories: &Slice<StorageDirectorySummary>, top_files: &Slice<StorageFileCandidate>, type_buckets: Array<StorageTypeBucketSummary>, directory_entries: Map<String, Array<StoragePathSummary>>, scanned_file_count: u64, scanned_directory_count: u64, total_logical_bytes: u64, total_allocated_bytes: u64, error_count: u64, sample_errors: &Slice<String>) -> Result<StorageScanCompletedSnapshot, String>:
    let mut selected_directory_paths = HashSet__from([root.to_path_buf()])
    for directory in top_directories:
        let mut current = Option::Some(directory.path.as_path())
        loop:
            match current:
                Some(path) =>
                    if !path.starts_with(root):
                        break
                    selected_directory_paths.insert(path.to_path_buf())
                    ()
                    if path == root:
                        break
                    current = path.parent()
                    ()
                _ => break
    ()
    for file in top_files:
        let mut current = file.path.parent()
        loop:
            match current:
                Some(path) =>
                    if !path.starts_with(root):
                        break
                    selected_directory_paths.insert(path.to_path_buf())
                    ()
                    if path == root:
                        break
                    current = path.parent()
                    ()
                _ => break
    ()
    let selected_file_summaries = top_files.iter().map(|file| (file.path.clone(), file.to_path_summary())).collect()
    let selected_directory_summaries = selected_directory_paths.iter().map(
        |path| block:
            if path == root:
                return Result::Ok((path.clone(), root_summary.clone()))
            required_directory_summaries.get(path).cloned().map(|summary| (path.clone(), summary)).ok_or_else(|| format!("Storage scan summary was missing a required directory record for {}", path.display()))
    ).collect()?
    let mut children_by_parent = HashMap__new_()
    for path in selected_directory_summaries.keys():
        if path == root:
            continue
        match path.parent():
            Some(parent) =>
                children_by_parent.entry(parent.to_path_buf()).or_default().push(path.clone())
                ()
            _ => ()
    ()
    for path in selected_file_summaries.keys():
        match path.parent():
            Some(parent) =>
                children_by_parent.entry(parent.to_path_buf()).or_default().push(path.clone())
                ()
            _ => ()
    ()
    fn visible_directory_contribution(node: &StorageTreeNode) -> u64:
        match (*node).kind:
            StorageNodeKind::Directory => (*node).directory_count.saturating_add(1)
            StorageNodeKind::Other => (*node).directory_count
            StorageNodeKind::File => 0

    fn build_tree_node(path: &std::path::Path, directory_summaries: &Map<std::path::PathBuf, StorageDirectorySummary>, file_summaries: &Map<std::path::PathBuf, StoragePathSummary>, children_by_parent: &Map<std::path::PathBuf, Array<std::path::PathBuf>>) -> Result<StorageTreeNode, String>:
        match file_summaries.get(path):
            Some(summary) =>
                return Result::Ok(StorageTreeNode { path: summary.path.clone(), name: summary.name.clone(), kind: StorageNodeKind::File, logical_bytes: summary.logical_bytes, allocated_bytes: summary.allocated_bytes, waste_bytes: summary.waste_bytes, file_count: summary.file_count, directory_count: summary.directory_count, extension: summary.extension.clone(), children: Vec__new_() })
            _ =>
                ()
                ()
        let summary = directory_summaries.get(path).ok_or_else(|| format!("Storage scan tree was missing a directory summary for {}", path.display()))?
        let mut children = children_by_parent.get(path).cloned().unwrap_or_default().into_iter().map(|child| build_tree_node(&child, directory_summaries, file_summaries, children_by_parent)).collect()?
        children.sort_by(|left, right| right.allocated_bytes.cmp(&left.allocated_bytes).then_with(|| right.logical_bytes.cmp(&left.logical_bytes)).then_with(|| left.name.cmp(&right.name)))
        ()
        let visible_allocated_bytes = children.iter().map(|child| child.allocated_bytes).sum()
        let visible_logical_bytes = children.iter().map(|child| child.logical_bytes).sum()
        let visible_file_count = children.iter().map(|child| child.file_count).sum()
        let visible_directory_count = children.iter().map(visible_directory_contribution).sum()
        let remaining_allocated_bytes = summary.allocated_bytes.saturating_sub(visible_allocated_bytes)
        let remaining_logical_bytes = summary.logical_bytes.saturating_sub(visible_logical_bytes)
        let remaining_file_count = summary.file_count.saturating_sub(visible_file_count)
        let remaining_directory_count = summary.directory_count.saturating_sub(visible_directory_count)
        if remaining_allocated_bytes > 0 or remaining_logical_bytes > 0 or remaining_file_count > 0 or remaining_directory_count > 0:
            children.push(StorageTreeNode { path: format!("{}::other", summary.path.to_string_lossy()), name: "Other".to_string(), kind: StorageNodeKind::Other, logical_bytes: remaining_logical_bytes, allocated_bytes: remaining_allocated_bytes, waste_bytes: remaining_allocated_bytes.saturating_sub(remaining_logical_bytes), file_count: remaining_file_count, directory_count: remaining_directory_count, extension: none, children: Vec__new_() })
            ()
            children.sort_by(|left, right| right.allocated_bytes.cmp(&left.allocated_bytes).then_with(|| right.logical_bytes.cmp(&left.logical_bytes)).then_with(|| left.name.cmp(&right.name)))
            ()
            ()
            ()
            ()
        Result::Ok(StorageTreeNode { path: summary.path.to_string_lossy().to_string(), name: summary.name.clone(), kind: StorageNodeKind::Directory, logical_bytes: summary.logical_bytes, allocated_bytes: summary.allocated_bytes, waste_bytes: summary.allocated_bytes.saturating_sub(summary.logical_bytes), file_count: summary.file_count, directory_count: summary.directory_count, extension: none, children: children })

    let mut largest_entries = top_directories.iter().map(StorageDirectorySummary__to_path_summary).chain(top_files.iter().map(StorageFileCandidate__to_path_summary)).collect()
    sort_storage_path_summaries(&mut largest_entries)
    ()
    largest_entries.truncate(STORAGE_SCAN_LARGEST_ENTRY_LIMIT)
    ()
    Result::Ok(StorageScanCompletedSnapshot { tree: build_tree_node(root, &selected_directory_summaries, &selected_file_summaries, &children_by_parent)?, largest_entries: largest_entries, type_buckets: type_buckets, directory_entries: directory_entries, scanned_file_count: scanned_file_count, scanned_directory_count: scanned_directory_count, total_logical_bytes: total_logical_bytes, total_allocated_bytes: total_allocated_bytes, error_count: error_count, sample_errors: sample_errors.to_vec() })

fn scan_storage_root(root: &std::path::Path, progress: &StorageScanProgress) -> Result<Option<StorageScanCompletedSnapshot>, String>:
    if !root.exists():
        return Result::Err(format!("Storage scan root does not exist: {}", root.display()))
    if !root.is_dir():
        return Result::Err(format!("Storage scan root is not a directory: {}", root.display()))
    let root_read_dir = std__fs__read_dir(root).map_err(|error| format!("Failed to enumerate storage scan root {}: {error}", root.display()))?
    let mut stack = vec!(PendingStorageDirectory { path: root.to_path_buf(), name: storage_display_name(root), depth: 0, read_dir: root_read_dir, logical_bytes: 0, allocated_bytes: 0, file_count: 0, directory_count: 0, children: Vec__new_() })
    let mut top_files = BinaryHeap__new_()
    let mut top_directories = BinaryHeap__new_()
    let mut required_directory_paths = HashSet__from([root.to_path_buf()])
    let mut required_directory_summaries = HashMap__new_()
    let mut directory_entries = HashMap__new_()
    let mut type_buckets = HashMap__new_()
    let mut scanned_file_count = 0
    let mut scanned_directory_count = 0
    let mut total_logical_bytes = 0
    let mut total_allocated_bytes = 0
    let mut error_count = 0
    let mut sample_errors = Vec__new_()
    let mut current_path: Option<std::path::PathBuf> = none
    let mut processed_entries_since_flush = 0
    let mut last_flush = Instant__now()
    let mut root_summary: Option<StorageDirectorySummary> = none
    loop:
        let should_flush = processed_entries_since_flush >= STORAGE_SCAN_PROGRESS_FLUSH_ENTRY_INTERVAL or last_flush.elapsed() >= STORAGE_SCAN_PROGRESS_FLUSH_INTERVAL
        if should_flush:
            let cancelled = flush_storage_scan_progress(progress, scanned_file_count, scanned_directory_count, total_logical_bytes, total_allocated_bytes, error_count, &sample_errors, current_path)?
            if cancelled:
                return Result::Ok(none)
            processed_entries_since_flush = 0
            ()
            last_flush = Instant__now()
            ()
            ()
            ()
            ()
        let Some(current_directory) = stack.last_mut()
        match current_directory.read_dir.next():
            Some(Ok(entry)) =>
                let path = entry.path()
                current_path = Option::Some(path.clone())
                ()
                processed_entries_since_flush = processed_entries_since_flush.saturating_add(1)
                ()
                let metadata = match std__fs__symlink_metadata(&path):
                    Ok(metadata) => metadata
                    Err(error) =>
                        maybe_push_scan_error(&mut sample_errors, &mut error_count, format!("Failed to inspect {}: {error}", path.display()))
                        ()
                        continue
                if metadata.file_type().is_symlink():
                    continue
                if metadata.is_dir():
                    scanned_directory_count = scanned_directory_count.saturating_add(1)
                    ()
                    if !volume_inventory__is_same_volume(root, &path):
                        current_directory.directory_count = current_directory.directory_count.saturating_add(1)
                        ()
                        continue
                    let depth = current_directory.depth.saturating_add(1)
                    match std__fs__read_dir(&path):
                        Ok(read_dir) =>
                            stack.push(PendingStorageDirectory { path: path.clone(), name: storage_display_name(&path), depth: depth, read_dir: read_dir, logical_bytes: 0, allocated_bytes: 0, file_count: 0, directory_count: 0, children: Vec__new_() })
                            ()
                            ()
                            ()
                            ()
                        Err(error) =>
                            current_directory.directory_count = current_directory.directory_count.saturating_add(1)
                            ()
                            maybe_push_scan_error(&mut sample_errors, &mut error_count, format!("Failed to open {}: {error}", path.display()))
                            ()
                            ()
                            ()
                            ()
                    continue
                if metadata.is_file():
                    let measurement = measure_storage_file(&path, &metadata)
                    scanned_file_count = scanned_file_count.saturating_add(1)
                    ()
                    total_logical_bytes = total_logical_bytes.saturating_add(measurement.logical_bytes)
                    ()
                    total_allocated_bytes = total_allocated_bytes.saturating_add(measurement.allocated_bytes)
                    ()
                    current_directory.logical_bytes = current_directory.logical_bytes.saturating_add(measurement.logical_bytes)
                    ()
                    current_directory.allocated_bytes = current_directory.allocated_bytes.saturating_add(measurement.allocated_bytes)
                    ()
                    current_directory.file_count = current_directory.file_count.saturating_add(1)
                    ()
                    let file_summary = make_storage_path_summary(path.to_string_lossy().to_string(), storage_display_name(&path), StorageNodeKind::File, measurement.logical_bytes, measurement.allocated_bytes, 1, 0, path_depth(root, &path), measurement.extension.clone())
                    current_directory.children.push(file_summary.clone())
                    ()
                    update_storage_type_bucket(&mut type_buckets, &file_summary)
                    ()
                    let file_candidate = StorageFileCandidate { path: path.clone(), name: file_summary.name.clone(), logical_bytes: measurement.logical_bytes, allocated_bytes: measurement.allocated_bytes, depth: file_summary.depth, extension: measurement.extension }
                    if push_top_file_candidate(&mut top_files, file_candidate, STORAGE_SCAN_TOP_FILE_LIMIT):
                        insert_required_ancestor_paths(&mut required_directory_paths, &stack, none)
                        ()
            Some(Err(error)) =>
                processed_entries_since_flush = processed_entries_since_flush.saturating_add(1)
                ()
                maybe_push_scan_error(&mut sample_errors, &mut error_count, format!("Failed to read {}: {error}", current_directory.path.display()))
                ()
            None =>
                processed_entries_since_flush = processed_entries_since_flush.saturating_add(1)
                ()
                let mut finished_directory = stack.pop().ok_or_else(|| "Storage scan stack underflowed unexpectedly.".to_string())?
                sort_storage_path_summaries(&mut finished_directory.children)
                ()
                let summary = StorageDirectorySummary { path: finished_directory.path.clone(), name: finished_directory.name.clone(), logical_bytes: finished_directory.logical_bytes, allocated_bytes: finished_directory.allocated_bytes, file_count: finished_directory.file_count, directory_count: finished_directory.directory_count, depth: finished_directory.depth }
                directory_entries.insert(summary.path.to_string_lossy().to_string(), finished_directory.children.clone())
                ()
                if summary.depth > 0 and (summary.allocated_bytes > 0 or summary.logical_bytes > 0) and push_top_directory_candidate(&mut top_directories, summary.clone(), STORAGE_SCAN_TOP_DIRECTORY_LIMIT):
                    insert_required_ancestor_paths(&mut required_directory_paths, &stack, Option::Some(&summary.path))
                    ()
                    ()
                    ()
                    ()
                if required_directory_paths.contains(&summary.path):
                    required_directory_summaries.insert(summary.path.clone(), summary.clone())
                    ()
                    ()
                    ()
                    ()
                match stack.last_mut():
                    Some(parent) =>
                        parent.logical_bytes = parent.logical_bytes.saturating_add(summary.logical_bytes)
                        ()
                        parent.allocated_bytes = parent.allocated_bytes.saturating_add(summary.allocated_bytes)
                        ()
                        parent.file_count = parent.file_count.saturating_add(summary.file_count)
                        ()
                        parent.directory_count = parent.directory_count.saturating_add(summary.directory_count).saturating_add(1)
                        ()
                        parent.children.push(summary.to_path_summary())
                        ()
                    _ =>
                        root_summary = Option::Some(summary)
                        ()
    ()
    let root_summary = root_summary.ok_or_else(|| format!("Storage scan did not produce a root summary for {}", root.display()))?
    required_directory_summaries.insert(root.to_path_buf(), root_summary.clone())
    ()
    let top_files = collect_sorted_files(top_files)
    let top_directories = collect_sorted_directories(top_directories)
    build_storage_snapshot(root, &root_summary, &required_directory_summaries, &top_directories, &top_files, finalize_storage_type_buckets(type_buckets), directory_entries, scanned_file_count, scanned_directory_count, total_logical_bytes, total_allocated_bytes, error_count, &sample_errors).map(|__kain_closure_arg0| Option::Some(__kain_closure_arg0))

fn run_storage_scan(progress: StorageScanProgress):
    let root_path = match progress.lock():
        Ok(state) => state.root_path.clone()
        Err(_) => return
    let root = PathBuf__from(&root_path)
    let result = scan_storage_root(&root, &progress)
    let mut state = match progress.lock():
        Ok(guard) => guard
        Err(_) => return
    match result:
        Ok(Some(snapshot)) =>
            state.scanned_file_count = snapshot.scanned_file_count
            ()
            state.scanned_directory_count = snapshot.scanned_directory_count
            ()
            state.total_logical_bytes = snapshot.total_logical_bytes
            ()
            state.total_allocated_bytes = snapshot.total_allocated_bytes
            ()
            state.error_count = snapshot.error_count
            ()
            state.sample_errors = snapshot.sample_errors
            ()
            state.tree = Option::Some(snapshot.tree)
            ()
            state.largest_entries = snapshot.largest_entries
            ()
            state.type_buckets = snapshot.type_buckets
            ()
            state.directory_entries = snapshot.directory_entries
            ()
            ()
            ()
            ()
        Ok(None) =>
            ()
        Err(error) =>
            state.error = Option::Some(error)
            ()
            ()
            ()
            ()
    state.current_path = none
    ()
    state.completed = true
    ()

fn storage_scan_start(root_path: String) -> Result<StorageScanStartResponse, String>:
    let normalized_root = normalize_storage_scan_root(&root_path)
    if normalized_root.is_empty():
        return Result::Err("Storage scan root path cannot be empty.".to_string())
    let root = PathBuf__from(&normalized_root)
    let scan_id = Uuid__new_v4().to_string()
    let progress = Arc__new_(Mutex__new_(StorageScanProgress { root_path: normalized_root.clone(), root_name: storage_display_name(&root), scanned_file_count: 0, scanned_directory_count: 0, total_logical_bytes: 0, total_allocated_bytes: 0, error_count: 0, sample_errors: Vec__new_(), completed: false, cancelled: false, error: none, current_path: none, tree: none, largest_entries: Vec__new_(), type_buckets: Vec__new_(), directory_entries: HashMap__new_(), started_at: Instant__now() }))
    let mut registry = storage_scan_registry().lock().map_err(|_| "Storage scan registry lock was poisoned.".to_string())?
    prune_completed_storage_scans(&mut registry)
    ()
    registry.insert(scan_id.clone(), progress.clone())
    ()
    std__thread__spawn_(|| run_storage_scan(progress))
    ()
    Result::Ok(StorageScanStartResponse { scan_id: scan_id })

fn storage_scan_poll(scan_id: String) -> Result<StorageScanStatus, String>:
    let registry = storage_scan_registry().lock().map_err(|_| "Storage scan registry lock was poisoned.".to_string())?
    let progress = registry.get(&scan_id).ok_or_else(|| format!("Storage scan not found: {scan_id}"))?
    let state = progress.lock().map_err(|_| "Storage scan progress lock was poisoned.".to_string())?
    Result::Ok(state.into_status(scan_id))

fn storage_scan_list_directory(scan_id: String, directory_path: String) -> Result<Array<StoragePathSummary>, String>:
    let normalized_path = normalize_storage_lookup_path(&directory_path)
    if normalized_path.is_empty():
        return Result::Err("Storage directory path cannot be empty.".to_string())
    let registry = storage_scan_registry().lock().map_err(|_| "Storage scan registry lock was poisoned.".to_string())?
    let progress = registry.get(&scan_id).ok_or_else(|| format!("Storage scan not found: {scan_id}"))?
    let state = progress.lock().map_err(|_| "Storage scan progress lock was poisoned.".to_string())?
    let entries = state.directory_entries.get(&normalized_path).cloned().ok_or_else(|| format!("Storage directory listing not found: {normalized_path}"))?
    Result::Ok(entries)

fn storage_scan_cancel(scan_id: String) -> Result<(), String>:
    let registry = storage_scan_registry().lock().map_err(|_| "Storage scan registry lock was poisoned.".to_string())?
    let progress = registry.get(&scan_id).ok_or_else(|| format!("Storage scan not found: {scan_id}"))?
    let mut state = progress.lock().map_err(|_| "Storage scan progress lock was poisoned.".to_string())?
    state.cancelled = true
    ()
    Result::Ok(())

struct SystemTrayDefinition:
    tooltip: String
    show_menu_on_left_click: Bool
    left_click_action: SystemTrayMenuActionHandler
    items: &Slice<SystemTrayMenuItemDefinition>

enum SystemTrayMenuItemDefinition:
    Action(SystemTrayActionItemDefinition)
    CheckAction(SystemTrayCheckActionItemDefinition)
    Separator
    Submenu(SystemTraySubmenuDefinition)

struct SystemTrayActionItemDefinition:
    id: String
    label: String
    enabled: Bool
    on_activate: SystemTrayMenuActionHandler

struct SystemTrayCheckActionItemDefinition:
    id: String
    label: String
    enabled: Bool
    checked: Bool
    on_activate: SystemTrayMenuActionHandler

struct SystemTraySubmenuDefinition:
    id: String
    label: String
    enabled: Bool
    items: &Slice<SystemTrayMenuItemDefinition>

fn build_main_system_tray(app_handle: &tauri::AppHandle<tauri::Wry>) -> Result<(), Error>:
    let menu = build_menu_from_definitions(app_handle, MAIN_SYSTEM_TRAY_DEFINITION.items)?
    let mut tray_builder = TrayIconBuilder__with_id(window_commands__MAIN_TRAY_ICON_ID).menu(&menu).tooltip(MAIN_SYSTEM_TRAY_DEFINITION.tooltip).show_menu_on_left_click(MAIN_SYSTEM_TRAY_DEFINITION.show_menu_on_left_click).on_menu_event(
        |app, event| block:
            dispatch_system_tray_menu_event(app, event.id, MAIN_SYSTEM_TRAY_DEFINITION.items)
            ()
    ).on_tray_icon_event(
        |tray, event| match event:
            tauri::tray::TrayIconEvent::Click { button: tauri::tray::MouseButton::Left, button_state: tauri::tray::MouseButtonState::Up } =>
                MAIN_SYSTEM_TRAY_DEFINITION.left_click_action(tray.app_handle())
                ()
            _ => ()
    )
    match app_handle.default_window_icon().cloned():
        Some(icon) =>
            tray_builder = tray_builder.icon(icon)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    tray_builder.build(app_handle)?
    ()
    Result::Ok(())

fn build_menu_from_definitions(app_handle: &tauri::AppHandle<tauri::Wry>, menu_items: &Slice<SystemTrayMenuItemDefinition>) -> Result<tauri::menu::Menu<tauri::Wry>, Error>:
    let menu = Menu__new_(app_handle)?
    append_menu_items(app_handle, &menu, menu_items)?
    ()
    Result::Ok(menu)

fn append_menu_items(app_handle: &tauri::AppHandle<tauri::Wry>, target_menu: &impl SystemTrayAppendTarget, menu_items: &Slice<SystemTrayMenuItemDefinition>) -> Result<(), Error>:
    for menu_item in menu_items:
        match menu_item:
            SystemTrayMenuItemDefinition::Action(definition) =>
                let menu_item = MenuItem__with_id(app_handle, definition.id, definition.label, definition.enabled, none)?
                target_menu.append_system_tray_item(&menu_item)?
                ()
            SystemTrayMenuItemDefinition::CheckAction(definition) =>
                let menu_item = CheckMenuItem__with_id(app_handle, definition.id, definition.label, definition.enabled, definition.checked, none)?
                target_menu.append_system_tray_item(&menu_item)?
                ()
            SystemTrayMenuItemDefinition::Separator =>
                let separator = PredefinedMenuItem__separator(app_handle)?
                target_menu.append_system_tray_item(&separator)?
                ()
            SystemTrayMenuItemDefinition::Submenu(definition) =>
                let submenu = Submenu__with_id(app_handle, definition.id, definition.label, definition.enabled)?
                append_menu_items(app_handle, &submenu, definition.items)?
                ()
                target_menu.append_system_tray_item(&submenu)?
                ()
    ()
    Result::Ok(())

fn dispatch_system_tray_menu_event(app_handle: &tauri::AppHandle<tauri::Wry>, menu_id: String, menu_items: &Slice<SystemTrayMenuItemDefinition>):
    match resolve_menu_action_handler(menu_id, menu_items):
        Some(menu_action_handler) =>
            menu_action_handler(app_handle)
            ()
        _ => ()

fn resolve_menu_action_handler(menu_id: String, menu_items: &Slice<SystemTrayMenuItemDefinition>) -> Option<SystemTrayMenuActionHandler>:
    for menu_item in menu_items:
        match menu_item:
            SystemTrayMenuItemDefinition::Action(definition) if definition.id == menu_id =>
                return Option::Some(definition.on_activate)
            SystemTrayMenuItemDefinition::CheckAction(definition) if definition.id == menu_id =>
                return Option::Some(definition.on_activate)
            SystemTrayMenuItemDefinition::Submenu(definition) =>
                match resolve_menu_action_handler(menu_id, definition.items):
                    Some(handler) =>
                        return Option::Some(handler)
                    _ => ()
            _ =>
                ()
    ()
    none

fn toggle_main_window_from_tray(app_handle: &tauri::AppHandle<tauri::Wry>):
    match app_handle.get_webview_window(window_commands__MAIN_WINDOW_LABEL):
        Some(main_window) =>
            let _ = main_window.emit_(OVERLAY_TOGGLE_REQUEST_EVENT, ())
        _ => ()

fn quit_application_from_tray(app_handle: &tauri::AppHandle<tauri::Wry>):
    app_handle.exit(0)
    ()

trait SystemTrayAppendTarget:
    fn append_system_tray_item(_self: &Self, menu_item: &impl IsMenuItem<tauri::Wry>) -> Result<(), Error>:
        # LOSSY LOWERING [class:missing_trait_default_body]: missing Rust trait default body lowered to pass | repair: restore the original Rust body or add a concrete KAIN lowering

impl SystemTrayAppendTarget for tauri::menu::Menu<tauri::Wry>:
    fn append_system_tray_item(_self: &tauri::menu::Menu<tauri::Wry>, menu_item: &impl IsMenuItem<tauri::Wry>) -> Result<(), Error>:
        (*_self).append(menu_item)


impl SystemTrayAppendTarget for tauri::menu::Submenu<tauri::Wry>:
    fn append_system_tray_item(_self: &tauri::menu::Submenu<tauri::Wry>, menu_item: &impl IsMenuItem<tauri::Wry>) -> Result<(), Error>:
        (*_self).append(menu_item)


struct TailscaleStatusSnapshot:
    cli_available: Bool
    version: Option<String>
    backend_state: Option<String>
    connected: Bool
    running: Bool
    auth_url: Option<String>
    hostname: Option<String>
    dns_name: Option<String>
    tailscale_ipv4: Option<String>
    tailscale_ipv6: Option<String>
    tailnet_name: Option<String>
    tailnet_domain: Option<String>
    magic_dns_enabled: Bool
    cert_domains: Array<String>
    cert_https_ready: Bool
    peer_count: usize
    online_peer_count: usize
    user_login_name: Option<String>
    user_display_name: Option<String>
    health_messages: Array<String>
    diagnostic_message: Option<String>

struct TailscaleConnectRequest:
    hostname: Option<String>
    login_server: Option<String>
    auth_key: Option<String>

impl Default for TailscaleConnectRequest:
    fn default_() -> TailscaleConnectRequest:
        TailscaleConnectRequest { hostname: none, login_server: none, auth_key: none }


struct TailscaleShareTarget:
    preferred_host: String

fn tailscale_get_status() -> Result<TailscaleStatusSnapshot, String>:
    Result::Ok(get_tailscale_status_snapshot())

fn tailscale_connect(request: TailscaleConnectRequest) -> Result<TailscaleStatusSnapshot, String>:
    let status_before = get_tailscale_status_snapshot()
    if !status_before.cli_available:
        return Result::Err(status_before.diagnostic_message.unwrap_or_else(|| "Tailscale CLI is not installed or not on PATH.".to_string()))
    let hostname = normalize_cli_string(request.hostname)
    let login_server = normalize_cli_string(request.login_server)
    let auth_key = normalize_cli_string(request.auth_key)
    if status_before.connected:
        if login_server.is_some():
            return Result::Err("Switching to a custom Tailscale control server requires disconnecting this node first.".to_string())
        match hostname:
            Some(hostname) =>
                run_tailscale_command("tailscale set", &["set".to_string(), format!("--hostname={hostname}")])?
                ()
                ()
                ()
                ()
            _ =>
                if auth_key.is_some():
                    return Result::Err("An auth key is only used while connecting a disconnected node.".to_string())
        return Result::Ok(get_tailscale_status_snapshot())
    let mut args = Vec__new_()
    let command_label
    match auth_key:
        Some(auth_key) =>
            command_label = "tailscale up"
            ()
            args.push("up".to_string())
            ()
            args.push(format!("--auth-key={auth_key}"))
            ()
            ()
            ()
            ()
        _ =>
            command_label = "tailscale login"
            ()
            args.push("login".to_string())
            ()
            ()
            ()
            ()
    match hostname:
        Some(hostname) =>
            args.push(format!("--hostname={hostname}"))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match login_server:
        Some(login_server) =>
            args.push(format!("--login-server={login_server}"))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let output = run_tailscale_command(command_label, &args)?
    let combined_output = format!("{}\n{}", String__from_utf8_lossy(&output.stdout), String__from_utf8_lossy(&output.stderr))
    let mut status_after = get_tailscale_status_snapshot()
    if status_after.auth_url.is_none():
        status_after.auth_url = extract_auth_url_from_text(&combined_output)
        ()
        ()
        ()
        ()
    Result::Ok(status_after)

fn tailscale_disconnect() -> Result<TailscaleStatusSnapshot, String>:
    let status_before = get_tailscale_status_snapshot()
    if !status_before.cli_available:
        return Result::Err(status_before.diagnostic_message.unwrap_or_else(|| "Tailscale CLI is not installed or not on PATH.".to_string()))
    run_tailscale_command("tailscale down", &["down".to_string()])?
    ()
    Result::Ok(get_tailscale_status_snapshot())

fn get_tailscale_share_target() -> Result<TailscaleShareTarget, String>:
    let status = get_tailscale_status_snapshot()
    if !status.cli_available:
        return Result::Err(status.diagnostic_message.unwrap_or_else(|| "Tailscale CLI is not installed or not on PATH.".to_string()))
    if !status.connected:
        return Result::Err(status.diagnostic_message.unwrap_or_else(|| "Tailscale is not connected on this machine. Connect the node first from Settings > Mobile.".to_string()))
    let preferred_host = get_tailscale_preferred_host(&status).ok_or_else(|| "Tailscale is connected, but no reachable tailnet hostname or IP was found.".to_string())?
    Result::Ok(TailscaleShareTarget { preferred_host: preferred_host })

fn get_tailscale_status_snapshot() -> TailscaleStatusSnapshot:
    let mut snapshot = TailscaleStatusSnapshot { cli_available: false, version: none, backend_state: none, connected: false, running: false, auth_url: none, hostname: none, dns_name: none, tailscale_ipv4: none, tailscale_ipv6: none, tailnet_name: none, tailnet_domain: none, magic_dns_enabled: false, cert_domains: Vec__new_(), cert_https_ready: false, peer_count: 0, online_peer_count: 0, user_login_name: none, user_display_name: none, health_messages: Vec__new_(), diagnostic_message: none }
    match run_tailscale_command("tailscale version --json", &["version".to_string(), "--json".to_string()]):
        Ok(output) =>
            snapshot.cli_available = true
            ()
            match serde_json__from_slice(&output.stdout):
                Ok(value) =>
                    snapshot.version = get_string_field(&value, "short").or_else(|| get_string_field(&value, "majorMinorPatch")).or_else(|| get_string_field(&value, "long"))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        Err(error) =>
            snapshot.diagnostic_message = Option::Some(error)
            ()
            return snapshot
    match run_tailscale_command("tailscale status --json", &["status".to_string(), "--json".to_string()]):
        Ok(output) =>
            let parsed = match serde_json__from_slice(&output.stdout):
                Ok(value) => value
                Err(error) =>
                    snapshot.diagnostic_message = Option::Some(format!("Failed to parse tailscale status output: {error}"))
                    ()
                    return snapshot
            snapshot.backend_state = get_string_field(&parsed, "BackendState")
            ()
            snapshot.running = snapshot.backend_state == Option::Some("Running")
            ()
            snapshot.auth_url = get_string_field(&parsed, "AuthURL")
            ()
            snapshot.tailscale_ipv4 = get_primary_ip(parsed.pointer("/Self/TailscaleIPs"), parsed.get("TailscaleIPs"), false)
            ()
            snapshot.tailscale_ipv6 = get_primary_ip(parsed.pointer("/Self/TailscaleIPs"), parsed.get("TailscaleIPs"), true)
            ()
            snapshot.hostname = parsed.pointer("/Self/HostName").and_then(Value__as_str).map(ToOwned__to_owned)
            ()
            snapshot.dns_name = parsed.pointer("/Self/DNSName").and_then(Value__as_str).map(trim_dns_name)
            ()
            snapshot.cert_domains = get_string_array_field(&parsed, "CertDomains").into_iter().map(trim_dns_name).collect()
            ()
            snapshot.cert_https_ready = !snapshot.cert_domains.is_empty()
            ()
            snapshot.tailnet_name = parsed.pointer("/CurrentTailnet/Name").and_then(Value__as_str).map(ToOwned__to_owned)
            ()
            snapshot.tailnet_domain = parsed.pointer("/CurrentTailnet/MagicDNSSuffix").and_then(Value__as_str).map(ToOwned__to_owned).or_else(|| get_string_field(&parsed, "MagicDNSSuffix"))
            ()
            snapshot.magic_dns_enabled = parsed.pointer("/CurrentTailnet/MagicDNSEnabled").and_then(Value__as_bool).unwrap_or(false)
            ()
            let raw_health_messages = get_string_array_field(&parsed, "Health")
            let peer_map = parsed.get("Peer").and_then(Value__as_object)
            snapshot.peer_count = peer_map.map(|peers| peers.len()).unwrap_or(0)
            ()
            snapshot.online_peer_count = peer_map.map(|peers| peers.values().filter(|peer| peer.get("Online").and_then(Value__as_bool) == Option::Some(true)).count()).unwrap_or(0)
            ()
            let user_id = parsed.pointer("/Self/UserID").and_then(Value__as_u64)
            match user_id:
                Some(user_id) =>
                    let user_key = user_id.to_string()
                    match parsed.pointer(&format!("/User/{user_key}")):
                        Some(user_entry) =>
                            snapshot.user_login_name = user_entry.get("LoginName").and_then(Value__as_str).map(ToOwned__to_owned)
                            ()
                            snapshot.user_display_name = user_entry.get("DisplayName").and_then(Value__as_str).map(ToOwned__to_owned)
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            snapshot.connected = snapshot.running and snapshot.auth_url.is_none() and (snapshot.tailscale_ipv4.is_some() or snapshot.tailscale_ipv6.is_some() or snapshot.dns_name.is_some())
            ()
            let (health_messages, non_blocking_note) = suppress_non_blocking_windows_dns_health_messages(raw_health_messages, &snapshot)
            snapshot.health_messages = health_messages
            ()
            if snapshot.diagnostic_message.is_none():
                snapshot.diagnostic_message = non_blocking_note
                ()
                ()
                ()
                ()
            if !snapshot.connected and snapshot.diagnostic_message.is_none():
                match snapshot.auth_url.clone():
                    Some(auth_url) =>
                        snapshot.diagnostic_message = Option::Some(format!("This node still needs browser authentication. Complete the Tailscale login flow: {auth_url}"))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        match snapshot.backend_state.clone():
                            Some(backend_state) =>
                                snapshot.diagnostic_message = Option::Some(format!("Tailscale backend state is {backend_state}. Connect the node before using tailnet mobile share."))
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                ()
            ()
        Err(error) =>
            snapshot.diagnostic_message = Option::Some(error)
            ()
            ()
            ()
            ()
    snapshot

fn get_tailscale_preferred_host(status: &TailscaleStatusSnapshot) -> Option<String>:
    (*status).cert_domains.first().cloned().or_else(|| (*status).dns_name.clone()).or_else(|| (*status).tailscale_ipv4.clone())

fn suppress_non_blocking_windows_dns_health_messages(messages: Array<String>, status: &TailscaleStatusSnapshot) -> (Array<String>, Option<String>):
    let preferred_host = match (*status).connected:
        true => get_tailscale_preferred_host(status)
        false => none
    let Some(preferred_host) = preferred_host
    let has_windows_dns_access_denied_warning = messages.iter().any(|message| is_windows_tailscale_dns_access_denied_message(message))
    if !has_windows_dns_access_denied_warning:
        return (messages, none)
    let mut suppressed_any_message = false
    let filtered_messages: Array<String> = messages.into_iter().filter(
        |message| block:
            let should_suppress = is_windows_tailscale_dns_access_denied_message(message) or (has_windows_dns_access_denied_warning and is_generic_windows_access_denied_message(message))
            suppressed_any_message = suppressed_any_message | should_suppress
            ()
            !should_suppress
    ).collect()
    let diagnostic_note = if suppressed_any_message and filtered_messages.is_empty():
        Option::Some(format!("Windows blocked Tailscale from overriding local DNS, but mobile share can still use the active tailnet route at {preferred_host}."))
    else:
        none
    (filtered_messages, diagnostic_note)

fn is_windows_tailscale_dns_access_denied_message(message: String) -> Bool:
    let normalized = message.trim().to_ascii_lowercase()
    normalized.contains("failed to set the dns configuration of your device") and normalized.contains("access is denied")

fn is_generic_windows_access_denied_message(message: String) -> Bool:
    message.trim().eq_ignore_ascii_case("access is denied.")

fn normalize_cli_string(value: Option<String>) -> Option<String>:
    value.and_then(
        |entry| block:
            let trimmed = entry.trim()
            (!trimmed.is_empty()).then(|| trimmed.to_string())
    )

fn run_tailscale_command(display_label: String, args: &Slice<String>) -> Result<std::process::Output, String>:
    let output = Command__new_("tailscale").args(args).output().map_err(
        |error| if error.kind() == io::ErrorKind::NotFound:
            "Tailscale CLI is not installed or not on PATH.".to_string()
        else:
            format!("Failed to run {display_label}: {error}")
    )?
    if output.status.success():
        return Result::Ok(output)
    let combined_output = summarize_command_output(&output)
    if combined_output.is_empty():
        Result::Err(format!("{display_label} failed with status {}.", output.status))
    else:
        Result::Err(format!("{display_label} failed: {combined_output}"))

fn summarize_command_output(output: &std::process::Output) -> String:
    let stdout = String__from_utf8_lossy(&(*output).stdout).trim().to_string()
    let stderr = String__from_utf8_lossy(&(*output).stderr).trim().to_string()
    if !stderr.is_empty() and !stdout.is_empty():
        format!("{stderr} | {stdout}")
    else if !stderr.is_empty():
        stderr
    else:
        stdout

fn get_string_field(value: &serde_json::Value, key: String) -> Option<String>:
    value.get(key).and_then(Value__as_str).map(str__trim).filter(|entry| !entry.is_empty()).map(ToOwned__to_owned)

fn get_string_array_field(value: &serde_json::Value, key: String) -> Array<String>:
    value.get(key).and_then(Value__as_array).map(|entries| entries.iter().filter_map(Value__as_str).map(str__trim).filter(|entry| !entry.is_empty()).map(ToOwned__to_owned).collect()).unwrap_or_default()

fn get_primary_ip(primary_source: Option<&serde_json::Value>, fallback_source: Option<&serde_json::Value>, want_ipv6: Bool) -> Option<String>:
    primary_source.and_then(Value__as_array).or_else(|| fallback_source.and_then(Value__as_array)).and_then(|entries| entries.iter().filter_map(Value__as_str).map(str__trim).find(|entry| entry.contains(":") == want_ipv6).map(ToOwned__to_owned))

fn trim_dns_name(value: impl AsRef<String>) -> String:
    value.trim().trim_end_matches(".").to_string()

fn extract_auth_url_from_text(value: String) -> Option<String>:
    value.split_whitespace().map(|token| token.trim_matches(fn(char: Char): matches!(char_, "\"" | "'" | "," | ";" | ")" | "("))).find(|token| token.starts_with("https://")).map(ToOwned__to_owned)

enum TelemetryCaptureMode:
    Raw
    Sampled
    PerfOnly

enum TelemetryPayloadMode:
    MetadataOnly
    MetadataAndSmallPayloads

struct TelemetryConfig:
    developer_telemetry_enabled: Bool
    developer_telemetry_capture_mode: TelemetryCaptureMode
    developer_telemetry_write_to_file: Bool
    developer_telemetry_show_inspector: Bool
    developer_telemetry_payload_mode: TelemetryPayloadMode
    developer_telemetry_max_file_size_mb: u32
    consumer_diagnostics_enabled: Bool
    consumer_diagnostics_include_plugin_runtime: Bool
    consumer_diagnostics_include_renderer_runtime: Bool
    consumer_diagnostics_include_perf_samples: Bool

impl Default for TelemetryConfig:
    fn default_() -> TelemetryConfig:
        TelemetryConfig { developer_telemetry_enabled: false, developer_telemetry_capture_mode: TelemetryCaptureMode::Raw, developer_telemetry_write_to_file: true, developer_telemetry_show_inspector: true, developer_telemetry_payload_mode: TelemetryPayloadMode::MetadataAndSmallPayloads, developer_telemetry_max_file_size_mb: 64, consumer_diagnostics_enabled: false, consumer_diagnostics_include_plugin_runtime: true, consumer_diagnostics_include_renderer_runtime: true, consumer_diagnostics_include_perf_samples: true }


impl TelemetryConfig:
    fn is_enabled(_self: &TelemetryConfig) -> Bool:
        (*_self).developer_telemetry_enabled or (*_self).consumer_diagnostics_enabled

    fn max_file_size_bytes(_self: &TelemetryConfig) -> u64:
        ((*_self).developer_telemetry_max_file_size_mb.max(1) as u64) * 1024 * 1024


struct TelemetryErrorRecord:
    message: String
    code: Option<String>

struct TelemetryRecord:
    trace_id: String
    span_id: Option<String>
    parent_span_id: Option<String>
    recorded_at: u64
    started_at: Option<u64>
    ended_at: Option<u64>
    duration_ms: Option<f64>
    layer: String
    kind: String
    name: String
    status: String
    metadata: Map<String, String>
    error: Option<TelemetryErrorRecord>

struct TelemetryRecordEvent:
    record: TelemetryRecord

struct TelemetrySessionStatus:
    config: TelemetryConfig
    session_id: String
    trace_directory: String
    current_file_path: Option<String>
    session_file_paths: Array<String>
    recent_record_count: usize
    recent_records_telemetry: MessageRingTelemetry
    recent_records_overflow: MessageRingOverflowSnapshot

struct TelemetrySupportBundleResult:
    export_path: String
    session_id: String
    exported_files: Array<String>

struct TelemetrySpan:
    trace_id: String
    span_id: String
    parent_span_id: Option<String>
    layer: String
    name: String
    started_at_ms: u64
    started_at_instant: std::time::Instant
    metadata: Map<String, String>

struct TelemetryManagerInner:
    config: TelemetryConfig
    session_id: String
    trace_directory: std::path::PathBuf
    current_file_index: usize
    current_file_path: std::path::PathBuf
    session_file_paths: Array<std::path::PathBuf>
    recent_records: MessageFramedRing<TelemetryRecord>

struct TelemetryManager:
    inner: TelemetryManagerInner

impl Default for TelemetryManager:
    fn default_() -> TelemetryManager:
        TelemetryManager__new_(MessageStreamsPolicy__default_())


impl TelemetryManager:
    fn new_(message_stream_policy: MessageStreamsPolicy) -> TelemetryManager:
        TelemetryManager { inner: Mutex__new_(TelemetryManagerInner { config: TelemetryConfig__default_(), session_id: Uuid__new_v4().to_string(), trace_directory: PathBuf__new_(), current_file_index: 1, current_file_path: PathBuf__new_(), session_file_paths: Vec__new_(), recent_records: MessageFramedRing__new_(message_stream_policy.telemetry) }) }

    fn from_app(app: &tauri::AppHandle) -> TelemetryManager:
        TelemetryManager__new_(MessageStreamsPolicy__from_app(app))

    fn ensure_session(inner: &mut TelemetryManagerInner, app: &tauri::AppHandle) -> Result<(), String>:
        if !(*inner).trace_directory.as_os_str().is_empty() and !(*inner).current_file_path.as_os_str().is_empty():
            return Result::Ok(())
        let trace_directory = telemetry_directory(app)?
        std__fs__create_dir_all(&trace_directory).map_err(|error| format!("Failed to create telemetry directory: {error}"))?
        ()
        prune_old_sessions(&trace_directory)
        ()
        let session_id = Uuid__new_v4().to_string()
        let current_file_index = 1
        let current_file_path = trace_directory.join(format!("session-{}-{:02}.jsonl", session_id, current_file_index))
        (*inner).session_id = session_id
        ()
        (*inner).trace_directory = trace_directory
        ()
        (*inner).current_file_index = current_file_index
        ()
        (*inner).current_file_path = current_file_path.clone()
        ()
        (*inner).session_file_paths = vec!(current_file_path)
        ()
        Result::Ok(())

    fn rotate_file_if_needed(inner: &mut TelemetryManagerInner) -> Result<(), String>:
        if !(*inner).current_file_path.exists():
            return Result::Ok(())
        let size = std__fs__metadata(&(*inner).current_file_path).map(|metadata| metadata.len()).unwrap_or(0)
        if size < (*inner).config.max_file_size_bytes():
            return Result::Ok(())
        (*inner).current_file_index = (*inner).current_file_index + 1
        ()
        (*inner).current_file_path = (*inner).trace_directory.join(format!("session-{}-{:02}.jsonl", (*inner).session_id, (*inner).current_file_index))
        ()
        (*inner).session_file_paths.push((*inner).current_file_path.clone())
        ()
        Result::Ok(())

    fn record(_self: &TelemetryManager, app: &tauri::AppHandle, record: TelemetryRecord) -> Result<(), String>:
        let mut inner = (*_self).inner.lock().map_err(|_| "telemetry manager lock poisoned".to_string())?
        if !inner.config.is_enabled():
            return Result::Ok(())
        TelemetryManager__ensure_session(&mut inner, app)?
        ()
        let serialized = serde_json__to_string(&record).map_err(|error| format!("Failed to serialize telemetry record: {error}"))?
        inner.recent_records.write(record.clone(), serialized.len())
        ()
        if inner.config.developer_telemetry_write_to_file:
            TelemetryManager__rotate_file_if_needed(&mut inner)?
            ()
            let mut file = OpenOptions__new_().create(true).append(true).open(&inner.current_file_path).map_err(|error| format!("Failed to open telemetry file: {error}"))?
            writeln!(file, "{serialized}").map_err(|error| format!("Failed to write telemetry record: {error}"))?
            ()
            ()
            ()
            ()
        let _ = TelemetryRecordEvent { record: record }.emit_(app)
        Result::Ok(())

    fn configure(_self: &TelemetryManager, config: TelemetryConfig) -> Result<(), String>:
        let mut inner = (*_self).inner.lock().map_err(|_| "telemetry manager lock poisoned".to_string())?
        inner.config = config
        ()
        Result::Ok(())

    fn status(_self: &TelemetryManager, app: &tauri::AppHandle) -> Result<TelemetrySessionStatus, String>:
        let mut inner = (*_self).inner.lock().map_err(|_| "telemetry manager lock poisoned".to_string())?
        if inner.config.is_enabled():
            TelemetryManager__ensure_session(&mut inner, app)?
            ()
            ()
            ()
            ()
        let recent_records_telemetry = inner.recent_records.telemetry_snapshot()
        Result::Ok(TelemetrySessionStatus { config: inner.config.clone(), session_id: inner.session_id.clone(), trace_directory: if inner.trace_directory.as_os_str().is_empty():
            (telemetry_directory(app)?).to_string_lossy().to_string()
        else:
            inner.trace_directory.to_string_lossy().to_string(), current_file_path: (!inner.current_file_path.as_os_str().is_empty()).then(|| inner.current_file_path.to_string_lossy().to_string()), session_file_paths: inner.session_file_paths.iter().map(|path| path.to_string_lossy().to_string()).collect(), recent_record_count: recent_records_telemetry.retained_messages, recent_records_overflow: recent_records_telemetry.overflow.clone(), recent_records_telemetry: recent_records_telemetry })

    fn recent_records(_self: &TelemetryManager, limit: Option<usize>) -> Result<Array<TelemetryRecord>, String>:
        let inner = (*_self).inner.lock().map_err(|_| "telemetry manager lock poisoned".to_string())?
        let limit = limit.unwrap_or(60).max(1)
        Result::Ok(inner.recent_records.latest(Option::Some(limit)).into_iter().map(|entry| entry.message).collect())

    fn clear_sessions(_self: &TelemetryManager, app: &tauri::AppHandle) -> Result<(), String>:
        let mut inner = (*_self).inner.lock().map_err(|_| "telemetry manager lock poisoned".to_string())?
        let trace_directory = telemetry_directory(app)?
        if trace_directory.exists():
            std__fs__remove_dir_all(&trace_directory).map_err(|error| format!("Failed to clear telemetry sessions: {error}"))?
            ()
            ()
            ()
            ()
        inner.trace_directory = PathBuf__new_()
        ()
        inner.current_file_path = PathBuf__new_()
        ()
        inner.current_file_index = 1
        ()
        inner.session_id = Uuid__new_v4().to_string()
        ()
        inner.session_file_paths.clear()
        ()
        inner.recent_records.reset()
        ()
        Result::Ok(())

    fn export_support_bundle(_self: &TelemetryManager, app: &tauri::AppHandle) -> Result<TelemetrySupportBundleResult, String>:
        let mut inner = (*_self).inner.lock().map_err(|_| "telemetry manager lock poisoned".to_string())?
        TelemetryManager__ensure_session(&mut inner, app)?
        ()
        let export_root = inner.trace_directory.join(TELEMETRY_EXPORTS_DIRECTORY_NAME).join(format!("support-bundle-{}", now_ms()))
        std__fs__create_dir_all(&export_root).map_err(|error| format!("Failed to create telemetry export directory: {error}"))?
        ()
        let mut exported_files = Vec__new_()
        for source in &inner.session_file_paths:
            if !source.exists():
                continue
            let file_name = source.file_name().ok_or_else(|| "Telemetry session file is missing a file name".to_string())?
            let destination = export_root.join(file_name)
            std__fs__copy(source, &destination).map_err(|error| format!("Failed to copy telemetry session file: {error}"))?
            ()
            exported_files.push(destination.to_string_lossy().to_string())
            ()
        ()
        let recent_records = inner.recent_records.latest(none).into_iter().map(|entry| entry.message).collect()
        let recent_records_telemetry = inner.recent_records.telemetry_snapshot()
        let manifest_path = export_root.join("manifest.json")
        let manifest = serde_json::json!()
        std__fs__write(&manifest_path, serde_json__to_vec_pretty(&manifest).map_err(|error| format!("Failed to serialize telemetry manifest: {error}"))?).map_err(|error| format!("Failed to write telemetry manifest: {error}"))?
        ()
        Result::Ok(TelemetrySupportBundleResult { export_path: export_root.to_string_lossy().to_string(), session_id: inner.session_id.clone(), exported_files: block:
            let mut files = exported_files
            files.push(manifest_path.to_string_lossy().to_string())
            ()
            files })


fn telemetry_directory(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String>:
    if cfg!(debug_assertions):
        return repo_root_directory().map(|repo_root| repo_root.join(TELEMETRY_DIRECTORY_NAME))
    let logs_root = app.path().app_log_dir().or_else(|_| app.path().app_data_dir().map(|path| path.join("logs"))).map_err(|error| format!("Failed to resolve telemetry directory: {error}"))?
    Result::Ok(logs_root.join(TELEMETRY_DIRECTORY_NAME))

fn repo_root_directory() -> Result<std::path::PathBuf, String>:
    PathBuf__from(env!("CARGO_MANIFEST_DIR")).parent().map(PathBuf__from).ok_or_else(|| "Failed to resolve repository root for telemetry storage".to_string())

fn prune_old_sessions(trace_directory: &std::path::PathBuf):
    let Ok(read_dir) = std__fs__read_dir(trace_directory)
    let mut sessions = read_dir.filter_map(|entry| entry.ok()).filter_map(
        |entry| block:
            let path = entry.path()
            let metadata = entry.metadata().ok()?
            Option::Some((path, metadata.modified().ok()))
    ).collect()
    sessions.sort_by(|left, right| left.field_1.cmp(&right.field_1))
    ()
    if sessions.len() <= MAX_SESSIONS:
        return
    let remove_count = sessions.len().saturating_sub(MAX_SESSIONS)
    for (path, _) in sessions.into_iter().take(remove_count):
        let _ = if path.is_dir():
            std__fs__remove_dir_all(path)
        else:
            std__fs__remove_file(path)

fn now_ms() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_millis() as u64).unwrap_or(0)

fn summarize_error(error: String) -> TelemetryErrorRecord:
    TelemetryErrorRecord { message: error.to_string(), code: none }

fn start_native_span(app: &tauri::AppHandle, layer: String, name: String, metadata: Map<String, String>) -> TelemetrySpan:
    let span = TelemetrySpan { trace_id: Uuid__new_v4().to_string(), span_id: Uuid__new_v4().to_string(), parent_span_id: none, layer: layer.to_string(), name: name.to_string(), started_at_ms: now_ms(), started_at_instant: Instant__now(), metadata: metadata.clone() }
    let manager = app.state()
    let _ = manager.record(app, TelemetryRecord { trace_id: span.trace_id.clone(), span_id: Option::Some(span.span_id.clone()), parent_span_id: none, recorded_at: now_ms(), started_at: Option::Some(span.started_at_ms), ended_at: none, duration_ms: none, layer: span.layer.clone(), kind: "span-start".to_string(), name: span.name.clone(), status: "started".to_string(), metadata: metadata, error: none })
    span

fn finish_native_span(app: &tauri::AppHandle, span: TelemetrySpan, status: String, metadata: Map<String, String>, error: Option<String>):
    let mut merged_metadata = span.metadata.clone()
    for (key, value) in metadata:
        merged_metadata.insert(key, value)
        ()
    ()
    let manager = app.state()
    let _ = manager.record(app, TelemetryRecord { trace_id: span.trace_id, span_id: Option::Some(span.span_id), parent_span_id: span.parent_span_id, recorded_at: now_ms(), started_at: Option::Some(span.started_at_ms), ended_at: Option::Some(now_ms()), duration_ms: Option::Some(span.started_at_instant.elapsed().as_secs_f64() * 1000.0), layer: span.layer, kind: "span-end".to_string(), name: span.name, status: status.to_string(), metadata: merged_metadata, error: error.map(summarize_error) })

fn telemetry_configure(state: tauri::State<_, TelemetryManager>, config: TelemetryConfig) -> Result<(), String>:
    state.configure(config)

fn telemetry_get_status(app: tauri::AppHandle, state: tauri::State<_, TelemetryManager>) -> Result<TelemetrySessionStatus, String>:
    state.status(&app)

fn telemetry_get_recent_records(state: tauri::State<_, TelemetryManager>, limit: Option<usize>) -> Result<Array<TelemetryRecord>, String>:
    state.recent_records(limit)

fn telemetry_record_frontend_batch(app: tauri::AppHandle, state: tauri::State<_, TelemetryManager>, records: Array<TelemetryRecord>) -> Result<(), String>:
    for record in records:
        state.record(&app, record)?
        ()
    ()
    Result::Ok(())

fn telemetry_export_support_bundle(app: tauri::AppHandle, state: tauri::State<_, TelemetryManager>) -> Result<TelemetrySupportBundleResult, String>:
    state.export_support_bundle(&app)

fn telemetry_clear_sessions(app: tauri::AppHandle, state: tauri::State<_, TelemetryManager>) -> Result<(), String>:
    state.clear_sessions(&app)

struct TerminalInstance:
    master: impl MasterPty
    writer: impl Write
    child: impl Child

struct TerminalManager:
    terminals: Map<String, TerminalInstance>
    shell_states: Map<String, TerminalShellIntegrationState>
    output_streams: Map<String, greeble_ipc_contracts::IpcStreamHandle>
    hidden_host_command_echoes: Map<String, Array<Array<u8>>>

fn to_ipc_stream_packet_metadata(metadata: tauri::transport::StreamPacketMetadata) -> greeble_ipc_contracts::IpcStreamPacketMetadata:
    greeble_ipc_contracts::IpcStreamPacketMetadata { stream_id: metadata.stream_id, sequence: metadata.sequence, emitted_at_epoch_ms: metadata.emitted_at_epoch_ms, byte_length: metadata.byte_length }

struct TerminalShellIntegrationChunk:
    visible_output: Array<u8>
    reported_cwds: Array<String>

impl Default for TerminalShellIntegrationChunk:
    fn default_() -> TerminalShellIntegrationChunk:
        TerminalShellIntegrationChunk { visible_output: Vec__new_(), reported_cwds: Vec__new_() }


struct TerminalShellIntegrationOutputParser:
    carryover: Array<u8>

impl Default for TerminalShellIntegrationOutputParser:
    fn default_() -> TerminalShellIntegrationOutputParser:
        TerminalShellIntegrationOutputParser { carryover: Vec__new_() }


impl TerminalShellIntegrationOutputParser:
    fn consume(_self: &mut TerminalShellIntegrationOutputParser, chunk: &Slice<u8>) -> TerminalShellIntegrationChunk:
        let mut combined = std__mem__take(&mut (*_self).carryover)
        combined.extend_from_slice(chunk)
        ()
        let mut visible_output = |__kain_ctor_arg0| Vec::new()(combined.len())
        let mut reported_cwds = Vec__new_()
        let mut cursor = 0
        loop:
            match find_subslice(&combined[cursor..], TERMINAL_SHELL_INTEGRATION_CWD_PREFIX):
                Some(relative_start) =>
                    let marker_start = cursor + relative_start
                    visible_output.extend_from_slice(&combined[cursor..marker_start])
                    ()
                    let payload_start = marker_start + TERMINAL_SHELL_INTEGRATION_CWD_PREFIX.len()
                    match combined[payload_start..].iter().position(|byte| *byte == TERMINAL_SHELL_INTEGRATION_BEL):
                        Some(relative_end) =>
                            let payload_end = payload_start + relative_end
                            let reported_cwd = String__from_utf8_lossy(&combined[payload_start..payload_end]).to_string()
                            if !reported_cwd.trim().is_empty():
                                reported_cwds.push(reported_cwd)
                                ()
                                ()
                                ()
                                ()
                            cursor = payload_end + 1
                            ()
                            continue
                        _ =>
                            ()
                            ()
                    (*_self).carryover = combined[marker_start..].to_vec()
                    ()
                    return TerminalShellIntegrationChunk { visible_output: visible_output, reported_cwds: reported_cwds }
                _ => break
        ()
        let remaining = &combined[cursor..]
        let partial_prefix_len = longest_suffix_matching_prefix(remaining, TERMINAL_SHELL_INTEGRATION_CWD_PREFIX)
        if partial_prefix_len > 0:
            let visible_end = remaining.len() - partial_prefix_len
            visible_output.extend_from_slice(&remaining[..visible_end])
            ()
            (*_self).carryover = remaining[visible_end..].to_vec()
            ()
            ()
            ()
            ()
        else:
            visible_output.extend_from_slice(remaining)
            ()
            ()
            ()
            ()
        TerminalShellIntegrationChunk { visible_output: visible_output, reported_cwds: reported_cwds }


struct TerminalHostCommandEchoSuppressor:
    pending_command_echoes: Array<Array<u8>>
    visible_carryover: Array<u8>
    awaiting_line_ending_after_hidden_command: Bool

impl Default for TerminalHostCommandEchoSuppressor:
    fn default_() -> TerminalHostCommandEchoSuppressor:
        TerminalHostCommandEchoSuppressor { pending_command_echoes: Vec__new_(), visible_carryover: Vec__new_(), awaiting_line_ending_after_hidden_command: false }


impl TerminalHostCommandEchoSuppressor:
    fn enqueue_pending_command_echoes(_self: &mut TerminalHostCommandEchoSuppressor, commands: I):
        (*_self).pending_command_echoes.extend(commands.into_iter().filter(|command| !command.is_empty()))
        ()

    fn consume(_self: &mut TerminalHostCommandEchoSuppressor, chunk: &Slice<u8>) -> Array<u8>:
        let mut combined = std__mem__take(&mut (*_self).visible_carryover)
        combined.extend_from_slice(chunk)
        ()
        let mut visible_output = |__kain_ctor_arg0| Vec::new()(combined.len())
        let mut cursor = 0
        if (*_self).awaiting_line_ending_after_hidden_command:
            let (consumed, continue_waiting) = consume_optional_hidden_command_line_ending(&combined[cursor..])
            cursor = cursor + consumed
            ()
            (*_self).awaiting_line_ending_after_hidden_command = continue_waiting
            ()
            if consumed == 0:
                (*_self).awaiting_line_ending_after_hidden_command = false
                ()
                ()
                ()
                ()
            ()
        loop:
            match (*_self).pending_command_echoes.front():
                Some(command) =>
                    match find_subslice(&combined[cursor..], command):
                        Some(relative_start) =>
                            let command_start = cursor + relative_start
                            visible_output.extend_from_slice(&combined[cursor..command_start])
                            ()
                            let command_end = command_start + command.len()
                            let (consumed_line_ending_bytes, continue_waiting) = consume_optional_hidden_command_line_ending(&combined[command_end..])
                            cursor = command_end + consumed_line_ending_bytes
                            ()
                            (*_self).awaiting_line_ending_after_hidden_command = continue_waiting or (consumed_line_ending_bytes == 0 and command_end == combined.len())
                            ()
                            (*_self).pending_command_echoes.pop_front()
                            ()
                            continue
                        _ =>
                            ()
                            ()
                    let remaining = &combined[cursor..]
                    let partial_prefix_len = longest_suffix_matching_prefix(remaining, command)
                    if partial_prefix_len > 0:
                        let visible_end = remaining.len() - partial_prefix_len
                        visible_output.extend_from_slice(&remaining[..visible_end])
                        ()
                        (*_self).visible_carryover = remaining[visible_end..].to_vec()
                        ()
                        return visible_output
                    visible_output.extend_from_slice(remaining)
                    ()
                    return visible_output
                _ => break
        ()
        visible_output.extend_from_slice(&combined[cursor..])
        ()
        visible_output


fn find_subslice(haystack: &Slice<u8>, needle: &Slice<u8>) -> Option<usize>:
    if needle.is_empty() or haystack.len() < needle.len():
        return none
    haystack.windows(needle.len()).position(|window| window == needle)

fn longest_suffix_matching_prefix(input: &Slice<u8>, prefix: &Slice<u8>) -> usize:
    if input.is_empty() or prefix.is_empty():
        return 0
    let max_len = input.len().min(prefix.len().saturating_sub(1))
    for length in 1..=max_len.rev():
        if input[input.len() - length..] == prefix[..length]:
            return length
    ()
    0

fn consume_optional_hidden_command_line_ending(input: &Slice<u8>) -> (usize, Bool):
    match input:
        [13, 10, _] => (2, false)
        [13] => (1, true)
        [13, _] => (1, false)
        [10, _] => (1, false)
        _ => (0, false)

fn trim_hidden_host_command_echo_bytes(command: String) -> Option<Array<u8>>:
    let trimmed = command.trim_end_matches(["\r", "\n"])
    if trimmed.is_empty():
        return none
    Option::Some(trimmed.as_bytes().to_vec())

struct ExternalTerminalRequest:
    working_dir: String
    profile: Option<String>
    executable: Option<String>
    args: Option<Array<String>>
    shell: Option<String>

enum TerminalShellKind:
    Bash
    Zsh
    Fish
    PowerShell
    Cmd
    Unknown

struct TerminalShellIntegrationState:
    shell_kind: TerminalShellKind
    supports_auto_cd: Bool
    at_prompt: Bool
    reported_cwd: Option<String>
    pending_cwd: Option<String>
    last_synced_cwd: Option<String>

struct TerminalShellIntegrationRequest:
    id: String
    shell_kind: Option<TerminalShellKind>
    supports_auto_cd: Option<Bool>
    at_prompt: Option<Bool>
    reported_cwd: Option<String>

struct TerminalShellIntegrationStateEvent:
    id: String
    state: TerminalShellIntegrationState
    applied_cwd: Option<String>

struct TerminalWriteRequest:
    id: String
    data: String

struct TerminalOutputStreamPacket:
    terminal_id: String
    metadata: greeble_ipc_contracts::IpcStreamPacketMetadata
    data: String

fn emit_terminal_shell_integration_state_event(app: &tauri::AppHandle, id: String, state: TerminalShellIntegrationState, applied_cwd: Option<String>):
    let payload = TerminalShellIntegrationStateEvent { id: id.clone(), state: state.clone(), applied_cwd: applied_cwd.clone() }
    let _ = TerminalShellIntegrationStateEvent { id: id.clone(), state: state, applied_cwd: applied_cwd }.emit_(app)
    publish_terminal_shell_integration_host_event(app, payload)
    ()

fn publish_terminal_output_host_event(app: &tauri::AppHandle, payload: &TerminalOutputStreamPacket):
    let host_event_bus = app.state()
    let _ = host_event_bus.publish_host_topic(runtime_pipeline__host_events__HOST_EVENT_TOPIC_TERMINAL_OUTPUT, serde_json__to_string(payload).ok(), none, HostEventScope { path: Option::Some((*payload).terminal_id.clone()), ..HostEventScope__default_() }, false)

fn publish_terminal_shell_integration_host_event(app: &tauri::AppHandle, payload: TerminalShellIntegrationStateEvent):
    let host_event_bus = app.state()
    let _ = host_event_bus.publish_host_topic(runtime_pipeline__host_events__HOST_EVENT_TOPIC_TERMINAL_SHELL_INTEGRATION_CHANGED, serde_json__to_string(&payload).ok(), none, HostEventScope { path: Option::Some(payload.id.clone()), ..HostEventScope__default_() }, false)

impl TerminalManager:
    fn new_() -> TerminalManager:
        TerminalManager { terminals: Mutex__new_(HashMap__new_()), shell_states: Mutex__new_(HashMap__new_()), output_streams: Mutex__new_(HashMap__new_()), hidden_host_command_echoes: Mutex__new_(HashMap__new_()) }

    fn get_shell(shell_override: Option<String>) -> (String, Array<String>):
        let (requested_executable, requested_args) = shell_override.map(parse_shell_command).unwrap_or_else(|| (String__new_(), Vec__new_()))
        let requested = requested_executable.as_str()
        let requested_args = requested_args.clone()
        let system_root = std__env__var_("SystemRoot").unwrap_or_else(|_| "C:\\Windows".to_string())
        let powershell_path = format!("{}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", system_root)
        let pwsh_path = std__env__var_("ProgramFiles").unwrap_or_default() + "\\PowerShell\\7\\pwsh.exe"
        let requested_path_is_explicit = command_looks_like_path(requested)
        let default_shell = || if Path__new_(&pwsh_path).exists():
            (pwsh_path.clone(), vec!("-NoLogo".to_string()))
        else if Path__new_(&powershell_path).exists():
            (powershell_path.clone(), vec!("-NoLogo".to_string()))
        else:
            let cmd_path = format!("{}\\System32\\cmd.exe", system_root)
            (cmd_path, Vec__new_())
        if requested.is_empty():
            return default_shell()
        let normalized = requested.to_ascii_lowercase()
        if normalized.ends_with("cmd") or normalized.ends_with("cmd.exe"):
            let executable = if requested_path_is_explicit:
                requested.to_string()
            else:
                format!("{}\\System32\\cmd.exe", system_root)
            return (executable, if requested_args.is_empty():
                Vec__new_()
            else:
                requested_args)
        if normalized.ends_with("pwsh") or normalized.ends_with("pwsh.exe"):
            let executable = if requested_path_is_explicit:
                requested.to_string()
            else if Path__new_(&pwsh_path).exists():
                pwsh_path
            else if command_exists(requested):
                requested.to_string()
            else if Path__new_(&powershell_path).exists():
                powershell_path.clone()
            else:
                default_shell().field_0
            return (executable, if requested_args.is_empty():
                vec!("-NoLogo".to_string())
            else:
                requested_args)
        if normalized.ends_with("powershell") or normalized.ends_with("powershell.exe"):
            let executable = if requested_path_is_explicit:
                requested.to_string()
            else if Path__new_(&powershell_path).exists():
                powershell_path
            else if command_exists(requested):
                requested.to_string()
            else:
                default_shell().field_0
            return (executable, if requested_args.is_empty():
                vec!("-NoLogo".to_string())
            else:
                requested_args)
        if Path__new_(requested).exists() or command_exists(requested):
            return (requested.to_string(), requested_args)
        default_shell()
        ()
        ()
        if !requested_executable.is_empty():
            return (requested_executable.clone(), if requested_args.is_empty():
                vec!("-l".to_string())
            else:
                requested_args)
        if Path__new_("/bin/zsh").exists():
            return ("/bin/zsh".to_string(), vec!("-l".to_string()))
        ("/bin/bash".to_string(), vec!("-l".to_string()))
        ()
        ()
        if !requested_executable.is_empty():
            return (requested_executable.clone(), if requested_args.is_empty():
                vec!("-l".to_string())
            else:
                requested_args)
        match std__env__var_("SHELL"):
            Ok(shell) =>
                return (shell, vec!("-l".to_string()))
            _ =>
                ()
                ()
        ("/bin/bash".to_string(), vec!("-l".to_string()))
        ()
        ()
        if !requested_executable.is_empty():
            return (requested_executable.clone(), requested_args)
        ("/bin/sh".to_string(), vec!())

    fn spawn_(_self: &TerminalManager, id: String, working_dir: Option<String>, shell: Option<String>, rows: u16, cols: u16) -> Result<(), String>:
        let pty_system = NativePtySystem__default_()
        let pair = pty_system.openpty(portable_pty::PtySize { rows: rows, cols: cols, pixel_width: 0, pixel_height: 0 }).map_err(|e| format!("Failed to open PTY: {}", e))?
        let (shell, args) = TerminalManager__get_shell(shell)
        let mut cmd = CommandBuilder__new_(&shell)
        for arg in args:
            cmd.arg(arg)
            ()
        ()
        match &working_dir:
            Some(dir) =>
                let normalized = dir.replace("/", "\\")
                let normalized = dir.to_string()
                cmd.cwd(&normalized)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let child = pair.slave.spawn_command(cmd).map_err(|e| format!("Failed to spawn shell: {}", e))?
        let writer = pair.master.take_writer().map_err(|e| format!("Failed to get writer: {}", e))?
        let instance = Arc__new_(Mutex__new_(TerminalInstance { master: pair.master, writer: writer, child: child }))
        let mut terminals = (*_self).terminals.lock().unwrap()
        terminals.insert(id.to_string(), instance)
        ()
        drop(terminals)
        ()
        let shell_kind = terminal_shell_kind_from_executable(&shell)
        let mut shell_states = (*_self).shell_states.lock().unwrap()
        shell_states.insert(id.to_string(), TerminalShellIntegrationState { shell_kind: shell_kind, supports_auto_cd: true, at_prompt: true, reported_cwd: working_dir, pending_cwd: none, last_synced_cwd: none })
        ()
        drop(shell_states)
        ()
        match terminal_shell_integration_bootstrap_command(&terminal_shell_kind_from_executable(&shell)):
            Some(bootstrap_command) =>
                match (*_self).write_hidden_host_command(id, &bootstrap_command):
                    Err(error) =>
                        log::warn!("failed to install terminal shell integration for {id}: {error}")
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        Result::Ok(())

    fn write(_self: &TerminalManager, id: String, data: &Slice<u8>) -> Result<(), String>:
        if data.is_empty():
            return Result::Ok(())
        let instance = (*_self).terminal_instance(id)?
        let mut instance = instance.lock().unwrap()
        instance.writer.write_all(data).map_err(|e| format!("Write failed: {}", e))?
        ()
        Result::Ok(())

    fn write_many(_self: &TerminalManager, writes: &Slice<TerminalWriteRequest>) -> Result<(), String>:
        for request in writes:
            if request.data.is_empty():
                continue
            let instance = (*_self).terminal_instance(&request.id)?
            let mut instance = instance.lock().unwrap()
            instance.writer.write_all(request.data.as_bytes()).map_err(|e| format!("Write failed for {}: {}", request.id, e))?
            ()
        ()
        Result::Ok(())

    fn write_hidden_host_command(_self: &TerminalManager, id: String, command: String) -> Result<(), String>:
        let trimmed_command = trim_hidden_host_command_echo_bytes(command)
        match trimmed_command.clone():
            Some(trimmed_command) =>
                let mut hidden_host_command_echoes = (*_self).hidden_host_command_echoes.lock().map_err(|_| "terminal hidden host command echoes lock poisoned".to_string())?
                hidden_host_command_echoes.entry(id.to_string()).or_default().push_back(trimmed_command)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match (*_self).write(id, command.as_bytes()):
            Err(error) =>
                if trimmed_command.is_some():
                    match (*_self).hidden_host_command_echoes.lock():
                        Ok(mut hidden_host_command_echoes) =>
                            match hidden_host_command_echoes.get_mut(id):
                                Some(queued_commands) =>
                                    queued_commands.pop_back()
                                    ()
                                    if queued_commands.is_empty():
                                        hidden_host_command_echoes.remove(id)
                                        ()
                                        ()
                                        ()
                                        ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                return Result::Err(error)
            _ =>
                ()
                ()
        Result::Ok(())

    fn drain_hidden_host_command_echoes(_self: &TerminalManager, id: String) -> Array<Array<u8>>:
        let Ok(mut hidden_host_command_echoes) = (*_self).hidden_host_command_echoes.lock()
        hidden_host_command_echoes.remove(id).map(|commands| commands.into_iter().collect()).unwrap_or_default()

    fn read(_self: &TerminalManager, id: String) -> Result<Array<u8>, String>:
        let instance = (*_self).terminal_instance(id)?
        let mut reader = block:
            let instance = instance.lock().unwrap()
            instance.master.try_clone_reader().map_err(|e| format!("Failed to clone reader: {}", e))?
        let mut buffer = vec!()
        match reader.read(&mut buffer):
            Ok(n) if n > 0 =>
                buffer.truncate(n)
                ()
                Result::Ok(buffer)
            Ok(_) => Result::Ok(vec!())
            Err(e) if e.kind() == io::ErrorKind::WouldBlock => Result::Ok(vec!())
            Err(e) => Result::Err(format!("Read failed: {}", e))

    fn resize(_self: &TerminalManager, id: String, rows: u16, cols: u16) -> Result<(), String>:
        let instance = (*_self).terminal_instance(id)?
        let instance = instance.lock().unwrap()
        instance.master.resize(portable_pty::PtySize { rows: rows, cols: cols, pixel_width: 0, pixel_height: 0 }).map_err(|e| format!("Resize failed: {}", e))?
        ()
        Result::Ok(())

    fn terminal_instance(_self: &TerminalManager, id: String) -> Result<TerminalInstance, String>:
        let terminals = (*_self).terminals.lock().unwrap()
        terminals.get(id).cloned().ok_or_else(|| format!("Terminal {} not found", id))

    fn open_output_stream(_self: &TerminalManager, id: String, app: &tauri::AppHandle) -> Result<greeble_ipc_contracts::IpcStreamHandle, String>:
        let _ = (*_self).terminal_instance(id)?
        match ((*_self).output_streams.lock().map_err(|_| "terminal output stream lock poisoned".to_string())?).get(id).cloned():
            Some(existing) =>
                return Result::Ok(existing)
            _ =>
                ()
                ()
        let handle = tauri__transport__register_stream(app, "terminal-output", Option::Some(id))?
        let handle = greeble_ipc_contracts::IpcStreamHandle { id: handle.id, kind: handle.kind }
        let mut output_streams = (*_self).output_streams.lock().map_err(|_| "terminal output stream lock poisoned".to_string())?
        output_streams.insert(id.to_string(), handle.clone())
        ()
        Result::Ok(handle)

    fn kill(_self: &TerminalManager, id: String, app: &tauri::AppHandle) -> Result<(), String>:
        let mut terminals = (*_self).terminals.lock().unwrap()
        terminals.remove(id).ok_or_else(|| format!("Terminal {} not found", id))?
        ()
        drop(terminals)
        ()
        let mut shell_states = (*_self).shell_states.lock().unwrap()
        shell_states.remove(id)
        ()
        drop(shell_states)
        ()
        match ((*_self).output_streams.lock().map_err(|_| "terminal output stream lock poisoned".to_string())?).remove(id):
            Some(stream_handle) =>
                tauri__transport__close_stream(app, &stream_handle.id)?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match (*_self).hidden_host_command_echoes.lock():
            Ok(mut hidden_host_command_echoes) =>
                hidden_host_command_echoes.remove(id)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        Result::Ok(())

    fn register_shell_integration(_self: &TerminalManager, request: &TerminalShellIntegrationRequest) -> Result<TerminalShellIntegrationState, String>:
        let mut states = (*_self).shell_states.lock().unwrap()
        let state = states.entry((*request).id.clone()).or_insert_with(|| TerminalShellIntegrationState { shell_kind: (*request).shell_kind.clone().unwrap_or(TerminalShellKind::Unknown), supports_auto_cd: (*request).supports_auto_cd.unwrap_or(true), at_prompt: (*request).at_prompt.unwrap_or(true), reported_cwd: (*request).reported_cwd.clone(), pending_cwd: none, last_synced_cwd: none })
        match &(*request).shell_kind:
            Some(shell_kind) =>
                state.shell_kind = shell_kind.clone()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match (*request).supports_auto_cd:
            Some(supports_auto_cd) =>
                state.supports_auto_cd = supports_auto_cd
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match (*request).at_prompt:
            Some(at_prompt) =>
                state.at_prompt = at_prompt
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match &(*request).reported_cwd:
            Some(reported_cwd) =>
                state.reported_cwd = Option::Some(reported_cwd.clone())
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        Result::Ok(state.clone())

    fn request_cwd_sync(_self: &TerminalManager, id: String, cwd: String) -> Result<(TerminalShellIntegrationState, Option<String>), String>:
        let mut states = (*_self).shell_states.lock().unwrap()
        let state = states.get_mut(id).ok_or_else(|| format!("Terminal {} shell state not found", id))?
        state.reported_cwd = Option::Some(cwd.to_string())
        ()
        state.pending_cwd = Option::Some(cwd.to_string())
        ()
        if state.supports_auto_cd and state.at_prompt:
            let applied = (*_self).flush_pending_cwd_locked(id, state)?
            return Result::Ok((state.clone(), applied))
        Result::Ok((state.clone(), none))

    fn set_prompt_state(_self: &TerminalManager, id: String, at_prompt: Bool, reported_cwd: Option<String>) -> Result<(TerminalShellIntegrationState, Option<String>), String>:
        let mut states = (*_self).shell_states.lock().unwrap()
        let state = states.get_mut(id).ok_or_else(|| format!("Terminal {} shell state not found", id))?
        state.at_prompt = at_prompt
        ()
        match reported_cwd:
            Some(reported_cwd) =>
                state.reported_cwd = Option::Some(reported_cwd)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let applied = if state.at_prompt:
            (*_self).flush_pending_cwd_locked(id, state)?
        else:
            none
        Result::Ok((state.clone(), applied))

    fn report_prompt_ready_cwd(_self: &TerminalManager, id: String, reported_cwd: String) -> Result<Option<(TerminalShellIntegrationState, Option<String>)>, String>:
        let mut states = (*_self).shell_states.lock().unwrap()
        let state = states.get_mut(id).ok_or_else(|| format!("Terminal {} shell state not found", id))?
        let normalized_reported_cwd = normalize_reported_terminal_cwd(&state.shell_kind, reported_cwd)
        if normalized_reported_cwd.is_empty():
            return Result::Ok(none)
        let should_emit = !state.at_prompt or state.reported_cwd != Option::Some(normalized_reported_cwd.as_str()) or state.pending_cwd.is_some()
        state.at_prompt = true
        ()
        state.reported_cwd = Option::Some(normalized_reported_cwd)
        ()
        let applied = (*_self).flush_pending_cwd_locked(id, state)?
        if !should_emit and applied.is_none():
            return Result::Ok(none)
        Result::Ok(Option::Some((state.clone(), applied)))

    fn flush_pending_cwd_locked(_self: &TerminalManager, id: String, state: &mut TerminalShellIntegrationState) -> Result<Option<String>, String>:
        let Some(cwd) = (*state).pending_cwd.clone()
        if !(*state).supports_auto_cd:
            return Result::Ok(none)
        if (*state).last_synced_cwd == Option::Some(cwd.as_str()):
            (*state).pending_cwd = none
            ()
            return Result::Ok(none)
        let Some(command) = terminal_auto_cd_command(&(*state).shell_kind, &cwd)
        (*_self).write_hidden_host_command(id, &command)?
        ()
        (*state).last_synced_cwd = Option::Some(cwd.clone())
        ()
        (*state).pending_cwd = none
        ()
        Result::Ok(Option::Some(cwd))

    fn start_reader_thread(_self: &TerminalManager, id: String, app: tauri::AppHandle):
