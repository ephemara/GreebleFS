    let ttl = fs_cache_policy().search_name_index_cache_ttl
    if ttl.is_zero():
        cache.clear()
        ()
        return
    for variants in cache.values_mut():
        if variants.visible_only.map(|index| index.cached_at.elapsed() > ttl).unwrap_or(false):
            variants.visible_only = none
            ()
            ()
            ()
            ()
        if variants.include_hidden.map(|index| index.cached_at.elapsed() > ttl).unwrap_or(false):
            variants.include_hidden = none
            ()
    ()
    cache.retain(|_, variants| variants.visible_only.is_some() or variants.include_hidden.is_some())
    ()

fn prune_expired_search_content_index_cache(cache: &mut Map<ExplorerPathKey, CachedSearchContentIndexVariants>):
    let ttl = fs_cache_policy().search_content_index_cache_ttl
    if ttl.is_zero():
        cache.clear()
        ()
        return
    for variants in cache.values_mut():
        if variants.visible_only.map(|index| index.cached_at.elapsed() > ttl).unwrap_or(false):
            variants.visible_only = none
            ()
            ()
            ()
            ()
        if variants.include_hidden.map(|index| index.cached_at.elapsed() > ttl).unwrap_or(false):
            variants.include_hidden = none
            ()
    ()
    cache.retain(|_, variants| variants.visible_only.is_some() or variants.include_hidden.is_some())
    ()

fn search_request_scope(path: String, request_scope: Option<String>) -> String:
    request_scope.map(|scope| scope.trim().to_string()).filter(|scope| !scope.is_empty()).unwrap_or_else(|| path_cache_key_string(Path__new_(path)))

fn register_search_request(scope: String, request_id: Option<u64>) -> u64:
    let mut active = search_requests().lock().expect("search request map poisoned")
    match request_id:
        Some(id) =>
            active.insert(scope.to_string(), id)
            ()
            id
        None =>
            let next_request_id = active.get(scope).copied().unwrap_or(0).saturating_add(1)
            active.insert(scope.to_string(), next_request_id)
            ()
            next_request_id

fn is_search_request_active(scope: String, request_id: u64) -> Bool:
    search_requests().lock().ok().and_then(|active| active.get(scope).copied()) == Option::Some(request_id)

fn pause_search_entry_scan_for_tests():
    ()

fn record_search_entry_scan_for_tests():
    ()

fn invalidate_entry_size_cache(path: &std::path::Path):
    let key = path_cache_key_string(path)
    let key_with_separator = if key.ends_with(std__path__MAIN_SEPARATOR):
        key.clone()
    else:
        format!("{key}{}", std__path__MAIN_SEPARATOR)
    match entry_size_cache().lock():
        Ok(mut cache) =>
            cache.retain(
                |cached_path, _| block:
                    if cached_path == &key or cached_path.starts_with(&key_with_separator):
                        return false
                    let cached_path_with_separator = if cached_path.ends_with(std__path__MAIN_SEPARATOR):
                        cached_path.clone()
                    else:
                        format!("{cached_path}{}", std__path__MAIN_SEPARATOR)
                    !key.starts_with(&cached_path_with_separator)
            )
            ()
        _ => ()

fn invalidate_dir_list_cache(path: &std::path::Path):
    let key = path_cache_key(path)
    match dir_list_cache().lock():
        Ok(mut cache) =>
            cache.retain(|cached_path, _| !cached_path.is_same_or_descendant_of(&key))
            ()
        _ => ()

fn invalidate_search_name_index_cache(path: &std::path::Path):
    let key = path_cache_key(path)
    match search_name_index_cache().lock():
        Ok(mut cache) =>
            cache.retain(
                |cached_path, _| block:
                    if cached_path.is_same_or_descendant_of(&key):
                        return false
                    !key.is_same_or_descendant_of(cached_path)
            )
            ()
        _ => ()

fn invalidate_search_content_index_cache(path: &std::path::Path):
    let key = path_cache_key(path)
    match search_content_index_cache().lock():
        Ok(mut cache) =>
            cache.retain(
                |cached_path, _| block:
                    if cached_path.is_same_or_descendant_of(&key):
                        return false
                    !key.is_same_or_descendant_of(cached_path)
            )
            ()
        _ => ()

fn invalidate_persisted_entry_size(path: &std::path::Path):
    let _ = entry_size_cache__delete_entry_size_subtree(path)
    let _ = entry_size_cache__mark_path_and_ancestors_dirty(path)

fn invalidate_all_entry_size_caches(path: &std::path::Path):
    invalidate_entry_size_cache(path)
    ()
    invalidate_persisted_entry_size(path)
    ()

fn invalidate_all_fs_caches(path: &std::path::Path):
    invalidate_all_entry_size_caches(path)
    ()
    invalidate_dir_list_cache(path)
    ()
    invalidate_search_name_index_cache(path)
    ()
    invalidate_search_content_index_cache(path)
    ()

fn invalidate_all_fs_caches_for_path(path: &std::path::Path):
    invalidate_all_fs_caches(path)
    ()
    match path.parent():
        Some(parent) =>
            invalidate_dir_list_cache(parent)
            ()
        _ => ()

struct MeasuredPathSize:
    bytes: u64
    is_dir: Bool
    is_complete: Bool
    modified_ms: Option<u64>
    entry_bytes: Option<u64>

fn metadata_modified_ms(metadata: &std::fs::Metadata) -> Option<u64>:
    metadata.modified().ok().and_then(|value| value.duration_since(std__time__UNIX_EPOCH).ok()).map(|duration| duration.as_millis() as u64)

fn metadata_created_ms(metadata: &std::fs::Metadata) -> Option<u64>:
    metadata.created().ok().and_then(|value| value.duration_since(std__time__UNIX_EPOCH).ok()).map(|duration| duration.as_millis() as u64)

fn metadata_accessed_ms(metadata: &std::fs::Metadata) -> Option<u64>:
    metadata.accessed().ok().and_then(|value| value.duration_since(std__time__UNIX_EPOCH).ok()).map(|duration| duration.as_millis() as u64)

fn unix_permissions_octal(metadata: &std::fs::Metadata) -> u32:
    metadata.permissions().mode() & 511

fn format_unix_permissions(mode: u32) -> String:
    let mut rendered = |__kain_ctor_arg0| String::new()(9)
    for shift in [6, 3, 0]:
        rendered.push(
            if (mode & (4 << shift)) != 0:
                "r"
            else:
                "-"
        )
        ()
        rendered.push(
            if (mode & (2 << shift)) != 0:
                "w"
            else:
                "-"
        )
        ()
        rendered.push(
            if (mode & (1 << shift)) != 0:
                "x"
            else:
                "-"
        )
        ()
    ()
    rendered

fn describe_permissions(metadata: &std::fs::Metadata) -> FsPermissionInfo:
    let mode = unix_permissions_octal(metadata)
    return FsPermissionInfo { readonly: metadata.permissions().readonly(), display: format!("{} ({mode:03o})", format_unix_permissions(mode)), unix_mode: Option::Some(mode), unix_mode_octal: Option::Some(format!("{mode:03o}")) }
    let readonly = metadata.permissions().readonly()
    FsPermissionInfo { readonly: readonly, display: if readonly:
        "Read-only".to_string()
    else:
        "Read/Write".to_string(), unix_mode: none, unix_mode_octal: none }

fn read_item_properties(path: &std::path::Path) -> Result<FsItemPropertiesInfo, String>:
    let metadata = std__fs__symlink_metadata(path).map_err(|error| format!("Failed to inspect {}: {error}", path.display()))?
    Result::Ok(FsItemPropertiesInfo { path: path.to_string_lossy().to_string(), name: path.file_name().map(|value| value.to_string_lossy().to_string()).unwrap_or_else(|| path.to_string_lossy().to_string()), is_dir: metadata.is_dir(), is_symlink: metadata.file_type().is_symlink(), bytes: if metadata.is_dir():
        0
    else:
        metadata.len(), modified_at_ms: metadata_modified_ms(&metadata), created_at_ms: metadata_created_ms(&metadata), accessed_at_ms: metadata_accessed_ms(&metadata), permissions: describe_permissions(&metadata) })

fn cha_modified_ms(metadata: &yazi_fs::cha::Cha) -> Option<u64>:
    (*metadata).mtime.and_then(|value| value.duration_since(std__time__UNIX_EPOCH).ok()).map(|duration| duration.as_millis() as u64)

fn build_local_entry_content_revision(size: u64, modified_ms: u64, is_dir: Bool, is_symlink: Bool) -> String:
    explorer_identity__build_content_revision(size, modified_ms, is_dir, is_symlink)

fn build_local_entry_identity(app: &tauri::AppHandle, identity_manager: &ExplorerIdentityManager, path: &std::path::Path, size: u64, modified_ms: u64, is_dir: Bool, is_symlink: Bool) -> Result<(String, ExplorerIdentityKind, String), String>:
    let content_revision = build_local_entry_content_revision(size, modified_ms, is_dir, is_symlink)
    let resolved_identity = explorer_identity__resolve_local_identity(app, identity_manager, path, &content_revision)?
    Result::Ok((resolved_identity.entity_id, resolved_identity.identity_kind, resolved_identity.content_revision))

fn build_local_entry_listing_identity(app: &tauri::AppHandle, identity_manager: &ExplorerIdentityManager, path: &std::path::Path, size: u64, modified_ms: u64, is_dir: Bool, is_symlink: Bool) -> Result<(String, ExplorerIdentityKind, String), String>:
    let _ = app
    let content_revision = build_local_entry_content_revision(size, modified_ms, is_dir, is_symlink)
    let resolved_identity = explorer_identity__resolve_fast_local_listing_identity(identity_manager, path, &content_revision)
    Result::Ok((resolved_identity.entity_id, resolved_identity.identity_kind, resolved_identity.content_revision))
    ()
    ()
    build_local_entry_identity(app, identity_manager, path, size, modified_ms, is_dir, is_symlink)

fn build_transfer_result_from_destination(app: &tauri::AppHandle, identity_manager: &ExplorerIdentityManager, source_path: &std::path::Path, destination_path: &std::path::Path, operation: FileTransferOperation, collision_policy: FileTransferCollisionPolicy, disposition: FileTransferDisposition) -> Result<FileTransferResult, String>:
    let metadata = std__fs__symlink_metadata(destination_path).map_err(|error| format!("Failed to inspect transferred destination '{}': {error}", destination_path.display()))?
    let is_symlink = metadata.file_type().is_symlink()
    let is_dir = metadata.is_dir()
    let size = if is_dir:
        0
    else:
        metadata.len()
    let modified = metadata_modified_ms(&metadata).unwrap_or(0)
    let (entity_id, identity_kind, content_revision) = build_local_entry_identity(app, identity_manager, destination_path, size, modified, is_dir, is_symlink)?
    Result::Ok(FileTransferResult { source_path: source_path.to_string_lossy().to_string(), destination_path: destination_path.to_string_lossy().to_string(), operation: operation, collision_policy: collision_policy, disposition: disposition, entity_id: entity_id, identity_kind: identity_kind, content_revision: content_revision })

fn build_transfer_result_from_source(app: &tauri::AppHandle, identity_manager: &ExplorerIdentityManager, source_path: &std::path::Path, destination_path: &std::path::Path, operation: FileTransferOperation, collision_policy: FileTransferCollisionPolicy, disposition: FileTransferDisposition) -> Result<FileTransferResult, String>:
    let metadata = std__fs__symlink_metadata(source_path).map_err(|error| format!("Failed to inspect transfer source '{}': {error}", source_path.display()))?
    let is_symlink = metadata.file_type().is_symlink()
    let is_dir = metadata.is_dir()
    let size = if is_dir:
        0
    else:
        metadata.len()
    let modified = metadata_modified_ms(&metadata).unwrap_or(0)
    let (entity_id, identity_kind, content_revision) = build_local_entry_identity(app, identity_manager, source_path, size, modified, is_dir, is_symlink)?
    Result::Ok(FileTransferResult { source_path: source_path.to_string_lossy().to_string(), destination_path: destination_path.to_string_lossy().to_string(), operation: operation, collision_policy: collision_policy, disposition: disposition, entity_id: entity_id, identity_kind: identity_kind, content_revision: content_revision })

fn current_time_millis() -> u64:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(|duration| duration.as_millis() as u64).unwrap_or(0)

fn persisted_entry_is_valid(path: &std::path::Path, entry: &PersistedEntrySize) -> Bool:
    if (*entry).dirty:
        return false
    let metadata = match std__fs__symlink_metadata(path):
        Ok(metadata) => metadata
        Err(_) => return false
    let file_type = metadata.file_type()
    if file_type.is_symlink():
        return (*entry).bytes == 0 and (*entry).is_complete
    if (*entry).is_dir != metadata.is_dir():
        return false
    let modified_ms = metadata_modified_ms(&metadata)
    if (*entry).modified_ms != modified_ms:
        return false
    if metadata.is_file():
        return (*entry).entry_bytes == Option::Some(metadata.len())
    metadata.is_dir()

fn measured_to_persisted_entry(path: &std::path::Path, measurement: &MeasuredPathSize) -> PersistedEntrySize:
    PersistedEntrySize { path: path_cache_key_string(path), bytes: (*measurement).bytes, is_dir: (*measurement).is_dir, is_complete: (*measurement).is_complete, modified_ms: (*measurement).modified_ms, entry_bytes: (*measurement).entry_bytes, measured_at_ms: current_time_millis(), dirty: false }

fn measure_path_size_with_cancel(path: &std::path::Path, cancellation_token: Option<&NativeTaskCancellationToken>) -> Result<MeasuredPathSize, String>:
    match cancellation_token:
        Some(token) =>
            token.throw_if_cancelled()?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let metadata = match std__fs__symlink_metadata(path):
        Ok(metadata) => metadata
        Err(_) =>
            return Result::Ok(MeasuredPathSize { bytes: 0, is_dir: false, is_complete: false, modified_ms: none, entry_bytes: none })
    let file_type = metadata.file_type()
    let modified_ms = metadata_modified_ms(&metadata)
    if file_type.is_symlink():
        return Result::Ok(MeasuredPathSize { bytes: 0, is_dir: path.is_dir(), is_complete: true, modified_ms: modified_ms, entry_bytes: none })
    if metadata.is_file():
        return Result::Ok(MeasuredPathSize { bytes: metadata.len(), is_dir: false, is_complete: true, modified_ms: modified_ms, entry_bytes: Option::Some(metadata.len()) })
    if !metadata.is_dir():
        return Result::Ok(MeasuredPathSize { bytes: 0, is_dir: false, is_complete: false, modified_ms: modified_ms, entry_bytes: none })
    let mut total_bytes = 0
    let mut stack = vec!(path.to_path_buf())
    let mut visited = HashSet__new_()
    let deadline = Instant__now() + fs_cache_policy().entry_size_scan_budget
    loop:
        match stack.pop():
            Some(dir) =>
                match cancellation_token:
                    Some(token) =>
                        token.throw_if_cancelled()?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                if Instant__now() >= deadline:
                    return Result::Ok(MeasuredPathSize { bytes: total_bytes, is_dir: true, is_complete: false, modified_ms: modified_ms, entry_bytes: none })
                let canonical = dir.canonicalize().unwrap_or(dir.clone())
                if !visited.insert(canonical):
                    continue
                let read_dir = match std__fs__read_dir(&dir):
                    Ok(entries) => entries
                    Err(_) => continue
                for entry in read_dir.flatten():
                    match cancellation_token:
                        Some(token) =>
                            token.throw_if_cancelled()?
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    if Instant__now() >= deadline:
                        return Result::Ok(MeasuredPathSize { bytes: total_bytes, is_dir: true, is_complete: false, modified_ms: modified_ms, entry_bytes: none })
                    let entry_path = entry.path()
                    let entry_metadata = match std__fs__symlink_metadata(&entry_path):
                        Ok(metadata) => metadata
                        Err(_) => continue
                    let entry_type = entry_metadata.file_type()
                    if entry_type.is_symlink():
                        continue
                    if entry_type.is_dir():
                        stack.push(entry_path)
                        ()
                        continue
                    if entry_type.is_file():
                        total_bytes = total_bytes.saturating_add(entry_metadata.len())
                        ()
            _ => break
    ()
    Result::Ok(MeasuredPathSize { bytes: total_bytes, is_dir: true, is_complete: true, modified_ms: modified_ms, entry_bytes: none })

fn measure_entry_sizes_blocking_with_cancel(paths: Array<String>, force_refresh: Bool, cancellation_token: Option<&NativeTaskCancellationToken>) -> Result<Array<EntryStorageInfo>, String>:
    let now = Instant__now()
    let entry_size_cache_ttl = fs_cache_policy().entry_size_cache_ttl
    let mut results = |__kain_ctor_arg0| Vec::new()(paths.len())
    let mut pending: Array<(usize, std::path::PathBuf, String)> = Vec__new_()
    let path_bufs = paths.iter().map(PathBuf__from).collect()
    let persisted = if force_refresh:
        HashMap__new_()
    else:
        entry_size_cache__load_entry_size_cache(&path_bufs).unwrap_or_default()
    match entry_size_cache().lock():
        Ok(cache) =>
            for (index, raw_path) in paths.iter().enumerate():
                let path = PathBuf__from(raw_path)
                let key = path_cache_key_string(&path)
                let cached = if force_refresh:
                    none
                else:
                    cache.get(&key).filter(|entry| !entry_size_cache_ttl.is_zero() and now.duration_since(entry.measured_at) <= entry_size_cache_ttl).cloned()
                match cached:
                    Some(entry) =>
                        results.push(EntryStorageInfo { path: key, bytes: entry.bytes, is_dir: entry.is_dir, is_complete: entry.is_complete })
                        ()
                    _ =>
                        match persisted.get(&key).filter(|entry| persisted_entry_is_valid(&path, entry)):
                            Some(entry) =>
                                results.push(EntryStorageInfo { path: entry.path.clone(), bytes: entry.bytes, is_dir: entry.is_dir, is_complete: entry.is_complete })
                                ()
                            _ =>
                                results.push(EntryStorageInfo { path: key.clone(), bytes: 0, is_dir: path.is_dir(), is_complete: !path.is_dir() })
                                ()
                                pending.push((index, path, key))
                                ()
            ()
            ()
        _ =>
            ()
            ()
    if pending.is_empty():
        return Result::Ok(results)
    let mut cache_updates = |__kain_ctor_arg0| Vec::new()(pending.len())
    let mut persisted_updates = |__kain_ctor_arg0| Vec::new()(pending.len())
    for (index, path, key) in pending:
        match cancellation_token:
            Some(token) =>
                token.throw_if_cancelled()?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let measured = measure_path_size_with_cancel(&path, cancellation_token)?
        results[index] = EntryStorageInfo { path: key.clone(), bytes: measured.bytes, is_dir: measured.is_dir, is_complete: measured.is_complete }
        ()
        cache_updates.push((key, CachedEntrySize { bytes: measured.bytes, is_dir: measured.is_dir, is_complete: measured.is_complete, measured_at: now }))
        ()
        persisted_updates.push(measured_to_persisted_entry(&path, &measured))
        ()
    ()
    match entry_size_cache().lock():
        Ok(mut cache) =>
            if !entry_size_cache_ttl.is_zero():
                for (key, entry) in cache_updates:
                    cache.insert(key, entry)
                    ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    let _ = entry_size_cache__upsert_entry_size_cache(&persisted_updates)
    Result::Ok(results)

enum FileTransferOperation:
    Copy
    Move

enum FileTransferCollisionPolicy:
    KeepBoth
    Replace
    Skip

enum FileTransferDisposition:
    Transferred
    SkippedExisting

struct FileTransferCollision:
    source_path: String
    source_name: String
    destination_path: String
    operation: FileTransferOperation
    destination_exists: Bool
    destination_is_dir: Bool

struct FileTransferResult:
    source_path: String
    destination_path: String
    operation: FileTransferOperation
    collision_policy: FileTransferCollisionPolicy
    disposition: FileTransferDisposition
    entity_id: String
    identity_kind: ExplorerIdentityKind
    content_revision: String

enum FileSearchMatchKind:
    Name
    Content
    NameAndContent

struct FileSearchResult:
    name: String
    path: String
    relative_path: String
    is_dir: Bool
    size: u64
    modified: u64
    extension: String
    is_hidden: Bool
    is_symlink: Bool
    match_kind: FileSearchMatchKind
    snippet: String
    line_number: Option<u64>
    entity_id: String
    identity_kind: ExplorerIdentityKind
    content_revision: String

enum FileSearchExecutionStrategy:
    NameIndexCacheHit
    ContentIndexCacheHit
    LiveScan

enum FileSearchContentCacheStatus:
    NotRequested
    CacheHit
    Warmed
    Disabled
    OverBudgetFallback
    ReadFailureFallback

struct FileSearchDiagnostics:
    execution_strategy: FileSearchExecutionStrategy
    content_cache_status: FileSearchContentCacheStatus
    scanned_entry_count: u64
    indexed_entry_count: u64
    content_cache_stored_file_count: u64
    content_cache_stored_byte_count: u64
    truncated_by_scan_budget: Bool

struct FileSearchResponse:
    results: Array<FileSearchResult>
    diagnostics: FileSearchDiagnostics

struct ListedFileEntry:
    sort_name: String
    entry: FileEntry

struct SearchableEntry:
    path: std::path::PathBuf
    name_lower: String
    result: FileSearchResult
    content_searchable: Bool

fn build_listed_file_entry(app: &tauri::AppHandle, identity_manager: &ExplorerIdentityManager, entry: T, show_hidden: Bool) -> Result<Option<ListedFileEntry>, String>:
    let name = entry.name().to_string_lossy().into_owned()
    let path = entry.path().to_os_owned().map_err(|error| format!("Failed to resolve Yazi entry path: {error}"))?
    let provider = Local__regular(&path)
    let entry_metadata = (await provider.symlink_metadata()).map_err(|error| format!("Failed to read entry metadata '{}': {error}", path.to_string_lossy()))?
    let entry_type = ChaType__from(entry_metadata.mode)
    let is_hidden = entry_metadata.is_hidden() or is_hidden_name(&name)
    if is_hidden and !show_hidden:
        return Result::Ok(none)
    let target_metadata = if entry_type == yazi_fs::cha::ChaType::Link:
        (await provider.metadata()).ok()
    else:
        none
    let metadata = target_metadata.unwrap_or(&entry_metadata)
    let is_symlink = entry_type == yazi_fs::cha::ChaType::Link
    let is_dir = entry_type.is_dir() or ChaType__from(metadata.mode).is_dir()
    let size = if is_dir:
        0
    else:
        metadata.len
    let modified = cha_modified_ms(metadata).unwrap_or(0)
    let (entity_id, identity_kind, content_revision) = build_local_entry_listing_identity(app, identity_manager, &path, size, modified, is_dir, is_symlink)?
    Result::Ok(Option::Some(ListedFileEntry { sort_name: name.to_lowercase(), entry: FileEntry { name: name, path: path.to_string_lossy().to_string(), is_dir: is_dir, size: size, modified: modified, extension: if is_dir:
        String__new_()
    else:
        normalized_extension(&path), is_hidden: is_hidden, is_symlink: is_symlink, entity_id: entity_id, identity_kind: identity_kind, content_revision: content_revision } }))

fn list_dir_via_yazi(app: &tauri::AppHandle, identity_manager: &ExplorerIdentityManager, dir_path: &std::path::Path, show_hidden: Bool) -> Result<Array<FileEntry>, String>:
    let mut read_dir = (await Local__regular(dir_path).read_dir()).map_err(|error| format!("Failed to read directory: {error}"))?
    let mut entries = Vec__new_()
    loop:
        match (await read_dir.next()).map_err(|error| format!("Failed to read directory: {error}"))?:
            Some(entry) =>
                match (await build_listed_file_entry(app, identity_manager, entry, show_hidden))?:
                    Some(listed) =>
                        entries.push(listed)
                        ()
                    _ => ()
            _ => break
    ()
    entries.sort_unstable_by(
        |left, right| match (left.entry.is_dir, right.entry.is_dir):
            (true, false) => cmp::Ordering::Less
            (false, true) => cmp::Ordering::Greater
            _ => left.sort_name.cmp(&right.sort_name)
    )
    ()
    Result::Ok(entries.into_iter().map(|listed| listed.entry).collect())

fn build_searchable_entry(entry: T, root: &std::path::Path, show_hidden: Bool, max_search_content_file_bytes: u64) -> Option<SearchableEntry>:
    let name = entry.name().to_string_lossy().into_owned()
    let path = entry.path().to_os_owned().ok()?
    let provider = Local__regular(&path)
    let entry_metadata = (await provider.symlink_metadata()).ok()?
    let entry_type = ChaType__from(entry_metadata.mode)
    let is_hidden = entry_metadata.is_hidden() or is_hidden_name(&name)
    if is_hidden and !show_hidden:
        return none
    let target_metadata = if entry_type == yazi_fs::cha::ChaType::Link:
        (await provider.metadata()).ok()
    else:
        none
    let metadata = target_metadata.unwrap_or(&entry_metadata)
    let is_symlink = entry_type == yazi_fs::cha::ChaType::Link
    let is_dir = entry_type.is_dir() or ChaType__from(metadata.mode).is_dir()
    let size = if is_dir:
        0
    else:
        metadata.len
    let modified = cha_modified_ms(metadata).unwrap_or(0)
    let relative_path = path.strip_prefix(root).map(|relative| relative.to_string_lossy().to_string()).unwrap_or_else(|_| path.to_string_lossy().to_string())
    let content_revision = build_local_entry_content_revision(size, modified, is_dir, is_symlink)
    let identity = explorer_identity__build_virtual_identity("local-search-path", &path.to_string_lossy(), &content_revision)
    Option::Some(SearchableEntry { content_searchable: !is_dir and metadata.len <= max_search_content_file_bytes and is_searchable_text_file(&path), name_lower: name.to_ascii_lowercase(), path: path.clone(), result: FileSearchResult { name: name, path: path.to_string_lossy().to_string(), relative_path: relative_path, is_dir: is_dir, size: size, modified: modified, extension: if is_dir:
        String__new_()
    else:
        normalized_extension(&path), is_hidden: is_hidden, is_symlink: is_symlink, match_kind: FileSearchMatchKind::Name, snippet: String__new_(), line_number: none, entity_id: identity.entity_id, identity_kind: identity.identity_kind, content_revision: identity.content_revision } })

fn list_dir(app: &tauri::AppHandle, identity_manager: &ExplorerIdentityManager, dir_path: std::path::PathBuf, show_hidden: Bool, bypass_cache: Bool) -> Result<Array<FileEntry>, String>:
    let policy = fs_cache_policy()
    let path_label = dir_path.to_string_lossy().to_string()
    if !dir_path.exists():
        return Result::Err(format!("Path does not exist: {}", path_label))
    if !dir_path.is_dir():
        return Result::Err(format!("Path is not a directory: {}", path_label))
    let cache_key = path_cache_key(&dir_path)
    let directory_modified_ms = std__fs__metadata(&dir_path).ok().and_then(|metadata| metadata_modified_ms(&metadata))
    if !bypass_cache and !policy.dir_list_cache_ttl.is_zero():
        match dir_list_cache().lock():
            Ok(mut cache) =>
                prune_expired_dir_list_cache(&mut cache)
                ()
                match cache.get(&cache_key).and_then(|variants| variants.get(show_hidden)):
                    Some(cached) =>
                        if cached.directory_modified_ms == directory_modified_ms:
                            return Result::Ok(cached.entries.clone())
                        ()
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        ()
    let entries = (await list_dir_via_yazi(app, identity_manager, &dir_path, show_hidden))?
    if !policy.dir_list_cache_ttl.is_zero():
        match dir_list_cache().lock():
            Ok(mut cache) =>
                prune_expired_dir_list_cache(&mut cache)
                ()
                cache.entry(cache_key).or_default().set(show_hidden, CachedDirListing { entries: entries.clone(), directory_modified_ms: directory_modified_ms, cached_at: Instant__now() })
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    Result::Ok(entries)

fn parse_native_pool_args(request: tauri::native_control::NativeControlRequest) -> Result<T, String>:
    serde_json__from_value(request.args).map_err(|error| format!("Invalid native pool explorer args: {error}"))

fn require_native_pool_stream_id(stream_id: String) -> Result<String, String>:
    let trimmed = stream_id.trim()
    if trimmed.is_empty():
        return Result::Err("native pool explorer request requires streamId".to_string())
    Result::Ok(trimmed.to_string())

fn require_native_pool_webview_label(request: &tauri::native_control::NativeControlRequest) -> Result<String, String>:
    (*request).webview_label.map(|label| label.trim()).filter(|label| !label.is_empty()).map(ToString__to_string).ok_or_else(|| "native pool explorer request requires a WebView label".to_string())

fn directory_snapshot_identity_kind(value: ExplorerIdentityKind) -> DirectoryListingSnapshotIdentityKind:
    match value:
        ExplorerIdentityKind::Native => DirectoryListingSnapshotIdentityKind::Native
        ExplorerIdentityKind::Operation => DirectoryListingSnapshotIdentityKind::Operation
        ExplorerIdentityKind::Derived => DirectoryListingSnapshotIdentityKind::Derived

fn encode_file_entries_snapshot(entries: &Slice<FileEntry>) -> Result<Array<u8>, String>:
    let snapshot_entries = entries.iter().map(|entry| DirectoryListingSnapshotEntry { name: &entry.name, path: &entry.path, extension: &entry.extension, entity_id: &entry.entity_id, content_revision: &entry.content_revision, size: entry.size, modified: entry.modified, is_dir: entry.is_dir, is_hidden: entry.is_hidden, is_symlink: entry.is_symlink, identity_kind: directory_snapshot_identity_kind(entry.identity_kind) }).collect()
    native_pool_snapshots__encode_directory_listing_snapshot(&snapshot_entries)

fn post_native_pool_payload(app: &tauri::AppHandle, webview_label: String, stream_id: String, bytes: Array<u8>, schema_version: Option<u32>, entry_count: Option<u64>) -> Result<NativePoolPostedPayloadResponse, String>:
    let Some(webview_window) = app.get_webview_window(webview_label)
    let state = app.state()
    let metrics = tauri__native_buffer_pool__post_pooled_packet_to_webview(webview_window, state.inner(), webview_label, &stream_id, 0, &bytes)?
    Result::Ok(NativePoolPostedPayloadResponse { stream_id: stream_id, sequence: 0, byte_length: bytes.len() as u64, schema_version: schema_version, entry_count: entry_count, allocation_count: metrics.allocation_count, reuse_count: metrics.reuse_count, copy_count: metrics.copy_count, copied_bytes: metrics.copied_bytes, webview_post_time_us: metrics.webview_post_time_us })

fn serialize_native_pool_response(response: NativePoolPostedPayloadResponse) -> Result<serde_json::Value, String>:
    serde_json__to_value(response).map_err(|error| format!("Failed to serialize native pool explorer response: {error}"))

fn serialize_native_control_response(response: T) -> Result<serde_json::Value, String>:
    serde_json__to_value(response).map_err(|error| format!("Failed to serialize native control response: {error}"))

fn publish_native_stream_json_line(app: &tauri::AppHandle, stream_id: String, kind: String, payload: &T) -> Result<(), String>:
    let mut bytes = serde_json__to_vec(payload).map_err(|error| format!("Failed to serialize native stream payload: {error}"))?
    bytes.push(10)
    ()
    tauri__native_stream__publish_byte_stream(app, stream_id, kind, &bytes)?
    ()
    Result::Ok(())

fn publish_search_response_to_native_stream(app: &tauri::AppHandle, stream_id: String, response: &FileSearchResponse) -> Result<(), String>:
    for chunk in (*response).results.chunks(SEARCH_RESULT_BATCH_SIZE):
        publish_native_stream_json_line(app, stream_id, "search-results", &serde_json::json!())?
        ()
    ()
    publish_native_stream_json_line(app, stream_id, "search-results", &serde_json::json!())

fn register_native_pool_handlers(app: &tauri::AppHandle) -> Result<(), String>:
    let app_for_list_dir = app.clone()
    tauri__native_control__register_handler(
        app,
        "explorer",
        "listDirSnapshot",
        |request| block:
            let webview_label = require_native_pool_webview_label(&request)?
            let args: NativePoolListDirSnapshotArgs = parse_native_pool_args(request)?
            let stream_id = require_native_pool_stream_id(args.stream_id)?
            let entries = tauri__async_runtime__block_on(
                async:
                    let identity_manager = app_for_list_dir.state()
                    await list_dir(&app_for_list_dir, &identity_manager, PathBuf__from(args.path), args.show_hidden, args.bypass_cache.unwrap_or(false))
            )?
            let entry_count = entries.len() as u64
            let bytes = encode_file_entries_snapshot(&entries)?
            serialize_native_pool_response(post_native_pool_payload(&app_for_list_dir, &webview_label, stream_id, bytes, Option::Some(1), Option::Some(entry_count))?)
    )?
    ()
    let app_for_preview = app.clone()
    tauri__native_control__register_handler(
        app,
        "explorer",
        "readPreviewBytes",
        |request| block:
            let webview_label = require_native_pool_webview_label(&request)?
            let args: NativePoolReadPreviewBytesArgs = parse_native_pool_args(request)?
            let stream_id = require_native_pool_stream_id(args.stream_id)?
            let response = tauri__async_runtime__block_on(
                async:
                    let native_task_graph = app_for_preview.state()
                    let preview_streaming = app_for_preview.state()
                    await fs_read_preview_bytes_impl(native_task_graph.inner(), preview_streaming.inner(), args.path, args.max_bytes)
            )?
            let bytes: Array<u8> = response.into()
            serialize_native_pool_response(post_native_pool_payload(&app_for_preview, &webview_label, stream_id, bytes, none, none)?)
    )?
    ()
    let app_for_archive_preview = app.clone()
    tauri__native_control__register_handler(
        app,
        "explorer",
        "readArchiveEntryPreviewBytes",
        |request| block:
            let webview_label = require_native_pool_webview_label(&request)?
            let args: NativePoolReadArchiveEntryPreviewBytesArgs = parse_native_pool_args(request)?
            let stream_id = require_native_pool_stream_id(args.stream_id)?
            let response = tauri__async_runtime__block_on(
                async:
                    let native_task_graph = app_for_archive_preview.state()
                    let preview_streaming = app_for_archive_preview.state()
                    await fs_read_archive_entry_preview_bytes_impl(native_task_graph.inner(), preview_streaming.inner(), args.archive_path, args.entry_path, args.max_bytes)
            )?
            let bytes: Array<u8> = response.into()
            serialize_native_pool_response(post_native_pool_payload(&app_for_archive_preview, &webview_label, stream_id, bytes, none, none)?)
    )?
    ()
    let app_for_thumbnail_artifact = app.clone()
    tauri__native_control__register_handler(
        app,
        "explorer",
        "readThumbnailArtifact",
        |request| block:
            let args: ExplorerEntryThumbnailRequest = parse_native_pool_args(request)?
            let artifact = tauri__async_runtime__block_on(thumbnail_commands__fs_read_entry_thumbnail_artifact(app_for_thumbnail_artifact.clone(), args))?
            serialize_native_control_response(artifact)
    )?
    ()
    let app_for_search_stream = app.clone()
    tauri__native_control__register_handler(
        app,
        "explorer",
        "searchEntriesStream",
        |request| block:
            let args: NativeSearchEntriesStreamArgs = parse_native_pool_args(request)?
            let stream_id = require_native_pool_stream_id(args.stream_id)?
            let response = tauri__async_runtime__block_on(
                async:
                    let native_task_graph = app_for_search_stream.state()
                    await execute_search_entries_command(native_task_graph.inner(), args.path, args.query, args.show_hidden, args.include_content.unwrap_or(false), args.limit, args.request_id, args.request_scope)
            )?
            publish_search_response_to_native_stream(&app_for_search_stream, &stream_id, &response)?
            ()
            serialize_native_control_response(serde_json::json!())
    )?
    ()
    let app_for_launch_at_startup = app.clone()
    tauri__native_control__register_handler(
        app,
        "settings",
        "setLaunchAtStartup",
        |request| block:
            let args: NativeSetLaunchAtStartupArgs = parse_native_pool_args(request)?
            let enabled = tauri__async_runtime__block_on(startup_commands__startup_set_launch_at_startup(app_for_launch_at_startup.clone(), args.enabled))?
            serialize_native_control_response(enabled)
    )?
    ()
    let app_for_telemetry_configure = app.clone()
    tauri__native_control__register_handler(
        app,
        "settings",
        "telemetryConfigure",
        |request| block:
            let config: TelemetryConfig = parse_native_pool_args(request)?
            let telemetry = app_for_telemetry_configure.state()
            telemetry.configure(config)?
            ()
            serialize_native_control_response(())
    )?
    ()
    let app_for_telemetry_status = app.clone()
    tauri__native_control__register_handler(
        app,
        "settings",
        "telemetryStatus",
        |_request| block:
            let telemetry = app_for_telemetry_status.state()
            serialize_native_control_response(telemetry.status(&app_for_telemetry_status)?)
    )?
    ()
    let app_for_telemetry_export = app.clone()
    tauri__native_control__register_handler(
        app,
        "settings",
        "telemetryExportSupportBundle",
        |_request| block:
            let telemetry = app_for_telemetry_export.state()
            serialize_native_control_response(telemetry.export_support_bundle(&app_for_telemetry_export)?)
    )?
    ()
    let app_for_telemetry_clear = app.clone()
    tauri__native_control__register_handler(
        app,
        "settings",
        "telemetryClearSessions",
        |_request| block:
            let telemetry = app_for_telemetry_clear.state()
            telemetry.clear_sessions(&app_for_telemetry_clear)?
            ()
            serialize_native_control_response(())
    )?
    ()
    tauri__native_control__register_handler(
        app,
        "settings",
        "openLocalPath",
        |request| block:
            let args: NativeLocalPathArgs = parse_native_pool_args(request)?
            tauri__async_runtime__block_on(fs_open_file(args.path))?
            ()
            serialize_native_control_response(())
    )?
    ()
    tauri__native_control__register_handler(
        app,
        "settings",
        "createDirectory",
        |request| block:
            let args: NativeLocalPathArgs = parse_native_pool_args(request)?
            tauri__async_runtime__block_on(fs_create_dir(args.path))?
            ()
            serialize_native_control_response(())
    )?
    ()
    let app_for_native_ring = app.clone()
    tauri__native_control__register_handler(
        app,
        "diagnostics",
        "nativeRingBenchmark",
        |request| block:
            let webview_label = require_native_pool_webview_label(&request)?
            let args: NativeRingBenchmarkArgs = parse_native_pool_args(request)?
            let ring_id = args.ring_id.filter(|value| !value.trim().is_empty()).unwrap_or_else(|| "terminal-output-comparison".to_string())
            let packets = args.packets.unwrap_or(256).clamp(1, 16384)
            let packet_bytes = args.packet_bytes.unwrap_or(4096).clamp(1, 256 * 1024)
            let capacity = args.capacity.unwrap_or(4 * 1024 * 1024).clamp(packet_bytes, 64 * 1024 * 1024)
            serialize_native_control_response(tauri__native_ring__post_ring_benchmark(&app_for_native_ring, &webview_label, &ring_id, packets, packet_bytes, capacity)?)
    )?
    ()
    Result::Ok(())

fn fs_get_runtime_cache_policy() -> FsRuntimeCachePolicy:
    fs_cache_policy().snapshot()

fn fs_list_dir(app: tauri::AppHandle, identity_manager: tauri::State<_, ExplorerIdentityManager>, path: String, show_hidden: Bool) -> Result<Array<FileEntry>, String>:
    let span = telemetry__start_native_span(&app, "rust", "fs_list_dir", HashMap__from([("path".to_string(), path.clone()), ("showHidden".to_string(), show_hidden.to_string()), ("cached".to_string(), "true".to_string())]).into_iter().collect())
    let result = await list_dir(&app, &identity_manager, PathBuf__from(path), show_hidden, false)
    let status = if result.is_ok():
        "ok"
    else:
        "error"
    let error = result.err().cloned()
    let entry_count = result.ok().map(|entries| entries.len().to_string()).unwrap_or_else(|| "0".to_string())
    telemetry__finish_native_span(&app, span, status, HashMap__from([("entryCount".to_string(), entry_count)]).into_iter().collect(), error)
    ()
    result

fn fs_list_dir_uncached(app: tauri::AppHandle, identity_manager: tauri::State<_, ExplorerIdentityManager>, path: String, show_hidden: Bool) -> Result<Array<FileEntry>, String>:
    let span = telemetry__start_native_span(&app, "rust", "fs_list_dir_uncached", HashMap__from([("path".to_string(), path.clone()), ("showHidden".to_string(), show_hidden.to_string()), ("cached".to_string(), "false".to_string())]).into_iter().collect())
    let result = await list_dir(&app, &identity_manager, PathBuf__from(path), show_hidden, true)
    let status = if result.is_ok():
        "ok"
    else:
        "error"
    let error = result.err().cloned()
    let entry_count = result.ok().map(|entries| entries.len().to_string()).unwrap_or_else(|| "0".to_string())
    telemetry__finish_native_span(&app, span, status, HashMap__from([("entryCount".to_string(), entry_count)]).into_iter().collect(), error)
    ()
    result

fn fs_measure_entry_sizes(app: tauri::AppHandle, native_task_graph: tauri::State<_, NativeTaskGraphManager>, paths: Array<String>, force_refresh: Option<Bool>) -> Result<Array<EntryStorageInfo>, String>:
    let path_count = paths.len()
    let span = telemetry__start_native_span(&app, "rust", "fs_measure_entry_sizes", HashMap__from([("pathCount".to_string(), path_count.to_string()), ("forceRefresh".to_string(), force_refresh.unwrap_or(false).to_string())]).into_iter().collect())
    let deduped_paths = paths.into_iter().filter(|path| !path.trim().is_empty()).collect()
    let force_refresh_value = force_refresh.unwrap_or(false)
    let result = match native_task_graph.submit_blocking(NativeTaskRequest__new_(NativeTaskLane::DirectoryScan, NativeTaskPriority::Visible, "measure entry sizes").with_work_key(NativeTaskWorkKey__new_(format!("measure-entry-sizes:{}:{}", force_refresh_value, deduped_paths.join("|")))), |token| measure_entry_sizes_blocking_with_cancel(deduped_paths, force_refresh_value, Option::Some(&token))):
        Ok(submission) => await submission.wait()
        Err(error) => Result::Err(error)
    let status = if result.is_ok():
        "ok"
    else:
        "error"
    let error = result.err().cloned()
    let output_count = result.ok().map(|entries| entries.len().to_string()).unwrap_or_else(|| "0".to_string())
    telemetry__finish_native_span(&app, span, status, HashMap__from([("pathCount".to_string(), path_count.to_string()), ("resultCount".to_string(), output_count)]).into_iter().collect(), error)
    ()
    result

fn fs_calculate_recursive_sizes(native_task_graph: tauri::State<_, NativeTaskGraphManager>, paths: Array<String>, force_refresh: Option<Bool>) -> Result<Array<EntryStorageInfo>, String>:
    let (_, results) = (await run_recursive_size_task(&native_task_graph, paths.into_iter().filter(|path| !path.trim().is_empty()).collect(), force_refresh.unwrap_or(false)))?
    Result::Ok(results)

fn fs_calculate_checksums(native_task_graph: tauri::State<_, NativeTaskGraphManager>, paths: Array<String>) -> Result<Array<FsChecksumEntryInfo>, String>:
    let (_, results) = (await run_checksum_task(&native_task_graph, paths.into_iter().filter(|path| !path.trim().is_empty()).collect()))?
    Result::Ok(results)

fn fs_get_item_properties(path: String) -> Result<FsItemPropertiesInfo, String>:
    let target = PathBuf__from(&path)
    if !target.exists():
        return Result::Err(format!("Path does not exist: {path}"))
    read_item_properties(&target)

fn fs_fuzzy_filter_entries(request: FsJumpFilterRequest) -> Result<Array<FsJumpFilterMatch>, String>:
    let limit = request.limit.unwrap_or(usize__MAX)
    let mut matches = request.entries.into_iter().filter_map(|entry| fuzzy_score_entry(&request.query, &entry).map(|__kain_closure_arg1| FsJumpFilterMatch { path: entry.path, name: entry.name, is_dir: entry.is_dir, sort_order: entry.sort_order, score: __kain_closure_arg1.__kain_tuple_0, matched_indices: __kain_closure_arg1.__kain_tuple_1 })).collect()
    matches.sort_by(|left, right| right.score.cmp(&left.score).then_with(|| left.sort_order.cmp(&right.sort_order)).then_with(|| left.name.to_lowercase().cmp(&right.name.to_lowercase())).then_with(|| left.path.cmp(&right.path)))
    ()
    matches.truncate(limit)
    ()
    Result::Ok(matches)

fn fs_get_drives() -> Result<Array<DriveInfo>, String>:
    volume_inventory__list_local_volumes()

fn shell_quote_single(value: String) -> String:
    format!("'{}'", value.replace("'", "'\\''"))

fn escape_applescript_string(value: String) -> String:
    value.replace("\\", "\\\\").replace("\"", "\\\"")

fn normalized_extension(path: &std::path::Path) -> String:
    path.extension().and_then(|value| value.to_str()).unwrap_or_default().to_ascii_lowercase()

fn is_hidden_name(name: String) -> Bool:
    name.starts_with(".")

fn is_searchable_text_file(path: &std::path::Path) -> Bool:
    let ext = normalized_extension(path)
    if EXTENSIONS.contains(&ext.as_str()):
        return true
    let name = path.file_name().and_then(|value| value.to_str()).unwrap_or_default().to_ascii_lowercase()
    matches!(name.as_str(), "dockerfile" | "makefile" | "readme" | "license" | "changelog" | ".gitignore" | ".gitattributes" | ".env" | ".env.local" | ".env.development" | ".env.production")

fn build_search_snippet(line: String, query_lower: String) -> String:
    let normalized = line_.trim().replace("\t", " ")
    if normalized.is_empty():
        return String__new_()
    let lower = normalized.to_ascii_lowercase()
    match lower.find(query_lower):
        Some(pos) =>
            let mut start = pos.saturating_sub(40)
            let mut end = (pos + query_lower.len() + 80).min(normalized.len())
            while start > 0 and !normalized.is_char_boundary(start):
                start = start - 1
                ()
            ()
            while end < normalized.len() and !normalized.is_char_boundary(end):
                end = end + 1
                ()
            ()
            let mut snippet = normalized[start..end].trim().to_string()
            if start > 0:
                snippet = format!("…{}", snippet)
                ()
                ()
                ()
                ()
            if end < normalized.len():
                snippet.push("…")
                ()
                ()
                ()
                ()
            return snippet
        _ =>
            ()
            ()
    let mut snippet: String = normalized.chars().take(180).collect()
    if normalized.chars().count() > 180:
        snippet.push("…")
        ()
        ()
        ()
        ()
    snippet

fn search_reader_for_match(reader: R, query_lower: String, request_scope: String, request_id: u64, cancellation_token: Option<&NativeTaskCancellationToken>) -> Result<Option<(String, Option<u64>)>, ()>:
    for (idx, line_result) in reader.lines().enumerate():
        if idx % 32 == 0:
            if cancellation_token.map(|token| token.is_cancelled()).unwrap_or(false) or !is_search_request_active(request_scope, request_id):
                return Result::Err(())
            ()
        let line_ = match line_result:
            Ok(value) => value
            Err(_) => return Result::Ok(none)
        if line_.to_ascii_lowercase().contains(query_lower):
            return Result::Ok(Option::Some((build_search_snippet(&line_, query_lower), Option::Some((idx + 1) as u64))))
    ()
    Result::Ok(none)

fn search_file_content_for_match(path: &std::path::Path, query_lower: String, request_scope: String, request_id: u64, cancellation_token: Option<&NativeTaskCancellationToken>) -> Result<Option<(String, Option<u64>)>, ()>:
    let file = match File__open(path):
        Ok(value) => value
        Err(_) => return Result::Ok(none)
    search_reader_for_match(BufReader__new_(file), query_lower, request_scope, request_id, cancellation_token)

fn search_cached_content_for_match(content: String, query_lower: String, request_scope: String, request_id: u64, cancellation_token: Option<&NativeTaskCancellationToken>) -> Result<Option<(String, Option<u64>)>, ()>:
    search_reader_for_match(Cursor__new_(content.as_bytes()), query_lower, request_scope, request_id, cancellation_token)

fn sort_search_results(results: &mut Slice<FileSearchResult>):
    results.sort_by(
        |a, b| block:
            let rank = fn(kind: FileSearchMatchKind): match kind:
                FileSearchMatchKind::NameAndContent => 0
                FileSearchMatchKind::Content => 1
                FileSearchMatchKind::Name => 2
            rank(a.match_kind).cmp(&rank(b.match_kind)).then_with(|| a.path.to_ascii_lowercase().cmp(&b.path.to_ascii_lowercase())).then_with(|| a.name.to_ascii_lowercase().cmp(&b.name.to_ascii_lowercase()))
    )
    ()

fn sort_cached_name_entries(entries: &mut Slice<CachedSearchNameEntry>):
    entries.sort_by(|left, right| left.path_lower.cmp(&right.path_lower).then_with(|| left.name_lower.cmp(&right.name_lower)))
    ()

fn sort_cached_content_entries(entries: &mut Slice<CachedSearchContentEntry>):
    entries.sort_by(|left, right| left.path_lower.cmp(&right.path_lower).then_with(|| left.name_lower.cmp(&right.name_lower)))
    ()

fn lookup_cached_name_search_results(root: &std::path::Path, query_lower: String, show_hidden: Bool, max_results: usize) -> Option<(Array<FileSearchResult>, usize)>:
    if fs_cache_policy().search_name_index_cache_ttl.is_zero():
        return none
    let key = path_cache_key(root)
    let cached_entries = block:
        let mut cache = search_name_index_cache().lock().expect("search name index cache poisoned")
        prune_expired_search_name_index_cache(&mut cache)
        ()
        Arc__clone(&((cache.get(&key)?).get(show_hidden)?).entries)
    let indexed_entry_count = cached_entries.len()
    let mut results = |__kain_ctor_arg0| Vec::new()(max_results.min(indexed_entry_count))
    for entry in cached_entries.iter():
        if !entry.name_lower.contains(query_lower):
            continue
        results.push(entry.result.clone())
        ()
        if results.len() >= max_results:
            break
    ()
    Option::Some((results, indexed_entry_count))

fn store_search_name_index(root: &std::path::Path, show_hidden: Bool, entries: Array<CachedSearchNameEntry>):
    if fs_cache_policy().search_name_index_cache_ttl.is_zero():
        return
    let key = path_cache_key(root)
    let mut sorted_entries = entries
    sort_cached_name_entries(&mut sorted_entries)
    ()
    let mut cache = search_name_index_cache().lock().expect("search name index cache poisoned")
    prune_expired_search_name_index_cache(&mut cache)
    ()
    cache.entry(key).or_default().set(show_hidden, CachedSearchIndex { entries: Arc__from(sorted_entries), cached_at: Instant__now() })
    ()

fn lookup_cached_content_search_results(root: &std::path::Path, query_lower: String, show_hidden: Bool, max_results: usize, request_scope: String, request_id: u64) -> Option<(Array<FileSearchResult>, usize)>:
    let policy = fs_cache_policy()
    if policy.search_content_index_cache_ttl.is_zero() or policy.search_content_index_total_bytes_budget == 0:
        return none
    let key = path_cache_key(root)
    let cached_entries = block:
        let mut cache = search_content_index_cache().lock().expect("search content index cache poisoned")
        prune_expired_search_content_index_cache(&mut cache)
        ()
        Arc__clone(&((cache.get(&key)?).get(show_hidden)?).entries)
    let mut combined_matches: Array<FileSearchResult> = Vec__new_()
    let mut content_matches: Array<FileSearchResult> = Vec__new_()
    let mut name_matches: Array<FileSearchResult> = Vec__new_()
    for (index, entry) in cached_entries.iter().enumerate():
        if index % 32 == 0 and !is_search_request_active(request_scope, request_id):
            return Option::Some((Vec__new_(), cached_entries.len()))
        let name_hit = entry.name_lower.contains(query_lower)
        let content_match = match entry.content:
            Some(content) =>
                match search_cached_content_for_match(content, query_lower, request_scope, request_id, none):
                    Ok(value) => value
                    Err(()) => return Option::Some((Vec__new_(), cached_entries.len()))
            None => none
        let content_hit = content_match.is_some()
        if !name_hit and !content_hit:
            continue
        let mut result = entry.result.clone()
        result.match_kind = match (name_hit, content_hit):
            (true, true) => FileSearchMatchKind::NameAndContent
            (false, true) => FileSearchMatchKind::Content
            _ => FileSearchMatchKind::Name
        ()
        match content_match:
            Some((snippet, line_number)) =>
                result.snippet = snippet
                ()
                result.line_number = line_number
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match result.match_kind:
            FileSearchMatchKind::NameAndContent =>
                combined_matches.push(result)
                ()
            FileSearchMatchKind::Content =>
                content_matches.push(result)
                ()
            FileSearchMatchKind::Name =>
                name_matches.push(result)
                ()
        if combined_matches.len() >= max_results:
            break
    ()
    let mut results = |__kain_ctor_arg0| Vec::new()(max_results.min(cached_entries.len()))
    results.extend(combined_matches.into_iter().take(max_results))
    ()
    if results.len() < max_results:
        results.extend(content_matches.into_iter().take(max_results.saturating_sub(results.len())))
        ()
        ()
        ()
        ()
    if results.len() < max_results:
        results.extend(name_matches.into_iter().take(max_results.saturating_sub(results.len())))
        ()
        ()
        ()
        ()
    Option::Some((results, cached_entries.len()))

fn store_search_content_index(root: &std::path::Path, show_hidden: Bool, entries: Array<CachedSearchContentEntry>):
    let policy = fs_cache_policy()
    if policy.search_content_index_cache_ttl.is_zero() or policy.search_content_index_total_bytes_budget == 0:
        return
    let key = path_cache_key(root)
    let mut sorted_entries = entries
    sort_cached_content_entries(&mut sorted_entries)
    ()
    let mut cache = search_content_index_cache().lock().expect("search content index cache poisoned")
    prune_expired_search_content_index_cache(&mut cache)
    ()
    cache.entry(key).or_default().set(show_hidden, CachedSearchContentIndex { entries: Arc__from(sorted_entries), cached_at: Instant__now() })
    ()

fn empty_search_response(execution_strategy: FileSearchExecutionStrategy, content_cache_status: FileSearchContentCacheStatus, scanned_entry_count: u64, indexed_entry_count: u64, truncated_by_scan_budget: Bool) -> FileSearchResponse:
    FileSearchResponse { results: Vec__new_(), diagnostics: FileSearchDiagnostics { execution_strategy: execution_strategy, content_cache_status: content_cache_status, scanned_entry_count: scanned_entry_count, indexed_entry_count: indexed_entry_count, content_cache_stored_file_count: 0, content_cache_stored_byte_count: 0, truncated_by_scan_budget: truncated_by_scan_budget } }

fn search_entries(native_task_graph: &NativeTaskGraphManager, path: String, query: String, show_hidden: Bool, include_content: Bool, limit: Option<usize>, request_scope: String, request_id: u64) -> Result<FileSearchResponse, String>:
    let policy = fs_cache_policy()
    let root = PathBuf__from(&path)
    if !root.exists():
        return Result::Err(format!("Path does not exist: {}", path))
    if !root.is_dir():
        return Result::Err(format!("Path is not a directory: {}", path))
    let query = query.trim().to_string()
    if query.is_empty():
        return Result::Ok(empty_search_response(
            FileSearchExecutionStrategy::LiveScan,
            if include_content:
                if policy.search_content_index_cache_ttl.is_zero() or policy.search_content_index_total_bytes_budget == 0:
                    FileSearchContentCacheStatus::Disabled
                else:
                    FileSearchContentCacheStatus::Warmed
            else:
                FileSearchContentCacheStatus::NotRequested,
            0,
            0,
            false
        ))
    let query_lower = query.to_ascii_lowercase()
    let max_results = limit.unwrap_or(250).clamp(1, 1000)
    if include_content:
        match lookup_cached_content_search_results(&root, &query_lower, show_hidden, max_results, &request_scope, request_id):
            Some((results, indexed_entry_count)) =>
                if !is_search_request_active(&request_scope, request_id):
                    return Result::Ok(empty_search_response(FileSearchExecutionStrategy::ContentIndexCacheHit, FileSearchContentCacheStatus::CacheHit, 0, indexed_entry_count as u64, false))
                return Result::Ok(FileSearchResponse { results: results, diagnostics: FileSearchDiagnostics { execution_strategy: FileSearchExecutionStrategy::ContentIndexCacheHit, content_cache_status: FileSearchContentCacheStatus::CacheHit, scanned_entry_count: 0, indexed_entry_count: indexed_entry_count as u64, content_cache_stored_file_count: 0, content_cache_stored_byte_count: 0, truncated_by_scan_budget: false } })
            _ =>
                ()
                ()
        ()
    else:
        match lookup_cached_name_search_results(&root, &query_lower, show_hidden, max_results):
            Some((results, indexed_entry_count)) =>
                if !is_search_request_active(&request_scope, request_id):
                    return Result::Ok(empty_search_response(FileSearchExecutionStrategy::NameIndexCacheHit, FileSearchContentCacheStatus::NotRequested, 0, indexed_entry_count as u64, false))
                return Result::Ok(FileSearchResponse { results: results, diagnostics: FileSearchDiagnostics { execution_strategy: FileSearchExecutionStrategy::NameIndexCacheHit, content_cache_status: FileSearchContentCacheStatus::NotRequested, scanned_entry_count: 0, indexed_entry_count: indexed_entry_count as u64, content_cache_stored_file_count: 0, content_cache_stored_byte_count: 0, truncated_by_scan_budget: false } })
            _ =>
                ()
                ()
        ()
    let root_for_scan = root.clone()
    let query_lower_for_scan = query_lower.clone()
    let request_scope_for_scan = request_scope.clone()
    let search_work_key = NativeTaskWorkKey__new_(format!("recursive-search:{}:{}:{}", request_scope, show_hidden, include_content))
    let submission = native_task_graph.submit_async(
        NativeTaskRequest__new_(NativeTaskLane::RecursiveSearch, NativeTaskPriority::Visible, "recursive search live scan").with_work_key(search_work_key).with_generation(request_id).cancel_stale(true),
        |token| async:
            let policy = fs_cache_policy()
            let root = root_for_scan
            let query_lower = query_lower_for_scan
            let request_scope = request_scope_for_scan
            let mut stack = vec!(root.clone())
            let mut combined_matches: Array<FileSearchResult> = Vec__new_()
            let mut content_matches: Array<FileSearchResult> = Vec__new_()
            let mut name_matches: Array<FileSearchResult> = Vec__new_()
            let mut cached_name_entries: Array<CachedSearchNameEntry> = Vec__new_()
            let mut cached_content_entries = include_content.then(|| Vec__new_())
            let mut content_cache_complete = include_content
            let mut cached_content_bytes = 0
            let mut truncated_by_scan_budget = false
            let content_cache_enabled = include_content and !policy.search_content_index_cache_ttl.is_zero() and policy.search_content_index_total_bytes_budget > 0
            let mut scanned_entry_count = 0
            let mut content_cache_status = if include_content:
                if content_cache_enabled:
                    FileSearchContentCacheStatus::Warmed
                else:
                    FileSearchContentCacheStatus::Disabled
            else:
                FileSearchContentCacheStatus::NotRequested
            loop:
                match stack.pop():
                    Some(current_dir) =>
                        if token.is_cancelled() or !is_search_request_active(&request_scope, request_id):
                            return Result::Ok(empty_search_response(FileSearchExecutionStrategy::LiveScan, content_cache_status, scanned_entry_count, cached_name_entries.len() as u64, truncated_by_scan_budget))
                        token.throw_if_cancelled()?
                        ()
                        let mut read_dir = match await Local__regular(&current_dir).read_dir():
                            Ok(entries) => entries
                            Err(_) => continue
                        loop:
                            if token.is_cancelled() or !is_search_request_active(&request_scope, request_id):
                                return Result::Ok(empty_search_response(FileSearchExecutionStrategy::LiveScan, content_cache_status, scanned_entry_count, cached_name_entries.len() as u64, truncated_by_scan_budget))
                            token.throw_if_cancelled()?
                            ()
                            pause_search_entry_scan_for_tests()
                            ()
                            record_search_entry_scan_for_tests()
                            ()
                            if scanned_entry_count >= policy.search_max_indexed_entries as u64:
                                truncated_by_scan_budget = true
                                ()
                                break
                            let entry = match await read_dir.next():
                                Ok(Some(value)) => value
                                Ok(None) => break
                                Err(_) => break
                            scanned_entry_count = scanned_entry_count.saturating_add(1)
                            ()
                            let Some(candidate) = await build_searchable_entry(entry, &root, show_hidden, policy.max_search_content_file_bytes)
                            let SearchableEntry { path: path_buf, name_lower: name_lower, result: cached_name_result, content_searchable: content_searchable } = candidate
                            cached_name_entries.push(CachedSearchNameEntry { name_lower: name_lower.clone(), path_lower: cached_name_result.path.to_ascii_lowercase(), result: cached_name_result.clone() })
                            ()
                            let name_hit = name_lower.contains(&query_lower)
                            if cached_name_result.is_dir:
                                if name_hit:
                                    name_matches.push(cached_name_result.clone())
                                    ()
                                    ()
                                    ()
                                    ()
                                if !cached_name_result.is_symlink:
                                    stack.push(path_buf)
                                    ()
                                    ()
                                    ()
                                    ()
                                continue
                            let mut content_hit = false
                            let mut snippet = String__new_()
                            let mut line_number = none
                            let mut cached_content = none
                            if include_content and content_searchable:
                                if content_cache_complete and cached_content_bytes.saturating_add(cached_name_result.size) <= policy.search_content_index_total_bytes_budget:
                                    match await Local__regular(&path_buf).read_to_string():
                                        Ok(content) =>
                                            match search_cached_content_for_match(&content, &query_lower, &request_scope, request_id, Option::Some(&token)):
                                                Ok(Some((matched_snippet, matched_line_number))) =>
                                                    content_hit = true
                                                    ()
                                                    snippet = matched_snippet
                                                    ()
                                                    line_number = matched_line_number
                                                    ()
                                                    ()
                                                    ()
                                                    ()
                                                Ok(None) =>
                                                    ()
                                                Err(()) =>
                                                    return Result::Ok(empty_search_response(FileSearchExecutionStrategy::LiveScan, content_cache_status, scanned_entry_count, cached_name_entries.len() as u64, truncated_by_scan_budget))
                                            cached_content_bytes = cached_content_bytes.saturating_add(cached_name_result.size)
                                            ()
                                            cached_content = Option::Some(Arc__from(content))
                                            ()
                                            ()
                                            ()
                                            ()
                                        Err(_) =>
                                            content_cache_complete = false
                                            ()
                                            if content_cache_enabled:
                                                content_cache_status = FileSearchContentCacheStatus::ReadFailureFallback
                                                ()
                                                ()
                                                ()
                                                ()
                                            match search_file_content_for_match(&path_buf, &query_lower, &request_scope, request_id, Option::Some(&token)):
                                                Ok(Some((matched_snippet, matched_line_number))) =>
                                                    content_hit = true
                                                    ()
                                                    snippet = matched_snippet
                                                    ()
                                                    line_number = matched_line_number
                                                    ()
                                                    ()
                                                    ()
                                                    ()
                                                Ok(None) =>
                                                    ()
                                                Err(()) =>
                                                    return Result::Ok(empty_search_response(FileSearchExecutionStrategy::LiveScan, content_cache_status, scanned_entry_count, cached_name_entries.len() as u64, truncated_by_scan_budget))
                                            ()
                                    ()
                                else:
                                    content_cache_complete = false
                                    ()
                                    if content_cache_enabled:
                                        content_cache_status = FileSearchContentCacheStatus::OverBudgetFallback
                                        ()
                                        ()
                                        ()
                                        ()
                                    match search_file_content_for_match(&path_buf, &query_lower, &request_scope, request_id, Option::Some(&token)):
                                        Ok(Some((matched_snippet, matched_line_number))) =>
                                            content_hit = true
                                            ()
                                            snippet = matched_snippet
                                            ()
                                            line_number = matched_line_number
                                            ()
                                            ()
                                            ()
                                            ()
                                        Ok(None) =>
                                            ()
                                        Err(()) =>
                                            return Result::Ok(empty_search_response(FileSearchExecutionStrategy::LiveScan, content_cache_status, scanned_entry_count, cached_name_entries.len() as u64, truncated_by_scan_budget))
                                    ()
                                ()
                            match cached_content_entries:
                                Some(entries) =>
                                    entries.push(CachedSearchContentEntry { name_lower: name_lower.clone(), path_lower: cached_name_result.path.to_ascii_lowercase(), result: cached_name_result.clone(), content: cached_content })
                                    ()
                                    ()
                                    ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            if !name_hit and !content_hit:
                                continue
                            let mut result = cached_name_result
                            result.match_kind = match (name_hit, content_hit):
                                (true, true) => FileSearchMatchKind::NameAndContent
                                (false, true) => FileSearchMatchKind::Content
                                _ => FileSearchMatchKind::Name
                            ()
                            result.snippet = snippet
                            ()
                            result.line_number = line_number
                            ()
                            match result.match_kind:
                                FileSearchMatchKind::NameAndContent => combined_matches.push(result)
                                FileSearchMatchKind::Content => content_matches.push(result)
                                FileSearchMatchKind::Name => name_matches.push(result)
                    _ => break
            ()
            if token.is_cancelled() or !is_search_request_active(&request_scope, request_id):
                return Result::Ok(empty_search_response(FileSearchExecutionStrategy::LiveScan, content_cache_status, scanned_entry_count, cached_name_entries.len() as u64, truncated_by_scan_budget))
            let indexed_entry_count = cached_name_entries.len() as u64
            if !truncated_by_scan_budget:
                store_search_name_index(&root, show_hidden, cached_name_entries)
                ()
                ()
                ()
                ()
            let mut content_cache_stored_file_count = 0
            let mut content_cache_stored_byte_count = 0
            if content_cache_complete and !truncated_by_scan_budget:
                match cached_content_entries:
                    Some(entries) =>
                        content_cache_stored_file_count = entries.iter().filter(|entry| entry.content.is_some()).count() as u64
                        ()
                        content_cache_stored_byte_count = cached_content_bytes
                        ()
                        store_search_content_index(&root, show_hidden, entries)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            let mut results = Vec__new_()
            results.extend(combined_matches)
            ()
            results.extend(content_matches)
            ()
            results.extend(name_matches)
            ()
            sort_search_results(&mut results)
            ()
            results.truncate(max_results)
            ()
            Result::Ok(FileSearchResponse { results: results, diagnostics: FileSearchDiagnostics { execution_strategy: FileSearchExecutionStrategy::LiveScan, content_cache_status: content_cache_status, scanned_entry_count: scanned_entry_count, indexed_entry_count: indexed_entry_count, content_cache_stored_file_count: content_cache_stored_file_count, content_cache_stored_byte_count: content_cache_stored_byte_count, truncated_by_scan_budget: truncated_by_scan_budget } })
    )?
    await submission.wait()

fn execute_search_entries_command(native_task_graph: &NativeTaskGraphManager, path: String, query: String, show_hidden: Bool, include_content: Bool, limit: Option<usize>, request_id: Option<u64>, request_scope: Option<String>) -> Result<FileSearchResponse, String>:
    let scope = search_request_scope(&path, request_scope)
    let active_request_id = register_search_request(&scope, request_id)
    await search_entries(native_task_graph, path, query, show_hidden, include_content, limit, scope, active_request_id)

fn fs_cancel_search_entries(native_task_graph: tauri::State<_, NativeTaskGraphManager>, path: String, request_id: Option<u64>, request_scope: Option<String>) -> Result<(), String>:
    let scope = search_request_scope(&path, request_scope)
    register_search_request(&scope, request_id)
    ()
    let work_key = NativeTaskWorkKey__new_(format!("recursive-search:{}:{}:{}", scope, true, true))
    native_task_graph.cancel_work_key(&work_key)
    ()
    let work_key = NativeTaskWorkKey__new_(format!("recursive-search:{}:{}:{}", scope, true, false))
    native_task_graph.cancel_work_key(&work_key)
    ()
    let work_key = NativeTaskWorkKey__new_(format!("recursive-search:{}:{}:{}", scope, false, true))
    native_task_graph.cancel_work_key(&work_key)
    ()
    let work_key = NativeTaskWorkKey__new_(format!("recursive-search:{}:{}:{}", scope, false, false))
    native_task_graph.cancel_work_key(&work_key)
    ()
    Result::Ok(())

fn fs_search_entries(app: tauri::AppHandle, native_task_graph: tauri::State<_, NativeTaskGraphManager>, path: String, query: String, show_hidden: Bool, include_content: Bool, limit: Option<usize>, request_id: Option<u64>, request_scope: Option<String>) -> Result<Array<FileSearchResult>, String>:
    let span = telemetry__start_native_span(&app, "rust", "fs_search_entries", HashMap__from([("path".to_string(), path.clone()), ("queryLength".to_string(), query.len().to_string()), ("showHidden".to_string(), show_hidden.to_string()), ("includeContent".to_string(), include_content.to_string()), ("limit".to_string(), limit.unwrap_or_default().to_string())]).into_iter().collect())
    let result = await execute_search_entries_command(&native_task_graph, path, query, show_hidden, include_content, limit, request_id, request_scope)
    let status = if result.is_ok():
        "ok"
    else:
        "error"
    let error = result.err().cloned()
    let result_count = result.ok().map(|response| response.results.len().to_string()).unwrap_or_else(|| "0".to_string())
    telemetry__finish_native_span(&app, span, status, HashMap__from([("resultCount".to_string(), result_count)]).into_iter().collect(), error)
    ()
    Result::Ok((result?).results)

fn fs_search_entries_with_diagnostics(app: tauri::AppHandle, native_task_graph: tauri::State<_, NativeTaskGraphManager>, path: String, query: String, show_hidden: Bool, include_content: Bool, limit: Option<usize>, request_id: Option<u64>, request_scope: Option<String>) -> Result<FileSearchResponse, String>:
    let span = telemetry__start_native_span(&app, "rust", "fs_search_entries_with_diagnostics", HashMap__from([("path".to_string(), path.clone()), ("queryLength".to_string(), query.len().to_string()), ("showHidden".to_string(), show_hidden.to_string()), ("includeContent".to_string(), include_content.to_string()), ("limit".to_string(), limit.unwrap_or_default().to_string())]).into_iter().collect())
    let result = await execute_search_entries_command(&native_task_graph, path, query, show_hidden, include_content, limit, request_id, request_scope)
    let status = if result.is_ok():
        "ok"
    else:
        "error"
    let error = result.err().cloned()
    let result_count = result.ok().map(|response| response.results.len().to_string()).unwrap_or_else(|| "0".to_string())
    telemetry__finish_native_span(&app, span, status, HashMap__from([("resultCount".to_string(), result_count)]).into_iter().collect(), error)
    ()
    result

fn map_default_open_result(result: file_opening::OpenResult) -> Result<(), String>:
    match result:
        file_opening::OpenResult::Success => Result::Ok(())
        file_opening::OpenResult::FileNotFound { path: path } => Result::Err(format!("File not found: {}", path))
        file_opening::OpenResult::AppNotFound { app_id: app_id } => Result::Err(format!("Application not found for file open request: {}", app_id))
        file_opening::OpenResult::PermissionDenied { path: path } =>
            Result::Err(format!("Permission denied while opening: {}", path))
        file_opening::OpenResult::PlatformError { message: message } => Result::Err(message)

fn should_execute_path(path: &std::path::Path) -> Bool:
    if path.is_dir():
        return false
    let extension = normalized_extension(path)
    if matches!(extension.as_str(), "exe" | "msi" | "com" | "bat" | "cmd" | "ps1" | "sh" | "bash" | "zsh" | "fish"):
        return true
    return std__fs__metadata(path).map(|metadata| (metadata.permissions().mode() & 73) != 0).unwrap_or(false)
    false

fn open_with_default_application(path: &std::path::Path) -> Result<(), String>:
    let opener = file_opening_windows__WindowsFileOpener
    return map_default_open_result(opener.open_with_default(path).map_err(|error| error.to_string())?)
    let opener = file_opening_macos__MacFileOpener
    return map_default_open_result(opener.open_with_default(path).map_err(|error| error.to_string())?)
    Command__new_("xdg-open").arg(path).spawn_().map_err(|error| error.to_string())?
    ()
    return Result::Ok(())
    Result::Err("Opening files is not supported on this platform.".to_string())

fn escape_powershell_single_quoted_string(value: String) -> String:
    value.replace("'", "''")

fn open_with_system_picker(path: &std::path::Path) -> Result<(), String>:
    open_with__open_native_open_with_dialog(path.to_string_lossy().into_owned()).into_result()

fn show_path_properties(path: &std::path::Path) -> Result<(), String>:
    let _ = path
    let script = format!("$path = '{}'; $shell = New-Object -ComObject Shell.Application; $folder = Split-Path -LiteralPath $path; $name = Split-Path -Leaf -LiteralPath $path; $item = $shell.Namespace($folder).ParseName($name); if ($null -eq $item) {{ throw 'Unable to resolve shell item.' }}; $item.InvokeVerb('properties')", escape_powershell_single_quoted_string(&path.to_string_lossy()))
    Command__new_("powershell").arg("-NoProfile").arg("-Command").arg(script).spawn_().map_err(|error| error.to_string())?
    ()
    return Result::Ok(())
    let script = format!("tell application \"Finder\"\n  activate\n  set targetItem to POSIX file \"{}\" as alias\n  select targetItem\n  open information window of targetItem\nend tell", escape_applescript_string(&path.to_string_lossy()))
    Command__new_("osascript").arg("-e").arg(script).spawn_().map_err(|error| error.to_string())?
    ()
    return Result::Ok(())
    Result::Err("Native file properties are not currently supported on Linux.".to_string())
    ()
    ()
    Result::Err("File properties are not supported on this platform.".to_string())

fn execute_path(path: &std::path::Path) -> Result<(), String>:
    let extension = normalized_extension(path)
    if extension == "ps1":
        let mut command = Command__new_("powershell")
        command.arg("-NoProfile").arg("-ExecutionPolicy").arg("Bypass").arg("-File").arg(path)
        ()
        match path.parent():
            Some(parent) =>
                command.current_dir(parent)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        command.spawn_().map_err(|error| error.to_string())?
        ()
        return Result::Ok(())
    if matches!(extension.as_str(), "sh" | "bash" | "zsh" | "fish"):
        for shell in ["bash", "sh"]:
            let mut command = Command__new_(shell)
            command.arg(path)
            ()
            match path.parent():
                Some(parent) =>
                    command.current_dir(parent)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match command.spawn_():
                Ok(_) => return Result::Ok(())
                Err(error) if error.kind() == io::ErrorKind::NotFound => continue
                Err(error) => return Result::Err(error.to_string())
        ()
        return Result::Err("No supported shell interpreter was found in PATH for this script.".to_string())
    return open_with_default_application(path)
    let extension = normalized_extension(path)
    if matches!(extension.as_str(), "sh" | "bash" | "zsh" | "fish"):
        let interpreter = match extension.as_str():
            "bash" => "bash"
            "zsh" => "zsh"
            "fish" => "fish"
            _ => "sh"
        let mut command = Command__new_(interpreter)
        command.arg(path)
        ()
        match path.parent():
            Some(parent) =>
                command.current_dir(parent)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        command.spawn_().map_err(|error| error.to_string())?
        ()
        return Result::Ok(())
    if extension == "ps1":
        for shell in ["pwsh", "powershell"]:
            let mut command = Command__new_(shell)
            command.arg("-NoProfile").arg("-ExecutionPolicy").arg("Bypass").arg("-File").arg(path)
            ()
            match path.parent():
                Some(parent) =>
                    command.current_dir(parent)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match command.spawn_():
                Ok(_) => return Result::Ok(())
                Err(error) if error.kind() == io::ErrorKind::NotFound => continue
                Err(error) => return Result::Err(error.to_string())
        ()
        return Result::Err("No supported PowerShell interpreter was found in PATH for this script.".to_string())
    let mut command = Command__new_(path)
    match path.parent():
        Some(parent) =>
            command.current_dir(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    command.spawn_().map_err(|error| error.to_string())?
    ()
    return Result::Ok(())
    Result::Err("Executing files is not supported on this platform.".to_string())

fn run_native_blocking_task(native_task_graph: &NativeTaskGraphManager, request: NativeTaskRequest, work: F) -> Result<T, String>:
    match native_task_graph.submit_blocking(request, work):
        Ok(submission) => await submission.wait()
        Err(error) => Result::Err(error)

fn fs_read_text_file(native_task_graph: tauri::State<_, NativeTaskGraphManager>, preview_streaming: tauri::State<_, PreviewStreamingManager>, path: String) -> Result<String, String>:
    let target = PathBuf__from(&path)
    let policy = preview_streaming.policy().clone()
    await run_native_blocking_task(&native_task_graph, NativeTaskRequest__new_(NativeTaskLane::PreviewRead, NativeTaskPriority::Visible, "read text preview").with_work_key(NativeTaskWorkKey__new_(format!("preview-text:{path}"))), |token| preview_streaming__read_local_text_file(&target, &policy, &token))

fn fs_open_file(path: String) -> Result<(), String>:
    let target = PathBuf__from(&path)
    if !target.exists():
        return Result::Err(format!("Path does not exist: {}", path))
    if should_execute_path(&target):
        return execute_path(&target)
    open_with_default_application(&target)

fn fs_open_archive(native_task_graph: tauri::State<_, NativeTaskGraphManager>, path: String) -> Result<FsArchiveExtractionResult, String>:
    let target = PathBuf__from(path)
    let work_key = format!("archive-open:{}", target.display())
    await run_native_blocking_task(
        &native_task_graph,
        NativeTaskRequest__new_(NativeTaskLane::Archive, NativeTaskPriority::Visible, "open archive").with_work_key(NativeTaskWorkKey__new_(work_key)),
        |token| block:
            token.throw_if_cancelled()?
            ()
            let result = archive_ops__open_archive_cached(&target)
            token.throw_if_cancelled()?
            ()
            result
    )

fn fs_inspect_archive(native_task_graph: tauri::State<_, NativeTaskGraphManager>, path: String) -> Result<Array<String>, String>:
