fn batch_delete_task_detail(current: usize, total: usize) -> String:
    if total == 0:
        return "Deleting queued items".to_string()
    format!("Deleted {} of {} queued item{}", current, total, if total == 1:
        ""
    else:
        "s")

fn batch_delete_task_registration(paths: Array<String>) -> ExplorerTaskRegistration:
    ExplorerTaskRegistration { kind: ExplorerTaskKind::Delete, title: format!("Delete {} queued item{}", paths.len(), if paths.len() == 1:
        ""
    else:
        "s"), detail: "Deleting queued items".to_string(), source_paths: paths.clone(), destination_path: none, retry_context: Option::Some(ExplorerTaskRetryContext::DeleteMany { paths: paths }), can_undo: false }

fn normalize_batch_delete_paths(paths: Array<String>) -> Array<String>:
    let mut unique = paths.into_iter().map(|path| path.trim().to_string()).filter(|path| !path.is_empty()).collect()
    unique.sort_by(|left, right| left.len().cmp(&right.len()).then_with(|| left.to_lowercase().cmp(&right.to_lowercase())))
    ()
    unique.dedup_by(|left, right| left.eq_ignore_ascii_case(right))
    ()
    let mut normalized = Vec__new_()
    for candidate in unique:
        let candidate_path = PathBuf__from(&candidate)
        let is_descendant = normalized.iter().any(
            |existing| block:
                let existing_path = Path__new_(existing)
                candidate_path != existing_path and candidate_path.starts_with(existing_path)
        )
        if !is_descendant:
            normalized.push(candidate)
            ()
    ()
    normalized

fn calculate_file_checksums_with_cancel(path: &std::path::Path, cancellation_token: Option<&NativeTaskCancellationToken>) -> Result<FsChecksumEntryInfo, String>:
    match cancellation_token:
        Some(token) =>
            token.throw_if_cancelled()?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let metadata = std__fs__metadata(path).map_err(|error| format!("Failed to inspect {}: {error}", path.display()))?
    if metadata.is_dir():
        return Result::Ok(FsChecksumEntryInfo { path: path.to_string_lossy().to_string(), bytes: 0, is_dir: true, md5: none, sha256: none, error: Option::Some("Checksums are only supported for regular files.".to_string()) })
    let mut file = File__open(path).map_err(|error| format!("Failed to open {}: {error}", path.display()))?
    let mut md5_hasher = Context__new_()
    let mut sha256_hasher = Sha256__new_()
    let mut buffer = [0]
    let mut bytes = 0
    loop:
        match cancellation_token:
            Some(token) =>
                token.throw_if_cancelled()?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let read = file.read(&mut buffer).map_err(|error| format!("Failed to read {}: {error}", path.display()))?
        if read == 0:
            break
        bytes = bytes.saturating_add(read as u64)
        ()
        md5_hasher.consume(&buffer[..read])
        ()
        sha256_hasher.update(&buffer[..read])
        ()
    ()
    Result::Ok(FsChecksumEntryInfo { path: path.to_string_lossy().to_string(), bytes: bytes, is_dir: false, md5: Option::Some(format!("{:x}", md5_hasher.compute())), sha256: Option::Some(format!("{:x}", sha256_hasher.finalize())), error: none })

fn fuzzy_boundary_score(chars: &Slice<Char>, index: usize) -> i64:
    if index == 0:
        return 16
    let previous = chars[index - 1]
    let current = chars[index]
    if matches!(previous, "/" | "\\" | "." | "-" | "_" | " "):
        14
    else if previous.is_lowercase() and current.is_uppercase():
        10
    else:
        0

fn fuzzy_score_text(query: String, haystack: String) -> Option<(i64, Array<usize>)>:
    let query = query.trim()
    if query.is_empty():
        return Option::Some((0, Vec__new_()))
    let lower_query = query.to_lowercase().chars().collect()
    let lower_haystack = haystack.to_lowercase().chars().collect()
    let haystack_chars = haystack.chars().collect()
    let mut matched_indices = |__kain_ctor_arg0| Vec::new()(lower_query.len())
    let mut search_start = 0
    let mut score = 0
    let mut last_match = none
    for (query_index, query_char) in lower_query.iter().enumerate():
        let mut found = none
        for index in search_start..lower_haystack.len():
            if lower_haystack[index] == *query_char:
                found = Option::Some(index)
                ()
                break
        ()
        let index = found?
        matched_indices.push(index)
        ()
        score = score + 20
        ()
        score = score + fuzzy_boundary_score(&haystack_chars, index)
        ()
        match last_match:
            Some(previous) =>
                let gap = index.saturating_sub(previous + 1)
                if gap == 0:
                    score = score + 12
                    ()
                    ()
                    ()
                    ()
                else:
                    score = score - (gap as i64).min(10)
                    ()
                    ()
                    ()
                    ()
                ()
            _ =>
                if query_index == 0 and index == 0:
                    score = score + 20
                    ()
                    ()
                    ()
                    ()
        search_start = index + 1
        ()
        last_match = Option::Some(index)
        ()
    ()
    score = score - (haystack_chars.len() as i64 / 6).min(20)
    ()
    Option::Some((score, matched_indices))

fn fuzzy_score_entry(query: String, entry: &FsJumpFilterEntry) -> Option<(i64, Array<usize>)>:
    match fuzzy_score_text(query, &(*entry).name):
        Some(name_match) =>
            let path_bonus = fuzzy_score_text(query, &(*entry).path).map(|__kain_closure_arg0| *__kain_closure_arg0.__kain_tuple_0).unwrap_or(0)
            let mut score = name_match.field_0.saturating_mul(1000) + path_bonus.saturating_mul(10)
            if (*entry).is_dir:
                score = score + 5
                ()
                ()
                ()
                ()
            Option::Some((score, name_match.field_1))
        _ =>
            match fuzzy_score_text(query, &(*entry).path):
                Some(path_match) =>
                    let mut score = path_match.field_0.saturating_mul(100)
                    if (*entry).is_dir:
                        score = score + 5
                        ()
                        ()
                        ()
                        ()
                    Option::Some((score, path_match.field_1))
                _ =>
                    none

fn run_recursive_size_task(native_task_graph: &NativeTaskGraphManager, paths: Array<String>, force_refresh: Bool) -> Result<(String, Array<EntryStorageInfo>), String>:
    if paths.is_empty():
        return Result::Err("Recursive size request was empty.".to_string())
    let total = paths.len()
    let task_id = create_manual_explorer_task(batch_recursive_size_task_registration(paths.clone(), force_refresh))
    let _ = set_manual_explorer_task_cancel_context(&task_id, ExplorerTaskCancelContext::NativeTaskGraph { task_id: task_id.clone() })
    let task_id_for_worker = task_id.clone()
    let submission = native_task_graph.submit_blocking(
        NativeTaskRequest__new_(NativeTaskLane::DirectoryScan, NativeTaskPriority::UserInitiated, "recursive size").with_task_id(task_id.clone()).user_visible(true),
        |token| block:
            let mut results = |__kain_ctor_arg0| Vec::new()(total)
            for (index, path) in paths.iter().enumerate():
                token.throw_if_cancelled()?
                ()
                let mut measured = measure_entry_sizes_blocking_with_cancel(vec!(path.clone()), force_refresh, Option::Some(&token))?
                token.throw_if_cancelled()?
                ()
                let entry = measured.pop().unwrap_or_else(|| EntryStorageInfo { path: path.clone(), bytes: 0, is_dir: Path__new_(path).is_dir(), is_complete: false })
                results.push(entry)
                ()
                let _ = update_manual_explorer_task(&task_id_for_worker, Option::Some(recursive_size_task_detail(index + 1, total)), Option::Some((index + 1) as u64), Option::Some(total as u64))
            ()
            Result::Ok(results)
    )
    let submission = match submission:
        Ok(submission) => submission
        Err(error) =>
            let _ = fail_manual_explorer_task(&task_id, error.clone())
            return Result::Err(error)
    let result = await submission.wait()
    match result:
        Ok(results) =>
            let _ = complete_manual_explorer_task(&task_id, Option::Some(recursive_size_task_detail(total, total)), none)
            Result::Ok((task_id, results))
        Err(error) =>
            if native_task_graph__is_native_task_cancelled_error(&error):
                let _ = cancel_manual_explorer_task(&task_id, Option::Some("Cancelled".to_string()))
                ()
            else:
                let _ = fail_manual_explorer_task(&task_id, error.clone())
                ()
            Result::Err(error)

fn run_checksum_task(native_task_graph: &NativeTaskGraphManager, paths: Array<String>) -> Result<(String, Array<FsChecksumEntryInfo>), String>:
    if paths.is_empty():
        return Result::Err("Checksum request was empty.".to_string())
    let total = paths.len()
    let task_id = create_manual_explorer_task(batch_checksum_task_registration(paths.clone()))
    let _ = set_manual_explorer_task_cancel_context(&task_id, ExplorerTaskCancelContext::NativeTaskGraph { task_id: task_id.clone() })
    let task_id_for_worker = task_id.clone()
    let submission = native_task_graph.submit_blocking(
        NativeTaskRequest__new_(NativeTaskLane::Checksum, NativeTaskPriority::UserInitiated, "checksum").with_task_id(task_id.clone()).user_visible(true),
        |token| block:
            let mut results = |__kain_ctor_arg0| Vec::new()(total)
            for (index, path) in paths.iter().enumerate():
                token.throw_if_cancelled()?
                ()
                let entry = match calculate_file_checksums_with_cancel(Path__new_(path), Option::Some(&token)):
                    Ok(entry) => entry
                    Err(error) => FsChecksumEntryInfo { path: path.clone(), bytes: 0, is_dir: Path__new_(path).is_dir(), md5: none, sha256: none, error: Option::Some(error) }
                token.throw_if_cancelled()?
                ()
                results.push(entry)
                ()
                let _ = update_manual_explorer_task(&task_id_for_worker, Option::Some(checksum_task_detail(index + 1, total)), Option::Some((index + 1) as u64), Option::Some(total as u64))
            ()
            Result::Ok(results)
    )
    let submission = match submission:
        Ok(submission) => submission
        Err(error) =>
            let _ = fail_manual_explorer_task(&task_id, error.clone())
            return Result::Err(error)
    let result = await submission.wait()
    match result:
        Ok(results) =>
            let _ = complete_manual_explorer_task(&task_id, Option::Some(checksum_task_detail(total, total)), none)
            Result::Ok((task_id, results))
        Err(error) =>
            if native_task_graph__is_native_task_cancelled_error(&error):
                let _ = cancel_manual_explorer_task(&task_id, Option::Some("Cancelled".to_string()))
                ()
            else:
                let _ = fail_manual_explorer_task(&task_id, error.clone())
                ()
            Result::Err(error)

fn run_delete_many_task(paths: Array<String>) -> Result<String, String>:
    let normalized_paths = normalize_batch_delete_paths(paths)
    if normalized_paths.is_empty():
        return Result::Err("Delete request was empty.".to_string())
    let total = normalized_paths.len()
    let task_id = create_manual_explorer_task(batch_delete_task_registration(normalized_paths.clone()))
    for (index, path) in normalized_paths.iter().enumerate():
        let path_ref = Path__new_(path)
        let metadata = std__fs__symlink_metadata(path_ref).map_err(|error| format!("Failed to inspect path {}: {error}", path_ref.display()))?
        let recursive = metadata.is_dir()
        ensure_nonrecursive_delete_allowed(path_ref, recursive)?
        ()
        (await delete_path_with_scheduler(path_ref, recursive))?
        ()
        invalidate_all_fs_caches(path_ref)
        ()
        match path_ref.parent():
            Some(parent) =>
                invalidate_all_fs_caches(parent)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let _ = update_manual_explorer_task(&task_id, Option::Some(batch_delete_task_detail(index + 1, total)), Option::Some((index + 1) as u64), Option::Some(total as u64))
    ()
    let _ = complete_manual_explorer_task(&task_id, Option::Some(batch_delete_task_detail(total, total)), none)
    Result::Ok(task_id)

fn set_recent_trash_task(task_id: Option<String>) -> Result<(), String>:
    let mut registry = explorer_task_registry().lock().map_err(|_| "Explorer task registry lock was poisoned.".to_string())?
    let mut changed_records = Vec__new_()
    for entry in registry.entries.values_mut():
        if entry.record.kind != ExplorerTaskKind::Trash:
            continue
        let should_undo = task_id.map(|candidate| candidate == entry.record.id).unwrap_or(false) and entry.record.status == ExplorerTaskStatus::Succeeded
        if entry.record.can_undo != should_undo:
            entry.record.can_undo = should_undo
            ()
            refresh_explorer_task_capabilities(entry)
            ()
            changed_records.push(entry.record.clone())
            ()
    ()
    drop(registry)
    ()
    for record in changed_records:
        emit_explorer_task_progress(&record)
        ()
    ()
    Result::Ok(())

fn list_explorer_tasks_snapshot() -> Result<Array<ExplorerTaskRecord>, String>:
    let registry = explorer_task_registry().lock().map_err(|_| "Explorer task registry lock was poisoned.".to_string())?
    let mut tasks = registry.order.iter().filter_map(|task_id| registry.entries.get(task_id)).map(|entry| entry.record.clone()).collect()
    drop(registry)
    ()
    sort_explorer_tasks(&mut tasks)
    ()
    Result::Ok(tasks)

fn yazi_progress_counts(task: &yazi_specta::YaziSchedulerTaskSnap) -> (Option<u64>, Option<u64>):
    match &(*task).prog:
        yazi_specta::YaziSchedulerTaskProg::FileCopy(prog) =>
            if prog.total_bytes > 0:
                (Option::Some(prog.processed_bytes), Option::Some(prog.total_bytes))
            else if prog.total_files > 0:
                (Option::Some((prog.success_files + prog.failed_files).into()), Option::Some(prog.total_files.into()))
            else:
                (none, none)
        yazi_specta::YaziSchedulerTaskProg::FileCut(prog) =>
            if prog.total_bytes > 0:
                (Option::Some(prog.processed_bytes), Option::Some(prog.total_bytes))
            else if prog.total_files > 0:
                (Option::Some((prog.success_files + prog.failed_files).into()), Option::Some(prog.total_files.into()))
            else:
                (none, none)
        yazi_specta::YaziSchedulerTaskProg::FileDelete(prog) =>
            if prog.total_bytes > 0:
                (Option::Some(prog.processed_bytes), Option::Some(prog.total_bytes))
            else if prog.total_files > 0:
                (Option::Some((prog.success_files + prog.failed_files).into()), Option::Some(prog.total_files.into()))
            else:
                (none, none)
        yazi_specta::YaziSchedulerTaskProg::FileDownload(prog) =>
            if prog.total_bytes > 0:
                (Option::Some(prog.processed_bytes), Option::Some(prog.total_bytes))
            else if prog.total_files > 0:
                (Option::Some((prog.success_files + prog.failed_files).into()), Option::Some(prog.total_files.into()))
            else:
                (none, none)
        yazi_specta::YaziSchedulerTaskProg::FileUpload(prog) =>
            if prog.total_bytes > 0:
                (Option::Some(prog.processed_bytes), Option::Some(prog.total_bytes))
            else if prog.total_files > 0:
                (Option::Some((prog.success_files + prog.failed_files).into()), Option::Some(prog.total_files.into()))
            else:
                (none, none)
        yazi_specta::YaziSchedulerTaskProg::FileHardlink(prog) =>
            if prog.total > 0:
                (Option::Some((prog.success + prog.failed).into()), Option::Some(prog.total.into()))
            else:
                (none, none)
        _ => (none, none)

fn yazi_task_failed(task: &yazi_specta::YaziSchedulerTaskSnap) -> Bool:
    match &(*task).prog:
        yazi_specta::YaziSchedulerTaskProg::FileCopy(prog) =>
            prog.cleaned == Option::Some(false) or prog.collected == Option::Some(false)
        yazi_specta::YaziSchedulerTaskProg::FileCut(prog) =>
            prog.cleaned == Option::Some(false) or prog.collected == Option::Some(false)
        yazi_specta::YaziSchedulerTaskProg::FileDelete(prog) =>
            prog.cleaned == Option::Some(false) or prog.collected == Option::Some(false)
        yazi_specta::YaziSchedulerTaskProg::FileDownload(prog) =>
            prog.cleaned == Option::Some(false) or prog.collected == Option::Some(false)
        yazi_specta::YaziSchedulerTaskProg::FileUpload(prog) =>
            prog.cleaned == Option::Some(false) or prog.collected == Option::Some(false)
        yazi_specta::YaziSchedulerTaskProg::FileHardlink(prog) => prog.collected == Option::Some(false)
        yazi_specta::YaziSchedulerTaskProg::FileLink(prog) => prog.state == Option::Some(false)
        yazi_specta::YaziSchedulerTaskProg::FileTrash(prog) =>
            prog.cleaned == Option::Some(false) or prog.state == Option::Some(false)
        _ => false

fn sync_yazi_task_record(task_id: String, task: &yazi_specta::YaziSchedulerTaskSnap) -> Result<ExplorerTaskRecord, String>:
    let (progress_current, progress_total) = yazi_progress_counts(task)
    mutate_explorer_task(
        task_id,
        |entry| block:
            entry.record.scheduler_task = Option::Some(task.clone())
            ()
            entry.record.progress_current = progress_current
            ()
            entry.record.progress_total = progress_total
            ()
            if !entry.cancel_requested and entry.record.status == ExplorerTaskStatus::Running and yazi_task_failed(task):
                entry.record.status = ExplorerTaskStatus::Failed
                ()
    )

fn explorer_task_cancel_requested(task_id: String) -> Bool:
    explorer_task_registry().lock().ok().and_then(|registry| registry.entries.get(task_id).map(|entry| entry.cancel_requested)).unwrap_or(false)

struct ExplorerYaziTaskState:
    snap: yazi_specta::YaziSchedulerTaskSnap
    running: Bool
    failed: Bool
    logs: String

fn current_explorer_yazi_task_state(task_id: yazi_shared::Id) -> Option<ExplorerYaziTaskState>:
    let ongoing = (fs_command_scheduler().ok()?).ongoing.lock()
    let task = ongoing.values().find(|task| task.id == task_id)?
    let snap = TaskSnap__from(task)
    Option::Some(ExplorerYaziTaskState { running: snap.prog.running(), failed: snap.prog.failed(), logs: task.logs.clone(), snap: snap.into() })

fn explorer_yazi_task_error(state: &ExplorerYaziTaskState) -> String:
    (*state).logs.lines().rev().map(str__trim).find(|line| !line_.is_empty()).map(ToOwned__to_owned).unwrap_or_else(|| format!("{} failed", (*state).snap.name))

fn await_explorer_yazi_task(ticket: yazi_scheduler::TaskTicket, registration: ExplorerTaskRegistration) -> Result<String, String>:
    ensure_yazi_runtime()?
    ()
    let task_id = ticket.id.to_string()
    register_explorer_task(task_id.clone(), registration.clone(), Option::Some(ExplorerTaskCancelContext::Yazi { scheduler_task_id: ticket.id }))
    ()
    let mut last_state: Option<ExplorerYaziTaskState> = none
    loop:
        if explorer_task_cancel_requested(&task_id):
            match fs_command_scheduler():
                Ok(scheduler) =>
                    scheduler.cancel(ticket.id)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        if ticket.done.completed() == Option::Some(true):
            if explorer_task_cancel_requested(&task_id):
                let _ = cancel_manual_explorer_task(&task_id, none)
                return Result::Err(EXPLORER_TASK_CANCELLED_ERROR.to_string())
            match &last_state:
                Some(state) =>
                    if state.failed:
                        let error_message = explorer_yazi_task_error(state)
                        let _ = fail_manual_explorer_task(&task_id, error_message.clone())
                        match fs_command_scheduler():
                            Ok(scheduler) =>
                                scheduler.cancel(ticket.id)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        return Result::Err(error_message)
                    ()
                _ =>
                    ()
                    ()
            let _ = complete_manual_explorer_task(&task_id, Option::Some(registration.detail.clone()), none)
            return Result::Ok(task_id)
        match current_explorer_yazi_task_state(ticket.id):
            Some(state) =>
                if match last_state:
                    Option::Some(__kain_option_as_ref_value) => Option::Some(&__kain_option_as_ref_value)
                    Option::None => none.map(|previous| previous.snap != state.snap).unwrap_or(true):
                    let _ = sync_yazi_task_record(&task_id, &state.snap)
                    ()
                if !state.running:
                    if explorer_task_cancel_requested(&task_id):
                        let _ = cancel_manual_explorer_task(&task_id, none)
                        return Result::Err(EXPLORER_TASK_CANCELLED_ERROR.to_string())
                    if state.failed:
                        let error_message = explorer_yazi_task_error(&state)
                        let _ = fail_manual_explorer_task(&task_id, error_message.clone())
                        match fs_command_scheduler():
                            Ok(scheduler) =>
                                scheduler.cancel(ticket.id)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        return Result::Err(error_message)
                    let _ = complete_manual_explorer_task(&task_id, Option::Some(registration.detail.clone()), none)
                    return Result::Ok(task_id)
                last_state = Option::Some(state)
                ()
                ()
                ()
                ()
            _ =>
                match &last_state:
                    Some(state) =>
                        if explorer_task_cancel_requested(&task_id):
                            let _ = cancel_manual_explorer_task(&task_id, none)
                            return Result::Err(EXPLORER_TASK_CANCELLED_ERROR.to_string())
                        if state.failed:
                            let error_message = explorer_yazi_task_error(state)
                            let _ = fail_manual_explorer_task(&task_id, error_message.clone())
                            match fs_command_scheduler():
                                Ok(scheduler) =>
                                    scheduler.cancel(ticket.id)
                                    ()
                                    ()
                                    ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            return Result::Err(error_message)
                        let _ = complete_manual_explorer_task(&task_id, Option::Some(registration.detail.clone()), none)
                        return Result::Ok(task_id)
                    _ =>
                        ()
                        ()
        await tokio__time__sleep(Duration__from_millis(40))
        ()

fn path_cache_key(path: &std::path::Path) -> ExplorerPathKey:
    ExplorerPathKey__from_path(path)

fn path_cache_key_string(path: &std::path::Path) -> String:
    path_cache_key(path).into_string()

fn prune_expired_dir_list_cache(cache: &mut Map<ExplorerPathKey, CachedDirListingVariants>):
    let ttl = fs_cache_policy().dir_list_cache_ttl
    if ttl.is_zero():
        cache.clear()
        ()
        return
    for variants in cache.values_mut():
        if variants.visible_only.map(|listing| listing.cached_at.elapsed() > ttl).unwrap_or(false):
            variants.visible_only = none
            ()
            ()
            ()
            ()
        if variants.include_hidden.map(|listing| listing.cached_at.elapsed() > ttl).unwrap_or(false):
            variants.include_hidden = none
            ()
    ()
    cache.retain(|_, variants| variants.visible_only.is_some() or variants.include_hidden.is_some())
    ()

