fn fs_get_home_dir() -> Result<String, String>:
    dirs__home_dir().map(|p| p.to_string_lossy().to_string()).ok_or_else(|| "Could not determine home directory".to_string())

fn current_process_is_elevated() -> Result<Bool, String>:
    let mut token_handle = std__ptr__null_mut()
    if windows_sys::Win32::System::Threading::OpenProcessToken(windows_sys::Win32::System::Threading::GetCurrentProcess(), windows_sys::Win32::Security::TOKEN_QUERY, &mut token_handle) == 0:
        return Result::Err(Error__last_os_error().to_string())
    struct TokenGuard:
        field_0: isize

    impl Drop for TokenGuard:
        fn drop(_self: &mut TokenGuard):
            windows_sys::Win32::Foundation::CloseHandle((*_self).field_0 as _)
            ()


    let token_guard = TokenGuard(token_handle as isize)
    let mut elevation = windows_sys::Win32::Security::TOKEN_ELEVATION { TokenIsElevated: 0 }
    let mut bytes_returned = 0
    if windows_sys::Win32::Security::GetTokenInformation(token_handle, windows_sys::Win32::Security::TokenElevation, &mut elevation as PtrMut<_> as PtrMut<_>, std__mem__size_of() as u32, &mut bytes_returned) == 0:
        return Result::Err(Error__last_os_error().to_string())
    Result::Ok(elevation.TokenIsElevated != 0)

fn fs_is_process_elevated() -> Result<Bool, String>:
    return current_process_is_elevated()
    Result::Ok(false)

