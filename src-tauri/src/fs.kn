fn fs_materialize_archive_entry(native_task_graph: tauri::State<_, NativeTaskGraphManager>, request: FsArchiveEntryMaterializationRequest) -> Result<FsArchiveEntryMaterializationResult, String>:
    let work_key = format!("archive-materialize:{}:{}:{}:{:?}", request.archive_path, request.entry_path, request.entry_is_dir, request.mode)
    await run_native_blocking_task(
        &native_task_graph,
        NativeTaskRequest__new_(NativeTaskLane::Archive, NativeTaskPriority::UserInitiated, "materialize archive entry").with_work_key(NativeTaskWorkKey__new_(work_key)),
        |token| block:
