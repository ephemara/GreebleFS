fn fs_extract_archive(native_task_graph: tauri::State<_, NativeTaskGraphManager>, request: FsArchiveExtractionRequest) -> Result<FsArchiveExtractionResult, String>:
    if request.mode == FsArchiveExtractionMode::OpenCached:
        return Result::Err("Use fs_open_archive for cached archive opening.".to_string())
    let (_, result) = (await run_archive_extraction_task_with_result(&native_task_graph, request))?
    Result::Ok(result)

fn fs_open_with_dialog(path: String) -> Result<(), String>:
    let target = PathBuf__from(&path)
    if !target.exists():
        return Result::Err(format!("Path does not exist: {}", path))
    open_with_system_picker(&target)

fn fs_open_as_admin(path: String) -> Result<(), String>:
    let verb: Array<u16> = OsStr__new_("runas").encode_wide().chain(std__iter__once(0)).collect()
    let file: Array<u16> = OsStr__new_(&path).encode_wide().chain(std__iter__once(0)).collect()
    let result = windows_sys::Win32::UI::Shell::ShellExecuteW(std__ptr__null_mut(), verb.as_ptr(), file.as_ptr(), std__ptr__null(), std__ptr__null(), 1)
    if result as isize <= 32:
        return Result::Err(format!("ShellExecuteW failed with code: {}", result as isize))
    return Result::Ok(())
    let display = std__env__var_("DISPLAY").unwrap_or_default()
    let xauthority = std__env__var_("XAUTHORITY").unwrap_or_default()
    let runtime_dir = std__env__var_("XDG_RUNTIME_DIR").unwrap_or_default()
    let command = format!("DISPLAY={} XAUTHORITY={} XDG_RUNTIME_DIR={} xdg-open {}", shell_quote_single(&display), shell_quote_single(&xauthority), shell_quote_single(&runtime_dir), shell_quote_single(&path))
    Command__new_("pkexec").arg("sh").arg("-lc").arg(command).spawn_().map_err(|e| e.to_string())?
    ()
    return Result::Ok(())
    let shell_command = format!("open {}", shell_quote_single(&path))
    let script = format!("do shell script \"{}\" with administrator privileges", escape_applescript_string(&shell_command))
    Command__new_("osascript").arg("-e").arg(script).spawn_().map_err(|e| e.to_string())?
    ()
    return Result::Ok(())
    Result::Err("Admin elevation is not implemented for this operating system.".to_string())

fn fs_reveal_in_explorer(path: String) -> Result<(), String>:
    Command__new_("explorer").arg("/select,").arg(&path).spawn_().map_err(|e| e.to_string())?
    ()
    return Result::Ok(())
    Command__new_("open").arg("-R").arg(&path).spawn_().map_err(|e| e.to_string())?
    ()
    return Result::Ok(())
    Command__new_("xdg-open").arg(Path__new_(&path).parent().unwrap_or(Path__new_("/"))).spawn_().map_err(|e| e.to_string())?
    ()
    return Result::Ok(())

fn fs_show_item_properties(path: String) -> Result<(), String>:
    let target = PathBuf__from(&path)
    if !target.exists():
        return Result::Err(format!("Path does not exist: {}", path))
    show_path_properties(&target)

fn fs_delete(path: String, recursive: Bool) -> Result<(), String>:
    let p = Path__new_(&path)
    ensure_nonrecursive_delete_allowed(p, recursive)?
    ()
    (await delete_path_with_scheduler(p, recursive))?
    ()
    invalidate_all_fs_caches(p)
    ()
    match p.parent():
        Some(parent) =>
            invalidate_all_fs_caches(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn fs_delete_many(paths: Array<String>) -> Result<(), String>:
    (await run_delete_many_task(paths))?
    ()
    Result::Ok(())

fn fs_rename(app: tauri::AppHandle, identity_manager: tauri::State<_, ExplorerIdentityManager>, old_path: String, new_path: String) -> Result<(), String>:
    let old_path_ref = Path__new_(&old_path)
    let new_path_ref = Path__new_(&new_path)
    let continuity_entity_id = std__fs__symlink_metadata(old_path_ref).ok().and_then(
        |metadata| block:
            let is_symlink = metadata.file_type().is_symlink()
            let is_dir = metadata.is_dir()
            let size = if is_dir:
                0
            else:
                metadata.len()
            let modified = metadata_modified_ms(&metadata).unwrap_or(0)
            let content_revision = build_local_entry_content_revision(size, modified, is_dir, is_symlink)
            explorer_identity__prepare_move_operation_continuity(&app, &identity_manager, old_path_ref, &content_revision).ok().flatten()
    )
    std__fs__rename(old_path_ref, new_path_ref).map_err(|error| error.to_string())?
    ()
    let _ = explorer_identity__apply_move_operation_continuity(&app, &identity_manager, old_path_ref, new_path_ref, continuity_entity_id)
    invalidate_all_fs_caches(old_path_ref)
    ()
    invalidate_all_fs_caches(new_path_ref)
    ()
    match old_path_ref.parent():
        Some(parent) =>
            invalidate_all_fs_caches(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match new_path_ref.parent():
        Some(parent) =>
            invalidate_all_fs_caches(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    return Result::Ok(())
    ensure_yazi_runtime()?
    ()
    let result = (await yazi_vfs__provider__rename(UrlBuf__from(old_path_ref), UrlBuf__from(new_path_ref))).map_err(|error| error.to_string())
    if result.is_ok():
        let _ = explorer_identity__apply_move_operation_continuity(&app, &identity_manager, old_path_ref, new_path_ref, continuity_entity_id)
        invalidate_all_fs_caches(old_path_ref)
        ()
        invalidate_all_fs_caches(new_path_ref)
        ()
        match old_path_ref.parent():
            Some(parent) =>
                invalidate_all_fs_caches(parent)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match new_path_ref.parent():
            Some(parent) =>
                invalidate_all_fs_caches(parent)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    result

fn fs_move(app: tauri::AppHandle, identity_manager: tauri::State<_, ExplorerIdentityManager>, src: String, dst: String) -> Result<(), String>:
    let src_path = Path__new_(&src)
    let dst_path = Path__new_(&dst)
    validate_transfer_destination(src_path, dst_path, FileTransferOperation::Move)?
    ()
    let continuity_entity_id = std__fs__symlink_metadata(src_path).ok().and_then(
        |metadata| block:
            let is_symlink = metadata.file_type().is_symlink()
            let is_dir = metadata.is_dir()
            let size = if is_dir:
                0
            else:
                metadata.len()
            let modified = metadata_modified_ms(&metadata).unwrap_or(0)
            let content_revision = build_local_entry_content_revision(size, modified, is_dir, is_symlink)
            explorer_identity__prepare_move_operation_continuity(&app, &identity_manager, src_path, &content_revision).ok().flatten()
    )
    (await move_path(src_path, dst_path, true))?
    ()
    let _ = explorer_identity__apply_move_operation_continuity(&app, &identity_manager, src_path, dst_path, continuity_entity_id)
    invalidate_all_fs_caches(src_path)
    ()
    invalidate_all_fs_caches(dst_path)
    ()
    match src_path.parent():
        Some(parent) =>
            invalidate_all_fs_caches(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match dst_path.parent():
        Some(parent) =>
            invalidate_all_fs_caches(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn fs_copy(src: String, dst: String) -> Result<(), String>:
    let src_path = Path__new_(&src)
    let dst_path = Path__new_(&dst)
    validate_transfer_destination(src_path, dst_path, FileTransferOperation::Copy)?
    ()
    (await copy_path(src_path, dst_path, true))?
    ()
    invalidate_all_fs_caches(dst_path)
    ()
    match dst_path.parent():
        Some(parent) =>
            invalidate_all_fs_caches(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(())

fn fs_plan_transfer_items(target_dir: String, sources: Array<String>, operation: FileTransferOperation) -> Result<Array<FileTransferCollision>, String>:
    let target_dir_path = Path__new_(&target_dir)
    if !target_dir_path.exists():
        return Result::Err(format!("Target directory does not exist: {}", target_dir))
    if !target_dir_path.is_dir():
        return Result::Err(format!("Target path is not a directory: {}", target_dir))
    let mut collisions = Vec__new_()
    for source in sources:
        let source_path = PathBuf__from(&source)
        if !source_path.exists():
            return Result::Err(format!("Source path does not exist: {}", source))
        let Some(file_name) = source_path.file_name()
        let preferred_destination = target_dir_path.join(file_name)
        if preferred_destination == source_path:
            continue
        if !preferred_destination.exists():
            continue
        collisions.push(FileTransferCollision { source_path: source_path.to_string_lossy().to_string(), source_name: file_name.to_string_lossy().to_string(), destination_path: preferred_destination.to_string_lossy().to_string(), operation: operation, destination_exists: true, destination_is_dir: preferred_destination.is_dir() })
        ()
    ()
    Result::Ok(collisions)

fn fs_transfer_items(app: tauri::AppHandle, identity_manager: tauri::State<_, ExplorerIdentityManager>, target_dir: String, sources: Array<String>, operation: FileTransferOperation, collision_policy: Option<FileTransferCollisionPolicy>) -> Result<Array<FileTransferResult>, String>:
    let target_dir_path = Path__new_(&target_dir)
    if !target_dir_path.exists():
        return Result::Err(format!("Target directory does not exist: {}", target_dir))
    if !target_dir_path.is_dir():
        return Result::Err(format!("Target path is not a directory: {}", target_dir))
    let mut results = Vec__new_()
    let resolved_collision_policy = collision_policy.unwrap_or(FileTransferCollisionPolicy::KeepBoth)
    for source in sources:
        let source_path = PathBuf__from(&source)
        if !source_path.exists():
            return Result::Err(format!("Source path does not exist: {}", source))
        let Some(file_name) = source_path.file_name()
        let preferred_destination = target_dir_path.join(file_name)
        let destination = resolve_transfer_destination(preferred_destination.clone(), operation, &source_path, resolved_collision_policy)
        if source_path == destination:
            continue
        if resolved_collision_policy == FileTransferCollisionPolicy::Skip and preferred_destination.exists() and preferred_destination != source_path:
            results.push(build_transfer_result_from_source(&app, &identity_manager, &source_path, &preferred_destination, operation, resolved_collision_policy, FileTransferDisposition::SkippedExisting)?)
            ()
            continue
        validate_transfer_destination(&source_path, &destination, operation)?
        ()
        let continuity_entity_id = if operation == FileTransferOperation::Move:
            let metadata = std__fs__symlink_metadata(&source_path).map_err(|error| format!("Failed to inspect transfer source '{}': {error}", source_path.display()))?
            let is_symlink = metadata.file_type().is_symlink()
            let is_dir = metadata.is_dir()
            let size = if is_dir:
                0
            else:
                metadata.len()
            let modified = metadata_modified_ms(&metadata).unwrap_or(0)
            let content_revision = build_local_entry_content_revision(size, modified, is_dir, is_symlink)
            explorer_identity__prepare_move_operation_continuity(&app, &identity_manager, &source_path, &content_revision)?
        else:
            none
        let operation_result = match operation:
            FileTransferOperation::Copy => await copy_path(&source_path, &destination, true)
            FileTransferOperation::Move => await move_path(&source_path, &destination, true)
        match operation_result:
            Err(error) =>
                return Result::Err(error)
            _ =>
                ()
                ()
        if operation == FileTransferOperation::Move:
            let _ = explorer_identity__apply_move_operation_continuity(&app, &identity_manager, &source_path, &destination, continuity_entity_id)
            ()
        results.push(build_transfer_result_from_destination(&app, &identity_manager, &source_path, &destination, operation, resolved_collision_policy, FileTransferDisposition::Transferred)?)
        ()
    ()
    for result in &results:
        invalidate_all_fs_caches(Path__new_(&result.source_path))
        ()
        invalidate_all_fs_caches(Path__new_(&result.destination_path))
        ()
        match Path__new_(&result.source_path).parent():
            Some(parent) =>
                invalidate_all_fs_caches(parent)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match Path__new_(&result.destination_path).parent():
            Some(parent) =>
                invalidate_all_fs_caches(parent)
                ()
            _ => ()
    ()
    Result::Ok(results)

fn fs_list_explorer_tasks() -> Result<Array<ExplorerTaskRecord>, String>:
    list_explorer_tasks_snapshot()

fn should_clear_explorer_task(scope: ExplorerTaskHistoryClearScope, status: ExplorerTaskStatus) -> Bool:
    match scope:
        ExplorerTaskHistoryClearScope::Completed => status == ExplorerTaskStatus::Succeeded
        ExplorerTaskHistoryClearScope::Failed =>
            matches!(status, ExplorerTaskStatus::Failed | ExplorerTaskStatus::Cancelled)
        ExplorerTaskHistoryClearScope::Finished => status != ExplorerTaskStatus::Running

fn fs_clear_explorer_task_history(scope: ExplorerTaskHistoryClearScope) -> Result<(), String>:
    let mut registry = explorer_task_registry().lock().map_err(|_| "Explorer task registry lock was poisoned.".to_string())?
    let retained_task_ids = registry.order.iter().filter_map(
        |task_id| registry.entries.get(task_id).and_then(
            |entry| if should_clear_explorer_task(scope, entry.record.status):
                none
            else:
                Option::Some(task_id.clone())
        )
    ).collect()
    registry.order = retained_task_ids
    ()
    registry.entries.retain(|_, entry| !should_clear_explorer_task(scope, entry.record.status))
    ()
    Result::Ok(())

fn retry_context_for_task(task_id: String) -> Result<ExplorerTaskRetryContext, String>:
    let registry = explorer_task_registry().lock().map_err(|_| "Explorer task registry lock was poisoned.".to_string())?
    let entry = registry.entries.get(task_id).ok_or_else(|| format!("Explorer task not found: {task_id}"))?
    if !entry.record.can_retry:
        return Result::Err(format!("Explorer task is not retryable: {task_id}"))
    entry.retry_context.clone().ok_or_else(|| format!("Explorer task has no retry context: {task_id}"))

fn fs_retry_explorer_task(app: tauri::AppHandle, native_task_graph: tauri::State<_, NativeTaskGraphManager>, task_id: String) -> Result<ExplorerTaskRecord, String>:
    let retry_context = retry_context_for_task(&task_id)?
    let next_task_id = match retry_context:
        ExplorerTaskRetryContext::Copy { source_path: source_path, destination_path: destination_path } => (await copy_path(Path__new_(&source_path), Path__new_(&destination_path), true))?
        ExplorerTaskRetryContext::Move { source_path: source_path, destination_path: destination_path } => (await move_path(Path__new_(&source_path), Path__new_(&destination_path), true))?
        ExplorerTaskRetryContext::Delete { path: path, recursive: recursive } =>
            let path_ref = Path__new_(&path)
            ensure_nonrecursive_delete_allowed(path_ref, recursive)?
            ()
            (await delete_path_with_scheduler(path_ref, recursive))?
        ExplorerTaskRetryContext::DeleteMany { paths: paths } => (await run_delete_many_task(paths))?
        ExplorerTaskRetryContext::BatchRename { items: items } =>
            (await explorer_pro_commands__run_batch_rename_task(items))?
        ExplorerTaskRetryContext::DuplicateScan { root_path: root_path } =>
            explorer_pro_commands__start_duplicate_scan_task(app, root_path)?
        ExplorerTaskRetryContext::RecursiveSize { paths: paths, force_refresh: force_refresh } =>
            ((await run_recursive_size_task(&native_task_graph, paths, force_refresh))?).field_0
        ExplorerTaskRetryContext::Checksum { paths: paths } =>
            ((await run_checksum_task(&native_task_graph, paths))?).field_0
        ExplorerTaskRetryContext::ArchiveExtraction { request: request } =>
            (await run_archive_extraction_task(&native_task_graph, request))?
        ExplorerTaskRetryContext::AudioTransform { request: request } =>
            ((await audio_commands__audio_export_transform(app, request))?).task_id
        ExplorerTaskRetryContext::AudioBatchProcess { request: request } =>
            ((await audio_commands__audio_batch_process(app, request))?).task_id
    let tasks = list_explorer_tasks_snapshot()?
    tasks.into_iter().find(|record| record.id == next_task_id).ok_or_else(|| format!("Retried explorer task was not registered: {next_task_id}"))

fn cancel_context_for_task(task_id: String) -> Result<ExplorerTaskCancelContext, String>:
    let mut registry = explorer_task_registry().lock().map_err(|_| "Explorer task registry lock was poisoned.".to_string())?
    let entry = registry.entries.get_mut(task_id).ok_or_else(|| format!("Explorer task not found: {task_id}"))?
    if !entry.record.can_cancel:
        return Result::Err(format!("Explorer task is not cancellable: {task_id}"))
    entry.cancel_requested = true
    ()
    entry.cancel_context.clone().ok_or_else(|| format!("Explorer task has no cancel context: {task_id}"))

fn fs_cancel_explorer_task(native_task_graph: tauri::State<_, NativeTaskGraphManager>, task_id: String) -> Result<ExplorerTaskRecord, String>:
    let cancel_context = cancel_context_for_task(&task_id)?
    match cancel_context:
        ExplorerTaskCancelContext::Yazi { scheduler_task_id: scheduler_task_id } =>
            match fs_command_scheduler():
                Ok(scheduler) =>
                    scheduler.cancel(scheduler_task_id)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        ExplorerTaskCancelContext::NativeTaskGraph { task_id: task_id } =>
            native_task_graph.cancel(&task_id)
            ()
            ()
            ()
            ()
        ExplorerTaskCancelContext::DuplicateScan { scan_id: scan_id } =>
            explorer_pro_commands__cancel_duplicate_scan_task(&scan_id)?
            ()
            ()
            ()
            ()
        ExplorerTaskCancelContext::AudioOperation { operation_id: operation_id } =>
            audio_commands__cancel_audio_task(&operation_id)?
            ()
            ()
            ()
            ()
    cancel_manual_explorer_task(&task_id, none)

fn ensure_nonrecursive_delete_allowed(path: &std::path::Path, recursive: Bool) -> Result<(), String>:
    if recursive or !path.is_dir():
        return Result::Ok(())
    let mut entries = std__fs__read_dir(path).map_err(|error| error.to_string())?
    let has_entries = (entries.next().transpose().map_err(|error| error.to_string())?).is_some()
    if has_entries:
        return Result::Err(format!("Directory is not empty: {}", path.display()))
    Result::Ok(())

fn validate_transfer_destination(source_path: &std::path::Path, destination: &std::path::Path, operation: FileTransferOperation) -> Result<(), String>:
    if !source_path.is_dir():
        return Result::Ok(())
    let normalized_source = if source_path.is_absolute():
        source_path.to_path_buf()
    else:
        std__env__current_dir().map(|cwd| cwd.join(source_path)).unwrap_or_else(|_| source_path.to_path_buf())
    let normalized_destination = if destination.is_absolute():
        destination.to_path_buf()
    else:
        std__env__current_dir().map(|cwd| cwd.join(destination)).unwrap_or_else(|_| destination.to_path_buf())
    if normalized_destination.starts_with(&normalized_source):
        return Result::Err(format!("Cannot {:?} a folder into itself or one of its descendants: {} -> {}", operation, source_path.display(), destination.display()))
    Result::Ok(())

fn ensure_destination_parent_dir(path: &std::path::Path) -> Result<(), String>:
    let Some(parent) = path.parent()
    if parent.as_os_str().is_empty():
        return Result::Ok(())
    std__fs__create_dir_all(parent).map_err(|error| format!("Failed to create destination parent directory {}: {error}", parent.display()))?
    ()
    return Result::Ok(())
    ensure_yazi_runtime()?
    ()
    (await yazi_vfs__provider__create_dir_all(UrlBuf__from(parent))).map_err(|error| format!("Failed to create destination parent directory {} via Yazi VFS: {error}", parent.display()))

fn yazi_task_registration(kind: ExplorerTaskKind, title: String, detail: String, source_paths: Array<String>, destination_path: Option<String>, retry_context: Option<ExplorerTaskRetryContext>) -> ExplorerTaskRegistration:
    ExplorerTaskRegistration { kind: kind, title: title, detail: detail, source_paths: source_paths, destination_path: destination_path, retry_context: retry_context, can_undo: false }

fn archive_task_initial_output_path(request: &FsArchiveExtractionRequest) -> Option<String>:
    match (*request).mode:
        FsArchiveExtractionMode::ExtractHere => Path__new_(&(*request).archive_path).parent().map(|path| path.to_string_lossy().into_owned())
        FsArchiveExtractionMode::ExtractToDirectory => (*request).target_directory.clone()
        FsArchiveExtractionMode::OpenCached | FsArchiveExtractionMode::ExtractToNewFolder => none

fn archive_task_registration(request: &FsArchiveExtractionRequest, output_path: Option<String>) -> ExplorerTaskRegistration:
    let archive_path = Path__new_(&(*request).archive_path)
    let archive_label = task_path_label(archive_path)
    let (title_prefix, detail_suffix) = match (*request).mode:
        FsArchiveExtractionMode::OpenCached => ("Open", "cached contents")
        FsArchiveExtractionMode::ExtractHere => ("Extract", "here")
        FsArchiveExtractionMode::ExtractToDirectory => ("Extract", "to selected folder")
        FsArchiveExtractionMode::ExtractToNewFolder => ("Extract", "to a new folder")
    let detail = match output_path:
        Option::Some(__kain_option_as_ref_value) => Option::Some(&__kain_option_as_ref_value)
        Option::None => none.map(|path| format!("{} -> {}", archive_path.display(), path)).unwrap_or_else(|| format!("{} -> {}", archive_path.display(), detail_suffix))
    ExplorerTaskRegistration { kind: ExplorerTaskKind::ExtractArchive, title: format!("{title_prefix} {archive_label}"), detail: detail, source_paths: vec!((*request).archive_path.clone()), destination_path: output_path, retry_context: Option::Some(ExplorerTaskRetryContext::ArchiveExtraction { request: request.clone() }), can_undo: false }

fn archive_task_success_detail(result: &FsArchiveExtractionResult) -> String:
    if (*result).reused_cached_output:
        return format!("Reused extracted contents at {}", (*result).output_path)
    let item_label = if (*result).extracted_entry_count == 1:
        "item"
    else:
        "items"
    format!("Extracted {} {} to {}", (*result).extracted_entry_count, item_label, (*result).output_path)

fn complete_archive_extraction_task(task_id: String, result: &FsArchiveExtractionResult) -> Result<ExplorerTaskRecord, String>:
    mutate_explorer_task(
        task_id,
        |entry| block:
            entry.record.status = ExplorerTaskStatus::Succeeded
            ()
            entry.record.finished_at = Option::Some(current_epoch_ms())
            ()
            entry.record.detail = archive_task_success_detail(result)
            ()
            entry.record.destination_path = Option::Some((*result).output_path.clone())
            ()
            entry.record.error_message = none
            ()
    )

fn execute_archive_extraction(native_task_graph: &NativeTaskGraphManager, task_id: String, request: FsArchiveExtractionRequest) -> Result<FsArchiveExtractionResult, String>:
    let work_key = format!("archive-extract:{}:{:?}", request.archive_path, request.mode)
    await run_native_blocking_task(
        native_task_graph,
        NativeTaskRequest__new_(NativeTaskLane::Archive, NativeTaskPriority::UserInitiated, "extract archive").with_task_id(task_id.to_string()).with_work_key(NativeTaskWorkKey__new_(work_key)).user_visible(true),
        |token| block:
            token.throw_if_cancelled()?
            ()
            let result = archive_ops__extract_archive(&request)
            token.throw_if_cancelled()?
            ()
            result
    )

fn run_archive_extraction_task_with_result(native_task_graph: &NativeTaskGraphManager, request: FsArchiveExtractionRequest) -> Result<(String, FsArchiveExtractionResult), String>:
    let task_id = create_manual_explorer_task(archive_task_registration(&request, archive_task_initial_output_path(&request)))
    let _ = set_manual_explorer_task_cancel_context(&task_id, ExplorerTaskCancelContext::NativeTaskGraph { task_id: task_id.clone() })
    match await execute_archive_extraction(native_task_graph, &task_id, request):
        Ok(result) =>
            complete_archive_extraction_task(&task_id, &result)?
            ()
            Result::Ok((task_id, result))
        Err(error) =>
            if native_task_graph__is_native_task_cancelled_error(&error):
                let _ = cancel_manual_explorer_task(&task_id, Option::Some("Cancelled".to_string()))
                ()
            else:
                let _ = fail_manual_explorer_task(&task_id, error.clone())
                ()
            Result::Err(error)

fn run_archive_extraction_task(native_task_graph: &NativeTaskGraphManager, request: FsArchiveExtractionRequest) -> Result<String, String>:
    let (task_id, _) = (await run_archive_extraction_task_with_result(native_task_graph, request))?
    Result::Ok(task_id)

fn copy_path(src: &std::path::Path, dst: &std::path::Path, force: Bool) -> Result<String, String>:
    let _ = force
    (await ensure_destination_parent_dir(dst))?
    ()
    copy_path_direct(src, dst)?
    ()
    return Result::Ok(String__new_())
    (await ensure_destination_parent_dir(dst))?
    ()
    let ticket = (fs_command_scheduler()?).file_copy_ticket(UrlBuf__from(src), UrlBuf__from(dst), force, false)
    await await_explorer_yazi_task(ticket, yazi_task_registration(ExplorerTaskKind::Copy, format!("Copy {}", task_path_label(src)), format!("{} -> {}", src.display(), dst.display()), vec!(src.to_string_lossy().to_string()), Option::Some(dst.to_string_lossy().to_string()), Option::Some(ExplorerTaskRetryContext::Copy { source_path: src.to_string_lossy().to_string(), destination_path: dst.to_string_lossy().to_string() })))

fn yazi_path_metadata(path: &std::path::Path) -> Result<Option<yazi_fs::cha::Cha>, String>:
    ensure_yazi_runtime()?
    ()
    match await yazi_vfs__provider__symlink_metadata(UrlBuf__from(path)):
        Ok(metadata) => Result::Ok(Option::Some(metadata))
        Err(error) if error.kind() == io::ErrorKind::NotFound => Result::Ok(none)
        Err(error) => Result::Err(format!("Failed to inspect {} via Yazi VFS: {error}", path.display()))

fn cleanup_residual_move_source(source: &std::path::Path, metadata: yazi_fs::cha::Cha) -> Result<(), String>:
    let url = UrlBuf__from(source)
    let cleanup_result = if metadata.is_dir() and !metadata.is_link():
        await yazi_vfs__provider__remove_dir_all(url)
    else:
        await yazi_vfs__provider__remove_file(url)
    cleanup_result.map_err(|error| format!("Move completed but residual source cleanup failed for {}: {error}", source.display()))

fn move_path(src: &std::path::Path, dst: &std::path::Path, force: Bool) -> Result<String, String>:
    let _ = force
    (await ensure_destination_parent_dir(dst))?
    ()
    move_path_direct(src, dst)?
    ()
    return Result::Ok(String__new_())
    (await ensure_destination_parent_dir(dst))?
    ()
    let ticket = (fs_command_scheduler()?).file_cut_ticket(UrlBuf__from(src), UrlBuf__from(dst), force)
    let task_id = (await await_explorer_yazi_task(ticket, yazi_task_registration(ExplorerTaskKind::Move, format!("Move {}", task_path_label(src)), format!("{} -> {}", src.display(), dst.display()), vec!(src.to_string_lossy().to_string()), Option::Some(dst.to_string_lossy().to_string()), Option::Some(ExplorerTaskRetryContext::Move { source_path: src.to_string_lossy().to_string(), destination_path: dst.to_string_lossy().to_string() }))))?
    let destination_metadata = (await yazi_path_metadata(dst))?
    let source_metadata = (await yazi_path_metadata(src))?
    match (destination_metadata, source_metadata):
        (None, _) => Result::Err(format!("Move completed but destination is missing: {}", dst.display()))
        (Some(_), None) => Result::Ok(())
        (Some(_), Some(metadata)) => await cleanup_residual_move_source(src, metadata)?
    ()
    Result::Ok(task_id)

fn delete_path_with_scheduler(path: &std::path::Path, recursive: Bool) -> Result<String, String>:
    let _ = recursive
    delete_path_direct(path)?
    ()
    return Result::Ok(String__new_())
    let ticket = (fs_command_scheduler()?).file_delete_ticket(UrlBuf__from(path))
    await await_explorer_yazi_task(ticket, yazi_task_registration(ExplorerTaskKind::Delete, format!("Delete {}", task_path_label(path)), path.display().to_string(), vec!(path.to_string_lossy().to_string()), none, Option::Some(ExplorerTaskRetryContext::Delete { path: path.to_string_lossy().to_string(), recursive: recursive })))

fn resolve_transfer_destination(preferred_path: std::path::PathBuf, operation: FileTransferOperation, source_path: &std::path::Path, collision_policy: FileTransferCollisionPolicy) -> std::path::PathBuf:
    match collision_policy:
        FileTransferCollisionPolicy::KeepBoth =>
            collision_free_destination(preferred_path, operation, source_path)
        FileTransferCollisionPolicy::Replace | FileTransferCollisionPolicy::Skip => preferred_path

fn collision_free_destination(preferred_path: std::path::PathBuf, operation: FileTransferOperation, source_path: &std::path::Path) -> std::path::PathBuf:
    if !preferred_path.exists() or preferred_path == source_path:
        return preferred_path
    let parent = preferred_path.parent().map(Path__to_path_buf).unwrap_or_else(|| PathBuf__from("."))
    let file_name = preferred_path.file_name().map(|value| value.to_string_lossy().to_string()).unwrap_or_else(|| "item".to_string())
    if preferred_path.is_dir() or source_path.is_dir():
        return numbered_destination(&parent, &file_name, "", operation)
    let stem = preferred_path.file_stem().map(|value| value.to_string_lossy().to_string()).unwrap_or_else(|| file_name.clone())
    let ext = preferred_path.extension().map(|value| format!(".{}", value.to_string_lossy())).unwrap_or_default()
    numbered_destination(&parent, &stem, &ext, operation)

fn numbered_destination(parent: &std::path::Path, base_name: String, extension: String, operation: FileTransferOperation) -> std::path::PathBuf:
    let copy_suffix = "copy"
    let first_candidate = match operation:
        FileTransferOperation::Copy => format!("{base_name} ({copy_suffix}){extension}")
        FileTransferOperation::Move => format!("{base_name} (moved){extension}")
    let first_path = parent.join(&first_candidate)
    if !first_path.exists():
        return first_path
    for index in 2..10000:
        let candidate = match operation:
            FileTransferOperation::Copy =>
                format!("{base_name} ({copy_suffix} {index}){extension}")
            FileTransferOperation::Move => format!("{base_name} (moved {index}){extension}")
        let candidate_path = parent.join(candidate)
        if !candidate_path.exists():
            return candidate_path
    ()
    parent.join(format!("{base_name}-fallback{extension}"))

fn fs_create_dir(path: String) -> Result<(), String>:
    let path_ref = Path__new_(&path)
    std__fs__create_dir_all(path_ref).map_err(|error| error.to_string())?
    ()
    invalidate_all_fs_caches(path_ref)
    ()
    match path_ref.parent():
        Some(parent) =>
            invalidate_all_fs_caches(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    return Result::Ok(())
    ensure_yazi_runtime()?
    ()
    let result = (await yazi_vfs__provider__create_dir_all(UrlBuf__from(Path__new_(&path)))).map_err(|e| e.to_string())
    if result.is_ok():
        let path_ref = Path__new_(&path)
        invalidate_all_fs_caches(path_ref)
        ()
        match path_ref.parent():
            Some(parent) =>
                invalidate_all_fs_caches(parent)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    result

fn fs_write_file(path: String, content: FsWriteFileContent) -> Result<(), String>:
    let path_ref = Path__new_(&path)
    match path_ref.parent():
        Some(parent) =>
            std__fs__create_dir_all(parent).map_err(|error| error.to_string())?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let bytes = match content:
        FsWriteFileContent::Text(text) => text.into_bytes()
        FsWriteFileContent::Bytes(bytes) => bytes
    std__fs__write(path_ref, bytes).map_err(|error| error.to_string())?
    ()
    invalidate_all_fs_caches(path_ref)
    ()
    match path_ref.parent():
        Some(parent) =>
            invalidate_all_fs_caches(parent)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    return Result::Ok(())
    match Path__new_(&path).parent():
        Some(parent) =>
            ensure_yazi_runtime()?
            ()
            (await yazi_vfs__provider__create_dir_all(UrlBuf__from(parent))).map_err(|e| e.to_string())?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let bytes = match content:
        FsWriteFileContent::Text(text) => text.into_bytes()
        FsWriteFileContent::Bytes(bytes) => bytes
    let result = (await yazi_vfs__provider__write(UrlBuf__from(Path__new_(&path)), bytes)).map(|_| ()).map_err(|e| e.to_string())
    if result.is_ok():
        let path_ref = Path__new_(&path)
        invalidate_all_fs_caches(path_ref)
        ()
        match path_ref.parent():
            Some(parent) =>
                invalidate_all_fs_caches(parent)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    result

fn git_command_program() -> String:
    std__env__var_("OVERLAYTERM_GIT_EXECUTABLE").ok().map(|value| value.trim().to_string()).filter(|value| !value.is_empty()).unwrap_or_else(|| "git".to_string())

fn run_git_command(repo_path: String, args: &Slice<String>, timeout: std::time::Duration) -> Result<String, String>:
    let program = git_command_program()
    let mut cmd = Command__new_(&program)
    cmd.current_dir(repo_path).args(args).stdout(Stdio__piped()).stderr(Stdio__piped())
    ()
    cmd.creation_flags(CREATE_NO_WINDOW)
    ()
    ()
    ()
    ()
    let mut child = cmd.spawn_().map_err(|e| format!("Failed to run git via '{}': {}", program, e))?
    let started = Instant__now()
    loop:
        match child.try_wait():
            Ok(Some(_)) =>
                let output = child.wait_with_output().map_err(|e| format!("Failed to collect git output: {}", e))?
                return if output.status.success():
                    Result::Ok(String__from_utf8_lossy(&output.stdout).to_string())
                else:
                    let stderr = String__from_utf8_lossy(&output.stderr).trim().to_string()
                    let stdout = String__from_utf8_lossy(&output.stdout).trim().to_string()
                    let exit_code = output.status.code().map(|code| code.to_string()).unwrap_or_else(|| "signal".to_string())
                    let output_detail = if !stderr.is_empty():
                        stderr
                    else if !stdout.is_empty():
                        stdout
                    else:
                        "no output".to_string()
                    Result::Err(format!("Git command failed (exit {}): {}", exit_code, output_detail))
            Ok(None) =>
                if started.elapsed() >= timeout:
                    let _ = child.kill()
                    let _ = child.wait()
                    return Result::Err(format!("Git command timed out after {}s: {} {}", timeout.as_secs(), program, args.join(" ")))
                std__thread__sleep(Duration__from_millis(15))
                ()
            Err(e) => return Result::Err(format!("Failed while waiting for git: {}", e))

fn git_exec(repo_path: String, args: Array<String>) -> Result<String, String>:
    (await tauri__async_runtime__spawn_blocking(|| run_git_command(&repo_path, &args, GIT_EXEC_TIMEOUT))).map_err(|join_error| format!("Git task join failure: {}", join_error))?

fn fs_read_file_base64(native_task_graph: tauri::State<_, NativeTaskGraphManager>, preview_streaming: tauri::State<_, PreviewStreamingManager>, path: String) -> Result<String, String>:
    let target = PathBuf__from(&path)
    let policy = preview_streaming.policy().clone()
    await run_native_blocking_task(&native_task_graph, NativeTaskRequest__new_(NativeTaskLane::PreviewRead, NativeTaskPriority::Visible, "read data uri preview").with_work_key(NativeTaskWorkKey__new_(format!("preview-data-uri:{path}"))), |token| preview_streaming__read_local_file_data_url(&target, &policy, &token))

fn fs_read_preview_bytes_impl(native_task_graph: &NativeTaskGraphManager, preview_streaming: &PreviewStreamingManager, path: String, max_bytes: Option<u64>) -> Result<tauri::transport::BinaryResponse, String>:
    let target = PathBuf__from(&path)
    let policy = preview_streaming.policy().clone()
    let bytes = (await run_native_blocking_task(&native_task_graph, NativeTaskRequest__new_(NativeTaskLane::PreviewRead, NativeTaskPriority::Visible, "read preview bytes").with_work_key(NativeTaskWorkKey__new_(format!("preview-bytes:{path}"))), |token| preview_streaming__read_local_preview_bytes(&target, max_bytes, &policy, &token)))?
    Result::Ok(BinaryResponse__new_(bytes))

fn fs_read_preview_bytes(native_task_graph: tauri::State<_, NativeTaskGraphManager>, preview_streaming: tauri::State<_, PreviewStreamingManager>, path: String, max_bytes: Option<u64>) -> Result<tauri::transport::BinaryResponse, String>:
    await fs_read_preview_bytes_impl(native_task_graph.inner(), preview_streaming.inner(), path, max_bytes)

fn fs_read_archive_entry_preview_bytes_impl(native_task_graph: &NativeTaskGraphManager, preview_streaming: &PreviewStreamingManager, archive_path: String, entry_path: String, max_bytes: Option<u64>) -> Result<tauri::transport::BinaryResponse, String>:
    let target = PathBuf__from(&archive_path)
    let policy = preview_streaming.policy().clone()
    let allowed_bytes = preview_streaming__resolve_preview_byte_limit(max_bytes, policy.archive_entry_max_bytes)
    let chunk_bytes = policy.chunk_bytes
    let work_key = format!("archive-entry-preview:{archive_path}:{entry_path}")
    let bytes = (await run_native_blocking_task(&native_task_graph, NativeTaskRequest__new_(NativeTaskLane::PreviewRead, NativeTaskPriority::Visible, "read archive entry preview bytes").with_work_key(NativeTaskWorkKey__new_(work_key)), |token| archive_ops__read_archive_entry_preview_bytes(&target, &entry_path, allowed_bytes, chunk_bytes, &token)))?
    Result::Ok(BinaryResponse__new_(bytes))

fn fs_read_archive_entry_preview_bytes(native_task_graph: tauri::State<_, NativeTaskGraphManager>, preview_streaming: tauri::State<_, PreviewStreamingManager>, archive_path: String, entry_path: String, max_bytes: Option<u64>) -> Result<tauri::transport::BinaryResponse, String>:
    await fs_read_archive_entry_preview_bytes_impl(native_task_graph.inner(), preview_streaming.inner(), archive_path, entry_path, max_bytes)

