{
  "version": 1,
  "id": "dreamcast-skyline",
  "name": "Dreamcast Skyline",
  "description": "Bright white launcher with orange signal accents and a clean arcade-console home screen feel.",
  "author": "Codex",
  "tags": ["dreamcast", "console", "bright", "launcher"],
  "extends": "github-dark",
  "fonts": {
    "ui": "\"Space Grotesk\", Inter, sans-serif",
    "mono": "\"JetBrains Mono\", \"Cascadia Code\", monospace"
  },
  "presentation": {
    "chromeStyle": "minimal",
    "density": "comfortable",
    "iconStyle": "vector",
    "motionStyle": "fluid",
    "cornerRadius": 22,
    "panelSpacing": 10
  },
  "theme": {
    "palette": {
      "appBackground": "#eef4f5",
      "appBackgroundAlt": "#f6f8f8",
      "shellBackground": "rgba(249, 252, 252, 0.95)",
      "shellBackgroundSolid": "rgba(249, 252, 252, 0.99)",
      "topBarBackground": "#ffffff",
      "topBarMenuBackground": "#f7fbfb",
      "sidebarBackground": "rgba(242, 247, 247, 0.98)",
      "panelBackground": "rgba(255, 255, 255, 0.98)",
      "panelAltBackground": "rgba(244, 248, 248, 0.98)",
      "cardBackground": "rgba(255, 255, 255, 0.98)",
      "cardHoverBackground": "rgba(250, 252, 252, 1)",
      "contextMenuBackground": "rgba(255, 255, 255, 0.99)",
      "inputBackground": "#ffffff",
      "terminalBackground": "#1f2328",
      "selectionBackground": "rgba(255, 117, 42, 0.14)",
      "textPrimary": "#1c2b33",
      "textSecondary": "#30434d",
      "textMuted": "rgba(28, 43, 51, 0.64)",
      "textDim": "rgba(28, 43, 51, 0.4)",
      "textInverse": "#ffffff",
      "border": "rgba(33, 53, 62, 0.14)",
      "borderStrong": "rgba(255, 117, 42, 0.34)",
      "accent": "#ff752a",
      "accentSoft": "rgba(255, 117, 42, 0.14)",
      "accentContrast": "#ffffff"
    },
    "effects": {
      "backgroundImage": "radial-gradient(circle at 18% 14%, rgba(255,117,42,0.1), transparent 24%), radial-gradient(circle at 78% 14%, rgba(93,188,255,0.1), transparent 18%)",
      "shadow": "0 16px 30px rgba(31, 41, 46, 0.12)",
      "overlayShadow": "0 -2px 0 0 #ff752a, 0 -18px 34px rgba(31, 41, 46, 0.14)"
    },
    "workbench": {
      "brandLabel": "Skyline",
      "topBarStyle": "minimal",
      "commandPaletteStyle": "floating",
      "terminalStyle": "solid",
      "settingsStyle": "floating",
      "tabStyle": "capsule",
      "metrics": {
        "chromeHeight": 38,
        "controlRadius": 16,
        "panelRadius": 22,
        "shellInset": 10,
        "pagePadding": 12,
        "panelGap": 10
      }
    },
    "explorer": {
      "railBrandLabel": "Arcade",
      "toolbarStyle": "minimal",
      "breadcrumbStyle": "segmented",
      "selectionStyle": "outline",
      "hoverStyle": "lift",
      "previewStyle": "floating",
      "statusBarStyle": "hidden",
      "preferredViewMode": "icons-xl",
      "metrics": {
        "railWidth": 240,
        "previewWidth": 400,
        "panelRadius": 22,
        "gridScale": 1.2,
        "iconScale": 1.18
      }
    }
  },
  "layoutPrimitives": [
    {
      "id": "dreamcast-grid",
      "name": "Dreamcast Grid",
      "kind": "grid",
      "props": {
        "cellSize": 152
      }
    }
  ],
  "navigationPatterns": [
    {
      "id": "dreamcast-spatial",
      "name": "Dreamcast Spatial",
      "kind": "spatial",
      "axis": "both",
      "props": {
        "breadcrumb": false
      }
    }
  ],
  "renderStyles": [
    {
      "id": "dreamcast-render",
      "label": "Dreamcast Launcher",
      "description": "Bright launcher-grid runtime with arcade-console card styling.",
      "kind": "wii-channels",
      "entryModule": "renderers/dreamcast-skyline.tsx",
      "supportsLiveSwap": true
    }
  ],
  "defaultLayoutPrimitiveId": "dreamcast-grid",
  "defaultNavigationPatternId": "dreamcast-spatial",
  "defaultRenderStyleId": "dreamcast-render",
  "visuals": [
    {
      "id": "dreamcast-frost",
      "backgroundImage": "linear-gradient(180deg, rgba(255,255,255,0.28), rgba(255,255,255,0) 34%)",
      "opacity": 0.88,
      "blendMode": "screen"
    }
  ]
}
