{
  "version": 1,
  "id": "midnight-noir",
  "name": "Midnight Noir",
  "description": "Matte charcoal surfaces, restrained chrome, and a dark editorial shell with sharp contrast.",
  "author": "Codex",
  "tags": ["dark", "noir", "editorial", "minimal"],
  "extends": "github-dark",
  "fonts": {
    "ui": "Geist, Inter, system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", \"Cascadia Code\", monospace"
  },
  "presentation": {
    "chromeStyle": "minimal",
    "density": "comfortable",
    "iconStyle": "vector",
    "motionStyle": "instant",
    "cornerRadius": 14,
    "panelSpacing": 8
  },
  "theme": {
    "palette": {
      "appBackground": "#08090b",
      "appBackgroundAlt": "#0d0f12",
      "shellBackground": "rgba(9, 10, 12, 0.88)",
      "shellBackgroundSolid": "rgba(9, 10, 12, 0.98)",
      "topBarBackground": "#0e1115",
      "topBarMenuBackground": "#14181d",
      "sidebarBackground": "#101317",
      "panelBackground": "#12161b",
      "panelAltBackground": "#171c22",
      "cardBackground": "#171b20",
      "cardHoverBackground": "#1d232a",
      "contextMenuBackground": "#14181d",
      "inputBackground": "#0f1318",
      "terminalBackground": "#080a0d",
      "selectionBackground": "rgba(224, 83, 83, 0.14)",
      "textPrimary": "#f1f2f4",
      "textSecondary": "#dfe3e7",
      "textMuted": "rgba(241, 242, 244, 0.58)",
      "textDim": "rgba(241, 242, 244, 0.28)",
      "border": "rgba(255, 255, 255, 0.08)",
      "borderStrong": "rgba(224, 83, 83, 0.24)",
      "accent": "#e05353",
      "accentSoft": "rgba(224, 83, 83, 0.14)",
      "accentContrast": "#fff4f4",
      "danger": "#ff8a8a",
      "info": "#8aa6ff"
    },
    "effects": {
      "backgroundImage": "radial-gradient(circle at 18% 14%, rgba(224,83,83,0.1), transparent 24%), linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0) 28%)",
      "shadow": "0 18px 56px rgba(0, 0, 0, 0.58)",
      "overlayShadow": "0 -3px 0 0 #e05353, 0 -28px 72px rgba(0, 0, 0, 0.92)"
    },
    "workbench": {
      "brandLabel": "Noir",
      "topBarStyle": "minimal",
      "commandPaletteStyle": "floating",
      "terminalStyle": "solid",
      "settingsStyle": "floating",
      "tabStyle": "underline",
      "metrics": {
        "chromeHeight": 34,
        "controlRadius": 8,
        "panelRadius": 14,
        "shellInset": 6,
        "pagePadding": 10,
        "panelGap": 8
      }
    },
    "explorer": {
      "railBrandLabel": "Case Files",
      "toolbarStyle": "minimal",
      "breadcrumbStyle": "plain",
      "selectionStyle": "outline",
      "hoverStyle": "fill",
      "previewStyle": "attached",
      "statusBarStyle": "solid",
      "preferredViewMode": "details",
      "metrics": {
        "railWidth": 246,
        "previewWidth": 450,
        "panelRadius": 14,
        "rowHeightScale": 0.98,
        "iconScale": 0.94
      }
    }
  },
  "layoutPrimitives": [
    {
      "id": "noir-stack",
      "name": "Noir Stack",
      "kind": "stack",
      "props": {
        "gap": 8
      }
    }
  ],
  "navigationPatterns": [
    {
      "id": "noir-tabs",
      "name": "Noir Tabs",
      "kind": "tabbed",
      "axis": "horizontal",
      "props": {
        "defaultSurface": "files"
      }
    }
  ],
  "renderStyles": [
    {
      "id": "noir-render",
      "label": "Noir Workbench",
      "description": "Minimal workbench runtime with restrained contrast and dark editorial chrome.",
      "kind": "vs-code-workbench",
      "entryModule": "renderers/midnight-noir.tsx",
      "supportsLiveSwap": true
    }
  ],
  "defaultLayoutPrimitiveId": "noir-stack",
  "defaultNavigationPatternId": "noir-tabs",
  "defaultRenderStyleId": "noir-render",
  "visuals": [
    {
      "id": "noir-vignette",
      "backgroundImage": "radial-gradient(circle at 50% 40%, transparent 0%, transparent 38%, rgba(0,0,0,0.24) 100%)",
      "opacity": 1,
      "blendMode": "multiply"
    }
  ]
}
