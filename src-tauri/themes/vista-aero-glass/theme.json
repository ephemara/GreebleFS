{
  "version": 1,
  "id": "vista-aero-glass",
  "name": "Vista Aero Glass",
  "description": "Glossy blue translucency, bright highlights, and a soft frosted workbench shell.",
  "author": "Codex",
  "tags": ["windows", "vista", "glass", "aero"],
  "extends": "github-dark",
  "fonts": {
    "ui": "\"Segoe UI\", Inter, sans-serif",
    "mono": "\"JetBrains Mono\", \"Cascadia Code\", monospace"
  },
  "presentation": {
    "chromeStyle": "floating",
    "density": "comfortable",
    "iconStyle": "skeuomorphic",
    "motionStyle": "fluid",
    "cornerRadius": 18,
    "panelSpacing": 10
  },
  "theme": {
    "palette": {
      "accent": "#7fd8ff",
      "accentSoft": "rgba(127, 216, 255, 0.16)",
      "panelBackground": "rgba(23, 40, 68, 0.62)",
      "sidebarBackground": "rgba(16, 31, 58, 0.64)",
      "cardBackground": "rgba(39, 63, 94, 0.58)",
      "cardHoverBackground": "rgba(58, 86, 122, 0.68)",
      "border": "rgba(164, 221, 255, 0.18)",
      "borderStrong": "rgba(164, 221, 255, 0.34)"
    },
    "effects": {
      "backgroundImage": "radial-gradient(circle at 18% 14%, rgba(127,216,255,0.22), transparent 28%), radial-gradient(circle at 84% 12%, rgba(255,255,255,0.14), transparent 18%), linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0) 38%)",
      "shadow": "0 18px 54px rgba(0, 0, 0, 0.38)",
      "overlayShadow": "0 -4px 0 0 #8bdcff, 0 -28px 72px rgba(2, 8, 18, 0.82)"
    },
    "workbench": {
      "brandLabel": "Aero",
      "topBarStyle": "glass",
      "commandPaletteStyle": "glass",
      "terminalStyle": "glass",
      "settingsStyle": "glass",
      "tabStyle": "capsule",
      "metrics": {
        "chromeHeight": 40,
        "controlRadius": 14,
        "panelRadius": 20,
        "shellInset": 12,
        "pagePadding": 12,
        "panelGap": 10
      }
    },
    "explorer": {
      "railBrandLabel": "Glass Shelf",
      "toolbarStyle": "glass",
      "breadcrumbStyle": "capsule",
      "selectionStyle": "glow",
      "hoverStyle": "lift",
      "previewStyle": "glass",
      "statusBarStyle": "floating",
      "preferredViewMode": "icons-l",
      "metrics": {
        "railWidth": 252,
        "previewWidth": 460,
        "panelRadius": 20,
        "gridScale": 1.08,
        "iconScale": 1.12,
        "hoverLiftPx": 3
      }
    }
  },
  "layoutPrimitives": [
    {
      "id": "vista-shell",
      "name": "Vista Shell",
      "kind": "dock",
      "props": {
        "chrome": "frosted"
      }
    }
  ],
  "navigationPatterns": [
    {
      "id": "vista-palette",
      "name": "Vista Breadcrumbs",
      "kind": "palette",
      "axis": "horizontal",
      "props": {
        "searchFirst": true
      }
    }
  ],
  "renderStyles": [
    {
      "id": "vista-render",
      "label": "Vista Glass",
      "description": "Glossy workbench shell with frosted panel treatment.",
      "kind": "vs-code-workbench",
      "entryModule": "renderers/vista-aero.tsx",
      "supportsLiveSwap": true
    }
  ],
  "defaultLayoutPrimitiveId": "vista-shell",
  "defaultNavigationPatternId": "vista-palette",
  "defaultRenderStyleId": "vista-render",
  "visuals": [
    {
      "id": "vista-bloom",
      "backgroundImage": "radial-gradient(circle at 18% 20%, rgba(255,255,255,0.14), transparent 22%), linear-gradient(180deg, rgba(255,255,255,0.1), rgba(255,255,255,0) 32%)",
      "opacity": 0.92,
      "blendMode": "screen"
    }
  ]
}
