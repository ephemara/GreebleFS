{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@tauri-apps/api": ["../tauron/packages/api/dist/index.d.ts"],
      "@tauri-apps/api/*": ["../tauron/packages/api/dist/*.d.ts"],
      "@greeblefs/ui": ["usr/packages/greeblefs-ui/src/index.tsx"],
      "overlayterm-plugin": ["src/components/pluginRuntime.tsx"],
      "@tiptap/core": ["src/vendor/tiptap/core/src/index.ts"],
      "@tiptap/core/jsx-runtime": ["src/vendor/tiptap/core/src/jsx-runtime.ts"],
      "@tiptap/core/jsx-dev-runtime": ["src/vendor/tiptap/core/src/jsx-runtime.ts"],
      "@tiptap/react": ["src/vendor/tiptap/react/src/index.ts"],
      "@tiptap/pm/*": ["src/vendor/tiptap/pm/*/index.ts"],
      "@tiptap/*": ["src/vendor/tiptap/*/src/index.ts"]
    },

    "types": ["vitest/globals", "node"],
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "src-mobile"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
