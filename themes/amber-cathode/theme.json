{
  "version": 1,
  "id": "amber-cathode",
  "name": "Amber Cathode",
  "description": "A phosphor-screen shell with amber glow, scanline overlays, and terminal-first density.",
  "author": "Codex",
  "tags": ["retro", "crt", "terminal", "amber"],
  "extends": "monokai",
  "fonts": {
    "ui": "\"IBM Plex Mono\", \"Cascadia Code\", monospace",
    "mono": "\"IBM Plex Mono\", \"Cascadia Code\", monospace"
  },
  "presentation": {
    "chromeStyle": "solid",
    "density": "compact",
    "iconStyle": "system",
    "motionStyle": "instant",
    "cornerRadius": 8,
    "panelSpacing": 6
  },
  "theme": {
    "palette": {
      "appBackground": "#100c06",
      "appBackgroundAlt": "#171109",
      "shellBackground": "rgba(14, 10, 6, 0.88)",
      "shellBackgroundSolid": "rgba(14, 10, 6, 0.98)",
      "topBarBackground": "#1a1209",
      "topBarMenuBackground": "#22170c",
      "sidebarBackground": "#181108",
      "panelBackground": "#1e140a",
      "panelAltBackground": "#25180c",
      "cardBackground": "#2b1b0d",
      "cardHoverBackground": "#332010",
      "contextMenuBackground": "#28190d",
      "inputBackground": "#120d08",
      "terminalBackground": "#0a0704",
      "selectionBackground": "rgba(255, 176, 77, 0.18)",
      "textPrimary": "#ffd59a",
      "textSecondary": "#ffca86",
      "textMuted": "rgba(255, 213, 154, 0.62)",
      "textDim": "rgba(255, 213, 154, 0.32)",
      "border": "rgba(255, 176, 77, 0.16)",
      "borderStrong": "rgba(255, 176, 77, 0.3)",
      "accent": "#ffb04d",
      "accentSoft": "rgba(255, 176, 77, 0.16)",
      "accentContrast": "#140c04",
      "success": "#d8ff8f",
      "warning": "#ffb04d",
      "danger": "#ff7b47",
      "info": "#ffd59a"
    },
    "effects": {
      "backgroundImage": "linear-gradient(180deg, rgba(255,176,77,0.05), rgba(255,176,77,0) 45%)",
      "shadow": "0 16px 42px rgba(0, 0, 0, 0.58)",
      "overlayShadow": "0 -3px 0 0 #ffb04d, 0 -22px 54px rgba(0, 0, 0, 0.86)"
    },
    "workbench": {
      "brandLabel": "Cathode",
      "topBarStyle": "solid",
      "commandPaletteStyle": "solid",
      "terminalStyle": "solid",
      "settingsStyle": "solid",
      "tabStyle": "underline",
      "metrics": {
        "chromeHeight": 32,
        "controlRadius": 5,
        "panelRadius": 8,
        "shellInset": 4,
        "pagePadding": 8,
        "panelGap": 6
      }
    },
    "explorer": {
      "railBrandLabel": "Index",
      "toolbarStyle": "solid",
      "breadcrumbStyle": "plain",
      "selectionStyle": "glow",
      "hoverStyle": "fill",
      "previewStyle": "attached",
      "statusBarStyle": "solid",
      "preferredViewMode": "list",
      "metrics": {
        "railWidth": 228,
        "previewWidth": 420,
        "rowHeightScale": 0.94,
        "iconScale": 0.88,
        "panelRadius": 8
      }
    }
  },
  "layoutPrimitives": [
    {
      "id": "amber-stack",
      "name": "Amber Stack",
      "kind": "stack",
      "props": {
        "gap": 6
      }
    }
  ],
  "navigationPatterns": [
    {
      "id": "amber-tabs",
      "name": "Amber Tabs",
      "kind": "tabbed",
      "axis": "horizontal",
      "props": {
        "focusRing": "chrome"
      }
    }
  ],
  "renderStyles": [
    {
      "id": "amber-render",
      "label": "Amber Terminal",
      "description": "Dense workbench render path for terminal-heavy retro themes.",
      "kind": "vs-code-workbench",
      "entryModule": "renderers/amber-cathode.tsx",
      "supportsLiveSwap": true
    }
  ],
  "defaultLayoutPrimitiveId": "amber-stack",
  "defaultNavigationPatternId": "amber-tabs",
  "defaultRenderStyleId": "amber-render",
  "visuals": [
    {
      "id": "amber-scanlines",
      "backgroundImage": "repeating-linear-gradient(180deg, rgba(255,176,77,0.06) 0 1px, transparent 1px 4px)",
      "opacity": 0.42,
      "blendMode": "screen"
    }
  ]
}
