{
  "version": 1,
  "id": "gamecube-orbital",
  "name": "GameCube Orbital",
  "description": "Purple console chrome with crisp cubes, cool glass panels, and a launch-grid shell.",
  "author": "Codex",
  "tags": ["console", "gamecube", "purple", "launcher"],
  "extends": "operator",
  "fonts": {
    "ui": "\"Space Grotesk\", Inter, sans-serif",
    "mono": "\"JetBrains Mono\", \"Cascadia Code\", monospace"
  },
  "presentation": {
    "chromeStyle": "glass",
    "density": "comfortable",
    "iconStyle": "vector",
    "motionStyle": "dramatic",
    "cornerRadius": 22,
    "panelSpacing": 10
  },
  "theme": {
    "palette": {
      "appBackground": "#080912",
      "appBackgroundAlt": "#0d1020",
      "shellBackground": "rgba(12, 13, 26, 0.92)",
      "shellBackgroundSolid": "#101222",
      "topBarBackground": "rgba(22, 24, 39, 0.84)",
      "topBarMenuBackground": "rgba(20, 21, 36, 0.96)",
      "sidebarBackground": "rgba(18, 19, 34, 0.92)",
      "panelBackground": "rgba(24, 26, 46, 0.92)",
      "panelAltBackground": "rgba(16, 18, 32, 0.96)",
      "cardBackground": "rgba(38, 40, 66, 0.84)",
      "cardHoverBackground": "rgba(52, 55, 90, 0.92)",
      "contextMenuBackground": "rgba(18, 20, 36, 0.98)",
      "inputBackground": "rgba(12, 13, 24, 0.88)",
      "terminalBackground": "#0a0b16",
      "selectionBackground": "rgba(115, 103, 240, 0.28)",
      "scrimBackground": "rgba(4, 5, 12, 0.66)",
      "textPrimary": "#f1f4ff",
      "textSecondary": "#c6cbe6",
      "textMuted": "#9aa2ca",
      "textDim": "#6e759d",
      "textInverse": "#101222",
      "border": "rgba(126, 135, 188, 0.2)",
      "borderStrong": "rgba(124, 110, 255, 0.38)",
      "accent": "#7367f0",
      "accentSoft": "rgba(115, 103, 240, 0.2)",
      "accentContrast": "#f8f9ff",
      "success": "#59c679",
      "warning": "#f2ca54",
      "danger": "#d25d78",
      "info": "#5bc7ff",
      "note": "#cfd5e8",
      "todo": "#59c679",
      "bug": "#d25d78",
      "prompt": "#f2ca54"
    },
    "effects": {
      "backgroundImage": "radial-gradient(circle at 18% 14%, rgba(115,103,240,0.22), transparent 28%), radial-gradient(circle at 82% 18%, rgba(91,199,255,0.1), transparent 22%), linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0) 24%)",
      "shadow": "0 24px 64px rgba(0, 0, 0, 0.58)",
      "overlayShadow": "0 -4px 0 0 #7367f0, 0 -30px 72px rgba(3, 4, 12, 0.9)"
    },
    "workbench": {
      "brandLabel": "Orbital",
      "topBarStyle": "glass",
      "commandPaletteStyle": "glass",
      "terminalStyle": "glass",
      "settingsStyle": "glass",
      "tabStyle": "capsule",
      "metrics": {
        "chromeHeight": 40,
        "controlRadius": 16,
        "panelRadius": 22,
        "shellInset": 12,
        "pagePadding": 12,
        "panelGap": 10
      }
    },
    "explorer": {
      "railBrandLabel": "Cube Grid",
      "toolbarStyle": "floating",
      "breadcrumbStyle": "capsule",
      "selectionStyle": "glow",
      "hoverStyle": "glow",
      "previewStyle": "glass",
      "statusBarStyle": "floating",
      "preferredViewMode": "icons-xl",
      "preferredExperimentalViewMode": "constellation",
      "metrics": {
        "railWidth": 244,
        "previewWidth": 430,
        "panelRadius": 22,
        "gridScale": 1.18,
        "iconScale": 1.22,
        "hoverLiftPx": 4
      }
    }
  },
  "layoutPrimitives": [
    {
      "id": "cube-grid",
      "name": "Cube Grid",
      "kind": "grid",
      "props": {
        "cellSize": 148
      }
    }
  ],
  "navigationPatterns": [
    {
      "id": "cube-launcher",
      "name": "Cube Launcher",
      "kind": "spatial",
      "axis": "both",
      "props": {
        "breadcrumb": false
      }
    }
  ],
  "renderStyles": [
    {
      "id": "cube-render",
      "label": "Orbital Grid",
      "description": "Large channel-grid launcher styling for console-inspired browsing.",
      "kind": "wii-channels",
      "entryModule": "renderers/gamecube-orbital.tsx",
      "supportsLiveSwap": true
    }
  ],
  "themeRenderer": {
    "entryModule": "renderers/gamecube-orbital.tsx",
    "apiVersion": 1,
    "supportsLiveSwap": true,
    "fallbackRuntime": "channel-launcher",
    "capabilities": {
      "customScreens": true,
      "wallpaperScene": true,
      "surfaceAdapters": true
    }
  },
  "defaultLayoutPrimitiveId": "cube-grid",
  "defaultNavigationPatternId": "cube-launcher",
  "defaultRenderStyleId": "cube-render",
  "visuals": [
      {
        "id": "cube-sheen",
        "backgroundImage": "radial-gradient(circle at 20% 18%, rgba(201,194,255,0.08), transparent 20%), linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0) 26%)",
        "opacity": 0.88,
        "blendMode": "screen"
      }
  ]
}
