{
  "version": 1,
  "id": "aqua-light",
  "name": "Aqua Light",
  "description": "Glossy aqua chrome with candy-blue highlights and bright translucent panels.",
  "extends": "operator",
  "assets": {
    "background": "assets/wallpaper.svg",
    "iconsDirectory": "icons"
  },
  "theme": {
    "palette": {
      "appBackground": "#dbefff",
      "appBackgroundAlt": "#cbe7ff",
      "shellBackground": "rgba(239, 248, 255, 0.72)",
      "shellBackgroundSolid": "rgba(231, 244, 255, 0.96)",
      "topBarBackground": "#eef8ff",
      "topBarMenuBackground": "#dcefff",
      "sidebarBackground": "rgba(226, 243, 255, 0.92)",
      "panelBackground": "rgba(245, 251, 255, 0.82)",
      "panelAltBackground": "rgba(230, 245, 255, 0.92)",
      "cardBackground": "rgba(255, 255, 255, 0.74)",
      "cardHoverBackground": "rgba(216, 237, 255, 0.94)",
      "contextMenuBackground": "rgba(241, 249, 255, 0.98)",
      "inputBackground": "rgba(255, 255, 255, 0.9)",
      "terminalBackground": "#f4fbff",
      "selectionBackground": "rgba(85, 182, 255, 0.2)",
      "scrimBackground": "rgba(112, 157, 194, 0.22)",
      "textPrimary": "#11334c",
      "textSecondary": "#204968",
      "textMuted": "rgba(17, 51, 76, 0.62)",
      "textDim": "rgba(17, 51, 76, 0.34)",
      "textInverse": "#f8fdff",
      "border": "rgba(91, 163, 217, 0.24)",
      "borderStrong": "rgba(67, 151, 214, 0.42)",
      "accent": "#2a9df4",
      "accentSoft": "rgba(42, 157, 244, 0.16)",
      "accentContrast": "#f7fcff",
      "success": "#2bb673",
      "warning": "#f0a428",
      "danger": "#d95a77",
      "info": "#2a9df4",
      "note": "#2a9df4",
      "todo": "#2bb673",
      "bug": "#d95a77",
      "prompt": "#7b7ff4"
    },
    "effects": {
      "backgroundSize": "cover",
      "backgroundPosition": "center",
      "shadow": "0 18px 44px rgba(52, 108, 156, 0.18)",
      "overlayShadow": "0 -4px 0 0 #2a9df4, 0 -28px 72px rgba(114, 166, 214, 0.3)"
    },
    "xterm": {
      "background": "#f4fbff",
      "foreground": "#204968",
      "cursor": "#2a9df4",
      "black": "#7ea1bd",
      "white": "#18415f",
      "brightWhite": "#0f3048"
    },
    "cssVars": {
      "--snapyard-chrome-style": "aqua-light"
    }
  },
  "visuals": [
    {
      "id": "aqua-gloss",
      "backgroundImage": "linear-gradient(180deg, rgba(255,255,255,0.72) 0%, rgba(255,255,255,0.14) 18%, rgba(255,255,255,0) 52%)",
      "opacity": 0.78,
      "blendMode": "screen"
    },
    {
      "id": "aqua-bubbles",
      "backgroundImage": "radial-gradient(circle at 16% 14%, rgba(127, 220, 255, 0.46), transparent 24%), radial-gradient(circle at 80% 12%, rgba(53, 184, 255, 0.24), transparent 20%), radial-gradient(circle at 68% 74%, rgba(64, 193, 255, 0.22), transparent 18%)",
      "opacity": 0.82,
      "blendMode": "screen",
      "animation": {
        "kind": "pulse",
        "durationMs": 11000
      }
    }
  ]
}
