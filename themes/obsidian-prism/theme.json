{
  "version": 1,
  "id": "obsidian-prism",
  "name": "Obsidian Prism",
  "description": "Deep obsidian shell with a violet-to-teal prismatic edge. Designed as the gold-standard reference theme exercising every surface, recipe, and visual layer of the GreebleFS theming system.",
  "author": "GreebleFS Core",
  "homepage": "https://github.com/greeblefs/overlayterm",
  "tags": ["dark", "premium", "reference", "prismatic", "glass"],
  "extends": "pilot-dark",

  "themeRenderer": {
    "entryModule": "renderers/obsidian-shell.tsx",
    "apiVersion": 1,
    "supportsLiveSwap": true,
    "fallbackRuntime": "workbench-tabs",
    "capabilities": {
      "customScreens": true,
      "wallpaperScene": true,
      "surfaceAdapters": true
    }
  },

  "fonts": {
    "ui": "Inter, system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", \"Cascadia Code\", monospace"
  },

  "presentation": {
    "density": "comfortable",
    "chromeStyle": "floating",
    "iconStyle": "vector",
    "motionStyle": "fluid",
    "cornerRadius": 16,
    "panelSpacing": 10
  },

  "compatibility": {
    "shellBlueprints": ["classic-dock"],
    "tags": ["dark", "premium", "glass", "prismatic"]
  },

  "contributions": {
    "shaders": ["shaders/ObsidianPulse.tsx"],
    "animations": ["animations/ObsidianSlide.tsx"]
  },

  "theme": {
    "assets": {
      "iconTheme": "icon-theme.json"
    },
    "palette": {
      "appBackground": "#08080e",
      "appBackgroundAlt": "#0c0c16",
      "shellBackground": "rgba(8, 8, 14, 0.82)",
      "shellBackgroundSolid": "rgba(8, 8, 14, 0.97)",
      "topBarBackground": "#0e0e1a",
      "topBarMenuBackground": "#141424",
      "sidebarBackground": "#101018",
      "panelBackground": "#13131f",
      "panelAltBackground": "#18182a",
      "cardBackground": "#1a1a2e",
      "cardHoverBackground": "#222238",
      "contextMenuBackground": "#1c1c2e",
      "inputBackground": "#1e1e32",
      "terminalBackground": "#06060c",
      "selectionBackground": "rgba(139, 92, 246, 0.2)",
      "scrimBackground": "rgba(0, 0, 0, 0.62)",
      "textPrimary": "#eae8f4",
      "textSecondary": "#d4d0ea",
      "textMuted": "rgba(234, 232, 244, 0.56)",
      "textDim": "rgba(234, 232, 244, 0.24)",
      "textInverse": "#08080e",
      "border": "rgba(139, 92, 246, 0.12)",
      "borderStrong": "rgba(139, 92, 246, 0.26)",
      "accent": "#8b5cf6",
      "accentSoft": "rgba(139, 92, 246, 0.16)",
      "accentContrast": "#f5f3ff",
      "success": "#34d399",
      "warning": "#fbbf24",
      "danger": "#fb7185",
      "info": "#67e8f9",
      "note": "#67e8f9",
      "todo": "#34d399",
      "bug": "#fb7185",
      "prompt": "#c084fc"
    },
    "effects": {
      "backgroundImage": "radial-gradient(ellipse at 14% 8%, rgba(139, 92, 246, 0.3), transparent 32%), radial-gradient(ellipse at 86% 12%, rgba(34, 211, 238, 0.18), transparent 28%), radial-gradient(circle at 50% 90%, rgba(168, 85, 247, 0.1), transparent 40%), linear-gradient(180deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0) 100%)",
      "backgroundSize": "cover",
      "backgroundPosition": "center",
      "shadow": "0 20px 60px rgba(0, 0, 0, 0.52)",
      "overlayShadow": "0 -4px 0 0 #8b5cf6, 0 -36px 90px rgba(0, 0, 0, 0.96)"
    },
    "xterm": {
      "background": "#06060c",
      "foreground": "#d4d0ea",
      "cursor": "#8b5cf6",
      "black": "#1a1a2e",
      "red": "#fb7185",
      "green": "#34d399",
      "yellow": "#fbbf24",
      "blue": "#60a5fa",
      "magenta": "#c084fc",
      "cyan": "#22d3ee",
      "white": "#d4d0ea",
      "brightBlack": "#6366f1",
      "brightRed": "#fda4af",
      "brightGreen": "#6ee7b7",
      "brightYellow": "#fcd34d",
      "brightBlue": "#93c5fd",
      "brightMagenta": "#d8b4fe",
      "brightCyan": "#67e8f9",
      "brightWhite": "#f5f3ff"
    },
    "defaultShaderId": "obsidian-prism-ObsidianPulse",
    "defaultOpenAnimationId": "obsidian-prism-ObsidianSlide",
    "defaultCloseAnimationId": "obsidian-prism-ObsidianSlide",

    "workbench": {
      "preset": "workbench",
      "brandLabel": "Obsidian Prism",
      "topBarStyle": "glass",
      "panelStyle": "glass",
      "commandPaletteStyle": "glass",
      "terminalStyle": "glass",
      "settingsStyle": "glass",
      "tabStyle": "capsule",
      "metrics": {
        "chromeHeight": 40,
        "controlRadius": 10,
        "panelRadius": 16,
        "shellInset": 10,
        "commandPaletteWidth": 800,
        "commandPaletteTopInset": 52,
        "pagePadding": 14,
        "panelGap": 10
      },
      "surfaces": {
        "shellBackground": "color-mix(in srgb, var(--overlay-bg-shell-solid) 88%, transparent)",
        "chromeBackground": "color-mix(in srgb, var(--overlay-bg-topbar) 82%, transparent)",
        "chromeMenuBackground": "color-mix(in srgb, var(--overlay-bg-topbar-menu) 86%, transparent)",
        "chromeBorder": "color-mix(in srgb, var(--overlay-accent) 18%, var(--overlay-border))",
        "chromeButtonBackground": "color-mix(in srgb, var(--overlay-accent) 6%, transparent)",
        "chromeButtonHoverBackground": "color-mix(in srgb, var(--overlay-accent) 14%, transparent)",
        "chromeButtonActiveBackground": "color-mix(in srgb, var(--overlay-accent) 18%, transparent)",
        "chromeButtonActiveBorder": "color-mix(in srgb, var(--overlay-accent) 38%, transparent)",
        "chromeTabBackground": "color-mix(in srgb, var(--overlay-bg-panel) 78%, transparent)",
        "chromeTabActiveBackground": "color-mix(in srgb, var(--overlay-accent) 14%, transparent)",
        "chromeTabBorder": "color-mix(in srgb, var(--overlay-accent) 16%, var(--overlay-border))",
        "shellShadow": "0 20px 52px rgba(0, 0, 0, 0.32)",
        "commandPaletteScrimBackground": "rgba(4, 4, 8, 0.52)",
        "commandPaletteBackground": "color-mix(in srgb, var(--overlay-bg-panel) 84%, transparent)",
        "commandPaletteBorder": "color-mix(in srgb, var(--overlay-accent) 22%, var(--overlay-border))",
        "commandPaletteInputBackground": "color-mix(in srgb, var(--overlay-bg-input) 80%, transparent)",
        "commandPaletteItemBackground": "color-mix(in srgb, var(--overlay-bg-panel) 76%, transparent)",
        "commandPaletteItemActiveBackground": "color-mix(in srgb, var(--overlay-accent) 16%, transparent)",
        "settingsBackground": "linear-gradient(180deg, color-mix(in srgb, var(--overlay-bg-app-alt) 92%, transparent) 0%, color-mix(in srgb, var(--overlay-bg-panel) 86%, transparent) 100%)",
        "settingsRailBackground": "color-mix(in srgb, var(--overlay-bg-sidebar) 78%, transparent)",
        "settingsCardBackground": "color-mix(in srgb, var(--overlay-bg-panel) 80%, transparent)",
        "settingsCardBorder": "color-mix(in srgb, var(--overlay-accent) 14%, var(--overlay-border))",
        "settingsBadgeBackground": "color-mix(in srgb, var(--overlay-bg-panel) 74%, transparent)",
        "settingsBadgeBorder": "color-mix(in srgb, var(--overlay-accent) 16%, var(--overlay-border))",
        "terminalBackground": "color-mix(in srgb, var(--overlay-bg-shell) 82%, transparent)",
        "terminalPanelBackground": "color-mix(in srgb, var(--overlay-bg-panel) 80%, transparent)",
        "terminalPaneBackground": "color-mix(in srgb, var(--overlay-bg-terminal) 88%, transparent)",
        "terminalBorder": "color-mix(in srgb, var(--overlay-accent) 14%, var(--overlay-border))",
        "terminalStatusBackground": "color-mix(in srgb, var(--overlay-accent) 16%, transparent)"
      },
      "typography": {
        "chromeLabelSize": 11,
        "chromeMetaSize": 8,
        "tabLabelSize": 11,
        "pageTitleSize": 17,
        "pageBodySize": 11,
        "badgeSize": 9,
        "labelLetterSpacing": "0.1em"
      }
    },

    "explorer": {
      "preset": "workbench",
      "chromeLayoutId": "default",
      "defaultModeProfileId": "balanced",
      "railPosition": "left",
      "railBrandLabel": "Prism Explorer",
      "toolbarStyle": "glass",
      "breadcrumbStyle": "capsule",
      "selectionStyle": "glow",
      "hoverStyle": "glow",
      "previewStyle": "glass",
      "statusBarStyle": "floating",
      "labelMode": "stacked",
      "preferredViewMode": "icons-m",
      "preferredExperimentalViewMode": "off",
      "metrics": {
        "railWidth": 272,
        "previewWidth": 380,
        "chromeInset": 10,
        "toolbarPaddingX": 12,
        "toolbarPaddingY": 8,
        "toolbarGap": 7,
        "controlRadius": 10,
        "panelRadius": 16,
        "spacingScale": 1.06,
        "gridScale": 1.08,
        "rowHeightScale": 1.04,
        "iconScale": 1.08,
        "hoverLiftPx": 2
      },
      "surfaces": {
        "rootBackground": "transparent",
        "contentBackground": "transparent",
        "sidebarBackground": "color-mix(in srgb, var(--overlay-bg-sidebar) 88%, transparent)",
        "sidebarBorder": "color-mix(in srgb, var(--overlay-accent) 14%, var(--overlay-border))",
        "toolbarBackground": "color-mix(in srgb, var(--overlay-bg-panel) 78%, transparent)",
        "toolbarBorder": "color-mix(in srgb, var(--overlay-accent) 18%, var(--overlay-border))",
        "toolbarShadow": "0 16px 38px rgba(0, 0, 0, 0.24)",
        "omniboxBackground": "color-mix(in srgb, var(--overlay-bg-shell-solid) 80%, transparent)",
        "omniboxBorder": "color-mix(in srgb, var(--overlay-accent) 24%, var(--overlay-border))",
        "previewBackground": "color-mix(in srgb, var(--overlay-bg-panel) 82%, transparent)",
        "previewHeaderBackground": "color-mix(in srgb, var(--overlay-bg-sidebar) 80%, transparent)",
        "previewBorder": "color-mix(in srgb, var(--overlay-accent) 18%, var(--overlay-border))",
        "statusBarBackground": "color-mix(in srgb, var(--overlay-bg-sidebar) 80%, transparent)",
        "statusBarBorder": "color-mix(in srgb, var(--overlay-accent) 12%, var(--overlay-border))",
        "itemHoverBackground": "color-mix(in srgb, var(--overlay-accent) 10%, transparent)",
        "itemHoverBorder": "color-mix(in srgb, var(--overlay-accent) 32%, transparent)",
        "itemSelectedBackground": "color-mix(in srgb, var(--overlay-accent) 14%, transparent)",
        "itemSelectedBorder": "var(--overlay-accent)",
        "itemDropBackground": "color-mix(in srgb, var(--overlay-accent) 16%, transparent)",
        "itemDropBorder": "var(--overlay-accent)",
        "itemFocusShadow": "0 12px 30px color-mix(in srgb, var(--overlay-accent) 16%, transparent)",
        "inputBackground": "color-mix(in srgb, var(--overlay-bg-shell-solid) 76%, transparent)",
        "inputBorder": "var(--overlay-accent)",
        "chipBackground": "color-mix(in srgb, var(--overlay-bg-shell-solid) 60%, transparent)",
        "chipBorder": "color-mix(in srgb, var(--overlay-accent) 16%, var(--overlay-border))",
        "chipActiveBackground": "color-mix(in srgb, var(--overlay-accent) 14%, transparent)",
        "chipActiveBorder": "color-mix(in srgb, var(--overlay-accent) 38%, transparent)",
        "chipActiveText": "var(--overlay-accent)"
      },
      "typography": {
        "railEyebrowSize": 9,
        "railTitleSize": 15,
        "toolbarFontSize": 11,
        "breadcrumbFontSize": 10.5,
        "entryTitleSize": 11,
        "entryMetaSize": 10,
        "statusFontSize": 10,
        "entryTitleWeight": 550,
        "labelLetterSpacing": "0.1em"
      }
    },

    "dock": {
      "workbench": {
        "brandLabel": "Obsidian Dock",
        "topBarStyle": "glass",
        "panelStyle": "glass",
        "commandPaletteStyle": "glass",
        "terminalStyle": "glass",
        "settingsStyle": "glass",
        "tabStyle": "capsule",
        "metrics": {
          "chromeHeight": 36,
          "controlRadius": 12,
          "panelRadius": 14,
          "shellInset": 8,
          "commandPaletteWidth": 740,
          "commandPaletteTopInset": 46,
          "pagePadding": 10,
          "panelGap": 8
        },
        "surfaces": {
          "shellBackground": "color-mix(in srgb, var(--overlay-bg-shell-solid) 92%, transparent)",
          "chromeBackground": "color-mix(in srgb, var(--overlay-bg-topbar) 86%, transparent)",
          "shellShadow": "0 18px 44px rgba(0, 0, 0, 0.38)"
        }
      },
      "explorer": {
        "metrics": {
          "railWidth": 236,
          "previewWidth": 340,
          "chromeInset": 8,
          "toolbarPaddingX": 10,
          "toolbarPaddingY": 6,
          "toolbarGap": 6,
          "panelRadius": 14
        },
        "surfaces": {
          "toolbarBackground": "color-mix(in srgb, var(--overlay-bg-panel) 84%, transparent)",
          "sidebarBackground": "color-mix(in srgb, var(--overlay-bg-sidebar) 92%, transparent)",
          "previewBackground": "color-mix(in srgb, var(--overlay-bg-panel) 84%, transparent)"
        }
      }
    }
  },

  "visuals": [
    {
      "id": "prism-glow-top",
      "backgroundImage": "radial-gradient(ellipse 120% 40% at 30% 0%, rgba(139, 92, 246, 0.14), transparent 70%)",
      "backgroundSize": "100% 100%",
      "backgroundPosition": "center top",
      "backgroundRepeat": "no-repeat",
      "opacity": 0.9,
      "blendMode": "screen",
      "filter": "none",
      "inset": "0"
    },
    {
      "id": "prism-teal-accent",
      "backgroundImage": "radial-gradient(ellipse 80% 50% at 85% 20%, rgba(34, 211, 238, 0.08), transparent 60%)",
      "backgroundSize": "100% 100%",
      "backgroundPosition": "center",
      "backgroundRepeat": "no-repeat",
      "opacity": 0.8,
      "blendMode": "screen",
      "filter": "blur(40px)",
      "inset": "0",
      "animation": {
        "kind": "drift",
        "durationMs": 24000,
        "easing": "ease-in-out",
        "direction": "alternate"
      }
    },
    {
      "id": "prism-vignette",
      "backgroundImage": "radial-gradient(ellipse 70% 70% at 50% 50%, transparent 40%, rgba(0, 0, 0, 0.18) 100%)",
      "backgroundSize": "100% 100%",
      "backgroundPosition": "center",
      "backgroundRepeat": "no-repeat",
      "opacity": 1,
      "blendMode": "multiply",
      "filter": "none",
      "inset": "0"
    }
  ],

  "cssVars": {
    "--obsidian-prism-glow": "rgba(139, 92, 246, 0.35)",
    "--obsidian-prism-teal": "rgba(34, 211, 238, 0.25)",
    "--obsidian-prism-edge": "rgba(168, 85, 247, 0.18)"
  }
}
