{
  "version": 1,
  "id": "appearance-core",
  "name": "Andromeda Appearance",
  "description": "Deep-space palette, frosted observatory chrome, and restrained atmospheric glow.",
  "author": "Codex",
  "tags": [
    "space",
    "minimal",
    "glass",
    "reference"
  ],
  "extendsThemeId": "github-dark",
  "palette": {
    "appBackground": "#03050c",
    "appBackgroundAlt": "#060912",
    "shellBackground": "rgba(7, 10, 19, 0.78)",
    "shellBackgroundSolid": "rgba(8, 11, 21, 0.96)",
    "topBarBackground": "rgba(10, 14, 24, 0.78)",
    "topBarMenuBackground": "rgba(12, 17, 30, 0.94)",
    "sidebarBackground": "rgba(8, 12, 22, 0.8)",
    "panelBackground": "rgba(14, 18, 32, 0.74)",
    "panelAltBackground": "rgba(18, 23, 40, 0.78)",
    "cardBackground": "rgba(18, 24, 42, 0.72)",
    "cardHoverBackground": "rgba(24, 31, 54, 0.86)",
    "contextMenuBackground": "rgba(11, 16, 28, 0.96)",
    "inputBackground": "rgba(8, 12, 22, 0.9)",
    "terminalBackground": "#050814",
    "selectionBackground": "rgba(143, 231, 255, 0.18)",
    "scrimBackground": "rgba(1, 3, 8, 0.62)",
    "textPrimary": "#f6f8ff",
    "textSecondary": "#d5def6",
    "textMuted": "rgba(213, 222, 246, 0.68)",
    "textDim": "rgba(213, 222, 246, 0.42)",
    "textInverse": "#01030a",
    "border": "rgba(156, 179, 233, 0.16)",
    "borderStrong": "rgba(143, 231, 255, 0.38)",
    "accent": "#8fe7ff",
    "accentSoft": "rgba(143, 231, 255, 0.16)",
    "accentContrast": "#031018",
    "success": "#7ef6ca",
    "warning": "#ffd38c",
    "danger": "#ff90ae",
    "info": "#9ab7ff",
    "note": "#c8bbff",
    "todo": "#90cfff",
    "bug": "#ff7da4",
    "prompt": "#ffd7aa"
  },
  "effects": {
    "backgroundImage": "radial-gradient(circle at 18% 20%, rgba(143,231,255,0.16), transparent 26%), radial-gradient(circle at 78% 12%, rgba(200,187,255,0.14), transparent 20%), radial-gradient(circle at 58% 62%, rgba(255,255,255,0.05), transparent 18%), linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0) 28%)",
    "backgroundSize": "cover",
    "backgroundPosition": "center top",
    "shadow": "0 28px 72px rgba(1, 4, 12, 0.56)",
    "overlayShadow": "0 -2px 0 0 rgba(143, 231, 255, 0.36), 0 -32px 84px rgba(1, 4, 12, 0.92)"
  },
  "xterm": {
    "background": "#050814",
    "foreground": "#e8f1ff",
    "cursor": "#8fe7ff",
    "black": "#0a0f1a",
    "red": "#ff829c",
    "green": "#7ff7ca",
    "yellow": "#ffd58f",
    "blue": "#8fbaff",
    "magenta": "#c8bbff",
    "cyan": "#8fe7ff",
    "white": "#e8f1ff",
    "brightBlack": "#51607d",
    "brightRed": "#ff9bb0",
    "brightGreen": "#a7ffd7",
    "brightYellow": "#ffe1ad",
    "brightBlue": "#b5ccff",
    "brightMagenta": "#dbcfff",
    "brightCyan": "#c8f6ff",
    "brightWhite": "#ffffff"
  },
  "fonts": {
    "ui": "\"Space Grotesk\", Inter, system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", \"Cascadia Code\", monospace"
  },
  "visuals": [
    {
      "id": "andromeda-aura",
      "backgroundImage": "radial-gradient(circle at 76% 18%, rgba(143,231,255,0.18), transparent 20%), radial-gradient(circle at 28% 76%, rgba(200,187,255,0.12), transparent 18%), radial-gradient(circle at 54% 52%, rgba(255,255,255,0.05), transparent 14%)",
      "opacity": 0.78,
      "blendMode": "screen",
      "filter": "blur(0px)"
    },
    {
      "id": "andromeda-starlines",
      "backgroundImage": "repeating-radial-gradient(circle at center, rgba(255,255,255,0.22) 0 0.7px, transparent 0.7px 28px), linear-gradient(120deg, transparent 0%, rgba(143,231,255,0.08) 48%, transparent 100%)",
      "backgroundSize": "220px 220px, cover",
      "opacity": 0.16,
      "blendMode": "screen"
    },
    {
      "id": "andromeda-vignette",
      "backgroundImage": "radial-gradient(circle at 50% 42%, transparent 0%, transparent 42%, rgba(0,0,0,0.28) 100%)",
      "opacity": 1,
      "blendMode": "multiply"
    }
  ],
  "cssVars": {
    "--overlay-workbench-brand": "andromeda-bridge",
    "--overlay-explorer-brand": "deep-field",
    "--greeblefs-theme-atmosphere": "andromeda",
    "--greeblefs-theme-star-opacity": "0.42"
  }
}
