{
  "schemaVersion": 1,
  "toolchains": {
    "kain": {
      "id": "kain",
      "displayName": "Kain",
      "compiler": "kain-script",
      "defaultSourceRoot": "D:/Kain-Lang",
      "payloadRoot": "toolchains/kain/payload-runtime",
      "payloadResourcePath": "toolchains/kain/",
      "defaultPayloadProfile": "runtime-bundled",
      "fullPayloadProfile": "full-local",
      "requiredExecutables": [
        "bin/kain.exe"
      ],
      "optionalExecutables": [
        "bin/kn.exe"
      ],
      "payloadDirectories": [
        "stdlib",
        "runtime"
      ],
      "payloadDirectoryExcludes": [
        "runtime/3rdparty",
        "runtime/changelogs",
        "runtime/conformance",
        "runtime/fixtures",
        "runtime/parallel"
      ],
      "payloadProfiles": {
        "runtime-bundled": {
          "payloadDirectories": [
            "stdlib",
            "runtime"
          ],
          "payloadDirectoryExcludes": [
            "runtime/3rdparty",
            "runtime/changelogs",
            "runtime/conformance",
            "runtime/fixtures",
            "runtime/parallel"
          ]
        },
        "full-local": {
          "payloadDirectories": [
            "stdlib",
            "runtime",
            "toolchain",
            "docs"
          ],
          "payloadDirectoryExcludes": []
        }
      },
      "runtimeEnvironment": {
        "KAIN_STDLIB_PATH": "stdlib",
        "KAIN_RUNTIME_MANIFEST_PATH": "runtime/native_runtime.toml",
        "KAIN_RUNTIME_C_PATH": "runtime/kain_runtime.c"
      }
    }
  }
}
