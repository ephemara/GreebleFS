type SettingsSchemaId = String

enum SettingsProofScope:
    Runtime
    UserProfile
    PluginDefaults

struct SettingsProofDescriptor:
    id: SettingsSchemaId
    label: String
    scope: SettingsProofScope
    output_path: String

fn settings_json_field_present(object, key: String) -> Bool:
    if !json_has(object, key):
        return false
    return json_string(json_get(object, key)) != "null"

fn settings_json_string_field(object, key: String, fallback: String) -> String:
    if settings_json_field_present(object, key):
        let value = json_get_string(object, key).trim()
        if len(value) > 0:
            return value
    return fallback

fn settings_scope_name(scope: SettingsProofScope) -> String:
    match scope:
        SettingsProofScope::Runtime => "runtime"
        SettingsProofScope::UserProfile => "user_profile"
        SettingsProofScope::PluginDefaults => "plugin_defaults"
        _ => "unknown"

fn default_settings_output_path(runtime_root: String) -> String:
    return path_join(path_join(runtime_root, "generated"), "settings-proof.json")

fn build_settings_descriptor(payload, runtime_root: String) -> SettingsProofDescriptor:
    let schema_id = settings_json_string_field(payload, "schemaId", "greeblefs.kain.controlPlane")
    let label = settings_json_string_field(payload, "label", "Kain Control Plane Settings")
    let output_path = settings_json_string_field(payload, "outputPath", default_settings_output_path(runtime_root))
    return SettingsProofDescriptor {
        id: schema_id,
        label: label,
        scope: SettingsProofScope::Runtime,
        output_path: output_path,
    }

fn build_default_settings_descriptor(runtime_root: String) -> SettingsProofDescriptor:
    return SettingsProofDescriptor {
        id: "greeblefs.kain.controlPlane",
        label: "Kain Control Plane Settings",
        scope: SettingsProofScope::Runtime,
        output_path: default_settings_output_path(runtime_root),
    }

fn build_settings_field(id: String, label: String, kind: String, default_value: String, summary: String) -> Any:
    let field = json_object_new()
    json_object_set(field, "id", id)
    json_object_set(field, "label", label)
    json_object_set(field, "kind", kind)
    json_object_set(field, "defaultValue", default_value)
    json_object_set(field, "summary", summary)
    return field

fn build_settings_schema_text(descriptor: SettingsProofDescriptor) -> String:
    let schema = json_object_new()
    let fields = json_array_new()
    let generation = json_object_new()

    json_array_push(fields, build_settings_field(
        "kain.controlPlane.enabled",
        "Kain control plane",
        "boolean",
        "true",
        "Enables the resident Kain control-plane runtime for bridge and authoring tasks.",
    ))
    json_array_push(fields, build_settings_field(
        "kain.controlPlane.defaultTarget",
        "Default Kain target",
        "string",
        "ks",
        "Default emitted target for fast control-plane scripts before heavier Wasm/Rust lanes.",
    ))
    json_array_push(fields, build_settings_field(
        "kain.controlPlane.generatedArtifactPolicy",
        "Generated artifact policy",
        "enum",
        "proof-only",
        "Keeps Kain-generated artifacts in proof mode until a host consumer explicitly adopts them.",
    ))

    json_object_set(generation, "source", "src-kain/runtimes/greeblefs-kain-control-plane/src/settings_authoring.kn")
    json_object_set(generation, "strategy", "Kain owns typed settings intent and emits GreebleFS-compatible schema artifacts.")
    json_object_set(generation, "migrationRule", "Never replace the existing settings store until Kain can emit equivalent stable artifacts.")

    json_object_set(schema, "id", descriptor.id)
    json_object_set(schema, "label", descriptor.label)
    json_object_set(schema, "scope", settings_scope_name(descriptor.scope))
    json_object_set(schema, "fields", fields)
    json_object_set(schema, "kain", generation)
    return json_string(schema)

fn build_settings_emit_result(descriptor: SettingsProofDescriptor, schema_text: String) -> Any:
    let result = json_object_new()
    json_object_set(result, "artifactKind", "settings-proof")
    json_object_set(result, "schemaId", descriptor.id)
    json_object_set(result, "outputPath", descriptor.output_path)
    json_object_set(result, "bytes", len(schema_text))
    json_object_set(result, "scope", settings_scope_name(descriptor.scope))
    json_object_set(result, "schemaJson", json_parse(schema_text))
    return result
