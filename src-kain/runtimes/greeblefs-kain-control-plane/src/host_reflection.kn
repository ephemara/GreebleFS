type CapabilityId = String

enum ControlPlaneLane:
    Runtime
    Bridge
    Authoring
    Settings
    Pipeline
    Ffi
    Gpu

struct CapabilityRecord:
    id: CapabilityId
    lane: ControlPlaneLane
    label: String
    summary: String
    implemented: Bool

fn lane_name(lane: ControlPlaneLane) -> String:
    match lane:
        ControlPlaneLane::Runtime => "runtime"
        ControlPlaneLane::Bridge => "bridge"
        ControlPlaneLane::Authoring => "authoring"
        ControlPlaneLane::Settings => "settings"
        ControlPlaneLane::Pipeline => "pipeline"
        ControlPlaneLane::Ffi => "ffi"
        ControlPlaneLane::Gpu => "gpu"
        _ => "unknown"

fn host_capability_to_json(capability: CapabilityRecord) -> Any:
    let item = json_object_new()
    json_object_set(item, "id", capability.id)
    json_object_set(item, "lane", lane_name(capability.lane))
    json_object_set(item, "label", capability.label)
    json_object_set(item, "summary", capability.summary)
    json_object_set(item, "implemented", capability.implemented)
    return item

fn build_capability_record(id: String, lane: ControlPlaneLane, label: String, summary: String, implemented: Bool) -> CapabilityRecord:
    return CapabilityRecord {
        id: id,
        lane: lane,
        label: label,
        summary: summary,
        implemented: implemented,
    }

fn build_control_plane_capabilities() -> Array<Any>:
    let capabilities = json_array_new()
    json_array_push(capabilities, host_capability_to_json(build_capability_record(
        "kain.sidecar.control-plane",
        ControlPlaneLane::Runtime,
        "Kain sidecar control plane",
        "Long-lived Kain process using GreebleFS stdio-json-lines-v2 packets.",
        true,
    )))
    json_array_push(capabilities, host_capability_to_json(build_capability_record(
        "kain.host.reflection",
        ControlPlaneLane::Bridge,
        "Host API reflection",
        "Kain can ask Rust for the host bridge schema and route decisions from that shape.",
        true,
    )))
    json_array_push(capabilities, host_capability_to_json(build_capability_record(
        "kain.plugin.authoring",
        ControlPlaneLane::Authoring,
        "Plugin manifest authoring",
        "Kain owns the plugin/action intent and emits GreebleFS-compatible artifacts.",
        true,
    )))
    json_array_push(capabilities, host_capability_to_json(build_capability_record(
        "kain.settings.authoring",
        ControlPlaneLane::Settings,
        "Settings schema authoring",
        "Kain owns typed settings intent and emits compatibility output before deeper adoption.",
        true,
    )))
    json_array_push(capabilities, host_capability_to_json(build_capability_record(
        "kain.pipeline.orchestration",
        ControlPlaneLane::Pipeline,
        "Pipeline orchestration",
        "Kain coordinates Rust, Tauron, Node, C, GPU, codegen, sidecars, and generated outputs.",
        true,
    )))
    json_array_push(capabilities, host_capability_to_json(build_capability_record(
        "kain.node.ffi",
        ControlPlaneLane::Ffi,
        "Node FFI bridge",
        "Kain can call Node/native packages for fast authoring and build tools.",
        false,
    )))
    json_array_push(capabilities, host_capability_to_json(build_capability_record(
        "kain.c.runtime",
        ControlPlaneLane::Ffi,
        "C runtime bridge",
        "Kain can use C libraries, DLLs, SDKs, and legacy native tools behind explicit lanes.",
        false,
    )))
    json_array_push(capabilities, host_capability_to_json(build_capability_record(
        "kain.gpu.spirv",
        ControlPlaneLane::Gpu,
        "SPIR-V and shader artifacts",
        "Kain can emit GPU artifacts for future preview, lookdev, and compute pipelines.",
        false,
    )))
    return capabilities

fn build_control_plane_actions() -> Array<String>:
    let actions = json_array_new()
    json_array_push(actions, "control-plane.describe")
    json_array_push(actions, "host.reflect")
    json_array_push(actions, "plugin.emit-proof")
    json_array_push(actions, "settings.emit-proof")
    json_array_push(actions, "pipeline.plan")
    return actions

fn build_control_plane_modules() -> Array<String>:
    let modules = json_array_new()
    json_array_push(modules, "server.kn")
    json_array_push(modules, "host_reflection.kn")
    json_array_push(modules, "plugin_authoring.kn")
    json_array_push(modules, "settings_authoring.kn")
    json_array_push(modules, "pipeline_tools.kn")
    return modules

fn build_runtime_metadata(runtime_root: String) -> Any:
    let metadata = json_object_new()
    json_object_set(metadata, "language", "kain")
    json_object_set(metadata, "runtimeId", "greeblefs-kain-control-plane")
    json_object_set(metadata, "compiler", "kain-script")
    json_object_set(metadata, "transport", "stdio-json-lines-v2")
    json_object_set(metadata, "runtimeRoot", runtime_root)
    json_object_set(metadata, "manifestPath", env("KAIN_RUNTIME_MANIFEST_PATH"))
    json_object_set(metadata, "stdlibPath", env("KAIN_STDLIB_PATH"))
    json_object_set(metadata, "payloadRoot", env("GREEBLEFS_KAIN_PAYLOAD_ROOT"))
    return metadata

fn build_control_plane_catalog(runtime_root: String) -> Any:
    let catalog = json_object_new()
    json_object_set(catalog, "id", "greeblefs-kain-control-plane")
    json_object_set(catalog, "label", "GreebleFS Kain Control Plane")
    json_object_set(catalog, "summary", "Kain-authored runtime brain for GreebleFS bridge, plugin, settings, and pipeline authoring.")
    json_object_set(catalog, "runtime", build_runtime_metadata(runtime_root))
    json_object_set(catalog, "actions", build_control_plane_actions())
    json_object_set(catalog, "modules", build_control_plane_modules())
    json_object_set(catalog, "capabilities", build_control_plane_capabilities())
    return catalog

fn build_host_schema_request_payload() -> Any:
    return json_object_new()

fn build_host_reflection_result(runtime_root: String, host_schema: Any) -> Any:
    let result = json_object_new()
    json_object_set(result, "controlPlane", build_control_plane_catalog(runtime_root))
    json_object_set(result, "hostSchema", host_schema)
    json_object_set(result, "routingRule", "Rust describes trusted host methods; Kain plans and emits typed boring glue; Tauron/GreebleFS enforce permissions.")
    return result
