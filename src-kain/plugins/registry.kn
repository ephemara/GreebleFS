fn image_converter_action(id: String, label: String, summary: String, effect: String, sidecar_action_id: String, ffi_lanes: Array<String>) -> Any:
    let item = json_object_new()
    json_object_set(item, "id", id)
    json_object_set(item, "label", label)
    json_object_set(item, "summary", summary)
