fn build_kain_image_converter_plugin() -> Any:
    let plugin = json_object_new()
    let permissions = json_array_new()
    let ffi_capabilities = json_array_new()
    let runtimes = json_array_new()
    let tools = json_array_new()
    let workbenches = json_array_new()
    let preview_workbenches = json_array_new()
    let actions = json_array_new()
    let wasm_targets = json_array_new()
    let cargo_targets = json_array_new()
    let artifacts = json_array_new()
    let runtime = json_object_new()
    let wasm = json_object_new()
    let cargo = json_object_new()
    let artifact = json_object_new()

    append_item(permissions, image_converter_capability("kain.bridge.dispatch", "Kain bridge dispatch", "tauri-view", "Resident Tauron Kain bridge dispatches trusted workbench actions.", "live", true))
    append_item(permissions, image_converter_capability("runtime.ffi.python", "Python image IO", "python", "Pillow-backed resize/convert/ICO/SVG emit path.", "live", true))
    append_item(permissions, image_converter_capability("runtime.ffi.node", "Node asset tools", "node", "Sharp/SVGO path for future high-throughput conversion and vector cleanup.", "declared", false))
    append_item(permissions, image_converter_capability("runtime.ffi.cargo", "Cargo image helpers", "cargo-ffi", "Rust helper crate compiles beside the plugin for future native codecs.", "compiled-helper", false))

    append_item(ffi_capabilities, image_converter_capability("python.pillow.converter", "Python Pillow converter", "python", "Actual trusted image inspect/plan/convert action in the managed Python sidecar.", "live", true))
    append_item(ffi_capabilities, image_converter_capability("node.sharp.svgo", "Node Sharp/SVGO bridge", "node", "Declared Kain Node FFI lane for npm-native image optimization.", "declared", false))
    append_item(ffi_capabilities, image_converter_capability("cargo.image.resvg", "Cargo image/resvg bridge", "cargo-ffi", "Compiled plugin-owned Rust helper target for native image math and future codec calls.", "compiled-helper", false))
    append_item(ffi_capabilities, image_converter_capability("c.native.codecs", "C runtime codecs", "c-runtime", "Future C/DLL codec bridge for SDK-only formats.", "available-in-kain", false))
    append_item(ffi_capabilities, image_converter_capability("wasm.preview.worker", "WASM preview worker", "wasm", "Future Kain-compiled portable image worker.", "declared", false))

    json_object_set(runtime, "id", "kain-image-converter.runtime")
    json_object_set(runtime, "kind", "resident-kain-plugin")
    json_object_set(runtime, "language", "kain")
    json_object_set(runtime, "entry", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(runtime, "transport", "tauron.kain.bridge")
    json_object_set(runtime, "status", "catalog-live")
    json_object_set(runtime, "ffiLanes", string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm"))
    append_item(runtimes, runtime)

    append_item(tools, build_image_converter_tool())
    append_item(workbenches, image_converter_workbench())
    append_item(preview_workbenches, image_converter_preview_workbench())
    append_item(actions, image_converter_action("kain.image.inspect", "Inspect", "Inspect the selected image through the Kain-declared Python FFI lane.", "inspect", "kain.plugin.image_converter.inspect", string_array_2("python", "cargo-ffi")))
    append_item(actions, image_converter_action("kain.image.plan-conversion", "Plan", "Build the output path/format/resize plan before writing bytes.", "plan", "kain.plugin.image_converter.plan", string_array_3("python", "node", "cargo-ffi")))
    append_item(actions, image_converter_action("kain.image.convert", "Convert", "Resize and convert the image through the trusted Python sidecar action declared by this Kain plugin.", "convert", "kain.plugin.image_converter.convert", string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm")))

    json_object_set(wasm, "id", "kain-image-converter-preview-worker")
    json_object_set(wasm, "label", "Kain Image Converter Preview Worker")
    json_object_set(wasm, "source", "usr/plugins-kain/kain-image-converter/plugin.runtime/wasm/image_converter_preview_worker.kn")
    json_object_set(wasm, "target", "plugin.runtime/wasm/dist/image_converter_preview_worker.wasm")
    json_object_set(wasm, "buildTarget", "wasm32-unknown-unknown")
    json_object_set(wasm, "status", "declared")
    append_item(wasm_targets, wasm)

    json_object_set(cargo, "id", "kain-image-converter-cargo-ffi")
    json_object_set(cargo, "label", "Kain Image Converter Cargo FFI")
    json_object_set(cargo, "crateName", "greeblefs-kain-image-tools")
    json_object_set(cargo, "cratePath", "usr/plugins-kain/kain-image-converter/plugin.runtime/cargo/greeblefs-kain-image-tools")
    json_object_set(cargo, "feature", "image-math")
    json_object_set(cargo, "status", "compiled-helper")
    append_item(cargo_targets, cargo)

    json_object_set(artifact, "id", "compat-extension-toml")
    json_object_set(artifact, "kind", "plugin-compat-manifest")
    json_object_set(artifact, "source", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(artifact, "target", "generated/kain-image-converter/extension.toml")
    json_object_set(artifact, "status", "future")
    append_item(artifacts, artifact)

    json_object_set(plugin, "id", "kain-image-converter")
    json_object_set(plugin, "name", "Kain Image Converter")
    json_object_set(plugin, "version", "0.1.0")
    json_object_set(plugin, "description", "First real Kain-native workbench plugin for image inspect, resize, conversion, ICO, SVG, and future Node/Cargo/C/WASM lanes.")
    json_object_set(plugin, "category", "Kain Plugins")
    json_object_set(plugin, "source", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(plugin, "directory", "usr/plugins-kain/kain-image-converter")
    json_object_set(plugin, "manifestPath", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(plugin, "status", "live")
    json_object_set(plugin, "tags", string_array_6("kain", "workbench", "image", "converter", "ffi", "python"))
    json_object_set(plugin, "permissions", permissions)
    json_object_set(plugin, "ffiCapabilities", ffi_capabilities)
    json_object_set(plugin, "runtimes", runtimes)
    json_object_set(plugin, "tools", tools)
    json_object_set(plugin, "workbenches", workbenches)
    json_object_set(plugin, "previewWorkbenches", preview_workbenches)
    json_object_set(plugin, "actions", actions)
    json_object_set(plugin, "wasmTargets", wasm_targets)
    json_object_set(plugin, "cargoFfiTargets", cargo_targets)
    json_object_set(plugin, "generatedArtifacts", artifacts)
    return plugin

fn build_kain_plugin_catalog() -> Any:
    let catalog = json_object_new()
    let plugins = json_array_new()
    let consumers = json_array_new()
    append_item(plugins, build_kain_workbench_smoke_plugin())
    append_item(plugins, build_kain_image_converter_plugin())
    json_array_push(consumers, "src/runtime/kainPluginCatalog.ts")
    json_array_push(consumers, "src/config/pluginPackages.ts")
    json_array_push(consumers, "src/runtime/useFolderPluginRuntime.ts")
    json_array_push(consumers, "usr/plugins-kain/kain-workbench-smoke/plugin.kn")
    json_array_push(consumers, "usr/plugins-kain/kain-image-converter/plugin.kn")

    json_object_set(catalog, "schemaVersion", 1)
    json_object_set(catalog, "kind", "greeblefs.kain.plugin.catalog")
    json_object_set(catalog, "source", "src-kain/plugins/registry.kn")
    json_object_set(catalog, "root", "usr/plugins-kain")
    json_object_set(catalog, "stdlib", "src-kain/plugins/stdlib/greeblefs/plugin.kn")
    json_object_set(catalog, "host", "src/runtime/kainPluginCatalog.ts")
    json_object_set(catalog, "summary", "Parallel Kain-native plugin catalog for workbenches, preview workbenches, trusted actions, tools, FFI, WASM, and Cargo FFI while existing TSX plugins stay intact.")
    json_object_set(catalog, "plugins", plugins)
    json_object_set(catalog, "consumers", consumers)
    return catalog

fn main() -> Any:
    return build_kain_plugin_catalog()
