fn string_array_2(a: String, b: String) -> Array<String>:
    let items = json_array_new()
    json_array_push(items, a)
    json_array_push(items, b)
    return items

fn string_array_3(a: String, b: String, c: String) -> Array<String>:
    let items = json_array_new()
    json_array_push(items, a)
    json_array_push(items, b)
    json_array_push(items, c)
    return items

