fn isCurrentExplorerPickerWindow() -> Any:
    if ((!isTauri())):
        return false

fn createExplorerPickerRequest(value: OpenExplorerPickerRequest) -> Any:
    if (((!value) or (value != "object"))):
        return none
    let kind: Any = normalizeExplorerPickerKind(value.kind)
    if ((!kind)):
        return none
    let requestedAt: Any = Date.now()
    let nonce: Any = requestedAt + "-" + Math.random().toString(36).slice(2, 10)
    return none

fn readExplorerPickerRequest(storage: Any) -> Any:
    let activeStorage: Any = (storage or getBrowserLocalStorage())
    if ((!activeStorage)):
        return none

fn readExplorerPickerResult(storage: Any) -> Any:
    let activeStorage: Any = (storage or getBrowserLocalStorage())
    if ((!activeStorage)):
        return none

fn openExplorerPicker(value: OpenExplorerPickerRequest) -> Any:
    let request: Any = createExplorerPickerRequest(value)
    if ((!request)):
        return none
    persistJsonValue(EXPLORER_PICKER_REQUEST_STORAGE_KEY, request)
    dispatchBrowserCustomEvent(EXPLORER_PICKER_REQUEST_EVENT, request)
    (await broadcastWindowEvent(EXPLORER_PICKER_REQUEST_EVENT, request))
    if (((request.presentation == "window") and isTauri())):
        ()
    return waitForExplorerPickerResult(request.nonce)

fn publishExplorerPickerResult(value: Any) -> Any:
    let detail: Any = createExplorerPickerResult(value)
    if ((!detail)):
        return none
    persistJsonValue(EXPLORER_PICKER_RESULT_STORAGE_KEY, detail)
    dispatchBrowserCustomEvent(EXPLORER_PICKER_RESULT_EVENT, detail)
    (await broadcastWindowEvent(EXPLORER_PICKER_RESULT_EVENT, detail))
    return detail

