    return next

fn inferPreset(appearance: ResolvedOverlayAppearance) -> Any:
    let tags: Any = ts_Set(((appearance.baseTheme.compatibility.tags or [])).map(none).filter(ts_Boolean))
    if (((tags.has("xmb") or tags.has("ps3")) or tags.has("console"))):
        return "xmb"
    if (((tags.has("wii") or tags.has("springboard")) or tags.has("channels"))):
        return "channel-grid"
    return "workbench"

fn createPresetRecipe(preset: OverlayExplorerThemePreset) -> Any:
    if ((preset == "xmb")):
        return none
    else if ((preset == "channel-grid")):
        return none
    else if ((preset == "custom")):
        return none
    else:
        return none

fn inferExplorerPresetFromEngine(appearance: ResolvedOverlayAppearance) -> Any:
    let bindings: Any = resolveThemeEngineBindings(appearance.baseTheme.compiledEngineManifest, appearance.baseTheme.explorer)
    let renderKind: Any = bindings.renderStyle.kind
    if ((renderKind == "ps-3-xmb")):
        return "xmb"
    if (((renderKind == "wii-channels") or (renderKind == "ios-springboard"))):
        return "channel-grid"
    if ((bindings.navigationPattern.kind == "xmb")):
        return "xmb"
    if (((bindings.layoutPrimitive.kind == "grid") and (bindings.navigationPattern.kind == "spatial"))):
        return "channel-grid"
    return undefined

fn getDensitySpacingScale(density: Any) -> Float:
    if ((density == "compact")):
        return 0.92
    else if ((density == "immersive")):
        return 1.16
    else:
        return 1

fn getIconStyleScale(iconStyle: Any) -> Float:
    if ((iconStyle == "pixel")):
        return 0.94
    else if ((iconStyle == "skeuomorphic")):
        return 1.18
    else:
        return 1

fn getHoverLiftFromMotion(motionStyle: Any) -> Float:
    if ((motionStyle == "instant")):
        return 0
    else if ((motionStyle == "snappy")):
        return 1
    else if ((motionStyle == "dramatic")):
        return 4
    else:
        return 2

fn createExplorerStyleSeed(appearance: ResolvedOverlayAppearance) -> Any:
    let chromeStyle: Any = appearance.baseTheme.compiledEngineManifest.manifest.presentation.chromeStyle
    if ((chromeStyle == "floating")):
        return none
    else if ((chromeStyle == "minimal")):
        return none
    else if ((chromeStyle == "ornate")):
        return none
    else:
        return none

fn createExplorerEngineRecipe(appearance: ResolvedOverlayAppearance) -> Any:
    if ((!appearance.baseTheme.compiledEngineManifest)):
        return none
    let userRecipe: Any = appearance.baseTheme.explorer
    let bindings: Any = resolveThemeEngineBindings(appearance.baseTheme.compiledEngineManifest, userRecipe)
    let presentation: Any = bindings.presentation
    let layoutPrimitive: Any = bindings.layoutPrimitive
    let navigationPattern: Any = bindings.navigationPattern
    let renderStyle: Any = bindings.renderStyle
    let navigationProps: Any = navigationPattern.props
    let styleSeed: Any = createExplorerStyleSeed(appearance)
    let spacingScale: Any = getDensitySpacingScale(presentation.density)
    let panelSpacing: Any = clampNumber(Math.round((presentation.panelSpacing or workbenchMetrics.toolbarGap)), 4, 24)
    let panelRadius: Any = clampNumber(Math.round((presentation.cornerRadius or workbenchMetrics.panelRadius)), 8, 48)
    let controlRadius: Any = clampNumber(Math.round((((presentation.cornerRadius or workbenchMetrics.controlRadius)) * 0.9)), 4, 999)
    let layoutGap: Any = ((readThemeNumberProp(layoutPrimitive.props, "gap") or readThemeNumberProp(layoutPrimitive.props, "gutter")) or panelSpacing)
    let layoutSide: Any = readThemeStringProp(layoutPrimitive.props, "side")
    let railPosition: Option<Any> = none
    let toolbarStyle: Any = styleSeed.toolbarStyle
    let breadcrumbStyle: Any = styleSeed.breadcrumbStyle
    let selectionStyle: Any = styleSeed.selectionStyle
    let hoverStyle: Any = styleSeed.hoverStyle
    let previewStyle: Any = styleSeed.previewStyle
    let statusBarStyle: Any = styleSeed.statusBarStyle
    let labelMode: Any = styleSeed.labelMode
    let preferredViewMode: Option<Any> = none
    let preferredExperimentalViewMode: Option<Any> = none
    let railWidth: Any = none
    let previewWidth: Any = none
    let chromeInset: Any = none
    let toolbarPaddingX: Any = Math.max(8, Math.round((panelSpacing + 2)))
    let toolbarPaddingY: Any = Math.max(6, Math.round((panelSpacing * 0.7)))
    let toolbarGap: Any = Math.max(6, Math.round(layoutGap))
    let metricsSpacingScale: Any = spacingScale
    let gridScale: Any = none
    let rowHeightScale: Any = none
    let iconScale: Any = getIconStyleScale(presentation.iconStyle)
    let hoverLiftPx: Any = getHoverLiftFromMotion(presentation.motionStyle)
    if ((layoutPrimitive.kind == "grid")):
        preferredViewMode = "icons-xl"
        labelMode = "stacked"
        previewWidth = Math.max(previewWidth, 420)
    else if ((layoutPrimitive.kind == "freeform")):
        preferredViewMode = "icons-l"
        labelMode = "stacked"
        previewStyle = none
        gridScale = Math.max(gridScale, 1.1)
    else if ((layoutPrimitive.kind == "split")):
        preferredViewMode = "columns"
        labelMode = "inline"
        previewWidth = Math.max(previewWidth, 460)
    else if ((layoutPrimitive.kind == "stack")):
        preferredViewMode = "details"
        labelMode = "inline"
    else if ((layoutPrimitive.kind == "dock")):
        preferredViewMode = "list"
        railWidth = Math.max(railWidth, 232)
    else:
        ()
    if ((navigationPattern.kind == "xmb")):
        toolbarStyle = "floating"
        breadcrumbStyle = "capsule"
        selectionStyle = "glow"
        hoverStyle = "glow"
        previewStyle = "glass"
        statusBarStyle = "floating"
        labelMode = "stacked"
        preferredViewMode = (preferredViewMode or "icons-xl")
        preferredExperimentalViewMode = "adaptive-semantic-grid"
        gridScale = Math.max(gridScale, 1.2)
        iconScale = Math.max(iconScale, 1.2)
        hoverLiftPx = Math.max(hoverLiftPx, 3)
    else if ((navigationPattern.kind == "spatial")):
        breadcrumbStyle = "capsule"
        selectionStyle = "outline"
        hoverStyle = "lift"
        previewStyle = none
        labelMode = "stacked"
        preferredViewMode = (preferredViewMode or "icons-xl")
        gridScale = Math.max(gridScale, 1.14)
    else if ((navigationPattern.kind == "hierarchy")):
        breadcrumbStyle = "segmented"
        selectionStyle = "outline"
        hoverStyle = "lift"
        labelMode = "inline"
        preferredViewMode = (preferredViewMode or "columns")
    else if ((navigationPattern.kind == "palette")):
        toolbarStyle = none
        previewStyle = "attached"
        preferredViewMode = (preferredViewMode or "list")
    else if ((navigationPattern.kind == "tabbed")):
        breadcrumbStyle = "segmented"
        preferredViewMode = (preferredViewMode or "columns")
    else:
        ()
    if ((renderStyle.kind == "ps-3-xmb")):
        toolbarStyle = "floating"
        breadcrumbStyle = "capsule"
        selectionStyle = "glow"
        hoverStyle = "glow"
        previewStyle = "glass"
        statusBarStyle = "floating"
        preferredViewMode = "icons-xl"
        preferredExperimentalViewMode = "adaptive-semantic-grid"
        controlRadius = 999
        railWidth = Math.max(railWidth, 232)
        previewWidth = Math.max(previewWidth, 460)
        chromeInset = Math.max(chromeInset, 12)
        gridScale = Math.max(gridScale, 1.2)
        iconScale = Math.max(iconScale, 1.3)
        hoverLiftPx = Math.max(hoverLiftPx, 4)
    else if ((renderStyle.kind == "wii-channels")):
        toolbarStyle = "minimal"
        breadcrumbStyle = "segmented"
        selectionStyle = "outline"
        hoverStyle = "lift"
        previewStyle = "floating"
        statusBarStyle = "hidden"
        preferredViewMode = "icons-xl"
        railWidth = Math.max(railWidth, 244)
        previewWidth = Math.max(previewWidth, 420)
        chromeInset = Math.max(chromeInset, 10)
        gridScale = Math.max(gridScale, 1.24)
        iconScale = Math.max(iconScale, 1.2)
    else if ((renderStyle.kind == "ios-springboard")):
        toolbarStyle = "minimal"
        breadcrumbStyle = "plain"
        selectionStyle = "outline"
        hoverStyle = "lift"
        previewStyle = "floating"
        statusBarStyle = "hidden"
        preferredViewMode = "icons-xl"
        labelMode = "stacked"
        railWidth = Math.max(railWidth, 220)
        previewWidth = Math.max(previewWidth, 400)
        chromeInset = Math.max(chromeInset, 8)
        gridScale = Math.max(gridScale, 1.22)
        iconScale = Math.max(iconScale, 1.12)
    else if ((renderStyle.kind == "desktop-window-manager")):
        toolbarStyle = "solid"
        breadcrumbStyle = "plain"
        selectionStyle = "fill"
        hoverStyle = "fill"
        previewStyle = "attached"
        statusBarStyle = "solid"
        preferredViewMode = (preferredViewMode or "details")
        labelMode = "inline"
        railWidth = Math.max(railWidth, 260)
    else:
        ()
    let railRecipe: Any = none
    let workspaceTabsRecipe: Any = none
    let railSectionOrder: Any = normalizeExplorerRailSectionOrder(readThemeStringProp(navigationProps, "railSectionOrder").split(",").map(none).filter(ts_Boolean))
    let railHiddenSectionIds: Any = normalizeExplorerRailSectionOrder(readThemeStringProp(navigationProps, "railHiddenSectionIds").split(",").map(none).filter(ts_Boolean))
    if ((navigationPattern.kind == "hierarchy")):
        railRecipe = normalizeExplorerRailThemeRecipe(none, railRecipe)
    else if ((navigationPattern.kind == "palette")):
        railRecipe = normalizeExplorerRailThemeRecipe(none, railRecipe)
    if ((navigationPattern.kind == "tabbed")):
        workspaceTabsRecipe = normalizeExplorerWorkspaceTabsThemeRecipe(none, workspaceTabsRecipe)
    else if (((navigationPattern.kind == "xmb") or (navigationPattern.kind == "spatial"))):
        workspaceTabsRecipe = normalizeExplorerWorkspaceTabsThemeRecipe(none, workspaceTabsRecipe)
    railRecipe = normalizeExplorerRailThemeRecipe(none, railRecipe)
    workspaceTabsRecipe = normalizeExplorerWorkspaceTabsThemeRecipe(none, workspaceTabsRecipe)
    return none

