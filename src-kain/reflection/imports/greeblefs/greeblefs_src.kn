fn getPathLeaf(path: String) -> Any:
    let trimmed: Any = path.trim()
    if (((!trimmed) or isExplorerHomePath(trimmed))):
        return "Home"
    if (isExplorerArchiveVirtualPath(trimmed)):
        return getExplorerArchiveVirtualCurrentFolderName(trimmed)
    let parts: Any = trimmed.split(none).filter(ts_Boolean)
    return none

fn getPathParent(path: String) -> Any:
    let trimmed: Any = path.trim().replace(none, "")
    if ((!trimmed)):
        return none
    if (isExplorerArchiveVirtualPath(trimmed)):
        return getExplorerArchiveVirtualParentPath(trimmed)
    if ("/^[A-Za-z]:$/".test_(trimmed)):
        return trimmed + none
    let nextPath: Any = trimmed.replace(none, "")
    if ((nextPath == trimmed)):
        return none
    if ("/^[A-Za-z]:$/".test_(nextPath)):
        return nextPath + none
    return (nextPath or (none))

fn isSameOrDescendantPath(path: String, candidate: String) -> Any:
    let normalizedPath: Any = path.trim().replace(none, "")
    let normalizedCandidate: Any = candidate.trim().replace(none, "")
    if (((!normalizedPath) or (!normalizedCandidate))):
        return false
    if ((normalizedPath == normalizedCandidate)):
        return true
    return ((normalizedPath.startsWith(normalizedCandidate + "/") or normalizedPath.startsWith(normalizedCandidate + none)))

fn shouldRefreshExplorerForTransferEvent(currentPath: String, detail: FileOperationsTransferCompletedEventDetail) -> Any:
    let normalizedCurrentPath: Any = currentPath.trim()
    if ((!normalizedCurrentPath)):
