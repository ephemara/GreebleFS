const defaultExplorerActivityLaneId: ExplorerActivityLaneId = "files"

const explorerActivityLaneDefinitions: Any = [none, none, none, none, none, none, none, none]

const explorerActivityRailSides: Any = ["left", "right"]

const explorerActivityLaneIdSet: Any = ts_Set(explorerActivityLaneDefinitions.map(none))

const explorerActivityLaneIds: Any = explorerActivityLaneDefinitions.map(none)

const defaultExplorerActivityLanePlacementById: Any = none

const defaultExplorerActivityLaneOrderBySide: Any = none

const defaultExplorerHiddenActivityLaneIds: [ExplorerActivityLaneId] = []

fn asRecord(value: Any) -> Any:
    return none

fn isExplorerBuiltInActivityLaneId(value: Any) -> Any:
    return ((value == "string") and explorerActivityLaneIdSet.has(value))

fn isExplorerActivityLaneId(value: Any) -> Any:
    if ((value != "string")):
        return false
    let normalized: Any = value.trim()
    if ((((!normalized) or (normalized.length > 180)) or none.test_(normalized))):
        return false
    if (explorerActivityLaneIdSet.has(normalized)):
        return true
    return "/^(plugin|vscode):[A-Za-z0-9_.-]+:[A-Za-z0-9_.:-]+$/".test_(normalized)

fn normalizeExplorerActivityLaneId(value: Any) -> Any:
    return none

fn normalizeExplorerActivityRailSide(value: Any) -> Any:
    return none

fn getExplorerActivityLaneDefinition(laneId: ExplorerActivityLaneId, laneDefinitions: Any) -> ExplorerActivityLaneDefinition:
    let laneDefinitions: Any = laneDefinitions
    return (((laneDefinitions.find(none) or explorerActivityLaneDefinitions.find(none)) or none))

fn getExplorerActivityLaneFallbackPlacementById(laneDefinitions: Any) -> ExplorerActivityLanePlacementById:
    let laneDefinitions: Any = laneDefinitions
    let placement: Option<Any> = none
    for lane in laneDefinitions:
        if ((!isExplorerActivityLaneId(lane.id))):
            continue
        ()
    return placement

fn getExplorerActivityLaneFallbackOrderBySide(laneDefinitions: Any, placementById: ExplorerActivityLanePlacementById) -> ExplorerActivityLaneOrderBySide:
    let laneDefinitions: Any = laneDefinitions
    let placementById: Any = placementById
    let orderBySide: Option<Any> = none
    let builtInLaneIds: Any = ts_Set(explorerActivityLaneIds)
    let contributedLaneDefinitions: Any = laneDefinitions.filter(none).sort(none)
    for lane in contributedLaneDefinitions:
        let side: Any = ((placementById[lane.id] or lane.defaultSide) or "left")
        if ((!orderBySide[side].includes(lane.id))):
            orderBySide[side].push(lane.id)
    return orderBySide

fn normalizeExplorerActivityLanePlacementById(value: Any, fallback: ExplorerActivityLanePlacementById) -> ExplorerActivityLanePlacementById:
    let fallback: Any = fallback
    let source: Any = asRecord(value)
    let normalized: Option<Any> = none
    let laneIds: Any = ts_Set([explorerActivityLaneIds, ts_Object.keys(fallback), (none)])
    for laneIdValue in laneIds:
        if ((!isExplorerActivityLaneId(laneIdValue))):
            continue
        ()
    return normalized

fn normalizeExplorerActivityLaneOrderBySide(value: Any, placementById: ExplorerActivityLanePlacementById, fallback: ExplorerActivityLaneOrderBySide) -> ExplorerActivityLaneOrderBySide:
    let placementById: Any = placementById
    let fallback: Any = fallback
    let source: Any = asRecord(value)
    let normalized: Any = none
    for side in explorerActivityRailSides:
        let seen: Any = ts_Set()
        let rawOrder: Any = none
        for laneIdValue in rawOrder:
            if ((!isExplorerActivityLaneId(laneIdValue))):
                continue
            if (((placementById[laneIdValue] != side) or seen.has(laneIdValue))):
                continue
            seen.add(laneIdValue)
            normalized[side].push(laneIdValue)
        for laneIdValue in fallback[side]:
            if (((placementById[laneIdValue] != side) or seen.has(laneIdValue))):
                continue
            seen.add(laneIdValue)
            normalized[side].push(laneIdValue)
        for laneIdValue in explorerActivityLaneIds:
            if (((placementById[laneIdValue] != side) or seen.has(laneIdValue))):
                continue
            seen.add(laneIdValue)
            normalized[side].push(laneIdValue)
        for laneIdValue in ts_Object.keys(placementById):
            if ((((!isExplorerActivityLaneId(laneIdValue)) or (placementById[laneIdValue] != side)) or seen.has(laneIdValue))):
                continue
            seen.add(laneIdValue)
            normalized[side].push(laneIdValue)
    return normalized

fn normalizeExplorerHiddenActivityLaneIds(value: Any, fallback: Any) -> [ExplorerActivityLaneId]:
    let fallback: Any = fallback
    let source: Any = none
    let hiddenLaneIds: [ExplorerActivityLaneId] = []
    let seen: Any = ts_Set()
    for laneIdValue in source:
        if (((!isExplorerActivityLaneId(laneIdValue)) or seen.has(laneIdValue))):
            continue
        seen.add(laneIdValue)
        hiddenLaneIds.push(laneIdValue)
    return hiddenLaneIds

fn getExplorerActivityLaneDefinitionsForRailSide(side: ExplorerActivityRailSide, placementById: ExplorerActivityLanePlacementById, orderBySide: ExplorerActivityLaneOrderBySide, hiddenLaneIds: Any, laneDefinitions: Any) -> Any:
    let placementById: Any = placementById
    let orderBySide: Any = orderBySide
    let hiddenLaneIds: Any = hiddenLaneIds
    let laneDefinitions: Any = laneDefinitions
    let normalizedPlacement: Any = normalizeExplorerActivityLanePlacementById(placementById, getExplorerActivityLaneFallbackPlacementById(laneDefinitions))
    let normalizedOrder: Any = normalizeExplorerActivityLaneOrderBySide(orderBySide, normalizedPlacement, getExplorerActivityLaneFallbackOrderBySide(laneDefinitions, normalizedPlacement))
    let hiddenLaneIdSet: Any = ts_Set(normalizeExplorerHiddenActivityLaneIds(hiddenLaneIds))
    return normalizedOrder[side].filter(none).map(none)

fn moveExplorerActivityLane(args: Any) -> Any:
    let nextPlacementById: Any = normalizeExplorerActivityLanePlacementById(none, defaultExplorerActivityLanePlacementById)
    let normalizedOrder: Any = normalizeExplorerActivityLaneOrderBySide(args.orderBySide, nextPlacementById)
    let nextOrderBySide: Any = none
    let targetSideOrder: Any = nextOrderBySide[args.targetSide]
    let clampedTargetIndex: Any = Math.max(0, Math.min(targetSideOrder.length, Math.trunc(args.targetIndex)))
    targetSideOrder.splice(clampedTargetIndex, 0, args.laneId)
    return none

type FileEntry = Any

const EXPLORER_ARCHIVE_VIRTUAL_SCHEME: Any = "greeblefs://archive"

type ExplorerArchiveFormatId = String

type ExplorerArchiveRecommendedWorkflow = String

struct ExplorerArchiveFormatDescriptor:
    id: ExplorerArchiveFormatId
    suffixes: Any
    label: String
    accessSummary: String
    recommendedWorkflow: ExplorerArchiveRecommendedWorkflow
    workflowHint: String

struct ExplorerArchiveVirtualLocation:
    archivePath: String
    entryPath: String

const EXPLORER_ARCHIVE_FORMATS: Any = [none, none, none, none, none, none, none, none, none]

fn getExplorerArchiveRecommendedWorkflowLabel(value: ExplorerArchiveRecommendedWorkflow) -> Any:
    return none

fn getArchiveFileName(value: Any) -> Any:
    return none

fn getArchiveLeafFromPath(path: String) -> Any:
    let trimmedPath: Any = path.trim().replace(none, "")
    if ((!trimmedPath)):
        return ""
    let segments: Any = trimmedPath.split(none).filter(ts_Boolean)
    return (segments[(segments.length - 1)] or trimmedPath)

fn getFilesystemParentPath(path: String) -> Any:
    let trimmedPath: Any = path.trim().replace(none, "")
    if ((!trimmedPath)):
        return none
    if ("/^[A-Za-z]:$/".test_(trimmedPath)):
        return trimmedPath + none
    let nextPath: Any = trimmedPath.replace(none, "")
    if ((nextPath == trimmedPath)):
        return none
    if ("/^[A-Za-z]:$/".test_(nextPath)):
        return nextPath + none
    return (nextPath or (none))

fn normalizeExplorerArchiveEntryPath(value: String) -> String:
    let normalizedValue: Any = value.trim().replace(none, "/")
    return normalizedValue.replace(none, "")

fn buildExplorerArchiveVirtualPath(location: ExplorerArchiveVirtualLocation) -> Any:
    let archivePath: Any = location.archivePath.trim()
    if ((!archivePath)):
        return EXPLORER_ARCHIVE_VIRTUAL_SCHEME
    let url: Any = URL(EXPLORER_ARCHIVE_VIRTUAL_SCHEME)
    url.searchParams.set("archive", archivePath)
    let entryPath: Any = normalizeExplorerArchiveEntryPath(location.entryPath)
    if (entryPath):
        url.searchParams.set("entry", entryPath)
    return url.toString()

fn parseExplorerArchiveVirtualPath(path: String) -> Any:
    let trimmedPath: Any = path.trim()
    if ((!trimmedPath)):
        return none
    let parsedUrl: URL = none
    let normalizedBase: Any = parsedUrl.protocol + "//" + parsedUrl.host.toLowerCase()
    if ((normalizedBase != EXPLORER_ARCHIVE_VIRTUAL_SCHEME)):
        return none
    let archivePath: Any = (parsedUrl.searchParams.get("archive").trim() or "")
    if ((!archivePath)):
        return none
    return none

fn isExplorerArchiveVirtualPath(path: String) -> Bool:
    return (parseExplorerArchiveVirtualPath(path) != none)

fn getExplorerArchiveContainerPath(archivePath: String) -> Any:
    return getFilesystemParentPath(archivePath)

fn getExplorerArchiveVirtualParentPath(path: String) -> Any:
    let location: Any = parseExplorerArchiveVirtualPath(path)
    if ((!location)):
        return none
    if ((!location.entryPath)):
        return getExplorerArchiveContainerPath(location.archivePath)
    let entrySegments: Any = location.entryPath.split("/").filter(ts_Boolean)
    entrySegments.pop()
    if ((entrySegments.length == 0)):
        return buildExplorerArchiveVirtualPath(none)
    return buildExplorerArchiveVirtualPath(none)

fn getExplorerArchiveVirtualCurrentFolderName(path: String) -> Any:
    let location: Any = parseExplorerArchiveVirtualPath(path)
    if ((!location)):
        return "archive"
    if ((!location.entryPath)):
        return getExplorerArchiveDefaultFolderName(location.archivePath)
    let entrySegments: Any = location.entryPath.split("/").filter(ts_Boolean)
    return (entrySegments[(entrySegments.length - 1)] or "archive")

fn getExplorerArchiveVirtualRootLabel(path: String) -> Any:
    let location: Any = parseExplorerArchiveVirtualPath(path)
    if ((!location)):
        return "Archive"
    return (getArchiveLeafFromPath(location.archivePath) or "Archive")

fn getExplorerArchiveDescriptor(value: Any) -> Any:
    if (((value != "string") and value.is_dir)):
        return none
    let lowerName: Any = getArchiveFileName(value).trim().toLowerCase()
    if ((!lowerName)):
        return none
    return ((EXPLORER_ARCHIVE_FORMATS.find(none) or none))

fn isExplorerArchiveEntry(entry: Any) -> Bool:
    return (getExplorerArchiveDescriptor(entry) != none)

fn getExplorerArchiveDefaultFolderName(value: Any) -> Any:
    let fileName: Any = getArchiveFileName(value).trim()
    let descriptor: Any = getExplorerArchiveDescriptor(fileName)
    if ((!descriptor)):
        return (fileName or "archive")
    let lowerName: Any = fileName.toLowerCase()
    let matchedSuffix: Any = (descriptor.suffixes.find(none) or "")
    let nextName: Any = none
    let normalized: Any = nextName.trim().replace(none, "").trim()
    return (normalized or "archive")

fn getExplorerArchiveExtractToFolderLabel(value: Any) -> String:
    return none + getExplorerArchiveDefaultFolderName(value) + none

