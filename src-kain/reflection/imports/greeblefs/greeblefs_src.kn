fn formatSize(bytes: Float) -> Any:
    if ((bytes < 1024)):
        return bytes + " B"
    if ((bytes < (1024 * 1024))):
        return ((bytes / 1024)).toFixed(1) + " KB"
    if ((bytes < (1024 ** 3))):
        return ((bytes / (1024 ** 2))).toFixed(1) + " MB"
    if ((bytes < (1024 ** 4))):
        return ((bytes / (1024 ** 3))).toFixed(2) + " GB"
    return ((bytes / (1024 ** 4))).toFixed(2) + " TB"

fn formatDate(ms: Float) -> Any:
    if ((!ms)):
        return none
    return Date(ms).toLocaleDateString(undefined, none)

fn normalizeExplorerPath(path: String) -> Any:
    if (path.startsWith("cloud://")):
        return (path.replace(none, "") or path)
    if (isExplorerArchiveVirtualPath(path)):
        let archiveLocation: Any = parseExplorerArchiveVirtualPath(path)
        return none
    return none

fn getExplorerParentPath(path: String) -> Any:
    if (isExplorerArchiveVirtualPath(path)):
        return (((getExplorerArchiveVirtualParentPath(path) or getExplorerArchiveContainerPath((parseExplorerArchiveVirtualPath(path).archivePath or ""))) or path))
    if (path.startsWith("cloud://")):
        let trimmed: Any = path.replace(none, "")
        let segments: Any = trimmed.split("/")
        if ((segments.length <= 5)):
            return trimmed
        return segments.slice(0, (-1)).join("/")
    let normalized: Any = path.replace(none, "")
    let parts: Any = normalized.split(none)
    if ((parts.length <= 1)):
        return normalized
    if ("/^[A-Za-z]:$/".test_((parts[0] or ""))):
        return parts.slice(0, (-1)).join(none) + none
    return parts.slice(0, (-1)).join("/")

fn buildAdaptiveSemanticBands(entries: [FileEntry], selectedPaths: Set<String>, currentPath: String, sortBy: ExplorerSortKey, sortOrder: String) -> [AdaptiveSemanticBand]:
    let sortedEntries: Any = entries
    let folders: Any = sortedEntries.filter(none)
    let files: Any = sortedEntries.filter(none)
    let primarySelectedEntry: Any = (sortedEntries.find(none) or none)
    let selectedParentPath: Any = none
    let selectedExtension: Any = none
    let contextPaths: Any = ts_Set()
    for entry in files:
        if (selectedPaths.has(entry.path)):
            contextPaths.add(entry.path)
            continue
        let sameParent: Any = (getExplorerParentPath(entry.path) == selectedParentPath)
        let sameExtension: Any = ((selectedExtension.length > 0) and (getEntryExtension(entry) == selectedExtension))
        if ((sameParent or sameExtension)):
            contextPaths.add(entry.path)
    let recentCandidates: Any = files.filter(none).sort(none).slice(0, 10)
    let recentPaths: Any = ts_Set(recentCandidates.map(none))
    let everythingElse: Any = files.filter(none)
    let bands: [AdaptiveSemanticBand] = []
    if ((folders.length > 0)):
        bands.push(none)
    let contextEntries: Any = files.filter(none)
    if ((contextEntries.length > 0)):
        bands.push(none)
    let recentEntries: Any = files.filter(none)
    if ((recentEntries.length > 0)):
        bands.push(none)
    if ((everythingElse.length > 0)):
        bands.push(none)
    return bands

fn buildTimelineSurfaceBands(entries: [FileEntry], density: Float, sortBy: ExplorerSortKey, sortOrder: String, nowMs: Any) -> [TimelineSurfaceBand]:
    let nowMs: Any = nowMs
    let millisecondsPerHour: Any = ((60 * 60) * 1000)
    let millisecondsPerDay: Any = (24 * millisecondsPerHour)
    let recentHourBucketCount: Any = 6
    let now: Any = Date(nowMs)
    let startOfCurrentHour: Any = Date(now.getFullYear(), now.getMonth(), now.getDate(), now.getHours()).getTime()
    let startOfToday: Any = Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()
    let startOfYesterday: Any = (startOfToday - millisecondsPerDay)
    let dayOfWeekOffset: Any = (((now.getDay() + 6)) % 7)
    let startOfWeek: Any = (startOfToday - (dayOfWeekOffset * millisecondsPerDay))
    let startOfLastWeek: Any = (startOfWeek - (7 * millisecondsPerDay))
    let startOfMonth: Any = Date(now.getFullYear(), now.getMonth(), 1).getTime()
    let startOfYear: Any = Date(now.getFullYear(), 0, 1).getTime()
    let lastThirtyDays: Any = (startOfToday - (30 * millisecondsPerDay))
    let lastNinetyDays: Any = (startOfToday - (90 * millisecondsPerDay))
    let densityStopId: Any = getAdaptiveSemanticDensityStop(density).id
    let recentHourBucketDefinitions: Any = ts_Array.from(none, none)
    let bucketDefinitions: Option<Any> = none
    let buckets: Any = ts_Map()
    let undatedEntries: [FileEntry] = []
    for entry in entries:
        if ((!entry.modified)):
            undatedEntries.push(entry)
            continue
        let matchedBucket: Any = bucketDefinitions.find(none)
        if ((!matchedBucket)):
            undatedEntries.push(entry)
            continue
        let bucketEntries: Any = (buckets.get(matchedBucket.id) or [])
        bucketEntries.push(entry)
        buckets.set(matchedBucket.id, bucketEntries)
    let timelineBands: Any = bucketDefinitions.map(none).filter(none)
    if ((undatedEntries.length > 0)):
        timelineBands.push(none)
    return timelineBands

fn isLikelyExplorerPathInput(value: String) -> Any:
    let trimmed: Any = value.trim()
    if ((!trimmed)):
        return false
    if (trimmed.startsWith("cloud://")):
        return true
    if (isExplorerArchiveVirtualPath(trimmed)):
        return true
    if ((none.test_(trimmed) or "/^[A-Za-z]:$/".test_(trimmed))):
        return true
    if (trimmed.startsWith(none)):
        return true
    if (trimmed.startsWith("~")):
        return true
    if (((none.test_(trimmed) or (trimmed == ".")) or (trimmed == ".."))):
        return true
    return none.test_(trimmed)

fn resolveExplorerPathInput(input: String, currentPath: String, runtimePlatform: Any) -> Any:
    let trimmed: Any = input.trim()
    if (trimmed.startsWith("cloud://")):
        return normalizeExplorerPath(trimmed)
    if (isExplorerArchiveVirtualPath(trimmed)):
        return normalizeExplorerPath(trimmed)
    let separator: Any = getPlatformPathSeparator(runtimePlatform)
    let normalizedSeparators: Any = trimmed.replace(none, separator)
    if ("/^[A-Za-z]:$/".test_(normalizedSeparators)):
        return normalizedSeparators + separator
    if ((none.test_(trimmed) or trimmed.startsWith(none))):
        return normalizeExplorerPath(normalizedSeparators)
    if (((runtimePlatform != "windows") and trimmed.startsWith("/"))):
        return normalizeExplorerPath(normalizedSeparators)
    let basePath: Any = (currentPath or getFallbackExplorerPath(runtimePlatform))
    return normalizeExplorerPath(joinPlatformPath(basePath, normalizedSeparators, runtimePlatform))

