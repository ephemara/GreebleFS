component WorkbenchIdeShell(appearance: Any, surfaces: Any, surfaceSeeds: Any, layoutState: Any, onLayoutStateChange: Any, onRequestFocusSurface: Any, onRequestExternalizeSurface: Any, renderSurfaceBody: Any) with Reactive:
    state theme: Any = appearance.theme
