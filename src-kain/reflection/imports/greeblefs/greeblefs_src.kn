        ()
        index = (index + 1)
    return none

type ExplorerImageStageTransform = Any

const DEFAULT_EXPLORER_IMAGE_STAGE_TRANSFORM: Option<Any> = none

const EXPLORER_IMAGE_STAGE_MIN_SCALE: Any = 0.5

const EXPLORER_IMAGE_STAGE_MAX_SCALE: Any = 6

const EXPLORER_IMAGE_STAGE_ZOOM_SENSITIVITY: Any = 0.0015

const EXPLORER_PREVIEW_STAGE_CHECKERBOARD_BACKGROUND_IMAGE: Any = none

const EXPLORER_PREVIEW_STAGE_CHECKERBOARD_BACKGROUND_SIZE: Any = "16px 16px"

const EXPLORER_PREVIEW_STAGE_CHECKERBOARD_BACKGROUND_POSITION: Any = "0 0, 0 8px, 8px -8px, -8px 0px"

const EXPLORER_PREVIEW_STAGE_CHECKERBOARD_BACKGROUND_COLOR: Any = "rgba(0,0,0,0.4)"

fn clampExplorerImageStageValue(value: Float, min: Float, max: Float) -> Float:
    return Math.min(max, Math.max(min, value))

fn normalizeExplorerImageStageTransform(transform: ExplorerImageStageTransform, viewport: Any, content: Any) -> Any:
    let nextScale: Any = ts_Number(clampExplorerImageStageValue(transform.scale, EXPLORER_IMAGE_STAGE_MIN_SCALE, EXPLORER_IMAGE_STAGE_MAX_SCALE).toFixed(2))
    if (((!viewport) or (!content))):
        return none
    let viewportWidth: Any = viewport.clientWidth
    let viewportHeight: Any = viewport.clientHeight
    let baseWidth: Any = content.clientWidth
    let baseHeight: Any = content.clientHeight
    if (((((viewportWidth <= 0) or (viewportHeight <= 0)) or (baseWidth <= 0)) or (baseHeight <= 0))):
        return none
    let scaledWidth: Any = (baseWidth * nextScale)
    let scaledHeight: Any = (baseHeight * nextScale)
    let maxOffsetX: Any = Math.max(0, (((scaledWidth - viewportWidth)) / 2))
    let maxOffsetY: Any = Math.max(0, (((scaledHeight - viewportHeight)) / 2))
    return none

fn applyExplorerImageStageWheelZoom(args: Any) -> Any:
    let _: Any = args
    let currentTransform: Any = none
    let viewport: Any = none
    let content: Any = none
    let clientX: Any = none
    let clientY: Any = none
    let deltaY: Any = none
    if ((!viewport)):
        return currentTransform
    let zoomFactor: Any = Math.exp(((-deltaY) * EXPLORER_IMAGE_STAGE_ZOOM_SENSITIVITY))
    let viewportRect: Any = viewport.getBoundingClientRect()
    let focusX: Any = ((clientX - viewportRect.left) - (viewportRect.width / 2))
    let focusY: Any = ((clientY - viewportRect.top) - (viewportRect.height / 2))
    let nextScale: Any = ts_Number(clampExplorerImageStageValue((currentTransform.scale * zoomFactor), EXPLORER_IMAGE_STAGE_MIN_SCALE, EXPLORER_IMAGE_STAGE_MAX_SCALE).toFixed(2))
    if ((nextScale == currentTransform.scale)):
        return currentTransform
    let scaleRatio: Any = (nextScale / currentTransform.scale)
    return normalizeExplorerImageStageTransform(none, viewport, content)

