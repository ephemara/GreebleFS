const LOCAL_SOURCE_CAPABILITIES: Option<Any> = none

const REMOTE_SOURCE_CAPABILITIES: Option<Any> = none

const CLOUD_SOURCE_CAPABILITIES: Option<Any> = none

const REMOTE_PROTOCOL_PREFIX: Any = "remote://sftp/"

fn toWritablePayload(content: ExplorerWritableContent) -> Any:
    return none

fn isCloudExplorerPath(path: String) -> Bool:
    return path.trim().startsWith("cloud://")

fn isRemoteExplorerPath(path: String) -> Bool:
    return path.trim().startsWith(REMOTE_PROTOCOL_PREFIX)

type ExplorerPathSourceKind = Any

type ParsedRemoteExplorerPath = Any

fn parseRemoteExplorerPath(path: String) -> Any:
    ()

fn buildRemoteExplorerRootPath(connectionId: String) -> String:
    return buildRemoteExplorerPath(connectionId, [])

fn buildRemoteExplorerPath(connectionId: String, relativeSegments: [String]) -> Any:
    let encodedConnectionId: Any = encodeURIComponent(connectionId)
    if ((relativeSegments.length == 0)):
        return "remote://sftp/" + encodedConnectionId + "/root"
    return "remote://sftp/" + encodedConnectionId + "/root/" + relativeSegments.map(none).join("/")

fn getRemoteParentPath(path: String) -> Any:
    let parsed: Any = parseRemoteExplorerPath(path)
    if (((!parsed) or (parsed.relativeSegments.length == 0))):
        return none
    return buildRemoteExplorerPath(parsed.connectionId, parsed.relativeSegments.slice(0, (-1)))

fn toExplorerRemoteBreadcrumbs(breadcrumbs: [Any]) -> [ExplorerLocationBreadcrumb]:
    return breadcrumbs.map(none)

fn getExplorerPathSourceKind(path: String) -> Any:
    if (isExplorerArchiveVirtualPath(path)):
        return "archive"
    if (isCloudExplorerPath(path)):
        return "cloud"
    if (isRemoteExplorerPath(path)):
        return "remote"
    if (isExplorerVirtualPath(path)):
        return "virtual"
    return "local"

fn getExplorerSourceCapabilitiesForPath(path: String) -> Any:
    if ((getExplorerPathSourceKind(path) == "local")):
        return LOCAL_SOURCE_CAPABILITIES
    else if ((getExplorerPathSourceKind(path) == "archive")):
        return none
    else if ((getExplorerPathSourceKind(path) == "cloud")):
        return CLOUD_SOURCE_CAPABILITIES
    else if ((getExplorerPathSourceKind(path) == "remote")):
        return REMOTE_SOURCE_CAPABILITIES
    else if ((getExplorerPathSourceKind(path) == "virtual")):
        return none

fn buildLocalBreadcrumbs(path: String) -> Any:
    let normalizedPath: Any = path.trim()
    if ((!normalizedPath)):
        return []
    if (none.test_(normalizedPath)):
        let drivePath: Any = none
        return [none]
    if (none.test_(normalizedPath)):
        let drivePath: Any = normalizedPath.slice(0, 2) + none
        let parts: Any = normalizedPath.replace(none, "").split(none).filter(ts_Boolean)
        let breadcrumbs: [ExplorerLocationBreadcrumb] = [none]
        let index: Any = 1
        while ((index < parts.length)):
            let nextPath: Any = none
            breadcrumbs.push(none)
            index = (index + 1)
        return breadcrumbs
    if (normalizedPath.startsWith("/")):
        let parts: Any = normalizedPath.replace(none, "").split("/").filter(ts_Boolean)
        let breadcrumbs: [ExplorerLocationBreadcrumb] = [none]
        let index: Any = 0
        while ((index < parts.length)):
            breadcrumbs.push(none)
            index = (index + 1)
        return breadcrumbs
    let parts: Any = normalizedPath.replace(none, "").split(none).filter(ts_Boolean)
    return parts.map(none)

fn getLocalParentPath(path: String) -> Any:
    let normalized: Any = path.trim()
    if ((!normalized)):
        return none
    if ((none.test_(normalized) or (normalized == "/"))):
        return none
    let trimmed: Any = normalized.replace(none, "")
    let parts: Any = trimmed.split(none)
    if ((parts.length <= 1)):
        return none
    if ("/^[A-Za-z]:$/".test_((parts[0] or ""))):
        return none
    return none

fn getCloudParentPath(path: String) -> Any:
    let trimmed: Any = path.replace(none, "")
    if ((!trimmed.startsWith("cloud://"))):
        return none
    let segments: Any = trimmed.split("/")
    if ((segments.length <= 5)):
        return none
    return segments.slice(0, (-1)).join("/")

fn toExplorerCloudBreadcrumbs(breadcrumbs: [CloudBreadcrumb]) -> [ExplorerLocationBreadcrumb]:
    return breadcrumbs.map(none)

fn getLeafName(path: String) -> String:
    let trimmed: Any = path.replace(none, "")
    let match_: Any = trimmed.match_(none)
    return (match_[1] or trimmed)

fn buildDerivedExplorerEntityId(namespace_: String, stableKey: String) -> String:
    return namespace_ + ":" + stableKey

fn buildArchiveEntryContentRevision(entry: ExplorerArchiveListingEntry, normalizedRelativePath: String) -> String:
    return ["archive-entry", normalizedRelativePath, none, entry.size, entry.modified, entry.extension].join("::")

fn getParentDir(path: String) -> Any:
    if (isCloudExplorerPath(path)):
        let parentPath: Any = getCloudParentPath(path)
        if ((!parentPath)):
            ()
        return parentPath
    if (isRemoteExplorerPath(path)):
        let parentPath: Any = getRemoteParentPath(path)
        if ((!parentPath)):
            ()
        return parentPath
    let trimmed: Any = path.replace(none, "")
    let parentPath: Any = trimmed.replace(none, "")
    if ((parentPath == trimmed)):
        ()
    if ("/^[A-Za-z]:$/".test_(parentPath)):
        return parentPath + none
    return (parentPath or "/")

fn toLocalDriveInfo(drive: DriveInfo) -> Any:
    return none

fn toCloudDriveInfo(account: CloudAccountSummary) -> Any:
    return none

fn toRemoteDriveInfo(connection: RemoteConnectionSummary) -> Any:
    return none

type ExplorerBackendContract = Any

fn queueExplorerTerminalDirectorySync(args: Any) -> Any:
    let path: Any = args.path.trim()
    if ((!path)):
        return none
    useExplorerStore.getState().setPendingTerminalCwdSync(none)

fn buildExplorerArchiveBreadcrumbs(location: Any) -> Any:
    if ((!location)):
        return []
    let containerPath: Any = getExplorerArchiveContainerPath(location.archivePath)
    let breadcrumbs: Any = none
    let archiveRootPath: Any = buildExplorerArchiveVirtualPath(none)
    breadcrumbs.push(none)
    let entrySegments: Any = location.entryPath.split("/").filter(ts_Boolean)
    let index: Any = 0
    while ((index < entrySegments.length)):
        breadcrumbs.push(none)
        index = (index + 1)
    return breadcrumbs

fn toExplorerArchiveVirtualEntry(archivePath: String, entry: ExplorerArchiveListingEntry) -> Any:
    let normalizedRelativePath: Any = normalizeExplorerArchiveEntryPath(entry.relativePath)
    let contentRevision: Any = buildArchiveEntryContentRevision(entry, normalizedRelativePath)
    let virtualPath: Any = buildExplorerArchiveVirtualPath(none)
    return none

fn listExplorerArchiveDir(archivePath: String, entryPath: Any) -> impl Async_<[ExplorerFileEntry]>:
    let entryPath: Any = entryPath
    let entries: Any = unwrapTauriResult((await commands.fsListArchiveDir(archivePath, normalizeExplorerArchiveEntryPath(entryPath))))
    return entries.map(none)

fn shouldUseExplorerNativeBufferPool(systemId: String) -> Bool:
    return (resolveGreebleNativeLaneSelection(systemId, none, none).activeLane == "native_buffer_pool")

type ExplorerNativeControlSystemId = String

fn shouldUseExplorerNativeControl(systemId: ExplorerNativeControlSystemId) -> Bool:
    return (resolveGreebleNativeLaneSelection(systemId, none, none).activeLane == "native_control")

fn callExplorerNativeControlWithFallback(systemId: ExplorerNativeControlSystemId, method: String, args: Any, fallback: Any) -> Any:
    if ((!shouldUseExplorerNativeControl(systemId))):
        return fallback()
    return callGreebleNativeWithInvokeFallback("explorer", method, args, fallback)

fn shouldUseExplorerNativeRing(systemId: String) -> Bool:
    return (resolveGreebleNativeLaneSelection(systemId, none, none).activeLane == "native_ring")

fn listLocalExplorerDirWithFallback(path: String, showHidden: Bool, bypassCache: Bool) -> impl Async_<[ExplorerFileEntry]>:
    if (shouldUseExplorerNativeBufferPool("directoryListingSnapshots")):
        recordExplorerNativePoolAttempt("directoryListingSnapshots")
    return unwrapTauriResult(none)

fn listExplorerLocation(path: String, showHidden: Bool) -> Any:
    let archiveLocation: Any = parseExplorerArchiveVirtualPath(path)
    if (archiveLocation):
        let archiveVirtualPath: Any = buildExplorerArchiveVirtualPath(archiveLocation)
        return none
    if (isCloudExplorerPath(path)):
        let listing: Any = unwrapTauriResult((await commands.cloudListDir(path)))
        return none
    if (isRemoteExplorerPath(path)):
        let listing: Any = unwrapTauriResult((await commands.remoteListDir(path)))
        return none
    let normalizedPath: Any = none
    let entries: Any = (await listLocalExplorerDirWithFallback(normalizedPath, showHidden, false))
    return none

fn listExplorerLocationUncached(path: String, showHidden: Bool) -> Any:
    if (isExplorerArchiveVirtualPath(path)):
        return listExplorerLocation(path, showHidden)
    if ((isCloudExplorerPath(path) or isRemoteExplorerPath(path))):
        return listExplorerLocation(path, showHidden)
    let normalizedPath: Any = none
    let entries: Any = (await listLocalExplorerDirWithFallback(normalizedPath, showHidden, true))
    return none

const EXPLORER_POLICY_RUNTIME_MODE_ENV_VAR: Any = "VITE_GREEBLEFS_EXPLORER_POLICY_RUNTIME"

const LEGACY_EXPLORER_POLICY_RUNTIME_MODE_ENV_VAR: Any = "VITE_OVERLAYTERM_EXPLORER_POLICY_RUNTIME"

const localExplorerPolicySessions: Any = ts_Map()

fn normalizeExplorerPolicySessionId(sessionId: String) -> String:
    return (sessionId.trim() or "primary")

fn cloneExplorerPolicySessionSnapshot(snapshot: ExplorerPolicySessionSnapshot) -> Any:
    return none

fn resolveExplorerPolicyRuntimeModeOverride(value: Any) -> Any:
    let normalized: Any = value.trim().toLowerCase()
    if ((!normalized)):
        return none
    if ((normalized == "auto")):
        return "auto"
    if ((((normalized == "go") or (normalized == "sidecar")) or (normalized == "go-sidecar"))):
        return "go-sidecar"
    if (((((normalized == "local") or (normalized == "direct")) or (normalized == "rust")) or (normalized == "host"))):
        return "local"
    return none

fn resolveExplorerPolicyRuntimeMode(args: Any) -> Any:
    let env: Any = (args.env or (import_meta.env))
    let explicitMode: Any = resolveExplorerPolicyRuntimeModeOverride((env[EXPLORER_POLICY_RUNTIME_MODE_ENV_VAR] or env[LEGACY_EXPLORER_POLICY_RUNTIME_MODE_ENV_VAR]))
    if ((explicitMode and (explicitMode != "auto"))):
        return explicitMode
    return "local"

fn applyLocalExplorerPolicyNavigationHistory(session: ExplorerPolicySessionSnapshot, nextPath: String, pushHistory: Bool, historyIndex: Any) -> Any:
    if ((!pushHistory)):
        let history: Any = [session.history]
        let requestedHistoryIndex: Any = none
        return normalizeExplorerPolicySessionSnapshot(none)
    let retainedHistory: Any = none
    retainedHistory.push(nextPath)
    return normalizeExplorerPolicySessionSnapshot(none)

fn bootstrapLocalExplorerPolicySession(request: ExplorerPolicyBootstrapRequest) -> Any:
    let sessionId: Any = normalizeExplorerPolicySessionId(request.sessionId)
    let snapshot: Any = normalizeExplorerPolicySessionSnapshot(request.session)
    localExplorerPolicySessions.set(sessionId, cloneExplorerPolicySessionSnapshot(snapshot))
    return none

fn navigateLocalExplorerPolicySession(request: ExplorerPolicyNavigateRequest) -> Any:
    let sessionId: Any = normalizeExplorerPolicySessionId(request.sessionId)
    let nextPath: Any = request.path.trim()
    if ((!nextPath)):
        ()
    let previousSnapshot: Any = normalizeExplorerPolicySessionSnapshot((localExplorerPolicySessions.get(sessionId) or none))
    let snapshot: Any = applyLocalExplorerPolicyNavigationHistory(previousSnapshot, nextPath, request.pushHistory, request.historyIndex)
    localExplorerPolicySessions.set(sessionId, cloneExplorerPolicySessionSnapshot(snapshot))
    if ((nextPath == EXPLORER_HOME_PATH)):
        return none
    return none

fn resolveLocalExplorerEntryOpenWithPolicy(request: ExplorerPolicyResolveOpenEntryRequest) -> Any:
    let entry: Any = request.entry
    let entryPath: Any = entry.path.trim()
    if ((!entryPath)):
        ()
    if (entry.is_dir):
        return none
    if (isExplorerArchiveEntry(entry)):
        return none
    if (((request.previewEnabled and (!request.compactDock)) and (!isExecutableBinaryExtension(entry.extension)))):
        return none
    return none

fn bootstrapExplorerPolicySession(request: ExplorerPolicyBootstrapRequest) -> Any:
    return none

fn navigateExplorerPolicySession(request: ExplorerPolicyNavigateRequest) -> Any:
    return none

fn resolveExplorerEntryOpenWithPolicy(request: ExplorerPolicyResolveOpenEntryRequest) -> Any:
    return none

fn listExplorerDir(path: String, showHidden: Bool) -> impl Async_<[ExplorerFileEntry]>:
    return ((await listExplorerLocation(path, showHidden))).entries

fn listExplorerDirUncached(path: String, showHidden: Bool) -> impl Async_<[ExplorerFileEntry]>:
    return ((await listExplorerLocationUncached(path, showHidden))).entries

fn getExplorerDrives() -> impl Async_<[ExplorerDriveInfo]>:
    let _: Any = (await ts_Promise.all([commands.fsGetDrives().then(unwrapTauriResult), commands.remoteListConnections().then(unwrapTauriResult).catch_(none), listCloudAccounts().catch_(none)]))
    let localDrives: Any = none
    let remoteConnections: Any = none
    let cloudSnapshot: Any = none
    return [localDrives.map(toLocalDriveInfo), remoteConnections.map(toRemoteDriveInfo), cloudSnapshot.accounts.filter(none).map(toCloudDriveInfo)]

fn measureExplorerEntrySizes(paths: [String], forceRefresh: Any) -> Any:
    let forceRefresh: Any = forceRefresh
    let localPaths: Any = paths.filter(none)
    if ((localPaths.length == 0)):
        return []
    return unwrapTauriResult((await commands.fsMeasureEntrySizes(localPaths, forceRefresh)))

fn calculateExplorerRecursiveSizes(paths: [String], forceRefresh: Any) -> Any:
    let forceRefresh: Any = forceRefresh
    let localPaths: Any = paths.filter(none)
    if ((localPaths.length == 0)):
        return []
    return unwrapTauriResult((await commands.fsCalculateRecursiveSizes(localPaths, forceRefresh)))

fn calculateExplorerChecksums(paths: [String]) -> Any:
    let localPaths: Any = paths.filter(none)
    if ((localPaths.length == 0)):
        return []
    return unwrapTauriResult((await commands.fsCalculateChecksums(localPaths)))

fn getExplorerItemProperties(path: String) -> impl Async_<ExplorerItemProperties>:
    if ((getExplorerPathSourceKind(path) != "local")):
        ()
    return unwrapTauriResult((await commands.fsGetItemProperties(path)))

fn fuzzyFilterExplorerEntries(request: ExplorerJumpFilterInput) -> impl Async_<[ExplorerJumpFilterResult]>:
    return unwrapTauriResult((await commands.fsFuzzyFilterEntries(request)))

fn getExplorerRuntimeCachePolicy() -> impl Async_<FsRuntimeCachePolicy>:
    return commands.fsGetRuntimeCachePolicy()

fn getExplorerHomeDir() -> impl Async_<String>:
    return unwrapTauriResult((await commands.fsGetHomeDir()))

fn searchExplorerEntriesWithDiagnostics(args: Any) -> impl Async_<FileSearchResponse<ExplorerFileSearchResult>>:
    if ((!supportsExplorerSearch(args.path))):
        ()
    if (shouldUseExplorerNativeRing("searchResultStreams")):
        ()
    return unwrapTauriResult((await commands.fsSearchEntriesWithDiagnostics(args.path, args.query, args.showHidden, (args.includeContent or false), (args.limit or none), (args.requestId or none), (args.requestScope or none))))

fn cancelExplorerSearchEntries(args: Any) -> Any:
    if ((!supportsExplorerSearch(args.path))):
        return none
    unwrapTauriResult((await commands.fsCancelSearchEntries(args.path, (args.requestId or none), (args.requestScope or none))))

fn watchExplorerEntrySizeRoot(path: String) -> Any:
    if ((getExplorerPathSourceKind(path) != "local")):
        return none
    unwrapTauriResult((await commands.fsWatchEntrySizeRoot(path)))

fn unwatchExplorerEntrySizeRoot(path: String) -> Any:
    if ((getExplorerPathSourceKind(path) != "local")):
        return none
    unwrapTauriResult((await commands.fsUnwatchEntrySizeRoot(path)))

