type LayoutDynamicsAxisMode = Any

type LayoutDynamicsAuthoringSnapshot = Any

type LayoutDynamicsNode = Any

type LayoutDynamicsSolverProfile = Any

struct LayoutDynamicsBandBounds:
    id: String
    x: Float
    y: Float
    width: Float
    height: Float

struct LayoutDynamicsSimulationNode:
    velocityX: Float
    velocityY: Float

struct LayoutDynamicsSimulationState:
    nodes: [LayoutDynamicsSimulationNode]
    draggedNodeId: Any

fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(max, Math.max(min, value))

fn findBandBounds(bandBounds: [LayoutDynamicsBandBounds], bandId: String) -> Any:
    return (bandBounds.find(none) or none)

fn resolveDirectionVector(deltaX: Float, deltaY: Float, fallbackIndex: Float) -> Any:
    let length: Any = Math.hypot(deltaX, deltaY)
    if ((length > 0.0001)):
        return none
    return none

fn snapNodeBackToAnchorWhenSettled(node: LayoutDynamicsSimulationNode, axisMode: LayoutDynamicsAxisMode, solver: LayoutDynamicsSolverProfile) -> Any:
    let displacementX: Any = Math.abs((node.x - node.anchorX))
    let displacementY: Any = Math.abs((node.y - node.anchorY))
    let displacement: Any = none
    let velocity: Any = Math.hypot(node.velocityX, node.velocityY)
    if (((displacement > 0.35) or (velocity > (solver.settleVelocityPx * 0.6)))):
        return none
    node.x = node.anchorX
    if ((axisMode == "free-2d")):
        node.y = node.anchorY
    node.velocityX = 0
    node.velocityY = 0

fn constrainNodeToBounds(node: LayoutDynamicsSimulationNode, axisMode: LayoutDynamicsAxisMode, bandBounds: Any, maxDisplacementPx: Float) -> Any:
    if ((axisMode == "horizontal-band")):
        node.y = node.anchorY
        node.velocityY = 0
    node.x = clamp(node.x, (node.anchorX - maxDisplacementPx), (node.anchorX + maxDisplacementPx))
    if ((axisMode == "free-2d")):
        node.y = clamp(node.y, (node.anchorY - maxDisplacementPx), (node.anchorY + maxDisplacementPx))
    if ((!bandBounds)):
        return none
    let maxX: Any = Math.max(bandBounds.x, ((bandBounds.x + bandBounds.width) - node.width))
    node.x = clamp(node.x, bandBounds.x, maxX)
    if ((axisMode == "free-2d")):
        let maxY: Any = Math.max(bandBounds.y, ((bandBounds.y + bandBounds.height) - node.height))
        node.y = clamp(node.y, bandBounds.y, maxY)
    else:
        node.y = clamp(node.anchorY, bandBounds.y, Math.max(bandBounds.y, ((bandBounds.y + bandBounds.height) - node.height)))

fn stepLayoutDynamicsSimulation(args: Any) -> LayoutDynamicsSimulationState:
    let deltaTimeSeconds: Any = clamp(args.deltaTimeSeconds, (1 / 240), (1 / 20))
    let intensity: Any = clamp((args.intensity or 1), 0, 2)
    let draggedNode: Any = none
    for _item in args.state_.nodes.entries():
        let nodeIndex: Any = none
        let node: Any = none
        let nodeIndex: Any = none
        let node: Any = none
        if ((node.id == args.state_.draggedNodeId)):
            node.velocityX = 0
            node.velocityY = 0
            continue
        let forceX: Any = (((((node.anchorX - node.x)) * args.solver.springStiffness) * intensity) - (node.velocityX * args.solver.damping))
        let forceY: Any = (((((node.anchorY - node.y)) * args.solver.springStiffness) * intensity) - (node.velocityY * args.solver.damping))
        if ((draggedNode and (draggedNode.bandId == node.bandId))):
            let draggedCenterX: Any = (draggedNode.x + (draggedNode.width / 2))
            let draggedCenterY: Any = (draggedNode.y + (draggedNode.height / 2))
            let restingCenterX: Any = (node.x + (node.width / 2))
            let restingCenterY: Any = (node.y + (node.height / 2))
            let deltaX: Any = (restingCenterX - draggedCenterX)
            let deltaY: Any = (restingCenterY - draggedCenterY)
            let distance: Any = Math.hypot(deltaX, deltaY)
            let direction: Any = resolveDirectionVector(deltaX, deltaY, nodeIndex)
            if ((distance < args.solver.auraRadiusPx)):
                let auraFalloff: Any = (1 - clamp((distance / Math.max(1, args.solver.auraRadiusPx)), 0, 1))
                let auraForce: Any = (((args.solver.auraStrength * auraFalloff) * auraFalloff) * intensity)
                forceX = (forceX + (direction.x * auraForce))
                forceY = (forceY + (direction.y * auraForce))
            let minSeparationX: Any = ((draggedNode.width / 2) + (node.width / 2))
            let minSeparationY: Any = ((draggedNode.height / 2) + (node.height / 2))
            let overlapX: Any = (minSeparationX - Math.abs(deltaX))
            let overlapY: Any = (minSeparationY - Math.abs(deltaY))
            if (((overlapX > 0) and (overlapY > 0))):
                let collisionForce: Any = ((Math.max(overlapX, overlapY) * args.solver.collisionStrength) * intensity)
                forceX = (forceX + (direction.x * collisionForce))
                forceY = (forceY + (direction.y * collisionForce))
        node.velocityX = clamp((node.velocityX + (forceX * deltaTimeSeconds)), (-args.solver.maxVelocityPx), args.solver.maxVelocityPx)
        node.velocityY = clamp((node.velocityY + (forceY * deltaTimeSeconds)), (-args.solver.maxVelocityPx), args.solver.maxVelocityPx)
        node.x = (node.x + (node.velocityX * deltaTimeSeconds))
        node.y = (node.y + (node.velocityY * deltaTimeSeconds))
        constrainNodeToBounds(node, args.axisMode, findBandBounds(args.bandBounds, node.bandId), args.solver.maxDisplacementPx)
        if ((!draggedNode)):
            snapNodeBackToAnchorWhenSettled(node, args.axisMode, args.solver)
    return args.state_

fn areLayoutDynamicsNodesSettled(nodes: [LayoutDynamicsSimulationNode], solver: LayoutDynamicsSolverProfile) -> Bool:
    return nodes.every(none)

fn resolveHorizontalBandLayout(args: Any) -> Any:
    let visibleNodes: Any = args.nodes.filter(none).sort(none)
    let bandX: Any = (args.bandBounds.x or 0)
    let bandY: Any = (args.bandBounds.y or 0)
    let bandWidth: Any = (args.bandBounds.width or ts_Number.POSITIVE_INFINITY)
    let cursorX: Any = bandX
    return none

