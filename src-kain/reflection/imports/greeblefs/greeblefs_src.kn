fn normalizeExplorerSettings(base: ExplorerSettings, updates: Any) -> Any:
    let nextViewMode: Any = normalizeExplorerViewMode((updates.viewMode or base.viewMode))
    let hasExplicitGridZoom: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "gridZoom"))
    let hasExplicitActiveExplorerViewId: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "activeExplorerViewId"))
    let hasExplicitExperimentalViewMode: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "experimentalViewMode"))
    let hasExplicitExplorerViewDensityById: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "explorerViewDensityById"))
    let hasExplicitExplorerWidgetStateByInstanceId: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "explorerWidgetStateByInstanceId"))
    let nextExperimentalViewMode: Any = normalizeExplorerExperimentalViewMode(none)
    let hasExplicitExperimentalDensity: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "experimentalDensity"))
    let legacySeedExplorerViewId: Any = normalizeExplorerActiveViewId((base.activeExplorerViewId or base.experimentalViewMode))
    let nextActiveExplorerViewId: Any = none
    let nextExplorerViewDensityById: Any = normalizeExplorerViewDensityById(none, none)
    if (hasExplicitExperimentalDensity):
        ()
    if ((nextExplorerViewDensityById[nextActiveExplorerViewId] == none)):
        ()
    let hasExplicitModeProfileOverrides: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "modeProfileOverridesByThemeId"))
    let hasExplicitChromeLayoutOverrides: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "chromeLayoutOverridesByThemeId"))
    let hasExplicitFollowThemeExplorerLayout: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "followThemeExplorerLayout"))
    let hasExplicitActiveExplorerLayoutId: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "activeExplorerLayoutId"))
    let hasExplicitLayoutSelectionByPresentationMode: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "layoutSelectionByPresentationMode"))
    let hasExplicitLayoutUiResetRevision: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "layoutUiResetRevision"))
    let hasExplicitActiveMenuPackId: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "activeMenuPackId"))
    let hasExplicitContextMenuLayoutOverrides: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "contextMenuLayoutOverridesByContext"))
    let hasExplicitContextMenuItemOverrides: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "contextMenuItemOverrides"))
    let hasExplicitThumbnailSettings: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "thumbnails"))
    let hasExplicitPreferredWorkbenchByExtension: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "preferredWorkbenchByExtension"))
    let nextFollowThemeExplorerLayout: Any = none
    let nextActiveExplorerLayoutId: Any = none
    let baseLayoutSelectionByPresentationMode: Any = resolveExplorerLayoutSelectionFallback(base)
    let explicitLayoutSelectionByPresentationMode: Any = none
    let legacyLayoutSelectionPatch: Any = none
    let legacyLayoutSelectionPatchTarget: Any = none
    let nextLayoutSelectionByPresentationMode: Any = none
    return none

