fn dockPlacementLabel(placement: DockStackPlacement) -> String:
    if ((placement == "left-sidebar")):
        return "Left"
    else if ((placement == "center")):
        return "Center"
    else if ((placement == "right-sidebar")):
        return "Right"
    else if ((placement == "bottom-panel")):
        return "Bottom"
    else:
        return placement

