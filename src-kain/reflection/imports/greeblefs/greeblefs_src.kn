                    _self.splittableMarks.push(extension.name)
            let onBeforeCreate: Any = getExtensionField(extension, "onBeforeCreate", context)
            let onCreate: Any = getExtensionField(extension, "onCreate", context)
            let onUpdate: Any = getExtensionField(extension, "onUpdate", context)
            let onSelectionUpdate: Any = getExtensionField(extension, "onSelectionUpdate", context)
            let onTransaction: Any = getExtensionField(extension, "onTransaction", context)
            let onFocus: Any = getExtensionField(extension, "onFocus", context)
            let onBlur: Any = getExtensionField(extension, "onBlur", context)
            let onDestroy: Any = getExtensionField(extension, "onDestroy", context)
