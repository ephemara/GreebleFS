fn persistActiveUsrProfileSettingsSnapshot(settings: Any) -> Any:
    if ((!isTauri())):
        return none
    let settingsJson: Any = currentSettingsJsonOrNull(settings)
    if ((!settingsJson)):
        return activeUsrProfileSnapshot
    let snapshot: Any = (await invokeUsrProfileCommand("usr_profiles_persist_active_settings_snapshot", none))
    return applyUsrProfileSnapshot(snapshot, none)

