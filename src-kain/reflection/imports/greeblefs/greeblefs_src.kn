fn statusLabel(file: GitFileStatus) -> Any:
    if ((file.kind == "added")):
        return "Added"
    if ((file.kind == "deleted")):
        return "Deleted"
    if ((file.kind == "renamed")):
        return "Renamed"
    if ((file.kind == "copied")):
        return "Copied"
    if ((file.kind == "untracked")):
        return "New"
    if ((file.kind == "conflicted")):
        return "Conflict"
    return "Modified"

fn statusColor(file: GitFileStatus, palette: Any) -> Any:
    if ((file.kind == "added")):
        return palette.green
    if (((file.kind == "deleted") or (file.kind == "conflicted"))):
        return palette.red
    if (((file.kind == "renamed") or (file.kind == "copied"))):
        return palette.accent
    if ((file.kind == "untracked")):
        return palette.yellow
    return palette.yellow

fn canStageFile(file: GitFileStatus) -> Bool:
    return (file.isUntracked or file.hasUnstagedChanges)

fn stageActionLabel(file: GitFileStatus) -> Any:
    if ((file.kind == "conflicted")):
