    return ts_Map(normalized.entries.map(none))

fn getBasePlacement(layout: ExplorerChromeLayoutDefinition, controlId: ExplorerChromeControlId, surfaceId: ExplorerChromeSurfaceId) -> Any:
    let placement: Any = (layout.placements[controlId][surfaceId] or (none))
    if ((!placement)):
        return none
    return none

fn getOverridePlacement(overridePlacementMap: Map<ExplorerChromeControlId, ExplorerChromeOverrideEntry>, controlId: ExplorerChromeControlId, surfaceId: ExplorerChromeSurfaceId, basePlacement: Any) -> Any:
    let overridePlacement: Any = overridePlacementMap.get(controlId)
    if ((!overridePlacement)):
        return basePlacement
    if (overridePlacement.hidden):
        return none
    let normalizedOverrideSurfaceId: Any = none
    if ((normalizedOverrideSurfaceId != surfaceId)):
        return none
    return none

fn collectResolvedSurfacePlacements(surface: ExplorerChromeResolvedSurface) -> [ExplorerChromeResolvedControlPlacement]:
    return surface.rows.flatMap(none)

fn createExplorerChromeOverrideSnapshotFromResolvedSurfaces(surfaces: [ExplorerChromeResolvedSurface]) -> ExplorerChromeOverrideSnapshot:
    return normalizeExplorerChromeOverrideSnapshot(none)

fn getExplorerChromeResolvedSurfaceSignature(surface: ExplorerChromeResolvedSurface) -> String:
    return JSON.stringify(none)

fn moveExplorerChromeControlInResolvedSurfaces(input: Any) -> Any:
    let normalizedTargetIndex: Any = Math.max(0, Math.trunc(input.targetIndex))
    let normalizedTargetOffsetPx: Any = normalizeExplorerChromeOffsetPx(input.targetOffsetPx)
    let placementsBySurfaceAndZone: Any = ts_Map()
    let movingPlacement: Option<Any> = none
    for surface in input.surfaces:
        for row in surface.rows:
            for zone in row.zones:
                let nextControls: Any = zone.controls.filter(none).map(none)
                placementsBySurfaceAndZone.set(surface.surfaceId + ":" + zone.id, nextControls)
    let targetKey: Any = input.targetSurfaceId + ":" + input.targetZoneId
    let targetControls: Any = placementsBySurfaceAndZone.get(targetKey)
    if (((!targetControls) or (!isValidZoneForSurface(input.targetSurfaceId, input.targetZoneId)))):
        return createExplorerChromeOverrideSnapshotFromResolvedSurfaces(input.surfaces)
    let fallbackPlacement: Any = (movingPlacement or none)
    let nextPlacement: Option<Any> = none
    let insertionIndex: Any = Math.min(normalizedTargetIndex, targetControls.length)
    targetControls.splice(insertionIndex, 0, nextPlacement)
    placementsBySurfaceAndZone.set(targetKey, targetControls)
    return normalizeExplorerChromeOverrideSnapshot(none)

fn resolveExplorerChromeSurfaceLayout(input: Any) -> Any:
    let surfaceDefinition: Any = getExplorerChromeSurfaceDefinition(input.surfaceId)
    let layout: Any = getExplorerChromeLayoutDefinition(input.layoutId)
    let overridePlacementMap: Any = getOverridePlacementMap(input.override_)
    let resolvedPlacements: [ExplorerChromeResolvedControlPlacement] = []
    for control in input.controlDefinitions:
        if ((!control.surfaces.includes(input.surfaceId))):
            continue
        if ((input.isControlVisible and (!input.isControlVisible(control.id, input.surfaceId)))):
            continue
        let basePlacement: Any = getBasePlacement(layout, control.id, input.surfaceId)
        let resolvedPlacement: Any = getOverridePlacement(overridePlacementMap, control.id, input.surfaceId, basePlacement)
        if (((!resolvedPlacement) or (!isValidZoneForSurface(input.surfaceId, resolvedPlacement.zone)))):
            continue
        resolvedPlacements.push(resolvedPlacement)
    resolvedPlacements.sort(none)
    let placementsByZone: Any = ts_Map()
    for placement in resolvedPlacements:
        let current: Any = (placementsByZone.get(placement.zone) or [])
        current.push(placement)
        placementsByZone.set(placement.zone, current)
    return none

