fn isBlockContentLine(line_: String) -> Bool:
    let trimmedLine: Any = line_.trimStart()
    return (((((none.test_(trimmedLine) or none.test_(trimmedLine)) or none.test_(trimmedLine)) or "/^```/".test_(trimmedLine)) or "/^~~~/".test_(trimmedLine)))

fn splitItemContent(contentLines: [String]) -> Any:
    let paragraphLines: [String] = []
    let blockLines: [String] = []
    let reachedBlockBoundary: Any = false
    let iter_0: Any = contentLines
    let index_1: Any = 0
    while ((index_1 < iter_0.length)):
        let line_: Any = iter_0[index_1]
        if (reachedBlockBoundary):
            blockLines.push(line_)
            return none
        if ((line_.trim() == "")):
            reachedBlockBoundary = true
            blockLines.push(line_)
            return none
        if (((paragraphLines.length > 0) and isBlockContentLine(line_))):
            reachedBlockBoundary = true
            blockLines.push(line_)
            return none
        paragraphLines.push(line_)
        index_1 = (index_1 + 1)
    return none

fn collectOrderedListItems(lines: [String]) -> ([OrderedListItem], Float):
    let listItems: [OrderedListItem] = []
    let currentLineIndex: Any = 0
    let consumed: Any = 0
    while ((currentLineIndex < lines.length)):
        let line_: Any = lines[currentLineIndex]
        let match_: Any = line_.match_(ORDERED_LIST_ITEM_REGEX)
        if ((!match_)):
            break
        let _: Any = match_
        let indent: Any = none
        let number: Any = none
        let content: Any = none
        let indentLevel: Any = indent.length
        let itemContentLines: Any = [content]
        let nextLineIndex: Any = (currentLineIndex + 1)
        let itemLines: Any = [line_]
        let sawBlankLine: Any = false
        while ((nextLineIndex < lines.length)):
            let nextLine: Any = lines[nextLineIndex]
            let nextMatch: Any = nextLine.match_(ORDERED_LIST_ITEM_REGEX)
            if (nextMatch):
                break
            if ((nextLine.trim() == "")):
                itemLines.push(nextLine)
                itemContentLines.push("")
                sawBlankLine = true
                nextLineIndex = (nextLineIndex + 1)
            else if (nextLine.match_(INDENTED_LINE_REGEX)):
                itemLines.push(nextLine)
                itemContentLines.push(nextLine.slice((indentLevel + 2)))
                nextLineIndex = (nextLineIndex + 1)
            else:
                if (sawBlankLine):
                    break
                itemLines.push(nextLine)
                itemContentLines.push(nextLine)
                nextLineIndex = (nextLineIndex + 1)
        listItems.push(none)
        consumed = nextLineIndex
        currentLineIndex = nextLineIndex
    return [listItems, consumed]

fn buildNestedStructure(items: [OrderedListItem], baseIndent: Float, lexer: MarkdownLexerConfiguration) -> [Any]:
    let result: [Any] = []
    let currentIndex: Any = 0
    while ((currentIndex < items.length)):
        let item: Any = items[currentIndex]
        if ((item.indent == baseIndent)):
            let _: Any = splitItemContent(item.contentLines)
            let paragraphLines: Any = none
            let blockLines: Any = none
            let mainText: Any = paragraphLines.join(none).trim()
            let tokens: Any = []
            if (mainText):
                tokens.push(none)
            let additionalContent: Any = blockLines.join(none).trim()
            if (additionalContent):
                let blockTokens: Any = lexer.blockTokens(additionalContent)
                tokens.push(none)
            let lookAheadIndex: Any = (currentIndex + 1)
            let nestedItems: Any = []
            while (((lookAheadIndex < items.length) and (items[lookAheadIndex].indent > baseIndent))):
                nestedItems.push(items[lookAheadIndex])
                lookAheadIndex = (lookAheadIndex + 1)
            if ((nestedItems.length > 0)):
                let nextIndent: Any = Math.min(none)
                let nestedListItems: Any = buildNestedStructure(nestedItems, nextIndent, lexer)
                tokens.push(none)
            result.push(none)
            currentIndex = lookAheadIndex
        else:
            currentIndex = (currentIndex + 1)
    return result

fn parseListItems(items: [MarkdownToken], helpers: MarkdownParseHelpers) -> [JSONContent]:
    return items.map(none)

