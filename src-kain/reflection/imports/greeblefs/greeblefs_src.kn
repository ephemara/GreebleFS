    return ["id", "name", "description", "defaultPlacement", "allowedPlacements", "defaultSize", "minSize", "defaultTerminalGrid", "topBarId", "preview", "tags", "dockPresentation", "dockPresentations"].some(none)

fn parseDockPresentationManifestText(text: String, filePath: String) -> Any:
    let trimmed: Any = text.trim()
    if ((!trimmed)):
        ()
    let parsed: Any = none
    let source: Any = asRecord(parsed)
    if ((!source)):
        ()
    let nestedPresentation: Any = asRecord(source.dockPresentation)
    let explicitPresentations: Any = none
    let shorthandPresentations: Any = none
    let dockPresentations: Any = none
    return none

fn cloneDockPresentationDefinition(presentation: LoadedDockPresentationDefinition) -> Any:
    return none

fn createLoadedDockPresentationDefinition(definition: DockPresentationDefinition, options: Any) -> Any:
    let localId: Any = normalizeDockPresentationIdFragment((definition.id or definition.name), DEFAULT_DOCK_PRESENTATION_ID)
    let normalizedScopeId: Any = normalizeDockPresentationSelectionId(options.scopeId)
    let id: Any = none
    let fallbackName: Any = (definition.name.trim() or localId.replace("/-/g", " ").replace(none, none))
    let allowedPlacements: Any = normalizeAllowedDockPlacements(definition.allowedPlacements)
    let defaultPlacement: Any = none
    let minSize: Any = parseDockSizeDefinition(definition.minSize, none)
    let defaultSize: Any = parseDockSizeDefinition(definition.defaultSize, none)
    let defaultTerminalGrid: Any = parseDockTerminalGridDefinition(definition.defaultTerminalGrid, none)
    return none

const builtInDockPresentationDefinitions: Any = (none).map(none)

fn getBuiltInDockPresentations() -> [LoadedDockPresentationDefinition]:
    return builtInDockPresentationDefinitions.map(cloneDockPresentationDefinition)

fn resolveAvailableDockPresentations(packageSources: [DockPresentationPackageSourceLike]) -> [LoadedDockPresentationDefinition]:
    let packageSources: Any = packageSources
    let loaded: Any = ts_Map()
    for presentation in getBuiltInDockPresentations():
        loaded.set(presentation.id, presentation)
    for packageSource in packageSources:
        for presentation in (packageSource.dockPresentations or []):
            loaded.set(presentation.id, cloneDockPresentationDefinition(presentation))
    return ts_Array.from(loaded.values())

fn normalizeFloatingBounds(value: Any) -> Any:
    let source: Any = asRecord(value)
    if ((!source)):
        return none
    let width: Any = asFiniteNumber(source.width, 0)
    let height: Any = asFiniteNumber(source.height, 0)
    let x: Any = asFiniteNumber(source.x, ts_Number.NaN)
    let y: Any = asFiniteNumber(source.y, ts_Number.NaN)
    if (((((width < overlayWindowGeometry.minWidth) or (height < overlayWindowGeometry.minHeight)) or (!ts_Number.isFinite(x))) or (!ts_Number.isFinite(y)))):
        return none
    return none

fn resolveActiveDockPresentation(args: Any) -> Any:
    let availableDockPresentations: Any = resolveAvailableDockPresentations(args.packageSources)
    let presentationById: Any = ts_Map(availableDockPresentations.map(none))
    let requestedPresentationId: Any = normalizeDockPresentationSelectionId(args.requestedPresentationId)
    let requestedPresentation: Any = none
    let fallbackPresentation: Any = (presentationById.get(DEFAULT_DOCK_PRESENTATION_ID) or availableDockPresentations[0])
    if ((!fallbackPresentation)):
        ()
    let presentation: Any = (requestedPresentation or fallbackPresentation)
    let rawPlacement: Any = normalizeDockPlacementMode(args.placementMode, presentation.defaultPlacement)
    let placementMode: Any = none
    let topBarId: Any = ((normalizeDockTopBarSelectionId(args.topBarId) or presentation.topBarId) or DEFAULT_DOCK_TOP_BAR_ID)
    return none

fn getParentDirectoryPath(path: String) -> Any:
    let normalized: Any = path.replace(none, "/")
    let lastSlash: Any = normalized.lastIndexOf("/")
    if ((lastSlash <= 0)):
        return none
    return normalized.slice(0, lastSlash)

fn deriveDockPresentationPackageId(record: DockPresentationPackageRecord) -> Any:
    let explicitId: Any = asString(record.manifest.id)
    if (explicitId):
        return explicitId
    return ((record.directoryName.trim().toLowerCase().replace("/[^a-z0-9]+/g", "-").replace("/^-+|-+$/g", "") or "dock-presentation-package"))

fn deriveDockPresentationPackageName(record: DockPresentationPackageRecord, packageId: String) -> String:
    return ((asString(record.manifest.name) or packageId.replace("/-/g", " ").replace(none, none)))

fn readDockPresentationPackageRecord(entry: FileEntry) -> Any:
    if ((!entry.is_dir)):
        let lowerName: Any = entry.name.toLowerCase()
        let isManifestFile: Any = (lowerName.endsWith(".json") or lowerName.endsWith(".toml"))
        if ((!isManifestFile)):
            return none
        let manifestText: Any = (await commands.fsReadTextFile(entry.path).then(unwrapTauriResult))
        return none
    for manifestName in dockPresentationSystemConfig.manifestNames:
        let manifestPath: Any = joinPlatformPath(entry.path, manifestName)
    return none

fn buildPackageDockPresentations(record: DockPresentationPackageRecord, packageId: String, packageName: String) -> Any:
    let deduped: Any = ts_Map()
    let warnings: [String] = []
    for definition in (record.manifest.dockPresentations or []):
        let loadedPresentation: Any = createLoadedDockPresentationDefinition(definition, none)
        if (deduped.has(loadedPresentation.id)):
            warnings.push(none + loadedPresentation.localId + none + record.manifestPath + "; keeping the first definition.")
            continue
        deduped.set(loadedPresentation.id, loadedPresentation)
    return none

fn loadDockPresentationPackagesFromDirectoryEntries(directoryEntries: [FileEntry], directoryLabel: Any) -> impl Async_<DockPresentationPackageLoadResult>:
    let directoryLabel: Any = directoryLabel

fn loadDockPresentationPackages() -> Any:
    if ((!isTauri())):
        return none
    return loadManagedContentPackagesFromDirectoryStack(none)

const overlayWindowGeometry: Any = none

struct DockTerminalGrid:
    rows: Float
    columns: Float

struct DockTerminalSize:
    edgeSize: Float
    edgeWidth: Float

struct DockTerminalGridMeasurementArgs:
    edgeSize: Float
    edgeWidth: Float
    terminalFontSize: Any
    dockTopBarHeight: Any

struct DockTerminalSizeMeasurementArgs:
    terminalFontSize: Any
    dockTopBarHeight: Any

const dockTerminalGridGeometry: Any = none

fn finiteNumber(value: Any, fallback: Float) -> Any:
    return none

fn clampInteger(value: Any, fallback: Float, min: Float, max: Float) -> Float:
    let rounded: Any = Math.round(finiteNumber(value, fallback))
    return Math.min(Math.max(rounded, min), max)

fn normalizeDockTerminalRows(value: Any, fallback: Float) -> Float:
    let fallback: Any = fallback
    return clampInteger(value, fallback, dockTerminalGridGeometry.minRows, dockTerminalGridGeometry.maxRows)

fn normalizeDockTerminalColumns(value: Any, fallback: Float) -> Float:
    let fallback: Any = fallback
    return clampInteger(value, fallback, dockTerminalGridGeometry.minColumns, dockTerminalGridGeometry.maxColumns)

fn resolveDockTerminalCellMetrics(terminalFontSize: Any) -> Any:
    let fontSize: Any = Math.max(9, Math.min(28, finiteNumber(terminalFontSize, dockTerminalGridGeometry.defaultTerminalFontSize)))
    return none

fn estimateDockTerminalGridFromSize(args: DockTerminalGridMeasurementArgs) -> Any:
    let _: Any = resolveDockTerminalCellMetrics(args.terminalFontSize)
    let cellWidth: Any = none
    let cellHeight: Any = none
    let dockTopBarHeight: Any = Math.max(0, Math.round(finiteNumber(args.dockTopBarHeight, dockTerminalGridGeometry.dockTopBarHeight)))
    let usableWidth: Any = Math.max(0, (finiteNumber(args.edgeWidth, overlayWindowGeometry.defaultWidth) - dockTerminalGridGeometry.terminalHorizontalPadding))
    let usableHeight: Any = Math.max(0, ((finiteNumber(args.edgeSize, overlayWindowGeometry.defaultHeight) - dockTopBarHeight) - dockTerminalGridGeometry.terminalVerticalPadding))
    return none

fn estimateDockSizeFromTerminalGrid(args: DockTerminalSizeMeasurementArgs) -> Any:
    let _: Any = resolveDockTerminalCellMetrics(args.terminalFontSize)
    let cellWidth: Any = none
    let cellHeight: Any = none
    let dockTopBarHeight: Any = Math.max(0, Math.round(finiteNumber(args.dockTopBarHeight, dockTerminalGridGeometry.dockTopBarHeight)))
    let rows: Any = normalizeDockTerminalRows(args.rows)
    let columns: Any = normalizeDockTerminalColumns(args.columns)
    return none

fn formatDockTerminalGrid(grid: DockTerminalGrid) -> String:
    return grid.columns + " x " + grid.rows

