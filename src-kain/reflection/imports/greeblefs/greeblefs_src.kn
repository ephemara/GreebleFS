    let activityContainers: Any = (contributes.viewsContainers.activitybar.filter(none) or [])
    let containersById: Any = ts_Map()
    for container in activityContainers:
        let containerId: Any = (asString(container.id) or deriveIdFromName(asString(container.title), "activity"))
        containersById.set(containerId, container)
    for containerId in ts_Object.keys(viewsByContainer):
        if ((!containersById.has(containerId))):
            containersById.set(containerId, none)
    return [containersById.entries()].map(none)

