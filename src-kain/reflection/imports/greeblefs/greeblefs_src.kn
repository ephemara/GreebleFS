fn invoke(command: String, args: Any) -> Any:
    let payload: Any = args
    if ((command == "fs_get_drives")):
        return []
    else if ((command == "fs_get_home_dir")):
        return REPO_ROOT
    else if ((command == "fs_get_runtime_cache_policy")):
        return RUNTIME_POLICY
    else if ((command == "fs_list_dir")):
        ()
    else if ((command == "fs_list_dir_uncached")):
        return EXPLORER_ENTRIES
    else if ((command == "fs_measure_entry_sizes")):
        return buildEntrySizeResults((payload.paths or []))
    else if ((command == "fs_resolve_native_icons")):
        ()
    else if ((command == "fs_search_entries")):
        return []
    else if ((command == "fs_search_entries_with_diagnostics")):
        return none
    else if ((command == "fs_watch_entry_size_root")):
        ()
    else if ((command == "fs_unwatch_entry_size_root")):
        ()
    else if ((command == "fs_cancel_search_entries")):
        return none
    else:
        ()

