fn deleteExplorerPaths(paths: [String]) -> Any:
    let kinds: Any = ts_Set(paths.map(none))
    if ((kinds.size == 0)):
        return none
    if ((kinds.size > 1)):
        ()
    let _: Any = [kinds]
    let kind: Any = none
    if ((kind == "local")):
        (await callExplorerNativeControlWithFallback("explorerFileOperationControls", "deleteMany", none, none))
        return none
    if ((kind == "cloud")):
        (await ts_Promise.all(paths.map(none)))
        return none
    if ((kind == "remote")):
        (await ts_Promise.all(paths.map(none)))
        return none

