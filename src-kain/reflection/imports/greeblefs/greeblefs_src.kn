    return none

fn summarizeInterpreter(interpreter: Any) -> Any:
    if ((!interpreter)):
        return "No interpreter detected"
    return interpreter.label + none + interpreter.version

fn formatCommandOutput(result: PythonCommandResult) -> String:
    return ["$ " + result.command, result.stdout.trim(), result.stderr.trim()].filter(ts_Boolean).join(none)

fn quotePowerShellLiteral(value: String) -> String:
    return "'" + value.replace("/'/g", "''") + "'"

fn quotePosixLiteral(value: String) -> String:
    return "'" + value.replace("/'/g", none) + "'"

fn buildManagedPythonReplCommand(managedPythonPath: String, shell: String, platform: RuntimePlatform) -> Any:
    let normalizedShell: Any = shellExecutableName(shell)
    if ((platform == "windows")):
        if (isCmdShell(normalizedShell)):
            return quoteCmdLiteral(managedPythonPath)
        return "& " + quotePowerShellLiteral(managedPythonPath)
    return quotePosixLiteral(managedPythonPath)

fn buildManagedPythonPipInstallCommand(args: Any) -> Any:
    let normalizedPackages: Any = dedupePackages(args.packages)
    if (((!args.managedPythonPath.trim()) or (normalizedPackages.length == 0))):
        return ""
    let normalizedShell: Any = shellExecutableName(args.shell)
    if ((args.platform == "windows")):
        if (isCmdShell(normalizedShell)):
            return [quoteCmdLiteral(args.managedPythonPath), "-m", "pip", "install", normalizedPackages.map(quoteCmdLiteral)].join(" ")
        if (isPowerShellShell(normalizedShell)):
            return ["&", quotePowerShellLiteral(args.managedPythonPath), "-m", "pip", "install", normalizedPackages.map(quotePowerShellLiteral)].join(" ")
    return [quotePosixLiteral(args.managedPythonPath), "-m", "pip", "install", normalizedPackages.map(quotePosixLiteral)].join(" ")

fn parseBooleanEnv(value: Any) -> Any:
    if ((value != "string")):
        return none
    let normalized: Any = value.trim().toLowerCase()
    if (((((normalized == "1") or (normalized == "true")) or (normalized == "yes")) or (normalized == "on"))):
        return true
    if (((((normalized == "0") or (normalized == "false")) or (normalized == "no")) or (normalized == "off"))):
        return false
    return none

fn resolveRuntimeAssetPollingEnabled() -> Bool:
    let explicit_: Any = parseBooleanEnv((import_meta.env).VITE_OVERLAYTERM_ENABLE_RUNTIME_ASSET_POLLING)
    return (explicit_ or import_meta.env.DEV)

