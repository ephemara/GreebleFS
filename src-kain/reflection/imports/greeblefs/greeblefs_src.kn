    (await hydrateGpuRuntimeStatus())
    (await ensureGpuRuntimeSubscription())
    let snapshot: Any = useGpuRuntimeStore.getState().snapshot
    if (((lastConfiguredMode == mode) and (snapshot.configuredMode == mode))):
        return none
    (await applyGpuRuntimeMode(mode))

