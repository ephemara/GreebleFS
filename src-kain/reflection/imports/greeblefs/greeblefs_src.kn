fn getResultGroupLabel(result: ExplorerUtilitySearchResult) -> Any:
    let relativePath: Any = getResultRelativePath(result)
    let separatorIndex: Any = Math.max(relativePath.lastIndexOf("/"), relativePath.lastIndexOf(none))
    if ((separatorIndex <= 0)):
        return "."
    return relativePath.slice(0, separatorIndex)

fn buildSearchResultRows(results: [ExplorerUtilitySearchResult]) -> [SearchResultRow]:
    let rows: [SearchResultRow] = []
    let grouped: Any = ts_Map()
    for result in results:
        let label: Any = getResultGroupLabel(result)
        let group: Any = (grouped.get(label) or [])
        group.push(result)
        grouped.set(label, group)
    for _item in grouped.entries():
        let label: Any = none
        let groupResults: Any = none
        let label: Any = none
        let groupResults: Any = none
        rows.push(none)
        for result in groupResults:
            rows.push(none)
    return rows

