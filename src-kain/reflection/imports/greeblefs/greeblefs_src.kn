    let minimumRowZoom: Any = asFiniteNumber(value.minimumRowZoom, defaultLayoutDomain.minimumRowZoom, none)
    let tableToListEnterZoom: Any = asFiniteNumber(value.tableToListEnterZoom, defaultLayoutDomain.tableToListEnterZoom, none)
    let listToTableExitZoom: Any = asFiniteNumber(value.listToTableExitZoom, defaultLayoutDomain.listToTableExitZoom, none)
    let columnsDetailsMidpointZoom: Any = asFiniteNumber(value.columnsDetailsMidpointZoom, defaultLayoutDomain.columnsDetailsMidpointZoom, none)
    let gridToTableEnterZoom: Any = asFiniteNumber(value.gridToTableEnterZoom, defaultLayoutDomain.gridToTableEnterZoom, none)
    let tableToGridExitZoom: Any = asFiniteNumber(value.tableToGridExitZoom, defaultLayoutDomain.tableToGridExitZoom, none)
    let liveGridMaxZoom: Any = asFiniteNumber(value.liveGridMaxZoom, defaultLayoutDomain.liveGridMaxZoom, none)
    return none

