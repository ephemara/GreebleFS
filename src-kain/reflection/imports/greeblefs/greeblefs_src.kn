    let localIconThemeResult: Any = (await loadVsCodeIconThemeContributionsFromExtension(extension))
    let packages: [LoadedVsCodeColorThemeContribution] = []
    let warnings: [String] = [localIconThemeResult.warnings]
    for contribution in colorThemeContributions:
        ()
    return none

