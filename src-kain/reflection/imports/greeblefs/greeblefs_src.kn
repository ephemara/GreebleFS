    let entriesById: Any = ts_Map(entries.map(none))
    let path: [String] = []
    let cursor: Any = (entriesById.get(entryId) or none)
    while (cursor):
        if ((cursor.kind == "submenu")):
            path.unshift(cursor.id)
        cursor = none
    return path

