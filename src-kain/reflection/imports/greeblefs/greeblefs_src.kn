fn groupPluginsByCategory(plugins: [LoadedOverlayPlugin]) -> Any:
    let groups: Any = ts_Map()
    let iter_12: Any = plugins
    let index_13: Any = 0
    while ((index_13 < iter_12.length)):
        let plugin: Any = iter_12[index_13]
        let category: Any = getPluginCategory(plugin)
        groups.set(category, [((groups.get(category) or [])), plugin])
        index_13 = (index_13 + 1)
    return [groups.entries()].sort(none).map(none)

