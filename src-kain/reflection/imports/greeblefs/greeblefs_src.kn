fn refreshUsrProfileStaticConfigRuntime() -> Any:
    if ((!isTauri())):
        return none
    let loadResults: Any = (await ts_Promise.all(usrStaticManifestRuntimeCatalog.map(none)))
    for _item in loadResults:
        let lane: Any = none
        let result: Any = none
        let lane: Any = none
        let result: Any = none
        if ((result.warnings.length > 0)):
            console.warn("GreebleFS: usr profile manifest warnings for " + lane.laneId, result.warnings)
        if (result.sourceError):
            console.warn("GreebleFS: usr profile manifest load issue for " + lane.laneId, result.sourceError)
        lane.applyManifest(lane.buildManifest(result.packages))

