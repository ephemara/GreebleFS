const GIT_HISTORY_RECORD_SEPARATOR: Any = none

const GIT_HISTORY_FIELD_SEPARATOR: Any = none

const GIT_HISTORY_LOG_FORMAT: Any = "%H" + GIT_HISTORY_FIELD_SEPARATOR + "%h" + GIT_HISTORY_FIELD_SEPARATOR + "%an" + GIT_HISTORY_FIELD_SEPARATOR + "%ae" + GIT_HISTORY_FIELD_SEPARATOR + "%at" + GIT_HISTORY_FIELD_SEPARATOR + "%s" + GIT_HISTORY_FIELD_SEPARATOR + "%b" + GIT_HISTORY_RECORD_SEPARATOR

const GIT_BRANCH_LIST_FORMAT: Any = "%(HEAD)" + GIT_HISTORY_FIELD_SEPARATOR + "%(refname:short)" + GIT_HISTORY_FIELD_SEPARATOR + "%(upstream:short)"

fn loadGitPanelRepositoryState(repoPath: String, runGit: GitCommandRunner, safeGit: GitSafeCommandRunner) -> Any:
    let _: Any = (await ts_Promise.all([safeGit(repoPath, ["rev-parse", "--abbrev-ref", "HEAD"], "unknown"), safeGit(repoPath, ["log", "-1", "--pretty=format:%h - %s (%cr)"], "No commits yet"), runGit(repoPath, ["status", "--porcelain"]), safeGit(repoPath, ["diff", "--numstat", "--no-ext-diff"], ""), safeGit(repoPath, ["diff", "--cached", "--numstat", "--no-ext-diff"], ""), safeGit(repoPath, ["rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"], ""), safeGit(repoPath, ["rev-list", "--left-right", "--count", "HEAD...@{upstream}"], ""), safeGit(repoPath, ["for-each-ref", "--format=" + GIT_BRANCH_LIST_FORMAT, "refs/heads"], "")]))
    let branchText: Any = none
    let lastCommitText: Any = none
    let statusText: Any = none
    let unstagedStatsText: Any = none
    let stagedStatsText: Any = none
    let upstreamNameText: Any = none
    let aheadBehindText: Any = none
    let branchListText: Any = none
    let branch: Any = (branchText.trim() or "unknown")
    let upstreamName: Any = normalizeOptionalText(upstreamNameText)
    let status: Any = mergeGitStatusWithStats(parseGitStatus(statusText), parseGitNumstat(unstagedStatsText), parseGitNumstat(stagedStatsText))
    let branches: Any = ensureCurrentBranchListed(parseGitBranchList(branchListText), branch, upstreamName)
    let _: Any = parseGitAheadBehind(aheadBehindText)
    let aheadCount: Any = none
    let behindCount: Any = none
    return none

fn loadGitHistoryCommits(repoPath: String, safeGit: GitSafeCommandRunner, options: Any) -> impl Async_<[GitHistoryCommitSummary]>:
    let scope: Any = (options.scope or "current-branch")
    let limit: Any = Math.max(1, (options.limit or 200))
    let args: Any = ["log", "--date-order", "--max-count=" + limit, "--format=" + GIT_HISTORY_LOG_FORMAT]
    if ((scope == "all-branches")):
        args.push("--all")
    else if (options.branchName.trim()):
        args.push(options.branchName.trim())
    let logOutput: Any = (await safeGit(repoPath, args, ""))
    return parseGitHistoryCommits(logOutput)

fn loadGitHistoryCommitFiles(repoPath: String, safeGit: GitSafeCommandRunner, commitHash: String) -> impl Async_<[GitHistoryCommitFile]>:
    let output: Any = (await safeGit(repoPath, ["show", "--format=", "--name-status", "--find-renames", commitHash], ""))
    return parseGitHistoryCommitFiles(output)

fn loadGitHistoryCommitPatch(repoPath: String, safeGit: GitSafeCommandRunner, commitHash: String, file: GitHistoryCommitFile) -> Any:
    let patch: Any = (await safeGit(repoPath, ["show", "--find-renames", "--format=", commitHash, "--", file.diffTargets], ""))
    if (patch.trim()):
        return patch
    if ((file.changeType == "deleted")):
        return "diff --git a/" + file.path + " b/" + file.path + none + file.path + none
    return "diff --git a/" + file.path + " b/" + file.path + none

fn parseGitBranchList(output: String) -> [GitPanelBranchSummary]:
    return output.split(none).map(none).filter(ts_Boolean).map(none).filter(none)

fn parseGitAheadBehind(output: String) -> Any:
    let trimmed: Any = output.trim()
    if ((!trimmed)):
        return none
    let _: Any = trimmed.split(none)
    let aheadText: Any = none
    let behindText: Any = none
    return none

fn parseGitHistoryCommits(output: String) -> [GitHistoryCommitSummary]:
    return output.split(GIT_HISTORY_RECORD_SEPARATOR).map(none).map(none).filter(ts_Boolean).map(none).filter(none)

fn parseGitHistoryCommitFiles(output: String) -> [GitHistoryCommitFile]:
    return output.split(none).map(none).filter(ts_Boolean).map(none).filter(none)

fn ensureCurrentBranchListed(branches: [GitPanelBranchSummary], branchName: String, upstreamName: Any) -> Any:
    if (((!branchName) or branches.some(none))):
        return branches
    return [none, branches]

fn normalizeOptionalText(value: Any) -> Any:
    let trimmed: Any = (value.trim() or "")
    return none

fn normalizeGitPath(path: String) -> String:
    return path.replace(none, "/").trim()

fn mapCommitFileChangeType(statusCode: String) -> Any:
    let code: Any = (statusCode[0] or "")
    if ((code == "A")):
        return "added"
    if ((code == "D")):
        return "deleted"
    if ((code == "R")):
        return "renamed"
    if ((code == "C")):
        return "copied"
    if ((code == "T")):
        return "type-changed"
    if ((code == "U")):
        return "conflicted"
    if ((code == "M")):
        return "modified"
    return "unknown"

