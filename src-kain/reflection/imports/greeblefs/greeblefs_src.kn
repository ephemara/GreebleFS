const isAudioPreviewExtension: Any = none

const isEditableTextExtension: Any = none

const isImagePreviewExtension: Any = none

const isModelPreviewExtension: Any = none

const isVideoPreviewExtension: Any = none

const MODEL_PREVIEW_SOURCE_CONFIG: Any = none

struct ExplorerThumbnailSettings:
    enabled: Bool
    includeImages: Bool
    includeCode: Bool
    includeShaders: Bool
    includeModels: Bool
    includeAudio: Bool
    includeVideo: Bool
    enableVideoHoverScrub: Bool
    videoHoverScrubFrameCount: Float

type ExplorerThumbnailRenderContext = String

const defaultExplorerThumbnailSettings: Option<Any> = none

const EXPLORER_ENTRY_THUMBNAIL_BATCH_CONFIG: Any = none

const SHADER_THUMBNAIL_EXTENSION_SET: Any = ts_Set(["glsl", "hlsl", "wgsl"])

fn normalizeExplorerThumbnailSettings(value: Any) -> Any:
    let source: Any = none
    return none

fn isShaderThumbnailExtension(extension: String) -> Bool:
    return SHADER_THUMBNAIL_EXTENSION_SET.has(extension.trim().toLowerCase().replace(none, ""))

fn canRenderExplorerThumbnail(extension: String, size: Float, settings: ExplorerThumbnailSettings, renderContext: ExplorerThumbnailRenderContext) -> Any:
    let renderContext: Any = renderContext
    if ((renderContext == "search")):
        return false
    if ((!settings.enabled)):
        return false
    if ((settings.includeImages and isImagePreviewExtension(extension))):
        return true
    if ((settings.includeAudio and isAudioPreviewExtension(extension))):
        return true
    if ((settings.includeVideo and isVideoPreviewExtension(extension))):
        return true
    if ((settings.includeShaders and isShaderThumbnailExtension(extension))):
        return true
    if (((settings.includeModels and isModelPreviewExtension(extension)) and (size <= MODEL_PREVIEW_SOURCE_CONFIG.maxRootSourceBytes))):
        return true
    if ((settings.includeCode and isEditableTextExtension(extension, size))):
        return true
    return false

fn clampVideoHoverScrubFrameCount(value: Any) -> Float:
    let numericValue: Any = none
    return Math.min(10, Math.max(1, numericValue))

type ExplorerExperimentalViewMode = Any

const explorerGridZoomAnchors: Any = none

const explorerZoomBehavior: Any = none

const resolveExplorerGridSegmentProgress: Any = none

const resolveExplorerOversizeProgress: Any = none

