const SYNCED_OVERLAY_APPEARANCE_STORAGE_KEY: Any = "greeblefs:appearance:resolved-snapshot"

const SYNCED_OVERLAY_APPEARANCE_EVENT: Any = "greeblefs:appearance:resolved-snapshot"

fn createSyncedOverlayAppearanceSnapshot(appearance: ResolvedOverlayAppearance, publishedAt: Any) -> Any:
    let publishedAt: Any = publishedAt
    return none

fn publishSyncedOverlayAppearanceSnapshot(appearance: ResolvedOverlayAppearance, options: Any) -> SyncedOverlayAppearanceSnapshot:
    let snapshot: Any = createSyncedOverlayAppearanceSnapshot(appearance)
    let storage: Any = (options.storage or getBrowserLocalStorage())
    let target: Any = (options.target or getBrowserWindow())
    target.dispatchEvent(CustomEvent(SYNCED_OVERLAY_APPEARANCE_EVENT, none))
    return snapshot

fn readSyncedOverlayAppearanceSnapshot(storage: Any) -> Any:
    let activeStorage: Any = (storage or getBrowserLocalStorage())
    if ((!activeStorage)):
        return none

fn listenToSyncedOverlayAppearanceSnapshots(listener: Any, options: Any) -> Any:
    let target: Any = (options.target or getBrowserWindow())
    let storage: Any = (options.storage or getBrowserLocalStorage())
    let handleSnapshotEvent: Any = none
    let handleStorageEvent: Any = none
    target.addEventListener(SYNCED_OVERLAY_APPEARANCE_EVENT, handleSnapshotEvent)
    target.addEventListener("storage", handleStorageEvent)
    let currentSnapshot: Any = parseSyncedOverlayAppearanceSnapshot(readSyncedOverlayAppearanceSnapshot(storage))
    if (currentSnapshot):
        listener(currentSnapshot)
    return none

fn parseSyncedOverlayAppearanceSnapshot(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    let record: Any = value
    if ((record.version != 1)):
        return none
    let cssVars: Any = parseStringRecord(record.cssVars)
    let explorerCssVars: Any = parseStringRecord(record.explorerCssVars)
    let fonts: Any = parseFonts(record.fonts)
    let palette: Any = parsePalette(record.palette)
    let themeId: Any = none
    let themeName: Any = none
    let mode: Any = none
    if (((((((!themeId) or (!themeName)) or (!cssVars)) or (!explorerCssVars)) or (!fonts)) or (!palette))):
        return none
    return none

fn parseFonts(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    let record: Any = value
    let ui: Any = none
    let mono: Any = none
    if (((!ui) or (!mono))):
        return none
    return none

fn parsePalette(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    let record: Any = value
    let requiredKeys: [Any] = ["appBackground", "appBackgroundAlt", "shellBackground", "shellBackgroundSolid", "topBarBackground", "topBarMenuBackground", "sidebarBackground", "panelBackground", "panelAltBackground", "cardBackground", "cardHoverBackground", "contextMenuBackground", "inputBackground", "terminalBackground", "selectionBackground", "scrimBackground", "textPrimary", "textSecondary", "textMuted", "textDim", "textInverse", "border", "borderStrong", "accent", "accentSoft", "accentContrast", "success", "warning", "danger", "info", "note", "todo", "bug", "prompt"]
    if (requiredKeys.some(none)):
        return none
    return ts_Object.fromEntries(requiredKeys.map(none))

fn parseStringRecord(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    return sanitizeStringRecord(value)

fn sanitizeStringRecord(value: Any) -> Any:
    return ts_Object.fromEntries(ts_Object.entries(value).filter(none))

fn getBrowserLocalStorage() -> Any:
    if ((window == "undefined")):
        return none
    return window.localStorage

fn getBrowserWindow() -> Any:
    if ((window == "undefined")):
        return none
    return window

