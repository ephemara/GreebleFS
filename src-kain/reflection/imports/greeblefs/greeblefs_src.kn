fn resolveShellBackgroundColor(translucentColor: String, solidColor: String, blurStrength: Float, parseColor: Any, withColorAlpha: Any) -> String:
    let normalizedStrength: Any = none
    let solidAlpha: Any = (parseColor(solidColor).alpha or 0.96)
    let translucentAlpha: Any = (parseColor(translucentColor).alpha or Math.min(0.82, solidAlpha))
    let minimumGlassAlpha: Any = Math.max(0.16, (translucentAlpha * 0.45))
    let targetAlpha: Any = (solidAlpha - ((((solidAlpha - minimumGlassAlpha)) * normalizedStrength)))
    return withColorAlpha(translucentColor, targetAlpha)

