const CONSTELLATION_CAMERA_ZOOM_RANGE: Any = ts_Object.freeze(none)

const CONSTELLATION_CAMERA_FIT_PADDING: Any = 72

fn clampNumber(value: Float, min: Float, max: Float) -> Any:
    if ((value < min)):
        return min
    if ((value > max)):
        return max
    return value

fn clampConstellationZoom(zoom: Float) -> Float:
    return clampNumber(none, CONSTELLATION_CAMERA_ZOOM_RANGE.min, CONSTELLATION_CAMERA_ZOOM_RANGE.max)

fn getConstellationScaledWorldSize(layout: ConstellationFieldLayout, zoom: Float) -> Any:
    let normalizedZoom: Any = clampConstellationZoom(zoom)
    return none

fn getConstellationFitZoom(layout: ConstellationFieldLayout, metrics: ConstellationViewportMetrics) -> Any:
    if (((metrics.viewportWidth <= 0) or (metrics.viewportHeight <= 0))):
        return CONSTELLATION_CAMERA_ZOOM_RANGE.default_
    let safeWidth: Any = Math.max(1, (metrics.viewportWidth - ((CONSTELLATION_CAMERA_FIT_PADDING * 2))))
    let safeHeight: Any = Math.max(1, (metrics.viewportHeight - ((CONSTELLATION_CAMERA_FIT_PADDING * 2))))
    return clampConstellationZoom(Math.min((safeWidth / layout.width), (safeHeight / layout.height)))

fn clampConstellationCameraPan(nextPan: Any, metrics: ConstellationViewportMetrics, layout: ConstellationFieldLayout, zoom: Float) -> Any:
    let _: Any = getConstellationScaledWorldSize(layout, zoom)
    let width: Any = none
    let height: Any = none
    let x: Any = none
    let y: Any = none
    return none

fn createConstellationFitCamera(layout: ConstellationFieldLayout, metrics: ConstellationViewportMetrics) -> Any:
    let zoom: Any = getConstellationFitZoom(layout, metrics)
    let pan: Any = clampConstellationCameraPan(none, metrics, layout, zoom)
    return none

fn centerConstellationCameraOnNode(layout: ConstellationFieldLayout, node: ConstellationFieldNode, metrics: ConstellationViewportMetrics, zoom: Float) -> Any:
    let normalizedZoom: Any = clampConstellationZoom(zoom)
    let pan: Any = clampConstellationCameraPan(none, metrics, layout, normalizedZoom)
    return none

fn zoomConstellationCameraAtViewportPoint(camera: ConstellationCameraState, targetZoom: Float, focalPoint: ConstellationViewportPoint, metrics: ConstellationViewportMetrics, layout: ConstellationFieldLayout) -> Any:
    let normalizedNextZoom: Any = clampConstellationZoom(targetZoom)
    let worldX: Any = (((focalPoint.x - camera.x)) / Math.max(camera.zoom, 0.001))
    let worldY: Any = (((focalPoint.y - camera.y)) / Math.max(camera.zoom, 0.001))
    let pan: Any = clampConstellationCameraPan(none, metrics, layout, normalizedNextZoom)
    return none

fn getConstellationWheelZoom(currentZoom: Float, deltaY: Float) -> Float:
    return clampConstellationZoom((currentZoom * Math.exp((((-deltaY)) * 0.0012))))

