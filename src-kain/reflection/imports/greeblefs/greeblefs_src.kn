fn nextConsoleEntryId() -> String:
    consoleEntrySequence = (consoleEntrySequence + 1)
    return "gfs-dev-mcp-console-" + consoleEntrySequence

fn appendConsoleEntry(entry: DevMcpBridgeConsoleEntryInput) -> ():
    let nextEntry: Any = none
    consoleEntries.push(nextEntry)
    if ((consoleEntries.length > MAX_CONSOLE_ENTRIES)):
        consoleEntries.splice(0, (consoleEntries.length - MAX_CONSOLE_ENTRIES))
    recordDevObservatoryEvent(none).catch_(none)

fn summarizeUnknownValue(value: Any, depth: Any) -> Any:
    let depth: Any = depth
    if ((value == none)):
        return value
    if ((value == "string")):
        return none
    if (((value == "number") or (value == "boolean"))):
        return value
    if ((value == "bigint")):
        return value.toString()
    if ((value == "function")):
        return "[function " + (value.name or "anonymous") + "]"
    if (ts_instanceof_operator(value, Error)):
        return none
    if (ts_Array.isArray(value)):
        if ((depth >= 2)):
            return "[array(" + value.length + ")]"
        return value.slice(0, 12).map(none)
    if (ts_instanceof_operator(value, HTMLElement)):
        return none
    if ((value == "object")):
        if ((depth >= 2)):
            return "[object]"
        let record: Any = value
        return ts_Object.fromEntries(ts_Object.entries(record).slice(0, 20).map(none))
    return ts_String(value)

fn buildConsoleMessage(values: [Any]) -> String:
    return values.map(none).join(" ")

fn installConsoleCapture() -> Any:
    let captureState: Any = (window.GREEBLEFS_DEV_MCP_CONSOLE_CAPTURE or none)
    captureState.appendEntry = appendConsoleEntry
    window.GREEBLEFS_DEV_MCP_CONSOLE_CAPTURE = captureState
    let consoleMethods: [ConsoleEntryLevel] = ["debug", "info", "log", "warn", "error"]
    for level in consoleMethods:
        if (captureState.originalMethods[level]):
            continue
        let original: Any = console[level].bind(console)
        ()
        ()
    if (captureState.globalListenersInstalled):
        return none
    captureState.globalListenersInstalled = true
    window.addEventListener("error", none)
    window.addEventListener("unhandledrejection", none)

fn buildElementPath(element: Element) -> String:
    let segments: [String] = []
    let current: Any = element
    while ((current and (segments.length < 6))):
        if (ts_instanceof_operator(current, HTMLElement)):
            let explicitId: Any = ((current.getAttribute("data-gfs-agent-id") or current.getAttribute("data-agent-id")) or current.id)
            if (explicitId):
                segments.unshift(current.tagName.toLowerCase() + "#" + explicitId)
                break
        let tagName: Any = current.tagName.toLowerCase()
        let parent: Any = current.parentElement
        if ((!parent)):
            segments.unshift(tagName)
            break
        let currentTagName: Any = current.tagName
        let siblings: Any = ts_Array.from(parent.children).filter(none)
        let siblingIndex: Any = (siblings.indexOf(current) + 1)
        segments.unshift(tagName + ":nth-of-type(" + Math.max(siblingIndex, 1) + ")")
        current = parent
    return segments.join(" > ")

fn readAccessibleName(element: Element) -> Any:
    if ((!(ts_instanceof_operator(element, HTMLElement)))):
        return none
    let ariaLabel: Any = element.getAttribute("aria-label").trim()
    if (ariaLabel):
        return ariaLabel
    let labelledById: Any = element.getAttribute("aria-labelledby").trim()
    if (labelledById):
        let labelText: Any = labelledById.split(none).map(none).filter(ts_Boolean).join(" ")
        if (labelText):
            return labelText
    if (ts_in_operator("labels", element)):
        let labels: Any = ts_Array.from(((element).labels or []))
        let labelText: Any = labels.map(none).filter(ts_Boolean).join(" ")
        if (labelText):
            return labelText
    let placeholder: Any = element.getAttribute("placeholder").trim()
    if (placeholder):
        return placeholder
    let title: Any = element.getAttribute("title").trim()
    if (title):
        return title
    let text: Any = element.innerText.trim()
    return none

fn isElementVisible(element: HTMLElement) -> Any:
    let style: Any = window.getComputedStyle(element)
    if ((((style.display == "none") or (style.visibility == "hidden")) or (style.opacity == "0"))):
        return false
    let rect: Any = element.getBoundingClientRect()
    return ((rect.width > 0) and (rect.height > 0))

fn collectThemeVariables() -> Any:
    let style: Any = window.getComputedStyle(document.documentElement)
    let variables: Option<Any> = none
    for name in ts_Array.from(style):
        if (((!name.startsWith("--gfs-")) and (!name.startsWith("--overlayterm-")))):
            continue
        let value: Any = style.getPropertyValue(name).trim()
        if (value):
            ()
    return variables

fn collectDomNodes() -> [DevMcpBridgeDomNodeSnapshot]:
    let selector: Any = ["button", "a[href]", "input", "select", "textarea", "[role]", "[aria-label]", "[title]", "[data-gfs-agent-id]", "[data-agent-id]", "[data-action-id]"].join(",")
    let nodes: [DevMcpBridgeDomNodeSnapshot] = []
    let elements: Any = ts_Array.from(document.querySelectorAll(selector)).slice(0, (MAX_DOM_NODES * 3))
    for element in elements:
        let visible: Any = isElementVisible(element)
        if (((!visible) and (!element.matches(none)))):
            continue
        let computedStyle: Any = window.getComputedStyle(element)
        let rect: Any = element.getBoundingClientRect()
        nodes.push(none)
        if ((nodes.length >= MAX_DOM_NODES)):
            break
    return nodes

fn createSettingsExcerpt() -> Any:
    let settings: Any = useSettingsStore.getState().settings
    if ((!settings)):
        return none
    let pickedKeys: Any = ["appearance", "presentation", "dock", "explorer", "layout", "terminal", "system", "plugins"]
    return ts_Object.fromEntries(pickedKeys.filter(none).map(none))

