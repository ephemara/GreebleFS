        return "Saved in Settings"
    else if ((source == "environment")):
        return "Bundled / Environment"
    else:
        return "Not Configured"

fn getHomeEntryLabel(path: String) -> Any:
    let trimmed: Any = path.replace(none, "")
    if ((!trimmed)):
        return "Home"
    let segments: Any = trimmed.split(none).filter(ts_Boolean)
    return (segments[(segments.length - 1)] or trimmed)

fn formatModelCacheBytes(bytes: Any) -> Any:
    if ((((bytes != "number") or (!ts_Number.isFinite(bytes))) or (bytes <= 0))):
        return "0 B"
    if ((bytes < 1024)):
        return bytes + " B"
    if ((bytes < (1024 ** 2))):
        return ((bytes / 1024)).toFixed(1) + " KB"
    if ((bytes < (1024 ** 3))):
        return ((bytes / (1024 ** 2))).toFixed(1) + " MB"
    return ((bytes / (1024 ** 3))).toFixed(2) + " GB"

fn formatModelTimestamp(epochMs: Any) -> Any:
    if ((((epochMs != "number") or (!ts_Number.isFinite(epochMs))) or (epochMs <= 0))):
        return "Not warmed yet"
    return Date(epochMs).toLocaleString()

