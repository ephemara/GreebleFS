fn getExplorerChromeSurfaceContextLabel(surfaceId: ExplorerChromeSurfaceId) -> String:
    if ((surfaceId == "explorerTopbar")):
        return "Explorer Top Bar"
    else if ((surfaceId == "explorerToolbar")):
        return "Explorer Toolbar"
    else if ((surfaceId == "workspaceHeader")):
        return "Workspace Header"
    else if ((surfaceId == "railHeader")):
        return "Rail Header"
    else if ((surfaceId == "previewHeader")):
        return "Preview Header"
    else if ((surfaceId == "explorerStatusBar")):
        return "Explorer Status Bar"
    else:
        return "Explorer Chrome"

