const EXPLORER_CONSTELLATION_UI_SELECTOR: Any = none

fn getExplorerZoomGestureTargetElement(target: Any) -> Any:
    return none

fn isExplorerZoomGestureVerticalDominant(gesture: Any) -> Bool:
    return ((Math.abs(gesture.normalizedDeltaY) > Math.abs(gesture.normalizedDeltaX)))

fn isExplorerZoomGestureMeaningful(gesture: Any, minimumAbsoluteDeltaPx: Any) -> Bool:
    let minimumAbsoluteDeltaPx: Any = minimumAbsoluteDeltaPx
    return (Math.abs(gesture.normalizedDeltaY) >= minimumAbsoluteDeltaPx)

fn isExplorerZoomGestureOnPrimarySurface(target: Any) -> Bool:
    return ((getExplorerZoomGestureTargetElement(target).closest(EXPLORER_PRIMARY_ZOOM_SURFACE_SELECTOR) != none))

fn isExplorerZoomGestureInsidePreviewSurface(target: Any) -> Bool:
    return ((getExplorerZoomGestureTargetElement(target).closest(EXPLORER_PREVIEW_ZOOM_SURFACE_SELECTOR) != none))

fn isExplorerZoomGestureInsideConstellationSurface(target: Any) -> Bool:
    return ((getExplorerZoomGestureTargetElement(target).closest(EXPLORER_CONSTELLATION_ZOOM_SURFACE_SELECTOR) != none))

fn isExplorerZoomGestureInsideConstellationUi(target: Any) -> Bool:
    return ((getExplorerZoomGestureTargetElement(target).closest(EXPLORER_CONSTELLATION_UI_SELECTOR) != none))

fn setExplorerLayoutCssVariable(element: HTMLElement, name: String, value: String):
    element.style.setProperty(name, value)

fn formatExplorerVerticalPaddingCss(padding: Any) -> Any:
    return padding.top + "px " + padding.horizontal + "px " + padding.bottom + "px"

fn resolveExplorerGridIconModeForCommittedViewMode(committedViewMode: ExplorerViewMode, resolvedState: ExplorerResolvedLayoutZoomState) -> Any:
    if (isExplorerGridMode(committedViewMode)):
        return committedViewMode
    if (((resolvedState.family == "grid") and isExplorerGridMode(resolvedState.viewMode))):
        return resolvedState.viewMode
    return none

fn applyExplorerLayoutZoomCssVariables(element: Any, layoutZoomState: ExplorerLayoutZoomState, explorerTheme: ResolvedExplorerThemeRecipe, committedViewMode: ExplorerViewMode) -> Any:
    if ((!element)):
        return none
    let resolvedState: Any = resolveExplorerLayoutZoomState(layoutZoomState)
    element.dataset.overlayExplorerLiveZoomFamily = resolvedState.family
    if ((resolvedState.family == "grid")):
        let iconMode: Any = resolveExplorerGridIconModeForCommittedViewMode(committedViewMode, resolvedState)
        let metrics: Any = applyExplorerThemeToGridMetrics(getExplorerGridMetricsForZoom(resolvedState.gridZoom), explorerTheme)
        let itemPadding: Any = formatExplorerVerticalPaddingCss(resolveExplorerGridItemPadding(metrics.iconStageSize))
        let thumbnailRadius: Any = resolveExplorerGridThumbnailRadius(metrics.tileRadius)
        element.dataset.overlayExplorerLiveGridIconBand = (iconMode or "")
        setExplorerLayoutCssVariable(element, "--overlay-explorer-grid-gap", metrics.gap + "px")
        setExplorerLayoutCssVariable(element, "--overlay-explorer-grid-padding", metrics.padding + "px")
        setExplorerLayoutCssVariable(element, "--overlay-explorer-grid-row-height", metrics.rowHeight + "px")
        setExplorerLayoutCssVariable(element, "--overlay-explorer-grid-new-item-height", metrics.newItemHeight + "px")
        setExplorerLayoutCssVariable(element, "--overlay-explorer-grid-tile-radius", metrics.tileRadius + "px")
        setExplorerLayoutCssVariable(element, "--overlay-explorer-grid-icon-stage-size", metrics.iconStageSize + "px")
        setExplorerLayoutCssVariable(element, "--overlay-explorer-grid-item-padding", itemPadding)
        setExplorerLayoutCssVariable(element, "--overlay-explorer-grid-thumbnail-radius", thumbnailRadius + "px")
        return none
    element.dataset.overlayExplorerLiveGridIconBand
    let rowMetrics: Any = applyExplorerThemeToRowMetrics(getExplorerViewModeDefinition("list").rows, explorerTheme)
    let rowHeight: Any = (rowMetrics.rowHeight or EXPLORER_LIST_ROW_HEIGHT)
    let newItemHeight: Any = (rowMetrics.newItemHeight or 42)
    let thumbnailStageSize: Any = resolveExplorerRowThumbnailStageSize((rowMetrics.iconSize or 16))
    setExplorerLayoutCssVariable(element, "--overlay-explorer-list-row-height", rowHeight + "px")
    setExplorerLayoutCssVariable(element, "--overlay-explorer-list-new-item-height", newItemHeight + "px")
    setExplorerLayoutCssVariable(element, "--overlay-explorer-list-thumbnail-size", thumbnailStageSize + "px")
    setExplorerLayoutCssVariable(element, "--overlay-explorer-list-padding", "12px")

type ExplorerSearchCacheEntry = Any

const explorerSearchResultCache: Any = ts_Map()

fn getExplorerSearchCacheKey(args: Any) -> String:
    return [args.path, args.query.trim().toLowerCase(), none, args.searchMode].join("::")

fn normalizeTextSearchResult(result: FileSearchResult, searchMode: Any) -> Any:
    return none

fn normalizeSemanticSearchResult(result: ExplorerSemanticSearchResultValue) -> Any:
    return none

fn getOrLoadCachedExplorerSearchResults(key: String, loader: Any) -> Any:
    let cachedValue: Any = explorerSearchResultCache.get(key)
    if (cachedValue):
        return none
    let pending: Any = loader().then(none).catch_(none)
    explorerSearchResultCache.set(key, pending)
    return pending

fn invalidateExplorerSearchResultCache(pathPrefix: String) -> Any:
    if ((!pathPrefix)):
        explorerSearchResultCache.clear()
        return none
    for key in explorerSearchResultCache.keys():
        if ((key.startsWith(pathPrefix + "::") or key.includes("::" + pathPrefix + "::"))):
            explorerSearchResultCache.delete_(key)

fn readViewportMetrics(viewport: HTMLDivElement) -> Any:
    return none

fn quantizeExplorerVirtualScrollTop(scrollTop: Float) -> Any:
    if (((!ts_Number.isFinite(scrollTop)) or (scrollTop <= 0))):
        return 0
    return ((Math.floor((scrollTop / EXPLORER_VIRTUAL_SCROLL_STATE_GRANULARITY_PX)) * EXPLORER_VIRTUAL_SCROLL_STATE_GRANULARITY_PX))

fn getExplorerPerformanceNow() -> Any:
    return none

fn getDocumentPreviewKind(path: String) -> Any:
    let ext: Any = (path.split(".").pop().toLowerCase() or "")
    if ((((ext == "md") or (ext == "markdown")) or (ext == "mdx"))):
        return "markdown"
    if (((ext == "html") or (ext == "htm"))):
        return "html"
    return "none"

struct ViewportMetrics:
    scrollTop: Float
    clientHeight: Float
    clientWidth: Float

struct ContextMenuState:
    visible: Bool
    x: Float
    y: Float
