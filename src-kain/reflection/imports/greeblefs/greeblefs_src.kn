fn applyGpuRuntimeMode(mode: GpuTierMode) -> impl Async_<GpuRuntimeStatusSnapshot>:
    let snapshot: Any = (await configureGpuRuntime(mode))
    lastConfiguredMode = mode
    useGpuRuntimeStore.getState().replaceSnapshot(snapshot)
    useGpuRuntimeStore.getState().setHydrationState("ready")
    return snapshot

