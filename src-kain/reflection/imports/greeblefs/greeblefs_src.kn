    fn componentDidUpdate(_self: ThemeRendererErrorBoundary, prevProps: Any):
        if (((prevProps.rendererName != _self.props.rendererName) and _self.state_.failed)):
            _self.setState(none)

    fn render(_self: ThemeRendererErrorBoundary) -> Any:
        if (_self.state_.failed):
            return _self.props.fallback
        return _self.props.children


