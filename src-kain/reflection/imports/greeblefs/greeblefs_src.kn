type ModelPreviewFormat = Any

const TARGET_MODEL_SIZE: Any = 2.4

fn getModelPreviewRotation(format: ModelPreviewFormat) -> Any:
    if ((((format == "fbx") or (format == "obj")) or (format == "stl"))):
        return THREE.Euler(((-Math.PI) / 2), 0, 0)
    return THREE.Euler(0, 0, 0)

fn normalizeModelForPreview(object: THREE_Object3D, format: ModelPreviewFormat, targetSize: Any) -> Any:
    let targetSize: Any = targetSize
    let root: Any = THREE.Group()
    let wrapper: Any = THREE.Group()
    wrapper.name = (object.name or "model") + "-normalized"
    wrapper.rotation.copy(getModelPreviewRotation(format))
    wrapper.add(object)
    root.add(wrapper)
    wrapper.updateWorldMatrix(true, true)
    let initialBounds: Any = THREE.Box3().setFromObject(root)
    if (initialBounds.isEmpty()):
        return root
    let initialSize: Any = initialBounds.getSize(THREE.Vector3())
    let maxDimension: Any = Math.max(initialSize.x, initialSize.y, initialSize.z, 0.001)
    let scale: Any = (targetSize / maxDimension)
    wrapper.scale.setScalar(scale)
    wrapper.updateWorldMatrix(true, true)
    let normalizedBounds: Any = THREE.Box3().setFromObject(root)
    let center: Any = normalizedBounds.getCenter(THREE.Vector3())
    wrapper.position.x = (wrapper.position.x - center.x)
    wrapper.position.z = (wrapper.position.z - center.z)
    wrapper.position.y = (wrapper.position.y - normalizedBounds.min.y)
    wrapper.updateWorldMatrix(true, true)
    root.userData.previewScale = scale
    root.userData.previewRotation = wrapper.rotation.toArray()
    return root

fn collectNormalizedBounds(object: THREE_Object3D) -> THREE_Box3:
    object.updateWorldMatrix(true, true)
    return THREE.Box3().setFromObject(object)

