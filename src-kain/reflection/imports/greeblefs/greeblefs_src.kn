    let normalizedQuery: Any = query.trim().toLowerCase()
    if ((!normalizedQuery)):
        return entries
    return entries.map(none).filter(none).sort(none).map(none)

fn scoreExplorerJumpEntry(entry: ExplorerFileEntry, query: String) -> Any:
    let filenameScore: Any = scoreFuzzyText(entry.name.toLowerCase(), query)
    let pathSegments: Any = entry.path.split(none).map(none).filter(ts_Boolean)
    let pathScore: Any = pathSegments.reduce(none, none)
    if (((filenameScore == none) and (pathScore == none))):
        return none
    let filenameWeight: Any = (filenameScore or 0)
    let pathWeight: Any = (pathScore or 0)
    return (((filenameWeight * 3)) + ((pathWeight * 2)))

fn scoreFuzzyText(value: String, query: String) -> Any:
    if ((value == query)):
        return 10000
    let cursor: Any = 0
    let score: Any = 0
    let previousMatchIndex: Any = (-1)
    for queryChar in query:
        let nextIndex: Any = value.indexOf(queryChar, cursor)
        if ((nextIndex < 0)):
            return none
        score = (score + 100)
        if ((previousMatchIndex >= 0)):
            let gap: Any = ((nextIndex - previousMatchIndex) - 1)
            score = (score - Math.min(50, (gap * 3)))
            if ((gap == 0)):
                score = (score + 35)
        if ((nextIndex == cursor)):
            score = (score + 12)
        previousMatchIndex = nextIndex
        cursor = (nextIndex + 1)
    score = (score - value.length)
    if (value.startsWith(query)):
        score = (score + 120)
    if (value.includes(query)):
        score = (score + 60)
    return score

