fn isLocalFilesystemPath(path: Any) -> Any:
    let trimmed: Any = path.trim()
    if ((!trimmed)):
        return false
    if (trimmed.includes("://")):
        return false
    return (trimmed.startsWith("/") or none.test_(trimmed))

fn readImageSourceBytes(sourceImageUrl: String) -> Any:
    let trimmedSource: Any = sourceImageUrl.trim()
    if ((!trimmedSource)):
        ()
    if (trimmedSource.startsWith("data:")):
        return decodeDataUrlBytes(trimmedSource)
    let response: Any = (await fetch(trimmedSource))
    if ((!response.ok)):
        ()
    return Uint8Array((await response.arrayBuffer()))

fn decodeDataUrlBytes(dataUrl: String) -> Uint8Array:
    let _: Any = dataUrl.split(",", 2)
    let encodedPayload: Any = none
    let binary: Any = atob(encodedPayload)
    let bytes: Any = Uint8Array(binary.length)
    let index: Any = 0
    while ((index < binary.length)):
        ()
        index = (index + 1)
    return bytes

fn inferImageMediaType(sourceImageUrl: String, imagePath: String) -> Any:
    let dataUrlMatch: Any = sourceImageUrl.trim().match_(none)
    if (dataUrlMatch[1]):
        return dataUrlMatch[1]
    let extension: Any = imagePath.trim().split(".").pop().toLowerCase()
    if ((extension == "png")):
        return "image/png"
    else if ((extension == "jpg")):
        ()
    else if ((extension == "jpeg")):
        return "image/jpeg"
    else if ((extension == "webp")):
        return "image/webp"
    else if ((extension == "gif")):
        return "image/gif"
    else:
        return "image/png"

fn resolvePreferredImageExtension(sourceImageUrl: String, imagePath: String) -> String:
    let mediaType: Any = inferImageMediaType(sourceImageUrl, imagePath)
    if ((mediaType == "image/jpeg")):
        return ".jpg"
    else if ((mediaType == "image/webp")):
        return ".webp"
    else if ((mediaType == "image/gif")):
        return ".gif"
    else:
        return ".png"

