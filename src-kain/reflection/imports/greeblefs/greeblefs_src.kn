fn readDirectoryOverride(id: ManagedContentDirectoryId) -> Any:
    let env: Any = import_meta.env
    let directoryDefinition: Any = managedContentDirectoryLookup.get(id)
    if ((!directoryDefinition.envVarSuffix)):
        return none
    let rawValue: Any = (env["VITE_GREEBLEFS_" + directoryDefinition.envVarSuffix + "_DIR"] or env["VITE_OVERLAYTERM_" + directoryDefinition.envVarSuffix + "_DIR"])
    let normalizedValue: Any = none
    return none

fn readUsrSourceRootOverride() -> Any:
    let env: Any = import_meta.env
    let rawValue: Any = (env[PRIMARY_USR_SOURCE_ROOT_ENV_VAR] or env[LEGACY_USR_SOURCE_ROOT_ENV_VAR])
    let normalizedValue: Any = none
    return none

fn appendRelativePath(basePath: String, relativeDirectory: String) -> String:
    let normalizedBasePath: Any = basePath.replace(none, "")
    let separator: Any = none
    return normalizedBasePath + separator + relativeDirectory

fn normalizePathForComparison(path: String) -> String:
    return path.replace(none, "/").replace(none, "").toLowerCase()

fn shouldUseReleaseManagedDirectories() -> Bool:
    return (isTauri() and (!import_meta.env.DEV))

fn resolveNativeManagedContentRoots() -> Any:
    if ((!isTauri())):
        return none

fn buildReleaseManagedDirectoryMap() -> impl Async_<Any>:
    let appLocalDataRoot: Any = ((await appLocalDataDir())).replace(none, "")
    let managedContentRoots: Any = (await resolveNativeManagedContentRoots())
    let writableManagedRoot: Any = none
    let resolvedEntries: Any = (await ts_Promise.all(managedContentDirectoryCatalog.map(none)))
    return ts_Object.fromEntries(resolvedEntries)

fn buildLegacyHomeDirectoryMap() -> impl Async_<Any>:
    let root: Any = ((await homeDir())).replace(none, "")
    return ts_Object.fromEntries((await ts_Promise.all(managedContentDirectoryCatalog.map(none))))

fn replaceTrailingDirectoryName(path: String, fromName: String, toName: String) -> Any:
    let escapedFromName: Any = fromName.replace(none, none)
    let pattern: Any = RegExp(none + escapedFromName + "$")
    if ((!pattern.test_(path))):
        return none
    return path.replace(pattern, "$1" + toName)

fn buildLegacyReleaseDirectoryMap() -> Any:
    let releaseRoot: Any = ((await appLocalDataDir())).replace(none, "")
    let legacyRoot: Any = replaceTrailingDirectoryName(releaseRoot, CURRENT_RELEASE_APP_IDENTIFIER, LEGACY_RELEASE_APP_IDENTIFIER)
    if (((!legacyRoot) or (normalizePathForComparison(legacyRoot) == normalizePathForComparison(releaseRoot)))):
        return none
    return ts_Object.fromEntries((await ts_Promise.all(managedContentDirectoryCatalog.map(none))))

fn migrateLegacyDirectory(legacyDirectory: Any, nextDirectory: String) -> Any:
    if ((!legacyDirectory)):
        return none
    if ((normalizePathForComparison(legacyDirectory) == normalizePathForComparison(nextDirectory))):
        return none
    if ((!((await exists(legacyDirectory))))):
        return none
    if ((await exists(nextDirectory))):
        return none
    let parentDirectory: Any = (await join(nextDirectory, ".."))
    (await mkdir(parentDirectory, none))
    (await rename(legacyDirectory, nextDirectory))

fn initializeManagedContentDirectories() -> Any:
    if (initializedManagedDirectories):
        return none
    if (initializationPromise):
        return initializationPromise
    initializationPromise = (none)()
    return initializationPromise

fn getManagedContentDirectory(id: ManagedContentDirectoryId) -> Any:
    let directoryDefinition: Any = managedContentDirectoryLookup.get(id)
    if ((!directoryDefinition)):
        return id
    let overrideDirectory: Any = readDirectoryOverride(id)
    if (overrideDirectory):
        return overrideDirectory
    let resolvedDirectory: Any = resolvedManagedDirectories[id]
    if (((resolvedDirectory == "string") and (resolvedDirectory.length > 0))):
        return resolvedDirectory
    if ((directoryDefinition.shippingMode == "shipped")):
        let manifestEntry: Any = getGreebleUsrManifestEntry(id)
        if (manifestEntry):
            let usrRootOverride: Any = readUsrSourceRootOverride()
            return appendRelativePath((usrRootOverride or "usr"), getGreebleUsrShippedRelativeDirectory(manifestEntry))
    return directoryDefinition.legacyRelativeDirectoryName

fn applyManagedContentDirectoryStackOverrides(overrides: [ManagedContentDirectoryStackOverride]) -> ():
    let nextSearchOverrides: Option<Any> = none
    let nextPrimaryOverrides: Option<Any> = none
    for override_ in overrides:
        let directoryId: Any = override_.laneId
        if ((!managedContentDirectoryLookup.has(directoryId))):
            continue
        let normalizedDirectories: Any = override_.directories.filter(none).map(none)
        if ((normalizedDirectories.length == 0)):
            continue
        ()
        let writableDirectory: Any = none
        ()
    managedContentDirectorySearchOverrides = nextSearchOverrides
    managedContentPrimaryDirectoryOverrides = nextPrimaryOverrides

fn clearManagedContentDirectoryStackOverrides() -> ():
    managedContentDirectorySearchOverrides = none
    managedContentPrimaryDirectoryOverrides = none

fn getManagedContentDirectorySearchDirectories(id: ManagedContentDirectoryId) -> Any:
    let overriddenDirectories: Any = managedContentDirectorySearchOverrides[id]
    if ((ts_Array.isArray(overriddenDirectories) and (overriddenDirectories.length > 0))):
        return [overriddenDirectories]
    return [getManagedContentDirectory(id)]

fn getManagedContentPrimaryDirectory(id: ManagedContentDirectoryId) -> Any:
    let overriddenDirectory: Any = managedContentPrimaryDirectoryOverrides[id]
    if (((overriddenDirectory == "string") and (overriddenDirectory.length > 0))):
        return overriddenDirectory
    return getManagedContentDirectory(id)

fn isLegacyScreenshotDirectory(path: Any) -> Any:
    if (((path != "string") or (path.trim().length == 0))):
        return false
    let normalizedPath: Any = normalizePathForComparison(path.trim())
    if ((normalizedPath == normalizePathForComparison(LEGACY_SCREENSHOT_DEFAULT_DIRECTORY))):
        return true
    let legacyHomeDirectory: Any = resolvedLegacyHomeDirectories.screenshots
    if (((legacyHomeDirectory == "string") and (normalizePathForComparison(legacyHomeDirectory) == normalizedPath))):
        return true
    let legacyReleaseDirectory: Any = resolvedLegacyReleaseDirectories.screenshots
    return (((legacyReleaseDirectory == "string") and (normalizePathForComparison(legacyReleaseDirectory) == normalizedPath)))

