const runtimeConfig: Any = none

const audioContextPromise: Any = none

const sampleBufferCache: Any = ts_Map()

const cueLastPlayedAt: Any = ts_Map()

fn clampUnit(value: Float) -> Any:
    if ((!ts_Number.isFinite(value))):
        return 0
    return Math.min(Math.max(value, 0), 1)

fn getAudioContextConstructor() -> Any:
    if ((window == "undefined")):
        return none
    let audioWindow: Any = window
    return ((audioWindow.AudioContext or audioWindow.webkitAudioContext) or none)

fn ensureAudioContext() -> Any:
    if (audioContextPromise):
        return audioContextPromise
    let AudioContextConstructor: Any = getAudioContextConstructor()
    if ((!AudioContextConstructor)):
        return none
    audioContextPromise = ts_Promise.resolve().then(none).catch_(none)
    return audioContextPromise

fn createMasterGainNode(context: AudioContext, gainValue: Float) -> GainNode:
    let gainNode: Any = context.createGain()
    gainNode.gain.value = clampUnit(gainValue)
    gainNode.connect(context.destination)
    return gainNode

fn connectOptionalStereoPan(context: AudioContext, sourceNode: AudioNode, targetNode: AudioNode, pan: Float) -> Any:
    if ((context.createStereoPanner != "function")):
        sourceNode.connect(targetNode)
        return sourceNode
    let stereoPanner: Any = context.createStereoPanner()
    stereoPanner.pan.value = Math.min(Math.max(pan, (-1)), 1)
    sourceNode.connect(stereoPanner)
    stereoPanner.connect(targetNode)
    return stereoPanner

fn scheduleTone(context: AudioContext, destinationNode: AudioNode, tone: LoadedOverlaySoundTone, cueVolume: Float) -> Float:
    let startAt: Any = (context.currentTime + ((tone.offsetMs / 1000)))
    let durationSeconds: Any = Math.max((tone.durationMs / 1000), 0.008)
    let attackSeconds: Any = Math.min((durationSeconds * 0.18), 0.01)
    let releaseSeconds: Any = Math.min((durationSeconds * 0.45), 0.06)
    let stopAt: Any = ((startAt + durationSeconds) + releaseSeconds)
    let oscillator: Any = context.createOscillator()
    oscillator.type_ = tone.waveform
    oscillator.frequency.value = tone.frequency
    oscillator.detune.value = tone.detuneCents
    let gainNode: Any = context.createGain()
    gainNode.gain.setValueAtTime(0.0001, startAt)
    gainNode.gain.linearRampToValueAtTime(Math.max((tone.gain * cueVolume), 0.0001), (startAt + attackSeconds))
    gainNode.gain.exponentialRampToValueAtTime(0.0001, stopAt)
    oscillator.connect(gainNode)
    connectOptionalStereoPan(context, gainNode, destinationNode, tone.pan)
    oscillator.start(startAt)
    oscillator.stop(stopAt)
    return stopAt

fn buildNoiseBuffer(context: AudioContext, durationSeconds: Float) -> AudioBuffer:
    let frameCount: Any = Math.max(Math.ceil((context.sampleRate * durationSeconds)), 1)
    let buffer: Any = context.createBuffer(1, frameCount, context.sampleRate)
    let channel: Any = buffer.getChannelData(0)
    let index: Any = 0
    while ((index < frameCount)):
        ()
        index = (index + 1)
    return buffer

fn scheduleNoiseLayer(context: AudioContext, destinationNode: AudioNode, noiseLayer: LoadedOverlaySoundNoiseLayer, cueVolume: Float) -> Float:
    let durationSeconds: Any = Math.max((noiseLayer.durationMs / 1000), 0.006)
    let startAt: Any = (context.currentTime + ((noiseLayer.offsetMs / 1000)))
    let stopAt: Any = (startAt + durationSeconds)
    let noiseSource: Any = context.createBufferSource()
    noiseSource.buffer = buildNoiseBuffer(context, durationSeconds)
    let pipeline: AudioNode = noiseSource
    if ((noiseLayer.highpassHz != none)):
        let highpass: Any = context.createBiquadFilter()
        highpass.type_ = "highpass"
        highpass.frequency.value = noiseLayer.highpassHz
        pipeline.connect(highpass)
        pipeline = highpass
    if ((noiseLayer.lowpassHz != none)):
        let lowpass: Any = context.createBiquadFilter()
        lowpass.type_ = "lowpass"
        lowpass.frequency.value = noiseLayer.lowpassHz
        pipeline.connect(lowpass)
        pipeline = lowpass
    let gainNode: Any = context.createGain()
    gainNode.gain.setValueAtTime(Math.max((noiseLayer.gain * cueVolume), 0.0001), startAt)
    gainNode.gain.exponentialRampToValueAtTime(0.0001, stopAt)
    pipeline.connect(gainNode)
    connectOptionalStereoPan(context, gainNode, destinationNode, noiseLayer.pan)
    noiseSource.start(startAt)
    noiseSource.stop(stopAt)
    return stopAt

fn loadSampleBuffer(context: AudioContext, cue: LoadedOverlaySoundSampleCue) -> Any:
    let cacheKey: Any = cue.sourceUrl
    if (sampleBufferCache.has(cacheKey)):
        return (sampleBufferCache.get(cacheKey) or none)
    let samplePromise: Any = fetch(cue.sourceUrl).then(none).catch_(none)
    sampleBufferCache.set(cacheKey, samplePromise)
    return samplePromise

fn playSampleCue(context: AudioContext, cue: LoadedOverlaySoundSampleCue, masterGainNode: GainNode, cueVolume: Float) -> Any:
    let buffer: Any = (await loadSampleBuffer(context, cue))
    if ((!buffer)):
        return none
    let source: Any = context.createBufferSource()
    source.buffer = buffer
    source.playbackRate.value = cue.playbackRate
    let gainNode: Any = context.createGain()
    gainNode.gain.value = Math.max((cue.volume * cueVolume), 0.0001)
    source.connect(gainNode)
    gainNode.connect(masterGainNode)
    source.start()

fn playSynthCue(context: AudioContext, cue: LoadedOverlaySoundSynthCue, masterGainNode: GainNode, cueVolume: Float) -> ():
    let lastEndAt: Any = Math.max(0, none, none)
    if ((lastEndAt > context.currentTime)):
        let cleanupDelayMs: Any = (Math.max((((lastEndAt - context.currentTime)) * 1000), 0) + 40)
        window.setTimeout(none, cleanupDelayMs)
    else:
        masterGainNode.disconnect()

fn shouldPlayCue(effectId: OverlaySoundEffectId, cue: LoadedOverlaySoundCue, options: PlaySoundEffectOptions) -> Any:
    if ((!options.ignoreEnabledFlags)):
        if (((!runtimeConfig.enabled) or (!runtimeConfig.pack))):
            return false
        let groupId: Any = getOverlaySoundEffectDefinition(effectId).groupId
        if ((groupId and (!runtimeConfig.groupEnabled[groupId]))):
            return false
    if (options.ignoreCooldown):
        return true
    let cooldownKey: Any = (runtimeConfig.pack.id or "none") + ":" + effectId
    let lastPlayedAt: Any = (cueLastPlayedAt.get(cooldownKey) or 0)
    let cooldownMs: Any = cue.cooldownMs
    if ((cooldownMs <= 0)):
        return true
    let now: Any = Date.now()
    if ((((now - lastPlayedAt)) < cooldownMs)):
        return false
    cueLastPlayedAt.set(cooldownKey, now)
    return true

fn configureSoundEffectsRuntime(config: Any) -> ():
    runtimeConfig = none

fn playSoundEffect(effectId: OverlaySoundEffectId, options: PlaySoundEffectOptions) -> Any:
    let cue: Any = runtimeConfig.pack.sounds[effectId]
    if (((!cue) or (!shouldPlayCue(effectId, cue, options)))):
        return false
    let context: Any = (await ensureAudioContext())
    if ((!context)):
        return false
    if ((context.state_ == "suspended")):
        (await context.resume().catch_(none))
    let totalVolume: Any = clampUnit(((runtimeConfig.volume * ((runtimeConfig.pack.masterVolume or 1))) * ((options.volumeMultiplier or 1))))
    if ((totalVolume <= 0)):
        return false
    let masterGainNode: Any = createMasterGainNode(context, totalVolume)
    if ((cue.kind == "sample")):
        (await playSampleCue(context, cue, masterGainNode, 1))
        window.setTimeout(none, 1500)
        return true
    playSynthCue(context, cue, masterGainNode, 1)
    return true

fn previewSoundEffect(effectId: OverlaySoundEffectId) -> impl Async_<Bool>:
    return playSoundEffect(effectId, none)

