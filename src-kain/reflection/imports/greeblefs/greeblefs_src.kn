    let options: Any = options
    let iconTheme: Any = getEffectiveIconTheme(options.iconTheme)
    if (entry.is_dir):
        return resolveExplorerPreviewFolderIconSrc(entry.path, false, options)
    return resolveFileIconSrc(entry.name, getExplorerEntryExtension(entry), iconTheme)

fn buildArchivePreviewEntryMetadata(paths: Any) -> [ExplorerArchivePreviewEntryMetadata]:
    let directoryHints: Any = ts_Set()
    for path in paths:
        let normalizedPath: Any = trimArchivePath(path)
        if ((!normalizedPath)):
            continue
        let segments: Any = normalizedPath.split(none).filter(ts_Boolean)
        let index: Any = 1
        while ((index < segments.length)):
            directoryHints.add(segments.slice(0, index).join("/"))
            index = (index + 1)
    return paths.map(none).filter(none)

fn resolveArchivePreviewEntryIconSrc(entry: ExplorerArchivePreviewEntryMetadata, options: ExplorerPreviewFolderIconConfig) -> Any:
    let options: Any = options
    let iconTheme: Any = getEffectiveIconTheme(options.iconTheme)
    if (entry.isDirectory):
        return resolveExplorerPreviewFolderIconSrc(entry.normalizedPath, false, options)
    return resolveFileIconSrc(entry.name, getArchiveEntryExtension(entry.name), iconTheme)

