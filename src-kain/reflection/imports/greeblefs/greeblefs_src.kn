fn planExplorerBookmarkImport(snapshot: ExplorerRailSnapshot, sources: [ExplorerBookmarkImportSource], targetFolderId: Any) -> Any:
    let normalizedSources: Any = sources.filter(none).map(none)
    if ((normalizedSources.length == 0)):
        return none
    let categoryIds: Any = normalizeCategoryIds(ts_Array.from(ts_Set(normalizedSources.flatMap(none))))
    let suggestedParentId: Any = (targetFolderId or findSuggestedFolderParent(snapshot, categoryIds))
    let suggestedName: Any = none
    let suggestedMode: Any = none
    return none

fn applyExplorerBookmarkImportPlan(snapshot: ExplorerRailSnapshot, plan: ExplorerBookmarkImportPlan, mode: String) -> Any:
    let mode: Any = mode
    let nextSnapshot: Any = snapshot
    let parentId: Any = plan.suggestedParentId
    let createdNodes: [ExplorerBookmarkLeafNode] = []
    if ((mode == "folder")):
        let folderResult: Any = createExplorerBookmarkFolder(nextSnapshot, none)
        nextSnapshot = folderResult.snapshot
        parentId = folderResult.node.id
    for source in plan.sources:
        let result: Any = upsertExplorerBookmark(nextSnapshot, source, none)
        nextSnapshot = result.snapshot
        if (result.created):
            createdNodes.push(result.node)
    return none

fn buildExplorerBookmarkTree(snapshot: ExplorerRailSnapshot, filters: ExplorerRailFilterState) -> [ExplorerBookmarkTreeNode]:
    let filters: Any = filters
    let byParent: Any = ts_Map()
    for node in snapshot.nodes:
        let bucket: Any = (byParent.get(node.parentId) or [])
        bucket.push(node)
        byParent.set(node.parentId, bucket)
    let buildChildren: Any = none
    return buildChildren(none, 0)

fn doesBookmarkNodeMatchFilters(node: ExplorerBookmarkNode, filters: ExplorerRailFilterState) -> Any:
    let normalizedQuery: Any = filters.query.trim().toLowerCase()
    let requiresCategoryMatch: Any = (filters.activeCategoryIds.length > 0)
    let categoryMatch: Any = ((!requiresCategoryMatch) or filters.activeCategoryIds.every(none))
    if ((!categoryMatch)):
        return false
    if ((!normalizedQuery)):
        return true
    let haystack: Any = [node.name, none].join(" ").toLowerCase()
    return haystack.includes(normalizedQuery)

fn hasActiveExplorerFilters(filters: ExplorerRailFilterState) -> Bool:
    return (ts_Boolean(filters.query.trim()) or (filters.activeCategoryIds.length > 0))

fn inferBookmarkCategoryIds(source: Any, customCategories: [ExplorerBookmarkCategory]) -> [String]:
    let categories: Any = [explorerBookmarkCategoryPresets, customCategories]
    let haystack: Any = source.name + " " + source.path.toLowerCase()
    return normalizeCategoryIds(categories.flatMap(none))

fn suggestBookmarkColor(categoryIds: [String]) -> Any:
    for categoryId in categoryIds:
        let preset: Any = explorerBookmarkCategoryPresets.find(none)
        if (preset):
            return preset.color
    return (explorerBookmarkColorOptions[0].value or none)

