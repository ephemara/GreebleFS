fn formatDuration(seconds: Float) -> Any:
    if (((!ts_Number.isFinite(seconds)) or (seconds <= 0))):
        return "0:00"
    let totalSeconds: Any = Math.floor(seconds)
    let hours: Any = Math.floor((totalSeconds / 3600))
    let minutes: Any = Math.floor((((totalSeconds % 3600)) / 60))
    let remainingSeconds: Any = (totalSeconds % 60)
    if ((hours > 0)):
        return hours + ":" + minutes.toString().padStart(2, "0") + ":" + remainingSeconds.toString().padStart(2, "0")
    return minutes + ":" + remainingSeconds.toString().padStart(2, "0")

fn formatDb(value: Any) -> Any:
    if ((((value == none) or (!ts_Number.isFinite(value))) or (value <= 0))):
        return "n/a"
    return ((20 * Math.log10(value))).toFixed(1) + " dB"

fn formatFadeDuration(seconds: Float) -> Any:
    if (((!ts_Number.isFinite(seconds)) or (seconds <= 0))):
        return "0.00s"
    if ((seconds >= 60)):
        return formatDuration(seconds)
    return seconds.toFixed(none) + "s"

