    else if ((category == "search")):
        ()
    else if ((category == "selection")):
        ()
    else if ((category == "creation")):
        ()
    else if ((category == "layout")):
        ()
    else if ((category == "actions")):
        ()
    else if ((category == "preview")):
        ()
    else if ((category == "workspace")):
        ()
    else if ((category == "rail")):
        ()
    else if ((category == "status")):
        ()
    else if ((category == "tasks")):
        ()
    else if ((category == "widgets")):
        ()
    else if ((category == "authored-actions")):
        ()
    else if ((category == "other")):
        return category
    else:
        return "widgets"

