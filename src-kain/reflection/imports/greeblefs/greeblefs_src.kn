    fn applyConstraints(_self: ResizableNodeView, width: Float, height: Float, preserveAspectRatio: Bool) -> Any:
        if ((!preserveAspectRatio)):
            let constrainedWidth: Any = Math.max(_self.minSize.width, width)
            let constrainedHeight: Any = Math.max(_self.minSize.height, height)
            if (_self.maxSize.width):
                constrainedWidth = Math.min(_self.maxSize.width, constrainedWidth)
            if (_self.maxSize.height):
                constrainedHeight = Math.min(_self.maxSize.height, constrainedHeight)
            return none
        let constrainedWidth: Any = width
        let constrainedHeight: Any = height
        if ((constrainedWidth < _self.minSize.width)):
            constrainedWidth = _self.minSize.width
            constrainedHeight = (constrainedWidth / _self.aspectRatio)
        if ((constrainedHeight < _self.minSize.height)):
            constrainedHeight = _self.minSize.height
            constrainedWidth = (constrainedHeight * _self.aspectRatio)
        if ((_self.maxSize.width and (constrainedWidth > _self.maxSize.width))):
            constrainedWidth = _self.maxSize.width
            constrainedHeight = (constrainedWidth / _self.aspectRatio)
        if ((_self.maxSize.height and (constrainedHeight > _self.maxSize.height))):
            constrainedHeight = _self.maxSize.height
            constrainedWidth = (constrainedHeight * _self.aspectRatio)
        return none

    fn applyAspectRatio(_self: ResizableNodeView, width: Float, height: Float, direction: ResizableNodeViewDirection) -> Any:
        let isHorizontal: Any = ((direction == "left") or (direction == "right"))
        let isVertical: Any = ((direction == "top") or (direction == "bottom"))
        if (isHorizontal):
            return none
        if (isVertical):
            return none
        return none


