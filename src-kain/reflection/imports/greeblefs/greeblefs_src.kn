const DIRECTORY_SNAPSHOT_MAGIC: Any = "GFLS"

const DIRECTORY_SNAPSHOT_VERSION: Any = 1

const DIRECTORY_SNAPSHOT_HEADER_BYTES: Any = 32

const DIRECTORY_SNAPSHOT_RECORD_STRIDE: Any = 64

