fn normalizeExplorerActionOutputTarget(target: ExplorerActionOutputTarget) -> Any:
    if ((target == "preview-terminal")):
        return "previewTerminal"
    else if ((target == "native-terminal")):
        return "nativeTerminal"
    else if ((target == "silent")):
        return "silent"
    else if ((target == "task-center")):
        ()
    else:
        return "taskCenter"

fn executeExplorerAction(request: ExplorerActionExecutionInput) -> impl Async_<ExplorerActionExecutionOutput>:
    return unwrapTauriResult((await commands.actionExecute(request)))

