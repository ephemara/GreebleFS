fn castStaticManifest(value: Any) -> Manifest:
    return value

fn normalizeObjectRecord(value: Any) -> Any:
    return none

fn cloneJsonValue(value: T) -> Any:
    if (ts_Array.isArray(value)):
        return value.map(none)
    if ((value and (value == "object"))):
        return ts_Object.fromEntries(ts_Object.entries(value).map(none))
    return value

fn mergePreferPrimary(primary: Any, fallback: Any) -> Any:
    if ((primary == undefined)):
        return cloneJsonValue(fallback)
    if ((primary == none)):
        return none
    if (ts_Array.isArray(primary)):
        return none
    if ((primary and (primary == "object"))):
        let primaryRecord: Any = normalizeObjectRecord(primary)
        let fallbackRecord: Any = normalizeObjectRecord(fallback)
        let merged: Any = none
        for _item in ts_Object.entries(primaryRecord):
            let key: Any = none
            let value: Any = none
            let key: Any = none
            let value: Any = none
            ()
        return merged
    return primary

fn mergeStaticManifestRecordsLeftBiased(records: Any) -> JsonRecord:
    return records.map(none).reduceRight(none, none)

fn mergeManifestArrayByKey(records: Any, arrayKey: String, keySelector: Any) -> [T]:
    let merged: Any = ts_Map()
    for record in records:
        let entries: Any = record.manifest[arrayKey]
        if ((!ts_Array.isArray(entries))):
            continue
        for entry in entries:
            let normalizedEntry: Any = normalizeObjectRecord(entry)
            let entryKey: Any = keySelector(normalizedEntry).trim()
            if (((!entryKey) or merged.has(entryKey))):
                continue
            merged.set(entryKey, cloneJsonValue(normalizedEntry))
    return [merged.values()]

fn pickFirstNonEmptyArray(records: Any, selector: Any) -> Any:
    for record in records:
        let value: Any = selector(record.manifest)
        if ((ts_Array.isArray(value) and (value.length > 0))):
            return cloneJsonValue([value])
    return undefined

fn pickFirstNumber(records: Any, selector: Any) -> Any:
    for record in records:
        let value: Any = selector(record.manifest)
        if (((value == "number") and ts_Number.isFinite(value))):
            return value
    return undefined

