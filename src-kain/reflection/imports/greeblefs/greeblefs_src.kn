fn getPdfWorkbenchToneColor(tone: PdfWorkbenchTone) -> Any:
    if ((tone == "accent")):
        return "var(--overlay-accent)"
    else if ((tone == "success")):
        return "var(--overlay-success)"
    else if ((tone == "warning")):
        return "var(--overlay-warning)"
    else if ((tone == "danger")):
        return "var(--overlay-danger)"
    else if ((tone == "default")):
        ()
    else:
        return "var(--overlay-text-primary)"

fn getPdfWorkbenchStatusPillStyle(tone: Any) -> Any:
    let toneColor: Any = getPdfWorkbenchToneColor(tone)
    return none

