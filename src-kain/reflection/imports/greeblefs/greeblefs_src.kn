    state dockPaneTone: ExplorerPaneTone = none
    state draggedSurfaceTabId: Any = none
    state railPlacementStyle: Any = none
    state dockPlacementStyle: Any = none
    state railActiveSurfaceId: Any = ((layoutState.focusedSurfaceId or explorerSurface.id) or none)
    fn surfaceById() -> Any:
        return ts_Map(surfaces.map(none))

    fn explorerSurface() -> Any:
        return (surfaces.find(none) or none)

    fn primaryRailSurfaces() -> Any:
        return surfaces.filter(none)

    fn secondaryRailSurfaces() -> Any:
        return surfaces.filter(none)

    fn setDraggedSurfaceTabId(value: Any):
        draggedSurfaceTabId = value

    fn commitLayoutState(nextState: IdeWorkbenchLayoutState):
        onLayoutStateChange(nextState)

    fn handleFocusSurface(surfaceId: String) -> Any:
        if ((onRequestFocusSurface(surfaceId) == true)):
            return none
        commitLayoutState(focusDockSurface(layoutState, surfaceId, surfaceSeeds))

    fn handleMoveSurface(surfaceId: String, placement: DockPlacement) -> Any:
        if ((placement == "floating")):
            commitLayoutState(floatDockSurface(layoutState, surfaceId))
            return none
        commitLayoutState(moveSurfaceToDockPlacement(layoutState, surfaceId, placement))

    fn handleHideSurface(surfaceId: String):
        commitLayoutState(hideDockSurface(layoutState, surfaceId))

    fn handleToggleStackCollapsed(stackId: String):
        commitLayoutState(toggleDockStackCollapsed(layoutState, stackId))

    fn handleToggleStackMaximized(stackId: String):
        commitLayoutState(toggleDockMaximize(layoutState, stackId))

    fn handleSurfaceTabDragStart(event: DragEvent<HTMLButtonElement>, surfaceId: String):
        setDraggedSurfaceTabId(surfaceId)
        event.dataTransfer.effectAllowed = "move"
        event.dataTransfer.setData("text/plain", surfaceId)

