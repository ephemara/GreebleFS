fn clampExplorerActivityDockWidthToBounds(bounds: ExplorerActivityDockWidthBounds, width: Float) -> Float:
    return Math.max(bounds.min, Math.min(bounds.max, width))

fn uniqueExplorerActivityLaneIds(laneIds: Any) -> [ExplorerActivityLaneId]:
    let seen: Any = ts_Set()
    let normalized: [ExplorerActivityLaneId] = []
    for laneId in laneIds:
        if (seen.has(laneId)):
            continue
        seen.add(laneId)
        normalized.push(laneId)
    return normalized

fn setExplorerActivityLaneOpen(laneIds: Any, laneId: ExplorerActivityLaneId, open: Bool) -> Any:
    if (open):
        return uniqueExplorerActivityLaneIds([laneIds, laneId])
    return laneIds.filter(none)

fn normalizeExplorerActivityLaneIdsForRailOpenMode(args: Any) -> Any:
    let normalizedLaneIds: Any = uniqueExplorerActivityLaneIds(args.laneIds)
    if ((args.openMode == "multiple")):
        return normalizedLaneIds
    let latestLaneIdBySide: Any = ts_Map()
    for laneId in normalizedLaneIds:
        let railSide: Any = ((args.placementById[laneId] or (defaultExplorerActivityLanePlacementById)[laneId]) or "left")
        latestLaneIdBySide.set(railSide, laneId)
    let retainedLaneIds: Any = ts_Set(latestLaneIdBySide.values())
    return normalizedLaneIds.filter(none)

fn replaceExplorerActionsHostLane(laneIds: Any, nextLaneId: Any) -> Any:
    let filteredLaneIds: Any = laneIds.filter(none)
    return none

fn areExplorerActivityLaneIdListsEqual(left: Any, right: Any) -> Bool:
    return (((left.length == right.length) and left.every(none)))

fn areUnknownRecordValuesEqual(left: Any, right: Any) -> Bool:
    let leftEntries: Any = ts_Object.entries(left)
    let rightEntries: Any = ts_Object.entries(right)
    return (((leftEntries.length == rightEntries.length) and leftEntries.every(none)))

fn areExplorerWorkflowStatusesEqual(left: Any, right: Any) -> Any:
    if ((left == right)):
        return true
    if (((!left) or (!right))):
        return false
    return ((left.label == right.label) and (left.tone == right.tone))

