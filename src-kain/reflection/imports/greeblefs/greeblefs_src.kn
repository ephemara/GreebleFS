const DEFAULT_EXPLORER_PREVIEW_CACHE_BUDGET_BYTES: Any = ((500 * 1024) * 1024)

type ExplorerPreviewCacheEntry = Any

struct ExplorerPreviewCache:
    entries: Any = ts_Map()
    currentBytes: Any = 0

impl ExplorerPreviewCache:
    fn new_(_self: ExplorerPreviewCache) -> ExplorerPreviewCache:
        ()

    fn read(_self: ExplorerPreviewCache, key: String) -> Any:
        let cachedEntry: Any = _self.entries.get(key)
        if ((!cachedEntry)):
            return none
        _self.entries.delete_(key)
        cachedEntry.lastAccessedAt = Date.now()
        _self.entries.set(key, cachedEntry)
        return cachedEntry.value

    fn write(_self: ExplorerPreviewCache, args: Any) -> Any:
        let normalizedBytes: Any = Math.max(0, Math.floor(args.bytes))
        let existingEntry: Any = _self.entries.get(args.key)
        if (existingEntry):
            _self.entries.delete_(args.key)
            _self.currentBytes = (_self.currentBytes - existingEntry.bytes)
        if ((normalizedBytes > _self.budgetBytes)):
            return []
        let evictedKeys: [String] = []
        while (((_self.entries.size > 0) and ((_self.currentBytes + normalizedBytes) > _self.budgetBytes))):
            let oldestKey: Any = _self.entries.keys().next().value
            if ((!oldestKey)):
                break
            _self.delete_(oldestKey)
            evictedKeys.push(oldestKey)
        _self.entries.set(args.key, none)
        _self.currentBytes = (_self.currentBytes + normalizedBytes)
        return evictedKeys

    fn delete_(_self: ExplorerPreviewCache, key: String) -> Any:
        let existingEntry: Any = _self.entries.get(key)
        if ((!existingEntry)):
            return none
        _self.entries.delete_(key)
        _self.currentBytes = (_self.currentBytes - existingEntry.bytes)

    fn invalidate(_self: ExplorerPreviewCache, pathPrefix: String) -> Any:
        if ((!pathPrefix)):
            _self.clear()
            return none
        for _item in _self.entries:
            let key: Any = none
            let entry: Any = none
            let key: Any = none
            let entry: Any = none
            if (matchesExplorerPreviewPathPrefix(entry.path, pathPrefix)):
                _self.delete_(key)

    fn clear(_self: ExplorerPreviewCache) -> ():
        _self.entries.clear()
        _self.currentBytes = 0

    fn getStats(_self: ExplorerPreviewCache) -> Any:
        return none


const sharedExplorerPreviewCache: Any = ExplorerPreviewCache()

fn readCachedExplorerPreview(key: String) -> Any:
    return ((sharedExplorerPreviewCache.read(key)) or none)

fn storeCachedExplorerPreview(args: Any) -> [String]:
    return sharedExplorerPreviewCache.write(args)

fn invalidateExplorerPreviewCache(pathPrefix: String) -> ():
    sharedExplorerPreviewCache.invalidate(pathPrefix)

fn estimateStringPreviewCacheBytes(value: String) -> Float:
    return TextEncoder().encode(value).length

fn matchesExplorerPreviewPathPrefix(path: String, pathPrefix: String) -> Any:
    if ((path == pathPrefix)):
        return true
    if ((!path.startsWith(pathPrefix))):
        return false
    let boundary: Any = path.charAt(pathPrefix.length)
    return (((boundary == "") or (boundary == "/")) or (boundary == none))

