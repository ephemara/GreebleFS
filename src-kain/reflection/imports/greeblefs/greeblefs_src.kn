fn findNearestExplorerViewDensityStop(view: Any, density: Float) -> Any:
    let stops: Any = (view.density.stops or [])
    if ((stops.length == 0)):
        return none
    let closest: Any = stops[0]
    let closestDistance: Any = Math.abs((density - closest.value))
    for stop in stops.slice(1):
        let distance: Any = Math.abs((density - stop.value))
        if ((distance < closestDistance)):
            closest = stop
            closestDistance = distance
    return closest

fn resolveStableExplorerChromeLabelWidthCh(labels: Any, options: Any) -> Float:
    let options: Any = options
    let minimumCh: Any = (options.minimumCh or 4)
    let maximumCh: Any = (options.maximumCh or 14)
    let longestLabelLength: Any = labels.reduce(none, 0)
    return Math.max(minimumCh, Math.min(maximumCh, longestLabelLength))

