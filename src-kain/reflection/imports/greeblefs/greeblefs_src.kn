        if ((hoveredEntryIndex >= 0)):
            pushCandidate(hoveredEntryIndex, "hover", 0)
    let index: Any = startIndex
    while ((index < endIndex)):
        pushCandidate(index, "visible", 0)
        index = (index + 1)
    let forwardEndIndex: Any = Math.min(totalEntries, (endIndex + forwardPrefetchCount))
    let index: Any = endIndex
    while ((index < forwardEndIndex)):
        pushCandidate(index, "forward-prefetch", ((index - endIndex) + 1))
        index = (index + 1)
    let backwardStartIndex: Any = Math.max(0, (startIndex - backwardPrefetchCount))
    let index: Any = (startIndex - 1)
