    return Intl.NumberFormat(undefined, none).format(value)

fn shouldRunGlobalSearchQuery(query: String) -> Bool:
    return (query.trim().length >= globalSearchPaletteConfig.minimumQueryLength)

fn createDefaultGlobalSearchQueryOptions(limit: Float) -> Any:
    let limit: Any = limit
    return none

fn createDefaultGlobalSearchScanSettings(driveRoots: [String]) -> Any:
    return none

fn normalizeGlobalSearchPriorityPaths(paths: [String]) -> [String]:
    let seen: Any = ts_Set()
    let normalizedPaths: [String] = []
    for rawPath in paths:
        let path: Any = rawPath.trim()
        if (((!path) or seen.has(path))):
            continue
        seen.add(path)
        normalizedPaths.push(path)
    return normalizedPaths

fn describeGlobalSearchPaletteStatus(args: Any) -> Any:
    let trimmedQuery: Any = args.query.trim()
    if (args.lastError):
        return none
    if ((!args.status)):
        return none
    if ((args.isSearching and shouldRunGlobalSearchQuery(trimmedQuery))):
        return none
    if ((args.status.isScanInProgress or args.status.isCommitting)):
        let driveProgress: Any = none
        return none
    if (((!args.status.isIndexValid) or (args.status.indexedItemCount == 0))):
        return none
    return none

