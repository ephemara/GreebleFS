fn getMockEntryThumbnailKind(path: Any) -> Any:
    let extension: Any = path.split(".").pop().toLowerCase()
    if ((extension == "png")):
        return "image"
    else if ((extension == "mp3")):
        return "audio"
    else if ((extension == "mp4")):
        return "video"
    else if ((extension == "wgsl")):
        ()
    else if ((extension == "hlsl")):
        ()
    else if ((extension == "spv")):
        return "shader"
    else:
        return "code"

