fn calculateFieldInfluence(element: HTMLElement, type_: FieldType, center: (Float, Float), radius: Float, direction: String, falloff: FalloffType, strength: Float, invert: Bool) -> Float:
    let rect: Any = element.getBoundingClientRect()
    let elemX: Any = (rect.left + (rect.width / 2))
    let elemY: Any = (rect.top + (rect.height / 2))
    let distance: Any = 0
    let influence: Any = 0
    if ((type_ == "spherical")):
        let dx: Any = (elemX - center[0])
        let dy: Any = (elemY - center[1])
        distance = Math.sqrt(((dx * dx) + (dy * dy)))
        break
    else if ((type_ == "linear")):
        if ((direction == "horizontal")):
            distance = Math.abs((elemX - center[0]))
        else:
            distance = Math.abs((elemY - center[1]))
        break
    else if ((type_ == "radial")):
        let dx: Any = (elemX - center[0])
        let dy: Any = (elemY - center[1])
        let angle: Any = Math.atan2(dy, dx)
        distance = (((Math.abs(angle) / Math.PI)) * radius)
        break
    else if ((type_ == "noise")):
        let hash: Any = none
        let noise: Any = hash(((elemX * 0.01) + (elemY * 0.01)))
        distance = (noise * radius)
        break
    else if ((type_ == "grid")):
        let gridSize: Any = (radius / 5)
        let gridX: Any = Math.floor((elemX / gridSize))
        let gridY: Any = Math.floor((elemY / gridSize))
        let isEven: Any = ((((gridX + gridY)) % 2) == 0)
        distance = none
        break
    if ((distance < radius)):
        let t: Any = (distance / radius)
        if ((falloff == "linear")):
            influence = (1 - t)
        else if ((falloff == "smooth")):
            influence = (1 - ((t * t) * ((3 - (2 * t)))))
        else if ((falloff == "inverse")):
            influence = (1 / ((1 + (t * 5))))
        else if ((falloff == "constant")):
            influence = 1
    influence = (influence * strength)
    if (invert):
        influence = (1 - influence)
    return Math.max(0, Math.min(1, influence))

