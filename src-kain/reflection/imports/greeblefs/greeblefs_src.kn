const MIN_FLOATING_WIDTH: Any = 320

const MIN_FLOATING_HEIGHT: Any = 220

const MIN_SPLIT_SIZE: Any = 0.12

const MAX_SPLIT_SIZE: Any = 6

const dockPlacementToStackId: Option<Any> = none

fn clampNumber(value: Float, min: Float, max: Float) -> Float:
    return Math.min(Math.max(value, min), max)

fn isExplorerCoreSurface(surfaceId: String) -> Bool:
    return (surfaceId == EXPLORER_CORE_SURFACE_ID)

fn normalizeUtilityDockPlacement(placement: DockStackPlacement) -> Any:
    if (((placement == "center") or (placement == "left-sidebar"))):
        return "right-sidebar"
    return placement

fn normalizeDockStackPlacement(value: Any) -> Any:
    return none

fn uniqueSurfaceIds(ids: [String]) -> [String]:
    let seen: Any = ts_Set()
    return ids.filter(none)

fn normalizeSurfaceTabs(value: Any, availableSurfaceIds: Set<String>) -> Any:
    if ((!ts_Array.isArray(value))):
        return []
    return uniqueSurfaceIds(value.filter(none))

fn normalizeSplitSizes(value: Any, expectedLength: Float, fallback: [Float]) -> Any:
    if (((!ts_Array.isArray(value)) or (value.length != expectedLength))):
        return [fallback]
    let normalized: Any = value.map(none)
    if (normalized.some(none)):
        return [fallback]
    return normalized

fn createDockStackNode(id: String, placement: DockStackPlacement, tabs: [String], collapsed: Any) -> Any:
    let collapsed: Any = collapsed
    return none

fn withStackActiveSurface(stack: DockStackNode, requestedSurfaceId: Any) -> Any:
    let nextActiveSurfaceId: Any = none
    return none

fn createDefaultRootDockNode(seeds: [WorkbenchSurfaceLayoutSeed]) -> Any:
    let sortedSeeds: Any = [seeds].sort(none)
    let visibleSeeds: Any = sortedSeeds.filter(none)
    let centerTabs: Any = visibleSeeds.filter(none).map(none)
    let rightSeeds: Any = visibleSeeds.filter(none).filter(none).sort(none)
    let bottomSeeds: Any = visibleSeeds.filter(none).filter(none).sort(none)
    let rightTabs: Any = rightSeeds.map(none)
    let bottomTabs: Any = bottomSeeds.map(none)
    let rightCollapsed: Any = none
    let bottomCollapsed: Any = none
    return none

fn createDefaultSurfaceStateById(seeds: [WorkbenchSurfaceLayoutSeed]) -> Any:
    return ts_Object.fromEntries(seeds.map(none))

fn collectSurfaceIdsFromDockNode(node: DockNode) -> Any:
    if ((node.type_ == "stack")):
        return [node.tabs]
    return node.children.flatMap(collectSurfaceIdsFromDockNode)

fn collectSurfaceIdsFromFloatingNodes(nodes: [FloatingDockNode]) -> [String]:
    return nodes.flatMap(none)

fn collectExternalizedSurfaceIds(layoutState: IdeWorkbenchLayoutState) -> [String]:
    return ts_Object.entries(layoutState.surfaceStateById).filter(none).map(none)

fn isDockSurfaceExternalized(layoutState: IdeWorkbenchLayoutState, surfaceId: String) -> Bool:
    return ts_Boolean(layoutState.surfaceStateById[surfaceId].externalizedWindowId)

fn getExternalizedSurfaceWindowId(layoutState: IdeWorkbenchLayoutState, surfaceId: String) -> Any:
    return (layoutState.surfaceStateById[surfaceId].externalizedWindowId or none)

fn updateDockNode(node: DockNode, updater: Any) -> Any:
    let updatedNode: Any = updater(node)
    if ((updatedNode.type_ != "split")):
        return updatedNode
    return none

fn updateDockStackById(node: DockNode, stackId: String, updater: Any) -> DockNode:
    return updateDockNode(node, none)

fn updateDockSplitById(node: DockNode, splitId: String, updater: Any) -> DockNode:
    return updateDockNode(node, none)

fn findDockStackById(node: DockNode, stackId: String) -> Any:
    if ((node.type_ == "stack")):
        return none
    for child in node.children:
        let match_: Any = findDockStackById(child, stackId)
        if (match_):
            return match_
    return none

fn collectDockStacks(node: DockNode) -> Any:
    if ((node.type_ == "stack")):
        return [node]
    return node.children.flatMap(collectDockStacks)

fn getDockStackPrimarySurfaceId(stack: Any) -> Any:
    if ((!stack)):
        return none
    if ((stack.activeSurfaceId and stack.tabs.includes(stack.activeSurfaceId))):
        return stack.activeSurfaceId
    return (stack.tabs[0] or none)

fn getFloatingDockPrimarySurfaceId(node: Any) -> Any:
    if ((!node)):
        return none
    if ((node.activeSurfaceId and node.tabs.includes(node.activeSurfaceId))):
        return node.activeSurfaceId
    return (node.tabs[0] or none)

fn resolvePreferredDockSurfaceId(rootDockNode: DockNode, floatingNodes: [FloatingDockNode]) -> Any:
    let centerSurfaceId: Any = getDockStackPrimarySurfaceId(findDockStackById(rootDockNode, IDE_WORKBENCH_STACK_IDS.center))
    if (centerSurfaceId):
        return centerSurfaceId
    let expandedDockSurfaceId: Any = collectDockStacks(rootDockNode).find(none)
    if (expandedDockSurfaceId):
        return getDockStackPrimarySurfaceId(expandedDockSurfaceId)
    let floatingSurfaceId: Any = floatingNodes.map(getFloatingDockPrimarySurfaceId).find(none)
    if (floatingSurfaceId):
        return floatingSurfaceId
    return ((collectSurfaceIdsFromDockNode(rootDockNode)[0] or collectSurfaceIdsFromFloatingNodes(floatingNodes)[0]) or none)

fn findDockStackContainingSurface(node: DockNode, surfaceId: String) -> Any:
    if ((node.type_ == "stack")):
        return none
    for child in node.children:
        let match_: Any = findDockStackContainingSurface(child, surfaceId)
        if (match_):
            return match_
    return none

fn removeSurfaceFromDockNode(node: DockNode, surfaceId: String) -> DockNode:
    return updateDockNode(node, none)

fn appendSurfaceToDockStack(node: DockNode, stackId: String, surfaceId: String, activate: Any) -> DockNode:
    let activate: Any = activate
    return updateDockStackById(node, stackId, none)

fn normalizeDockNodeAfterMutation(node: DockNode) -> DockNode:
    return updateDockNode(node, none)

fn synchronizeBottomDockState(rootDockNode: DockNode, bottomDockState: IdeWorkbenchBottomDockState) -> Any:
    let bottomStack: Any = findDockStackById(rootDockNode, IDE_WORKBENCH_STACK_IDS.bottomPanel)
    if (((!bottomStack) or (bottomStack.tabs.length == 0))):
        return none
    return none

fn normalizeFloatingNode(value: Any, availableSurfaceIds: Set<String>, usedSurfaceIds: Set<String>, index: Float) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    let source: Any = value
    let tabs: Any = normalizeSurfaceTabs(source.tabs, availableSurfaceIds).filter(none)
    if ((tabs.length == 0)):
        return none
    let activeSurfaceId: Any = none
    return none

fn buildNormalizedRootDockNode(inputNode: Any, seeds: [WorkbenchSurfaceLayoutSeed], surfaceStateById: Any) -> DockNode:
    let availableSurfaceIds: Any = ts_Set(seeds.map(none))
    let defaultRoot: Any = createDefaultRootDockNode(seeds)
    let sourceNode: Any = none
    let splitOverridesById: Any = ts_Map()
    let stackOverridesById: Any = ts_Map()
    let walk: Any = none
    walk(sourceNode)
    let withheldSurfaceIds: Any = ts_Set(ts_Object.entries(surfaceStateById).filter(none).map(none))
    let placedSurfaceIds: Any = ts_Set()
    let nextRoot: Any = updateDockNode(defaultRoot, none)
    for seed in seeds:
        if (((surfaceStateById[seed.id].hidden or surfaceStateById[seed.id].externalizedWindowId) or placedSurfaceIds.has(seed.id))):
            continue
        nextRoot = appendSurfaceToDockStack(nextRoot, none, seed.id, isExplorerCoreSurface(seed.id))
        placedSurfaceIds.add(seed.id)
    return nextRoot

fn normalizeSurfaceStateById(value: Any, seeds: [WorkbenchSurfaceLayoutSeed]) -> Any:
    let defaultSurfaceStateById: Any = createDefaultSurfaceStateById(seeds)
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return defaultSurfaceStateById
    let source: Any = value
    return ts_Object.fromEntries(seeds.map(none))

fn createDefaultIdeWorkbenchLayoutState(seeds: [WorkbenchSurfaceLayoutSeed]) -> Any:
    let surfaceStateById: Any = createDefaultSurfaceStateById(seeds)
    let rootDockNode: Any = createDefaultRootDockNode(seeds)
    let floatingNodes: [FloatingDockNode] = []
    let focusedSurfaceId: Any = resolvePreferredDockSurfaceId(rootDockNode, floatingNodes)
    return none

fn normalizeIdeWorkbenchLayoutState(value: Any, seeds: [WorkbenchSurfaceLayoutSeed]) -> Any:
    let defaultState: Any = createDefaultIdeWorkbenchLayoutState(seeds)
    let source: Any = none
    let sourceVersion: Any = none
    let shouldResetLegacyWorkbenchLayout: Any = (sourceVersion != CURRENT_IDE_WORKBENCH_LAYOUT_STATE_VERSION)
    let surfaceStateById: Any = none
    let rootDockNode: Any = none
    let availableSurfaceIds: Any = ts_Set(seeds.map(none))
    let usedSurfaceIds: Any = ts_Set(collectSurfaceIdsFromDockNode(rootDockNode))
    let floatingNodes: Any = none
    let placedSurfaceIds: Any = ts_Set([collectSurfaceIdsFromDockNode(rootDockNode), collectSurfaceIdsFromFloatingNodes(floatingNodes)])
    let focusableSurfaceIds: Any = ts_Set([placedSurfaceIds, ts_Object.entries(surfaceStateById).filter(none).map(none)])
    let focusedSurfaceId: Any = none
    let legacyRailStateSource: Any = (source).railState
    let railStateSource: Any = none
    let activityRailState: Option<Any> = none
    let sourcesRailSource: Any = none
    let sourcesRailState: Option<Any> = none
    let inspectorRailSource: Any = none
    let inspectorRailState: Option<Any> = none
    let bottomDockSource: Any = none
    let bottomDockState: Option<Any> = none
    let nextMaximizedNodeId: Any = none
    let dockIds: Any = ts_Set([IDE_WORKBENCH_STACK_IDS.center, IDE_WORKBENCH_STACK_IDS.rightSidebar, IDE_WORKBENCH_STACK_IDS.bottomPanel, floatingNodes.map(none)])
    return none

fn areIdeWorkbenchLayoutStatesEqual(left: IdeWorkbenchLayoutState, right: IdeWorkbenchLayoutState) -> Bool:
    return (JSON.stringify(left) == JSON.stringify(right))

fn resolvePrimaryIdeWorkbenchSurfaceId(layoutState: Any) -> Any:
    return resolvePreferredDockSurfaceId(layoutState.rootDockNode, layoutState.floatingNodes)

fn getStackIdForDockPlacement(placement: DockStackPlacement) -> String:
    return dockPlacementToStackId[placement]

fn findDockPlacementForSurface(layoutState: IdeWorkbenchLayoutState, surfaceId: String) -> Any:
    let stack: Any = findDockStackContainingSurface(layoutState.rootDockNode, surfaceId)
    if (stack):
        return stack.placement
    return none

fn ensureSurfaceVisibleState(layoutState: IdeWorkbenchLayoutState, surfaceId: String) -> Any:
    let currentSurfaceState: Any = layoutState.surfaceStateById[surfaceId]
    if ((!currentSurfaceState.hidden)):
        return layoutState
    return none

fn getRestorePlacementForSurface(layoutState: IdeWorkbenchLayoutState, surfaceId: String, currentPlacement: Any) -> Any:
    if ((currentPlacement and (currentPlacement != "floating"))):
        return currentPlacement
    return (layoutState.surfaceStateById[surfaceId].externalizedRestorePlacement or "right-sidebar")

fn clearExternalizedSurfaceState(hidden: Bool) -> Any:
    return none

fn externalizeDockSurface(layoutState: IdeWorkbenchLayoutState, surfaceId: String, windowId: String, restorePlacement: Any) -> Any:
    let restorePlacement: Any = restorePlacement
    if (isExplorerCoreSurface(surfaceId)):
        return layoutState
    let trimmedWindowId: Any = windowId.trim()
    if ((!trimmedWindowId)):
        return layoutState
    let currentPlacement: Any = findDockPlacementForSurface(layoutState, surfaceId)
    let nextRootDockNode: Any = normalizeDockNodeAfterMutation(removeSurfaceFromDockNode(layoutState.rootDockNode, surfaceId))
    let nextFloatingNodes: Any = updateFloatingNodesForSurface(layoutState.floatingNodes, surfaceId, none)
    let nextRestorePlacement: Any = (restorePlacement or getRestorePlacementForSurface(layoutState, surfaceId, currentPlacement))
    return none

fn clearExternalizedDockSurface(layoutState: IdeWorkbenchLayoutState, surfaceId: String, options: Any) -> Any:
    let hidden: Any = (options.hidden == true)
    let nextRootDockNode: Any = normalizeDockNodeAfterMutation(removeSurfaceFromDockNode(layoutState.rootDockNode, surfaceId))
    let nextFloatingNodes: Any = updateFloatingNodesForSurface(layoutState.floatingNodes, surfaceId, none)
    return none

fn restoreExternalizedDockSurface(layoutState: IdeWorkbenchLayoutState, surfaceId: String, seeds: [WorkbenchSurfaceLayoutSeed]) -> IdeWorkbenchLayoutState:
    let surfaceState: Any = layoutState.surfaceStateById[surfaceId]
    let seed: Any = seeds.find(none)
    let restorePlacement: Any = ((surfaceState.externalizedRestorePlacement or seed.defaultDockPlacement) or "right-sidebar")
    return moveSurfaceToDockPlacement(clearExternalizedDockSurface(layoutState, surfaceId, none), surfaceId, restorePlacement)

fn updateFloatingNodesForSurface(floatingNodes: [FloatingDockNode], surfaceId: String, updater: Any) -> [FloatingDockNode]:
    return floatingNodes.flatMap(none)

fn reorderSurfaceIds(ids: [String], draggedSurfaceId: String, targetSurfaceId: String) -> Any:
    if ((draggedSurfaceId == targetSurfaceId)):
        return ids
    let nextIds: Any = [ids]
    let draggedIndex: Any = nextIds.indexOf(draggedSurfaceId)
    let targetIndex: Any = nextIds.indexOf(targetSurfaceId)
    if (((draggedIndex < 0) or (targetIndex < 0))):
        return ids
    let _: Any = nextIds.splice(draggedIndex, 1)
    let draggedId: Any = none
    nextIds.splice(targetIndex, 0, draggedId)
    return nextIds

fn reorderDockSurfaceTabs(layoutState: IdeWorkbenchLayoutState, draggedSurfaceId: String, targetSurfaceId: String) -> Any:
    if ((draggedSurfaceId == targetSurfaceId)):
        return layoutState
    let reordered: Any = false
    let nextRootDockNode: Any = updateDockNode(layoutState.rootDockNode, none)
    let nextFloatingNodes: Any = layoutState.floatingNodes.map(none)
    if ((!reordered)):
        return layoutState
    return none

fn moveSurfaceToDockPlacement(layoutState: IdeWorkbenchLayoutState, surfaceId: String, placement: DockStackPlacement) -> Any:
    if (isExplorerCoreSurface(surfaceId)):
        return none
    let normalizedPlacement: Any = normalizeUtilityDockPlacement(placement)
    let withoutFloatingSurface: Any = updateFloatingNodesForSurface(layoutState.floatingNodes, surfaceId, none)
    let nextRoot: Any = normalizeDockNodeAfterMutation(appendSurfaceToDockStack(removeSurfaceFromDockNode(layoutState.rootDockNode, surfaceId), dockPlacementToStackId[normalizedPlacement], surfaceId, true))
    let nextBottomDockState: Any = synchronizeBottomDockState(nextRoot, none)
    return none

fn focusDockSurface(layoutState: IdeWorkbenchLayoutState, surfaceId: String, seeds: [WorkbenchSurfaceLayoutSeed]) -> Any:
    if (layoutState.surfaceStateById[surfaceId].externalizedWindowId):
        return none
    let currentPlacement: Any = findDockPlacementForSurface(layoutState, surfaceId)
    if ((currentPlacement == "floating")):
        return none
    if (currentPlacement):
        let stackId: Any = getStackIdForDockPlacement(currentPlacement)
        return none
    let seed: Any = seeds.find(none)
    return none

fn hideDockSurface(layoutState: IdeWorkbenchLayoutState, surfaceId: String) -> Any:
    if (isExplorerCoreSurface(surfaceId)):
        return layoutState
    let nextRoot: Any = normalizeDockNodeAfterMutation(removeSurfaceFromDockNode(layoutState.rootDockNode, surfaceId))
    let nextFloatingNodes: Any = updateFloatingNodesForSurface(layoutState.floatingNodes, surfaceId, none)
    return none

fn floatDockSurface(layoutState: IdeWorkbenchLayoutState, surfaceId: String) -> Any:
    if (isExplorerCoreSurface(surfaceId)):
        return layoutState
    let existingNode: Any = layoutState.floatingNodes.find(none)
    if (existingNode):
        return none
    let nextFloatingId: Any = "ide:floating:" + Date.now() + ":" + surfaceId
    let nextFloatingNodes: Any = [updateFloatingNodesForSurface(layoutState.floatingNodes, surfaceId, none), none]
    let nextRootDockNode: Any = normalizeDockNodeAfterMutation(removeSurfaceFromDockNode(layoutState.rootDockNode, surfaceId))
    return none

fn updateDockStackCollapsed(layoutState: IdeWorkbenchLayoutState, stackId: String, collapsed: Bool) -> Any:
    let nextRootDockNode: Any = normalizeDockNodeAfterMutation(updateDockStackById(layoutState.rootDockNode, stackId, none))
    return none

fn toggleDockStackCollapsed(layoutState: IdeWorkbenchLayoutState, stackId: String) -> Any:
    let targetStack: Any = findDockStackById(layoutState.rootDockNode, stackId)
    if ((!targetStack)):
        return layoutState
    return updateDockStackCollapsed(layoutState, stackId, (!targetStack.collapsed))

fn updateDockSplitSizes(layoutState: IdeWorkbenchLayoutState, splitId: String, sizes: [Float]) -> Any:
    return none

fn toggleDockMaximize(layoutState: IdeWorkbenchLayoutState, nodeId: String) -> Any:
    return none

fn updateFloatingDockNodeBounds(layoutState: IdeWorkbenchLayoutState, floatingNodeId: String, bounds: Any) -> Any:
    return none

fn closeFloatingDockNode(layoutState: IdeWorkbenchLayoutState, floatingNodeId: String) -> Any:
    let floatingNode: Any = layoutState.floatingNodes.find(none)
    if ((!floatingNode)):
        return layoutState
    let nextState: Any = none
    for surfaceId in floatingNode.tabs:
        nextState = hideDockSurface(nextState, surfaceId)
    return nextState

fn updateIdeRailState(layoutState: IdeWorkbenchLayoutState, updates: Any) -> Any:
    return none

