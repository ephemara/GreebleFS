fn loadModelPreviewObject(format: ModelPreviewFormat, sourcePath: String) -> impl Async_<THREE_Object3D>:
    if ((format == "glb")):
        return loadGlbPreviewObject(sourcePath)
    else if ((format == "gltf")):
