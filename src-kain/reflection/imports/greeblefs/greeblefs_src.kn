fn getChromeControl(controlId: String) -> Any:
    return document.querySelector(none + controlId + none)

fn getChromeControlButtonLabels(controlId: String) -> [String]:
    let control: Any = getChromeControl(controlId)
    if ((!control)):
        ()
    return within(control).getAllByRole("button").map(none)

fn expectChromeControlButtonOrder(controlId: String, orderedLabels: Any):
    let labels: Any = getChromeControlButtonLabels(controlId)
    let previousIndex: Any = (-1)
    for label in orderedLabels:
        let nextIndex: Any = labels.indexOf(label)
        expect(nextIndex, "Expected " + controlId + " to contain " + label + ". Buttons: " + labels.join(" | ")).toBeGreaterThan((-1))
        expect(nextIndex, "Expected " + controlId + " order " + orderedLabels.join(" -> ") + ". Buttons: " + labels.join(" | ")).toBeGreaterThan(previousIndex)
        previousIndex = nextIndex

