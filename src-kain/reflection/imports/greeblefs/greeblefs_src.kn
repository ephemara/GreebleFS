fn inferMaskChannelPreference(data: Uint8ClampedArray) -> Any:
    let alphaMin: Any = 255
    let alphaMax: Any = 0
    let lumaMin: Any = 255
    let lumaMax: Any = 0
    let maxChannelSpread: Any = 0
    let offset: Any = 0
    while ((offset < data.length)):
        let red: Any = (data[offset] or 0)
        let green: Any = (data[(offset + 1)] or 0)
        let blue: Any = (data[(offset + 2)] or 0)
        let alpha: Any = (data[(offset + 3)] or 0)
        let luma: Any = Math.max(red, green, blue)
        let channelSpread: Any = (Math.max(red, green, blue) - Math.min(red, green, blue))
        if ((alpha < alphaMin)):
            alphaMin = alpha
        if ((alpha > alphaMax)):
            alphaMax = alpha
        if ((luma < lumaMin)):
            lumaMin = luma
        if ((luma > lumaMax)):
            lumaMax = luma
        if ((channelSpread > maxChannelSpread)):
            maxChannelSpread = channelSpread
        offset = (offset + 4)
    let alphaRange: Any = (alphaMax - alphaMin)
    let lumaRange: Any = (lumaMax - lumaMin)
    let looksLikeOpaqueGrayscaleMask: Any = (((alphaMin >= 250) and (alphaRange <= 1)) and (maxChannelSpread <= 1))
    if (looksLikeOpaqueGrayscaleMask):
        return "luma"
    return none

