const ANNOUNCED_EXPLORER_TASK_KINDS: Any = ts_Set(["copy", "move", "delete", "trash", "extractArchive", "audioTransform", "audioBatchProcess"])

fn shouldAnnounceExplorerTask(task: ExplorerTaskSnapshot) -> Bool:
    return ANNOUNCED_EXPLORER_TASK_KINDS.has(task.kind)

fn getExplorerTaskKindLabel(task: ExplorerTaskSnapshot) -> String:
    if ((task.kind == "copy")):
        return "Copy"
    else if ((task.kind == "move")):
        return "Move"
    else if ((task.kind == "delete")):
        return "Delete"
    else if ((task.kind == "trash")):
        return "Trash"
    else if ((task.kind == "extractArchive")):
        return "Archive Extract"
    else if ((task.kind == "audioTransform")):
        return "Audio Transform"
    else if ((task.kind == "audioBatchProcess")):
        return "Audio Batch"
    else:
        return (task.title or "Explorer Task")

fn buildExplorerTaskNotificationPayload(task: ExplorerTaskSnapshot) -> Any:
    let kindLabel: Any = getExplorerTaskKindLabel(task)
    if ((task.status == "succeeded")):
        return none
    if ((task.status == "cancelled")):
        return none
    return none

fn hasPinnedThemeBundleLaneOverrides(overrides: Any) -> Bool:
    return ts_Boolean((((overrides.activeAppearancePackId or overrides.activeThemeRecipeId) or overrides.activeThemeEngineId) or overrides.activeShellRendererId))

fn createPinnedThemeBundleOverrideManifest(args: Any) -> Any:
    return none

fn clampValue(value: Float, min: Float, max: Float) -> Float:
    return Math.min(Math.max(value, min), max)

fn clampUnit(value: Float) -> Float:
    return clampValue(value, 0, 1)

fn getParentDirectoryPath(path: String) -> Any:
    let trimmed: Any = path.replace(none, "")
    let parentPath: Any = trimmed.replace(none, "")
    if ((parentPath == trimmed)):
        return path
    if ("/^[A-Za-z]:$/".test_(parentPath)):
        return parentPath + none
    return (parentPath or "/")

fn sanitizeImportedWallpaperFileName(fileName: String) -> Any:
    let dotIndex: Any = fileName.lastIndexOf(".")
    let rawBase: Any = none
    let rawExtension: Any = none
    let safeBase: Any = (rawBase.trim().toLowerCase().replace("/[^a-z0-9]+/g", "-").replace("/^-+|-+$/g", "") or "wallpaper")
    let safeExtension: Any = rawExtension.trim().toLowerCase().replace("/[^a-z0-9]+/g", "")
    return none

fn isThemeAssetDuplicatedInEffects(backgroundUrl: Any, backgroundImage: Any) -> Any:
    if (((!backgroundUrl) or (!backgroundImage))):
        return false
    let trimmedBackgroundImage: Any = backgroundImage.trim()
    return (((trimmedBackgroundImage == none + backgroundUrl + none) or (trimmedBackgroundImage == "url('" + backgroundUrl + "')")) or (trimmedBackgroundImage == "url(" + backgroundUrl + ")"))

fn applyWheelVisualControlAdjust(args: Any) -> Any:
    if (((!matchesWheelHotkey(args.event, args.binding)) or (args.event.deltaY == 0))):
        return false
    args.event.preventDefault()
    let nextValue: Any = clampValue((args.currentValue + (((args.step * args.direction) * args.multiplier))), args.min, args.max)
    args.onChange(nextValue)
    return true

fn resolveShellBackgroundColor(translucentColor: String, solidColor: String, blurStrength: Float) -> String:
    let normalizedStrength: Any = none
    let solidAlpha: Any = getOverlayColorAlpha(solidColor, 0.96)
    let translucentAlpha: Any = getOverlayColorAlpha(translucentColor, Math.min(0.82, solidAlpha))
    let minimumGlassAlpha: Any = Math.max(0.16, (translucentAlpha * 0.45))
    let targetAlpha: Any = (solidAlpha - ((((solidAlpha - minimumGlassAlpha)) * normalizedStrength)))
    return withOverlayColorAlpha(translucentColor, targetAlpha)

fn resolveWindowedModeApplyGeometry(args: Any) -> Any:
    if (((!args.shouldRestoreMaximizedWindow) or args.shouldSeedRestoreBoundsBeforeMaximize)):
        return none
    return none

const EMPTY_LAYOUT_PANEL_STATE: Option<Any> = none

fn uniquePanelIds(ids: [String]) -> [String]:
    return ts_Array.from(ts_Set(ids.filter(ts_Boolean)))

fn areStringArraysEqual(left: [String], right: [String]) -> Any:
    if ((left.length != right.length)):
        return false
    return left.every(none)

fn areLayoutPanelStatesEqual(left: LayoutPanelState, right: LayoutPanelState) -> Bool:
    return (((left.activePanelId == right.activePanelId) and areStringArraysEqual(left.openPanelIds, right.openPanelIds)) and areStringArraysEqual(left.dismissedPanelIds, right.dismissedPanelIds))

fn sanitizeLayoutPanelState(panelState: Any, availablePanelIds: [String], pinnedPanelIds: [String]) -> Any:
    let source: Any = (panelState or EMPTY_LAYOUT_PANEL_STATE)
    let availableSet: Any = ts_Set(availablePanelIds)
    let pinnedSet: Any = ts_Set(pinnedPanelIds)
    let normalizeIds: Any = none
    let activePanelId: Any = none
    return none

fn resolveActiveTabPanelId(args: Any) -> Any:
    if ((args.openPanelIds.length == 0)):
        return none
    if ((args.activePanelId and args.openPanelIds.includes(args.activePanelId))):
        return args.activePanelId
    if ((args.defaultActivePanelId and args.openPanelIds.includes(args.defaultActivePanelId))):
        return args.defaultActivePanelId
    return (args.openPanelIds[0] or none)

component LayoutPinnedPanelSlot(panel: Any, definition: Any) with Reactive:
    render <div style={none}>{definition.render()}</div>

