fn sortExplorerMenuLayoutEntries(entries: [ExplorerMenuLayoutEntry]) -> [ExplorerMenuLayoutEntry]:
    return [entries].sort(none)

fn moveExplorerMenuLayoutEntry(entries: [ExplorerMenuLayoutEntry], entryId: String, direction: String) -> Any:
    let sortedEntries: Any = sortExplorerMenuLayoutEntries(entries)
    let entry: Any = sortedEntries.find(none)
    if ((!entry)):
        return sortedEntries
    let siblings: Any = sortedEntries.filter(none)
    let currentIndex: Any = siblings.findIndex(none)
    if ((currentIndex < 0)):
        return sortedEntries
    let targetIndex: Any = none
    if (((targetIndex < 0) or (targetIndex >= siblings.length))):
        return sortedEntries
    let reorderedSiblings: Any = [siblings]
    let _: Any = reorderedSiblings.splice(currentIndex, 1)
    let movedEntry: Any = none
    reorderedSiblings.splice(targetIndex, 0, movedEntry)
    let nextSiblingOrders: Any = ts_Object.fromEntries(reorderedSiblings.map(none))
    return sortedEntries.map(none)

fn withExplorerMenuLayoutEntryEnabled(entries: [ExplorerMenuLayoutEntry], entryId: String, enabled: Bool) -> [ExplorerMenuLayoutEntry]:
    return sortExplorerMenuLayoutEntries(entries.map(none))

fn withExplorerMenuLayoutEntryParent(entries: [ExplorerMenuLayoutEntry], entryId: String, parentEntryId: Any) -> Any:
    if ((parentEntryId == entryId)):
        return sortExplorerMenuLayoutEntries(entries)
    let descendantIds: Any = ts_Set()
    let changed: Any = true
    while (changed):
        changed = false
        let iter_2: Any = entries
        let index_3: Any = 0
        while ((index_3 < iter_2.length)):
            let entry: Any = iter_2[index_3]
            if (((entry.parentEntryId and (((entry.parentEntryId == entryId) or descendantIds.has(entry.parentEntryId)))) and (!descendantIds.has(entry.id)))):
                descendantIds.add(entry.id)
                changed = true
            index_3 = (index_3 + 1)
    if ((parentEntryId and descendantIds.has(parentEntryId))):
        return sortExplorerMenuLayoutEntries(entries)
    let siblings: Any = entries.filter(none)
    let nextOrder: Any = (((siblings.length + 1)) * 10)
    return sortExplorerMenuLayoutEntries(entries.map(none))

fn placeExplorerMenuLayoutEntry(entries: [ExplorerMenuLayoutEntry], entryId: String, targetParentEntryId: Any, targetIndex: Float) -> Any:
    let sortedEntries: Any = sortExplorerMenuLayoutEntries(entries)
    let movingEntry: Any = sortedEntries.find(none)
    if ((!movingEntry)):
        return sortedEntries
    if ((targetParentEntryId == entryId)):
        return sortedEntries
    let descendantIds: Any = ts_Set()
    let changed: Any = true
    while (changed):
        changed = false
        let iter_4: Any = sortedEntries
        let index_5: Any = 0
        while ((index_5 < iter_4.length)):
            let entry: Any = iter_4[index_5]
            if (((entry.parentEntryId and (((entry.parentEntryId == entryId) or descendantIds.has(entry.parentEntryId)))) and (!descendantIds.has(entry.id)))):
                descendantIds.add(entry.id)
                changed = true
            index_5 = (index_5 + 1)
    if ((targetParentEntryId and descendantIds.has(targetParentEntryId))):
        return sortedEntries
    let currentParentEntryId: Any = (movingEntry.parentEntryId or none)
    let targetSiblings: Any = sortedEntries.filter(none)
    let clampedTargetIndex: Any = Math.max(0, Math.min(targetIndex, targetSiblings.length))
    let reorderedTargetSiblings: Any = [targetSiblings]
    reorderedTargetSiblings.splice(clampedTargetIndex, 0, none)
    let nextTargetOrders: Any = ts_Object.fromEntries(reorderedTargetSiblings.map(none))
    let nextCurrentParentOrders: Any = none
    return sortExplorerMenuLayoutEntries(sortedEntries.map(none))

