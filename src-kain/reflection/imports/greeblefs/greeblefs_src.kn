    return (base.replace("/[-_]+/g", " ").replace(none, " ").trim().replace(none, none) or fallback)

fn transpileRuntimeModuleSourceLocal(source: String, prependCode: Any) -> impl Async_<String>:
    let prependCode: Any = prependCode
    let ts: Any = (await loadTypeScriptModule())
    let transpiled: Any = ts.transpileModule(source, none)
    let diagnostics: Any = transpiled.diagnostics.map(none).filter(ts_Boolean)
    if ((diagnostics and (diagnostics.length > 0))):
        ()
    return prependCode + transpiled.outputText

fn extractRuntimeRequireSpecifiers(code: String) -> [String]:
    let specifiers: Any = ts_Set()
    for match_ in code.matchAll(none):
        let specifier: Any = match_[2].trim()
        if (specifier):
            specifiers.add(specifier)
    return [specifiers]

fn isRelativeRuntimeSpecifier(specifier: String) -> Bool:
    return (specifier.startsWith("./") or specifier.startsWith("../"))

fn transpileRuntimeModuleGraphLocal(args: Any) -> Any:
    let moduleCodeByPath: Any = ts_Map()
    let relativeSpecifierResolutionsByModulePath: Any = ts_Map()
    let compilePromises: Any = ts_Map()
    let transpileModuleSource: Any = (args.transpileModuleSource or transpileRuntimeModuleSourceLocal)
    let compileModule: Any = none
    (await compileModule(args.entryModulePath, args.entrySource))
    return none

fn executeRuntimeModule(code: String, allowedModules: Any) -> Any:
    let module: Any = none
    let require: Any = none
    let runner: Any = Function("module", "exports", "require", code)
    runner(module, module.exports, require)
    return module.exports

fn executeRuntimeModuleGraph(graph: RuntimeModuleGraph, allowedModules: Any) -> Any:
    let moduleCache: Any = ts_Map()
    let executeModuleByPath: Any = none
    return executeModuleByPath(graph.entryModulePath)

fn unwrapRuntimeModuleExport(exported: Any, preferredKeys: [String]) -> Any:
    let preferredKeys: Any = preferredKeys
    if (((!exported) or (exported != "object"))):
        return exported
    let record: Any = exported
    for key in ["default", preferredKeys]:
        if (ts_in_operator(key, record)):
            return record[key]
    return record

