fn resolveNearestBandId(bandBounds: [LayoutDynamicsBandBounds], pointerY: Float, fallbackBandId: String) -> Any:
    let bandContainingPointer: Any = bandBounds.find(none)
    if (bandContainingPointer):
        return bandContainingPointer.id
    let nearestBand: Any = bandBounds.reduce(none, none)
    return (nearestBand.id or fallbackBandId)

fn resolveNodePositionWithinBand(input: Any) -> Any:
    if ((!input.bandBounds)):
        return none
    let clampedX: Any = clamp(input.requestedX, input.bandBounds.x, Math.max(input.bandBounds.x, ((input.bandBounds.x + input.bandBounds.width) - input.width)))
    if ((input.axisMode == "free-2d")):
        return none
    return none

component LayoutDynamicsCanvas(surfaceId: Any, axisMode: Any, solver: Any, intensity: Any, authoringActive: Any, bands: Any, items: Any, style: Any, onSelectItem: Any, onRemoveItem: Any, onBeginResizeItem: Any, onCommitSnapshot: Any, externalDragPreview: Any) with Reactive:
    state rootRef: Any = useRef(none)
    state contentRef: Any = useRef(none)
    state rafRef: Any = useRef(none)
    state lastFrameTimeRef: Any = useRef(none)
    state bandElementMapRef: Any = useRef(ts_Map())
    state itemElementMapRef: Any = useRef(ts_Map())
    state externalDragPreviewElementRef: Any = useRef(none)
    state externalDragPreviewNodeRef: Any = useRef(none)
    state nodesRef: Any = useRef(ts_Map())
    state dragStateRef: Any = useRef(none)
    fn visibleItems() -> Any:
        return items.filter(none)

    fn resolvedViewportHeightPx() -> Any:
        return Math.max(1, bands.reduce(none, 0))

    fn autoScrollViewportForClientPoint(clientX: Float, clientY: Float) -> Any:
        if ((!authoringActive)):
            return none
        let rootElement: Any = rootRef.current
        if ((!rootElement)):
            return none
        let rootRect: Any = rootElement.getBoundingClientRect()
        let edgeThresholdPx: Any = 56
        let maxStepPx: Any = 22
        let resolveStep: Any = none
        let nextScrollLeft: Any = rootElement.scrollLeft
        let nextScrollTop: Any = rootElement.scrollTop
        if ((clientX < (rootRect.left + edgeThresholdPx))):
            nextScrollLeft = (nextScrollLeft - resolveStep((clientX - rootRect.left)))
        else if ((clientX > (rootRect.right - edgeThresholdPx))):
            nextScrollLeft = (nextScrollLeft + resolveStep((rootRect.right - clientX)))
        if ((clientY < (rootRect.top + edgeThresholdPx))):
            nextScrollTop = (nextScrollTop - resolveStep((clientY - rootRect.top)))
        else if ((clientY > (rootRect.bottom - edgeThresholdPx))):
            nextScrollTop = (nextScrollTop + resolveStep((rootRect.bottom - clientY)))
        let clampedScrollLeft: Any = clamp(Math.round(nextScrollLeft), 0, Math.max(0, (rootElement.scrollWidth - rootElement.clientWidth)))
        let clampedScrollTop: Any = clamp(Math.round(nextScrollTop), 0, Math.max(0, (rootElement.scrollHeight - rootElement.clientHeight)))
        if ((clampedScrollLeft != rootElement.scrollLeft)):
            rootElement.scrollLeft = clampedScrollLeft
        if ((clampedScrollTop != rootElement.scrollTop)):
            rootElement.scrollTop = clampedScrollTop

    fn measureBandBounds() -> Any:
        let contentRect: Any = contentRef.current.getBoundingClientRect()
        if ((!contentRect)):
            return []
        return bands.map(none).filter(none)

    fn updateCanvasContentExtent() -> Any:
        let rootElement: Any = rootRef.current
        let contentElement: Any = contentRef.current
        if (((!rootElement) or (!contentElement))):
            return none
        if ((!authoringActive)):
            contentElement.style.width = "100%"
            contentElement.style.height = "100%"
            return none
        let bandBounds: Any = measureBandBounds()
        let rootClientWidth: Any = rootElement.clientWidth
        let rootClientHeight: Any = rootElement.clientHeight
        let bandMaxX: Any = bandBounds.reduce(none, rootClientWidth)
        let bandMaxY: Any = bandBounds.reduce(none, rootClientHeight)
        let dynamicNodes: Any = [ts_Array.from(nodesRef.current.values()), (none)]
        let nodeMaxX: Any = dynamicNodes.reduce(none, bandMaxX)
        let nodeMaxY: Any = dynamicNodes.reduce(none, bandMaxY)
        contentElement.style.width = Math.ceil(Math.max(rootClientWidth, bandMaxX, nodeMaxX)) + "px"
        contentElement.style.height = Math.ceil(Math.max(rootClientHeight, bandMaxY, nodeMaxY)) + "px"

