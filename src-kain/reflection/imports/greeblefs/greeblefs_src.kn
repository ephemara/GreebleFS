    let topPadding: Any = arg_1.topPadding
    return none

fn getExplorerTextPreviewMetrics(content: String) -> Any:
    let normalizedContent: Any = (content or "")
    let characterCount: Any = normalizedContent.length
    if ((characterCount == 0)):
        return none
    let wordCount: Any = 0
    let lineCount: Any = 1
    let insideWord: Any = false
    let index: Any = 0
    while ((index < characterCount)):
        let character: Any = normalizedContent[index]
        let isWhitespace: Any = ((((((character == " ") or (character == none)) or (character == none)) or (character == none)) or (character == none)) or (character == none))
        if ((character == none)):
            lineCount = (lineCount + 1)
        if (isWhitespace):
            insideWord = false
            continue
        if ((!insideWord)):
            wordCount = (wordCount + 1)
            insideWord = true
        index = (index + 1)
    return none

