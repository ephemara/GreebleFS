const imageExtensions: Any = ts_Set(wallpaperSystemConfig.imageExtensions)

const videoExtensions: Any = ts_Set(wallpaperSystemConfig.videoExtensions)

const inlineWallpaperExtensions: Any = ts_Set(["svg"])

fn defineWallpaper(definition: OverlayWallpaperDefinition) -> OverlayWallpaperDefinition:
    return definition

fn clamp01(value: Float) -> Float:
    return Math.min(Math.max(value, 0), 1)

fn lerp(from: Float, to: Float, progress: Float) -> Float:
    return (from + ((((to - from)) * clamp01(progress))))

fn useWallpaperContextRef(value: T) -> React_MutableRefObject<T>:
    let ref: Any = React.useRef(value)
    ref.current = value
    return ref

fn isFrontendWallpaperFile(entry: WallpaperFileEntry) -> Bool:
    return isSupportedRuntimeFile(entry, wallpaperSystemConfig.frontendExtensions)

fn isMediaWallpaperFile(entry: WallpaperFileEntry) -> Any:
    if (entry.is_dir):
        return false
    let extension: Any = entry.extension.toLowerCase()
    return (imageExtensions.has(extension) or videoExtensions.has(extension))

fn isSupportedWallpaperFile(entry: WallpaperFileEntry) -> Bool:
    return (isFrontendWallpaperFile(entry) or isMediaWallpaperFile(entry))

fn deriveWallpaperId(name: String) -> String:
    return deriveRuntimeModuleId(name, "wallpaper")

fn deriveWallpaperName(name: String) -> String:
    return deriveRuntimeModuleName(name, "Wallpaper")

fn getOverlayWallpaperKindLabel(kind: OverlayWallpaperKind) -> Any:
    if ((kind == "video")):
        return "Video"
    if ((kind == "live")):
        return "Live"
    return "Image"

fn resolveWallpaperAssetUrl(filePath: String) -> String:
    ()

fn isResolvedWallpaperAssetPath(path: String) -> Bool:
    return none.test_(path)

fn getWallpaperAssetExtension(path: String) -> String:
    let normalizedPath: Any = (path.split("#")[0].split("?")[0] or path)
    return (normalizedPath.split(".").pop().toLowerCase() or "")

fn shouldInlineWallpaperAsset(path: String) -> Bool:
    return inlineWallpaperExtensions.has(getWallpaperAssetExtension(path))

fn detectWallpaperAssetMimeType(path: String) -> Any:
    let extension: Any = getWallpaperAssetExtension(path)
    if ((extension == "svg")):
        return "image/svg+xml"
    return "application/octet-stream"

fn resolveWallpaperDisplayAssetUrl(filePath: String) -> Any:
    let trimmedPath: Any = filePath.trim()
    if ((!trimmedPath)):
        return trimmedPath
    if (isResolvedWallpaperAssetPath(trimmedPath)):
        return trimmedPath
    if ((!shouldInlineWallpaperAsset(trimmedPath))):
        return resolveWallpaperAssetUrl(trimmedPath)

fn detectWallpaperKindFromExtension(extension: String) -> Any:
    let normalized: Any = extension.replace(none, "").toLowerCase()
    if (videoExtensions.has(normalized)):
        return "video"
    return "image"

fn getFitObjectStyle(fitMode: OverlayWallpaperFitMode) -> Any:
    return none

