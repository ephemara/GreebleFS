    let danger: Any = appearance.theme.palette.danger
    let text: Any = appearance.theme.palette.textPrimary
    let muted: Any = appearance.theme.palette.textMuted
    let controlRadius: Any = appearance.workbenchTheme.metrics.controlRadius
    let interactiveState: Any = none
    let sizeStyle: Any = none
    let toneStyleByState: Option<Any> = none
    return none

