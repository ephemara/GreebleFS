fn normalizeShareUrl(value: Any) -> Any:
    let trimmedValue: Any = value.trim()
    if ((!trimmedValue)):
        return none
    if (none.test_(trimmedValue)):
        return trimmedValue
    return "http://" + trimmedValue

fn isUsefulShareUrl(url: Any) -> Any:
    if ((!url)):
        return false

fn dedupeConnectionTargets(targets: [MobileShareConnectionTarget]) -> [MobileShareConnectionTarget]:
    let seenUrls: Any = ts_Set()
    return targets.filter(none)

fn createConnectionTarget(id: MobileShareConnectionTargetId, url: String, isPreferred: Bool) -> Any:
    let definition: Any = getMobileShareConnectionTargetDefinition(id)
    return none

fn createMobileShareConnectionTargets(result: LanShareResult, remoteAccessMode: MobileRemoteAccessMode) -> [MobileShareConnectionTarget]:
    let preferredUrl: Any = normalizeShareUrl(result.preferred_address)
    let targetCandidates: [(MobileShareConnectionTargetId, Any)] = [["lan-secure", normalizeShareUrl(result.ios_address)], ["lan-discovery", normalizeShareUrl(result.mdns_address)], ["lan-direct", normalizeShareUrl(result.address)], ["tailnet", normalizeShareUrl(result.tailscale_address)]]
    let targets: Any = dedupeConnectionTargets(targetCandidates.filter(none).map(none))
    let hasPreferredTarget: Any = (ts_Boolean(preferredUrl) and targets.some(none))
    if (((!hasPreferredTarget) and isUsefulShareUrl(preferredUrl))):
        let preferredDefinition: Any = getMobileRemoteAccessModeDefinition(remoteAccessMode)
        targets.unshift(none)
    return targets.sort(none)

fn copyTextToClipboardSafely(value: String) -> Any:
    if (((!value) or (!navigator.clipboard.writeText))):
        return false

fn resolveMobileSharePath(requestedPath: String) -> Any:
    let trimmedPath: Any = requestedPath.trim()
    if (isExplorerTrackableFolderPath(trimmedPath)):
        return trimmedPath
    return getExplorerHomeDir()

fn formatMobileShareNotice(session: MobileShareSession, copiedPreferredUrl: Bool) -> String:
    let accessDefinition: Any = getMobileRemoteAccessModeDefinition(session.remoteAccessMode)
    let suffix: Any = none
    return "Mobile share is live for " + session.sharePath + " via " + accessDefinition.launchBadge + " at " + session.preferredUrl + "." + suffix

fn getTailscaleMobileShareReadinessError(status: TailscaleStatusSnapshot) -> Any:
    if ((!status.cliAvailable)):
        return "Tailscale CLI is not available on this desktop. Install it or switch Mobile Access back to Local LAN."
    if ((!status.running)):
        return (status.diagnosticMessage or "Tailscale is installed but the local daemon is not running yet.")
    if ((!status.connected)):
        if (status.authUrl):
            return "Tailscale still needs desktop sign-in before the tailnet mobile route can come online."
        return (status.diagnosticMessage or "Tailscale is not connected on this machine yet.")
    return none

fn ensureMobileShareRemoteAccessReady(remoteAccessMode: MobileRemoteAccessMode) -> Any:
    if ((remoteAccessMode != "tailscale")):
        return none
    let tailscaleStatus: Any = (await getTailscaleStatus())
    let readinessError: Any = getTailscaleMobileShareReadinessError(tailscaleStatus)
    if (readinessError):
        ()
    return tailscaleStatus

fn createMobileShareSession(sharePath: String, remoteAccessMode: MobileRemoteAccessMode, result: LanShareResult) -> Any:
    let preferredUrl: Any = ((normalizeShareUrl(result.preferred_address) or normalizeShareUrl(result.address)) or "http://127.0.0.1")
    return none

fn startMobileShareRuntime(args: StartMobileShareArgs) -> Any:
    if ((!isTauri())):
        ()
    let sharePath: Any = (await resolveMobileSharePath(args.requestedPath))
    (await ensureMobileShareThemeSnapshotSynced())
    let tailscaleStatus: Any = (await ensureMobileShareRemoteAccessReady(args.remoteAccessMode))
    let result: Any = unwrapTauriResult((await commands.lanShareStart(sharePath, "mobile", none, args.remoteAccessMode)))
    let session: Any = createMobileShareSession(sharePath, args.remoteAccessMode, result)
    let copiedPreferredUrl: Any = none
    return none

fn stopMobileShareRuntime() -> impl Async_<()>:
    if ((!isTauri())):
        ()
    unwrapTauriResult((await commands.lanShareStop()))

