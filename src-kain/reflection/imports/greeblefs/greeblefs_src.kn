fn resolveIconAssetUrl(path: String) -> Any:
    let trimmedPath: Any = path.trim()
    if ((!trimmedPath)):
        return trimmedPath
    if (isWebAssetPath(trimmedPath)):
        return trimmedPath
    let fileData: Any = (await commands.fsReadFileBase64(trimmedPath).then(unwrapTauriResult))
    if (isWebAssetPath(fileData)):
        return fileData
    let extension: Any = trimmedPath.split(".").pop().toLowerCase()
    let mimeType: Any = none
    return "data:" + mimeType + ";base64," + fileData

fn buildLoadedIconThemePackage(record: IconThemePackageRecord) -> Any:
    let text: Any = (await commands.fsReadTextFile(record.manifestPath).then(unwrapTauriResult))
    let manifest: Any = parseIconThemeManifest(text)
    let resolvedEntries: Any = (await ts_Promise.all(ts_Object.entries((manifest.iconDefinitions or none)).map(none)))
    let resolvedIconTheme: Any = mergeResolvedIconThemes(getBuiltInIconTheme(), resolveIconThemeManifest(none, none))
    return none

fn readPackageRecord(entry: FileEntry) -> Any:
    if ((!entry.is_dir)):
        let isJsonManifest: Any = (entry.extension.toLowerCase() == "json")
        if ((!isJsonManifest)):
            return none
        return none
    for manifestName in iconThemeSystemConfig.manifestNames:
        let manifestPath: Any = joinPlatformPath(entry.path, manifestName)
    return none

