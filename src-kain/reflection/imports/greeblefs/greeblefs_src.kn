fn createWorkbenchEngineRecipe(theme: OverlayThemeDefinition) -> Any:
    if ((!theme.compiledEngineManifest)):
        return none
    let bindings: Any = resolveThemeEngineBindings(theme.compiledEngineManifest, theme.workbench)
    let presentation: Any = bindings.presentation
    let layoutPrimitive: Any = bindings.layoutPrimitive
    let navigationPattern: Any = bindings.navigationPattern
    let renderStyle: Any = bindings.renderStyle
    let styleSeed: Any = createWorkbenchStyleSeed(presentation.chromeStyle)
    let densityMetricDelta: Any = getDensityMetricDelta(presentation.density)
    let panelSpacing: Any = clampNumber(Math.round((presentation.panelSpacing or defaultMetrics.panelGap)), 4, 24)
    let cornerRadius: Any = clampNumber(Math.round((presentation.cornerRadius or defaultMetrics.panelRadius)), 4, 999)
    let layoutGap: Any = clampNumber(Math.round(((readThemeNumberProp(layoutPrimitive.props, "gap") or readThemeNumberProp(layoutPrimitive.props, "gutter")) or panelSpacing)), 4, 32)
    let topBarStyle: Any = styleSeed.topBarStyle
    let panelStyle: Any = styleSeed.panelStyle
    let commandPaletteStyle: Any = styleSeed.commandPaletteStyle
    let terminalStyle: Any = styleSeed.terminalStyle
    let settingsStyle: Any = styleSeed.settingsStyle
    let tabStyle: Option<Any> = none
    let chromeHeight: Any = (defaultMetrics.chromeHeight + densityMetricDelta)
    let controlRadius: Any = cornerRadius
    let panelRadius: Any = clampNumber(Math.max(cornerRadius, 8), 8, 48)
    let shellInset: Any = none
    let commandPaletteWidth: Any = none
    let commandPaletteTopInset: Any = ((defaultMetrics.commandPaletteTopInset + shellInset) + Math.max(densityMetricDelta, 0))
    let pagePadding: Any = (panelSpacing + (none))
    let panelGap: Any = layoutGap
    if ((navigationPattern.kind == "palette")):
        commandPaletteStyle = none
        commandPaletteWidth = (commandPaletteWidth + 24)
    if ((layoutPrimitive.kind == "grid")):
        commandPaletteWidth = (commandPaletteWidth + 24)
        pagePadding = (pagePadding + 1)
    else if ((layoutPrimitive.kind == "dock")):
        shellInset = Math.max(shellInset, panelSpacing)
        settingsStyle = none
    else if ((layoutPrimitive.kind == "freeform")):
        panelStyle = "floating"
        settingsStyle = "floating"
        panelRadius = clampNumber((panelRadius + 4), 8, 48)
        shellInset = Math.max(shellInset, panelSpacing)
    else:
        ()
    if ((renderStyle.kind == "ps-3-xmb")):
        topBarStyle = "floating"
        panelStyle = "glass"
        commandPaletteStyle = "glass"
        terminalStyle = "glass"
        settingsStyle = "glass"
        tabStyle = "capsule"
        controlRadius = 999
        panelRadius = clampNumber(Math.max(panelRadius, 24), 8, 48)
        shellInset = Math.max(shellInset, 12)
        commandPaletteWidth = Math.max(commandPaletteWidth, 780)
    else if ((renderStyle.kind == "ios-springboard")):
        topBarStyle = "minimal"
        panelStyle = "floating"
        commandPaletteStyle = "floating"
        settingsStyle = "floating"
        tabStyle = "capsule"
        controlRadius = Math.max(controlRadius, 18)
        panelRadius = clampNumber(Math.max(panelRadius, 24), 8, 48)
        shellInset = Math.max(shellInset, panelSpacing)
        commandPaletteWidth = Math.max(commandPaletteWidth, 760)
    else if ((renderStyle.kind == "wii-channels")):
        topBarStyle = "minimal"
        panelStyle = "floating"
        commandPaletteStyle = "floating"
        settingsStyle = "floating"
        tabStyle = "capsule"
        controlRadius = Math.max(controlRadius, 16)
        panelRadius = clampNumber(Math.max(panelRadius, 28), 8, 48)
        shellInset = Math.max(shellInset, 10)
    else if ((renderStyle.kind == "desktop-window-manager")):
        topBarStyle = "solid"
        panelStyle = "solid"
        commandPaletteStyle = "solid"
        terminalStyle = "solid"
        settingsStyle = "solid"
        tabStyle = "windows"
        controlRadius = clampNumber(Math.min(controlRadius, 8), 4, 999)
        panelRadius = clampNumber(Math.min(Math.max(panelRadius, 10), 18), 8, 48)
        shellInset = 0
    else:
        ()
    if ((navigationPattern.kind == "xmb")):
        topBarStyle = "floating"
        panelStyle = none
        commandPaletteStyle = none
        tabStyle = "capsule"
    let chromeTabs: Any = normalizeWorkbenchChromeTabsThemeRecipe(none)
    return none

fn formatLength(value: Float) -> String:
    return Math.round(value) + "px"

fn formatUnitlessNumber(value: Float) -> String:
    return ((Math.round((value * 1000)) / 1000)).toString()

fn resolveWorkbenchThemeRecipe(theme: OverlayThemeDefinition) -> Any:
    let userRecipe: Any = theme.workbench
    let engineRecipe: Any = createWorkbenchEngineRecipe(theme)
    let engineBindings: Any = resolveThemeEngineBindings(theme.compiledEngineManifest, userRecipe)
    let preset: Any = ((userRecipe.preset or inferWorkbenchPresetFromEngine(theme)) or inferWorkbenchPreset(theme))
    let presetRecipe: Any = getPresetRecipe(preset)
    let metrics: Any = none
    let surfaces: Any = none
    let typography: Any = none
    let terminalRenderer: Any = (((asTerminalRenderer(userRecipe.terminalRenderer) or asTerminalRenderer(engineRecipe.terminalRenderer)) or asTerminalRenderer(presetRecipe.terminalRenderer)) or "auto")
    let terminalFx: Any = resolveWorkbenchTerminalFxRecipe(presetRecipe.terminalFx, engineRecipe.terminalFx, userRecipe.terminalFx)
    let chromeTabs: Any = resolveWorkbenchChromeTabsThemeRecipe(getLegacyWorkbenchChromeTabsRecipe(presetRecipe), getLegacyWorkbenchChromeTabsRecipe(engineRecipe), getLegacyWorkbenchChromeTabsRecipe(userRecipe))
    let cssVars: Any = none
    return none

