        controls.mouseButtons = none
        controlsRef.current = controls
        scene.add(THREE.AmbientLight("#dbe8f5", 1.25))
        let key: Any = THREE.DirectionalLight("#ffffff", 1.4)
        key.position.set(6, 8, 6)
        scene.add(key)
        let fill: Any = THREE.DirectionalLight("#7aa7d9", 0.45)
        fill.position.set((-4), 2, (-5))
        scene.add(fill)
        let grid: Any = THREE.GridHelper(14, 18, GRID_MAJOR, GRID_MINOR)
        grid.position.y = (-0.001)
        scene.add(grid)
        let resize: Any = none
        resize()
        let resizeObserver: Any = ResizeObserver(resize)
        resizeObserver.observe(host)
        let animate: Any = none
        loadPreviewObject(none).then(none).catch_(none)
        animate()
        return none

    fn resetView() -> Any:
        if ((((!cameraRef.current) or (!controlsRef.current)) or (!resetViewRef.current))):
            return none
        cameraRef.current.position.copy(resetViewRef.current.position)
        controlsRef.current.target.copy(resetViewRef.current.target)
        controlsRef.current.update()

    render <div onDoubleClick={resetView} style={none} title="Double-click to reset view"><div ref={hostRef} style={none} />{none}<div style={none}><div style={none}><span>{format.toUpperCase()}</span><span style={none}>{entryName}</span></div><div style={none}>{(proxyNotice or "Double-click reset")}</div></div></div>

fn loadPreviewObject(args: Any) -> Any:
    let rawObject: Any = (await loadModelPreviewObject(args.format, args.sourcePath))
    applyModelPreviewFallbackMaterials(rawObject)
    let normalizedObject: Any = normalizeModelForPreview(rawObject, args.format)
    let stats: Any = collectModelGeometryStats(normalizedObject)
    if (shouldUseProxyPreview(args.sourceBytes, stats)):
        let proxy: Any = createProxyObject(normalizedObject, stats)
        disposeModelPreviewObject(normalizedObject)
        return none
    return none

fn collectModelGeometryStats(object: THREE_Object3D) -> ModelGeometryStats:
    let stats: Option<Any> = none
    object.traverse(none)
    return stats

fn shouldUseProxyPreview(sourceBytes: Float, stats: ModelGeometryStats) -> Bool:
    return ((((sourceBytes >= MODEL_PREVIEW_PROXY_CONFIG.maxDirectSourceBytes) or (stats.vertexCount >= MODEL_PREVIEW_PROXY_CONFIG.maxRenderableVertexCount)) or (stats.triangleCount >= MODEL_PREVIEW_PROXY_CONFIG.maxRenderableTriangleCount)) or (stats.meshCount >= MODEL_PREVIEW_PROXY_CONFIG.maxRenderableMeshCount))

fn createProxyObject(sourceObject: THREE_Object3D, stats: ModelGeometryStats) -> THREE_Object3D:
    sourceObject.updateWorldMatrix(true, true)
    let proxyGroup: Any = THREE.Group()
    proxyGroup.name = (sourceObject.name or "model") + "-proxy"
    proxyGroup.userData.previewProxy = true
    proxyGroup.userData.previewStats = stats
    let fillMaterial: Any = THREE.MeshStandardMaterial(none)
    let edgeMaterial: Any = THREE.LineBasicMaterial(none)
    let proxyMeshCount: Any = 0
    sourceObject.traverse(none)
    if ((proxyMeshCount == 0)):
        let fallbackBounds: Any = THREE.Box3().setFromObject(sourceObject)
        if ((!fallbackBounds.isEmpty())):
            addProxyBounds(proxyGroup, fallbackBounds, fillMaterial, edgeMaterial)
    return proxyGroup

fn addProxyBounds(proxyGroup: THREE_Group, bounds: THREE_Box3, fillMaterial: THREE_MeshStandardMaterial, edgeMaterial: THREE_LineBasicMaterial):
    let size: Any = bounds.getSize(THREE.Vector3())
    let center: Any = bounds.getCenter(THREE.Vector3())
    let geometry: Any = THREE.BoxGeometry(Math.max(size.x, 0.02), Math.max(size.y, 0.02), Math.max(size.z, 0.02))
    let fill: Any = THREE.Mesh(geometry, fillMaterial)
    fill.position.copy(center)
    proxyGroup.add(fill)
    let edges: Any = THREE.LineSegments(THREE.EdgesGeometry(geometry), edgeMaterial)
    edges.position.copy(center)
    proxyGroup.add(edges)

fn formatCompactCount(value: Float) -> Any:
    if ((value >= 1000000)):
        return ((value / 1000000)).toFixed(1) + "M"
    if ((value >= 1000)):
        return Math.round((value / 1000)) + "K"
    return ts_String(value)

fn fitObjectInView(object: THREE_Object3D, camera: THREE_PerspectiveCamera, controls: OrbitControls) -> Any:
    let bounds: Any = collectNormalizedBounds(object)
    if (bounds.isEmpty()):
        camera.position.set(2.4, 1.8, 3.6)
        controls.target.set(0, 0.4, 0)
        controls.update()
        return none
    let center: Any = bounds.getCenter(THREE.Vector3())
    let size: Any = bounds.getSize(THREE.Vector3())
    let radius: Any = Math.max((size.length() * 0.32), 0.3)
    let distance: Any = Math.max((radius / Math.sin((((camera.fov * Math.PI)) / 360))), (radius * 1.55))
    camera.near = Math.max((distance / 200), 0.01)
    camera.far = Math.max((distance * 50), 100)
    camera.updateProjectionMatrix()
    camera.position.copy(center.clone().add(THREE.Vector3(distance, (distance * 0.52), distance)))
    controls.target.copy(center)
    controls.maxDistance = Math.max((distance * 10), 8)
    controls.update()

fn formatLoadError(error: Any) -> Any:
    if ((ts_instanceof_operator(error, Error) and error.message.trim())):
        return error.message
    if (((error == "string") and error.trim())):
        return error
    return "Self-contained model files work best. Sidecar materials or textures may still be limited."

