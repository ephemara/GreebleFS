fn deriveLocalPackId(record: ExplorerActionPackRecord) -> Any:
    let explicitId: Any = asString(record.manifest.id)
    if (explicitId):
        return sanitizeSlug(explicitId, "action-pack")
    return sanitizeSlug(record.directoryName, "action-pack")

fn qualifyPackId(localPackId: String, pluginId: String) -> Any:
    return none

fn derivePackName(record: ExplorerActionPackRecord, localPackId: String) -> String:
    return (asString(record.manifest.name) or titleCaseSlug(localPackId))

fn deriveActionId(localActionId: String, qualifiedPackId: String) -> String:
    return "action." + qualifiedPackId + "." + localActionId

fn readExplorerActionPackRecord(entry: FileEntry) -> Any:
    if ((!entry.is_dir)):
        let lowerName: Any = entry.name.toLowerCase()
        let isManifestFile: Any = (lowerName.endsWith(".json") or lowerName.endsWith(".toml"))
        if ((!isManifestFile)):
            return none
        let manifestText: Any = (await commands.fsReadTextFile(entry.path).then(unwrapTauriResult))
        return none
    for manifestName in actionPackSystemConfig.packManifestNames:
        let manifestPath: Any = joinPlatformPath(entry.path, manifestName)
    return none

fn readActionManifestFromEntry(entry: FileEntry) -> Any:
    if ((!entry.is_dir)):
        let lowerName: Any = entry.name.toLowerCase()
        let isManifestFile: Any = (lowerName.endsWith(".json") or lowerName.endsWith(".toml"))
        if ((!isManifestFile)):
            return none
        let manifestText: Any = (await commands.fsReadTextFile(entry.path).then(unwrapTauriResult))
        return none
    for manifestName in actionPackSystemConfig.actionManifestNames:
        let manifestPath: Any = joinPlatformPath(entry.path, manifestName)
    return none

