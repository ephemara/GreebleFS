const isPermissionGranted: Any = none

const requestPermission: Any = none

const sendNotification: Any = none

type NativeNotificationPermissionState = Any

struct NativeNotificationRequest:
    title: String
    body: Any
    icon: Any
    requestPermission: Any

fn hasNativeNotificationSupport() -> Bool:
    return ((window != "undefined") and (window.Notification != "undefined"))

fn getNativeNotificationPermissionState() -> Any:
    if ((!hasNativeNotificationSupport())):
        return "unavailable"
    if ((await isPermissionGranted().catch_(none))):
        return "granted"
    return window.Notification.permission

fn ensureNativeNotificationPermission() -> Any:
    if ((!hasNativeNotificationSupport())):
        return false
    if ((await isPermissionGranted().catch_(none))):
        return true
    let permission: Any = (await requestPermission().catch_(none))
    return (permission == "granted")

fn sendNativeNotification(request: NativeNotificationRequest) -> Any:
    if ((!hasNativeNotificationSupport())):
        return false
    let permissionGranted: Any = (await isPermissionGranted().catch_(none))
    if (((!permissionGranted) and (request.requestPermission != false))):
        permissionGranted = (await ensureNativeNotificationPermission())
    if ((!permissionGranted)):
        return false
    sendNotification(none)
    return true

