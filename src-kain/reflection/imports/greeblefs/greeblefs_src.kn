component StorageInlineMetricPill(detail: Any, label: Any, value: Any) with Reactive:
    render <div style={none}><div style={none}>{label}</div><div style={none}>{value}</div>{none}</div>

fn buildQueuedItem(entry: StorageScanEntry) -> Any:
    return none

fn matchesQueueFilter(item: StorageQueuedItem, query: String) -> Any:
    let normalizedQuery: Any = query.trim().toLowerCase()
    if ((!normalizedQuery)):
        return true
    return ((item.name.toLowerCase().includes(normalizedQuery) or item.path.toLowerCase().includes(normalizedQuery)) or ((item.extension or "")).toLowerCase().includes(normalizedQuery))

fn formatRelativeStoragePath(path: String, rootPath: Any) -> Any:
    if ((!rootPath)):
        return path
    let normalizedPath: Any = normalizeStorageWorkbenchPath(path)
    let normalizedRootPath: Any = normalizeStorageWorkbenchPath(rootPath)
    if ((((!normalizedPath) or (!normalizedRootPath)) or (!isStoragePathWithinRoot(normalizedPath, normalizedRootPath)))):
        return path
    if ((normalizedPath == normalizedRootPath)):
        return "."
    let separator: Any = none
    let prefix: Any = none
    return (normalizedPath.slice(prefix.length) or ".")

fn resolveStorageContextPath(activeRootPath: Any, selectedEntry: Any) -> Any:
    if ((selectedEntry.kind == "directory")):
        return selectedEntry.path
    if (selectedEntry):
        return (getParentPath(selectedEntry.path) or activeRootPath)
    return activeRootPath

fn StorageStatusBanner(arg_0: Any) -> Any:
    let error: Any = arg_0.error
    let isElevated: Any = arg_0.isElevated
    let notice: Any = arg_0.notice
    if (error):
        return (none)
    return (none)

component StorageRail(appearance: Any, activeRootPath: Any, isElevated: Any, onBeginScan: Any, onRefreshRoots: Any, roots: Any, rootsError: Any, rootsLoading: Any, scanStatus: Any) with Reactive:
    render <OverlayScrollArea data_testid="storage-scan-rail" style={none} scrollbarStyle="explorer-file-list" viewportStyle={none}><div style={none}><section style={none}><div style={none}><div style={none}><div style={none}>{"Scan Rail"}</div><div style={none}>{none}</div></div><OverlayActionButton appearance={appearance} size="compact" tone="quiet" onClick={onRefreshRoots} disabled={rootsLoading}><RefreshCw size={13} />{"Refresh"}</OverlayActionButton></div>{none}</section><section style={none}><div style={none}><div style={none}>{"Session"}</div><div style={none}>{none}</div></div><StorageInlineMetricPill label="Access" value={none} detail={none} /><div style={none}>{none}</div></section></div></OverlayScrollArea>

component StorageWorkbenchToolbar(activeMode: Any, activeRootPath: Any, appearance: Any, isQueueDrawerOpen: Any, onRescan: Any, onSetActiveMode: Any, queueTrigger: Any, scanStatus: Any, selectionAllocatedBytes: Any, selectedEntriesCount: Any) with Reactive:
    render <div data_testid="storage-workbench-toolbar" style={none}><div style={none}><div style={none}><div style={none}>{"Storage Workbench"}</div><div style={none}>{none}</div></div><div style={none}>{none}{none}{queueTrigger}<div data_testid="storage-task-badge"><ExplorerTaskStatusBadge accent="var(--overlay-accent)" border="var(--overlay-border)" danger="#ff8d8d" muted="var(--overlay-text-muted)" text="var(--overlay-text-primary)" /></div></div></div><div style={none}><StorageInlineMetricPill label="Allocated" value={formatBytes((scanStatus.totalAllocatedBytes or 0))} /><StorageInlineMetricPill label="Logical" value={formatBytes((scanStatus.totalLogicalBytes or 0))} /><StorageInlineMetricPill label="Waste" value={formatBytes((scanStatus.totalWasteBytes or 0))} /><StorageInlineMetricPill label="Selected" value={formatCount(selectedEntriesCount) + " items"} detail={formatBytes(selectionAllocatedBytes)} />{none}</div></div>

component StorageQueueDrawer(appearance: Any, busyAction: Any, onClearQueue: Any, onExecuteQueue: Any, onRemoveQueuePath: Any, onSelectQueuePath: Any, queueFilterQuery: Any, queueItems: Any, selectedPathSet: Any, setQueueFilterQuery: Any) with Reactive:
    state queueDefinition: Any = getStorageBatchQueueDefinition("cleanup")
    state filteredQueueItems: Any = queueItems.filter(none)
    state queueSummary: Any = summarizeQueueEntries(queueItems)
