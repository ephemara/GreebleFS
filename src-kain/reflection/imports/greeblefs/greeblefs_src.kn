const BUILT_IN_ICON_THEME: Any = getBuiltInIconTheme()

fn isFolderIconId(iconId: String) -> Bool:
    return ((iconId == BUILT_IN_ICON_THEME.folder) or iconId.startsWith("folder_"))

const BUILT_IN_FOLDER_ICON_IDS: Any = ts_Object.keys(BUILT_IN_ICON_THEME.iconDefinitions).filter(none).sort(none)

type FolderIconValue = Any

struct FolderIconRule:
    id: String
    label: String
    matchers: [String]
    icon: FolderIconValue

struct FolderIconOption:
    value: FolderIconValue
    label: String
    closedSrc: String
    openSrc: String

struct FolderIconResolverConfig:
    rules: Any
    defaultIcon: Any
    iconTheme: Any

struct FolderIconResolution:
    icon: FolderIconValue
    matchedRule: Any

fn titleCase(value: String) -> String:
    return value.split(none).filter(ts_Boolean).map(none).join(" ")

fn splitCamelCase(value: String) -> String:
    return value.replace("/([a-z0-9])([A-Z])/g", "$1 $2").replace("/([A-Z]+)([A-Z][a-z])/g", "$1 $2")

fn normalizeFolderIconMatcher(value: String) -> String:
    return splitCamelCase(value).toLowerCase().replace("/[^a-z0-9]+/g", "_").replace("/^_+|_+$/g", "")

fn tokenizeSegment(value: String) -> Any:
    let normalized: Any = normalizeFolderIconMatcher(value)
    return none

fn buildSegmentVariants(segment: String) -> Any:
    let tokens: Any = tokenizeSegment(segment)
    if ((!tokens.length)):
        return []
    let variants: Any = ts_Set()
    variants.add(tokens.join("_"))
    if ((tokens.length > 1)):
        variants.add(tokens.join(""))
        variants.add(tokens[0])
        variants.add(tokens[(tokens.length - 1)])
    let lastToken: Any = tokens[(tokens.length - 1)]
    if ((lastToken.endsWith("s") and (lastToken.length > 3))):
        let singularTokens: Any = [tokens]
        ()
        variants.add(singularTokens.join("_"))
        variants.add(singularTokens[(singularTokens.length - 1)])
    return [variants]

fn buildCandidateMatchers(folderPath: String) -> Any:
    let pathSegments: Any = folderPath.split(none).filter(ts_Boolean)
    if ((!pathSegments.length)):
        return []
    let candidates: Any = ts_Set()
    let recentSegments: Any = pathSegments.slice((-4))
    for segment in recentSegments:
        for variant in buildSegmentVariants(segment):
            candidates.add(variant)
    let width: Any = 2
    while ((width <= Math.min(3, pathSegments.length))):
        let slice: Any = pathSegments.slice((-width))
        let tokens: Any = slice.flatMap(none)
        if ((!tokens.length)):
            continue
        candidates.add(tokens.join("_"))
        candidates.add(tokens.join(""))
        width = (width + 1)
    return [candidates]

fn cloneRule(rule: FolderIconRule) -> Any:
    return none

fn buildLabelForIcon(iconId: String) -> Any:
    if ((iconId == BUILT_IN_ICON_THEME.folder)):
        return "Default Folder"
    let labelSource: Any = iconId.replace("/^folder_/", "").replace("/_/g", " ")
    return titleCase(labelSource)

fn buildRuleId(iconId: String) -> Any:
    return none

fn groupMatchersByIcon(folderNames: Any) -> Map<FolderIconValue, [String]>:
    let grouped: Any = ts_Map()
    for _item in ts_Object.entries(folderNames):
        let matcher: Any = none
        let iconId: Any = none
        let matcher: Any = none
        let iconId: Any = none
        if ((!isFolderIconId(iconId))):
            continue
        let normalizedMatcher: Any = normalizeFolderIconMatcher(matcher)
        if ((!normalizedMatcher)):
            continue
        let existing: Any = (grouped.get(iconId) or [])
        if ((!existing.includes(normalizedMatcher))):
            existing.push(normalizedMatcher)
            grouped.set(iconId, existing)
    return grouped

fn createFolderRulesFromNames(folderNames: Any) -> [FolderIconRule]:
    return [groupMatchersByIcon(folderNames).entries()].map(none).sort(none)

const DEFAULT_FOLDER_ICON_VALUE: FolderIconValue = BUILT_IN_ICON_THEME.folder

const BUILT_IN_FOLDER_ICON_RULES: Any = createFolderRulesFromNames(BUILT_IN_ICON_THEME.folderNames)

fn createDefaultFolderIconRules() -> [FolderIconRule]:
    return BUILT_IN_FOLDER_ICON_RULES.map(cloneRule)

fn resolveOpenFolderIconId(icon: FolderIconValue, iconTheme: OverlayResolvedIconTheme) -> Any:
    let openIconId: Any = none
    return none

fn getIconPair(icon: FolderIconValue, iconTheme: OverlayResolvedIconTheme) -> Any:
    let theme: Any = (iconTheme or BUILT_IN_ICON_THEME)
    let closedIconId: Any = none
    let openIconId: Any = resolveOpenFolderIconId(closedIconId, theme)
    return none

fn buildThemeRules(iconTheme: OverlayResolvedIconTheme) -> Any:
    if ((!iconTheme)):
        return []
    return createFolderRulesFromNames(iconTheme.folderNames)

fn getEffectiveRules(rules: Any, iconTheme: OverlayResolvedIconTheme) -> Any:
    let baseRules: Any = (rules or BUILT_IN_FOLDER_ICON_RULES)
    let themeRules: Any = buildThemeRules(iconTheme)
    if ((!themeRules.length)):
        return baseRules
    return [themeRules, baseRules]

fn getOptionLabel(icon: FolderIconValue) -> String:
    return buildLabelForIcon(icon)

const FOLDER_ICON_OPTIONS: Any = BUILT_IN_FOLDER_ICON_IDS.map(none)

fn getNamedFolderIconSrc(icon: FolderIconValue, open: Any, iconTheme: OverlayResolvedIconTheme) -> Any:
    let open: Any = open
    let pair: Any = getIconPair(icon, iconTheme)
    return none

fn findMatchingRule(folderPath: String, rules: Any) -> Any:
    let candidates: Any = buildCandidateMatchers(folderPath)
    for rule in rules:
        let normalizedMatchers: Any = rule.matchers.map(normalizeFolderIconMatcher).filter(ts_Boolean)
        if (normalizedMatchers.some(none)):
            return rule
    return none

fn resolveFolderIcon(folderPath: String, config: FolderIconResolverConfig) -> Any:
    let config: Any = config
    let rules: Any = getEffectiveRules(config.rules, config.iconTheme)
    let defaultIcon: Any = (config.defaultIcon or DEFAULT_FOLDER_ICON_VALUE)
    let matchedRule: Any = findMatchingRule(folderPath.trim(), rules)
    if (matchedRule):
        return none
    return none

fn resolveFolderIconPair(folderPath: String, config: FolderIconResolverConfig) -> GeneratedFolderIconPair:
    let config: Any = config
    let resolution: Any = resolveFolderIcon(folderPath, config)
    return getIconPair(resolution.icon, config.iconTheme)

fn getFolderIconSrc(folderPath: String, open: Any, config: FolderIconResolverConfig) -> String:
    let open: Any = open
    let config: Any = config
    let resolution: Any = resolveFolderIcon(folderPath, config)
    return getNamedFolderIconSrc(resolution.icon, open, config.iconTheme)

const recordExplorerPerformanceSample: Any = none

type ExplorerPerformanceSample = Any

const OVERLAY_FRAME_TARGET_MS: Any = (1000 / 120)

const FRAME_TELEMETRY_MIN_SAMPLES: Any = 90

const FRAME_TELEMETRY_MIN_WINDOW_MS: Any = 1500

struct OverlayFrameTelemetryStats:
    avgFrameMs: Float
    avgFps: Float
    p95FrameMs: Float
    worstFrameMs: Float
    frameCount: Float
    overBudgetCount: Float
    withinTarget: Bool
    windowDurationMs: Float

fn shouldFlushOverlayFrameWindow(frameCount: Float, windowDurationMs: Float) -> Bool:
    return ((frameCount >= FRAME_TELEMETRY_MIN_SAMPLES) or (windowDurationMs >= FRAME_TELEMETRY_MIN_WINDOW_MS))

fn summarizeOverlayFrameWindow(frameDurations: Any, windowDurationMs: Float) -> Any:
    if (((frameDurations.length == 0) or (windowDurationMs <= 0))):
        return none
    let sorted: Any = [frameDurations].sort(none)
    let total: Any = sorted.reduce(none, 0)
    let avgFrameMs: Any = roundMetric((total / sorted.length))
    let p95Index: Any = Math.min((sorted.length - 1), Math.max(0, (Math.ceil((sorted.length * 0.95)) - 1)))
    let p95FrameMs: Any = roundMetric(((sorted[p95Index] or sorted[(sorted.length - 1)]) or 0))
    let worstFrameMs: Any = roundMetric((sorted[(sorted.length - 1)] or 0))
    let overBudgetCount: Any = frameDurations.filter(none).length
    return none

fn recordOverlayFrameTelemetry(stats: OverlayFrameTelemetryStats, metadata: Any) -> ExplorerPerformanceSample:
    let metadata: Any = metadata
    let sample: Option<Any> = none
    recordExplorerPerformanceSample(sample)
    return sample

fn roundMetric(value: Float) -> Float:
    return (Math.round((value * 100)) / 100)

