fn buildPreviewSourcePixels(sourceImageUrl: String, width: Float, height: Float) -> Any:
    let image: Any = (await loadImageElement(sourceImageUrl))
    let canvas: Any = document.createElement("canvas")
    canvas.width = width
    canvas.height = height
    let context: Any = canvas.getContext("2d")
    if ((!context)):
        ()
    context.clearRect(0, 0, width, height)
    context.drawImage(image, 0, 0, width, height)
    let imageData: Any = context.getImageData(0, 0, width, height)
