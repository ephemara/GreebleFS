fn normalizeMonacoColorValue(color: Any) -> Any:
    return normalizeMonacoLiteralColor(color)

fn resolveMonacoLiteralColor(candidates: [Any]) -> Any:
    let candidates: Any = candidates
    for candidate in candidates:
        let normalized: Any = normalizeMonacoColorValue(candidate)
        if (((normalized == "string") and "/^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$/".test_(normalized))):
            return normalized
    return undefined

fn normalizeMonacoThemeColors(colors: Any) -> Any:
    return ts_Object.fromEntries(ts_Object.entries(colors).map(none))

fn normalizeExplorerMonacoThemeIdFragment(themeId: Any) -> String:
    let normalized: Any = ts_String((themeId or "")).trim().toLowerCase().replace("/[^a-z0-9-]+/g", "-").replace("/-+/g", "-").replace("/^-+|-+$/g", "")
    return (normalized or "default")

fn isLightAppearance(appearance: ResolvedOverlayAppearance) -> Any:
    let color: Any = (parseOverlayColor(appearance.theme.palette.appBackground) or parseOverlayColor(appearance.theme.palette.panelBackground))
    if ((!color)):
        return false
    let luminance: Any = (((((0.299 * color.red) + (0.587 * color.green)) + (0.114 * color.blue))) / 255)
    return (luminance >= 0.62)

fn normalizeMonacoThemeRules(rules: Any) -> [OverlayMonacoThemeCompatibilityRule]:
    return ((rules or [])).filter(none).map(none)

fn resolveExplorerMonacoThemeId(appearance: Any) -> Any:
    if ((!appearance)):
        return "greeblefs-monaco-default"
    return "greeblefs-monaco-" + normalizeExplorerMonacoThemeIdFragment(appearance.theme.id)

fn buildExplorerMonacoThemeDescriptor(appearance: Any) -> Any:
    let compatibilityTheme: Any = appearance.theme.assets.monacoTheme
    let scrollbarTheme: Any = appearance.theme.scrollbar
    let scrollbarThumbColor: Any = resolveMonacoLiteralColor(scrollbarTheme.thumb, appearance.cssVars["--overlay-scrollbar-thumb"])
    let scrollbarThumbHoverColor: Any = resolveMonacoLiteralColor(scrollbarTheme.thumbHover, appearance.cssVars["--overlay-scrollbar-thumb-hover"])
    let base: Any = (compatibilityTheme.baseTheme or (none))
    let colors: Any = normalizeMonacoThemeColors(none)
    return none

fn applyExplorerMonacoTheme(monaco: Any, appearance: Any) -> String:
    let descriptor: Any = buildExplorerMonacoThemeDescriptor(appearance)
    monaco.editor.defineTheme(descriptor.id, none)
    monaco.editor.setTheme(descriptor.id)
    return descriptor.id

fn getExplorerMonacoLineNumberMinChars(lineCount: Float) -> Float:
    let normalizedLineCount: Any = Math.max(1, Math.trunc(lineCount))
    return Math.max(4, (ts_String(normalizedLineCount).length + 1))

