        let mod_: Any = parts[i]
        if ("/^(cmd|meta|m)$/i".test_(mod_)):
            meta = true
        else if ("/^a(lt)?$/i".test_(mod_)):
            alt = true
        else if ("/^(c|ctrl|control)$/i".test_(mod_)):
            ctrl = true
        else if ("/^s(hift)?$/i".test_(mod_)):
            shift = true
        else if ("/^mod$/i".test_(mod_)):
            if ((isiOS() or isMacOS())):
                meta = true
            else:
                ctrl = true
        else:
            ()
        i = (i + 1)
    if (alt):
        result = "Alt-" + result
    if (ctrl):
        result = "Ctrl-" + result
    if (meta):
        result = "Meta-" + result
    if (shift):
        result = "Shift-" + result
    return result

