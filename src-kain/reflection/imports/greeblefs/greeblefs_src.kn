        let firstMark: Any = start.node.marks.find(none)
        if (firstMark):
            attributes = firstMark.attrs
    let mark: Any = findMarkInSet([start.node.marks], type_, attributes)
    if ((!mark)):
        return none
    let startIndex: Any = start.index
    let startPos: Any = (pos.start() + start.offset)
    let endIndex: Any = (startIndex + 1)
    let endPos: Any = (startPos + start.node.nodeSize)
    while (((startIndex > 0) and isMarkInSet([pos.parent.child((startIndex - 1)).marks], type_, attributes))):
        startIndex = (startIndex - 1)
        startPos = (startPos - pos.parent.child(startIndex).nodeSize)
    while (((endIndex < pos.parent.childCount) and isMarkInSet([pos.parent.child(endIndex).marks], type_, attributes))):
        endPos = (endPos + pos.parent.child(endIndex).nodeSize)
        endIndex = (endIndex + 1)
    return none

