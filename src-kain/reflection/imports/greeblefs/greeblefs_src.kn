fn asRecord(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    return value

fn asString(value: Any, fallback: Any) -> Any:
    let fallback: Any = fallback
    return none

fn asStringArray(value: Any) -> Any:
    if ((!ts_Array.isArray(value))):
        return []
    return value.filter(none).map(none)

fn asBoolean(value: Any) -> Any:
    return none

fn asStringRecord(value: Any) -> Any:
    let record: Any = asRecord(value)
    if ((!record)):
        return none
    return ts_Object.fromEntries(ts_Object.entries(record).filter(none).map(none))

fn sanitizeSlug(value: String, fallback: String) -> String:
    return ((value.trim().toLowerCase().replace("/[^a-z0-9]+/g", "-").replace("/^-+|-+$/g", "") or fallback))

fn titleCaseSlug(value: String) -> String:
    return value.replace("/[-_]+/g", " ").replace(none, " ").trim().replace(none, none)

fn getParentDirectoryPath(path: String) -> Any:
    let normalized: Any = path.replace(none, "/")
    let lastSlash: Any = normalized.lastIndexOf("/")
    if ((lastSlash <= 0)):
        return none
    return normalized.slice(0, lastSlash)

