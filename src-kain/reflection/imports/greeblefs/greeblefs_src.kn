fn ensureAudioEngineHydration() -> Any:
    if ((!isTauri())):
        return none
    if (hydrationPromise):
        return hydrationPromise
    let store: Any = useAudioEngineStore.getState()
    store.setHydrationState("loading")
    store.setHydrationError(none)
    hydrationPromise = (none)().catch_(none).finally(none)
    return hydrationPromise

fn ensureAudioEngineSubscription() -> Any:
    if (((!isTauri()) or subscriptionReady)):
        return none
    if (subscriptionPromise):
        return subscriptionPromise
    let store: Any = useAudioEngineStore.getState()
    store.setSubscriptionState("loading")
    store.setSubscriptionError(none)
    subscriptionPromise = listenToExplorerAudioEngineState(none).then(none).catch_(none).finally(none)
    return subscriptionPromise

