type BridgeHarness = Any

const hostScriptPath: Any = resolve(process.cwd(), "src-node", "builtin-runtimes", "vscode-bridge-host", "index.cjs")

fn createBridgeFixture() -> Any:
    let rootPath: Any = mkdtempSync(join(tmpdir(), "greeblefs-vscode-bridge-"))
    let extensionRootPath: Any = join(rootPath, "tree-test")
    mkdirSync(extensionRootPath, none)
    let packageJsonPath: Any = join(extensionRootPath, "package.json")
    let workspaceTargetPath: Any = join(extensionRootPath, "workspace-target.txt")
    let manifest: Any = none
    writeFileSync(packageJsonPath, JSON.stringify(manifest, none, 2) + none, "utf8")
    writeFileSync(workspaceTargetPath, none, "utf8")
    writeFileSync(join(extensionRootPath, "extension.cjs"), none.trimStart(), "utf8")
    return none

fn createBridgeHarness() -> Any:
    let child: Any = spawn_(process.execPath, [hostScriptPath], none)
    let pendingCalls: Any = ts_Map()
    let stderrChunks: [String] = []
    let requestCounter: Any = 0
    let readyResolved: Any = false
    child.stderr.on("data", none)
    let close: Any = none
    let ready: Any = ts_Promise(none)
    return none

fn respondToHostCall(child: ChildProcessWithoutNullStreams, packet: BridgePacket):
    let payload: Any = none
    let pathValue: Any = ts_String((((payload.path or payload.oldPath) or payload.newPath) or ""))
    let response: Any = none
    if ((packet.methodId == "files.read_text")):
        response = readFileSync(pathValue, "utf8")
    else if ((packet.methodId == "files.write_text")):
        writeFileSync(pathValue, ts_String((payload.content or "")), "utf8")
    else if ((packet.methodId == "files.stat")):
        let stat: Any = statSync(pathValue)
        response = none
        break
    else if ((packet.methodId == "files.list_directory")):
        response = none
    else if ((packet.methodId == "files.create_directory")):
        mkdirSync(pathValue, none)
    else if ((packet.methodId == "files.delete")):
        rmSync(pathValue, none)
    else if ((packet.methodId == "files.rename")):
        renameSync(ts_String((payload.oldPath or "")), ts_String((payload.newPath or "")))
    else if ((packet.methodId == "explorer.open_path")):
        response = none
    else:
        ()
    child.stdin.write(JSON.stringify(none) + none)

