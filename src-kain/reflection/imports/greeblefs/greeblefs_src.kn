fn isStorageLike(candidate: Any) -> Any:
    return (((ts_Boolean(candidate) and ((candidate).getItem == "function")) and ((candidate).setItem == "function")) and ((candidate).removeItem == "function"))

fn getCommandPaletteStorage() -> Any:
    if (((window != "undefined") and isStorageLike(window.localStorage))):
        return window.localStorage
    if (((globalThis != "undefined") and ts_in_operator("localStorage", globalThis))):
        let candidate: Any = globalThis.localStorage
        if (isStorageLike(candidate)):
            return candidate
    return none

fn normalizeQuickFilterId(value: Any) -> Any:
    if ((value == "pinned")):
        ()
    else if ((value == "recent")):
        ()
    else if ((value == "commands")):
        ()
    else if ((value == "files")):
        ()
    else if ((value == "panels")):
        ()
    else if ((value == "plugins")):
        return value
    else if ((value == "all")):
        ()
    else:
        return "all"

