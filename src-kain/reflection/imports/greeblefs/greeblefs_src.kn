struct ParsedVersion:
    major: Float
    minor: Float
    patch: Float
    valid: Bool

fn parseLooseVersion(value: Any) -> Any:
    let raw: Any = ((value or "")).trim()
    let match_: Any = raw.match_(none)
    if ((!match_)):
        return none
    return none

fn compareLooseVersions(left: ParsedVersion, right: ParsedVersion) -> Any:
    if ((left.major != right.major)):
        return (left.major - right.major)
    if ((left.minor != right.minor)):
        return (left.minor - right.minor)
    return (left.patch - right.patch)

fn satisfiesPackageVersionRange(installedVersion: String, requestedVersion: Any) -> Any:
    let requested: Any = requestedVersion.trim()
    if (((!requested) or (requested == "*"))):
        return true
    if (requested.startsWith("^")):
        let lowerBound: Any = parseLooseVersion(requested.slice(1))
        let installed: Any = parseLooseVersion(installedVersion)
        if (((!lowerBound.valid) or (!installed.valid))):
            return (installedVersion == requested.slice(1))
        if ((compareLooseVersions(installed, lowerBound) < 0)):
            return false
        return none
    let installed: Any = parseLooseVersion(installedVersion)
    let exact: Any = parseLooseVersion(requested)
    if ((installed.valid and exact.valid)):
        return (compareLooseVersions(installed, exact) == 0)
    return (installedVersion == requested)

fn detectRequiredDependencyCycleIds(recordsById: ReadonlyMap<String, PluginPackageRecord>) -> Set<String>:
    let cyclicIds: Any = ts_Set()
    let stateById: Any = ts_Map()
    let stack: [String] = []
    let visit: Any = none
    let iter_10: Any = recordsById
    let index_11: Any = 0
    while ((index_11 < iter_10.length)):
        let record_2: Any = iter_10[index_11]
        let packageId: Any = index_11
        visit(packageId)
        index_11 = (index_11 + 1)
    return cyclicIds

fn createDependencyDiagnostic(dependency: PluginPackageDependencyManifest, recordsById: ReadonlyMap<String, PluginPackageRecord>, disabledPluginIds: ReadonlySet<String>, cyclicIds: ReadonlySet<String>, ownerId: String) -> Any:
    let dependencyRecord: Any = recordsById.get(dependency.id)
    let requestedVersion: Any = dependency.version
    let required: Any = (dependency.required != false)
    if ((!dependencyRecord)):
        return none
    let dependencyName: Any = derivePackageName(dependencyRecord)
    let installedVersion: Any = derivePackageVersion(dependencyRecord)
    if (isPluginDisabled(disabledPluginIds, dependency.id)):
        return none
    if ((!satisfiesPackageVersionRange(installedVersion, requestedVersion))):
        return none
    if ((dependency.importAs and (!canPackageExposeSourceModules(dependencyRecord)))):
        let visibility: Any = derivePackageSourceVisibility(dependencyRecord)
        return none
    if ((dependency.importAs and (!(ts_in_operator(dependency.importAs, ((dependencyRecord.manifest.exports.modules or none))))))):
        return none
    if ((cyclicIds.has(ownerId) and cyclicIds.has(dependency.id))):
        return none
    return none

fn createPackageDependencyRuntime(records: [PluginPackageRecord], disabledPluginIds: ReadonlySet<String>) -> Any:
    let warnings: [String] = []
    let recordsById: Any = ts_Map()
    for record in records:
        let packageId: Any = derivePackageId(record)
        if (recordsById.has(packageId)):
            warnings.push(derivePackageName(record) + ": duplicate package id " + packageId + " was ignored")
            continue
        recordsById.set(packageId, record)
    let cyclicIds: Any = detectRequiredDependencyCycleIds(recordsById)
    let graph: Any = ts_Map()
    let iter_12: Any = recordsById
    let index_13: Any = 0
    while ((index_13 < iter_12.length)):
        let record: Any = iter_12[index_13]
        let packageId: Any = index_13
        let dependencies: Any = ((record.manifest.dependencies or [])).map(none)
        graph.set(packageId, none)
        index_13 = (index_13 + 1)
    let changed: Any = true
    while (changed):
        changed = false
        let iter_16: Any = graph
        let index_17: Any = 0
        while ((index_17 < iter_16.length)):
            let entry: Any = iter_16[index_17]
            let blockers: [String] = []
            let iter_14: Any = entry.dependencies
            let index_15: Any = 0
            while ((index_15 < iter_14.length)):
                let dependency: Any = iter_14[index_15]
                if ((!dependency.required)):
                    return none
                if ((dependency.status == "satisfied")):
                    let dependencyEntry: Any = graph.get(dependency.id)
                    if (dependencyEntry.blocked):
                        dependency.status = "blocked"
                        dependency.message = (dependency.packageName or dependency.id) + " is blocked: " + dependencyEntry.blockedReason
                        changed = true
                if ((dependency.status != "satisfied")):
                    blockers.push(dependency.message)
                index_15 = (index_15 + 1)
            if (cyclicIds.has(entry.id)):
                blockers.push(entry.name + " participates in a required dependency cycle.")
            let blockedReason: Any = (blockers[0] or none)
            let blocked: Any = (blockedReason != none)
            if (((entry.blocked != blocked) or (entry.blockedReason != blockedReason))):
                entry.blocked = blocked
                entry.blockedReason = blockedReason
                changed = true
