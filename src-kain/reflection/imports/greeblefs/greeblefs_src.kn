    if ((entry.source == "action")):
        return (entry.action.packName.trim() or "Authored Action")
    if ((entry.source == "missing-action")):
        return "Missing Action"
    if ((entry.source == "widget")):
        return (entry.widget.sourceLabel.trim() or "Explorer Widget")
    if ((entry.source == "missing-widget")):
        return "Missing Widget"
    return "Built-In Control"

