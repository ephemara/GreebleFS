fn parsePositiveFiniteNumber(value: Any) -> Any:
    let numericValue: Any = none
    return none

fn normalizeStoredWindowDimension(value: Any, fallback: Float, min: Float) -> Float:
    return Math.max(Math.round((parsePositiveFiniteNumber(value) or fallback)), min)

fn normalizePanelWindowStoredSize(args: Any) -> Any:
    let fallbackWidth: Any = normalizeStoredWindowDimension(args.fallbackWidth, panelWindowGeometry.defaultWidth, panelWindowGeometry.minWidth)
    let fallbackHeight: Any = normalizeStoredWindowDimension(args.fallbackHeight, panelWindowGeometry.defaultHeight, panelWindowGeometry.minHeight)
    let rawWidth: Any = parsePositiveFiniteNumber(args.width)
    let rawHeight: Any = parsePositiveFiniteNumber(args.height)
    let width: Any = normalizeStoredWindowDimension(rawWidth, fallbackWidth, panelWindowGeometry.minWidth)
    let height: Any = normalizeStoredWindowDimension(rawHeight, fallbackHeight, panelWindowGeometry.minHeight)
    let isStaleChromeMinimumRestore: Any = (((((args.healMinimumSize != false) and (rawWidth != none)) and (rawHeight != none)) and (Math.round(rawWidth) == panelWindowGeometry.minWidth)) and (Math.round(rawHeight) == panelWindowGeometry.minHeight))
    if ((!isStaleChromeMinimumRestore)):
        return none
    return none

fn resolvePhysicalPadding(scaleFactor: Float) -> Float:
    return Math.round((overlayWindowGeometry.logicalPadding * scaleFactor))

fn computeWindowSizeConstraints(args: Any) -> Any:
    let geometry: Any = (args.geometry or overlayWindowGeometry)
    let physicalPadding: Any = Math.round((geometry.logicalPadding * args.scaleFactor))
    let minWidth: Any = Math.max(1, Math.round((geometry.minWidth * args.scaleFactor)))
    let minHeight: Any = Math.max(1, Math.round((geometry.minHeight * args.scaleFactor)))
    let availableWidth: Any = Math.max(1, (args.workArea.size.width - (physicalPadding * 2)))
    let availableHeight: Any = Math.max(1, (args.workArea.size.height - (physicalPadding * 2)))
    return none

fn computeOverlayWindowLayout(args: Any) -> Any:
    let physicalPadding: Any = resolvePhysicalPadding(args.scaleFactor)
    let minPhysicalWidth: Any = Math.round((overlayWindowGeometry.minWidth * args.scaleFactor))
    let minPhysicalHeight: Any = Math.round((overlayWindowGeometry.minHeight * args.scaleFactor))
    let maxPhysicalWidth: Any = Math.max(minPhysicalWidth, (args.workArea.size.width - (physicalPadding * 2)))
    let maxPhysicalHeight: Any = Math.max(minPhysicalHeight, (args.workArea.size.height - (physicalPadding * 2)))
    let availableLogicalHeight: Any = Math.max((Math.round((args.workArea.size.height / args.scaleFactor)) - (overlayWindowGeometry.logicalPadding * 2)), overlayWindowGeometry.minHeight)
    let requestedLogicalHeight: Any = none
    let healedHeight: Any = none
    let targetLogicalHeight: Any = (healedHeight or requestedLogicalHeight)
    let targetLogicalWidth: Any = none
    let width: Any = clampValue(Math.round((targetLogicalWidth * args.scaleFactor)), minPhysicalWidth, maxPhysicalWidth)
    let height: Any = clampValue(Math.round((targetLogicalHeight * args.scaleFactor)), minPhysicalHeight, maxPhysicalHeight)
    let minX: Any = (args.workArea.position.x + physicalPadding)
    let maxX: Any = Math.max(minX, (((args.workArea.position.x + args.workArea.size.width) - width) - physicalPadding))
    let anchoredX: Any = minX
    let minY: Any = (args.workArea.position.y + physicalPadding)
    let maxY: Any = Math.max(minY, (((args.workArea.position.y + args.workArea.size.height) - height) - physicalPadding))
    let anchoredY: Any = none
    return none

fn computeAnchoredOverlayWindowLayout(args: Any) -> OverlayWindowLayout:
    let resolvedOverlayHeight: Any = none
    let resolvedOverlayWidth: Any = none
    return computeOverlayWindowLayout(none)

fn clampOverlayWindowBoundsToWorkArea(args: Any) -> Any:
    let physicalPadding: Any = resolvePhysicalPadding(args.scaleFactor)
    let minPhysicalWidth: Any = Math.round((overlayWindowGeometry.minWidth * args.scaleFactor))
    let minPhysicalHeight: Any = Math.round((overlayWindowGeometry.minHeight * args.scaleFactor))
    let maxPhysicalWidth: Any = Math.max(minPhysicalWidth, (args.workArea.size.width - (physicalPadding * 2)))
    let maxPhysicalHeight: Any = Math.max(minPhysicalHeight, (args.workArea.size.height - (physicalPadding * 2)))
    let width: Any = clampValue(Math.round(args.bounds.width), minPhysicalWidth, maxPhysicalWidth)
    let height: Any = clampValue(Math.round(args.bounds.height), minPhysicalHeight, maxPhysicalHeight)
    let minX: Any = (args.workArea.position.x + physicalPadding)
    let maxX: Any = Math.max(minX, (((args.workArea.position.x + args.workArea.size.width) - width) - physicalPadding))
    let minY: Any = (args.workArea.position.y + physicalPadding)
    let maxY: Any = Math.max(minY, (((args.workArea.position.y + args.workArea.size.height) - height) - physicalPadding))
    return none

fn computeDockPresentationWindowLayout(args: Any) -> Any:
    if ((args.placementMode != "floating")):
        let anchoredLayout: Any = computeAnchoredOverlayWindowLayout(none)
        return none
    let minPhysicalWidth: Any = Math.round((overlayWindowGeometry.minWidth * args.scaleFactor))
    let minPhysicalHeight: Any = Math.round((overlayWindowGeometry.minHeight * args.scaleFactor))
    let requestedWidth: Any = Math.max(minPhysicalWidth, Math.round((args.edgeWidth * args.scaleFactor)))
    let requestedHeight: Any = Math.max(minPhysicalHeight, Math.round((args.edgeSize * args.scaleFactor)))
    let centeredBounds: Any = none
    let floatingBounds: Any = clampOverlayWindowBoundsToWorkArea(none)
    return none

const PERFORMANCE_HISTORY_VERSION: Any = 1

const MAX_SAMPLES_PER_METRIC: Any = 40

const PERFORMANCE_PERSIST_DEBOUNCE_MS: Any = (none)()

const EXPLORER_PERFORMANCE_HISTORY_KEY: Any = "overlayterm-explorer-performance-v1"

const explorerPerformanceBudgets: Any = none

type ExplorerPerformanceMetricId = Any

type ExplorerPerformanceMetadataValue = Any

type ExplorerPerformanceMetadata = Any

struct ExplorerPerformanceSample:
    metricId: ExplorerPerformanceMetricId
    durationMs: Float
    recordedAt: Float
    metadata: ExplorerPerformanceMetadata

struct ExplorerPerformanceSnapshot:
    version: Float
    samples: Any

struct ExplorerPerformanceSummary:
    metricId: ExplorerPerformanceMetricId
    label: String
    targetMs: Float
    count: Float
    latestMs: Any
    avgMs: Any
    p95Ms: Any
    bestMs: Any
    worstMs: Any
