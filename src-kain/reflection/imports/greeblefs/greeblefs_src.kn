fn discoverOverlayPlugins(hostApiFactory: Any, options: OverlayPluginDiscoveryOptions) -> Any:
    let options: Any = options
    let emptyResult: Option<Any> = none
    if ((!isTauri())):
        return emptyResult
    let disabledPluginIds: Any = normalizeDisabledPluginIdSet(options.disabledPluginIds)
    let rootEntries: Any = (await listDirectory(pluginSystemConfig.pluginsDirectory))
    let packageRootEntries: Any = (await listDirectoryOptional(pluginSystemConfig.packagesDirectory))
    let legacyFiles: Any = rootEntries.filter(none).sort(none)
    let vsixFiles: Any = rootEntries.filter(entryLooksLikeVsix).sort(none)
    let pluginPackageDirectories: Any = rootEntries.filter(none).sort(none)
    let dependencyPackageDirectories: Any = packageRootEntries.filter(none).sort(none)
    let aggregate: Option<Any> = none
    let packageRecords: [PluginPackageRecord] = []
    for directory in pluginPackageDirectories:
        let manifest: Any = (await readPluginManifest(directory.path))
        if ((!manifest)):
            continue
        packageRecords.push(none)
    for directory in dependencyPackageDirectories:
        let manifest: Any = (await readPluginManifest(directory.path))
        if ((!manifest)):
            continue
        packageRecords.push(none)
    let dependencyRuntimeResult: Any = createPackageDependencyRuntime(packageRecords, disabledPluginIds)
    aggregate.warnings.push(none)
    let legacyPluginResults: Any = (await ts_Promise.allSettled(legacyFiles.map(none)))
    let iter_18: Any = legacyPluginResults
    let index_19: Any = 0
    while ((index_19 < iter_18.length)):
        let result: Any = iter_18[index_19]
        let index: Any = index_19
        if ((result.status == "fulfilled")):
            aggregate.plugins.push(result.value)
            return none
        let legacyEntry: Any = legacyFiles[index]
        let legacyName: Any = ((legacyEntry.name or legacyEntry.path) or "legacy plugin")
        aggregate.warnings.push(legacyName + ": " + ts_String(result.reason))
        index_19 = (index_19 + 1)
    let vsixResults: Any = (await ts_Promise.allSettled(vsixFiles.map(none)))
    let iter_20: Any = vsixResults
    let index_21: Any = 0
    while ((index_21 < iter_20.length)):
        let result: Any = iter_20[index_21]
        let index: Any = index_21
        if ((result.status == "fulfilled")):
            aggregate.plugins.push(result.value.plugin)
            aggregate.explorerActivityLanes.push(none)
            aggregate.commands.push(none)
            return none
        let vsixEntry: Any = vsixFiles[index]
        let vsixName: Any = ((vsixEntry.name or vsixEntry.path) or "VSIX extension")
        aggregate.warnings.push(vsixName + ": " + ts_String(result.reason))
        index_21 = (index_21 + 1)
    for record in dependencyRuntimeResult.runtime.recordsById.values():
        ()
    aggregate.plugins.sort(none)
    aggregate.themePackages.sort(none)
    aggregate.shaders.sort(none)
    aggregate.fonts.sort(none)
    aggregate.commands.sort(none)
    aggregate.actionPacks.sort(none)
    aggregate.actions.sort(none)
    aggregate.explorerActions.sort(none)
    aggregate.contextMenuItems.sort(none)
    aggregate.explorerActivityLanes.sort(none)
    aggregate.explorerViews.sort(none)
    aggregate.explorerWidgets.sort(none)
    aggregate.workflows.sort(none)
    aggregate.settingsSlots.sort(none)
    return aggregate

