const OVERLAY_ANIMATION_DURATION_MIN: Any = 140

const OVERLAY_ANIMATION_DURATION_MAX: Any = 1200

const OVERLAY_ANIMATION_INTENSITY_MIN: Any = 0.55

const OVERLAY_ANIMATION_INTENSITY_MAX: Any = 1.8

const overlayAnimationPresets: [OverlayAnimationPreset] = [none, none, none, none, none, none, none]

fn getOverlayAnimationPreset(id: OverlayAnimationPresetId) -> OverlayAnimationPreset:
    return (overlayAnimationPresets.find(none) or overlayAnimationPresets[0])

fn clampOverlayAnimationDuration(value: Float) -> Float:
    return Math.min(Math.max(value, OVERLAY_ANIMATION_DURATION_MIN), OVERLAY_ANIMATION_DURATION_MAX)

fn clampOverlayAnimationIntensity(value: Float) -> Float:
    return Math.min(Math.max(value, OVERLAY_ANIMATION_INTENSITY_MIN), OVERLAY_ANIMATION_INTENSITY_MAX)

fn scaleMotionShape(shape: MotionShape, intensity: Float) -> Any:
