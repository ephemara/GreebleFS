fn buildExplorerExecutionContextSnapshot(input: BuildExplorerExecutionContextSnapshotInput) -> Any:
    let previewFocusedPath: Any = (input.previewSession.filePath.trim() or none)
    let requestedEntryPaths: Any = ts_Set([input.selectedPaths.map(none).filter(ts_Boolean), previewFocusedPath].filter(none))
    let entryByPath: Any = ts_Map()
    if ((requestedEntryPaths.size > 0)):
        for entry in input.entries:
            if ((!requestedEntryPaths.has(entry.path))):
                continue
            entryByPath.set(entry.path, toExecutionContextEntry(entry))
            if ((entryByPath.size == requestedEntryPaths.size)):
                break
    let selectedEntries: Any = input.selectedPaths.map(none).filter(none)
    let focusedEntry: Any = (selectedEntries[0] or (none))
    return none

fn toExecutionContextEntry(entry: ExplorerExecutionContextEntryLike) -> Any:
    return none

fn toExecutionContextPreviewSession(previewSession: Any) -> Any:
    if ((!previewSession)):
        return none
    return none

fn buildExecutionContextRoots(drives: [ExplorerExecutionContextDriveLike], activeDirectory: Any) -> Any:
    if ((drives.length > 0)):
        return drives.map(none)
    let fallbackRoot: Any = deriveRootFromPath(activeDirectory)
    return none

fn deriveRootFromPath(path: Any) -> Any:
    let normalized: Any = normalizeOptionalString(path)
    if ((!normalized)):
        return none
    let windowsDriveMatch: Any = normalized.match_(none)
    if (windowsDriveMatch):
        let drivePath: Any = normalized.slice(0, 2) + none
        return none
    if (normalized.startsWith("/")):
        return none
    let remoteRoot: Any = normalized.split("/").slice(0, 3).join("/")
    if (remoteRoot):
        return none
    return none

fn normalizeOptionalString(value: Any) -> Any:
    let normalized: Any = (value.trim() or "")
    return none

fn inferExplorerExecutionContextFileType(input: Any) -> Any:
    let focusedEntry: Any = (input.focusedEntry or none)
    let previewFilePath: Any = (((input.previewSession.resolvedPath.trim() or input.previewSession.filePath.trim()) or focusedEntry.path.trim()) or "")
    if ((!previewFilePath)):
        return none
    let extension: Any = ((focusedEntry.extension.trim().toLowerCase() or previewFilePath.split(".").pop().trim().toLowerCase()) or "")
    let normalizedExtension: Any = none
    let isDirectory: Any = (focusedEntry.isDirectory == true)
    return none

fn buildExplorerExecutionContextRevision(input: Any) -> String:
    return [(normalizeOptionalString(input.workspaceTabId) or ""), (normalizeOptionalString(input.paneId) or ""), (normalizeOptionalString(input.activeDirectory) or ""), (normalizeOptionalString(input.cwd) or ""), (normalizeOptionalString(input.previewFilePath) or ""), [input.selectedPaths].sort().join("|")].join("::")

