const TOGGLE_OVERLAY_REQUEST_EVENT: Any = "overlay://toggle-request"

const SHOW_WINDOW_MODE_REQUEST_EVENT: Any = "overlay://show-window-mode-request"

type WindowHostRole = Any

fn normalizeWindowHostRole(label: Any) -> Any:
    if (((label == MAIN_WINDOW_HOST_LABEL) or (label == DOCK_WINDOW_HOST_LABEL))):
        return label
    return "unknown"

fn getCurrentWindowHostRole() -> Any:
    if ((!isTauri())):
        return MAIN_WINDOW_HOST_LABEL

fn hasSeparateWaylandDockHost(args: Any) -> Bool:
    return (((args.runtimePlatform == "linux") and (args.linuxDisplayServer == "wayland")) and args.waylandDockHostEnabled)

fn shouldForceMainWindowStartupMode(args: Any) -> Bool:
    return (((((args.runtimePlatform == "linux") and (args.linuxDisplayServer == "wayland")) and args.useSeparateWaylandDockHost) and (args.hostRole == MAIN_WINDOW_HOST_LABEL)) and (args.windowMode == "overlay"))

fn resolvePresentationHostLabel(args: Any) -> Any:
    if ((!args.useSeparateWaylandDockHost)):
        return MAIN_WINDOW_HOST_LABEL
    return none

fn isWindowHostResponsibleForMode(args: Any) -> Bool:
    return (args.hostRole == resolvePresentationHostLabel(none))

fn shouldRegisterGlobalShortcutForHost(hostRole: WindowHostRole) -> Bool:
    return (hostRole != DOCK_WINDOW_HOST_LABEL)

fn emitWindowEventToHost(label: Any, eventName: String, payload: TPayload) -> Any:
    if ((!isTauri())):
        return false
    let target: Any = (await WebviewWindow.getByLabel(label))
    if ((!target)):
        return false
    (await target.emit_(eventName, payload))
    return true

