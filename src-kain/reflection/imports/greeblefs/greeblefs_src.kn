fn createExplorerFile(parentPath: String, name: String, content: ExplorerWritableContent) -> Any:
    let content: Any = content
    let payload: Any = toWritablePayload(content)
    if ((getExplorerPathSourceKind(parentPath) == "cloud")):
        unwrapTauriResult((await commands.cloudCreateFile(parentPath, name, payload)))
        return none
    else if ((getExplorerPathSourceKind(parentPath) == "remote")):
        unwrapTauriResult((await commands.remoteCreateFile(parentPath, name, payload)))
        return none
    else if ((getExplorerPathSourceKind(parentPath) == "local")):
        let separator: Any = none
        let normalizedParent: Any = parentPath.replace(none, "")
        let nextPath: Any = none
        unwrapTauriResult((await commands.fsWriteFile(nextPath, payload)))
        return none
    else:
        ()

fn transferExplorerItems(targetDir: String, sources: [String], operation: ExplorerFileTransferOperation, collisionPolicy: ExplorerFileTransferCollisionPolicy) -> Any:
    let collisionPolicy: Any = collisionPolicy
    let sourceKinds: Any = ts_Set(sources.map(none))
    let targetKind: Any = getExplorerPathSourceKind(targetDir)
    let involvesCloud: Any = ((targetKind == "cloud") or sourceKinds.has("cloud"))
    let involvesRemote: Any = ((targetKind == "remote") or sourceKinds.has("remote"))
    if ((((((targetKind != "local") and (targetKind != "cloud")) and (targetKind != "remote"))) or [sourceKinds].some(none))):
        ()
    if ((involvesCloud or involvesRemote)):
        if ((collisionPolicy != "keep_both")):
            ()
    if ((involvesCloud and involvesRemote)):
        ()
    if (involvesCloud):
        return unwrapTauriResult((await commands.cloudTransferItems(targetDir, sources, operation)))
    if (involvesRemote):
        return unwrapTauriResult((await commands.remoteTransferItems(targetDir, sources, operation)))
    return callExplorerNativeControlWithFallback("explorerFileOperationControls", "transferItems", none, none)

fn planExplorerItemTransfer(targetDir: String, sources: [String], operation: ExplorerFileTransferOperation) -> Any:
    if (((getExplorerPathSourceKind(targetDir) != "local") or sources.some(none))):
        return []
    return callExplorerNativeControlWithFallback("explorerFileOperationControls", "planTransferItems", none, none)

