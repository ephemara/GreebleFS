const overlayId: Any = "overlayterm-global-error-panel"

const currentRecord: Any = none

fn ensureHost() -> Any:
    let existing: Any = document.getElementById(overlayId)
    if (ts_instanceof_operator(existing, HTMLDivElement)):
        return existing
    let host: Any = document.createElement("div")
    host.id = overlayId
    host.style.position = "fixed"
    host.style.top = "16px"
    host.style.right = "16px"
    host.style.zIndex = "2147483647"
    host.style.width = "min(680px, calc(100vw - 32px))"
    host.style.maxHeight = "min(72vh, 760px)"
    host.style.pointerEvents = "none"
    host.style.display = "flex"
    host.style.justifyContent = "flex-end"
    host.style.alignItems = "flex-start"
    document.body.appendChild(host)
    return host

fn createButton(label: String) -> HTMLButtonElement:
    let button: Any = document.createElement("button")
    button.type_ = "button"
    button.textContent = label
    button.style.border = "1px solid rgba(255,255,255,0.12)"
    button.style.background = "rgba(255,255,255,0.06)"
    button.style.color = "#f9dcdc"
    button.style.fontSize = "11px"
    button.style.fontWeight = "700"
    button.style.letterSpacing = "0.08em"
    button.style.textTransform = "uppercase"
    button.style.padding = "6px 10px"
    button.style.borderRadius = "999px"
    button.style.cursor = "pointer"
    return button

fn renderPanel(host: HTMLDivElement, record: GlobalErrorPanelRecord) -> ():
    host.innerHTML = ""
    let panel: Any = document.createElement("section")
    panel.style.pointerEvents = "auto"
    panel.style.display = "flex"
    panel.style.flexDirection = "column"
    panel.style.gap = "12px"
    panel.style.width = "100%"
    panel.style.maxHeight = "100%"
    panel.style.padding = "16px"
    panel.style.borderRadius = "18px"
    panel.style.border = "1px solid rgba(255, 120, 120, 0.35)"
    panel.style.background = "rgba(26, 8, 10, 0.94)"
    panel.style.color = "#ffe7e7"
    panel.style.boxShadow = "0 24px 80px rgba(0, 0, 0, 0.45)"
    panel.style.backdropFilter = "blur(18px)"
    panel.style.setProperty("-webkit-backdrop-filter", "blur(18px)")
    let header: Any = document.createElement("div")
    header.style.display = "flex"
    header.style.alignItems = "flex-start"
    header.style.justifyContent = "space-between"
    header.style.gap = "12px"
    let titleWrap: Any = document.createElement("div")
    titleWrap.style.display = "flex"
    titleWrap.style.flexDirection = "column"
    titleWrap.style.gap = "6px"
    titleWrap.style.minWidth = "0"
    let title: Any = document.createElement("div")
    title.textContent = record.title
    title.style.fontSize = "14px"
    title.style.fontWeight = "700"
    let meta: Any = document.createElement("div")
    meta.textContent = none
    meta.style.fontSize = "11px"
    meta.style.letterSpacing = "0.06em"
    meta.style.textTransform = "uppercase"
    meta.style.color = "rgba(255, 231, 231, 0.68)"
    titleWrap.appendChild(title)
    titleWrap.appendChild(meta)
    let actions: Any = document.createElement("div")
    actions.style.display = "flex"
    actions.style.alignItems = "center"
    actions.style.gap = "8px"
    actions.style.flexShrink = "0"
    let copyButton: Any = createButton("Copy")
    copyButton.onclick = none
    let reloadButton: Any = createButton("Reload")
    reloadButton.onclick = none
    let closeButton: Any = createButton("Dismiss")
    closeButton.onclick = none
    actions.appendChild(copyButton)
    actions.appendChild(reloadButton)
    actions.appendChild(closeButton)
    header.appendChild(titleWrap)
    header.appendChild(actions)
    let detail: Any = document.createElement("pre")
    detail.textContent = record.detail
    detail.style.margin = "0"
    detail.style.padding = "14px"
    detail.style.overflow = "auto"
    detail.style.maxHeight = "min(48vh, 540px)"
    detail.style.whiteSpace = "pre-wrap"
    detail.style.wordBreak = "break-word"
    detail.style.fontFamily = "Consolas, 'Courier New', monospace"
    detail.style.fontSize = "12px"
    detail.style.lineHeight = "1.55"
    detail.style.color = "#f9dcdc"
    detail.style.background = "rgba(255,255,255,0.03)"
    detail.style.border = "1px solid rgba(255,255,255,0.08)"
    detail.style.borderRadius = "12px"
    panel.appendChild(header)
    panel.appendChild(detail)
    host.appendChild(panel)

fn formatTimestamp(date: Date) -> String:
    return date.toLocaleTimeString([], none)

fn formatObjectDetail(value: Any) -> Any:
    let segments: [String] = []
    let message: Any = none
    let filename: Any = none
    let lineno: Any = none
    let colno: Any = none
    if (message):
        segments.push(message)
    if (filename):
        let locationSuffix: Any = none
        segments.push("@" + filename + locationSuffix)
    if ((segments.length > 0)):
        return segments.join(none)

fn formatGlobalErrorDetail(value: Any) -> Any:
    if (ts_instanceof_operator(value, Error)):
        return (value.stack or value.name + ": " + value.message)
    if ((value == "string")):
        return value
    if ((value and (value == "object"))):
        return formatObjectDetail(value)
    return ts_String(value)

fn reportGlobalError(title: String, detail: String) -> ():
    let normalizedDetail: Any = (detail.trim() or "Unknown error.")
    let nextRecord: Any = none
    currentRecord = nextRecord
    renderPanel(ensureHost(), nextRecord)

fn resetGlobalErrorPanel() -> ():
    currentRecord = none
    document.getElementById(overlayId).remove()

