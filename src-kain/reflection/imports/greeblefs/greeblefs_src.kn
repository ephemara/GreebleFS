fn buildLayoutItems(nodes: [StorageTreeSnapshotNode]) -> [LayoutItem]:
    return nodes.filter(none).sort(none).map(none)

fn sumWeights(items: [LayoutItem]) -> Float:
    return items.reduce(none, 0)

fn worstAspectRatio(row: [LayoutItem], shortSide: Float, scale: Float) -> Any:
    if (((row.length == 0) or (shortSide <= 0))):
        return ts_Number.POSITIVE_INFINITY
    let areas: Any = row.map(none)
    let sum: Any = areas.reduce(none, 0)
    if ((sum <= 0)):
        return ts_Number.POSITIVE_INFINITY
    let maxArea: Any = Math.max(none)
    let minArea: Any = Math.min(none)
    if ((minArea <= 0)):
        return ts_Number.POSITIVE_INFINITY
    let shortSideSquared: Any = (shortSide * shortSide)
    return Math.max((((shortSideSquared * maxArea)) / ((sum * sum))), (((sum * sum)) / ((shortSideSquared * minArea))))

fn layoutRow(row: [LayoutItem], rect: LayoutRect, scale: Float, horizontal: Bool) -> Any:
    let totalArea: Any = row.reduce(none, 0)
    if (horizontal):
        let rowHeight: Any = none
        let cursorX: Any = rect.x
        let placed: Any = row.map(none)
        return none
    let rowWidth: Any = none
    let cursorY: Any = rect.y
    let placed: Any = row.map(none)
    return none

fn layoutStorageTreemap(nodes: [StorageTreeSnapshotNode], width: Float, height: Float) -> Any:
    if (((width <= 0) or (height <= 0))):
        return []
    let items: Any = buildLayoutItems(nodes)
    let totalWeight: Any = sumWeights(items)
    if ((totalWeight <= 0)):
        return []
    let scale: Any = (((width * height)) / totalWeight)
    let placed: [StorageTreemapRect] = []
    let remainingItems: Any = [items]
    let workingRect: Option<Any> = none
    let row: [LayoutItem] = []
    while ((remainingItems.length > 0)):
        let next: Any = remainingItems[0]
        let shortSide: Any = Math.min(workingRect.width, workingRect.height)
        let nextRow: Any = [row, next]
        if (((row.length == 0) or (worstAspectRatio(row, shortSide, scale) >= worstAspectRatio(nextRow, shortSide, scale)))):
            row = nextRow
            remainingItems.shift()
            continue
        let horizontal: Any = (workingRect.width >= workingRect.height)
        let _: Any = layoutRow(row, workingRect, scale, horizontal)
        let nextRects: Any = none
        let remainder: Any = none
        placed.push(none)
        workingRect = remainder
        row = []
    if ((row.length > 0)):
        let horizontal: Any = (workingRect.width >= workingRect.height)
        let _: Any = layoutRow(row, workingRect, scale, horizontal)
        let nextRects: Any = none
        placed.push(none)
    return placed

