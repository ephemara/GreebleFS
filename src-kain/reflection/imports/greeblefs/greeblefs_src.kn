fn getActionEntries(invocation: ExplorerMenuInvocationContext) -> Any:
    if ((invocation.kind == "background")):
        return []
    if ((invocation.kind == "multi-select")):
        return invocation.selectedEntries
    if (invocation.primaryEntry):
        if (((invocation.selectedEntries.length > 1) and invocation.selectedEntries.some(none))):
            return invocation.selectedEntries
        return [invocation.primaryEntry]
    if (invocation.previewTarget):
        return [invocation.previewTarget]
    return invocation.selectedEntries

fn isCommandApplicableToSelection(command: ExplorerCommandDefinition, targetEntries: [ExplorerMenuInvocationEntry]) -> Any:
    if ((command.appliesTo == "any")):
        return true
    if ((targetEntries.length == 0)):
        return false
    if ((command.appliesTo == "file")):
        return targetEntries.every(none)
    return targetEntries.every(none)

fn resolveCurrentPathEntry(environment: ExplorerMenuRuntimeEnvironment) -> Any:
    let segments: Any = environment.currentPath.split(none).filter(ts_Boolean)
    let name: Any = (segments[(segments.length - 1)] or environment.currentPath)
    let parentPath: Any = environment.currentPath.replace(none, "")
    return none

fn createDisabledResolverNode(id: String, label: String, description: Any, command: ExplorerCommandDefinition, depth: Float) -> Any:
    return none

fn resolveOpenWithProgramLaunchId(program: ExplorerAssociatedProgram) -> String:
    return ((program.launchId.trim() or program.path)).trim()

fn resolveOpenWithProgramDedupeKey(program: ExplorerAssociatedProgram) -> String:
    return [(program.launchKind or "path"), resolveOpenWithProgramLaunchId(program), (program.executablePath or ""), program.name].join(none).toLowerCase()

fn createOpenWithProgramNode(command: ExplorerCommandDefinition, entryPath: String, program: ExplorerAssociatedProgram, depth: Float, environment: ExplorerMenuRuntimeEnvironment, labelOverride: String, descriptionOverride: String) -> Any:
    let launchId: Any = resolveOpenWithProgramLaunchId(program)
    return none

fn dedupeOpenWithPrograms(programs: [ExplorerAssociatedProgram], seenProgramKeys: Set<String>) -> [ExplorerAssociatedProgram]:
    let deduped: [ExplorerAssociatedProgram] = []
    for program in programs:
        let programKey: Any = resolveOpenWithProgramDedupeKey(program)
        if (seenProgramKeys.has(programKey)):
            continue
        seenProgramKeys.add(programKey)
        deduped.push(program)
    return deduped

fn buildExplorerWindowsShellContextMenuRequestKey(request: ExplorerShellContextMenuRequest) -> String:
    return [request.targetKind, request.currentDirectoryPath, request.targetPaths].join(none)

fn canResolveWindowsShellContextMenuPath(path: String, environment: ExplorerMenuRuntimeEnvironment) -> Bool:
    return ((((ts_Boolean(path) and environment.supportsNativeIntegration(path)) and (!environment.isCloudExplorerPath(path))) and (!environment.isExplorerArchiveVirtualPath(path))))

fn resolveWindowsShellContextMenuCurrentDirectory(targetEntries: [ExplorerMenuInvocationEntry], environment: ExplorerMenuRuntimeEnvironment) -> Any:
    let firstParentPath: Any = (targetEntries[0].parentPath.trim() or "")
    if ((firstParentPath and targetEntries.every(none))):
        return firstParentPath
    return environment.currentPath

fn resolveExplorerWindowsShellContextMenuRequest(invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment) -> Any:
    if ((environment.runtimePlatform != "windows")):
        return none
    if ((invocation.kind == "background")):
        if ((!canResolveWindowsShellContextMenuPath(environment.currentPath, environment))):
            return none
        let request: Option<Any> = none
        return none
    let shellTargetEntries: Any = none
    if ((shellTargetEntries.length == 0)):
        return none
    if (shellTargetEntries.some(none)):
        return none
    let targetKind: Any = none
    let request: Option<Any> = none
    return none

fn resolveExplorerWindowsShellContextMenuRequestForInvocation(invocation: ExplorerMenuInvocationContext, environment: ExplorerMenuRuntimeEnvironment) -> Any:
    let targetEntries: Any = getActionEntries(invocation)
    let primaryEntry: Any = getPrimaryActionEntry(invocation, environment, targetEntries)
    return resolveExplorerWindowsShellContextMenuRequest(invocation, targetEntries, primaryEntry, environment)

fn getPrimaryActionEntry(invocation: ExplorerMenuInvocationContext, environment: ExplorerMenuRuntimeEnvironment, targetEntries: [ExplorerMenuInvocationEntry]) -> Any:
    if ((targetEntries.length > 0)):
        return targetEntries[0]
    if (invocation.primaryEntry):
        return invocation.primaryEntry
    if (invocation.previewTarget):
        return invocation.previewTarget
    if ((invocation.kind == "background")):
        return resolveCurrentPathEntry(environment)
    return none

fn sanitizeNodeList(nodes: [ExplorerRuntimeMenuNode]) -> [ExplorerRuntimeMenuNode]:
    let filtered: Any = nodes.filter(none)
    let trimmedLeading: Any = [filtered]
    while ((trimmedLeading[0].kind == "separator")):
        trimmedLeading.shift()
    while ((trimmedLeading[(trimmedLeading.length - 1)].kind == "separator")):
        trimmedLeading.pop()
    return trimmedLeading.filter(none)

fn resolvePresentationRenderer(menuPack: LoadedExplorerMenuPack, invocation: ExplorerMenuInvocationContext, layout: ExplorerMenuContextLayout, themeRendererPreference: ExplorerMenuRendererKind, themePresentationPreference: OverlayContextMenuPresentationOptions) -> Any:
    let presentation: Any = menuPack.presentation
    let themePresentation: Any = (themePresentationPreference or none)
    let capabilityRules: Any = (presentation.capabilityRules or [])
    let matchingRule: Any = capabilityRules.find(none)
    return none

fn createDynamicAudioCommands(invocation: ExplorerMenuInvocationContext, environment: ExplorerMenuRuntimeEnvironment) -> Any:
    let targetEntries: Any = getActionEntries(invocation)
    if ((!environment.canRunAudioBatch(targetEntries))):
        return []
    let shared_: Any = none
    return [none, none]

fn createPreviewContextMenuCommands(invocation: ExplorerMenuInvocationContext, registration: Any) -> Any:
    if ((((invocation.kind != "preview-pane") or (!invocation.previewContext)) or (!registration))):
        return []
    if ((registration.previewKind != invocation.previewContext.previewKind)):
        return []
    return resolveExplorerPreviewContextMenuActions(registration, invocation.previewContext.workflowTabId).map(none)

fn matchesActionSelectionRules(command: ExplorerResolvedActionContextMenuContribution, targetEntries: [ExplorerMenuInvocationEntry]) -> Any:
    let _: Any = command.execution.action
    let selection: Any = none
    let count: Any = targetEntries.length
    if (((selection.minCount != none) and (count < selection.minCount))):
        return false
    if (((selection.maxCount != none) and (count > selection.maxCount))):
        return false
    if ((count == 0)):
        return ((selection.minCount == none) or (selection.minCount == 0))
