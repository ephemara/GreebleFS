type OklabColor = Any

fn srgbChannelToLinear(component_: Float) -> Any:
    let normalized: Any = (component_ / 255)
    return none

fn resolveOklabColorFromRgb(red: Float, green: Float, blue: Float) -> Any:
    let linearRed: Any = srgbChannelToLinear(red)
    let linearGreen: Any = srgbChannelToLinear(green)
    let linearBlue: Any = srgbChannelToLinear(blue)
    let l: Any = (((0.4122214708 * linearRed) + (0.5363325363 * linearGreen)) + (0.0514459929 * linearBlue))
    let m: Any = (((0.2119034982 * linearRed) + (0.6806995451 * linearGreen)) + (0.1073969566 * linearBlue))
    let s: Any = (((0.0883024619 * linearRed) + (0.2817188376 * linearGreen)) + (0.6299787005 * linearBlue))
    let lRoot: Any = Math.cbrt(l)
    let mRoot: Any = Math.cbrt(m)
    let sRoot: Any = Math.cbrt(s)
    return none

fn resolvePixelOklabColor(pixels: ExplorerImageCutoutSourcePixels, x: Float, y: Float) -> OklabColor:
    let offset: Any = sourceOffset(pixels.width, x, y)
    return resolveOklabColorFromRgb((pixels.data[offset] or 0), (pixels.data[(offset + 1)] or 0), (pixels.data[(offset + 2)] or 0))

fn colorDistanceSquared(left: OklabColor, right: OklabColor) -> Float:
    let deltaL: Any = (left.l - right.l)
    let deltaA: Any = (left.a - right.a)
    let deltaB: Any = (left.b - right.b)
    return (((deltaL * deltaL) + (deltaA * deltaA)) + (deltaB * deltaB))

fn colorDistanceSquaredToPixel(pixels: ExplorerImageCutoutSourcePixels, x: Float, y: Float, color: OklabColor) -> Float:
    return colorDistanceSquared(resolvePixelOklabColor(pixels, x, y), color)

