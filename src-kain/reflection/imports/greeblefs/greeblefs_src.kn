    ADAPTIVE_SEMANTIC_DENSITY_STEP = none
    DEFAULT_ADAPTIVE_SEMANTIC_DENSITY = none
    adaptiveSemanticDensityStops = none
    explorerExperimentalModes = none
    constellationDensityDescriptors = none
    timelineDensityDescriptors = none
    explorerExperimentalModeMap = ts_Map(explorerExperimentalModes.map(none))
    adaptiveDensityStopMap = ts_Map(adaptiveSemanticDensityStops.map(none))

fn normalizeExplorerExperimentalViewMode(value: Any) -> Any:
    if ((value == "off")):
        return "off"
    return none

fn normalizeAdaptiveSemanticDensity(value: Any) -> Any:
    if (((value == "number") and ts_Number.isFinite(value))):
        return clamp(value, 0, 1)
    return DEFAULT_ADAPTIVE_SEMANTIC_DENSITY

fn getExplorerExperimentalModeDefinition(mode: Any) -> ExplorerExperimentalModeDefinition:
    return ((explorerExperimentalModeMap.get(mode) or explorerExperimentalModeMap.get("adaptive-semantic-grid")))

fn getAdaptiveSemanticDensityStopId(density: Float) -> AdaptiveSemanticDensityStopId:
    let normalizedDensity: Any = normalizeAdaptiveSemanticDensity(density)
    let closest: Any = adaptiveSemanticDensityStops[0]
    let closestDistance: Any = Math.abs((normalizedDensity - closest.density))
    for stop in adaptiveSemanticDensityStops.slice(1):
        let distance: Any = Math.abs((normalizedDensity - stop.density))
        if ((distance < closestDistance)):
            closest = stop
            closestDistance = distance
    return closest.id

fn getAdaptiveSemanticDensityStop(density: Float) -> AdaptiveSemanticDensityStopDefinition:
    return ((adaptiveDensityStopMap.get(getAdaptiveSemanticDensityStopId(density)) or adaptiveSemanticDensityStops[2]))

fn getAdaptiveSemanticDensityPercent(density: Float) -> Float:
    return Math.round((normalizeAdaptiveSemanticDensity(density) * 100))

fn getExplorerExperimentalDensityDescriptor(mode: Any, density: Float) -> Any:
    if ((mode == "adaptive-semantic-grid")):
        return getAdaptiveSemanticDensityStop(density)
    let stopId: Any = getAdaptiveSemanticDensityStopId(density)
    let stopIndex: Any = adaptiveSemanticDensityStops.findIndex(none)
    let descriptorIndex: Any = none
    let descriptorSet: Any = none
    return (descriptorSet[descriptorIndex] or descriptorSet[2])

fn stepAdaptiveSemanticDensity(currentDensity: Float, direction: String) -> Any:
    let currentStopId: Any = getAdaptiveSemanticDensityStopId(currentDensity)
    let currentIndex: Any = adaptiveSemanticDensityStops.findIndex(none)
    if ((currentIndex < 0)):
        return DEFAULT_ADAPTIVE_SEMANTIC_DENSITY
    let nextIndex: Any = none
    return adaptiveSemanticDensityStops[nextIndex].density

fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(max, Math.max(min, value))

