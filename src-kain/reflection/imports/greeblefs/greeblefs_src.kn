    let trackSize: Any = none
    let viewportSize: Any = none
    let scrollSize: Any = none
    let scrollOffset: Any = none
    let maxScrollOffset: Any = Math.max(0, (scrollSize - viewportSize))
    let minimumThumbSize: Any = resolveMinimumThumbSize(none)
