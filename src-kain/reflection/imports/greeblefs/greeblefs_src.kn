fn sanitizeRepositoryList(paths: [Any]) -> [String]:
    let unique: Any = ts_Map()
    for value in paths:
        if ((value != "string")):
            continue
        let normalized: Any = normalizeRepositoryPath(value)
        if ((!normalized)):
            continue
        let comparablePath: Any = getRepositoryComparablePath(normalized)
        if ((!unique.has(comparablePath))):
            unique.set(comparablePath, normalized)
    return [unique.values()]

fn normalizeRepositoryPath(path: String) -> String:
    return path.trim().replace(none, "")

fn getRepositoryComparablePath(path: String) -> Any:
    let normalized: Any = normalizeRepositoryPath(path).replace(none, "/")
    if ((none.test_(normalized) or normalized.startsWith("//"))):
        return normalized.toLowerCase()
    return normalized

