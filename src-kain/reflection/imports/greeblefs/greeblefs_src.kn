fn asStringArray(value: Any) -> Any:
    if ((!ts_Array.isArray(value))):
        return []
    return value.filter(none).map(none).filter(ts_Boolean)

fn normalizeRelativeRuntimeModulePath(path: String) -> Any:
    let normalizedPath: Any = path.trim().replace(none, "/")
    if ((((!normalizedPath) or normalizedPath.startsWith("/")) or none.test_(normalizedPath))):
        return none
    let segments: [String] = []
    for segment in normalizedPath.split("/"):
        if (((!segment) or (segment == "."))):
            continue
        if ((segment == "..")):
            if ((segments.length == 0)):
                return none
            segments.pop()
            continue
        segments.push(segment)
    return segments.join("/")

fn normalizeComparisonPath(path: String) -> String:
    return path.replace(none, "/").replace(none, "/").replace(none, "")

fn getPackageRelativePath(directoryPath: String, filePath: String) -> Any:
    let normalizedDirectoryPath: Any = normalizeComparisonPath(directoryPath)
    let normalizedFilePath: Any = normalizeComparisonPath(filePath)
    if (((!normalizedDirectoryPath) or (!normalizedFilePath))):
        return none
    if ((normalizedFilePath == normalizedDirectoryPath)):
        return ""
    if ((!normalizedFilePath.startsWith(normalizedDirectoryPath + "/"))):
        return none
    return normalizedFilePath.slice((normalizedDirectoryPath.length + 1))

fn resolvePackageRuntimeModuleImportPath(fromModuleRelativePath: String, specifier: String) -> Any:
    let importerSegments: Any = fromModuleRelativePath.replace(none, "/").split("/").filter(ts_Boolean)
    importerSegments.pop()
    let specifierSegments: Any = specifier.replace(none, "/").split("/")
    return normalizeRelativeRuntimeModulePath([importerSegments, specifierSegments].join("/"))

fn buildRuntimeModuleCandidates(relativePath: String) -> Any:
    let normalizedRelativePath: Any = normalizeRelativeRuntimeModulePath(relativePath)
    if ((!normalizedRelativePath)):
        return []
    let candidates: Any = ts_Set()
    if (none.test_(normalizedRelativePath)):
        candidates.add(normalizedRelativePath)
    else:
        for extension in explorerViewRuntimeModuleExtensions:
            candidates.add(normalizedRelativePath + "." + extension)
            candidates.add(normalizedRelativePath + "/index." + extension)
    return [candidates]

fn createExplorerViewRelativeModuleSourceResolver(directoryPath: String) -> Any:
    return none

fn resolveRelativeRuntimeFileEntry(directoryPath: String, relativePath: String) -> Any:
    let normalizedRelativePath: Any = normalizeRelativeRuntimeModulePath(relativePath)
    if ((!normalizedRelativePath)):
        return none
    for candidateRelativePath in buildRuntimeModuleCandidates(normalizedRelativePath):
        let candidateAbsolutePath: Any = joinPlatformPath(directoryPath, candidateRelativePath)
    return none

fn deriveExplorerViewPackId(record: Any) -> String:
    return ((((asString(record.manifest.explorerView.id) or asString(record.manifest.id)) or record.packageId.trim().toLowerCase().replace("/[^a-z0-9]+/g", "-").replace("/^-+|-+$/g", "")) or "explorer-view"))

fn deriveExplorerViewPackTitle(record: Any, packId: String) -> String:
    return (((asString(record.manifest.explorerView.title) or asString(record.manifest.name)) or packId.replace("/-/g", " ").replace(none, none)))

fn normalizeExplorerViewManifestValue(value: Any, filePath: String) -> Any:
    let source: Any = asRecord(value)
    if ((!source)):
        ()
    let explorerViewSource: Any = asRecord(source.explorerView)
    return none

fn loadExplorerViewFromManifestRecord(manifestRecord: ManagedContentStackManifestRecord<ExplorerViewPackManifest>) -> Any:
    let warnings: [String] = []
    let packId: Any = deriveExplorerViewPackId(manifestRecord)
    let title: Any = deriveExplorerViewPackTitle(manifestRecord, packId)
    let explorerViewManifest: Any = (manifestRecord.manifest.explorerView or none)
    let descriptorDefaults: Option<Any> = none
    if ((descriptorDefaults.rendererKind == "wasm-panel")):
        let runtimeId: Any = (descriptorDefaults.runtimeSurfaceId or descriptorDefaults.runtimeId)
        if ((!runtimeId)):
            warnings.push("Explorer view " + title + ": wasm-panel views require runtimeSurfaceId, runtimeSurfaceRef, runtimeId, or runtimeRef")
            return none
        let descriptor: Any = normalizeExplorerViewDescriptor(none, none)
        return none
    let rendererEntryPath: Any = ((explorerViewManifest.rendererEntry or explorerViewManifest.renderer) or "")
    if ((!rendererEntryPath)):
        warnings.push("Explorer view " + title + ": missing renderer entry path")
        return none
    let rendererEntry: Any = (await resolveRelativeRuntimeFileEntry(manifestRecord.packageDirectory, rendererEntryPath))
    if ((!rendererEntry)):
        warnings.push("Explorer view " + title + ": renderer " + rendererEntryPath + " could not be resolved")
        return none
    let source: Any = (await commands.fsReadTextFile(rendererEntry.path).then(unwrapTauriResult))
    let loadOptions: Option<Any> = none
    let loadedModule: LoadedExplorerViewModule = (await loadExplorerViewFromSource(source, rendererEntry, loadOptions))
    return none

fn discoverManagedExplorerViews() -> Any:
    if ((!isTauri())):
        return none
    let manifestResult: Any = (await loadManagedContentManifestsFromDirectoryStack(none))
    let normalizedManifestRecords: Any = manifestResult.packages.map(none)
    let loadedViews: Any = (await ts_Promise.all(normalizedManifestRecords.map(none)))
    return none

const EXPLORER_HOME_PATH: Any = "greeblefs://home"

const EXPLORER_VIRTUAL_SCHEME: Any = "greeblefs://"

fn normalizeExplorerVirtualPath(path: String) -> Any:
    let trimmedPath: Any = path.trim()
    if ((!trimmedPath)):
        return trimmedPath
    if ((!trimmedPath.toLowerCase().startsWith(EXPLORER_VIRTUAL_SCHEME))):
        return trimmedPath
    let _: Any = trimmedPath.split("?")
    let schemeAndPath: Any = none
    let queryParts: Any = none
    let normalizedBase: Any = schemeAndPath.replace(none, "").toLowerCase()
    return none

fn isExplorerVirtualPath(path: String) -> Bool:
    return normalizeExplorerVirtualPath(path).startsWith(EXPLORER_VIRTUAL_SCHEME)

fn isExplorerHomePath(path: String) -> Bool:
    return (normalizeExplorerVirtualPath(path) == EXPLORER_HOME_PATH)

fn isExplorerTrackableFolderPath(path: String) -> Bool:
    let trimmedPath: Any = path.trim()
    return (((trimmedPath.length > 0) and (!trimmedPath.startsWith("cloud://"))) and (!isExplorerVirtualPath(trimmedPath)))

