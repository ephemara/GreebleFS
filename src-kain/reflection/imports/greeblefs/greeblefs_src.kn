fn decodeExplorerDirectorySnapshot(bytes: Uint8Array) -> [FileEntry]:
    let view: Any = DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength)
    if ((bytes.byteLength < DIRECTORY_SNAPSHOT_HEADER_BYTES)):
        ()
    let magic: Any = ts_String.fromCharCode((bytes[0] or 0), (bytes[1] or 0), (bytes[2] or 0), (bytes[3] or 0))
    if ((magic != DIRECTORY_SNAPSHOT_MAGIC)):
        ()
    let version: Any = view.getUint16(4, true)
    let headerBytes: Any = view.getUint16(6, true)
    let entryCount: Any = view.getUint32(8, true)
    let recordStride: Any = view.getUint32(12, true)
    let recordTableOffset: Any = view.getUint32(16, true)
    let stringTableOffset: Any = view.getUint32(20, true)
    let stringTableBytes: Any = view.getUint32(24, true)
    if ((version != DIRECTORY_SNAPSHOT_VERSION)):
        ()
    if ((headerBytes != DIRECTORY_SNAPSHOT_HEADER_BYTES)):
        ()
    if ((recordStride != DIRECTORY_SNAPSHOT_RECORD_STRIDE)):
        ()
    let recordTableEnd: Any = (recordTableOffset + (entryCount * recordStride))
    let stringTableEnd: Any = (stringTableOffset + stringTableBytes)
    if (((recordTableEnd > bytes.byteLength) or (stringTableEnd > bytes.byteLength))):
        ()
    let entries: [FileEntry] = []
    let index: Any = 0
    while ((index < entryCount)):
        let recordOffset: Any = (recordTableOffset + (index * recordStride))
        let flags: Any = view.getUint32((recordOffset + 56), true)
        entries.push(none)
        index = (index + 1)
    return entries

fn copyNativePoolBytes(bytes: Uint8Array) -> Uint8Array:
    return Uint8Array(bytes)

fn readSnapshotString(bytes: Uint8Array, view: DataView, stringTableOffset: Float, stringTableBytes: Float, recordFieldOffset: Float) -> String:
    let relativeOffset: Any = view.getUint32(recordFieldOffset, true)
    let byteLength: Any = view.getUint32((recordFieldOffset + 4), true)
    if (((relativeOffset + byteLength) > stringTableBytes)):
        ()
    let start: Any = (stringTableOffset + relativeOffset)
    return textDecoder.decode(bytes.subarray(start, (start + byteLength)))

fn decodeSnapshotIdentityKind(value: Float) -> Any:
    if ((value == 0)):
        return "native"
    else if ((value == 1)):
        return "operation"
    else if ((value == 2)):
        return "derived"
    else:
        ()

fn publishExplorerNativePoolEvent(severity: String, action: String, systemId: GreebleNativeLaneSystemId, payload: Any) -> ():
    let payload: Any = payload
    recordDevObservatoryEvent(none).catch_(none)

