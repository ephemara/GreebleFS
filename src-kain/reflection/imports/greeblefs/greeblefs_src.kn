    let folderClickMode: Any = arg_2.folderClickMode
    if ((!isDirectory)):
        return false
    if (isDropTarget):
        return true
    return (((folderClickMode == "double") and isSelected) and isOpenPrimed)

fn shouldNavigateUpOnEmptyExplorerDoubleClick(arg_3: Any) -> Any:
    let enabled: Any = arg_3.enabled
    let target: Any = arg_3.target
    let currentTarget: Any = arg_3.currentTarget
    if ((!enabled)):
        return false
    if ((!(ts_instanceof_operator(currentTarget, HTMLElement)))):
        return false
    if (((!(ts_instanceof_operator(target, Node))) or (!currentTarget.contains(target)))):
        return false
    if ((!(ts_instanceof_operator(target, Element)))):
        return true
    let blockedAncestor: Any = target.closest(["[data-entry-path]", none, "button", "input", "textarea", "select", "a", none, none, none, none, "[data-no-empty-double-click]"].join(", "))
    return ((blockedAncestor == none) or (!currentTarget.contains(blockedAncestor)))

