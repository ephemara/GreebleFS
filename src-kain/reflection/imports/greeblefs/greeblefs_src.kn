impl MockPreviewImage:
    fn src(_self: MockPreviewImage, value: String) -> Any:
        _self.src = value
        if (previewImageMockState.deferredSources.has(value)):
            let pendingLoads: Any = (previewImageMockState.pendingLoads.get(value) or [])
            pendingLoads.push(_self)
            previewImageMockState.pendingLoads.set(value, pendingLoads)
            return none
        queueMicrotask(none)

    fn src(_self: MockPreviewImage) -> String:
        return _self.src


