struct EventEmitter:
    callbacks: Any = none

impl EventEmitter:
    fn on(_self: EventEmitter, event: EventName, fn_: CallbackFunction<T, EventName>) -> Self_:
        if ((!_self.callbacks[event])):
            ()
        _self.callbacks[event].push(fn_)
        return _self

    fn emit_(_self: EventEmitter, event: EventName, args: CallbackType<T, EventName>) -> Self_:
        let args: Any = event
        let callbacks: Any = _self.callbacks[event]
        if (callbacks):
            let iter_0: Any = callbacks
            let index_1: Any = 0
            while ((index_1 < iter_0.length)):
                let callback: Any = iter_0[index_1]
                callback.apply(_self, args)
                index_1 = (index_1 + 1)
        return _self

    fn off(_self: EventEmitter, event: EventName, fn_: CallbackFunction<T, EventName>) -> Self_:
        let callbacks: Any = _self.callbacks[event]
        if (callbacks):
            if (fn_):
                ()
            else:
                _self.callbacks[event]
        return _self

    fn once(_self: EventEmitter, event: EventName, fn_: CallbackFunction<T, EventName>) -> Self_:
        let onceFn: Any = none
        return _self.on(event, onceFn)

    fn removeAllListeners(_self: EventEmitter) -> ():
        _self.callbacks = none


