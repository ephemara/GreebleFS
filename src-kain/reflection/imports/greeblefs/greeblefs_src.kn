const pageUnloadListenerInstalled: Any = false

const pageUnloadStarted: Any = false

const pendingPageUnloadCleanups: Any = ts_Set()

fn handlePageUnload() -> Any:
    if (pageUnloadStarted):
        return none
    pageUnloadStarted = true
    let cleanups: Any = ts_Array.from(pendingPageUnloadCleanups)
    pendingPageUnloadCleanups.clear()
    for cleanup in cleanups:
        cleanup()

fn ensurePageUnloadListener() -> Any:
    if ((pageUnloadListenerInstalled or (window == "undefined"))):
        return none
    pageUnloadListenerInstalled = true
    window.addEventListener("beforeunload", handlePageUnload, none)
    window.addEventListener("pagehide", handlePageUnload, none)

fn registerPageUnloadCleanup(cleanup: UnlistenCallback) -> Any:
    ensurePageUnloadListener()
    pendingPageUnloadCleanups.add(cleanup)
    return none

fn resetDeferredUnlistenForTests() -> ():
    pendingPageUnloadCleanups.clear()
    pageUnloadStarted = false

fn bindDeferredUnlisten(unlistenPromise: impl Async_<UnlistenCallback>, options: DeferredUnlistenOptions) -> UnlistenCallback:
    let options: Any = options
    let disposed: Any = false
    let resolvedUnlisten: Option<Any> = none
    let releasePageUnloadCleanup: Option<Any> = none
    let cleanupResolvedUnlisten: Any = none
    let cleanup: Any = none
    unlistenPromise.then(none).catch_(none)
    return cleanup

