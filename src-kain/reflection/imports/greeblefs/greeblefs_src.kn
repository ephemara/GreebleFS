fn computePanelWindowLayout(args: Any) -> Any:
    let physPad: Any = Math.round((panelWindowGeometry.logicalPadding * args.scaleFactor))
    let availableLogicalWidth: Any = Math.max((Math.round((args.workArea.size.width / args.scaleFactor)) - (panelWindowGeometry.logicalPadding * 2)), panelWindowGeometry.minWidth)
    let availableLogicalHeight: Any = Math.max((Math.round((args.workArea.size.height / args.scaleFactor)) - (panelWindowGeometry.logicalPadding * 2)), panelWindowGeometry.minHeight)
    let restoredSize: Any = normalizePanelWindowStoredSize(none)
    let targetLogicalWidth: Any = restoredSize.width
    let targetLogicalHeight: Any = restoredSize.height
    let healedWidth: Any = none
    let healedHeight: Any = none
    let logicalWidth: Any = Math.max(Math.min((healedWidth or targetLogicalWidth), availableLogicalWidth), Math.min(panelWindowGeometry.minWidth, availableLogicalWidth))
    let logicalHeight: Any = Math.max(Math.min((healedHeight or targetLogicalHeight), availableLogicalHeight), Math.min(panelWindowGeometry.minHeight, availableLogicalHeight))
    let width: Any = Math.round((logicalWidth * args.scaleFactor))
    let height: Any = Math.round((logicalHeight * args.scaleFactor))
    return none

