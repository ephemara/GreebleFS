fn resolvePdfFormDraft(field: ExplorerPdfFormFieldDescriptor, formValuesByFieldId: Any) -> PdfFormValueDraft:
    return (formValuesByFieldId[field.fieldId] or none)

fn getPdfFormFieldLabel(field: ExplorerPdfFormFieldDescriptor) -> String:
    return (field.fieldName.trim() or field.fieldId)

fn validatePdfFormDraft(field: ExplorerPdfFormFieldDescriptor, draft: PdfFormValueDraft, options: Any) -> Any:
    let fieldLabel: Any = getPdfFormFieldLabel(field)
    let enforceRequired: Any = (options.enforceRequired or true)
    if (((field.kind == "dropdown") or (field.kind == "listbox"))):
        let allowedOptionValues: Any = ts_Set(field.options.map(none))
        let normalizedSelections: Any = draft.selectedValues.filter(none)
        if ((draft.stringValue and (!allowedOptionValues.has(draft.stringValue)))):
            return fieldLabel + " must use a supported option."
        if (normalizedSelections.some(none)):
            return fieldLabel + " must use a supported option."
        if (((enforceRequired and field.required) and (normalizedSelections.length == 0))):
            return fieldLabel + " is required."
        return none
    if ((((enforceRequired and field.required) and (((field.kind == "checkbox") or (field.kind == "radio")))) and (draft.boolValue != true))):
        return fieldLabel + " must be selected."
    if ((((enforceRequired and field.required) and (((field.kind == "text") or (field.kind == "multiline")))) and (!((draft.stringValue or "")).trim()))):
        return fieldLabel + " is required."
    return none

fn isEditableElement(target: Any) -> Any:
    let element: Any = none
    if ((!element)):
        return false
    return ((element.isContentEditable or ["INPUT", "TEXTAREA", "SELECT", "OPTION", "BUTTON"].includes(element.tagName)))

fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(Math.max(value, min), max)

fn normalizeRect(startPoint: Any, endPoint: Any) -> Any:
    let x: Any = Math.min(startPoint.x, endPoint.x)
    let y: Any = Math.min(startPoint.y, endPoint.y)
    return none

