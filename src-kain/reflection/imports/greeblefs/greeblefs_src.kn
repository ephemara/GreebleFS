fn normalizeExplorerWorkspaceTabSnapshot(value: Any, index: Float) -> Any:
    let source: Any = asRecord(value)
    if ((!source)):
        return none
    let panes: Any = createEmptyExplorerWorkspacePaneSlots()
    let rawPanes: Any = asRecord(source.panes)
    for paneId in explorerPaneIds:
        ()
    let firstOccupiedPaneId: Any = getFirstOccupiedExplorerPaneId(panes)
    if ((!firstOccupiedPaneId)):
        return none
    let layoutMode: Any = normalizeExplorerWorkspaceLayoutMode(source.layoutMode)
    let visiblePaneIds: Any = getExplorerWorkspaceVisiblePaneIds(layoutMode)
    let focusedPaneCandidate: Any = normalizeExplorerPaneId(source.focusedPane)
    let focusedPane: Any = none
    return none

fn normalizeLegacyExplorerTabSnapshots(rawTabs: [Any], sessions: Any) -> [LegacyExplorerTabSnapshot]:
    let normalizedTabs: Any = rawTabs.map(none).filter(none)
    let dedupedTabs: Any = normalizedTabs.filter(none)
    let missingPrimaryTab: Any = (!dedupedTabs.some(none))
    if ((missingPrimaryTab and sessions[PRIMARY_EXPLORER_INSTANCE_ID])):
        dedupedTabs.unshift(none)
    return dedupedTabs

fn migrateLegacyExplorerWorkspaceSnapshot(source: Any, sessions: Any) -> Any:
    let legacyTabs: Any = normalizeLegacyExplorerTabSnapshots(none, sessions)
    if ((legacyTabs.length == 0)):
        return createDefaultExplorerWorkspace()
    let legacyLayoutMode: Any = normalizeExplorerWorkspaceLayoutMode(source.layoutMode)
    let visiblePaneIds: Any = getExplorerWorkspaceVisiblePaneIds(legacyLayoutMode)
    let activeSource: Any = asRecord(source.activeTabIdByPane)
    let activeTabIdByPane: Any = createEmptyExplorerPaneRecord(none)
    for paneId in explorerPaneIds:
        let paneTabs: Any = legacyTabs.filter(none)
        let activeCandidate: Any = none
        ()
    let activeWorkspacePanes: Any = createEmptyExplorerWorkspacePaneSlots()
    let consumedLegacyTabIds: Any = ts_Set()
    for paneId in visiblePaneIds:
        let activeTabId: Any = activeTabIdByPane[paneId]
        let activeLegacyTab: Any = legacyTabs.find(none)
        if ((!activeLegacyTab)):
            continue
        ()
        consumedLegacyTabIds.add(activeLegacyTab.id)
    if (((!activeWorkspacePanes["pane-1"]) and sessions[PRIMARY_EXPLORER_INSTANCE_ID])):
        ()
    let focusedPaneCandidate: Any = normalizeExplorerPaneId(source.focusedPane)
    let focusedPane: Any = none
    let migratedTabs: [ExplorerWorkspaceTabSnapshot] = [none]
    let remainingLegacyTabs: Any = legacyTabs.filter(none)
    for legacyTab in remainingLegacyTabs:
        migratedTabs.push(none)
    let nextTabOrdinalValue: Any = none
    return none

fn normalizeExplorerWorkspaceSnapshot(value: Any, sessions: Any) -> Any:
    let source: Any = asRecord(value)
    if (((source and ts_Array.isArray(source.tabs)) and source.tabs.some(none))):
        return migrateLegacyExplorerWorkspaceSnapshot(source, sessions)
    let normalizedTabs: Any = (none).map(none).filter(none).filter(none)
    let tabs: Any = none
    let activeWorkspaceTabId: Any = none
    let nextTabOrdinalValue: Any = none
    return none

