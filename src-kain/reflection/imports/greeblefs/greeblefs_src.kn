    let legacyLayout: Any = getExplorerShellLayoutDefinition(normalizedShellLayoutId)
    let legacySourcesVisible: Any = none
    let rawConstellation: Any = asRecord(source.constellation)
    let rawExplorerViewStateById: Any = asRecord(source.explorerViewStateById)
    let pinnedPaths: Any = none
    let leftActivityDockWidth: Any = deriveLegacyLeftActivityDockWidth(source)
    let rightActivityDockWidth: Any = deriveLegacyRightActivityDockWidth(source)
    let previewEnabled: Any = none
    let previewLocked: Any = none
    let previewJumpToFolderEnabled: Any = none
    let legacyActionsVisible: Any = none
    let legacyActiveActivityLane: Any = normalizeExplorerActivityLaneId(source.activeActivityLane)
    let legacyActivityPaneVisible: Any = none
    let activityLanePlacementById: Any = normalizeExplorerActivityLanePlacementById(source.activityLanePlacementById)
    let activityLaneOrderBySide: Any = normalizeExplorerActivityLaneOrderBySide(source.activityLaneOrderBySide, activityLanePlacementById)
    let hiddenActivityLaneIds: Any = normalizeExplorerHiddenActivityLaneIds(source.hiddenActivityLaneIds)
    let openActivityLaneIds: Any = normalizeExplorerOpenActivityLaneIds(source.openActivityLaneIds, none)
    let sourcesVisible: Any = resolveExplorerCompatibilitySourcesVisible(openActivityLaneIds)
    let actionsVisible: Any = resolveExplorerCompatibilityActionsVisible(openActivityLaneIds)
    let activityPaneVisible: Any = resolveExplorerCompatibilityActivityPaneVisible(openActivityLaneIds)
    let activeActivityLane: Any = resolveExplorerCompatibilityActiveActivityLane(openActivityLaneIds, legacyActiveActivityLane)
    let constellationState: Any = none
    let explorerViewStateById: Option<Any> = none
    explorerViewStateById.constellation = none
    return none

