fn buildLegacyLayoutEntriesForContext(contextKind: ExplorerMenuContextKind, overrides: ExplorerContextMenuItemOverrideMap) -> [ExplorerMenuLayoutEntry]:
    let legacyTarget: Any = none
    return sortExplorerContextMenuItems(BUILT_IN_EXPLORER_CONTEXT_MENU_ITEMS.filter(none), overrides).map(none)

fn migrateLegacyContextMenuOverridesToLayouts(overrides: ExplorerContextMenuItemOverrideMap) -> Any:
    let normalizedOverrides: Any = normalizeExplorerContextMenuItemOverrideMap(overrides)
    if ((ts_Object.keys(normalizedOverrides).length == 0)):
        return none
    let entryLayout: Any = buildLegacyLayoutEntriesForContext("entry", normalizedOverrides)
    let backgroundLayout: Any = buildLegacyLayoutEntriesForContext("background", normalizedOverrides)
    let result: Option<Any> = none
    if ((entryLayout.length > 0)):
        result.entry = none
    if ((backgroundLayout.length > 0)):
        result.background = none
    return result

