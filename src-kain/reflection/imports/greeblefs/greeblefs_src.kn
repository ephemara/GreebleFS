                s = (s + (a[((k * 4) + r)] * b[((c * 4) + k)]))
                k = (k + 1)
            ()
            c = (c + 1)
        r = (r + 1)
    return o

fn buildPerspectiveMatrix(aspect: Float, fovRad: Float) -> Any:
    let f: Any = (1 / Math.tan((fovRad / 2)))
    let near: Any = 0.1
    let far: Any = 100
    return Float32Array([(f / aspect), 0, 0, 0, 0, f, 0, 0, 0, 0, (far / ((near - far))), (-1), 0, 0, (((near * far)) / ((near - far))), 0])

fn lookAt(eye: (Float, Float, Float), tgt: (Float, Float, Float)) -> Any:
    let fx: Any = (tgt[0] - eye[0])
    let fy: Any = (tgt[1] - eye[1])
    let fz: Any = (tgt[2] - eye[2])
    let fl: Any = (Math.sqrt((((fx * fx) + (fy * fy)) + (fz * fz))) or 1)
    let f: Any = [(fx / fl), (fy / fl), (fz / fl)]
    let sx: Any = ((f[1] * 0) - (f[2] * 1))
    let sy: Any = ((f[2] * 0) - (f[0] * 0))
    let sz: Any = ((f[0] * 1) - (f[1] * 0))
    let sx2: Any = ((f[1] * 0) - (f[2] * 1))
    let sy2: Any = ((f[2] * 0) - (f[0] * 0))
    let sz2: Any = ((f[0] * 1) - (f[1] * 0))
    let sl: Any = (Math.sqrt((((sx2 * sx2) + (sy2 * sy2)) + (sz2 * sz2))) or 1)
    let s: Any = [(sx2 / sl), (sy2 / sl), (sz2 / sl)]
    let u: Any = [((s[1] * f[2]) - (s[2] * f[1])), ((s[2] * f[0]) - (s[0] * f[2])), ((s[0] * f[1]) - (s[1] * f[0]))]
    return Float32Array([s[0], u[0], (-f[0]), 0, s[1], u[1], (-f[1]), 0, s[2], u[2], (-f[2]), 0, (-((((s[0] * eye[0]) + (s[1] * eye[1])) + (s[2] * eye[2])))), (-((((u[0] * eye[0]) + (u[1] * eye[1])) + (u[2] * eye[2])))), ((((f[0] * eye[0]) + (f[1] * eye[1])) + (f[2] * eye[2]))), 1])

fn orbitCameraEye(cam: OrbitCameraState) -> (Float, Float, Float):
    let cp: Any = Math.cos(cam.pitch)
    let sp: Any = Math.sin(cam.pitch)
    let cy: Any = Math.cos(cam.yaw)
    let sy: Any = Math.sin(cam.yaw)
    return [((cam.distance * cp) * sy), (cam.distance * sp), ((cam.distance * cp) * cy)]

