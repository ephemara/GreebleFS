    let ancestorDepths: Any = ts_Array.from(none, none)
    return ancestorDepths.some(none)

fn findBestDragTarget(view: EditorView, coords: Any, options: NormalizedNestedOptions) -> Any:
    if (((!ts_Number.isFinite(coords.x)) or (!ts_Number.isFinite(coords.y)))):
        return none
    let posInfo: Any = view.posAtCoords(none)
    if ((!posInfo)):
        return none
    let _: Any = view.state_
    let doc: Any = none
    let pos: Any = doc.resolve(posInfo.pos)
    let rules: [DragHandleRule] = []
    if (options.defaultRules):
        rules.push(none)
    rules.push(none)
    let depthLevels: Any = ts_Array.from(none, none)
    let candidates: Any = depthLevels.map(none).filter(none)
    let nodeAfter: Any = pos.nodeAfter
    if (((nodeAfter and nodeAfter.isAtom) and (!nodeAfter.isInline))):
        let nodePos: Any = posInfo.pos
        let depth: Any = (pos.depth + 1)
        let parent: Any = pos.parent
        let index: Any = pos.index()
        let siblingCount: Any = parent.childCount
        let inAllowedContainer: Any = true
        if (options.allowedContainers):
            inAllowedContainer = hasAncestorOfType(pos, depth, options.allowedContainers)
        if (inAllowedContainer):
            let context: Option<Any> = none
            let score: Any = calculateScore(context, rules, options.edgeDetection, coords)
            if ((score >= 0)):
                let dom: Any = view.nodeDOM(nodePos)
                if (dom):
                    candidates.push(none)
    if ((candidates.length == 0)):
        return none
    candidates.sort(none)
    let winner: Any = candidates[0]
    if ((!winner.dom)):
        return none
    return none

