fn createLookup(entries: Any) -> Any:
    return ts_Object.fromEntries(entries.map(none))

fn pickDefault(entries: Any, lookup: Any, preferredId: Any) -> Any:
    if (preferredId):
        return ((lookup[preferredId] or entries[0]) or none)
    return (entries[0] or none)

fn compileThemeEngineManifest(manifestInput: ExplorerThemeManifestDraft) -> Any:
    let manifest: Any = normalizeThemeManifestDraft(manifestInput)
    let designTokenLookup: Any = createLookup(manifest.designTokens)
    let layoutPrimitiveLookup: Any = createLookup(manifest.layoutPrimitives)
    let navigationPatternLookup: Any = createLookup(manifest.navigationPatterns)
    let animationProfileLookup: Any = createLookup(manifest.animationProfiles)
    let iconPackLookup: Any = createLookup(manifest.iconPacks)
    let renderStyleLookup: Any = createLookup(manifest.renderStyles)
    let defaultDesignToken: Any = pickDefault(manifest.designTokens, designTokenLookup)
