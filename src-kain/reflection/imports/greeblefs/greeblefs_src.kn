    return explorerChromeSurfaceDefinitions[surfaceId]

fn getExplorerChromeLayoutDefinition(layoutId: Any) -> ExplorerChromeLayoutDefinition:
    let normalizedId: Any = normalizeExplorerChromeLayoutId(layoutId)
    return ((builtInExplorerChromeLayouts[normalizedId] or builtInExplorerChromeLayouts[defaultExplorerChromeLayoutId]))

fn listBuiltInExplorerChromeControlIds() -> [BuiltInExplorerChromeControlId]:
    let builtInIds: Any = ts_Set()
    for layout in ts_Object.values(builtInExplorerChromeLayouts):
        for controlId in ts_Object.keys(layout.placements):
            builtInIds.add(controlId)
    return ts_Array.from(builtInIds).sort()

fn getSupportedExplorerChromeSurfaces(controlId: ExplorerChromeControlId) -> [ExplorerChromeSurfaceId]:
    let supportedSurfaces: Any = ts_Set()
    let flexibleSupport: Any = (explorerChromeFlexibleSurfaceSupport[controlId] or [])
    for surfaceId in flexibleSupport:
        supportedSurfaces.add(surfaceId)
    for layout in ts_Object.values(builtInExplorerChromeLayouts):
        let placements: Any = layout.placements[controlId]
        if ((!placements)):
            continue
        for surfaceId in ts_Object.keys(placements):
            supportedSurfaces.add(surfaceId)
    return ts_Array.from(supportedSurfaces)

fn normalizeExplorerChromeOverrideSnapshot(value: Any) -> Any:
    let entries: Any = none
    let normalizedEntries: Any = ts_Map()
    for entry in entries:
        let controlId: Any = asTrimmedString(entry.controlId)
        let surfaceId: Any = entry.surfaceId
        let zone: Any = entry.zone
        let order: Any = asFiniteInteger(entry.order)
        let bandId: Any = asTrimmedString(entry.bandId)
        let anchorX: Any = normalizeExplorerChromeAnchorCoordinate(entry.anchorX)
        let anchorY: Any = normalizeExplorerChromeAnchorCoordinate(entry.anchorY)
        let offsetPx: Any = normalizeExplorerChromeOffsetPx(entry.offsetPx)
        let hidden: Any = (asBooleanOrUndefined(entry.hidden) or false)
        let sizeVariant: Any = normalizeExplorerChromeSizeVariant(entry.sizeVariant)
        let widthPx: Any = normalizeExplorerChromeWidthPx(entry.widthPx)
        let showLabel: Any = asBooleanOrUndefined(entry.showLabel)
        let showIcon: Any = asBooleanOrUndefined(entry.showIcon)
        if ((((((!controlId) or (!isExplorerChromeSurfaceId(surfaceId))) or (!isExplorerChromeZoneId(zone))) or (order == none)) or (!isValidZoneForSurface(surfaceId, zone)))):
            continue
        normalizedEntries.set(controlId, none)
    return none

fn normalizeExplorerChromeOverrideSnapshotMap(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    return ts_Object.fromEntries(ts_Object.entries(value).map(none).filter(none))

