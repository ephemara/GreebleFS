fn reconcileExplorerPathValueRecord(args: Any) -> Any:
    let previousEntriesByPath: Any = buildExplorerEntryPathLookup(args.previousEntries)
    let previousEntriesByIdentity: Any = buildExplorerEntryIdentityLookup(args.previousEntries)
    let nextValues: Option<Any> = none
    for nextEntry in args.nextEntries:
        let nextIdentityKey: Any = buildExplorerEntryIdentityRevisionKey(nextEntry)
        let previousSamePathEntry: Any = previousEntriesByPath.get(nextEntry.path)
        if ((previousSamePathEntry and (buildExplorerEntryIdentityRevisionKey(previousSamePathEntry) == nextIdentityKey))):
            let existingValue: Any = args.currentValues[nextEntry.path]
            if ((existingValue != undefined)):
                ()
                continue
        let previousEntry: Any = previousEntriesByIdentity.get(nextIdentityKey)
        if ((!previousEntry)):
            continue
        let movedValue: Any = args.currentValues[previousEntry.path]
        if ((movedValue != undefined)):
            ()
    return nextValues

fn reconcileExplorerPathSet(args: Any) -> Set<String>:
    let previousEntriesByPath: Any = buildExplorerEntryPathLookup(args.previousEntries)
    let previousEntriesByIdentity: Any = buildExplorerEntryIdentityLookup(args.previousEntries)
    let nextPaths: Any = ts_Set()
    for nextEntry in args.nextEntries:
        let nextIdentityKey: Any = buildExplorerEntryIdentityRevisionKey(nextEntry)
        let previousSamePathEntry: Any = previousEntriesByPath.get(nextEntry.path)
        if (((previousSamePathEntry and (buildExplorerEntryIdentityRevisionKey(previousSamePathEntry) == nextIdentityKey)) and args.currentPaths.has(nextEntry.path))):
            nextPaths.add(nextEntry.path)
            continue
        let previousEntry: Any = previousEntriesByIdentity.get(nextIdentityKey)
        if ((previousEntry and args.currentPaths.has(previousEntry.path))):
            nextPaths.add(nextEntry.path)
    return nextPaths

fn reconcileExplorerThumbnailMap(args: Any) -> Any:
    let previousEntriesByPath: Any = buildExplorerEntryPathLookup(args.previousEntries)
    let previousEntriesByIdentity: Any = buildExplorerEntryIdentityLookup(args.previousEntries)
    let nextIdentityKeys: Any = ts_Set(args.nextEntries.map(none))
    let nextThumbnails: Option<Any> = none
    let preservedCount: Any = 0
    let hydratedCount: Any = 0
    let invalidatedCount: Any = 0
    for previousEntry in args.previousEntries:
        if (((args.currentThumbnails[previousEntry.path] != undefined) and (!nextIdentityKeys.has(buildExplorerEntryIdentityRevisionKey(previousEntry))))):
            invalidatedCount = (invalidatedCount + 1)
    for nextEntry in args.nextEntries:
        let nextIdentityKey: Any = buildExplorerEntryIdentityRevisionKey(nextEntry)
        let previousSamePathEntry: Any = previousEntriesByPath.get(nextEntry.path)
        if ((previousSamePathEntry and (buildExplorerEntryIdentityRevisionKey(previousSamePathEntry) == nextIdentityKey))):
            let existingThumbnail: Any = args.currentThumbnails[nextEntry.path]
            if ((existingThumbnail != undefined)):
                ()
                preservedCount = (preservedCount + 1)
                continue
        let previousEntry: Any = previousEntriesByIdentity.get(nextIdentityKey)
        if (previousEntry):
            let movedThumbnail: Any = args.currentThumbnails[previousEntry.path]
            if ((movedThumbnail != undefined)):
                ()
                preservedCount = (preservedCount + 1)
                continue
        let cachedThumbnail: Any = peekExplorerThumbnailForEntry(buildExplorerPosterThumbnailRequest(nextEntry))
        if ((cachedThumbnail != undefined)):
            ()
            hydratedCount = (hydratedCount + 1)
    return none

