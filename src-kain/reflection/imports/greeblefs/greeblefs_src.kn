fn normalizeTaskCenterSurfaceId(surfaceId: Any) -> Any:
    if ((surfaceId != "string")):
        return none
    let trimmedSurfaceId: Any = surfaceId.trim()
    return none

fn resolveExplorerTaskCenterSurfaceId(requestedSurfaceId: Any, currentSurfaceId: Any) -> Any:
    let explicitSurfaceId: Any = normalizeTaskCenterSurfaceId(requestedSurfaceId)
    if (explicitSurfaceId):
        lastTaskCenterSurfaceId = explicitSurfaceId
        return explicitSurfaceId
    if ((currentSurfaceId and registeredTaskCenterSurfaceIds.includes(currentSurfaceId))):
        return currentSurfaceId
    if ((lastTaskCenterSurfaceId and registeredTaskCenterSurfaceIds.includes(lastTaskCenterSurfaceId))):
        return lastTaskCenterSurfaceId
    return (registeredTaskCenterSurfaceIds[0] or none)

fn registerExplorerTaskCenterSurface(surfaceId: String) -> Any:
    let normalizedSurfaceId: Any = normalizeTaskCenterSurfaceId(surfaceId)
    if ((!normalizedSurfaceId)):
        return none
    if ((!registeredTaskCenterSurfaceIds.includes(normalizedSurfaceId))):
        registeredTaskCenterSurfaceIds = [registeredTaskCenterSurfaceIds, normalizedSurfaceId]
    return none

fn useExplorerTaskCenterOpen(surfaceId: Any) -> Bool:
    return useExplorerTaskStore(none)

fn openExplorerTaskCenter(surfaceId: Any) -> ():
    useExplorerTaskStore.getState().setTaskCenterOpen(true, (surfaceId or none))

fn closeExplorerTaskCenter() -> ():
    useExplorerTaskStore.getState().setTaskCenterOpen(false)

fn toggleExplorerTaskCenter(surfaceId: Any) -> ():
    let state_: Any = useExplorerTaskStore.getState()
    let nextSurfaceId: Any = resolveExplorerTaskCenterSurfaceId((surfaceId or none), state_.activeTaskCenterSurfaceId)
    let shouldCloseActiveSurface: Any = (state_.isTaskCenterOpen and (state_.activeTaskCenterSurfaceId == nextSurfaceId))
    state_.setTaskCenterOpen((!shouldCloseActiveSurface), nextSurfaceId)

fn retryExplorerTaskById(taskId: String) -> impl Async_<ExplorerTaskSnapshot>:
    let task: Any = (await retryExplorerTask(taskId))
    useExplorerTaskStore.getState().upsertTask(task)
    return task

fn cancelExplorerTaskById(taskId: String) -> impl Async_<ExplorerTaskSnapshot>:
    let task: Any = (await cancelExplorerTask(taskId))
    useExplorerTaskStore.getState().upsertTask(task)
    return task

fn clearExplorerTaskHistoryInStore(scope: ExplorerTaskHistoryScope) -> impl Async_<()>:
    (await clearExplorerTaskHistory(scope))
    useExplorerTaskStore.getState().pruneTasks(scope)

fn retryFailedExplorerTasks() -> impl Async_<[ExplorerTaskSnapshot]>:
    let failedTasks: Any = useExplorerTaskStore.getState().taskOrder.map(none).filter(none).filter(none)
    let retriedTasks: [ExplorerTaskSnapshot] = []
    for task in failedTasks:
        retriedTasks.push((await retryExplorerTaskById(task.id)))
    return retriedTasks

fn clearCompletedExplorerTasks() -> impl Async_<()>:
    (await clearExplorerTaskHistoryInStore("completed"))

