component OverlayActionButton(appearance: Any, tone: Any, size: Any, active: Any, motionStepIndex: Any, type_: Any, disabled: Any, className: Any, children: Any, style: Any, onClick: Any, onPointerEnter: Any, onPointerLeave: Any, onPointerDown: Any, onPointerUp: Any, onPointerCancel: Any, onBlur: Any, buttonProps: Any) with Reactive:
    state interactionMotion: Any = useInteractionMotionController(appearance)
    state isHovered: Any = false
    state isPressed: Any = false
    state visualStyle: Any = resolveOverlayActionButtonVisualStyle(none)
    fn motionBinding() -> Any:
        return interactionMotion.bindSurface(none)

    fn setIsHovered(value: Any):
        isHovered = value

    fn setIsPressed(value: Any):
        isPressed = value

    fn handlePointerEnter(event: ReactPointerEvent<HTMLButtonElement>):
        if ((!disabled)):
            setIsHovered(true)
        motionBinding.onPointerEnter(event)
        onPointerEnter(event)

    fn handlePointerLeave(event: ReactPointerEvent<HTMLButtonElement>):
        setIsHovered(false)
        setIsPressed(false)
        motionBinding.onPointerLeave(event)
        onPointerLeave(event)

    fn handlePointerDown(event: ReactPointerEvent<HTMLButtonElement>):
        if ((!disabled)):
            setIsHovered(true)
            setIsPressed(true)
        motionBinding.onPointerDown(event)
        onPointerDown(event)

    fn handlePointerUp(event: ReactPointerEvent<HTMLButtonElement>):
        setIsPressed(false)
        if ((!disabled)):
            setIsHovered(true)
        motionBinding.onPointerUp(event)
        onPointerUp(event)

    fn handlePointerCancel(event: ReactPointerEvent<HTMLButtonElement>):
        setIsHovered(false)
        setIsPressed(false)
        motionBinding.onPointerCancel(event)
        onPointerCancel(event)

    render <button type={type_} disabled={disabled} className={className} data_overlay_action_button_tone={tone} data_overlay_action_button_size={size} onPointerEnter={handlePointerEnter} onPointerLeave={handlePointerLeave} onPointerDown={handlePointerDown} onPointerUp={handlePointerUp} onPointerCancel={handlePointerCancel} onClick={none} onBlur={none} style={none}>{children}</button>

