fn listenToExplorerTaskProgress(listener: Any) -> impl Async_<Any>:
    return events.explorerTaskProgressEvent.listen(none)

fn getSchedulerTaskProgressPercent(task: ExplorerSchedulerTask) -> Any:
    if ((task.prog.kind == "fileCopy")):
        ()
    else if ((task.prog.kind == "fileCut")):
        ()
    else if ((task.prog.kind == "fileDelete")):
        ()
    else if ((task.prog.kind == "fileDownload")):
        ()
    else if ((task.prog.kind == "fileUpload")):
        return none
    else if ((task.prog.kind == "fileHardlink")):
        return none
    else if ((task.prog.kind == "fileLink")):
        ()
    else if ((task.prog.kind == "fileTrash")):
        return none
    else:
        return none

fn didSchedulerTaskFail(task: ExplorerSchedulerTask) -> Any:
    if ((task.prog.kind == "fileCopy")):
        ()
    else if ((task.prog.kind == "fileCut")):
        ()
    else if ((task.prog.kind == "fileDelete")):
        ()
    else if ((task.prog.kind == "fileDownload")):
        ()
    else if ((task.prog.kind == "fileUpload")):
        return ((task.prog.cleaned == false) or (task.prog.collected == false))
    else if ((task.prog.kind == "fileHardlink")):
        return (task.prog.collected == false)
    else if ((task.prog.kind == "fileLink")):
        return (task.prog.state_ == false)
    else if ((task.prog.kind == "fileTrash")):
        return ((task.prog.cleaned == false) or (task.prog.state_ == false))
    else:
        return false

fn isSchedulerTaskFinished(task: ExplorerSchedulerTask) -> Any:
    if ((task.prog.kind == "fileCopy")):
        ()
    else if ((task.prog.kind == "fileCut")):
        ()
    else if ((task.prog.kind == "fileDelete")):
        ()
    else if ((task.prog.kind == "fileDownload")):
        ()
    else if ((task.prog.kind == "fileUpload")):
        return ((task.prog.cleaned != none) or (task.prog.collected == false))
    else if ((task.prog.kind == "fileHardlink")):
        return (task.prog.collected != none)
    else if ((task.prog.kind == "fileLink")):
        return (task.prog.state_ != none)
    else if ((task.prog.kind == "fileTrash")):
        return ((task.prog.cleaned != none) or (task.prog.state_ == false))
    else:
        return false

fn getExplorerTaskProgressPercent(task: Any) -> Any:
    if (ts_in_operator("status", task)):
        if ((((task.progressCurrent == "number") and (task.progressTotal == "number")) and (task.progressTotal > 0))):
            return Math.min(100, Math.round((((task.progressCurrent / task.progressTotal)) * 100)))
        if (task.schedulerTask):
            return getSchedulerTaskProgressPercent(task.schedulerTask)
        return none
    return getSchedulerTaskProgressPercent(task)

fn didExplorerTaskFail(task: Any) -> Any:
    if (ts_in_operator("status", task)):
        return (task.status == "failed")
    return didSchedulerTaskFail(task)

fn isExplorerTaskFinished(task: Any) -> Any:
    if (ts_in_operator("status", task)):
        return (task.status != "running")
    return isSchedulerTaskFinished(task)

fn getExplorerTaskStatusLabel(task: Any) -> Any:
    if (ts_in_operator("status", task)):
        if ((task.status == "failed")):
            return "Failed"
        if ((task.status == "cancelled")):
            return "Cancelled"
        let percent: Any = getExplorerTaskProgressPercent(task)
        if (((percent != none) and (task.status == "running"))):
            return percent + "%"
        return none
    if (didSchedulerTaskFail(task)):
        return "Failed"
    let percent: Any = getSchedulerTaskProgressPercent(task)
    if (((percent != none) and (!isSchedulerTaskFinished(task)))):
        return percent + "%"
    return none

