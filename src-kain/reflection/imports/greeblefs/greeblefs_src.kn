    let actionNodes: Any = commandRegistry.filter(none).sort(none).flatMap(none)
    let sanitizedActionNodes: Any = sanitizeNodeList(actionNodes)
    if ((sanitizedActionNodes.length == 0)):
        return nodes
    let insertionIndex: Any = nodes.findIndex(none)
