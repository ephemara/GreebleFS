fn dedupeConstellationConnections(connections: Any) -> Any:
    let deduped: Any = ts_Map()
    let strengthRank: Option<Any> = none
    let iter_12: Any = connections
    let index_13: Any = 0
    while ((index_13 < iter_12.length)):
        let connection: Any = iter_12[index_13]
        let previous: Any = deduped.get(connection.id)
        if ((!previous)):
            deduped.set(connection.id, connection)
            return none
        let previousRank: Any = strengthRank[previous.strength]
        let nextRank: Any = strengthRank[connection.strength]
        if (((nextRank > previousRank) or connection.highlighted)):
            deduped.set(connection.id, none)
        index_13 = (index_13 + 1)
    return ts_Array.from(deduped.values())

fn getConstellationNodeSize(emphasis: Any, dominant: Bool, density: Float, tier: Float) -> Float:
    let base: Any = none
    let densityPenalty: Any = none
    let tierPenalty: Any = none
    return Math.max(24, Math.round(((base - ((density * densityPenalty))) - tierPenalty)))

fn buildConstellationGraphConnections(args: Any) -> [ConstellationFieldConnection]:
    let nodeLookup: Any = ts_Map()
    for band in args.bands:
        for node in band.nodes:
            nodeLookup.set(node.entry.path, node)
    let perNodeLimit: Any = clampNumber(Math.round((CONSTELLATION_CONNECTION_DENSITY_BOUNDS.minPerNode + ((args.density * 4)))), CONSTELLATION_CONNECTION_DENSITY_BOUNDS.minPerNode, CONSTELLATION_CONNECTION_DENSITY_BOUNDS.maxPerNode)
    let totalLimit: Any = clampNumber(Math.round((CONSTELLATION_CONNECTION_DENSITY_BOUNDS.minTotal + ((args.density * 20)))), CONSTELLATION_CONNECTION_DENSITY_BOUNDS.minTotal, CONSTELLATION_CONNECTION_DENSITY_BOUNDS.maxTotal)
    let minimumScore: Any = CONSTELLATION_MIN_EDGE_SCORE_BY_LENS[args.activeLens]
    let nodeConnectionCount: Any = ts_Map()
    let candidateEdges: Any = args.graph.edges.filter(none).sort(none)
    let connections: [ConstellationFieldConnection] = []
    for edge in candidateEdges:
        let fromNode: Any = nodeLookup.get(edge.fromPath)
        let toNode: Any = nodeLookup.get(edge.toPath)
        if (((!fromNode) or (!toNode))):
            continue
        let route: Any = args.routeEdgeIds.has(edge.id)
        let fromCount: Any = (nodeConnectionCount.get(edge.fromPath) or 0)
        let toCount: Any = (nodeConnectionCount.get(edge.toPath) or 0)
        if (((!route) and (connections.length >= totalLimit))):
            continue
        if ((((!route) and (fromCount >= perNodeLimit)) and (toCount >= perNodeLimit))):
            continue
        connections.push(createConstellationGraphConnection(none))
        nodeConnectionCount.set(edge.fromPath, (fromCount + 1))
        nodeConnectionCount.set(edge.toPath, (toCount + 1))
    return connections

fn createConstellationGraphConnection(args: Any) -> Any:
    let lensScore: Any = args.edge.scoreByLens[args.activeLens]
    return none

fn getConstellationConnectionStrength(score: Float, route: Bool) -> Any:
    if ((route or (score >= 1.2))):
        return "primary"
    if ((score >= 0.78)):
        return "bridge"
    return "secondary"

fn resolveClusterSlot(slots: Any, index: Float, bandCount: Float) -> Any:
    let direct: Any = slots[index]
    if (direct):
        return direct
    let progress: Any = ((((index - slots.length) + 1)) / Math.max(1, bandCount))
    return none

fn clampConstellationPoint(point: Any, width: Float, height: Float) -> Any:
    return none

fn getHashAngleJitter(hash: Float, amplitude: Float) -> Float:
    return (((((((((hash >> 5)) % 31)) / 30)) - 0.5)) * amplitude)

fn hashExplorerString(value: String) -> Float:
    let hash: Any = 0
    let index: Any = 0
    while ((index < value.length)):
        hash = (((((hash << 5)) - hash)) + value.charCodeAt(index))
        hash = (hash | 0)
        index = (index + 1)
    return Math.abs(hash)

fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(max, Math.max(min, value))

fn clampNumber(value: Float, min: Float, max: Float) -> Float:
    return Math.min(max, Math.max(min, value))

type ExplorerChromeControlId = Any

type ExplorerChromeSizeVariant = Any

type ExplorerChromeResizePoint = Any

type ExplorerChromeResizeKind = String

struct ExplorerChromeResizeSession:
    pointerId: Float
    controlId: ExplorerChromeControlId
    kind: ExplorerChromeResizeKind
    startPoint: ExplorerChromeResizePoint
    initialWidthPx: Any
    minWidthPx: Float
    maxWidthPx: Float
    initialSizeVariant: ExplorerChromeSizeVariant
    sizeVariants: [ExplorerChromeSizeVariant]
    active: Bool
    onActivate: Any
    onWidthChange: Any
    onSizeVariantChange: Any
    onComplete: Any

struct BeginExplorerChromeResizeSessionArgs:
    pointerId: Float
    controlId: ExplorerChromeControlId
    startPoint: ExplorerChromeResizePoint
    kind: ExplorerChromeResizeKind
    initialWidthPx: Any
    minWidthPx: Any
    maxWidthPx: Any
    initialSizeVariant: Any
    sizeVariants: Any
    onActivate: Any
    onWidthChange: Any
    onSizeVariantChange: Any
    onComplete: Any

const EXPLORER_CHROME_RESIZE_VARIANT_STEP_PX: Any = 64

const activeExplorerChromeResizeSession: Any = none

const resizeWindowListenersAttached: Any = false

const savedBodyUserSelect: Any = none

const savedBodyCursor: Any = none

fn attachBodyResizeState() -> Any:
    if ((document == "undefined")):
        return none
    let _: Any = document
    let body: Any = none
    if ((!body)):
        return none
    if ((savedBodyUserSelect == none)):
        savedBodyUserSelect = body.style.userSelect
    if ((savedBodyCursor == none)):
        savedBodyCursor = body.style.cursor
    body.style.userSelect = "none"
    body.style.cursor = "ew-resize"

fn restoreBodyResizeState() -> Any:
    if ((document == "undefined")):
        savedBodyUserSelect = none
        savedBodyCursor = none
        return none
    let _: Any = document
    let body: Any = none
    if ((!body)):
        savedBodyUserSelect = none
        savedBodyCursor = none
        return none
    if ((savedBodyUserSelect != none)):
        body.style.userSelect = savedBodyUserSelect
    else:
        body.style.removeProperty("user-select")
    if ((savedBodyCursor != none)):
        body.style.cursor = savedBodyCursor
    else:
        body.style.removeProperty("cursor")
    savedBodyUserSelect = none
    savedBodyCursor = none

fn clampWidthPx(value: Float, minWidthPx: Float, maxWidthPx: Float) -> Float:
    return Math.max(minWidthPx, Math.min(maxWidthPx, Math.round(value)))

fn resolveSizeVariantFromDelta(session: ExplorerChromeResizeSession, deltaX: Float) -> Any:
    let variantCount: Any = session.sizeVariants.length
    if ((variantCount <= 1)):
        return session.initialSizeVariant
    let initialVariantIndex: Any = Math.max(0, session.sizeVariants.indexOf(session.initialSizeVariant))
    let rawOffset: Any = Math.round((deltaX / EXPLORER_CHROME_RESIZE_VARIANT_STEP_PX))
    let nextIndex: Any = Math.max(0, Math.min((variantCount - 1), (initialVariantIndex + rawOffset)))
    return (session.sizeVariants[nextIndex] or session.initialSizeVariant)

fn completeExplorerChromeResizeSession() -> ():
    let session: Any = activeExplorerChromeResizeSession
    activeExplorerChromeResizeSession = none
    restoreBodyResizeState()
    if (session.onComplete):
        session.onComplete()

fn handleExplorerChromeResizePointerMove(event: PointerEvent) -> Any:
    let session: Any = activeExplorerChromeResizeSession
    if (((!session) or (event.pointerId != session.pointerId))):
        return none
    event.preventDefault()
    if ((!session.active)):
        session.active = true
        session.onActivate()
    let deltaX: Any = (event.clientX - session.startPoint.x)
    if ((session.kind == "width-px")):
        let nextWidthPx: Any = clampWidthPx((((session.initialWidthPx or session.minWidthPx)) + deltaX), session.minWidthPx, session.maxWidthPx)
        session.onWidthChange(nextWidthPx)
        return none
    let nextSizeVariant: Any = resolveSizeVariantFromDelta(session, deltaX)
    session.onSizeVariantChange(nextSizeVariant)

fn handleExplorerChromeResizePointerUp(event: PointerEvent) -> Any:
    if (((!activeExplorerChromeResizeSession) or (event.pointerId != activeExplorerChromeResizeSession.pointerId))):
        return none
    completeExplorerChromeResizeSession()

fn handleExplorerChromeResizePointerCancel(event: PointerEvent) -> Any:
    if (((!activeExplorerChromeResizeSession) or (event.pointerId != activeExplorerChromeResizeSession.pointerId))):
        return none
    completeExplorerChromeResizeSession()

fn handleExplorerChromeResizeWindowBlur() -> Any:
    if ((!activeExplorerChromeResizeSession)):
        return none
    completeExplorerChromeResizeSession()

fn handleExplorerChromeResizeEscape(event: KeyboardEvent) -> Any:
    if (((event.key != "Escape") or (!activeExplorerChromeResizeSession))):
        return none
    event.preventDefault()
    completeExplorerChromeResizeSession()

fn ensureResizeWindowListeners() -> Any:
    if ((resizeWindowListenersAttached or (window == "undefined"))):
        return none
    window.addEventListener("pointermove", handleExplorerChromeResizePointerMove, none)
    window.addEventListener("pointerup", handleExplorerChromeResizePointerUp)
    window.addEventListener("pointercancel", handleExplorerChromeResizePointerCancel)
    window.addEventListener("blur", handleExplorerChromeResizeWindowBlur)
    window.addEventListener("keydown", handleExplorerChromeResizeEscape)
    resizeWindowListenersAttached = true

fn beginExplorerChromeResizeSession(args: BeginExplorerChromeResizeSessionArgs) -> ():
    cancelExplorerChromeResizeSession()
    ensureResizeWindowListeners()
    attachBodyResizeState()
    activeExplorerChromeResizeSession = none

fn cancelExplorerChromeResizeSession() -> Any:
    if ((!activeExplorerChromeResizeSession)):
        restoreBodyResizeState()
        return none
    completeExplorerChromeResizeSession()

