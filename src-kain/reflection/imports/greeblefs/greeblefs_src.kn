fn getCSSText(element: Element) -> Any:
    let value: Any = ""
    let style: Any = getComputedStyle(element)
    let i: Any = 0
    while ((i < style.length)):
        value = (value + style[i] + ":" + style.getPropertyValue(style[i]) + ";")
        i = (i + 1)
    return value

fn cloneElement(node: HTMLElement) -> Any:
    let clonedNode: Any = node.cloneNode(true)
    let sourceElements: Any = [node, ts_Array.from(node.getElementsByTagName("*"))]
    let targetElements: Any = [clonedNode, ts_Array.from(clonedNode.getElementsByTagName("*"))]
    let iter_0: Any = sourceElements
    let index_1: Any = 0
    while ((index_1 < iter_0.length)):
        let sourceElement: Any = iter_0[index_1]
        let index: Any = index_1
        targetElements[index].style.cssText = getCSSText(sourceElement)
        index_1 = (index_1 + 1)
    return clonedNode

