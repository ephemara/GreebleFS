fn normalizeDockFloatingBounds(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    let source: Any = value
    let width: Any = normalizeDockEdgeWidth(source.width, overlayWindowGeometry.defaultWidth)
    let height: Any = normalizeDockEdgeSize(source.height, overlayWindowGeometry.defaultHeight)
    let x: Any = none
    let y: Any = none
    if (((!ts_Number.isFinite(x)) or (!ts_Number.isFinite(y)))):
        return none
    return none

