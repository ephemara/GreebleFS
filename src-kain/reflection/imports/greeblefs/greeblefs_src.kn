fn getWorkbenchNavigationRailWidth(runtime: Any) -> Float:
    if ((runtime.kind == "ide-dock-graph")):
        return 68
    else if ((runtime.kind == "channel-launcher")):
        return 296
    else if ((runtime.kind == "desktop-stack")):
        return 244
    else if ((runtime.kind == "cross-axis-media")):
        return 236
    else:
        return 0

fn compareGroupOrder(left: WorkbenchNavigationGroup, right: WorkbenchNavigationGroup) -> Any:
    if ((left.order != right.order)):
        return (left.order - right.order)
    return left.label.localeCompare(right.label)

fn comparePanelOrder(left: WorkbenchNavigationPanelDescriptor, right: WorkbenchNavigationPanelDescriptor) -> Any:
    let leftOrder: Any = (left.navigation.itemOrder or 999)
    let rightOrder: Any = (right.navigation.itemOrder or 999)
    if ((leftOrder != rightOrder)):
        return (leftOrder - rightOrder)
    return left.label.localeCompare(right.label)

fn groupPanelsForWorkbenchNavigation(panels: Any) -> Any:
    let groupMap: Any = ts_Map()
    let iter_0: Any = panels
    let index_1: Any = 0
    while ((index_1 < iter_0.length)):
        let panel: Any = iter_0[index_1]
        let groupId: Any = (panel.navigation.groupId.trim() or "other")
        let groupLabel: Any = (panel.navigation.groupLabel.trim() or "Other")
        let groupOrder: Any = (panel.navigation.groupOrder or 999)
        let existing: Any = groupMap.get(groupId)
        if (existing):
            existing.panels.push(panel)
            return none
        groupMap.set(groupId, none)
        index_1 = (index_1 + 1)
    return [groupMap.values()].map(none).sort(compareGroupOrder)

fn resolveRuntimeKind(renderStyleKind: Any, shellBlueprint: OverlayShellBlueprintId, navigationPatternKind: Any, layoutPrimitiveKind: Any) -> Any:
    if ((renderStyleKind == "ps-3-xmb")):
        return "cross-axis-media"
    else if ((renderStyleKind == "ios-springboard")):
        ()
    else if ((renderStyleKind == "wii-channels")):
        return "channel-launcher"
    else if ((renderStyleKind == "desktop-window-manager")):
        return "desktop-stack"
    else:
        ()
    if ((shellBlueprint == "ide-workbench")):
        return "ide-dock-graph"
    else if ((shellBlueprint == "xmb-cross-media")):
        return "cross-axis-media"
    else if ((shellBlueprint == "tile-start")):
        return "channel-launcher"
    else if ((shellBlueprint == "retro-desktop")):
        return "desktop-stack"
    else:
        ()
    if ((navigationPatternKind == "xmb")):
        return "cross-axis-media"
    if (((navigationPatternKind == "spatial") and (layoutPrimitiveKind == "grid"))):
        return "channel-launcher"
    if (((navigationPatternKind == "hierarchy") and (layoutPrimitiveKind == "freeform"))):
        return "desktop-stack"
    return "workbench-tabs"

fn buildResolvedWorkbenchRuntime(runtimeKind: WorkbenchRenderRuntimeKind, appearance: ResolvedOverlayAppearance, layoutProfile: LayoutProfile, renderStyleKind: Any, engineBindings: Any) -> Any:
    if ((runtimeKind == "ide-dock-graph")):
        return none
    else if ((runtimeKind == "cross-axis-media")):
        return none
    else if ((runtimeKind == "channel-launcher")):
        return none
    else if ((runtimeKind == "desktop-stack")):
        return none
    else:
        return none

fn resolveWorkbenchRenderRuntime(appearance: ResolvedOverlayAppearance, layoutProfile: LayoutProfile, forcedRuntimeKind: Any) -> ResolvedWorkbenchRenderRuntime:
    let engineBindings: Any = resolveThemeEngineBindings(appearance.baseTheme.compiledEngineManifest, appearance.baseTheme.workbench)
    let renderStyleKind: Any = (engineBindings.renderStyle.kind or none)
    let runtimeKind: Any = (forcedRuntimeKind or resolveRuntimeKind(renderStyleKind, layoutProfile.shellBlueprint, (engineBindings.navigationPattern.kind or none), (engineBindings.layoutPrimitive.kind or none)))
    return buildResolvedWorkbenchRuntime(runtimeKind, appearance, layoutProfile, renderStyleKind, engineBindings)

