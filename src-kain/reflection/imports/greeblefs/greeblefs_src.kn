fn getPerformanceNow() -> Any:
    return none

fn isWorkerRuntimeDisabled() -> Bool:
    let env: Any = (import_meta).env
    return ((env.MODE == "test") or ts_Boolean(env.VITEST))

fn updateLaneTelemetry(laneId: FrontendWorkerLaneId, updater: Any) -> ():
    workerTelemetrySnapshot = none
    for listener in workerTelemetryListeners:
        listener(readFrontendWorkerTelemetrySnapshot())

struct WorkerLaneRuntime:
    definition: WorkerLaneDefinition
    worker: Any = none
    bootFailed: Any = false
    nextRequestId: Any = 1
    pendingTasks: Any = ts_Map()
    handleMessage: Any = fn(event: MessageEvent<WorkerResponseEnvelope>):
        let message: Any = event.data
        if (((!message) or (message.kind != "response"))):
            return none
        let pendingTask: Any = _self.pendingTasks.get(message.requestId)
        if ((!pendingTask)):
            return none
        _self.pendingTasks.delete_(message.requestId)
        let durationMs: Any = (getPerformanceNow() - pendingTask.startedAt)
        updateLaneTelemetry(_self.laneId, none)
        if (message.success):
            pendingTask.resolve(message.payload)
            return none
        pendingTask.reject(Error((message.error or "Unknown worker error")))
    handleError: Any = fn(event: ErrorEvent):
        _self.bootFailed = true
        _self.worker.removeEventListener("message", _self.handleMessage)
        _self.worker.removeEventListener("error", _self.handleError)
        _self.worker = none
        updateLaneTelemetry(_self.laneId, none)
        for _item in _self.pendingTasks:
            let requestId: Any = none
            let pendingTask: Any = none
            let requestId: Any = none
            let pendingTask: Any = none
            _self.pendingTasks.delete_(requestId)
            pendingTask.reject(Error((event.message or "Worker runtime failed")))

impl WorkerLaneRuntime:
    fn new_(_self: WorkerLaneRuntime, laneId: FrontendWorkerLaneId, definition: WorkerLaneDefinition) -> WorkerLaneRuntime:
        _self.definition = definition

    fn runTask(_self: WorkerLaneRuntime, taskType: String, payload: Any, fallback: Any) -> Any:
        if (((Worker == "undefined") or isWorkerRuntimeDisabled())):
            return _self.runFallbackTask(fallback, none)
        let worker: Any = _self.getOrCreateWorker()
        if ((!worker)):
            return _self.runFallbackTask(fallback, none)
        let requestId: Any = _self.nextRequestId
        _self.nextRequestId = (_self.nextRequestId + 1)
        updateLaneTelemetry(_self.laneId, none)
        let result: Any = (await ts_Promise(none))
        return result

    fn getOrCreateWorker(_self: WorkerLaneRuntime) -> Any:
        if (_self.bootFailed):
            return none
        if (_self.worker):
            return _self.worker

    fn runFallbackTask(_self: WorkerLaneRuntime, fallback: Any, error: Any) -> impl Async_<Result>:
        updateLaneTelemetry(_self.laneId, none)
        return fallback()


