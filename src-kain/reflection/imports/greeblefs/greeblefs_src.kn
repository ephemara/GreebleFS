        _self.editor.extensionStorage = ts_Object.fromEntries(extensions.map(none))
        let iter_1: Any = extensions
        let index_2: Any = 0
        while ((index_2 < iter_1.length)):
            let extension: Any = iter_1[index_2]
            let context: Any = none
            if ((extension.type_ == "mark")):
                let keepOnSplit: Any = (callOrReturn(getExtensionField(extension, "keepOnSplit", context)) or true)
