        let defaultPreset: Any = pack.runtime.presets.find(none)
        if (defaultPreset):
            return defaultPreset
    return (pack.runtime.presets[0] or none)

fn formatRelativeTime(timestamp: Float) -> Any:
    if (((!ts_Number.isFinite(timestamp)) or (timestamp <= 0))):
        return "Unknown"
    let deltaMs: Any = (Date.now() - timestamp)
    if ((deltaMs < 60000)):
        return "Just now"
    if ((deltaMs < 3600000)):
        return Math.max(1, Math.round((deltaMs / 60000))) + "m ago"
    if ((deltaMs < 86400000)):
        return Math.max(1, Math.round((deltaMs / 3600000))) + "h ago"
    return Math.max(1, Math.round((deltaMs / 86400000))) + "d ago"

