const DEFAULT_ACCELERATION_RUNTIME_SNAPSHOT: Option<Any> = none

const hydrationPromise: Any = none

const lastHydratedRequestSignature: Any = ""

const useAccelerationRuntimeStore: Any = create(none)

fn buildRequestSignature(request: ManagedAccelerationRuntimeRequest) -> String:
    return JSON.stringify(none)

fn hydrateAccelerationRuntime(request: ManagedAccelerationRuntimeRequest) -> Any:
    if ((!isTauri())):
        return none
    let requestSignature: Any = buildRequestSignature(request)
    if ((hydrationPromise and (requestSignature == lastHydratedRequestSignature))):
        return hydrationPromise
    lastHydratedRequestSignature = requestSignature
    let store: Any = useAccelerationRuntimeStore.getState()
    store.setHydrationState("loading")
    store.setHydrationError(none)
    hydrationPromise = getAccelerationRuntimeStatus(request).then(none).catch_(none).finally(none)
    return hydrationPromise

fn refreshAccelerationRuntimeStatus(request: ManagedAccelerationRuntimeRequest) -> impl Async_<AccelerationRuntimeStatusSnapshot>:
    let snapshot: Any = (await getAccelerationRuntimeStatus(request))
    useAccelerationRuntimeStore.getState().replaceSnapshot(snapshot)
    useAccelerationRuntimeStore.getState().setHydrationState("ready")
    useAccelerationRuntimeStore.getState().setHydrationError(none)
    lastHydratedRequestSignature = buildRequestSignature(request)
    return snapshot

fn useAccelerationRuntimeFeed(request: ManagedAccelerationRuntimeRequest) -> ():
    useEffect(none, [request.routingMode, request.startSidecarIfNeeded, request.config.preferredInterpreterPath, request.config.runtimeRoot, request.config.bootstrapPackages, request.config.autoUpgradePip, request.config.createBoilerplate])

