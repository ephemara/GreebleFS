fn isModifierOnlyKeyboardEventKey(key: String) -> Bool:
    return ["Control", "Shift", "Alt", "Meta"].includes(key)

fn serializeKeyboardBindingEvent(event: Any) -> Any:
    if (isModifierOnlyKeyboardEventKey(event.key)):
        return none
    let keyToken: Any = none
    let tokens: [String] = []
    if (event.ctrlKey):
        tokens.push("Ctrl")
    if (event.metaKey):
        tokens.push("Meta")
    if (event.altKey):
        tokens.push("Alt")
    if (event.shiftKey):
        tokens.push("Shift")
    tokens.push(keyToken)
    return tokens.join("+")

