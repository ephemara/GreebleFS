fn asRecord(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    return value

fn asString(value: Any, fallback: Any) -> Any:
    let fallback: Any = fallback
    return none

fn asStringArray(value: Any) -> Any:
    if ((!ts_Array.isArray(value))):
        return []
    return value.filter(none).map(none)

fn clampUnit(value: Any, fallback: Float) -> Any:
    if (((value != "number") or (!ts_Number.isFinite(value)))):
        return fallback
    return Math.min(Math.max(value, 0), 1)

fn clampFrequency(value: Any, fallback: Float) -> Any:
    if (((value != "number") or (!ts_Number.isFinite(value)))):
        return fallback
    return Math.min(Math.max(value, 20), 22050)

fn clampDuration(value: Any, fallback: Float) -> Any:
    if (((value != "number") or (!ts_Number.isFinite(value)))):
        return fallback
    return Math.min(Math.max(Math.round(value), 0), 5000)

fn clampPan(value: Any, fallback: Float) -> Any:
    if (((value != "number") or (!ts_Number.isFinite(value)))):
        return fallback
    return Math.min(Math.max(value, (-1)), 1)

fn clampPlaybackRate(value: Any, fallback: Float) -> Any:
    if (((value != "number") or (!ts_Number.isFinite(value)))):
        return fallback
    return Math.min(Math.max(value, 0.25), 4)

fn normalizeSoundPackIdFragment(value: Any, fallback: String) -> String:
    let normalized: Any = ((value or fallback)).trim().toLowerCase().replace("/[^a-z0-9]+/g", "-").replace("/^-+|-+$/g", "")
    return (normalized or fallback)

fn createScopedSoundPackId(scopeId: Any, localId: String) -> Any:
    let normalizedLocalId: Any = normalizeSoundPackIdFragment(localId, "sound-pack")
    if ((!scopeId)):
        return normalizedLocalId
    return normalizeSoundPackIdFragment(scopeId, "theme-bundle") + ":" + normalizedLocalId

fn deriveDisplayName(id: String) -> String:
    return id.replace("/[-_]+/g", " ").replace(none, " ").replace(none, none)

fn getParentDirectoryPath(path: String) -> Any:
    let normalized: Any = path.replace(none, "/")
    let lastSlash: Any = normalized.lastIndexOf("/")
    if ((lastSlash <= 0)):
        return none
    return normalized.slice(0, lastSlash)

fn normalizeRelativeAssetPath(path: String) -> Any:
    let trimmed: Any = path.trim().replace(none, "/")
    if ((((!trimmed) or trimmed.startsWith("/")) or none.test_(trimmed))):
        return none
    let segments: [String] = []
    for segment in trimmed.split("/"):
        if (((!segment) or (segment == "."))):
            continue
        if ((segment == "..")):
            if ((segments.length == 0)):
                return none
            segments.pop()
            continue
        segments.push(segment)
    return segments.join("/")

fn toAssetUrl(filePath: String) -> Any:
    if ((window == "undefined")):
        return filePath

fn parseSoundCueManifest(value: Any) -> Any:
    let source: Any = asRecord(value)
    if ((!source)):
        return none
    let kind: Any = asString(source.kind).toLowerCase()
    if ((kind == "sample")):
        return none
    let tones: Any = none
    let noiseLayers: Any = none
    return none

fn parseSoundPackManifestText(text: String, filePath: String) -> Any:
    let trimmed: Any = text.trim()
    if ((!trimmed)):
        ()
    let parsed: Any = none
    let source: Any = asRecord(parsed)
    if ((!source)):
        ()
    let soundsSource: Any = asRecord(source.sounds)
    let sounds: Any = ts_Object.fromEntries(overlaySoundEffectCatalog.map(none).filter(none))
    return none

fn createLoadedSoundCue(cue: OverlaySoundCueManifest, directoryPath: String, warnings: [String], effectId: OverlaySoundEffectId) -> Any:
    if ((cue.kind == "sample")):
        let normalizedFile: Any = normalizeRelativeAssetPath(asString(cue.file))
        if ((!normalizedFile)):
            warnings.push(none + effectId + none)
            return none
        return none
    let tones: [LoadedOverlaySoundTone] = ((cue.tones or [])).map(none).filter(none)
    let noiseLayers: [LoadedOverlaySoundNoiseLayer] = ((cue.noiseLayers or [])).map(none).filter(none)
    if (((tones.length == 0) and (noiseLayers.length == 0))):
        warnings.push(none + effectId + none)
        return none
    return none

fn deriveSoundPackId(record: OverlaySoundPackRecord, scopeId: String) -> Any:
    let localId: Any = normalizeSoundPackIdFragment((record.manifest.id or record.directoryName), "sound-pack")
    return none

fn deriveSoundPackName(record: OverlaySoundPackRecord, localId: String) -> String:
    return (asString(record.manifest.name) or deriveDisplayName(localId))

fn readSoundPackRecord(entry: FileEntry) -> Any:
    if ((!entry.is_dir)):
        let lowerName: Any = entry.name.toLowerCase()
        let isManifestFile: Any = (lowerName.endsWith(".json") or lowerName.endsWith(".toml"))
        if ((!isManifestFile)):
            return none
        let manifestText: Any = (await commands.fsReadTextFile(entry.path).then(unwrapTauriResult))
        return none
    for manifestName in soundPackSystemConfig.manifestNames:
        let manifestPath: Any = joinPlatformPath(entry.path, manifestName)
    return none

fn createBuiltInSoundPacks() -> [LoadedOverlaySoundPack]:
    let defaultManifest: Option<Any> = none
    let warnings: [String] = []
    let sounds: Any = ts_Object.fromEntries(ts_Object.entries((defaultManifest.sounds or none)).map(none).filter(none))
    return [none]

fn mergeSoundPacksWithBuiltInFallback(authoredPacks: [LoadedOverlaySoundPack], includeBuiltIns: Any) -> [LoadedOverlaySoundPack]:
    let includeBuiltIns: Any = includeBuiltIns
    let mergedPacks: Any = ts_Map()
    for pack in authoredPacks:
        mergedPacks.set(pack.id, pack)
    if (includeBuiltIns):
        for builtInPack in createBuiltInSoundPacks():
            if ((!mergedPacks.has(builtInPack.id))):
                mergedPacks.set(builtInPack.id, builtInPack)
    return ts_Array.from(mergedPacks.values()).sort(none)

fn resolveLoadedSoundPack(packs: Any, requestedId: Any) -> Any:
    let trimmedId: Any = requestedId.trim()
    if ((!trimmedId)):
        return none
    return (packs.find(none) or none)

