const snapshotCache: Any = none

fn areExplorerCustomizePointerPointsEqual(left: Any, right: Any) -> Bool:
    return ((left.x == right.x) and (left.y == right.y))

fn areExplorerCustomizePointerDropTargetsEqual(left: Any, right: Any) -> Bool:
    return ((((((((left.surfaceId == right.surfaceId) and (left.zoneId == right.zoneId)) and (left.targetIndex == right.targetIndex)) and (left.offsetPx == right.offsetPx)) and (left.bandId == right.bandId)) and (left.anchorX == right.anchorX)) and (left.anchorY == right.anchorY)))

fn syncSnapshotCache() -> Any:
    let nextSnapshot: Option<Any> = none
    if (((((((snapshotCache.active == nextSnapshot.active) and (snapshotCache.draggingControlId == nextSnapshot.draggingControlId)) and (snapshotCache.sourceKind == nextSnapshot.sourceKind)) and (snapshotCache.removeTargetActive == nextSnapshot.removeTargetActive)) and areExplorerCustomizePointerDropTargetsEqual(snapshotCache.dropTarget, nextSnapshot.dropTarget)) and areExplorerCustomizePointerPointsEqual(snapshotCache.pointerPoint, nextSnapshot.pointerPoint))):
        return false
    snapshotCache = nextSnapshot
    return true

fn emitSnapshot() -> Any:
    if ((!syncSnapshotCache())):
        return none
    for listener in snapshotListeners:
        listener()

fn subscribeToExplorerCustomizePointerSnapshot(listener: Any) -> Any:
    snapshotListeners.add(listener)
    return none

fn getExplorerCustomizePointerSnapshot() -> ExplorerCustomizePointerSnapshot:
    syncSnapshotCache()
    return snapshotCache

fn useExplorerCustomizePointerSnapshot() -> ExplorerCustomizePointerSnapshot:
    return useSyncExternalStore(subscribeToExplorerCustomizePointerSnapshot, getExplorerCustomizePointerSnapshot, getExplorerCustomizePointerSnapshot)

fn useExplorerCustomizePointerActive() -> Bool:
    return useSyncExternalStore(subscribeToExplorerCustomizePointerSnapshot, none, none)

fn useExplorerCustomizePointerSourceKind() -> Any:
    return useSyncExternalStore(subscribeToExplorerCustomizePointerSnapshot, none, none)

fn isExplorerCustomizePointerActive() -> Bool:
    return getExplorerCustomizePointerSnapshot().active

fn applyBodyDragState() -> Any:
    if ((document == "undefined")):
        return none
    let _: Any = document
    let body: Any = none
    if ((!body)):
        return none
    if ((savedBodyUserSelect == none)):
        savedBodyUserSelect = body.style.userSelect
    if ((savedBodyCursor == none)):
        savedBodyCursor = body.style.cursor
    body.style.userSelect = "none"
    body.style.cursor = "grabbing"

fn restoreBodyDragState() -> Any:
    if ((document == "undefined")):
        savedBodyUserSelect = none
        savedBodyCursor = none
        return none
    let _: Any = document
    let body: Any = none
    if ((!body)):
        savedBodyUserSelect = none
        savedBodyCursor = none
        return none
    if ((savedBodyUserSelect != none)):
        body.style.userSelect = savedBodyUserSelect
    else:
        body.style.removeProperty("user-select")
    if ((savedBodyCursor != none)):
        body.style.cursor = savedBodyCursor
    else:
        body.style.removeProperty("cursor")
    savedBodyUserSelect = none
    savedBodyCursor = none

fn pointIntersectsRect(point: ExplorerCustomizePointerPoint, rect: DOMRect) -> Bool:
    return (((((point.x >= rect.left) and (point.x <= rect.right)) and (point.y >= rect.top)) and (point.y <= rect.bottom)))

fn distanceFromPointToRect(point: ExplorerCustomizePointerPoint, rect: DOMRect) -> Float:
    let horizontalDistance: Any = none
    let verticalDistance: Any = none
    return Math.hypot(horizontalDistance, verticalDistance)

fn getImmediateCustomizeZoneElements(rowElement: HTMLElement) -> [HTMLElement]:
    return ts_Array.from(rowElement.children).filter(none)

fn getImmediateCustomizeControlElements(zoneElement: HTMLElement, ignoredControlId: Any) -> [HTMLElement]:
    return ts_Array.from(zoneElement.children).filter(none)

fn getLayoutDynamicsBandElements(surfaceElement: HTMLElement) -> [HTMLElement]:
    return ts_Array.from(surfaceElement.querySelectorAll(EXPLORER_LAYOUT_DYNAMICS_BAND_SELECTOR))

fn getLayoutDynamicsBandControlElements(input: Any) -> [HTMLElement]:
    return ts_Array.from(input.surfaceElement.querySelectorAll(EXPLORER_LAYOUT_DYNAMICS_ITEM_SELECTOR)).filter(none).sort(none)

struct ExplorerCustomizeAmbientZoneTarget:
    zoneElement: HTMLElement
    territoryLeft: Float
    territoryRight: Float

struct ExplorerCustomizeAmbientLayoutDynamicsBandTarget:
    bandElement: HTMLElement
    territoryLeft: Float
    territoryRight: Float

fn resolveAmbientRowElementInSurface(surfaceElement: HTMLElement, point: ExplorerCustomizePointerPoint) -> Any:
    let rowElements: Any = ts_Array.from(surfaceElement.children).filter(none)
    if ((rowElements.length == 0)):
        return none
    for rowElement in rowElements:
        if (pointIntersectsRect(point, rowElement.getBoundingClientRect())):
            return rowElement
    return rowElements.reduce(none, none)

fn resolveAmbientLayoutDynamicsBandTargetInSurface(surfaceElement: HTMLElement, point: ExplorerCustomizePointerPoint) -> Any:
    let bandElements: Any = getLayoutDynamicsBandElements(surfaceElement)
    if ((bandElements.length == 0)):
        return none
    for bandElement in bandElements:
        let bandRect: Any = bandElement.getBoundingClientRect()
        if (pointIntersectsRect(point, bandRect)):
            return none
    return bandElements.reduce(none, none)

fn resolveAmbientZoneTargetInRow(rowElement: HTMLElement, point: ExplorerCustomizePointerPoint) -> Any:
    let zoneElements: Any = getImmediateCustomizeZoneElements(rowElement)
    if ((zoneElements.length == 0)):
        return none
    for zoneElement in zoneElements:
        if (pointIntersectsRect(point, zoneElement.getBoundingClientRect())):
            let zoneRect: Any = zoneElement.getBoundingClientRect()
            return none
    let rowRect: Any = rowElement.getBoundingClientRect()
    let index: Any = 0
    while ((index < zoneElements.length)):
        let zoneElement: Any = zoneElements[index]
        let zoneRect: Any = zoneElement.getBoundingClientRect()
        let previousRect: Any = none
        let nextRect: Any = none
        let territoryLeft: Any = none
        let territoryRight: Any = none
        if (((point.x >= territoryLeft) and (point.x <= territoryRight))):
            return none
        index = (index + 1)
    return zoneElements.reduce(none, none)

fn resolveInsertionPositionForZone(input: Any) -> Any:
    let controlElements: Any = getImmediateCustomizeControlElements(input.zoneElement, input.ignoredControlId)
    let clampedPointX: Any = Math.max(input.territoryLeft, Math.min(input.territoryRight, input.point.x))
    if ((controlElements.length == 0)):
        return none
    let targetIndex: Any = controlElements.length
    let index: Any = 0
    while ((index < controlElements.length)):
        let controlRect: Any = controlElements[index].getBoundingClientRect()
        let controlMidpointX: Any = (controlRect.left + (controlRect.width / 2))
        if (((input.point.y < controlRect.top) or (((input.point.y <= controlRect.bottom) and (clampedPointX < controlMidpointX))))):
            targetIndex = index
            break
        index = (index + 1)
    let previousControlRect: Any = none
    let nextControlRect: Any = none
    let slotStart: Any = (previousControlRect.right or input.territoryLeft)
    let slotEnd: Any = (nextControlRect.left or input.territoryRight)
    let clampedSlotPointX: Any = Math.max(slotStart, Math.min(slotEnd, clampedPointX))
    return none

fn resolveInsertionPositionForLayoutDynamicsBand(input: Any) -> Any:
    let bandId: Any = input.bandElement.dataset.layoutDynamicsBand
    let bandRect: Any = input.bandElement.getBoundingClientRect()
    let clampedPointX: Any = Math.max(input.territoryLeft, Math.min(input.territoryRight, input.point.x))
    let clampedPointY: Any = Math.max(bandRect.top, Math.min(bandRect.bottom, input.point.y))
    if ((!bandId)):
        return none
    let controlElements: Any = getLayoutDynamicsBandControlElements(none)
    if ((controlElements.length == 0)):
        return none
    let targetIndex: Any = controlElements.length
    let index: Any = 0
    while ((index < controlElements.length)):
        let controlRect: Any = controlElements[index].getBoundingClientRect()
        let controlMidpointX: Any = (controlRect.left + (controlRect.width / 2))
        if ((clampedPointX < controlMidpointX)):
            targetIndex = index
            break
        index = (index + 1)
    let previousControlRect: Any = none
    let nextControlRect: Any = none
    let slotStart: Any = (previousControlRect.right or input.territoryLeft)
    let slotEnd: Any = (nextControlRect.left or input.territoryRight)
    let clampedSlotPointX: Any = Math.max(slotStart, Math.min(slotEnd, clampedPointX))
    return none

fn resolveAmbientSurfaceElementFromPoint(point: ExplorerCustomizePointerPoint) -> Any:
    if ((document == "undefined")):
        return none
    let surfaceElements: Any = ts_Array.from(document.querySelectorAll("[" + EXPLORER_CUSTOMIZE_SURFACE_ATTRIBUTE + "]"))
    if ((surfaceElements.length == 0)):
        return none
    for surfaceElement in surfaceElements:
        if (pointIntersectsRect(point, surfaceElement.getBoundingClientRect())):
            return surfaceElement
    return none

fn resolveExplorerCustomizeDropTargetFromPoint(point: ExplorerCustomizePointerPoint) -> Any:
    if ((document == "undefined")):
        return none
    let hoveredElement: Any = document.elementFromPoint(point.x, point.y)
    let ambientSurfaceElement: Any = resolveAmbientSurfaceElementFromPoint(point)
    if (ambientSurfaceElement):
        let surfaceId: Any = ambientSurfaceElement.dataset.explorerCustomizeSurfaceId
        let ignoredControlId: Any = none
        let ambientLayoutDynamicsBandTarget: Any = resolveAmbientLayoutDynamicsBandTargetInSurface(ambientSurfaceElement, point)
        let layoutDynamicsZoneId: Any = ambientLayoutDynamicsBandTarget.bandElement.dataset.explorerCustomizeZoneId
        let layoutDynamicsBandId: Any = ambientLayoutDynamicsBandTarget.bandElement.dataset.layoutDynamicsBand
        let layoutDynamicsInsertionPosition: Any = none
        if ((((((surfaceId and layoutDynamicsZoneId) and layoutDynamicsBandId) and layoutDynamicsInsertionPosition) and ts_Number.isFinite(layoutDynamicsInsertionPosition.targetIndex)) and ts_Number.isInteger(layoutDynamicsInsertionPosition.targetIndex))):
            return none
        let ambientRowElement: Any = resolveAmbientRowElementInSurface(ambientSurfaceElement, point)
        let ambientZoneTarget: Any = none
        let zoneId: Any = ambientZoneTarget.zoneElement.dataset.explorerCustomizeZoneId
        let insertionPosition: Any = none
        if (((((surfaceId and zoneId) and insertionPosition) and ts_Number.isFinite(insertionPosition.targetIndex)) and ts_Number.isInteger(insertionPosition.targetIndex))):
            return none
    let removeZone: Any = none
    return none

fn clearHighlightedDropTarget() -> ():
    activeExplorerCustomizePointerSession.onUpdateDropTarget(none)

fn updateHighlightedDropTarget(nextDropTarget: Any) -> Any:
    let currentSession: Any = activeExplorerCustomizePointerSession
    if ((!currentSession)):
        return none
    let currentDropTarget: Any = currentSession.dropTarget
    if (areExplorerCustomizePointerDropTargetsEqual(currentDropTarget, nextDropTarget)):
        return none
    currentSession.onUpdateDropTarget(nextDropTarget)

fn commitExplorerCustomizePointerMove(point: ExplorerCustomizePointerPoint, pointerId: Float) -> Any:
    let currentSession: Any = activeExplorerCustomizePointerSession
    if (((!currentSession) or (currentSession.pointerId != pointerId))):
        return none
    let movedDistance: Any = Math.hypot((point.x - currentSession.startPoint.x), (point.y - currentSession.startPoint.y))
    if (((!currentSession.active) and (movedDistance < EXPLORER_CUSTOMIZE_POINTER_START_DISTANCE_PX))):
        return none
    if ((!currentSession.active)):
        applyBodyDragState()
        currentSession.onActivate(currentSession.controlId)
        currentSession.active = true
    let targetState: Any = resolveExplorerCustomizeDropTargetFromPoint(point)
    updateHighlightedDropTarget(targetState.dropTarget)
    activeExplorerCustomizePointerSession = none
    emitSnapshot()

fn finishExplorerCustomizePointerSession(args: Any) -> Any:
    let currentSession: Any = activeExplorerCustomizePointerSession
    if ((!currentSession)):
        return none
    if (((args.pointerId != none) and (currentSession.pointerId != args.pointerId))):
        return none
    let dragWasActive: Any = currentSession.active
    let dropTarget: Any = currentSession.dropTarget
    let removeTargetActive: Any = currentSession.removeTargetActive
    let controlId: Any = currentSession.controlId
    let sourceKind: Any = currentSession.sourceKind
    let latestPoint: Any = currentSession.latestPoint
    let onTap: Any = currentSession.onTap
    let onDrop: Any = currentSession.onDrop
    let onRemove: Any = currentSession.onRemove
    let onComplete: Any = currentSession.onComplete
    clearHighlightedDropTarget()
    activeExplorerCustomizePointerSession = none
    restoreBodyDragState()
    detachWindowListeners()
    emitSnapshot()
    if ((!dragWasActive)):
        onTap(controlId)
        onComplete()
        return none
    if (args.shouldDrop):
        if ((removeTargetActive and (sourceKind == "placed"))):
            onRemove(controlId)
        else if (dropTarget):
            onDrop(none)
    onComplete()

fn handleWindowPointerMove(event: PointerEvent) -> ():
    commitExplorerCustomizePointerMove(none, event.pointerId)

fn handleWindowPointerUp(event: PointerEvent) -> ():
    finishExplorerCustomizePointerSession(none)

fn handleWindowPointerCancel(event: PointerEvent) -> ():
    finishExplorerCustomizePointerSession(none)

fn handleWindowBlur() -> ():
    finishExplorerCustomizePointerSession(none)

fn handleWindowKeyDown(event: KeyboardEvent) -> Any:
    if ((event.key != "Escape")):
        return none
    finishExplorerCustomizePointerSession(none)

fn attachWindowListeners() -> Any:
    if ((windowListenersAttached or (window == "undefined"))):
        return none
    windowListenersAttached = true
    window.addEventListener("pointermove", handleWindowPointerMove)
    window.addEventListener("pointerup", handleWindowPointerUp)
    window.addEventListener("pointercancel", handleWindowPointerCancel)
    window.addEventListener("blur", handleWindowBlur)
    window.addEventListener("keydown", handleWindowKeyDown)

fn detachWindowListeners() -> Any:
    if (((!windowListenersAttached) or (window == "undefined"))):
        return none
    windowListenersAttached = false
    window.removeEventListener("pointermove", handleWindowPointerMove)
    window.removeEventListener("pointerup", handleWindowPointerUp)
    window.removeEventListener("pointercancel", handleWindowPointerCancel)
    window.removeEventListener("blur", handleWindowBlur)
    window.removeEventListener("keydown", handleWindowKeyDown)

fn cancelExplorerCustomizePointerSession() -> ():
    finishExplorerCustomizePointerSession(none)

fn beginExplorerCustomizePointerSession(args: BeginExplorerCustomizePointerSessionArgs) -> ():
    cancelExplorerCustomizePointerSession()
    activeExplorerCustomizePointerSession = none
    attachWindowListeners()
    emitSnapshot()

type ExplorerBackendContract = Any

type ExplorerLocationListing = Any

const explorerDirectoryResultCache: Any = ts_Map()

fn getExplorerDirectoryCacheKey(path: String, showHidden: Bool) -> Any:
    return none

fn loadCachedExplorerLocation(args: Any) -> Any:
    let key: Any = getExplorerDirectoryCacheKey(args.path, args.showHidden)
    if (args.forceRefresh):
        explorerDirectoryResultCache.delete_(key)
    let cachedValue: Any = explorerDirectoryResultCache.get(key)
    if (cachedValue):
        return none
    let pending: Any = args.listLocation(args.path, args.showHidden).then(none).catch_(none)
    explorerDirectoryResultCache.set(key, pending)
    return pending

fn storeExplorerCachedLocation(args: Any) -> ():
    explorerDirectoryResultCache.set(getExplorerDirectoryCacheKey(args.path, args.showHidden), args.listing)

fn invalidateExplorerDirectoryResultCaches(pathPrefix: String) -> Any:
    if ((!pathPrefix)):
        explorerDirectoryResultCache.clear()
        return none
    for key in [explorerDirectoryResultCache.keys()]:
        let _: Any = key.split("::")
        let cachedPath: Any = none
        if ((cachedPath and cachedPath.startsWith(pathPrefix))):
            explorerDirectoryResultCache.delete_(key)

