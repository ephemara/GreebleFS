fn mergeExplorerMenuPacksWithBuiltInFallback(authoredPacks: [LoadedExplorerMenuPack]) -> [LoadedExplorerMenuPack]:
    let mergedPacks: Any = ts_Map()
    for pack in authoredPacks:
        mergedPacks.set(pack.id, pack)
    let builtInPack: Any = createBuiltInExplorerMenuPack()
    if ((!mergedPacks.has(builtInPack.id))):
        mergedPacks.set(builtInPack.id, builtInPack)
    return ts_Array.from(mergedPacks.values()).sort(none)

