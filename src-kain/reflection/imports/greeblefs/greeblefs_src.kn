fn upsertExplorerBookmark(snapshot: ExplorerRailSnapshot, source: ExplorerBookmarkImportSource, options: Any) -> Any:
    let options: Any = options
    let parentId: Any = (options.parentId or none)
    let existingNode: Any = snapshot.nodes.find(none)
    let categoryIds: Any = normalizeCategoryIds(none)
    let color: Any = (((options.color or suggestBookmarkColor(categoryIds)) or source.color) or none)
    if (existingNode):
        let updatedNode: Option<Any> = none
        return none
    let now: Any = Date.now()
    let node: Option<Any> = none
    return none

