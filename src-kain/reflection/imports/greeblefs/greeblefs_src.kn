component FixtureHostSmokePage() with Reactive:
    state homeDir: Any = none
    state entries: [FixtureFileEntry] = []
    state mode: PickerMode = "openFolders"
    state selectedPath: Any = none
    state confirmedPath: Any = "none"
    fn setHomeDir(value: Any):
        homeDir = value

    fn setEntries(value: [FixtureFileEntry]):
        entries = value

    fn setMode(value: PickerMode):
        mode = value

    fn setSelectedPath(value: Any):
        selectedPath = value

    fn setConfirmedPath(value: Any):
        confirmedPath = value

    fn selectedEntry() -> Any:
        return (entries.find(none) or none)

    fn __component_effect_0() -> Any:
        let cancelled: Any = false
        let loadFixtureDirectory: Any = none
        loadFixtureDirectory()
        return none

    fn selectMode(nextMode: PickerMode):
        setMode(nextMode)
        setSelectedPath(none)
        setConfirmedPath("none")

    fn confirmSelected() -> Any:
        if ((mode == "openFolders")):
            setConfirmedPath(homeDir)
            return none
        if ((selectedEntry and (!selectedEntry.is_dir))):
            setConfirmedPath(selectedEntry.path)

    render <main style={none}><header style={none}><strong data_testid="proof-title" style={none}>{"Tauron UI fixture proof"}</strong><button data_testid="mode-folders" onClick={none} type="button">{"Folders"}</button><button data_testid="mode-files" onClick={none} type="button">{"Files"}</button><span data_testid="picker-mode" style={none}>{mode}</span><span data_testid="confirmed-paths" style={none}>{confirmedPath}</span></header><section data_testid="fixture-grid" style={none}>{none}</section><footer style={none}><button data_testid="confirm-current-folder" onClick={confirmSelected} type="button">{none}</button></footer></main>

