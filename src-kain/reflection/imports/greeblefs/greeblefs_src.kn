fn resolveOrbitEntryPlacement(index: Float, total: Float) -> Any:
    let compactPresets: Option<Any> = none
    let preset: Any = compactPresets[total]
    if (preset):
        return ((preset[index] or preset[(preset.length - 1)]) or none)
    let safeTotal: Any = Math.max(total, 1)
    let angle: Any = ((((((Math.PI * 2)) / safeTotal)) * index) - (Math.PI / 2))
    let radiusX: Any = none
    let radiusY: Any = none
    return none

fn resolveModeIcon(mode: ExplorerCollectionPreviewMode) -> Any:
    if ((mode == "overview")):
        return LayoutGrid
    else if ((mode == "strata")):
        return Layers3
    else if ((mode == "timeline")):
        return ScanLine
    else if ((mode == "orbit")):
        return Sparkles
    else if ((mode == "list")):
        ()
    else:
        return List

fn resolveCollectionEntryCategory(entry: ExplorerFileEntry) -> Any:
    if (entry.is_dir):
        return "folders"
    if (getExplorerArchiveDescriptor(entry)):
        return "packages"
    if ((((isImagePreviewExtension(entry.extension) or isVideoPreviewExtension(entry.extension)) or isAudioPreviewExtension(entry.extension)) or isModelPreviewExtension(entry.extension))):
        return "media"
    if (((isPdfPreviewExtension(entry.extension) or isSpreadsheetPreviewExtension(entry.extension)) or documentPreviewExtensionSet.has(normalizeEntryExtension(entry)))):
        return "documents"
    if ((isShaderPreviewExtension(entry.extension) or isEditableTextExtension(entry.extension, entry.size))):
        return "code"
    return "other"

fn resolveCollectionEntryRecencyBucket(entry: ExplorerFileEntry) -> Any:
    if (((!ts_Number.isFinite(entry.modified)) or (entry.modified <= 0))):
        return "undated"
    let ageMs: Any = (Date.now() - entry.modified)
    if ((ageMs <= (((24 * 60) * 60) * 1000))):
        return "fresh"
    if ((ageMs <= ((((7 * 24) * 60) * 60) * 1000))):
        return "recent"
    return "older"

fn formatSize(bytes: Float) -> Any:
    if ((bytes < 1024)):
        return bytes + " B"
    if ((bytes < (1024 * 1024))):
        return ((bytes / 1024)).toFixed(1) + " KB"
    if ((bytes < (1024 ** 3))):
        return ((bytes / (1024 ** 2))).toFixed(1) + " MB"
    if ((bytes < (1024 ** 4))):
        return ((bytes / (1024 ** 3))).toFixed(2) + " GB"
    return ((bytes / (1024 ** 4))).toFixed(2) + " TB"

fn formatModifiedLabel(timestampMs: Float) -> Any:
    if (((!ts_Number.isFinite(timestampMs)) or (timestampMs <= 0))):
        return none
    return Intl.DateTimeFormat(undefined, none).format(Date(timestampMs))

fn normalizeEntryExtension(entry: ExplorerFileEntry) -> String:
    return entry.extension.trim().toLowerCase().replace(none, "")

fn getCollectionEntryBadgeLabel(entry: ExplorerFileEntry) -> Any:
    if (entry.is_dir):
        return "DIR"
    let extension: Any = normalizeEntryExtension(entry)
    if ((!extension)):
        return "FILE"
    return extension.slice(0, 4).toUpperCase()

fn resolveCollectionEntrySecondaryLabel(entry: ExplorerFileEntry) -> Any:
    if (entry.is_dir):
        return "Folder"
    return formatSize(entry.size)

fn getCollectionEntryParentLabel(path: String) -> Any:
    let archiveLocation: Any = parseExplorerArchiveVirtualPath(path)
    if (archiveLocation):
        let segments: Any = archiveLocation.entryPath.split("/").filter(ts_Boolean)
        if ((segments.length <= 1)):
            return none
        segments.pop()
        return segments.join("/")
    let trimmedPath: Any = path.replace(none, "")
    let segments: Any = trimmedPath.split(none).filter(ts_Boolean)
    if ((segments.length <= 1)):
        return none
    segments.pop()
    return segments.join("/")

