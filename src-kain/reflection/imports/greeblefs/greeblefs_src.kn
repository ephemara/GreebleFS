fn normalizeTerminalSettings(base: TerminalSettings, updates: Any) -> Any:
    let merged: Any = none
    let windowedSize: Any = normalizePanelWindowStoredSize(none)
    let hasExplicitShellProfile: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "shellProfile"))
    let hasExplicitShellPath: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "shellPath"))
    let hasExplicitShellArgs: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "shellArgs"))
    let hasExplicitLegacyShell: Any = ((updates != none) and ts_Object.prototype.hasOwnProperty.call(updates, "shell"))
    let baseShellProfile: Any = normalizeIntegratedTerminalProfile(base.shellProfile)
    let baseShellPath: Any = normalizeTerminalShellText(base.shellPath)
    let baseShellArgs: Any = normalizeTerminalShellText(base.shellArgs)
    let normalizedShellConfig: Any = none
    let normalizedShellProfile: Any = normalizeIntegratedTerminalProfile(normalizedShellConfig.shellProfile)
    let shellTemplate: Any = getIntegratedTerminalProfileTemplate(normalizedShellProfile)
    let normalizedShellPath: Any = (normalizedShellConfig.shellPath or shellTemplate.shellPath)
    let normalizedShellArgs: Any = (normalizedShellConfig.shellArgs or shellTemplate.shellArgs)
    return none

