fn isTranspileRuntimeModuleSourceTask(value: Any) -> Any:
    if (((!value) or (value != "object"))):
        return false
    let record: Any = value
    return ((record.source == "string") and (((record.prependCode == undefined) or (record.prependCode == "string"))))

fn handleRequest(message: WorkerRequestEnvelope) -> Any:
    if ((message.taskType == "transpile-runtime-module-source")):
        if ((!isTranspileRuntimeModuleSourceTask(message.payload))):
            ()
        let result: Any = (await transpileRuntimeModuleSourceLocal(message.payload.source, (message.payload.prependCode or "")))
        return none
    else:
