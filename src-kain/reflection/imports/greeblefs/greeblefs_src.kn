    builtInExplorerWorkspaceLayouts = resolveBuiltInExplorerWorkspaceLayouts(manifest)

fn normalizeExplorerWorkspaceLayoutMode(value: Any) -> Any:
    if (((value == "split") or (value == "dual"))):
        return "split"
    if (((value == "triple") or (value == "triad"))):
        return "triple"
    if ((value == "quad")):
        return "quad"
    return defaultExplorerWorkspaceLayoutMode

fn getExplorerWorkspaceLayoutDefinition(layoutMode: Any) -> ExplorerWorkspaceLayoutDefinition:
    return builtInExplorerWorkspaceLayouts[normalizeExplorerWorkspaceLayoutMode(layoutMode)]

fn getExplorerWorkspaceVisiblePaneIds(layoutMode: Any) -> [ExplorerPaneId]:
    return getExplorerWorkspaceLayoutDefinition(layoutMode).visiblePaneIds

fn normalizeExplorerPaneId(value: Any) -> Any:
    if ((value == "pane-2")):
        ()
    else if ((value == "right")):
        return "pane-2"
    else if ((value == "pane-3")):
        return "pane-3"
    else if ((value == "pane-4")):
        return "pane-4"
    else if ((value == "pane-1")):
        ()
    else if ((value == "left")):
        ()
    else:
        return "pane-1"

fn getExplorerPaneIndex(paneId: ExplorerPaneId) -> Float:
    return explorerPaneIds.indexOf(paneId)

fn getExplorerPaneLabel(paneId: ExplorerPaneId) -> String:
    return "Pane " + (getExplorerPaneIndex(paneId) + 1)

fn createEmptyExplorerPaneRecord(factory: Any) -> Any:
    return ts_Object.fromEntries(explorerPaneIds.map(none))

fn clampExplorerWorkspaceAxisRatio(value: Any) -> Any:
    if (((value != "number") or (!ts_Number.isFinite(value)))):
        return defaultExplorerWorkspaceAxisRatio
    return Math.max(EXPLORER_WORKSPACE_AXIS_RATIO_BOUNDS.min, Math.min(EXPLORER_WORKSPACE_AXIS_RATIO_BOUNDS.max, value))

