fn formatBytes(bytes: Float) -> Any:
    if ((bytes <= 0)):
        return "0 B"
    if ((bytes < 1024)):
        return bytes + " B"
    if ((bytes < (1024 * 1024))):
        return ((bytes / 1024)).toFixed(1) + " KB"
    if ((bytes < (1024 ** 3))):
        return ((bytes / (1024 ** 2))).toFixed(1) + " MB"
    return ((bytes / (1024 ** 3))).toFixed(2) + " GB"

fn getPathLeaf(path: String) -> Any:
    let trimmed: Any = path.replace(none, "")
    if (((!trimmed) or isExplorerHomePath(trimmed))):
        return "Home"
    let segments: Any = trimmed.split(none).filter(ts_Boolean)
    return (segments[(segments.length - 1)] or trimmed)

fn getLocalDriveTotalBytes(drive: ExplorerDriveInfo) -> Any:
    if ((drive.kind != "local")):
        return 0
    let legacyTotalBytes: Any = (drive).total_bytes
    if ((drive.totalBytes == "number")):
        return drive.totalBytes
    return none

fn getLocalDriveFreeBytes(drive: ExplorerDriveInfo) -> Any:
    if ((drive.kind != "local")):
        return 0
    let legacyFreeBytes: Any = (drive).free_bytes
    if ((drive.freeBytes == "number")):
