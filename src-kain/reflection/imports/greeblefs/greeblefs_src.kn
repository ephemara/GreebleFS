fn formatPluginSettingsValueJson(value: OverlayPluginSettingsValue) -> Any:
    if ((value == none)):
        return "null"
    if ((value == "string")):
        return value
    return JSON.stringify(value, none, 2)

fn parsePluginSettingsJsonDraft(draft: String) -> Any:
    let trimmedDraft: Any = draft.trim()
    if ((!trimmedDraft)):
        return none

fn parsePluginSettingsTextList(value: OverlayPluginSettingsValue) -> Any:
    if (ts_Array.isArray(value)):
        return value.flatMap(none)
    if ((value != "string")):
        return []
    return value.split(none).map(none).filter(ts_Boolean)

fn dedupePluginSettingsListEntries(entries: [String]) -> [String]:
    let seen: Any = ts_Set()
    let normalizedEntries: [String] = []
    for entry in entries:
        let normalizedEntry: Any = entry.trim()
        let key: Any = normalizedEntry.toLocaleLowerCase()
        if (((!normalizedEntry) or seen.has(key))):
            continue
        seen.add(key)
        normalizedEntries.push(normalizedEntry)
    return normalizedEntries

fn normalizeExtensionToken(value: String) -> String:
    return value.trim().replace(none, "").toLocaleLowerCase()

fn formatPathListValue(paths: [String]) -> String:
    return dedupePluginSettingsListEntries(paths).join(none)

fn formatExtensionListValue(extensions: [String]) -> String:
