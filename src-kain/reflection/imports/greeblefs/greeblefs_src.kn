fn pushUtf8(table: [Float], value: String) -> (Float, Float):
    let bytes: Any = [TextEncoder().encode(value)]
    let offset: Any = table.length
    table.push(none)
    return [offset, bytes.length]

fn writeU16(bytes: [Float], value: Float) -> ():
    bytes.push((value & 255), (((value >> 8)) & 255))

fn writeU32(bytes: [Float], value: Float) -> ():
    bytes.push((value & 255), (((value >> 8)) & 255), (((value >> 16)) & 255), (((value >> 24)) & 255))

fn writeU64(bytes: [Float], value: Int) -> ():
    let index: Any = 0
    while ((index < 8)):
        bytes.push(ts_Number((((value >> ((index * 8)))) & "0xff")))
        index = (index + 1)

fn createDirectorySnapshotFixture() -> Uint8Array:
    let strings: [Float] = []
    let name: Any = pushUtf8(strings, none)
    let path: Any = pushUtf8(strings, none)
    let extension: Any = pushUtf8(strings, "txt")
    let entityId: Any = pushUtf8(strings, "entity-1")
    let contentRevision: Any = pushUtf8(strings, "rev-1")
    let bytes: [Float] = []
    bytes.push(none)
    writeU16(bytes, 1)
    writeU16(bytes, 32)
    writeU32(bytes, 1)
    writeU32(bytes, 64)
    writeU32(bytes, 32)
    writeU32(bytes, 96)
    writeU32(bytes, strings.length)
    writeU32(bytes, 0)
    for _item in [name, path, extension, entityId, contentRevision]:
        let offset: Any = none
        let length: Any = none
        let offset: Any = none
        let length: Any = none
        writeU32(bytes, offset)
        writeU32(bytes, length)
    writeU64(bytes, 42)
    writeU64(bytes, "1_700_000_000_000")
    writeU32(bytes, 6)
    writeU16(bytes, 1)
    writeU16(bytes, 0)
    bytes.push(none)
    return Uint8Array(bytes)

