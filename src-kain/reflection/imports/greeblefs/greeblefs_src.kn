    return none

fn getAccelerationRoutingModeLabel(value: AccelerationRoutingMode) -> String:
    return ((accelerationRoutingModeOptions.find(none).label or "Auto"))

fn getAccelerationWorkloadDefinition(workloadId: AccelerationWorkloadId) -> AccelerationWorkloadDefinition:
    return ((accelerationWorkloadCatalog.find(none) or accelerationWorkloadCatalog[0]))

fn findAccelerationProviderStatus(snapshot: AccelerationRuntimeSnapshotLike, providerKind: AccelerationProviderKind) -> Any:
    return ((snapshot.providers.find(none) or none))

fn reorderProviderOrder(providerOrder: Any, mode: AccelerationRoutingMode) -> Any:
    if ((mode == "cpuOnly")):
        return ["cpu"]
    let nextOrder: Any = [providerOrder]
    let promote: Any = none
    if (((!promote) or (!nextOrder.includes(promote)))):
        return nextOrder
    return [promote, nextOrder.filter(none)]

fn resolveAccelerationProviderForWorkload(snapshot: AccelerationRuntimeSnapshotLike, workloadId: AccelerationWorkloadId, mode: AccelerationRoutingMode) -> Any:
    let definition: Any = getAccelerationWorkloadDefinition(workloadId)
    let orderedProviders: Any = reorderProviderOrder(definition.defaultProviderOrder, mode)
    let candidateProviders: Any = orderedProviders.map(none).filter(none)
    let readyProvider: Any = ((candidateProviders.find(none) or candidateProviders.find(none)) or findAccelerationProviderStatus(snapshot, "cpu"))
    return none

