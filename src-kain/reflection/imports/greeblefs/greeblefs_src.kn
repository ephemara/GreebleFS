fn buildTicks(duration: Float) -> Any:
    if (((!ts_Number.isFinite(duration)) or (duration <= 0))):
        return [0]
    let steps: Any = [1, 2, 5, 10, 15, 30, 60, 120, 300, 600, 1800]
    let minStep: Any = (duration / 6)
    let step: Any = (steps.find(none) or 3600)
    let ticks: [Float] = []
    let t: Any = 0
    while ((t <= duration)):
        ticks.push(parseFloat(t.toFixed(4)))
        t = (t + step)
    if ((ticks[(ticks.length - 1)] != duration)):
        ticks.push(duration)
    return ticks

fn buildTrimmedVideoOutputPath(sourcePath: String) -> String:
    let match_: Any = sourcePath.match_(none)
    let parentPath: Any = (match_[1] or "")
    let leafName: Any = (match_[2] or sourcePath)
    let stem: Any = leafName.replace(none, "")
    return parentPath + stem + ".trimmed.mp4"

