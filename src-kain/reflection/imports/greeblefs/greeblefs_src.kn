fn getDraggedBlockElement(view: EditorView, pos: Float) -> Any:
    let nodeDom: Any = view.nodeDOM(pos)
    if ((ts_instanceof_operator(nodeDom, Element) and (nodeDom != view.dom))):
        return nodeDom
    let _: Any = view.domAtPos(pos)
    let node: Any = none
    let offset: Any = none
    let child: Any = node.childNodes[offset]
    if (ts_instanceof_operator(child, Element)):
        return child
    if (ts_instanceof_operator(node, Element)):
        return node
    if (((node.nodeType == Node.TEXT_NODE) and node.parentElement)):
        return node.parentElement
    return none

