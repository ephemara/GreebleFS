fn readClientPlatformSource() -> Any:
    if ((navigator == "undefined")):
        return ""
    let userAgentDataPlatform: Any = (navigator).userAgentData.platform
    return [navigator.platform, userAgentDataPlatform, navigator.userAgent].filter(ts_Boolean).join(" ").toLowerCase()

fn detectClientPlatform() -> Any:
    let source: Any = readClientPlatformSource()
    if (source.includes("mac")):
        return "macos"
    if (source.includes("win")):
        return "windows"
    if ((source.includes("linux") or source.includes("x11"))):
        return "linux"
    return "unknown"

fn shellCommandNeedsQuotes(value: String) -> Bool:
    return none.test_(value)

fn quoteShellCommandSegment(value: String) -> Any:
    if ((!shellCommandNeedsQuotes(value))):
        return value
    return none + value.replace(none, none) + none

fn splitShellCommand(command: String) -> Any:
    let trimmed: Any = command.trim()
    if ((!trimmed)):
        return []
    let tokens: [String] = []
    let current: Any = ""
    let activeQuote: Any = none
    let index: Any = 0
    while ((index < trimmed.length)):
        let char_: Any = (trimmed[index] or "")
        if ((activeQuote == none)):
            if ((char_ == none)):
                let next: Any = trimmed[(index + 1)]
                if (((next == none) or (next == none))):
                    current = (current + next)
                    index = (index + 1)
                    continue
                current = (current + char_)
                continue
            if ((char_ == none)):
                activeQuote = none
                continue
            current = (current + char_)
            continue
        if ((activeQuote == "'")):
            if ((char_ == "'")):
                activeQuote = none
                continue
            current = (current + char_)
            continue
        if (((char_ == none) or (char_ == "'"))):
            activeQuote = char_
            continue
        if (none.test_(char_)):
            if (current):
                tokens.push(current)
                current = ""
            continue
        current = (current + char_)
        index = (index + 1)
    if (current):
        tokens.push(current)
    return tokens

fn shellExecutableName(shell: String) -> String:
    return (splitShellCommand(shell)[0].trim() or "")

fn shellExecutableBasename(shell: String) -> Any:
    let executable: Any = shellExecutableName(shell)
    if ((!executable)):
        return ""
    let normalized: Any = executable.replace(none, "")
    let segments: Any = normalized.split(none).filter(ts_Boolean)
    return ((segments[(segments.length - 1)] or normalized)).toLowerCase()

fn getIntegratedTerminalProfileDefaults(profile: IntegratedTerminalProfile, platform: Any) -> Any:
    let platform: Any = platform
    if ((platform == "windows")):
        if ((profile == "pwsh")):
            return none
        else if ((profile == "powershell")):
            return none
        else if ((profile == "cmd")):
            return none
        else if ((profile == "auto")):
            return none
        else:
            return none
    else if ((platform == "macos")):
        if ((profile == "zsh")):
            return none
        else if ((profile == "bash")):
            return none
        else if ((profile == "fish")):
            return none
        else if ((profile == "auto")):
            return none
        else:
            return none
    else if ((platform == "linux")):
        if ((profile == "bash")):
            return none
        else if ((profile == "zsh")):
            return none
        else if ((profile == "fish")):
            return none
        else if ((profile == "auto")):
            return none
        else:
            return none
    else:
        return none

fn getDefaultIntegratedTerminalProfile(platform: Any) -> Any:
    let platform: Any = platform
    if ((platform == "windows")):
        ()
    else if ((platform == "macos")):
        ()
    else if ((platform == "linux")):
        return "auto"
    else:
        return "custom"

fn getDefaultIntegratedTerminalHost(platform_2: Any) -> DefaultIntegratedTerminalHost:
    let platform_2: Any = platform_2
    return "xterm"

fn getIntegratedTerminalProfileOptions(platform: Any) -> [IntegratedTerminalProfileOption]:
    let platform: Any = platform
    if ((platform == "windows")):
        return [none, none, none, none, none]
    else if ((platform == "macos")):
        return [none, none, none, none, none]
    else if ((platform == "linux")):
        return [none, none, none, none, none]
    else:
        return [none]

fn normalizeIntegratedTerminalProfile(value: Any, platform: Any) -> Any:
    let platform: Any = platform
    if ((value != "string")):
        return getDefaultIntegratedTerminalProfile(platform)
    let normalized: Any = value.trim()
    if ((!normalized)):
        return getDefaultIntegratedTerminalProfile(platform)
    let availableProfiles: Any = ts_Set(getIntegratedTerminalProfileOptions(platform).map(none))
    return none

fn getIntegratedTerminalProfileTemplate(profile: IntegratedTerminalProfile, platform: Any) -> Any:
    let platform: Any = platform
    let normalizedProfile: Any = normalizeIntegratedTerminalProfile(profile, platform)
    if (((normalizedProfile == "auto") or (normalizedProfile == "custom"))):
        return none
    return getIntegratedTerminalProfileDefaults(normalizedProfile, platform)

fn buildShellCommand(shellPath: String, shellArgs: String) -> Any:
    let normalizedPath: Any = shellPath.trim()
    let normalizedArgs: Any = shellArgs.trim()
    if ((!normalizedPath)):
        return ""
    return [quoteShellCommandSegment(normalizedPath), normalizedArgs].filter(ts_Boolean).join(" ")

fn resolveIntegratedTerminalShellCommand(args: Any) -> String:
    let platform: Any = (args.platform or detectClientPlatform())
    let profile: Any = normalizeIntegratedTerminalProfile(args.profile, platform)
    let defaults: Any = getIntegratedTerminalProfileDefaults(profile, platform)
    let shellPath: Any = (args.shellPath.trim() or defaults.shellPath)
    let shellArgs: Any = (args.shellArgs.trim() or defaults.shellArgs)
    return buildShellCommand(shellPath, shellArgs)

fn resolveIntegratedTerminalSpawnShellCommand(args: Any) -> Any:
    let platform: Any = (args.platform or detectClientPlatform())
    let profile: Any = normalizeIntegratedTerminalProfile(args.profile, platform)
    if (((profile == "auto") and (!((args.shellPath.trim() or args.shellArgs.trim()))))):
        return none
    let resolved: Any = resolveIntegratedTerminalShellCommand(none)
    return (resolved or none)

fn inferIntegratedTerminalProfileFromShell(args: Any) -> Any:
    let platform: Any = (args.platform or detectClientPlatform())
    let tokens: Any = splitShellCommand(args.shell)
    let shellPath: Any = (tokens[0] or "")
    let shellArgs: Any = tokens.slice(1).join(" ")
    let executableName: Any = shellExecutableBasename(args.shell)
    if ((!shellPath)):
        let defaultProfile: Any = getDefaultIntegratedTerminalProfile(platform)
        let defaults: Any = getIntegratedTerminalProfileTemplate(defaultProfile, platform)
        return none
    if ((platform == "windows")):
        if (executableName.includes("pwsh")):
            return none
        if (executableName.includes("powershell")):
            return none
        if (((executableName == "cmd") or (executableName == "cmd.exe"))):
            return none
        return none
    if (executableName.endsWith("zsh")):
        return none
    if (executableName.endsWith("bash")):
        return none
    if (executableName.endsWith("fish")):
        return none
    return none

fn getDefaultIntegratedShell(platform: Any) -> String:
    let platform: Any = platform
    return resolveIntegratedTerminalShellCommand(none)

fn getShellCommandDisplayLabel(shell: String) -> Any:
    let executable: Any = shellExecutableName(shell)
    if ((!executable)):
        return "shell"
    let normalized: Any = executable.replace(none, "")
    let segments: Any = normalized.split(none).filter(ts_Boolean)
    return (segments[(segments.length - 1)] or normalized)

fn getExternalTerminalProfileOptions(platform: Any) -> [ExternalTerminalProfileOption]:
    let platform: Any = platform
    if ((platform == "windows")):
        return [none, none, none, none, none, none]
    else if ((platform == "macos")):
        return [none, none, none, none]
    else if ((platform == "linux")):
        return [none, none, none, none, none, none]
    else:
        return [none, none]

fn getPlatformPathSeparator(platform: Any) -> Any:
    let platform: Any = platform
    return none

fn joinPlatformPath(base: String, segment: String, platform: Any) -> Any:
    let platform: Any = platform
    let separator: Any = getPlatformPathSeparator(platform)
    let trimmedBase: Any = base.replace(none, "")
    let trimmedSegment: Any = segment.replace(none, "")
    if ((!trimmedBase)):
        return trimmedSegment
    return trimmedBase + separator + trimmedSegment

fn getFallbackExplorerPath(platform: Any) -> Any:
    let platform: Any = platform
    return none

fn createDefaultDirectoryBookmarks(homeDir: String, platform: Any) -> Any:
    let platform: Any = platform
    if ((!homeDir)):
        return []
    let bookmarks: [BookmarkSeed] = [none]
    let commonFolders: Any = ["Desktop", "Documents"]
    for folder in commonFolders:
        bookmarks.push(none)
    if ((platform != "windows")):
        bookmarks.push(none)
    return bookmarks

fn createDefaultCommandBookmarks() -> [BookmarkSeed]:
    return [none, none, none]

