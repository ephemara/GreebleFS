fn deduplicateDriveRoots(drives: [DriveInfo]) -> [String]:
    let seen: Any = ts_Set()
    let roots: [String] = []
    for drive in drives:
        let root: Any = drive.path.trim()
        if (((!root) or seen.has(root))):
            continue
        seen.add(root)
        roots.push(root)
    return roots

fn shouldAutoIndexDrive(drive: DriveInfo) -> Any:
    if ((((!drive.supportsScan) or drive.isNetwork) or drive.isRemovable)):
        return false
    return ((((drive.classification != "optical") and (drive.classification != "virtual")) and (drive.classification != "unknown")))

fn mergeGlobalSearchResults(args: Any) -> [GlobalSearchResultEntry]:
    let mergedByPath: Any = ts_Map()
    for result in args.priorityResults:
        mergedByPath.set(result.path, result)
    for result in args.indexedResults:
        if ((!mergedByPath.has(result.path))):
            mergedByPath.set(result.path, result)
    let mergedResults: Any = [mergedByPath.values()]
    mergedResults.sort(none)
    return mergedResults.slice(0, args.limit)

