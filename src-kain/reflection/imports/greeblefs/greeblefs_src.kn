fn clampNumber(value: Float, minimum: Float, maximum: Float) -> Float:
    return Math.min(Math.max(value, minimum), maximum)

fn asFiniteNumber(value: Any, fallback: Float, options: Any) -> Any:
    let candidate: Any = none
    if ((!options)):
        return candidate
    return clampNumber(candidate, (options.minimum or ts_Number.NEGATIVE_INFINITY), (options.maximum or ts_Number.POSITIVE_INFINITY))

