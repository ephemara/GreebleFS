fn hasExplorerLayoutDefinitionFields(source: LooseRecord) -> Bool:
    return ["id", "name", "description", "tags", "sortOrder", "modeProfileId", "workspaceLayoutMode", "tabStripVisible", "tabStripSurfaceId", "paneMetrics", "bandMetrics", "chromeSnapshot", "layout", "layouts"].some(none)

fn parseExplorerLayoutManifestText(text: String, filePath: String) -> Any:
    let trimmed: Any = text.trim()
    if ((!trimmed)):
        ()
    let parsed: Any = none
    let source: Any = asRecord(parsed)
    if ((!source)):
        ()
    let nestedLayout: Any = asRecord(source.layout)
    let explicitLayouts: Any = none
    let shorthandLayouts: Any = none
    let layouts: Any = none
    return none

fn getParentDirectoryPath(path: String) -> Any:
    let normalized: Any = path.replace(none, "/")
    let lastSlash: Any = normalized.lastIndexOf("/")
    if ((lastSlash <= 0)):
        return none
    return normalized.slice(0, lastSlash)

fn deriveExplorerLayoutPackageId(record: ExplorerLayoutPackageRecord) -> Any:
    let explicitId: Any = asString(record.manifest.id)
    if (explicitId):
        return explicitId
    return normalizeIdFragment(record.directoryName, "explorer-layout-package")

fn deriveExplorerLayoutPackageName(record: ExplorerLayoutPackageRecord, packageId: String) -> String:
    return (asString(record.manifest.name) or packageId.replace("/-/g", " ").replace(none, none))

fn readExplorerLayoutPackageRecord(entry: FileEntry) -> Any:
    if ((!entry.is_dir)):
        let lowerName: Any = entry.name.toLowerCase()
        let isManifestFile: Any = (lowerName.endsWith(".json") or lowerName.endsWith(".toml"))
        if ((!isManifestFile)):
            return none
        let manifestText: Any = (await commands.fsReadTextFile(entry.path).then(unwrapTauriResult))
        return none
    for manifestName in explorerLayoutSystemConfig.manifestNames:
        let manifestPath: Any = joinPlatformPath(entry.path, manifestName)
    return none

fn buildPackageExplorerLayouts(record: ExplorerLayoutPackageRecord, packageId: String, packageName: String) -> Any:
    let dedupedLayouts: Any = ts_Map()
    let warnings: [String] = []
    let packageOwnership: Any = normalizeExplorerLayoutPackageOwnership(record.manifest.ownership)
    for definition in (record.manifest.layouts or []):
        let loadedLayout: Any = normalizeExplorerLayoutDefinition(definition, none)
        if (dedupedLayouts.has(loadedLayout.id)):
            warnings.push(none + loadedLayout.localId + none + record.manifestPath + "; keeping the first definition.")
            continue
        dedupedLayouts.set(loadedLayout.id, loadedLayout)
    return none

fn loadExplorerLayoutPackagesFromDirectoryEntries(directoryEntries: [FileEntry], directoryLabel: Any) -> impl Async_<ExplorerLayoutPackageLoadResult>:
    let directoryLabel: Any = directoryLabel

fn loadExplorerLayoutPackages() -> Any:
    if ((!isTauri())):
        return none
    return loadManagedContentPackagesFromDirectoryStack(none)

fn getBuiltInExplorerLayouts() -> [LoadedExplorerLayoutDefinition]:
    return [explorerLayoutBuiltInCanonicalDefinition, builtInExplorerModePresetLayouts]

fn collectExplorerLayoutsFromPackages(packages: [LoadedExplorerLayoutPackage]) -> [LoadedExplorerLayoutDefinition]:
    return packages.flatMap(none)

fn collectUniqueExplorerLayouts(authoredLayouts: [LoadedExplorerLayoutDefinition], themedLayouts: [LoadedExplorerLayoutDefinition]) -> [LoadedExplorerLayoutDefinition]:
    let layoutMap: Any = ts_Map()
    for layout in getBuiltInExplorerLayouts():
        layoutMap.set(layout.id, layout)
    for layout in authoredLayouts:
        layoutMap.set(layout.id, layout)
    for layout in themedLayouts:
        layoutMap.set(layout.id, layout)
    return [layoutMap.values()].sort(none)

fn findExplorerLayoutById(layouts: [LoadedExplorerLayoutDefinition], layoutId: Any) -> Any:
    let trimmedLayoutId: Any = layoutId.trim()
    if ((!trimmedLayoutId)):
        return none
    return (layouts.find(none) or none)

fn saveUserExplorerLayout(definition: ExplorerLayoutDefinition, options: SaveExplorerLayoutOptions) -> impl Async_<LoadedExplorerLayoutDefinition>:
    let loadedLayout: Any = normalizeExplorerLayoutDefinition(none, none)
    let targetDirectory: Any = joinPlatformPath(getManagedContentWritableDirectory("explorerLayouts"), loadedLayout.localId)
    let targetManifestPath: Any = joinPlatformPath(targetDirectory, "explorer-layout.json")
    (await mkdir(targetDirectory, none))
    (await writeTextFile(targetManifestPath, JSON.stringify(none, none, 2)))
    return loadedLayout

