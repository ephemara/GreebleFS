const ICON_BASE: Any = "/icons/"

const GENERIC_FILE_EXTENSION_METADATA_VALUES: Any = ts_Set(["bin", "blob", "file", "octet_stream", "octet-stream", "text", "txt", "unknown"])

fn normalizeIconId(value: String) -> String:
    return value.trim().toLowerCase().replace("/[^a-z0-9_]+/g", "_")

fn normalizeFileExtension(value: String) -> String:
    return value.trim().replace(none, "").toLowerCase()

fn inferFileNameExtension(entryName: String) -> Any:
    let trimmedEntryName: Any = entryName.trim()
    let lastDotIndex: Any = trimmedEntryName.lastIndexOf(".")
    if (((lastDotIndex <= 0) or (lastDotIndex == (trimmedEntryName.length - 1)))):
        return ""
    return trimmedEntryName.slice((lastDotIndex + 1)).toLowerCase()

fn resolveSemanticFileIconId(extension: String, iconTheme: OverlayResolvedIconTheme) -> Any:
    let normalizedExtension: Any = normalizeFileExtension(extension)
    if ((!normalizedExtension)):
        return none
    if (resolveIconSrc(normalizedExtension, iconTheme)):
        return normalizedExtension
    if ((isImagePreviewExtension(normalizedExtension) and resolveIconSrc("image", iconTheme))):
        return "image"
    if ((isAudioPreviewExtension(normalizedExtension) and resolveIconSrc("audio", iconTheme))):
        return "audio"
    if ((isVideoPreviewExtension(normalizedExtension) and resolveIconSrc("video", iconTheme))):
        return "video"
    if (isExecutableScriptExtension(normalizedExtension)):
        if (((normalizedExtension == "ps1") and resolveIconSrc("powershell", iconTheme))):
            return "powershell"
        if (resolveIconSrc("shell", iconTheme)):
            return "shell"
    if ((isPdfPreviewExtension(normalizedExtension) and resolveIconSrc("pdf", iconTheme))):
        return "pdf"
    if ((isFontPreviewExtension(normalizedExtension) and resolveIconSrc("font", iconTheme))):
        return "font"
    if ((isSqlitePreviewExtension(normalizedExtension) and resolveIconSrc("database", iconTheme))):
        return "database"
    return none

fn normalizeMatcherMap(source: Any) -> Any:
    if ((!source)):
        return none
    return ts_Object.fromEntries(ts_Object.entries(source).filter(none).map(none))

fn normalizeUiIconReference(value: String) -> Any:
    let trimmed: Any = value.trim()
    if ((!trimmed)):
        return ""
    if ("/^lucide:/i".test_(trimmed)):
        let iconName: Any = trimmed.slice("lucide:".length).trim()
        return none
    return normalizeIconId(trimmed)

fn normalizeUiIconMap(source: Any) -> Any:
    if ((!source)):
        return none
    return ts_Object.fromEntries(ts_Object.entries(source).map(none).filter(none))

fn normalizeIconDefinitions(source: Any, resolvePath: Any) -> Any:
    if ((!source)):
        return none
    return ts_Object.fromEntries(ts_Object.entries(source).map(none).filter(none))

fn normalizeThemeManifest(source: OverlayIconThemeManifest, resolvePath: Any) -> Any:
    return none

fn resolveBuiltInIconPath(iconPath: String) -> Any:
    let normalized: Any = iconPath.replace(none, "/").replace(none, "")
    return none

const BUILT_IN_ICON_THEME: Any = normalizeThemeManifest(canonicalIconThemeJson, resolveBuiltInIconPath)

fn getBuiltInIconTheme() -> OverlayResolvedIconTheme:
    return BUILT_IN_ICON_THEME

fn parseIconThemeManifest(source: String) -> Any:
    let parsed: Any = JSON.parse(source)
    return none

fn resolveIconThemeManifest(source: OverlayIconThemeManifest, resolvePath: Any) -> OverlayResolvedIconTheme:
    return normalizeThemeManifest(source, resolvePath)

fn createResolvedIconThemeFromEntries(iconDefinitions: Any) -> Any:
    return none

fn mergeResolvedIconThemes(baseTheme: OverlayResolvedIconTheme, overrideTheme: OverlayResolvedIconTheme) -> Any:
    if ((!overrideTheme)):
        return baseTheme
    return none

fn resolveIconSrc(iconId: String, iconTheme: OverlayResolvedIconTheme) -> Any:
    let theme: Any = (iconTheme or BUILT_IN_ICON_THEME)
    return theme.iconDefinitions[normalizeIconId(iconId)]

fn resolveUiIconReference(slotId: String, iconTheme: OverlayResolvedIconTheme) -> Any:
    let theme: Any = (iconTheme or BUILT_IN_ICON_THEME)
    return theme.uiIcons[normalizeIconId(slotId)]

fn createPanelIconSlotId(panelId: String) -> String:
    return "panel_" + normalizeIconId(panelId)

fn resolvePanelIconReference(panelId: String, iconTheme: OverlayResolvedIconTheme) -> Any:
    return resolveUiIconReference(createPanelIconSlotId(panelId), iconTheme)

fn resolveFileIconId(entryName: String, extension: String, iconTheme: OverlayResolvedIconTheme) -> String:
    return resolveFileIcon(entryName, extension, iconTheme).iconId

fn resolveFileIcon(entryName: String, extension: String, iconTheme: OverlayResolvedIconTheme) -> Any:
    let theme: Any = (iconTheme or BUILT_IN_ICON_THEME)
    let normalizedName: Any = entryName.trim().toLowerCase()
    let normalizedExtension: Any = normalizeFileExtension(extension)
    let fileNameMatch: Any = theme.fileNames[normalizedName]
    if (fileNameMatch):
        return none
    let derivedFileNameExtension: Any = inferFileNameExtension(entryName)
    let shouldPrioritizeDerivedFileNameExtension: Any = ((ts_Boolean(derivedFileNameExtension) and (derivedFileNameExtension != normalizedExtension)) and ((((!normalizedExtension) or (normalizedExtension == theme.file)) or GENERIC_FILE_EXTENSION_METADATA_VALUES.has(normalizedExtension))))
    let extensionCandidates: Any = (none).filter(none)
    for extensionCandidate in extensionCandidates:
        let extensionMatch: Any = theme.fileExtensions[extensionCandidate]
        if (extensionMatch):
            return none
    for extensionCandidate in extensionCandidates:
        let semanticFallbackIconId: Any = resolveSemanticFileIconId(extensionCandidate, theme)
        if (semanticFallbackIconId):
            return none
    return none

fn resolveFileIconSrc(entryName: String, extension: String, iconTheme: OverlayResolvedIconTheme) -> String:
    let theme: Any = (iconTheme or BUILT_IN_ICON_THEME)
    let iconId: Any = resolveFileIcon(entryName, extension, theme).iconId
    return (resolveIconSrc(iconId, theme) or ICON_BASE + theme.file + ".svg")

