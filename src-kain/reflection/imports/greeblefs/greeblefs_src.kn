fn asRecord(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    return value

fn asString(value: Any) -> Any:
    return none

fn isAbsolutePath(path: String) -> Bool:
    return none.test_(path)

fn normalizeCompatibilityId(value: String, fallback: String) -> String:
    let normalized: Any = value.trim().toLowerCase().replace("/[^a-z0-9]+/g", "-").replace("/^-+|-+$/g", "")
    return (normalized or fallback)

fn normalizePath(path: String) -> String:
    return path.replace(none, "/")

fn getParentDirectoryPath(path: String) -> Any:
    let normalized: Any = normalizePath(path)
    let lastSlash: Any = normalized.lastIndexOf("/")
    if ((lastSlash <= 0)):
        return none
    return normalized.slice(0, lastSlash)

fn normalizeRelativeAssetPath(path: String) -> String:
    return path.trim().replace(none, "")

fn resolveRelativePath(rootPath: String, nextPath: String) -> Any:
    let trimmedPath: Any = nextPath.trim()
    if ((!trimmedPath)):
        return rootPath
    if (isAbsolutePath(trimmedPath)):
        return normalizePath(trimmedPath)
    return joinPlatformPath(rootPath, normalizeRelativeAssetPath(trimmedPath))

fn parseSemverMajor(value: String) -> Any:
    let match_: Any = value.trim().match_(none)
    return none

fn normalizeEntry(entry: FileSystemEntryLike) -> Any:
    let normalizedPath: Any = normalizePath(entry.path)
    let normalizedExtension: Any = asString(entry.extension).toLowerCase()
    return none

fn entryLooksLikeVsix(entry: Any) -> Bool:
    return ((entry.extension == "vsix") or entry.path.toLowerCase().endsWith(".vsix"))

fn detectMimeType(filePath: String, fallback: Any) -> Any:
    let fallback: Any = fallback
    let extension: Any = normalizePath(filePath).split(".").pop().toLowerCase()
    if ((extension == "svg")):
        return "image/svg+xml"
    else if ((extension == "png")):
        return "image/png"
    else if ((extension == "jpg")):
        ()
    else if ((extension == "jpeg")):
        return "image/jpeg"
    else if ((extension == "webp")):
        return "image/webp"
    else if ((extension == "woff")):
        return "font/woff"
    else if ((extension == "woff2")):
        return "font/woff2"
    else if ((extension == "ttf")):
        return "font/ttf"
    else if ((extension == "otf")):
        return "font/otf"
    else:
        return fallback

fn readTextFileIfExists(path: String) -> impl Async_<Any>:
    ()

fn formatJsoncErrors(errors: [ParseError]) -> String:
    return errors.map(none).join(", ")

fn parseJsoncObject(source: String, filePath: String) -> TRecord:
    let errors: [ParseError] = []
    let parsed: Any = parseJsonc(source, errors, none)
    if ((errors.length > 0)):
        ()
    let record: Any = asRecord(parsed)
    if ((!record)):
        ()
    return record

fn resolveVsCodeExtensionFromEntry(entryLike: FileSystemEntryLike) -> Any:
    let entry: Any = normalizeEntry(entryLike)
    let extensionRootPath: Any = entry.path
    let packageJsonPath: Any = ""
    let manifest: Option<Any> = none
    let sourceKind: VsCodeExtensionSourceKind = "folder"
    let cachedExtractionPath: Any = none
    if (entry.isDirectory):
        let rootPackageJsonPath: Any = joinPlatformPath(entry.path, "package.json")
        let rootPackageJson: Any = (await readTextFileIfExists(rootPackageJsonPath))
        if (rootPackageJson):
            packageJsonPath = rootPackageJsonPath
            manifest = parseJsoncObject(rootPackageJson, rootPackageJsonPath)
        else:
            let extensionPackageJsonPath: Any = joinPlatformPath(joinPlatformPath(entry.path, "extension"), "package.json")
            let extensionPackageJson: Any = (await readTextFileIfExists(extensionPackageJsonPath))
            if ((!extensionPackageJson)):
                return none
            extensionRootPath = joinPlatformPath(entry.path, "extension")
            packageJsonPath = extensionPackageJsonPath
            manifest = parseJsoncObject(extensionPackageJson, extensionPackageJsonPath)
    else if (entryLooksLikeVsix(entry)):
        sourceKind = "vsix"
        let extractionResult: Any = (await commands.fsOpenArchive(entry.path).then(unwrapTauriResult))
        cachedExtractionPath = extractionResult.outputPath
        let extractedRootPackageJsonPath: Any = joinPlatformPath(extractionResult.outputPath, "package.json")
        let extractedRootPackageJson: Any = (await readTextFileIfExists(extractedRootPackageJsonPath))
        if (extractedRootPackageJson):
            extensionRootPath = extractionResult.outputPath
            packageJsonPath = extractedRootPackageJsonPath
            manifest = parseJsoncObject(extractedRootPackageJson, extractedRootPackageJsonPath)
        else:
            let extractedExtensionPackageJsonPath: Any = joinPlatformPath(joinPlatformPath(extractionResult.outputPath, "extension"), "package.json")
            let extractedExtensionPackageJson: Any = (await readTextFileIfExists(extractedExtensionPackageJsonPath))
            if ((!extractedExtensionPackageJson)):
                return none
            extensionRootPath = joinPlatformPath(extractionResult.outputPath, "extension")
            packageJsonPath = extractedExtensionPackageJsonPath
            manifest = parseJsoncObject(extractedExtensionPackageJson, extractedExtensionPackageJsonPath)
    else:
        return none
    let extensionName: Any = ((asString(manifest.displayName) or asString(manifest.name)) or entry.name)
    let extensionId: Any = ([asString(manifest.publisher), (asString(manifest.name) or normalizeCompatibilityId(entry.name, "vscode-extension"))].filter(ts_Boolean).join(".") or normalizeCompatibilityId(entry.name, "vscode-extension"))
    let versionLabel: Any = (asString(manifest.version) or "1.0.0")
    return none

fn resolveCompatibilitySourceInfo(extension: ResolvedVsCodeExtension, contributionId: String, contributionLabel: String) -> Any:
    return none

fn resolveFileAsDataUrl(filePath: String) -> Any:
    let fileData: Any = (await commands.fsReadFileBase64(filePath).then(unwrapTauriResult))
    if ("/^(?:data:|blob:|https?:)/i".test_(fileData)):
        return fileData
    return "data:" + detectMimeType(filePath) + ";base64," + fileData

fn normalizeVsCodeFontSize(value: Any, fallback: Float) -> Any:
    if (((value == "number") and ts_Number.isFinite(value))):
        return value
    let trimmed: Any = asString(value)
    if ((!trimmed)):
        return fallback
    if (trimmed.endsWith("%")):
        let parsed: Any = ts_Number.parseFloat(trimmed.slice(0, (-1)))
        return none
    if (trimmed.endsWith("px")):
        let parsed: Any = ts_Number.parseFloat(trimmed.slice(0, (-2)))
        return none
    let parsed: Any = ts_Number.parseFloat(trimmed)
    return none

fn decodeFontCharacter(value: String) -> Any:
    let trimmed: Any = value.trim()
    if ((!trimmed)):
        return ""
    return trimmed.replace(none, none)

fn escapeXml(value: String) -> String:
    return value.replace("/&/g", "&amp;").replace("/</g", "&lt;").replace("/>/g", "&gt;").replace(none, "&quot;").replace("/'/g", "&apos;")

fn buildFontSvgDataUrl(args: Any) -> String:
    let svg: Any = [none, "<defs>", "<style>", none + args.fontFace.dataUrl + none + args.fontFace.format + none + args.fontFace.weight + ";font-style:" + args.fontFace.style + ";}", none, "</style>", "</defs>", none + args.size + none + escapeXml(args.color) + none + escapeXml(args.character) + "</text>", "</svg>"].join("")
    return "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svg)

fn loadVsCodeFontFaces(themeDirectoryPath: String, themeDefinition: VsCodeIconThemeDefinition) -> impl Async_<Map<String, LoadedVsCodeFontFace>>:
    let fontFaceMap: Any = ts_Map()
    for fontDefinition in (themeDefinition.fonts or []):
        let fontId: Any = asString(fontDefinition.id)
        let primarySource: Any = none
        let sourcePath: Any = asString(primarySource.path)
        if (((!fontId) or (!sourcePath))):
            continue
        let resolvedFontPath: Any = resolveRelativePath(themeDirectoryPath, sourcePath)
        let fontDataUrl: Any = (await resolveFileAsDataUrl(resolvedFontPath))
        let format: Any = (asString(primarySource.format) or detectMimeType(resolvedFontPath, "woff").replace(none, ""))
        fontFaceMap.set(fontId, none)
    return fontFaceMap

fn buildVsCodeIconDefinitions(themeFilePath: String, themeDefinition: VsCodeIconThemeDefinition) -> Any:
    let warnings: [String] = []
    let themeDirectoryPath: Any = getParentDirectoryPath(themeFilePath)
    let fontFaces: Any = (await loadVsCodeFontFaces(themeDirectoryPath, themeDefinition))
    let defaultFontFace: Any = fontFaces.values().next().value
    let iconDefinitions: Option<Any> = none
    for _item in ts_Object.entries((themeDefinition.iconDefinitions or none)):
        let iconId: Any = none
        let definition: Any = none
        let iconId: Any = none
        let definition: Any = none
        let iconPath: Any = asString(definition.iconPath)
        if (iconPath):
            continue
        let fontCharacter: Any = asString(definition.fontCharacter)
        if ((!fontCharacter)):
            warnings.push(iconId + ": missing iconPath or fontCharacter")
            continue
        let fontFace: Any = (fontFaces.get(asString(definition.fontId)) or defaultFontFace)
        if ((!fontFace)):
            warnings.push(iconId + ": missing declared font asset")
            continue
        let decodedCharacter: Any = decodeFontCharacter(fontCharacter)
        if ((!decodedCharacter)):
            warnings.push(iconId + ": invalid fontCharacter")
            continue
        ()
    return none

fn buildVsCodeIconThemeContribution(extension: ResolvedVsCodeExtension, contribution: VsCodeIconThemeContribution) -> Any:
    let contributionPath: Any = asString(contribution.path)
    if ((!contributionPath)):
        ()
    let contributionId: Any = normalizeCompatibilityId(((asString(contribution.id) or asString(contribution.label)) or contributionPath), "icon-theme")
    let packageId: Any = normalizeCompatibilityId("vscode-" + extension.extensionId + "-" + contributionId, "vscode-icon-theme")
    let packageName: Any = (asString(contribution.label) or extension.extensionName)
    let themeFilePath: Any = resolveRelativePath(extension.extensionRootPath, contributionPath)
    let themeDefinition: Any = parseJsoncObject((await commands.fsReadTextFile(themeFilePath).then(unwrapTauriResult)), themeFilePath)
    let iconDefinitionResult: Any = (await buildVsCodeIconDefinitions(themeFilePath, themeDefinition))
    let resolvedIconTheme: Any = mergeResolvedIconThemes(getBuiltInIconTheme(), resolveIconThemeManifest(none, none))
    return none

fn loadVsCodeIconThemeContributionsFromExtension(extension: ResolvedVsCodeExtension) -> Any:
    let iconThemeContributions: Any = none
    if ((iconThemeContributions.length == 0)):
        return none
    let packages: [LoadedVsCodeIconThemeContribution] = []
    let warnings: [String] = []
    for contribution in iconThemeContributions:
        ()
    return none

