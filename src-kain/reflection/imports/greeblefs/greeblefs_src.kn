fn compareStorageEntries(left: StorageScanEntry, right: StorageScanEntry, key: Any, rootAllocatedBytes: Float) -> Any:
    if ((key == "name")):
        return left.name.localeCompare(right.name)
    else if ((key == "logicalBytes")):
        return (left.logicalBytes - right.logicalBytes)
    else if ((key == "wasteBytes")):
        return (left.wasteBytes - right.wasteBytes)
    else if ((key == "subtreeShare")):
        return (left.allocatedBytes - right.allocatedBytes)
    else if ((key == "rootShare")):
        return (resolveRootShare(left.allocatedBytes, rootAllocatedBytes) - resolveRootShare(right.allocatedBytes, rootAllocatedBytes))
    else if ((key == "fileCount")):
        return (left.fileCount - right.fileCount)
    else if ((key == "directoryCount")):
        return (left.directoryCount - right.directoryCount)
    else if ((key == "allocatedBytes")):
        ()
    else:
        return (left.allocatedBytes - right.allocatedBytes)

fn buildStorageMatrixRows(args: Any) -> [StorageMatrixRow]:
    let rows: [StorageMatrixRow] = []
    let rootAllocatedBytes: Any = Math.max(0, args.rootEntry.allocatedBytes)
    let visit: Any = none
    visit(args.rootEntry, 0, none, none)
    return rows

fn resolveSubtreeShare(allocatedBytes: Float, parentAllocatedBytes: Any) -> Any:
    if (((parentAllocatedBytes == none) or (parentAllocatedBytes <= 0))):
        return 100
    if (((!ts_Number.isFinite(allocatedBytes)) or (allocatedBytes <= 0))):
        return 0
    return (((allocatedBytes / parentAllocatedBytes)) * 100)

fn resolveRootShare(allocatedBytes: Float, rootAllocatedBytes: Float) -> Any:
    if ((((!ts_Number.isFinite(allocatedBytes)) or (!ts_Number.isFinite(rootAllocatedBytes))) or (rootAllocatedBytes <= 0))):
        return 0
    return (((allocatedBytes / rootAllocatedBytes)) * 100)

fn summarizeQueueEntries(entries: [StorageQueuedItem]) -> Any:
    return entries.reduce(none, none)

fn resolveTreemapFocusNode(rootNode: Any, selectedPath: Any) -> Any:
    if ((!rootNode)):
        return none
    if ((!selectedPath)):
        return rootNode
    let nodesByPath: Any = collectTreeNodesByPath(rootNode)
    let currentPath: Any = selectedPath
    while (currentPath):
        let matched: Any = nodesByPath.get(currentPath)
        if (matched):
            return matched
        currentPath = getParentPath(currentPath)
    return rootNode

fn collectTreeNodesByPath(rootNode: Any) -> Any:
    let nodesByPath: Any = ts_Map()
    if ((!rootNode)):
        return nodesByPath
    let visit: Any = none
    visit(rootNode)
    return nodesByPath

