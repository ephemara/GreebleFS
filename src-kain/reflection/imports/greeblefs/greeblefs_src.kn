    let next: Any = [ids]
    let draggedIndex: Any = next.indexOf(draggedId)
    let targetIndex: Any = next.indexOf(targetId)
    if (((draggedIndex == (-1)) or (targetIndex == (-1)))):
        return ids
    let _: Any = next.splice(draggedIndex, 1)
    let dragged: Any = none
    next.splice(targetIndex, 0, dragged)
    return next

fn togglePanelId(ids: [String], panelId: String) -> Any:
    return none

fn syncOpenPanelIds(openIds: [String], availableIds: [String], defaultOpenIds: [String]) -> [String]:
    return derivePanelOpenState(none)

fn derivePanelOpenState(args: Any) -> [String]:
    let availableSet: Any = ts_Set(args.availableIds)
    let savedOpenIds: Any = args.savedOpenIds.filter(none)
    let dismissedSet: Any = ts_Set(args.dismissedPanelIds.filter(none))
    let defaultOpenIds: Any = args.defaultOpenIds.filter(none)
    let enforcedOpenIds: Any = args.enforcedOpenIds.filter(none)
    return ts_Array.from(ts_Set([savedOpenIds, defaultOpenIds, enforcedOpenIds]))

fn getNextActivePanelId(openIds: [String], closedId: String) -> Any:
    let next: Any = openIds.filter(none)
    return (next[(next.length - 1)] or none)

