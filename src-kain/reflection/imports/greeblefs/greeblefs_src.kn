fn applyParticleForces(particle: Any, mode: ParticleMode, chaos: Float, mouse: Any, interactive: Bool):
    let centerX: Any = 400
    let centerY: Any = 300
    let hash: Any = none
    particle.vx = (particle.vx + ((((hash(((particle.x * 0.1) + (particle.y * 0.1))) - 0.5)) * chaos) * 0.1))
    particle.vy = (particle.vy + ((((hash(((particle.y * 0.1) + (particle.x * 0.1))) - 0.5)) * chaos) * 0.1))
    if ((mode == "orbit")):
        let dx: Any = (particle.x - centerX)
        let dy: Any = (particle.y - centerY)
        let distance: Any = Math.sqrt(((dx * dx) + (dy * dy)))
        if ((distance > 0)):
            particle.vx = (particle.vx + ((((-dy) / distance)) * 0.1))
            particle.vy = (particle.vy + (((dx / distance)) * 0.1))
        break
    else if ((mode == "attract")):
        let target: Any = none
        let dx: Any = (target.x - particle.x)
        let dy: Any = (target.y - particle.y)
        let distance: Any = Math.sqrt(((dx * dx) + (dy * dy)))
        if ((distance > 0)):
            particle.vx = (particle.vx + (((dx / distance)) * 0.05))
            particle.vy = (particle.vy + (((dy / distance)) * 0.05))
        break
    else if ((mode == "repel")):
        let target: Any = none
        let dx: Any = (particle.x - target.x)
        let dy: Any = (particle.y - target.y)
        let distance: Any = Math.sqrt(((dx * dx) + (dy * dy)))
        if (((distance > 0) and (distance < 200))):
            let force: Any = (((1 - (distance / 200))) * 0.2)
            particle.vx = (particle.vx + (((dx / distance)) * force))
            particle.vy = (particle.vy + (((dy / distance)) * force))
        break
    else if ((mode == "vortex")):
        let dx: Any = (particle.x - centerX)
        let dy: Any = (particle.y - centerY)
        let distance: Any = Math.sqrt(((dx * dx) + (dy * dy)))
        if ((distance > 0)):
            let angle: Any = Math.atan2(dy, dx)
            let force: Any = (0.1 / ((1 + (distance * 0.01))))
            particle.vx = (particle.vx + (Math.cos((angle + (Math.PI / 2))) * force))
            particle.vy = (particle.vy + (Math.sin((angle + (Math.PI / 2))) * force))
            particle.vx = (particle.vx + ((((-dx) / distance)) * 0.01))
            particle.vy = (particle.vy + ((((-dy) / distance)) * 0.01))
        break
    else if ((mode == "explode")):
        let dx: Any = (particle.x - centerX)
        let dy: Any = (particle.y - centerY)
        let distance: Any = Math.sqrt(((dx * dx) + (dy * dy)))
        if ((distance > 0)):
            particle.vx = (particle.vx + (((dx / distance)) * 0.1))
            particle.vy = (particle.vy + (((dy / distance)) * 0.1))
        break
    else if ((mode == "flow")):
        let time: Any = (Date.now() / 1000)
        particle.vx = (particle.vx + (Math.sin(((particle.y * 0.01) + time)) * 0.05))
        particle.vy = (particle.vy + (Math.cos(((particle.x * 0.01) + time)) * 0.05))
        break
    else if ((mode == "quantum")):
        if ((Math.random() < 0.01)):
            particle.x = (particle.x + (((Math.random() - 0.5)) * 50))
            particle.y = (particle.y + (((Math.random() - 0.5)) * 50))
        particle.vx = (particle.vx + (Math.sin((Date.now() * 0.01)) * 0.1))
        particle.vy = (particle.vy + (Math.cos((Date.now() * 0.01)) * 0.1))
        break
    particle.vx = (particle.vx * 0.98)
    particle.vy = (particle.vy * 0.98)

