fn normalizeExplorerHomePackExport(exported: Any, fallbackContext: ExplorerHomePackContext) -> Any:
    let candidate: Any = unwrapRuntimeModuleExport(exported, ["homePack"])
    if ((candidate == "function")):
        return none
    if (((!candidate) or (candidate != "object"))):
        ()
    let definition: Any = candidate
    if (((!definition.component_) and (((!ts_Array.isArray(definition.presets)) or (definition.presets.length == 0))))):
        ()
    return definition

