fn createMissingActionExplorerCustomizeCatalogEntry(entry: ExplorerChromeOverrideEntry) -> Any:
    if ((!isExplorerActionChromeControlId(entry.controlId))):
        return none
    let actionId: Any = getExplorerActionIdFromChromeControlId(entry.controlId)
    return none

fn createMissingWidgetExplorerCustomizeCatalogEntry(entry: ExplorerChromeOverrideEntry) -> Any:
    if ((!entry.controlId.startsWith("widget:"))):
        return none
    return none

fn buildExplorerCustomizeCatalog(input: Any) -> [ExplorerCustomizeCatalogEntry]:
    let builtInEntries: Any = createBuiltInExplorerCustomizeCatalogEntries()
    let actionEntries: Any = ((input.actions or [])).map(createActionExplorerCustomizeCatalogEntry)
    let widgetEntries: Any = [((input.widgets or [])), ((input.pluginWidgets or []))].map(createWidgetExplorerCustomizeCatalogEntry)
    let knownControlIds: Any = ts_Set([builtInEntries.map(none), actionEntries.map(none), widgetEntries.map(none)])
    let missingEntries: Any = ((input.persistedEntries or [])).filter(none).map(none).filter(none)
    return [builtInEntries, actionEntries, widgetEntries, missingEntries].sort(none)

fn resolveExplorerCustomizeCatalogEntry(catalog: [ExplorerCustomizeCatalogEntry], controlId: Any) -> Any:
    if ((!controlId)):
        return none
    return (catalog.find(none) or none)

fn resolveExplorerChromeCommandLabel(commandId: String, catalog: [ExplorerCustomizeCatalogEntry]) -> String:
    let matchingEntry: Any = catalog.find(none)
    return ((matchingEntry.label or titleCaseWords(commandId.replace("/^explorer-control:/", ""))))

