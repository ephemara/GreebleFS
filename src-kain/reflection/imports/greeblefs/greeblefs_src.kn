fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(max, Math.max(min, value))

fn parseCssPixels(value: Any) -> Any:
    if (((value == "number") and ts_Number.isFinite(value))):
        return value
    if ((value == "string")):
        let normalized: Any = value.trim()
        if (normalized.endsWith("px")):
            let parsed: Any = ts_Number.parseFloat(normalized)
            if (ts_Number.isFinite(parsed)):
                return parsed
    return 0

fn getOverlayTargetFlag(target: Any, attribute: String) -> Bool:
