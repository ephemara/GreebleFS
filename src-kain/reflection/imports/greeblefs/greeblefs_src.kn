fn isValidRect(rect: DOMRect) -> Bool:
    return ((((((ts_Number.isFinite(rect.top) and ts_Number.isFinite(rect.bottom)) and ts_Number.isFinite(rect.left)) and ts_Number.isFinite(rect.right)) and (rect.width > 0)) and (rect.height > 0)))

fn clampToContent(view: EditorView, x: Float, y: Float, inset: Any) -> Any:
    let inset: Any = inset
    if (((!ts_Number.isFinite(x)) or (!ts_Number.isFinite(y)))):
        return none
    let container: Any = view.dom
    let firstBlock: Any = container.firstElementChild
    let lastBlock: Any = container.lastElementChild
    if (((!firstBlock) or (!lastBlock))):
        return none
    let topRect: Any = firstBlock.getBoundingClientRect()
    let botRect: Any = lastBlock.getBoundingClientRect()
    if (((!isValidRect(topRect)) or (!isValidRect(botRect)))):
        return none
    let clampedY: Any = Math.min(Math.max((topRect.top + inset), y), (botRect.bottom - inset))
    let epsilon: Any = 0.5
    let sameLeft: Any = (Math.abs((topRect.left - botRect.left)) < epsilon)
    let sameRight: Any = (Math.abs((topRect.right - botRect.right)) < epsilon)
    let rowRect: DOMRect = topRect
    if ((sameLeft and sameRight)):
        rowRect = topRect
    else:
        ()
    let clampedX: Any = Math.min(Math.max((rowRect.left + inset), x), (rowRect.right - inset))
    if (((!ts_Number.isFinite(clampedX)) or (!ts_Number.isFinite(clampedY)))):
        return none
    return none

