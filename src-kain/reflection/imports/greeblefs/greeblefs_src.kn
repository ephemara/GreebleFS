fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(Math.max(value, min), max)

fn createHiddenRegion() -> Any:
    return none

fn shrinkWidths(widths: Any, overflow: Float) -> Any:
    let remainingOverflow: Any = overflow
    let launcher: Any = widths.launcher
    let pinnedLeft: Any = widths.pinnedLeft
    let pinnedRight: Any = widths.pinnedRight
    if (((launcher > 0) and (remainingOverflow > 0))):
        let nextLauncher: Any = Math.max(220, (launcher - remainingOverflow))
        remainingOverflow = (remainingOverflow - (launcher - nextLauncher))
        launcher = nextLauncher
    if (((pinnedRight > 0) and (remainingOverflow > 0))):
        let nextPinnedRight: Any = Math.max(180, (pinnedRight - remainingOverflow))
        remainingOverflow = (remainingOverflow - (pinnedRight - nextPinnedRight))
        pinnedRight = nextPinnedRight
    if (((pinnedLeft > 0) and (remainingOverflow > 0))):
        let nextPinnedLeft: Any = Math.max(180, (pinnedLeft - remainingOverflow))
        remainingOverflow = (remainingOverflow - (pinnedLeft - nextPinnedLeft))
        pinnedLeft = nextPinnedLeft
    if (((remainingOverflow > 0) and (launcher > 0))):
        launcher = Math.max(0, (launcher - remainingOverflow))
    return none

fn normalizeThemeRendererShellLayout(args: NormalizeThemeRendererShellLayoutArgs) -> Any:
    let viewportWidth: Any = Math.max(360, Math.round(args.viewportWidth))
    let viewportHeight: Any = Math.max(240, Math.round(args.viewportHeight))
    let shellInset: Any = clamp(Math.round(args.shellInset), 0, Math.max(12, Math.floor((Math.min(viewportWidth, viewportHeight) * 0.08))))
    let panelGap: Any = clamp(Math.round(args.panelGap), 0, 32)
    let contentInnerPadding: Any = clamp(Math.round(args.contentInnerPadding), 0, 40)
    let chromeHeight: Any = clamp(Math.round(args.chromeHeight), 32, Math.min(96, Math.floor((viewportHeight * 0.2))))
    let horizontalBudget: Any = (viewportWidth - (shellInset * 2))
    let verticalBudget: Any = (viewportHeight - (shellInset * 2))
    let minContentWidth: Any = clamp(Math.floor((horizontalBudget * 0.48)), 280, 720)
    let minContentHeight: Any = clamp(Math.floor((verticalBudget * 0.42)), 220, 560)
    let launcherWidth: Any = none
    let pinnedLeftWidth: Any = none
    let pinnedRightWidth: Any = none
    let sectionCount: Any = [(pinnedLeftWidth > 0), (launcherWidth > 0), true, (pinnedRightWidth > 0)].filter(ts_Boolean).length
    let gapBudget: Any = (Math.max(0, (sectionCount - 1)) * panelGap)
    let requestedContentWidth: Any = ((((horizontalBudget - pinnedLeftWidth) - pinnedRightWidth) - launcherWidth) - gapBudget)
    if ((requestedContentWidth < minContentWidth)):
        let shrunk: Any = shrinkWidths(none, (minContentWidth - requestedContentWidth))
        launcherWidth = shrunk.launcher
        pinnedLeftWidth = shrunk.pinnedLeft
        pinnedRightWidth = shrunk.pinnedRight
    let contentHeightBeforeClamp: Any = ((verticalBudget - chromeHeight) - panelGap)
    let resolvedChromeHeight: Any = none
    let contentHeight: Any = Math.max(220, ((verticalBudget - resolvedChromeHeight) - panelGap))
    let nextX: Any = shellInset
    let pinnedLeft: Any = none
    if (pinnedLeft.visible):
        nextX = (nextX + (pinnedLeft.width + panelGap))
    let launcher: Any = none
    if (launcher.visible):
        nextX = (nextX + (launcher.width + panelGap))
    let rightReservedWidth: Any = none
    let content: Any = none
    let pinnedRight: Any = none
    return none

