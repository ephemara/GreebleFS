    let limit: Any = (args.limit or globalSearchPaletteConfig.resultLimit)
    let queryOptions: Option<Any> = none
    let priorityPaths: Any = normalizeGlobalSearchPriorityPaths((args.priorityPaths or []))
    let _: Any = (await ts_Promise.all([commands.globalSearchQuery(args.query, queryOptions).then(unwrapTauriResult), none]))
    let indexedResults: Any = none
    let priorityResults: Any = none
    return mergeGlobalSearchResults(none)

