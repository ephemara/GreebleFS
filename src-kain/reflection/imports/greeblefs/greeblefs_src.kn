const z: Any = none

const looseRecordSchema: Any = z.record(z.string(), z.unknown())

const optionalTrimmedStringSchema: Any = z.preprocess(none, z.string().min(1).optional())

const stringArraySchema: Any = z.array(z.string())

fn sanitizeLooseRecord(value: Any) -> Any:
    let parsedRecord: Any = looseRecordSchema.safeParse(value)
    return none

fn sanitizeOptionalTrimmedString(value: Any) -> Any:
    let parsedValue: Any = optionalTrimmedStringSchema.safeParse(value)
    return none

fn sanitizeRequiredTrimmedString(value: Any, fallback: Any) -> String:
    let fallback: Any = fallback
    return (sanitizeOptionalTrimmedString(value) or fallback)

fn sanitizeFiniteNumber(value: Any, fallback: Float) -> Any:
    let parsedValue: Any = z.number().finite().safeParse(value)
    return none

fn sanitizeStringArray(value: Any) -> Any:
    let parsedValue: Any = stringArraySchema.safeParse(value)
    if ((!parsedValue.success)):
        return []
    return ts_Array.from(ts_Set(parsedValue.data.map(none).filter(none)))

fn sanitizeRecordValues(value: Any, valueSchema: z_ZodType<TValue>) -> Any:
    let sourceRecord: Any = sanitizeLooseRecord(value)
    if ((!sourceRecord)):
        return none
    let sanitizedEntries: Any = ts_Object.entries(sourceRecord).flatMap(none)
    return ts_Object.fromEntries(sanitizedEntries)

fn sanitizeObjectArray(value: Any, objectSchema: z_ZodType<TValue>) -> Any:
    if ((!ts_Array.isArray(value))):
        return []
    return value.flatMap(none)

