    while ((i < numDeclarations)):
        let declaration: Any = declarations[i]
        let firstColonIndex: Any = declaration.indexOf(":")
        if ((firstColonIndex == (-1))):
            continue
        let property: Any = declaration.slice(0, firstColonIndex).trim()
        let value: Any = declaration.slice((firstColonIndex + 1)).trim()
        if ((property and value)):
            pairs.push([property, value])
        i = (i + 1)
    return pairs

