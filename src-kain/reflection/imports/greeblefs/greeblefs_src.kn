    let trigger: Any = arg_0.trigger
    let plainClick: Any = arg_0.plainClick
    let folderClickMode: Any = arg_0.folderClickMode
    if ((!isDirectory)):
        return (trigger == "double-click")
    if ((folderClickMode == "single")):
        return ((trigger == "click") and plainClick)
    return (trigger == "double-click")

