    format: ModelPreviewFormat
    sourcePath: String
    maxWidth: Float
    maxHeight: Float

type SharedModelThumbnailRendererState = Any

const sharedRendererState: Any = none

const sharedRenderQueue: Any = ts_Promise.resolve()

fn renderModelThumbnailDataUrl(request: ModelThumbnailRenderRequest) -> impl Async_<String>:
    let task: Any = none
    let next: Any = sharedRenderQueue.then(task, task)
    sharedRenderQueue = next.then(none, none)
    return next

fn renderModelThumbnailDataUrlNow(request: ModelThumbnailRenderRequest) -> impl Async_<String>:
    let state_: Any = ensureModelThumbnailRendererState()
    let width: Any = Math.max(1, Math.floor(request.maxWidth))
    let height: Any = Math.max(1, Math.floor(request.maxHeight))
    let pixelRatio: Any = Math.min((window.devicePixelRatio or 1), MODEL_THUMBNAIL_RENDER_CONFIG.maxPixelRatio)
    state_.renderer.setPixelRatio(pixelRatio)
    state_.renderer.setSize(width, height, false)
    state_.camera.aspect = (width / height)
    state_.camera.updateProjectionMatrix()
    let normalizedObject: Option<Any> = none

fn ensureModelThumbnailRendererState() -> Any:
    if (sharedRendererState):
        return sharedRendererState
    if ((document == "undefined")):
        ()
    let canvas: Any = document.createElement("canvas")
    let renderer: Any = THREE.WebGLRenderer(none)
    renderer.outputColorSpace = THREE.SRGBColorSpace
    renderer.setClearColor(MODEL_THUMBNAIL_RENDER_CONFIG.backgroundColor, 1)
    let scene: Any = THREE.Scene()
    scene.background = THREE.Color(MODEL_THUMBNAIL_RENDER_CONFIG.backgroundColor)
    let camera: Any = THREE.PerspectiveCamera(MODEL_THUMBNAIL_RENDER_CONFIG.cameraFov, 1, 0.01, 2000)
    camera.position.set(2.4, 1.8, 3.6)
    let ambientLight: Any = THREE.AmbientLight("#dbe8f5", MODEL_THUMBNAIL_RENDER_CONFIG.ambientIntensity)
    let keyLight: Any = THREE.DirectionalLight("#ffffff", MODEL_THUMBNAIL_RENDER_CONFIG.keyLightIntensity)
    keyLight.position.set(6, 8, 6)
    let fillLight: Any = THREE.DirectionalLight("#7aa7d9", MODEL_THUMBNAIL_RENDER_CONFIG.fillLightIntensity)
    fillLight.position.set((-4), 2, (-5))
    scene.add(ambientLight, keyLight, fillLight)
    sharedRendererState = none
    return sharedRendererState

fn frameModelThumbnailCamera(object: THREE_Object3D, camera: THREE_PerspectiveCamera) -> Any:
    let bounds: Any = collectNormalizedBounds(object)
    if (bounds.isEmpty()):
        camera.position.set(2.4, 1.8, 3.6)
        camera.lookAt(0, 0.4, 0)
        return none
    let center: Any = bounds.getCenter(THREE.Vector3())
    let size: Any = bounds.getSize(THREE.Vector3())
    let radius: Any = Math.max((size.length() * 0.32), 0.3)
    let distance: Any = Math.max((radius / Math.sin((((camera.fov * Math.PI)) / 360))), (radius * 1.55))
    camera.near = Math.max((distance / 200), 0.01)
    camera.far = Math.max((distance * 50), 100)
    camera.updateProjectionMatrix()
    camera.position.copy(center.clone().add(THREE.Vector3(distance, (distance * 0.52), distance)))
    camera.lookAt(center)

