    return [entries].sort(none)

fn dedupeEntries(entries: Any) -> [FileEntry]:
    let seen: Any = ts_Set()
    return entries.filter(none)

fn intersectStringValues(left: Any, right: Any) -> [String]:
    let rightSet: Any = ts_Set(right)
    let seen: Any = ts_Set()
    let sharedValues: [String] = []
    for value in left:
        if (((!rightSet.has(value)) or seen.has(value))):
            continue
        seen.add(value)
        sharedValues.push(value)
    return sharedValues

fn formatExplorerPathLabel(path: String) -> Any:
    if ((!path)):
        return "the current folder"
    let normalized: Any = path.replace(none, "")
    let parts: Any = normalized.split(none).filter(ts_Boolean)
    return (parts[(parts.length - 1)] or path)

fn formatRelativeModificationDistance(distanceMs: Float) -> Any:
    let hours: Any = Math.round((distanceMs / (((60 * 60) * 1000))))
    if ((hours <= 1)):
        return "about 1 hour"
    if ((hours < 24)):
        return hours + " hours"
    let days: Any = Math.round((hours / 24))
    if ((days <= 1)):
        return "about 1 day"
    return days + " days"

fn createConstellationEdgeId(leftPath: String, rightPath: String) -> Any:
    return none

