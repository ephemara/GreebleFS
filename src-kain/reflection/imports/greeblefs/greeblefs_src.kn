        document.addEventListener("touchmove", _self.handleTouchMove)
        document.addEventListener("mouseup", _self.handleMouseUp)
        document.addEventListener("keydown", _self.handleKeyDown)
        document.addEventListener("keyup", _self.handleKeyUp)

    fn handleResize(_self: ResizableNodeView, deltaX: Float, deltaY: Float) -> Any:
        if ((!_self.activeHandle)):
            return none
        let shouldPreserveAspectRatio: Any = (_self.preserveAspectRatio or _self.isShiftKeyPressed)
        let _: Any = _self.calculateNewDimensions(_self.activeHandle, deltaX, deltaY)
        let width: Any = none
        let height: Any = none
        let constrained: Any = _self.applyConstraints(width, height, shouldPreserveAspectRatio)
        _self.element.style.width = constrained.width + "px"
        _self.element.style.height = constrained.height + "px"
        if (_self.onResize):
            _self.onResize(constrained.width, constrained.height)

    fn calculateNewDimensions(_self: ResizableNodeView, direction: ResizableNodeViewDirection, deltaX: Float, deltaY: Float) -> Any:
        let newWidth: Any = _self.startWidth
        let newHeight: Any = _self.startHeight
        let isRight: Any = direction.includes("right")
        let isLeft: Any = direction.includes("left")
        let isBottom: Any = direction.includes("bottom")
        let isTop: Any = direction.includes("top")
        if (isRight):
            newWidth = (_self.startWidth + deltaX)
        else if (isLeft):
            newWidth = (_self.startWidth - deltaX)
        if (isBottom):
            newHeight = (_self.startHeight + deltaY)
        else if (isTop):
            newHeight = (_self.startHeight - deltaY)
        if (((direction == "right") or (direction == "left"))):
            newWidth = (_self.startWidth + (none))
        if (((direction == "top") or (direction == "bottom"))):
            newHeight = (_self.startHeight + (none))
        let shouldPreserveAspectRatio: Any = (_self.preserveAspectRatio or _self.isShiftKeyPressed)
        if (shouldPreserveAspectRatio):
