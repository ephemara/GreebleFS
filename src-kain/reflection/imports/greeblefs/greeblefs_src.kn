fn canShowCommand(command: ExplorerCommandDefinition, invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment) -> Any:
