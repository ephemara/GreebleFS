    let contributionId: Any = normalizeCompatibilityId(((asString(contribution.id) or asString(contribution.label)) or contributionPath), "color-theme")
    let packageId: Any = normalizeCompatibilityId("vscode-" + extension.extensionId + "-" + contributionId, "vscode-color-theme")
    let packageName: Any = (asString(contribution.label) or extension.extensionName)
    let themeFilePath: Any = resolveRelativePath(extension.extensionRootPath, contributionPath)
    let colorThemeFile: Any = (await loadVsCodeColorThemeFile(themeFilePath))
    let fallbackTheme: Any = resolveVsCodeFallbackTheme(colorThemeFile.type_, asString(contribution.uiTheme))
    let palettePatch: Any = buildVsCodePalettePatch(colorThemeFile.colors)
    let themeDefinition: Any = normalizeThemeDefinition(none, fallbackTheme)
    return none

