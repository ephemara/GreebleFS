impl ExplorerHomePackErrorBoundary:
    fn new_(_self: ExplorerHomePackErrorBoundary, props: Any) -> ExplorerHomePackErrorBoundary:
        super_(props)
        _self.state_ = none

    fn getDerivedStateFromError() -> Any:
        return none

    fn componentDidCatch(_self: ExplorerHomePackErrorBoundary, error: Error):
        console.warn(none + _self.props.packName + none, error)
        _self.props.onError(error)

    fn componentDidUpdate(_self: ExplorerHomePackErrorBoundary, prevProps: Any):
        if (((prevProps.packName != _self.props.packName) and _self.state_.failed)):
            _self.setState(none)

    fn render(_self: ExplorerHomePackErrorBoundary) -> Any:
        if (_self.state_.failed):
            return _self.props.fallback
        return _self.props.children


