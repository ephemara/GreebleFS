const BASE_SCORE: Any = 1000

fn calculateScore(context: RuleContext, rules: [DragHandleRule], edgeConfig: EdgeDetectionConfig, coords: Any) -> Any:
    let score: Any = BASE_SCORE
    let excluded: Any = false
    rules.every(none)
    if (excluded):
        return (-1)
    let dom: Any = context.view.nodeDOM(context.pos)
    score = (score - calculateEdgeDeduction(coords, dom, edgeConfig, context.depth))
    if ((score <= 0)):
        return (-1)
    return score

