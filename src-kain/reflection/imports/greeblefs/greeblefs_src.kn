fn splitStyleDeclarations(styles: String) -> [String]:
    let result: [String] = []
    let current: Any = ""
    let inSingleQuote: Any = false
    let inDoubleQuote: Any = false
    let parenDepth: Any = 0
    let length: Any = styles.length
    let i: Any = 0
    while ((i < length)):
        let char_: Any = styles[i]
        if (((char_ == "'") and (!inDoubleQuote))):
            inSingleQuote = (!inSingleQuote)
            current = (current + char_)
            continue
        if (((char_ == none) and (!inSingleQuote))):
            inDoubleQuote = (!inDoubleQuote)
            current = (current + char_)
            continue
        if (((!inSingleQuote) and (!inDoubleQuote))):
            if ((char_ == "(")):
                parenDepth = (parenDepth + 1)
                current = (current + char_)
                continue
            if (((char_ == ")") and (parenDepth > 0))):
                parenDepth = (parenDepth - 1)
                current = (current + char_)
                continue
            if (((char_ == ";") and (parenDepth == 0))):
                result.push(current)
                current = ""
                continue
        current = (current + char_)
        i = (i + 1)
    if (current):
        result.push(current)
    return result

fn parseStyleEntries(styles: Any) -> [(String, String)]:
    let pairs: [(String, String)] = []
