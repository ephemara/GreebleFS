fn injectFallbackPreviewNodes(nodes: [ExplorerRuntimeMenuNode], layout: ExplorerMenuContextLayout, commandRegistry: [ExplorerCommandDefinition], invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment, handledCommandIds: Set<String>) -> Any:
    if (((invocation.kind != "preview-pane") or layoutHasGroupSlot(layout, "preview"))):
        return nodes
    let previewNodes: Any = commandRegistry.filter(none).sort(none).flatMap(none)
    let sanitizedPreviewNodes: Any = sanitizeNodeList(previewNodes)
    if ((sanitizedPreviewNodes.length == 0)):
        return nodes
    let pinnedTopCommandIds: Any = ts_Set(["built-in.open", "built-in.open-with"])
    let insertionIndex: Any = 0
    while ((insertionIndex < nodes.length)):
        let node: Any = nodes[insertionIndex]
        let matchesPinnedTopCommand: Any = ((((node.kind == "command") and pinnedTopCommandIds.has(node.commandId))) or (((node.kind == "submenu") and pinnedTopCommandIds.has(node.id))))
        if ((!matchesPinnedTopCommand)):
            break
        insertionIndex = (insertionIndex + 1)
    let prefix: Any = nodes.slice(0, insertionIndex)
    let suffix: Any = nodes.slice(insertionIndex)
    let mergedNodes: [ExplorerRuntimeMenuNode] = [prefix]
    if (((prefix.length > 0) and (prefix[(prefix.length - 1)].kind != "separator"))):
        mergedNodes.push(createFallbackSeparatorNode("preview.fallback.leading-separator"))
    mergedNodes.push(none)
    if ((suffix.length > 0)):
        mergedNodes.push(createFallbackSeparatorNode("preview.fallback.trailing-separator"))
        mergedNodes.push(none)
    return sanitizeNodeList(mergedNodes)

fn injectFallbackActionNodes(nodes: [ExplorerRuntimeMenuNode], layout: ExplorerMenuContextLayout, commandRegistry: [ExplorerCommandDefinition], invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment, handledCommandIds: Set<String>) -> Any:
    if (layoutHasGroupSlot(layout, "action")):
