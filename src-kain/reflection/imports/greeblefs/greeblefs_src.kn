fn getPathLeaf(path: String) -> Any:
    let trimmed: Any = path.trim()
    if (((!trimmed) or isExplorerHomePath(trimmed))):
        return "Home"
    let parts: Any = trimmed.split(none).filter(ts_Boolean)
    return none

fn getPathParent(path: String) -> Any:
    let trimmed: Any = path.trim()
    if ((!trimmed)):
        return ""
    let normalizedPath: Any = trimmed.replace(none, "")
    let parts: Any = normalizedPath.split(none).filter(ts_Boolean)
    if ((parts.length <= 1)):
        return none
    return none

fn getFileExtension(name: String) -> Any:
    let dotIndex: Any = name.lastIndexOf(".")
    if (((dotIndex <= 0) or (dotIndex == (name.length - 1)))):
        return ""
    return name.slice((dotIndex + 1)).toLowerCase()

fn getFileStem(name: String) -> Any:
    let dotIndex: Any = name.lastIndexOf(".")
    if ((dotIndex <= 0)):
        return name
    return name.slice(0, dotIndex)

fn getPaneShortLabel(paneId: ExplorerPaneId) -> String:
    return getExplorerPaneLabel(paneId).replace("Pane ", "P")

fn getWorkspacePaneDisplayLabel(pane: ExplorerWorkspacePaneSnapshot, currentPath: String) -> Any:
    if (currentPath.trim()):
        return getPathLeaf(currentPath)
    return (pane.title.trim() or "Explorer")

fn getPreferredWorkspaceTabPaneId(tab: ExplorerWorkspaceTabSnapshot) -> Any:
    let visiblePaneIds: Any = getExplorerWorkspaceVisiblePaneIds(tab.layoutMode)
    if ((visiblePaneIds.includes(tab.focusedPane) and tab.panes[tab.focusedPane])):
        return tab.focusedPane
    return (((visiblePaneIds.find(none) or (["pane-1", "pane-2", "pane-3", "pane-4"]).find(none)) or "pane-1"))

fn resolvePaneAccent(active: Bool) -> Any:
    return none

fn getNextVisiblePaneId(visiblePaneIds: [ExplorerPaneId], paneId: ExplorerPaneId) -> Any:
    let currentIndex: Any = visiblePaneIds.indexOf(paneId)
    if (((currentIndex == (-1)) or (visiblePaneIds.length <= 1))):
        return none
    return (visiblePaneIds[(((currentIndex + 1)) % visiblePaneIds.length)] or none)

fn getPreviousVisiblePaneId(visiblePaneIds: [ExplorerPaneId], paneId: ExplorerPaneId) -> Any:
    let currentIndex: Any = visiblePaneIds.indexOf(paneId)
    if (((currentIndex == (-1)) or (visiblePaneIds.length <= 1))):
        return none
    return ((visiblePaneIds[((((currentIndex - 1) + visiblePaneIds.length)) % visiblePaneIds.length)] or none))

fn getWorkspaceHeaderControlSizing(sizeVariant: Any) -> Any:
    let normalizedSizeVariant: Any = (sizeVariant or "regular")
    let compact: Any = (normalizedSizeVariant == "compact")
    let wide: Any = (normalizedSizeVariant == "wide")
    return none

fn sameSelectionEntry(left: ExplorerWorkspaceRuntimeSelectionEntry, right: ExplorerWorkspaceRuntimeSelectionEntry) -> Bool:
    return ((((left.path == right.path) and (left.name == right.name)) and (left.is_dir == right.is_dir)))

fn sameRuntimeSnapshot(left: Any, right: ExplorerWorkspaceRuntimeSnapshot) -> Any:
    if ((!left)):
        return false
    if (((((left.instanceId != right.instanceId) or (left.currentPath != right.currentPath)) or (left.currentPathIsCloud != right.currentPathIsCloud)) or (left.selectedEntries.length != right.selectedEntries.length))):
        return false
    return left.selectedEntries.every(none)

