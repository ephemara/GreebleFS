fn resolveExplorerRailThemeRecipe(presetRail: Any, engineRail: Any, userRail: Any) -> Any:
    let normalized: Any = normalizeExplorerRailThemeRecipe(userRail, normalizeExplorerRailThemeRecipe(engineRail, presetRail))
    let hiddenSectionIds: Any = (normalizeExplorerRailSectionOrder(normalized.hiddenSectionIds) or [])
    let orderedSectionIds: Any = [((normalizeExplorerRailSectionOrder(normalized.sectionOrder) or explorerRailSectionOrder)).filter(none), explorerRailSectionOrder.filter(none)]
    return none

fn resolveExplorerWorkspaceTabsThemeRecipe(presetTabs: Any, engineTabs: Any, userTabs: Any) -> Any:
    let merged: Any = normalizeExplorerWorkspaceTabsThemeRecipe(userTabs, normalizeExplorerWorkspaceTabsThemeRecipe(engineTabs, presetTabs))
    return none

fn resolveExplorerThemeRecipe(appearance: ResolvedOverlayAppearance) -> Any:
    let userRecipe: Any = appearance.baseTheme.explorer
    let engineRecipe: Any = createExplorerEngineRecipe(appearance)
    let engineBindings: Any = resolveThemeEngineBindings(appearance.baseTheme.compiledEngineManifest, userRecipe)
    let preset: Any = ((userRecipe.preset or inferExplorerPresetFromEngine(appearance)) or inferPreset(appearance))
    let presetRecipe: Any = createPresetRecipe(preset)
    let metrics: Any = resolveMetrics(none, userRecipe.metrics)
    let surfaces: Any = resolveSurfaces(none, userRecipe.surfaces)
    let typography: Any = resolveTypography(none, userRecipe.typography)
    let railBrandLabel: Any = ((userRecipe.railBrandLabel.trim() or presetRecipe.railBrandLabel.trim()) or "")
    let preferredViewMode: Any = (((userRecipe.preferredViewMode or engineRecipe.preferredViewMode) or presetRecipe.preferredViewMode) or none)
    let preferredExperimentalViewMode: Any = (((userRecipe.preferredExperimentalViewMode or engineRecipe.preferredExperimentalViewMode) or presetRecipe.preferredExperimentalViewMode) or none)
    let menuPresentation: Any = normalizeExplorerMenuPresentationRecipe((((userRecipe.menuPresentation or engineRecipe.menuPresentation) or presetRecipe.menuPresentation) or none))
    let defaultModeProfileId: Any = normalizeExplorerModeProfileId((((userRecipe.defaultModeProfileId or engineRecipe.defaultModeProfileId) or presetRecipe.defaultModeProfileId) or defaultExplorerModeProfileId))
    let rail: Any = resolveExplorerRailThemeRecipe(presetRecipe.rail, engineRecipe.rail, userRecipe.rail)
    let workspaceTabs: Any = resolveExplorerWorkspaceTabsThemeRecipe(presetRecipe.workspaceTabs, engineRecipe.workspaceTabs, userRecipe.workspaceTabs)
    let cssVars: Any = none
    return none

