const parseCssColor: Any = none

struct ParsedOverlayColor:
    red: Float
    green: Float
    blue: Float
    alpha: Float

const convertColorToRgb: Any = converter("rgb")

fn clampByte(value: Float) -> Any:
    if ((!ts_Number.isFinite(value))):
        return 0
    return Math.max(0, Math.min(255, Math.round(value)))

fn clampUnitInterval(value: Float) -> Any:
    if ((!ts_Number.isFinite(value))):
        return 0
    return Math.max(0, Math.min(1, value))

fn resolveParsedOverlayColor(color: String) -> Any:
    let parsedColor: Any = parseCssColor(color)
    if ((!parsedColor)):
        return none
    return convertColorToRgb(parsedColor)

fn parseOverlayColor(color: String) -> Any:
    let parsedColor: Any = resolveParsedOverlayColor(color)
    if ((!parsedColor)):
        return none
    if ((((parsedColor.r != "number") or (parsedColor.g != "number")) or (parsedColor.b != "number"))):
        return none
    return none

fn withOverlayColorAlpha(color: String, alpha: Float) -> Any:
    let parsedColor: Any = parseOverlayColor(color)
    if ((!parsedColor)):
        return color
    return "rgba(" + parsedColor.red + ", " + parsedColor.green + ", " + parsedColor.blue + ", " + clampUnitInterval(alpha).toFixed(3) + ")"

fn getOverlayColorAlpha(color: String, fallback: Any) -> Float:
    let fallback: Any = fallback
    return (parseOverlayColor(color).alpha or fallback)

fn formatOverlayColorHexChannel(value: Float) -> String:
    return clampByte(value).toString(16).padStart(2, "0")

fn normalizeOverlayColorInputValue(color: Any, fallback: Any) -> Any:
    let fallback: Any = fallback
    let parsedColor: Any = none
    if ((!parsedColor)):
        return fallback
    return "#" + formatOverlayColorHexChannel(parsedColor.red) + formatOverlayColorHexChannel(parsedColor.green) + formatOverlayColorHexChannel(parsedColor.blue)

fn mergeOverlayColorInputValue(nextColorInputValue: String, previousColor: Any) -> Any:
    let parsedColor: Any = parseOverlayColor(nextColorInputValue)
    if ((!parsedColor)):
        return nextColorInputValue
    let previousAlpha: Any = none
    if ((previousAlpha < 0.999)):
        return "rgba(" + parsedColor.red + ", " + parsedColor.green + ", " + parsedColor.blue + ", " + previousAlpha.toFixed(3) + ")"
    return nextColorInputValue

fn normalizeMonacoLiteralColor(color: Any) -> Any:
    if ((color != "string")):
        return color
    let trimmedColor: Any = color.trim()
    if ((!trimmedColor)):
        return trimmedColor
    let parsedColor: Any = resolveParsedOverlayColor(trimmedColor)
    if ((!parsedColor)):
        return trimmedColor
    let hasVisibleAlpha: Any = (((parsedColor.alpha or 1)) < 0.999)
    return none

