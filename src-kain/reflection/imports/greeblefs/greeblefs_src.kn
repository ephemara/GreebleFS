fn parseIndentedBlocks(src: String, config: BlockParserConfig, lexer: Any) -> Any:
    let lines: Any = src.split(none)
    let items: [ParsedBlock] = []
    let totalRaw: Any = ""
    let i: Any = 0
    let baseIndentSize: Any = (config.baseIndentSize or 2)
    while ((i < lines.length)):
        let currentLine: Any = lines[i]
        let itemMatch: Any = currentLine.match_(config.itemPattern)
        if ((!itemMatch)):
            if ((items.length > 0)):
                break
            else if ((currentLine.trim() == "")):
                i = (i + 1)
                totalRaw = totalRaw + currentLine + none
                continue
            else:
                return undefined
        let itemData: Any = config.extractItemData(itemMatch)
        let _: Any = itemData
        let indentLevel: Any = none
        let mainContent: Any = none
        totalRaw = totalRaw + currentLine + none
        let itemContent: Any = [mainContent]
        i = (i + 1)
        while ((i < lines.length)):
            let nextLine: Any = lines[i]
            if ((nextLine.trim() == "")):
                let nextNonEmptyIndex: Any = lines.slice((i + 1)).findIndex(none)
                if ((nextNonEmptyIndex == (-1))):
                    break
                let nextNonEmpty: Any = lines[((i + 1) + nextNonEmptyIndex)]
                let nextIndent: Any = (nextNonEmpty.match_(none)[1].length or 0)
                if ((nextIndent > indentLevel)):
                    itemContent.push(nextLine)
                    totalRaw = totalRaw + nextLine + none
                    i = (i + 1)
                    continue
                else:
                    break
            let nextIndent: Any = (nextLine.match_(none)[1].length or 0)
            if ((nextIndent > indentLevel)):
                itemContent.push(nextLine)
                totalRaw = totalRaw + nextLine + none
                i = (i + 1)
            else:
                break
        let nestedTokens: Any = none
        let nestedContent: Any = itemContent.slice(1)
        if ((nestedContent.length > 0)):
            let dedentedNested: Any = nestedContent.map(none).join(none)
            if (dedentedNested.trim()):
                if (config.customNestedParser):
                    nestedTokens = config.customNestedParser(dedentedNested)
                else:
                    nestedTokens = lexer.blockTokens(dedentedNested)
        let token: Any = config.createToken(itemData, nestedTokens)
        items.push(token)
    if ((items.length == 0)):
        return undefined
    return none

