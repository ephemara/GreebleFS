fn resolveExplorerCommandSourceLabel(command: ExplorerCommandDefinition) -> Any:
    if ((command.source == "action")):
        return none + command.packName
    if ((command.source == "plugin")):
        return none + command.pluginName
    if ((command.source == "preview")):
        return "Preview Lane"
    return "Built-In"

fn buildExplorerCommandSearchHaystack(command: ExplorerCommandDefinition) -> String:
    return [command.title, (command.description or ""), command.id, command.group, command.source, (command.shortcutId or ""), resolveExplorerCommandSourceLabel(command), none, none].join(" ").toLowerCase()

