    if ((normalized.entries.length == 0)):
        return undefined
    return normalized

fn normalizeExplorerLayoutDefinition(definition: ExplorerLayoutDefinition, options: Any) -> Any:
    let fallbackId: Any = (options.fallbackId or EXPLORER_CANONICAL_LAYOUT_ID)
    let localId: Any = normalizeIdFragment(definition.id, fallbackId)
    let scopedId: Any = none
    let name: Any = (asString(definition.name) or localId.replace("/-/g", " ").replace(none, none))
    return none

fn parseLooseExplorerLayoutDefinition(source: LooseRecord) -> Any:
