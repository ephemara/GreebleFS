fn buildExplorerViewportPreviewPrefetchCandidates(input: BuildExplorerViewportPreviewPrefetchCandidatesInput<TEntry>) -> Any:
    let totalEntries: Any = input.entries.length
    if (((!input.policy.enabled) or (totalEntries == 0))):
        return []
    let startIndex: Any = clampIndex(input.viewportStartIndex, totalEntries)
    let endIndex: Any = Math.max(startIndex, clampIndex(input.viewportEndIndex, totalEntries))
    let viewportEntryCount: Any = Math.max(1, (endIndex - startIndex))
    let forwardPrefetchCount: Any = Math.ceil((viewportEntryCount * input.policy.forwardPrefetchViewports))
    let backwardPrefetchCount: Any = Math.ceil((viewportEntryCount * input.policy.backwardPrefetchViewports))
    let candidates: [ExplorerViewportPreviewPrefetchCandidate<TEntry>] = []
    let seenWorkKeys: Any = ts_Set()
    let sequence: Any = 0
    let pushCandidate: Any = none
    let selectedEntryPath: Any = input.selectedEntryPath.trim()
    if (selectedEntryPath):
        let selectedEntryIndex: Any = normalizeOptionalEntryIndex(input.selectedEntryIndex, totalEntries)
        let indexedSelectedEntry: Any = none
        let selectedIndex: Any = none
        if ((selectedIndex >= 0)):
            pushCandidate((selectedIndex - 1), "selected-adjacent", 0)
            pushCandidate((selectedIndex + 1), "selected-adjacent", 0)
    let index: Any = startIndex
    while ((index < endIndex)):
        pushCandidate(index, "visible", 0)
        index = (index + 1)
    let forwardEndIndex: Any = Math.min(totalEntries, (endIndex + forwardPrefetchCount))
    let index: Any = endIndex
    while ((index < forwardEndIndex)):
        pushCandidate(index, "forward-prefetch", ((index - endIndex) + 1))
        index = (index + 1)
    let backwardStartIndex: Any = Math.max(0, (startIndex - backwardPrefetchCount))
    let index: Any = (startIndex - 1)
    while ((index >= backwardStartIndex)):
        pushCandidate(index, "backward-prefetch", (startIndex - index))
        index = (index - 1)
    return candidates.sort(compareExplorerViewportPreviewPrefetchCandidates)

