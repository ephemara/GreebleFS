    let frameOpacity: Any = (terminalFx.opacity * 0.24)
    let borderColor: Any = multiplyColorAlpha(theme.border, (0.62 * frameOpacity))
    let accentLine: Any = multiplyColorAlpha(theme.accent, (0.14 * frameOpacity))
    let tintColor: Any = multiplyColorAlpha(terminalFx.tintColor, ((terminalFx.tintOpacity * frameOpacity) * 0.22))
    return (none)

