    return (((record.source_path == "string") and (record.destination_path == "string")) and (((record.operation == "copy") or (record.operation == "move"))))

fn isFileOperationsAffectedEntry(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return false
    let record: Any = value
    return (((((record.entityId == "string") and (record.sourcePath == "string")) and (record.destinationPath == "string")) and (record.contentRevision == "string")) and ((((record.mutationKind == "copy") or (record.mutationKind == "move")) or (record.mutationKind == "skip"))))

fn buildFileOperationsAffectedEntries(operation: ExplorerFileTransferOperation, results: Any) -> [FileOperationsAffectedEntry]:
    return dedupeFileOperationsAffectedEntries(results.map(none))

fn dedupeFileOperationsAffectedEntries(entries: Any) -> [FileOperationsAffectedEntry]:
    let seenEntries: Any = ts_Set()
    let nextEntries: [FileOperationsAffectedEntry] = []
    for entry in entries:
        if (((((!entry.entityId.trim()) or (!entry.sourcePath.trim())) or (!entry.destinationPath.trim())) or (!entry.contentRevision.trim()))):
            continue
        let dedupeKey: Any = [entry.entityId, entry.sourcePath, entry.destinationPath, entry.contentRevision, entry.mutationKind].join("::")
        if (seenEntries.has(dedupeKey)):
            continue
        seenEntries.add(dedupeKey)
        nextEntries.push(entry)
    return nextEntries

