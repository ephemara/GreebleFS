            let hasInvalidContent: Any = false
            let invalidContent: Any = ""
            let contentCheckSchema: Any = Schema(none)
            if (options.slice):
                DOMParser.fromSchema(contentCheckSchema).parseSlice(elementFromString(content), options.parseOptions)
