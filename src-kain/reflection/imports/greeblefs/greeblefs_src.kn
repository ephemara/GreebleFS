    let localId: Any = normalizeTopBarIdFragment((definition.id or definition.name), "top-bar")
    let normalizedScopeId: Any = normalizeTopBarSelectionId(options.scopeId)
    let id: Any = none
    let fallbackName: Any = (definition.name.trim() or localId.replace("/-/g", " ").replace(none, none))
    return none

const builtInTopBarDefinitions: Any = (none).map(none)

fn getBuiltInTopBars() -> [LoadedOverlayTopBarDefinition]:
    return builtInTopBarDefinitions.map(cloneTopBarDefinition)

fn resolveAvailableTopBars(packageSources: [OverlayTopBarPackageSourceLike]) -> [LoadedOverlayTopBarDefinition]:
    let packageSources: Any = packageSources
    let loaded: Any = ts_Map()
    for topBar in getBuiltInTopBars():
        loaded.set(topBar.id, topBar)
    for packageSource in packageSources:
        for topBar in (packageSource.topBars or []):
            loaded.set(topBar.id, cloneTopBarDefinition(topBar))
    return ts_Array.from(loaded.values())

fn resolveLegacyThemeTopBarId(style: Any) -> Any:
    if ((!style)):
        return none
    return (legacyThemeTopBarIdsByStyle[style] or none)

fn qualifyThemeTopBarSelectionId(selectionId: Any, ownerThemeId: String, availableTopBars: [Any]) -> Any:
    let normalizedSelectionId: Any = normalizeTopBarSelectionId(selectionId)
    if ((!normalizedSelectionId)):
        return undefined
    if (normalizedSelectionId.includes(":")):
        return normalizedSelectionId
    let normalizedLocalId: Any = normalizeTopBarIdFragment(normalizedSelectionId, normalizedSelectionId)
    let matchedLocalTopBar: Any = availableTopBars.find(none)
    if (matchedLocalTopBar):
        return matchedLocalTopBar.id
    let scopedId: Any = createScopedTopBarId(ownerThemeId, normalizedSelectionId)
    return none

fn resolveActiveTopBarSelection(args: Any) -> Any:
    let availableTopBars: Any = resolveAvailableTopBars(args.packageSources)
    let topBarById: Any = ts_Map(availableTopBars.map(none))
    let requestedTopBarId: Any = normalizeTopBarSelectionId(args.requestedTopBarId)
    if (requestedTopBarId):
        let requestedTopBar: Any = topBarById.get(requestedTopBarId)
        if (requestedTopBar):
            return none
    let themeDefaultTopBarId: Any = normalizeTopBarSelectionId(args.theme.defaultTopBarId)
    if (themeDefaultTopBarId):
        let themedTopBar: Any = topBarById.get(themeDefaultTopBarId)
        if (themedTopBar):
            return none
    let legacyThemeTopBarId: Any = resolveLegacyThemeTopBarId(args.theme.workbench.topBarStyle)
    if (legacyThemeTopBarId):
        let legacyThemeTopBar: Any = topBarById.get(legacyThemeTopBarId)
        if (legacyThemeTopBar):
            return none
    let fallbackTopBar: Any = (topBarById.get("command-center") or availableTopBars[0])
    if ((!fallbackTopBar)):
        ()
    return none

fn getTopBarStyleLabel(style: Any) -> String:
    if ((style == "glass")):
        return "Glass"
    else if ((style == "floating")):
        return "Floating"
    else if ((style == "minimal")):
        return "Minimal"
    else:
        return "Solid"

fn getTopBarNavigationModeLabel(mode: OverlayTopBarNavigationMode) -> Any:
    return none

fn getTopBarSourceLabel(source: OverlayTopBarSource) -> Any:
    if ((source == "theme-package")):
        return "Theme Package"
    if ((source == "top-bar-package")):
        return "Top Bar Package"
    return "Built In"

fn getTopBarControlCatalog() -> [OverlayTopBarControlId]:
    return ts_Array.from(topBarControlCatalog.values())

fn flattenTopBarDefinitionControls(topBar: Any) -> [Any]:
    return [topBar.leadingControls.map(none), topBar.navigationShortcuts.map(none), topBar.trailingControls.map(none)]

fn getTopBarControlLabel(controlId: OverlayTopBarControlId) -> Any:
    let canonicalControlId: Any = none
    let catalogLabel: Any = getShellCustomizeControlLabel(canonicalControlId)
    if (catalogLabel):
        return catalogLabel
    if ((controlId == "blur-toggle")):
        return "Mobile"
    else if ((controlId == "panel-menu")):
        return "Surface"
    else:
        return controlId

