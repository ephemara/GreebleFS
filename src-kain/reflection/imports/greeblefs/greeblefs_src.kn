fn normalizePreviewAction(action: Any) -> Any:
    let title: Any = action.title.trim()
    if (((!title) or (action.onSelect != "function"))):
        return none
    let fallbackOrder: Any = none
    let defaultOrder: Any = none
    let priority: Any = none
    return none

fn resolveExplorerPreviewContextMenuActions(registration: Any, workflowTabId: Any) -> Any:
    if ((!registration)):
        return []
    let baseActions: Any = registration.baseActions.map(none).filter(none)
    if ((!workflowTabId)):
        return baseActions
    let overlay: Any = registration.workflowOverlays.find(none)
    if ((!overlay)):
        return baseActions
    let actionsById: Any = ts_Map(baseActions.map(none))
    let orderedIds: Any = baseActions.map(none)
    for override_ in overlay.actions:
        if (override_.hidden):
            actionsById.delete_(override_.id)
            continue
        let existingAction: Any = actionsById.get(override_.id)
        let nextAction: Any = normalizePreviewAction(none)
        if ((!nextAction)):
            continue
        actionsById.set(override_.id, nextAction)
        if ((!orderedIds.includes(override_.id))):
            orderedIds.push(override_.id)
    return orderedIds.map(none).filter(none)

