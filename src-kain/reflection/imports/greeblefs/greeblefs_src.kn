fn ThemeCatalogSection(arg_0: Any) -> Any:
    let sectionId: Any = arg_0.sectionId
    let themes: Any = arg_0.themes
    let activeThemeId: Any = arg_0.activeThemeId
    let onSelect: Any = arg_0.onSelect
    let themePackageLookup: Any = arg_0.themePackageLookup
    let createThemeCardMotion: Any = arg_0.createThemeCardMotion
    let density: Any = arg_0.density
    if ((themes.length == 0)):
        return none
    let isOfficialSuite: Any = (sectionId == "official-pilot")
    let sectionStyle: Any = none
    let sortedThemes: Any = [themes].sort(none)
    return (none)

component ThemeCatalogGrid(themes: Any, activeThemeId: Any, onSelect: Any, themePackageLookup: Any, createThemeCardMotion: Any, density: Any) with Reactive:
    fn catalogSections() -> Any:
        let groupedThemes: Option<Any> = none
        let iter_1: Any = themes
        let index_2: Any = 0
        while ((index_2 < iter_1.length)):
            let themeOption: Any = iter_1[index_2]
            let packageInfo: Any = themePackageLookup.get(themeOption.id)
            let sectionId: Any = resolveThemeCatalogSectionId(themeOption, packageInfo)
            groupedThemes[sectionId].push(themeOption)
            index_2 = (index_2 + 1)
        return (["official-pilot", "built-in", "legacy-archive"]).map(none)

    render <div className={none} data_settings_catalog_grid="theme-catalog" data_theme_catalog_density={density}>{none}</div>

