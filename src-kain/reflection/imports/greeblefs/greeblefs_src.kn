const PLUGIN_PANEL_OPEN_REQUEST_EVENT: Any = "greeblefs:plugin-panel:open-request"

type PluginPanelOpenRequestPresentation = String

struct PluginPanelOpenRequest:
    panelId: String
    payload: Any
    presentation: PluginPanelOpenRequestPresentation
    requestedAt: Float
    nonce: String
    source: String

struct StorageLike:
    getItem: Any
    setItem: Any

fn getPluginPanelOpenRequestStorageKey(panelId: String) -> String:
    return "greeblefs:plugin-panel:" + panelId.trim() + ":open-request"

fn getPluginPanelOpenRequestEvent(panelId: String) -> String:
    return "greeblefs:plugin-panel:" + panelId.trim() + ":open-request"

fn createPluginPanelOpenRequest(panelId: String, payload: Any, source: Any, presentation: PluginPanelOpenRequestPresentation) -> Any:
    let source: Any = source
    let presentation: Any = presentation
    let trimmedPanelId: Any = panelId.trim()
    if ((!trimmedPanelId)):
        return none
    return none

fn readPluginPanelOpenRequest(panelId: String, storage: Any) -> Any:
    let trimmedPanelId: Any = panelId.trim()
    if ((!trimmedPanelId)):
        return none
    let activeStorage: Any = (storage or getBrowserLocalStorage())
    if ((!activeStorage)):
        return none

fn requestPluginPanelOpen(panelId: String, payload: Any, options: Any) -> Any:
    let request: Any = createPluginPanelOpenRequest(panelId, payload, (options.source or "host"), (options.presentation or "docked"))
    if ((!request)):
        return none
    let activeStorage: Any = (options.storage or getBrowserLocalStorage())
    let target: Any = (options.target or getBrowserWindow())
    target.dispatchEvent(CustomEvent(PLUGIN_PANEL_OPEN_REQUEST_EVENT, none))
    target.dispatchEvent(CustomEvent(getPluginPanelOpenRequestEvent(request.panelId), none))
    if (isTauri()):
        emit_(PLUGIN_PANEL_OPEN_REQUEST_EVENT, request).catch_(none)
        emit_(getPluginPanelOpenRequestEvent(request.panelId), request).catch_(none)
    return request

fn requestPluginPanelWindowOpen(panelId: String, payload: Any, options: Any) -> Any:
    let payload: Any = payload
    return requestPluginPanelOpen(panelId, payload, none)

fn requestPluginPanelWindowDock(panelId: String, payload: Any, options: Any) -> Any:
    let payload: Any = payload
    return requestPluginPanelOpen(panelId, payload, none)

