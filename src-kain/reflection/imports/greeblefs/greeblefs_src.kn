fn groupGitHistoryCommitsByDay(commits: [GitHistoryCommitSummary]) -> [GitHistoryCommitGroup]:
    let groups: Any = ts_Map()
    for commit in commits:
        let label: Any = getCommitDayLabel(commit.timestampSeconds)
        let group: Any = groups.get(label)
        if (group):
            group.push(commit)
            continue
        groups.set(label, [commit])
    return ts_Array.from(groups.entries()).map(none)

fn getCommitDayLabel(timestampSeconds: Float) -> Any:
    let commitDate: Any = Date((timestampSeconds * 1000))
    let commitDay: Any = Date(commitDate.getFullYear(), commitDate.getMonth(), commitDate.getDate())
    let now: Any = Date()
    let today: Any = Date(now.getFullYear(), now.getMonth(), now.getDate())
    let diffDays: Any = Math.round((((today.getTime() - commitDay.getTime())) / 86400000))
    if ((diffDays <= 0)):
        return "Today"
    if ((diffDays == 1)):
        return "Yesterday"
    if ((diffDays < 7)):
        return diffDays + " Days Ago"
    return Intl.DateTimeFormat(undefined, none).format(commitDate)

fn formatRelativeCommitTime(timestampSeconds: Float) -> Any:
    let nowSeconds: Any = Math.floor((Date.now() / 1000))
    let diffSeconds: Any = Math.max(0, (nowSeconds - timestampSeconds))
    if ((diffSeconds < 60)):
        return "Just now"
    let diffMinutes: Any = Math.floor((diffSeconds / 60))
    if ((diffMinutes < 60)):
        return diffMinutes + "m ago"
    let diffHours: Any = Math.floor((diffMinutes / 60))
    if ((diffHours < 24)):
        return diffHours + "h ago"
    let diffDays: Any = Math.floor((diffHours / 24))
    if ((diffDays < 7)):
        return diffDays + "d ago"
    return Intl.DateTimeFormat(undefined, none).format(Date((timestampSeconds * 1000)))

fn formatAbsoluteCommitTime(timestampSeconds: Float) -> String:
    return Intl.DateTimeFormat(undefined, none).format(Date((timestampSeconds * 1000)))

fn getAvatarColor(authorName: String) -> String:
    let hash: Any = 0
    let index: Any = 0
    while ((index < authorName.length)):
        hash = ((((((hash << 5)) - hash) + authorName.charCodeAt(index))) | 0)
        index = (index + 1)
    return (AVATAR_COLORS[(Math.abs(hash) % AVATAR_COLORS.length)] or AVATAR_COLORS[0])

fn getInitials(authorName: String) -> Any:
    let words: Any = authorName.trim().split(none).filter(ts_Boolean)
    if ((words.length == 0)):
        return "?"
    return words.slice(0, 2).map(none).join("")

fn buildCommitFileSelectionKey(file: GitHistoryCommitFile) -> String:
    return (file.previousPath or "") + "=>" + file.path

fn historyFileChangeLabel(file: GitHistoryCommitFile) -> Any:
    if ((file.changeType == "added")):
        return "Added"
    if ((file.changeType == "deleted")):
        return "Deleted"
    if ((file.changeType == "renamed")):
        return "Renamed"
    if ((file.changeType == "copied")):
        return "Copied"
    if ((file.changeType == "type-changed")):
        return "Type"
    if ((file.changeType == "conflicted")):
        return "Conflict"
    if ((file.changeType == "modified")):
        return "Modified"
    return (file.statusCode or "Changed")

fn historyFileChangeColor(file: GitHistoryCommitFile, palette: Any) -> Any:
    if ((file.changeType == "added")):
        return palette.green
    if (((file.changeType == "deleted") or (file.changeType == "conflicted"))):
        return palette.red
    if (((file.changeType == "renamed") or (file.changeType == "copied"))):
        return palette.accent
    return palette.yellow

fn historyDiffLineStyle(line_: String, palette: Any) -> Any:
    if (line_.startsWith("@@")):
        return none
    if ((line_.startsWith("+") and (!line_.startsWith("+++")))):
        return none
    if ((line_.startsWith("-") and (!line_.startsWith("---")))):
        return none
    if ((((line_.startsWith("diff --git") or line_.startsWith("index ")) or line_.startsWith("--- ")) or line_.startsWith("+++ "))):
        return none
    return none

