fn normalizeThemeCatalogId(themeId: String) -> String:
    return themeId.trim().toLowerCase()

fn resolveThemeCatalogPackageMetadata(themeId: String) -> Any:
    let normalizedId: Any = normalizeThemeCatalogId(themeId)
    let override_: Any = THEME_CATALOG_PACKAGE_OVERRIDES[normalizedId]
    let tier: Any = THEME_CATALOG_TIERS[(override_.tierId or "legacy-lab")]
    return none

struct ThemeCatalogComparablePackage:
    id: String
    name: String
    catalog: ThemeCatalogPackageMetadata

fn compareThemeCatalogPackages(left: ThemeCatalogComparablePackage, right: ThemeCatalogComparablePackage) -> Any:
    let tierOrder: Any = (left.catalog.tierOrder - right.catalog.tierOrder)
    if ((tierOrder != 0)):
        return tierOrder
    let sortRank: Any = (left.catalog.sortRank - right.catalog.sortRank)
    if ((sortRank != 0)):
        return sortRank
    let nameOrder: Any = left.name.localeCompare(right.name)
    if ((nameOrder != 0)):
        return nameOrder
    return left.id.localeCompare(right.id)

