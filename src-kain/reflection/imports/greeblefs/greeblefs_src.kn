fn normalizeStorageWorkbenchPath(path: String) -> Any:
    let trimmed: Any = path.trim()
    if ((!trimmed)):
        return ""
    if (none.test_(trimmed)):
        return trimmed.slice(0, 2) + none
    if (none.test_(trimmed)):
