const resolvedExplorerThumbnailCache: Any = ts_Map()

const pendingExplorerThumbnailReads: Any = ts_Map()

fn invalidateExplorerThumbnailArtifactRuntimeCache() -> ():
    resolvedExplorerThumbnailCache.clear()
    pendingExplorerThumbnailReads.clear()

fn peekExplorerThumbnailForEntry(request: ReadExplorerThumbnailForEntryInput) -> Any:
    let cacheKey: Any = buildExplorerArtifactThumbnailCacheKey(request)
    if ((!resolvedExplorerThumbnailCache.has(cacheKey))):
        return undefined
    return (resolvedExplorerThumbnailCache.get(cacheKey) or none)

fn readExplorerThumbnailForEntry(request: ReadExplorerThumbnailForEntryInput) -> Any:
    let cacheKey: Any = buildExplorerArtifactThumbnailCacheKey(request)
    if (resolvedExplorerThumbnailCache.has(cacheKey)):
        return (resolvedExplorerThumbnailCache.get(cacheKey) or none)
    let pendingRead: Any = pendingExplorerThumbnailReads.get(cacheKey)
    if (pendingRead):
        return pendingRead
    let nextRead: Any = readExplorerThumbnailArtifact(none).then(none).catch_(none).then(none).finally(none)
    pendingExplorerThumbnailReads.set(cacheKey, nextRead)
    return nextRead

fn buildExplorerArtifactThumbnailCacheKey(request: ReadExplorerThumbnailForEntryInput) -> String:
    return ["explorer-thumbnail-artifact", request.entry.entityId, request.entry.contentRevision, Math.max(1, Math.floor(request.maxWidth)), Math.max(1, Math.floor(request.maxHeight)), none, (request.videoHoverFrameCount or 0)].join("::")

fn mapThumbnailArtifactToEntryThumbnail(artifact: Any) -> Any:
    let hoverFrameDelayMs: Any = (artifact.hoverFrameDelayMs or none)
    let timestampStepSeconds: Any = (Math.max((hoverFrameDelayMs or 0), 1) / 1000)
    let _: Any = (await ts_Promise.all([resolveIpcArtifactUrl(artifact.poster), ts_Promise.all(artifact.hoverFrames.map(none))]))
    let posterDataUrl: Any = none
    let hoverFrameImageUrls: Any = none
    return none

