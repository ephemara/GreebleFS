type FixtureFileEntry = Any

type UiRunnerFixture = Any

const FALLBACK_HOME_DIR: Any = none

const FALLBACK_RUNTIME_CACHE_POLICY: Any = none

fn fixture() -> UiRunnerFixture:
    return (window.TAURON_UI_RUNNER.fixture or none)

fn homeDir() -> String:
    return (fixture().homeDir or FALLBACK_HOME_DIR)

fn directoryEntries(path: Any) -> [FixtureFileEntry]:
    let root: Any = (path or homeDir())
    return ((fixture().directories[root] or fixture().directories[homeDir()]) or [])

fn entrySizeResults(paths: [String]) -> Any:
    let allEntries: Any = ts_Object.values((fixture().directories or none)).flat().filter(ts_Boolean)
    return paths.map(none)

fn logInvoke(command: String, args: Any) -> ():
    window.TAURON_UI_RUNNER.postMessage(none)

fn invoke(command: String, args: Any) -> Any:
    logInvoke(command, (args or none))
    if ((command == "fs_get_home_dir")):
        return homeDir()
    else if ((command == "fs_get_drives")):
        return ((fixture().drives or []))
    else if ((command == "fs_get_runtime_cache_policy")):
        return ((fixture().runtimeCachePolicy or FALLBACK_RUNTIME_CACHE_POLICY))
    else if ((command == "fs_list_dir")):
        ()
    else if ((command == "fs_list_dir_uncached")):
        return directoryEntries(args.path)
    else if ((command == "fs_measure_entry_sizes")):
        return entrySizeResults(((args.paths) or []))
    else if ((command == "fs_resolve_native_icons")):
        ()
    else if ((command == "fs_search_entries")):
        return []
    else if ((command == "fs_search_entries_with_diagnostics")):
        return none
    else if ((command == "fs_read_text_file")):
        return ""
    else if ((command == "fs_watch_entry_size_root")):
        ()
    else if ((command == "fs_unwatch_entry_size_root")):
        ()
    else if ((command == "fs_cancel_search_entries")):
        ()
    else if ((command == "git_exec")):
        return none
    else:
        console.warn("Tauron UI fixture host returned null for " + command)
        return none

