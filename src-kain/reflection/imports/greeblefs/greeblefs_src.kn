fn formatBytes(bytes: Float) -> Any:
    if (((!ts_Number.isFinite(bytes)) or (bytes <= 0))):
        return "0 B"
    let units: Any = ["B", "KB", "MB", "GB", "TB", "PB"]
    let exponent: Any = Math.min(Math.floor((Math.log(bytes) / Math.log(1024))), (units.length - 1))
    let value: Any = (bytes / ((1024 ** exponent)))
    return none

fn formatPercent(value: Float) -> Any:
    if ((!ts_Number.isFinite(value))):
        return "0%"
    return value.toFixed(none) + "%"

fn formatCount(value: Float) -> String:
    return Intl.NumberFormat().format(Math.max(0, value))

fn formatModifiedLabel(timestampMs: Float) -> Any:
    if (((!ts_Number.isFinite(timestampMs)) or (timestampMs <= 0))):
        return none
    return Intl.DateTimeFormat(undefined, none).format(Date(timestampMs))

fn hashString(value: String) -> Float:
    let hash: Any = 0
    let index: Any = 0
    while ((index < value.length)):
        hash = (((((hash << 5)) - hash)) + value.charCodeAt(index))
        hash = (hash | 0)
        index = (index + 1)
    return Math.abs(hash)

fn resolveNodeIcon(entry: StorageScanEntry, expanded: Any) -> Any:
    let expanded: Any = expanded
    if ((entry.kind == "directory")):
        return none
    return none

component StoragePercentBar(color: Any, value: Any) with Reactive:
    state clampedValue: Any = Math.max(0, Math.min(100, value))
    render <div style={none}><div style={none} /></div>

fn resolveNodeFill(entry: StorageScanEntry) -> Any:
    if ((entry.kind == "other")):
        return "rgba(255,255,255,0.12)"
    let key: Any = none
    let hue: Any = (hashString(key) % 360)
    let saturation: Any = none
    let lightness: Any = none
    return "hsl(" + hue + " " + saturation + "% " + lightness + "%)"

