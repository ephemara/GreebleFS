const FIELD_BOUNDS: Any = ts_Object.freeze(none)

const EMPHASIS_RANK: Option<Any> = none

const GOLDEN_ANGLE: Any = (Math.PI * ((3 - Math.sqrt(5))))

const CLUSTER_SLOTS: Option<Any> = none

fn buildConstellationFieldLayout(bands: Any, selectedPaths: ReadonlySet<String>, density: Float, options: ConstellationFieldLayoutOptions) -> Any:
    let normalizedDensity: Any = clamp(density, 0, 1)
    let maxVisibleNodes: Any = clampNumber(Math.round((8 + (normalizedDensity * 22))), 8, 30)
    let visibleBands: Any = bands.filter(none)
    let pinnedPaths: Any = (options.pinnedPaths or ts_Set())
    if ((visibleBands.length == 0)):
        return none
    let width: Any = none
    let height: Any = none
    let slots: Any = (CLUSTER_SLOTS[visibleBands.length] or CLUSTER_SLOTS[5])
    let fieldBands: [ConstellationFieldBand] = []
    let connections: [ConstellationFieldConnection] = []
    let dominantPrimaryNode: Option<Any> = none
    let iter_8: Any = visibleBands
    let index_9: Any = 0
    while ((index_9 < iter_8.length)):
        let band: Any = iter_8[index_9]
        let bandIndex: Any = index_9
        let slot: Any = resolveClusterSlot(slots, bandIndex, visibleBands.length)
        let visibleEntries: Any = band.entries.slice(0, maxVisibleNodes)
        let anchorQuota: Any = none
        let singleBandNodeScale: Any = none
        let positionedEntries: Any = visibleEntries.map(none).sort(none)
        let centerX: Any = clampNumber((width * slot.x), FIELD_BOUNDS.paddingX, (width - FIELD_BOUNDS.paddingX))
        let centerY: Any = clampNumber((height * slot.y), FIELD_BOUNDS.paddingY, (height - FIELD_BOUNDS.paddingY))
        let singleBandSpreadBonus: Any = none
        let radius: Any = Math.round(((((none) + Math.min((band.entries.length * 4), none)) + singleBandSpreadBonus) + (normalizedDensity * 36)))
        let primaryEntry: Any = (((positionedEntries.find(none) or positionedEntries.find(none)) or positionedEntries[0]) or none)
        let coreEntries: Any = none
        let anchoredEntries: Any = coreEntries.filter(none)
        let satelliteEntries: Any = coreEntries.filter(none)
        let nodes: [ConstellationFieldNode] = []
        if (primaryEntry):
            nodes.push(none)
        let iter_0: Any = anchoredEntries
        let index_1: Any = 0
        while ((index_1 < iter_0.length)):
            let positionedEntry: Any = iter_0[index_1]
            let index: Any = index_1
            let anchoredAngle: Any = ((slot.angleOffset + (((((Math.PI * 2)) / Math.max(1, anchoredEntries.length))) * index)) + getHashAngleJitter(positionedEntry.hash, 0.16))
            let anchoredRadius: Any = (radius * ((0.36 + ((((index % 2)) * 0.1)))))
            nodes.push(createConstellationFieldNode(none))
            index_1 = (index_1 + 1)
        let iter_2: Any = satelliteEntries
        let index_3: Any = 0
        while ((index_3 < iter_2.length)):
            let positionedEntry: Any = iter_2[index_3]
            let index: Any = index_3
            let progress: Any = (((index + 0.72)) / Math.max(1, (satelliteEntries.length + 0.72)))
            let satelliteAngle: Any = ((slot.angleOffset + ((index * GOLDEN_ANGLE))) + getHashAngleJitter(positionedEntry.hash, 0.22))
            let satelliteRadius: Any = (radius * ((0.42 + (Math.sqrt(progress) * 0.58))))
            let yScale: Any = (slot.yScale * ((0.92 + ((((((positionedEntry.hash >> 3)) % 7)) * 0.015)))))
            nodes.push(createConstellationFieldNode(none))
            index_3 = (index_3 + 1)
        let bandPrimaryNode: Any = ((nodes.find(none) or nodes[0]) or none)
        let bandCoreNodes: Any = nodes.filter(none)
        let bandSatelliteNodes: Any = nodes.filter(none)
        if (bandPrimaryNode):
            if ((band.dominant and (!dominantPrimaryNode))):
                dominantPrimaryNode = bandPrimaryNode
            let iter_4: Any = bandCoreNodes.filter(none)
            let index_5: Any = 0
            while ((index_5 < iter_4.length)):
                let node: Any = iter_4[index_5]
                connections.push(createConstellationConnection(bandPrimaryNode, node, "primary"))
                index_5 = (index_5 + 1)
            let iter_6: Any = bandSatelliteNodes
            let index_7: Any = 0
            while ((index_7 < iter_6.length)):
                let node: Any = iter_6[index_7]
                let index: Any = index_7
                let anchorNode: Any = none
                connections.push(createConstellationConnection(anchorNode, node, "secondary"))
                if ((((normalizedDensity >= 0.46) and (index > 0)) and ((index % 2) == 0))):
                    connections.push(createConstellationConnection(bandSatelliteNodes[(index - 1)], node, "secondary"))
                index_7 = (index_7 + 1)
        let chipAlign: Any = none
        let chipX: Any = clampNumber((centerX + ((radius * slot.chipBiasX))), FIELD_BOUNDS.paddingX, (width - FIELD_BOUNDS.paddingX))
        let chipY: Any = clampNumber((centerY - ((radius * (none)))), FIELD_BOUNDS.paddingY, (height - FIELD_BOUNDS.paddingY))
        fieldBands.push(none)
        index_9 = (index_9 + 1)
    if ((!dominantPrimaryNode)):
        dominantPrimaryNode = (fieldBands.find(none).nodes[0] or none)
    if (dominantPrimaryNode):
        let dominantNode: Any = dominantPrimaryNode
        let iter_10: Any = fieldBands
        let index_11: Any = 0
        while ((index_11 < iter_10.length)):
            let band: Any = iter_10[index_11]
            let bandPrimaryNode: Any = (band.nodes[0] or none)
            if (((!bandPrimaryNode) or (bandPrimaryNode.entry.path == dominantNode.entry.path))):
                return none
            connections.push(createConstellationConnection(dominantNode, bandPrimaryNode, "bridge"))
            index_11 = (index_11 + 1)
    let resolvedConnections: Any = none
    return none

fn createConstellationFieldNode(input: Any) -> Any:
    let clamped: Any = clampConstellationPoint(none, input.width, input.height)
