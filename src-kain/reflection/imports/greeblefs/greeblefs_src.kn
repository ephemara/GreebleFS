        if ((((listRuntimeId and listLabel) and ts_Number.isFinite(index)) and panelListRegistry.has(listRuntimeId))):
            return none
    let hoveredListElement: Any = hoveredElement.closest("[data-draggable-panel-runtime-list-id]")
