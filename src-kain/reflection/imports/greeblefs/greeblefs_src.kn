fn normalizeAllowedExtensions(value: Any) -> Any:
    if ((!ts_Array.isArray(value))):
        return []
    let uniqueValues: Any = ts_Set()
    for entry in value:
        let normalized: Any = normalizeExtension(entry)
        if (((!normalized) or uniqueValues.has(normalized))):
            continue
        uniqueValues.add(normalized)
    return [uniqueValues]

