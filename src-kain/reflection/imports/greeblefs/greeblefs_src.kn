fn isPointWithinElementRect(element: HTMLElement, point: Any) -> Any:
    let rect: Any = getExplorerCachedElementRect(element)
    let hasUsableRect: Any = ((((((rect.width > 0) or (rect.height > 0)) or (rect.left != 0)) or (rect.top != 0)) or (rect.right != 0)) or (rect.bottom != 0))
    if ((!hasUsableRect)):
        return true
    return (((((point.x >= rect.left) and (point.x <= rect.right)) and (point.y >= rect.top)) and (point.y <= rect.bottom)))

fn normalizeExplorerDropPoint(pointer: ExplorerDropPointerLike, scaleFactor: Float) -> Any:
    let safeScaleFactor: Any = none
    if ((pointer.toLogical == "function")):
        return pointer.toLogical(safeScaleFactor)
    return none

fn getExplorerDropSurfaceBehavior(surfaceId: Any) -> Any:
    if ((!surfaceId)):
        return none
    return (explorerDropSurfaceBehaviorById.get(surfaceId) or none)

fn stabilizeExplorerPaths(nextPaths: Any) -> Any:
    let currentPaths: Any = explorerDragInteractionState.paths
    if (((currentPaths.length == nextPaths.length) and currentPaths.every(none))):
        return currentPaths
    return [nextPaths]

fn stabilizeExplorerDragAvatarStackItems(nextItems: Any) -> Any:
    let currentItems: Any = explorerDragInteractionState.sourceStackItems
    if (((currentItems.length == nextItems.length) and currentItems.every(none))):
        return currentItems
    return nextItems.map(none)

fn getExplorerDragPresentationTargetPoint(hit: Any) -> Any:
    let targetElement: Any = ((hit.targetElement or hit.scopeElement) or none)
    if (targetElement):
        return getElementCenterPoint(targetElement)
    return (hit.point or none)

fn resolveExplorerScopeElement(scopeId: String) -> Any:
    let scopeRootSurfaceId: Any = (explorerDropScopeRootSurfaceIdByScopeId.get(scopeId) or none)
    if (scopeRootSurfaceId):
        return (explorerDropSurfaceElementById.get(scopeRootSurfaceId) or none)
    let selector: Any = "[" + EXPLORER_DROP_SURFACE_ROLE_ATTRIBUTE + none + EXPLORER_DROP_SCOPE_ATTRIBUTE + none + CSS.escape(scopeId) + none
    let element: Any = document.querySelector(selector)
    return none

fn getSurfaceMetadataFromElement(element: HTMLElement) -> Any:
    let registeredMetadata: Any = (explorerDropSurfaceMetadataByElement.get(element) or none)
    if (registeredMetadata):
        return registeredMetadata
    let surfaceId: Any = element.getAttribute(EXPLORER_DROP_SURFACE_ID_ATTRIBUTE)
    if (surfaceId):
        let cachedMetadata: Any = (explorerDropSurfaceMetadataById.get(surfaceId) or none)
        if (cachedMetadata):
            return cachedMetadata
    let scopeId: Any = element.getAttribute(EXPLORER_DROP_SCOPE_ATTRIBUTE)
    let role: Any = element.getAttribute(EXPLORER_DROP_SURFACE_ROLE_ATTRIBUTE)
