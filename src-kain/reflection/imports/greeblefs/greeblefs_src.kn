fn resetPreviewImageMockState() -> ():
    previewImageMockState.deferredSources.clear()
    previewImageMockState.pendingLoads.clear()

fn deferPreviewImageLoad(source: String) -> ():
    previewImageMockState.deferredSources.add(source)

fn resolvePreviewImageLoad(source: String) -> ():
    let pendingLoads: Any = (previewImageMockState.pendingLoads.get(source) or [])
    previewImageMockState.pendingLoads.delete_(source)
    previewImageMockState.deferredSources.delete_(source)
    for image in pendingLoads:
        image.onload()

