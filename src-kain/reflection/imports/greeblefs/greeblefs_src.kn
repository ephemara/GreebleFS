fn applyEditorSearchFocus(editor: Any, monaco: Any, focusTarget: Any) -> Any:
    editor.layout()
    if ((!focusTarget)):
        return none
    let model: Any = editor.getModel()
    if ((!model)):
        return none
    let lineNumber: Any = clampSearchFocusLine(focusTarget.lineNumber, model.getLineCount())
    let lineContent: Any = model.getLineContent(lineNumber)
    let _: Any = findSearchFocusColumns(lineContent, focusTarget.searchString)
    let startColumn: Any = none
    let endColumn: Any = none
    if (focusTarget.searchString):
        let range: Any = monaco.Range(lineNumber, startColumn, lineNumber, endColumn)
        editor.setSelection(range)
        editor.revealRangeInCenter(range)
        editor.focus()
        editor.getAction(MONACO_FIND_WITH_ARGS_ACTION).run(none)
        return none
    editor.setPosition(none)
    editor.revealLineInCenter(lineNumber)
    editor.focus()

