const IMAGE_EXTS: Any = ts_Set(["jpg", "jpeg", "png", "gif", "webp", "svg", "bmp", "ico", "tiff", "avif"])

const CODE_EXTS: Any = ts_Set(["ts", "tsx", "js", "jsx", "rs", "py", "go", "c", "cpp", "h", "hpp", "cs", "java", "rb", "php", "swift", "kt", "vue", "html", "css", "scss", "json", "toml", "yaml", "yml", "xml", "md", "sh", "ps1", "bat", "lua", "sql"])

const ARCHIVE_EXTS: Any = ts_Set(["zip", "rar", "7z", "tar", "gz", "bz2", "xz"])

const VIDEO_EXTS: Any = ts_Set(["mp4", "mkv", "avi", "mov", "wmv", "flv", "webm", "m4v"])

const AUDIO_EXTS: Any = ts_Set(["mp3", "wav", "flac", "ogg", "m4a", "aac", "opus"])

const EXEC_EXTS: Any = ts_Set(["exe", "msi", "bat", "cmd", "ps1", "sh", "app", "dmg"])

const FONT_EXTS: Any = ts_Set(["ttf", "otf", "woff", "woff2"])

struct FileEntry:
    name: String
    path: String
    is_dir: Bool
    size: Float
    modified: Float
    extension: String
    is_hidden: Bool
    is_symlink: Bool

fn makeEntry(overrides: Any) -> Any:
    let overrides: Any = overrides
    return none

fn fileColor(entry: FileEntry) -> Any:
    if (entry.is_dir):
        return "#fbbf24"
    let ext: Any = entry.extension
    if (IMAGE_EXTS.has(ext)):
        return "#34d399"
    if (CODE_EXTS.has(ext)):
        return "#60a5fa"
    if (ARCHIVE_EXTS.has(ext)):
        return "#f97316"
    if (VIDEO_EXTS.has(ext)):
        return "#a78bfa"
    if (AUDIO_EXTS.has(ext)):
        return "#f472b6"
    if (EXEC_EXTS.has(ext)):
        return "#f87171"
    if (FONT_EXTS.has(ext)):
        return "#fb923c"
    return "#94a3b8"

fn monacoLang(ext: String) -> String:
    let map: Option<Any> = none
    return (map[ext] or "plaintext")

fn formatSize(bytes: Float) -> Any:
    if ((bytes < 1024)):
        return bytes + " B"
    if ((bytes < (1024 * 1024))):
        return ((bytes / 1024)).toFixed(1) + " KB"
    if ((bytes < (1024 ** 3))):
        return ((bytes / (1024 ** 2))).toFixed(1) + " MB"
    if ((bytes < (1024 ** 4))):
        return ((bytes / (1024 ** 3))).toFixed(2) + " GB"
    return ((bytes / (1024 ** 4))).toFixed(2) + " TB"

fn formatDate(ms: Float) -> Any:
    if ((!ms)):
        return none
    return Date(ms).toLocaleDateString(undefined, none)

fn sortEntries(entries: [FileEntry]) -> [FileEntry]:
    return [entries].sort(none)

fn typeLabel(entry: FileEntry) -> Any:
    if (entry.is_dir):
        return "Folder"
    let labels: Option<Any> = none
    return (labels[entry.extension] or entry.extension.toUpperCase() + " File")

fn sortEntriesBy(entries: [FileEntry], sortBy: String, sortOrder: String) -> [FileEntry]:
    return [entries].sort(none)

fn filterEntries(entries: [FileEntry], query: String) -> Any:
    if ((!query.trim())):
        return entries
    let q: Any = query.toLowerCase()
    return entries.filter(none)

