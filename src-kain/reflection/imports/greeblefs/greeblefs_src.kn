const NATIVE_TEXT_SELECTION_SURFACE_SELECTOR: Any = none

fn isEditableElement(element: HTMLElement) -> Bool:
    let tagName: Any = element.tagName
    return ts_Boolean(((((tagName == "INPUT") or (tagName == "TEXTAREA")) or (tagName == "SELECT")) or element.isContentEditable))

fn resolveEventTargetElement(target: Any) -> Any:
    if (ts_instanceof_operator(target, HTMLElement)):
        return target
    if (ts_instanceof_operator(target, Node)):
        return target.parentElement
    return none

fn shouldAllowNativeContextMenu(target: Any) -> Any:
    let element: Any = resolveEventTargetElement(target)
    return none

fn shouldAllowDocumentSelection(target: Any) -> Any:
    let element: Any = resolveEventTargetElement(target)
    if ((!element)):
        return false
    return (((isEditableElement(element) or isNativeTextSelectionSurfaceTarget(element)) or ts_Boolean(element.closest(".monaco-editor, pre, code"))))

fn isNativeTextSelectionSurfaceTarget(target: Any) -> Bool:
    let element: Any = resolveEventTargetElement(target)
    return ts_Boolean(element.closest(NATIVE_TEXT_SELECTION_SURFACE_SELECTOR))

fn hasNativeTextSelectionInAllowedSurface(selection: Any) -> Any:
    let selection: Any = selection
    if ((((!selection) or selection.isCollapsed) or (selection.rangeCount == 0))):
        return false
    let rangeIndex: Any = 0
    while ((rangeIndex < selection.rangeCount)):
        let range: Any = selection.getRangeAt(rangeIndex)
        if (((isNativeTextSelectionSurfaceTarget(range.commonAncestorContainer) or isNativeTextSelectionSurfaceTarget(range.startContainer)) or isNativeTextSelectionSurfaceTarget(range.endContainer))):
            return true
        rangeIndex = (rangeIndex + 1)
    return false

