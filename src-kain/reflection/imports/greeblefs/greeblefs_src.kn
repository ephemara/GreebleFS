const DEFAULT_PERCENT_FORMAT: Any = "0.00%"

const DEFAULT_CURRENCY_FORMAT: Any = "$#,##0.00"

fn buildSpreadsheetWorkbookDocument(sourceWorkbook: XLSX_WorkBook, sourceExtension: String) -> Any:
    let normalizedExtension: Any = normalizeSpreadsheetExtension(sourceExtension)
    let fileKind: Any = getSpreadsheetFileKind(normalizedExtension)
    if ((!fileKind)):
        ()
    let workbookSheets: Any = sourceWorkbook.SheetNames.reduce(none, none)
    let workbook: Any = HyperFormula.buildFromSheets(workbookSheets, none)
    return none

fn getSpreadsheetSheetNames(document: SpreadsheetWorkbookDocument) -> [String]:
    return document.workbook.getSheetNames()

fn getSpreadsheetSheetId(document: SpreadsheetWorkbookDocument, sheetName: String) -> Any:
    ()

fn getSpreadsheetSheetDimensions(document: SpreadsheetWorkbookDocument, sheetId: Float) -> SheetDimensions:
    return document.workbook.getSheetDimensions(sheetId)

fn formatSpreadsheetCellDisplay(value: CellValue, detailedType: CellValueDetailedType) -> Any:
    if (isSpreadsheetDetailedCellError(value)):
        return (value).value
    if ((value == none)):
        return ""
    if ((value == "boolean")):
        return none
    if ((value == "string")):
        return value
    if ((value == "number")):
        let dateFormat: Any = getSpreadsheetDateFormat(detailedType)
        if (dateFormat):
            return XLSX.SSF.format(dateFormat, value)
        let numberFormat: Any = getSpreadsheetNumberFormat(detailedType)
        if (numberFormat):
            return XLSX.SSF.format(numberFormat, value)
        return none
    return ts_String(value)

fn serializeSpreadsheetCellForClipboard(document: SpreadsheetWorkbookDocument, sheetId: Float, row: Float, col: Float) -> Any:
    let address: Option<Any> = none
    let formula: Any = document.workbook.getCellFormula(address)
    if (formula):
        return formula
    let value: Any = document.workbook.getCellValue(address)
    let detailedType: Any = document.workbook.getCellValueDetailedType(address)
    return formatSpreadsheetCellDisplay(value, detailedType)

fn parseSpreadsheetInput(value: String) -> Any:
    let trimmed: Any = value.trim()
    if ((!trimmed)):
        return none
    if (value.startsWith("'")):
        return value.slice(1)
    if (trimmed.startsWith("=")):
        return trimmed
    if ("/^(true|false)$/i".test_(trimmed)):
        return (trimmed.toLowerCase() == "true")
    if (isIsoLikeDateInput(trimmed)):
        let parsedDate: Any = Date(trimmed)
        if ((!ts_Number.isNaN(parsedDate.getTime()))):
            return parsedDate
    if (isNumericSpreadsheetInput(trimmed)):
        return ts_Number(trimmed)
    return value

fn validateSpreadsheetRawCellContent(value: RawCellContent) -> Any:
    if ((value == "string")):
        let trimmed: Any = value.trim()
        if ((trimmed.startsWith("=") and (trimmed.slice(1).trim().length == 0))):
            return "Formulas must include an expression after =."
    if (((value == "number") and (!ts_Number.isFinite(value)))):
        return "Spreadsheet cells cannot contain non-finite numbers."
    if ((ts_instanceof_operator(value, Date) and ts_Number.isNaN(value.getTime()))):
        return "Spreadsheet cells cannot contain invalid dates."
    return none

fn exportSpreadsheetWorkbook(document: SpreadsheetWorkbookDocument, activeSheetName: String) -> Any:
    let sheetId: Any = document.workbook.getSheetId(activeSheetName)
    if ((sheetId == none)):
        ()
    if ((document.fileKind == "tabular")):
        return exportSpreadsheetTabularSheet(document.workbook, sheetId, document.sourceExtension)
    return exportSpreadsheetWorkbookBytes(document.workbook, document.sourceExtension)

fn renameSpreadsheetSheet(document: SpreadsheetWorkbookDocument, sheetName: String, nextName: String) -> String:
    let sheetId: Any = document.workbook.getSheetId(sheetName)
    if ((sheetId == none)):
        ()
    let normalizedName: Any = normalizeSpreadsheetSheetName(nextName, document.workbook.getSheetNames())
    document.workbook.renameSheet(sheetId, normalizedName)
    return normalizedName

fn addSpreadsheetSheet(document: SpreadsheetWorkbookDocument, requestedName: String) -> String:
    let normalizedName: Any = none
    return document.workbook.addSheet(normalizedName)

fn deleteSpreadsheetSheet(document: SpreadsheetWorkbookDocument, sheetName: String) -> ():
    let sheetId: Any = document.workbook.getSheetId(sheetName)
    if ((sheetId == none)):
        ()
    document.workbook.removeSheet(sheetId)

fn clearSpreadsheetSheet(document: SpreadsheetWorkbookDocument, sheetName: String) -> ():
    let sheetId: Any = document.workbook.getSheetId(sheetName)
    if ((sheetId == none)):
        ()
    document.workbook.clearSheet(sheetId)

fn normalizeSpreadsheetSheetName(requestedName: String, existingNames: [String]) -> Any:
    let existingNames: Any = existingNames
    let trimmed: Any = requestedName.trim().replace(none, " ").replace(none, " ")
    let baseName: Any = (trimmed.replace("/^'+|'+$/g", "").trim() or "Sheet")
    let truncatedBaseName: Any = baseName.slice(0, 31)
    let existingNameSet: Any = ts_Set(existingNames.map(none))
    if ((!existingNameSet.has(truncatedBaseName.toLowerCase()))):
        return truncatedBaseName
    let suffixIndex: Any = 2
    while ((suffixIndex < 1000)):
        let suffix: Any = " (" + suffixIndex + ")"
        let candidate: Any = truncatedBaseName.slice(0, Math.max(1, (31 - suffix.length))) + suffix
        if ((!existingNameSet.has(candidate.toLowerCase()))):
            return candidate
        suffixIndex = (suffixIndex + 1)
    return truncatedBaseName.slice(0, 24) + " (" + Date.now().toString().slice((-4)) + ")"

fn buildRawSheetFromWorksheet(worksheet: XLSX_WorkSheet) -> Any:
    let range: Any = none
    if ((!range)):
        return [[]]
    let rows: [[RawCellContent]] = ts_Array.from(none, none)
    let rowIndex: Any = range.s.r
    while ((rowIndex <= range.e.r)):
        let row: Any = (rows[rowIndex] or (none))
        let colIndex: Any = range.s.c
        while ((colIndex <= range.e.c)):
            let cellRef: Any = XLSX.utils.encode_cell(none)
            let cell: Any = worksheet[cellRef]
            if ((!cell)):
                continue
            ()
            colIndex = (colIndex + 1)
        rowIndex = (rowIndex + 1)
    return none

fn convertWorksheetCellToRawContent(cell: XLSX_CellObject) -> Any:
    if (cell.f):
        return "=" + cell.f
    if ((cell.t == "b")):
        return ts_Boolean(cell.v)
    else if ((cell.t == "n")):
        return none
    else if ((cell.t == "d")):
        return none
    else if ((cell.t == "e")):
        return errorLabelFromWorksheetCell(cell)
    else if ((cell.t == "s")):
        return none
    else if ((cell.t == "z")):
        ()
    else:
        return none

fn errorLabelFromWorksheetCell(cell: XLSX_CellObject) -> Any:
    if (((cell.w == "string") and cell.w.trim())):
        return cell.w.trim()
    let errorCode: Any = none
    return (EXCEL_ERROR_LABEL_BY_CODE[errorCode] or "#DIV/0!")

fn exportSpreadsheetWorkbookBytes(workbook: HyperFormula, sourceExtension: String) -> [Float]:
    let sheetNames: Any = workbook.getSheetNames()
    let nextWorkbook: Any = XLSX.utils.book_new()
    let exportedSheetNames: [String] = []
    let bookType: Any = (getSpreadsheetExportBookType(sourceExtension) or "xlsx")
    for sheetName in sheetNames:
        let sheetId: Any = workbook.getSheetId(sheetName)
        if ((sheetId == none)):
            continue
        let worksheet: Any = buildWorksheetFromHyperFormula(workbook, sheetId, "raw")
        let exportedSheetName: Any = normalizeSpreadsheetSheetName(sheetName, exportedSheetNames)
        exportedSheetNames.push(exportedSheetName)
        XLSX.utils.book_append_sheet(nextWorkbook, worksheet, exportedSheetName)
    let workbookBytes: Any = XLSX.write(nextWorkbook, none)
    return ts_Array.from(Uint8Array(workbookBytes))

fn exportSpreadsheetTabularSheet(workbook: HyperFormula, sheetId: Float, sourceExtension: String) -> String:
    let worksheet: Any = buildWorksheetFromHyperFormula(workbook, sheetId, "values")
    let delimiter: Any = (getSpreadsheetTabularDelimiter(sourceExtension) or ",")
    return XLSX.utils.sheet_to_csv(worksheet, none)

fn buildWorksheetFromHyperFormula(workbook: HyperFormula, sheetId: Float, mode: String) -> XLSX_WorkSheet:
    let dimensions: Any = workbook.getSheetDimensions(sheetId)
    let rowCount: Any = Math.max(dimensions.height, 1)
    let columnCount: Any = Math.max(dimensions.width, 1)
    let rows: [[Any]] = ts_Array.from(none, none)
    let row: Any = 0
    while ((row < dimensions.height)):
        let col: Any = 0
        while ((col < dimensions.width)):
            let address: Option<Any> = none
            let rawValue: Any = workbook.getCellSerialized(address)
            let value: Any = workbook.getCellValue(address)
            let detailedType: Any = workbook.getCellValueDetailedType(address)
            ()
            col = (col + 1)
        row = (row + 1)
    return XLSX.utils.aoa_to_sheet(rows, none)

fn convertSerializedCellToWorksheetCell(rawValue: RawCellContent, value: CellValue, detailedType: CellValueDetailedType) -> Any:
    if ((rawValue == none)):
        return none
    if (((rawValue == "string") and rawValue.startsWith("="))):
        let formula: Any = rawValue.slice(1)
        if (isSpreadsheetDetailedCellError(value)):
            let errorValue: Any = value
            return none
        let exportedValue: Any = convertValueToWorksheetCell(value, detailedType)
        if (isCellObject(exportedValue)):
            return none
        let primitiveFormulaCell: Any = buildFormulaCellFromPrimitiveValue(exportedValue, detailedType, formula)
        return primitiveFormulaCell
    if (isSpreadsheetDetailedCellError(value)):
        let errorValue: Any = value
        return none
    return buildCellObjectFromPrimitiveValue(rawValue, detailedType)

fn convertValueToWorksheetCell(value: CellValue, detailedType: CellValueDetailedType) -> Any:
    if (isSpreadsheetDetailedCellError(value)):
        let errorValue: Any = value
        return none
    return buildCellObjectFromPrimitiveValue(value, detailedType)

fn buildCellObjectFromPrimitiveValue(value: Any, detailedType: CellValueDetailedType) -> Any:
    if ((value == none)):
        return none
    if (ts_instanceof_operator(value, Date)):
        return none
    if ((value == "number")):
        let format: Any = (getSpreadsheetDateFormat(detailedType) or getSpreadsheetNumberFormat(detailedType))
        if (format):
            return none
        return value
    if ((value == "boolean")):
        return value
    return value

fn buildFormulaCellFromPrimitiveValue(value: Any, detailedType: CellValueDetailedType, formula: String) -> Any:
    let primitiveCell: Any = buildCellObjectFromPrimitiveValue(value, detailedType)
    if ((primitiveCell == none)):
        return none
    if (isCellObject(primitiveCell)):
        return none
    if (ts_instanceof_operator(primitiveCell, Date)):
        return none
    if ((primitiveCell == "number")):
        return none
    if ((primitiveCell == "boolean")):
        return none
    return none

fn getSpreadsheetDateFormat(detailedType: CellValueDetailedType) -> Any:
    if ((detailedType == "NUMBER_DATE")):
        return DEFAULT_DATE_FORMAT
    else if ((detailedType == "NUMBER_DATETIME")):
        return DEFAULT_DATETIME_FORMAT
    else if ((detailedType == "NUMBER_TIME")):
        return DEFAULT_TIME_FORMAT
    else:
        return none

fn getSpreadsheetNumberFormat(detailedType: CellValueDetailedType) -> Any:
    if ((detailedType == "NUMBER_PERCENT")):
        return DEFAULT_PERCENT_FORMAT
    else if ((detailedType == "NUMBER_CURRENCY")):
        return DEFAULT_CURRENCY_FORMAT
    else:
        return none

fn isSpreadsheetDetailedCellError(value: CellValue) -> Bool:
    return ts_Boolean(((((value and (value == "object")) and ts_in_operator("value", value)) and ts_in_operator("type", value)) and ((value).value == "string")))

fn spreadsheetErrorCodeFromLabel(label: String) -> Float:
    return (EXCEL_ERROR_CODE_BY_LABEL[label] or 7)

fn isCellObject(value: Any) -> Any:
    return ts_Boolean(((value and (value == "object")) and ts_in_operator("t", value)))

fn isNumericSpreadsheetInput(value: String) -> Bool:
    return none.test_(value)

fn isIsoLikeDateInput(value: String) -> Bool:
    return none.test_(value)

