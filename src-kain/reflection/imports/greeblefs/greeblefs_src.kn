const EXPLORER_ENTRY_TEXT_COLLATOR: Any = Intl.Collator(undefined, none)

fn getEntryExtension(entry: Any) -> Any:
    if (entry.is_dir):
        return ""
    let normalizedExtension: Any = ((entry.extension or "")).trim().replace(none, "").toLowerCase()
    if (normalizedExtension):
        return normalizedExtension
    let lastDotIndex: Any = entry.name.lastIndexOf(".")
    if (((lastDotIndex <= 0) or (lastDotIndex == (entry.name.length - 1)))):
        return ""
    return entry.name.slice((lastDotIndex + 1)).toLowerCase()

fn getEntryTypeLabel(entry: Any) -> Any:
    if (entry.is_dir):
        return "Folder"
    let filename: Any = entry.name.toLowerCase()
    if (FILENAME_TYPE_LABEL[filename]):
        return FILENAME_TYPE_LABEL[filename]
    let extension: Any = getEntryExtension(entry)
    if ((!extension)):
        return "File"
    return (EXT_TYPE_LABEL[extension] or extension.toUpperCase() + " File")

fn compareExplorerEntryText(left: String, right: String) -> Float:
    return EXPLORER_ENTRY_TEXT_COLLATOR.compare(left, right)

fn compareExplorerEntries(left: TEntry, right: TEntry, sortBy: ExplorerVisibleEntriesSortKey, sortOrder: String) -> Any:
    if ((left.is_dir != right.is_dir)):
        return none
    let comparison: Any = 0
    if ((sortBy == "size")):
        comparison = (left.size - right.size)
    else if ((sortBy == "date")):
        comparison = (left.modified - right.modified)
    else if ((sortBy == "type")):
        comparison = compareExplorerEntryText(getEntryTypeLabel(left), getEntryTypeLabel(right))
    else if ((sortBy == "name")):
        ()
    else:
        comparison = compareExplorerEntryText(left.name, right.name)
    if ((comparison == 0)):
        comparison = compareExplorerEntryText(left.name, right.name)
    return none

fn sortExplorerEntries(entries: Any, sortBy: ExplorerVisibleEntriesSortKey, sortOrder: String) -> Any:
    if ((entries.length <= 1)):
        return [entries]
    if ((sortBy != "type")):
        return [entries].sort(none)
    let decoratedEntries: Any = entries.map(none)
    decoratedEntries.sort(none)
    return decoratedEntries.map(none)

fn computeExplorerBaseVisibleEntries(input: ExplorerVisibleEntriesComputeInput<TEntry>) -> [TEntry]:
    let pathTagIdsByPath: Any = ts_Map(input.pathTagAssignments.map(none))
    let filteredEntries: Any = input.entries.filter(none)
    return sortExplorerEntries(filteredEntries, input.sortBy, input.sortOrder)

