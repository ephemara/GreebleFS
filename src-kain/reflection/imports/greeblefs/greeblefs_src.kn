const loadedFonts: Any = ts_Set()

const pluginFontFamilies: Any = ts_Set()

const pluginFontsStyleElementId: Any = "overlayterm-plugin-fonts"

fn getPrimaryFontFamily(fontFamily: String) -> Any:
    return (fontFamily.split(",").map(none).find(none) or none)

fn getPluginFontsStyleElement() -> Any:
    if ((document == "undefined")):
        return none
    let style: Any = document.getElementById(pluginFontsStyleElementId)
    if ((!style)):
        style = document.createElement("style")
        style.id = pluginFontsStyleElementId
        document.head.appendChild(style)
    return style

fn setOverlayPluginFonts(fonts: [OverlayRegisteredFontContribution]) -> ():
    let mergedOptions: Any = ts_Map(builtInOverlayFontCatalog.map(none))
    let fontFaceRules: [String] = []
    pluginFontFamilies.clear()
    let iter_0: Any = fonts
    let index_1: Any = 0
    while ((index_1 < iter_0.length)):
        let font: Any = iter_0[index_1]
        let faceName: Any = ((font.faceName.trim() or getPrimaryFontFamily(font.family)) or font.name)
        pluginFontFamilies.add(faceName)
        mergedOptions.set(font.id, none)
        fontFaceRules.push(none + faceName.replace(none, none) + none + font.sourceUrl + none + (font.format or "truetype") + none + (font.style or "normal") + "; font-weight: " + (font.weight or "400") + "; font-display: swap; }")
        index_1 = (index_1 + 1)
    overlayFontCatalog.splice(0, overlayFontCatalog.length, none)
    let style: Any = getPluginFontsStyleElement()
    if (style):
        style.textContent = fontFaceRules.join(none)

fn ensureFontFamilyLoaded(fontFamily: String) -> Any:
    if ((document == "undefined")):
        return none
    let familyName: Any = fontFamily.split(",").map(none).find(none)
    if ((((!familyName) or loadedFonts.has(familyName)) or pluginFontFamilies.has(familyName))):
        return none
    loadedFonts.add(familyName)
    let link: Any = document.createElement("link")
    link.rel = "stylesheet"
    link.href = "https://fonts.googleapis.com/css2?family=" + encodeURIComponent(familyName) + ":wght@400;500;600;700&display=swap"
    document.head.appendChild(link)

fn clampUnitInterval(value: Float) -> Any:
    if ((!ts_Number.isFinite(value))):
        return 0
    return Math.min(Math.max(value, 0), 1)

fn formatAlphaComponent(value: Float) -> String:
    return ts_String((Math.round((clampUnitInterval(value) * 1000)) / 1000))

fn multiplyColorAlpha(color: String, alphaMultiplier: Float) -> Any:
    let multiplier: Any = clampUnitInterval(alphaMultiplier)
    let trimmed: Any = color.trim()
    if ((!trimmed)):
        return color
    if ((multiplier >= 0.999)):
        return trimmed
    if ((trimmed == "transparent")):
        return "rgba(0, 0, 0, 0)"
    if (trimmed.startsWith("#")):
        let hex: Any = trimmed.slice(1)
        if ((![3, 4, 6, 8].includes(hex.length))):
            return "color-mix(in srgb, " + trimmed + " " + Math.round((multiplier * 100)) + "%, transparent)"
        let expanded: Any = none
        let red: Any = ts_Number.parseInt(expanded.slice(0, 2), 16)
        let green: Any = ts_Number.parseInt(expanded.slice(2, 4), 16)
        let blue: Any = ts_Number.parseInt(expanded.slice(4, 6), 16)
        let sourceAlpha: Any = none
        return "rgba(" + red + ", " + green + ", " + blue + ", " + formatAlphaComponent((sourceAlpha * multiplier)) + ")"
    let rgbaMatch: Any = trimmed.match_(none)
    if (rgbaMatch):
        let _: Any = rgbaMatch
        let red: Any = none
        let green: Any = none
        let blue: Any = none
        let alpha: Any = none
        return "rgba(" + red.trim() + ", " + green.trim() + ", " + blue.trim() + ", " + formatAlphaComponent((ts_Number.parseFloat(alpha) * multiplier)) + ")"
    let rgbMatch: Any = trimmed.match_(none)
    if (rgbMatch):
        let _: Any = rgbMatch
        let red: Any = none
        let green: Any = none
        let blue: Any = none
        return "rgba(" + red.trim() + ", " + green.trim() + ", " + blue.trim() + ", " + formatAlphaComponent(multiplier) + ")"
    let hslaMatch: Any = trimmed.match_(none)
    if (hslaMatch):
        let _: Any = hslaMatch
        let hue: Any = none
        let saturation: Any = none
        let lightness: Any = none
        let alpha: Any = none
        return "hsla(" + hue.trim() + ", " + saturation.trim() + ", " + lightness.trim() + ", " + formatAlphaComponent((ts_Number.parseFloat(alpha) * multiplier)) + ")"
    let hslMatch: Any = trimmed.match_(none)
    if (hslMatch):
        let _: Any = hslMatch
        let hue: Any = none
        let saturation: Any = none
        let lightness: Any = none
        return "hsla(" + hue.trim() + ", " + saturation.trim() + ", " + lightness.trim() + ", " + formatAlphaComponent(multiplier) + ")"
    return "color-mix(in srgb, " + trimmed + " " + Math.round((multiplier * 100)) + "%, transparent)"

fn applyPanelTransparency(theme: OverlayThemeDefinition, panelTransparency: Float) -> Any:
    let panelOpacity: Any = (1 - clampOverlayVisualControlValue("panelTransparency", panelTransparency))
    if ((panelOpacity >= 0.999)):
        return theme
    return none

