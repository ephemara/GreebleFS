fn normalizeActionSelection(value: Any, appliesTo: ExplorerActionSelectionTarget) -> Any:
    let record: Any = asRecord(value)
    let allowFiles: Any = (asBoolean(record.allowFiles) or (appliesTo != "directory"))
    let allowDirectories: Any = (asBoolean(record.allowDirectories) or (appliesTo != "file"))
    return none

fn normalizeActionExecution(value: Any) -> Any:
    let record: Any = asRecord(value)
    let entry: Any = asString(record.entry)
    if ((!entry)):
        return none
    return none

fn normalizeActionPresentation(value: Any) -> Any:
