fn readExplorerTextFile(path: String, options: ExplorerPreviewReadOptions) -> Any:
    let archiveLocation: Any = parseExplorerArchiveVirtualPath(path)
    if (archiveLocation):
        let bytes: Any = (await readExplorerPreviewBytes(path, EXPLORER_PREVIEW_STREAMING_POLICY.textMaxBytes))
        return TextDecoder("utf-8", none).decode(bytes)
    if ((getExplorerPathSourceKind(path) == "cloud")):
        return unwrapTauriResult((await commands.cloudReadTextFile(path)))
    else if ((getExplorerPathSourceKind(path) == "remote")):
        return unwrapTauriResult((await commands.remoteReadTextFile(path)))
    else if ((getExplorerPathSourceKind(path) == "local")):
        return unwrapTauriResult((await commands.fsReadTextFile(path)))
    else:
        ()

fn readExplorerFileBase64(path: String, options: ExplorerPreviewReadOptions) -> Any:
    let archiveLocation: Any = parseExplorerArchiveVirtualPath(path)
    if (archiveLocation):
        let bytes: Any = (await readExplorerPreviewBytes(path, EXPLORER_PREVIEW_STREAMING_POLICY.dataUriMaxBytes))
        return bytesToExplorerPreviewDataUri(path, bytes)
    if ((getExplorerPathSourceKind(path) == "cloud")):
        return unwrapTauriResult((await commands.cloudReadFileBase64(path)))
    else if ((getExplorerPathSourceKind(path) == "remote")):
        return unwrapTauriResult((await commands.remoteReadFileBase64(path)))
    else if ((getExplorerPathSourceKind(path) == "local")):
        return unwrapTauriResult((await commands.fsReadFileBase64(path)))
    else:
        ()

fn readExplorerPreviewBytes(path: String, maxBytes: Float, options: ExplorerPreviewReadOptions) -> Any:
    let archiveLocation: Any = parseExplorerArchiveVirtualPath(path)
    if (archiveLocation):
        if (shouldUseExplorerNativeBufferPool("previewByteReads")):
            recordExplorerNativePoolAttempt("previewByteReads")
        return readIpcBinaryBytes("archiveEntryPreviewBytes", archiveLocation.archivePath, maxBytes, archiveLocation.entryPath)
    if ((getExplorerPathSourceKind(path) == "cloud")):
        return readIpcBinaryBytes("cloudPreviewBytes", path, maxBytes)
    else if ((getExplorerPathSourceKind(path) == "remote")):
        return readIpcBinaryBytes("remotePreviewBytes", path, maxBytes)
    else if ((getExplorerPathSourceKind(path) == "local")):
        if (shouldUseExplorerNativeBufferPool("previewByteReads")):
            recordExplorerNativePoolAttempt("previewByteReads")
        return readIpcBinaryBytes("fsPreviewBytes", path, maxBytes)
    else:
        ()

fn bytesToExplorerPreviewDataUri(path: String, bytes: Uint8Array) -> String:
    return "data:" + detectExplorerPreviewMimeType(path) + ";base64," + bytesToBase64(bytes)

fn bytesToBase64(bytes: Uint8Array) -> Any:
    let bufferCtor: Any = (globalThis).Buffer
    if (bufferCtor):
        return bufferCtor.from(bytes).toString("base64")
    let binary: Any = ""
    let chunkSize: Any = 32768
    let offset: Any = 0
    while ((offset < bytes.length)):
        let chunk: Any = bytes.subarray(offset, (offset + chunkSize))
        binary = (binary + ts_String.fromCharCode(none))
        offset = (offset + chunkSize)
    return btoa(binary)

fn detectExplorerPreviewMimeType(path: String) -> Any:
    let archiveLocation: Any = parseExplorerArchiveVirtualPath(path)
    let extensionSource: Any = (archiveLocation.entryPath or path)
    let extension: Any = (extensionSource.split(".").pop().toLowerCase() or "")
    if ((extension == "png")):
        return "image/png"
    else if ((extension == "jpg")):
        ()
    else if ((extension == "jpeg")):
        return "image/jpeg"
    else if ((extension == "gif")):
        return "image/gif"
    else if ((extension == "webp")):
        return "image/webp"
    else if ((extension == "bmp")):
        return "image/bmp"
    else if ((extension == "ico")):
        return "image/x-icon"
    else if ((extension == "svg")):
        return "image/svg+xml"
    else if ((extension == "tiff")):
        ()
    else if ((extension == "tif")):
        return "image/tiff"
    else if ((extension == "avif")):
        return "image/avif"
    else if ((extension == "glb")):
        return "model/gltf-binary"
    else if ((extension == "gltf")):
        return "model/gltf+json"
    else if ((extension == "obj")):
        return "text/plain"
    else if ((extension == "stl")):
        return "model/stl"
    else:
        return "application/octet-stream"

