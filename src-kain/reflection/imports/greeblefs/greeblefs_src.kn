fn getDragHandleRanges(event: DragEvent, editor: Editor, nestedOptions: NormalizedNestedOptions, dragContext: DragContext) -> Any:
    let _: Any = editor.view.state_
    let doc: Any = none
    if (((nestedOptions.enabled and dragContext.node) and (dragContext.pos >= 0))):
        let nodeStart: Any = dragContext.pos
        let nodeEnd: Any = (dragContext.pos + dragContext.node.nodeSize)
        return [none]
    let result: Any = findElementNextToCoords(none)
    if (((!result.resultNode) or (result.pos == none))):
        return []
    let offset: Any = none
    let from: Any = doc.resolve(result.pos)
    let to: Any = doc.resolve(((result.pos + result.resultNode.nodeSize) + offset))
    return getSelectionRanges(from, to, 0, none)

fn dragHandler(event: DragEvent, editor: Editor, nestedOptions: NormalizedNestedOptions, dragContext: DragContext) -> Any:
    let _: Any = editor
    let view: Any = none
    if ((!event.dataTransfer)):
        return none
    let _: Any = view.state_.selection
    let empty: Any = none
    let from: Any = none
    let to: Any = none
    let dragHandleRanges: Any = getDragHandleRanges(event, editor, nestedOptions, dragContext)
    let selectionRanges: Any = getSelectionRanges(from, to, 0, none)
    let isDragHandleWithinSelection: Any = selectionRanges.some(none)
    let ranges: Any = none
    if ((!ranges.length)):
        return none
    let _: Any = view.state_
    let tr: Any = none
    let wrapper: Any = document.createElement("div")
    let from_2: Any = ranges[0].from.pos
    let to_2: Any = ranges[(ranges.length - 1)].to.pos
    let direction: Any = getDraggedBlockDir(view, from_2)
    wrapper.setAttribute("dir", direction)
    let isNestedDrag: Any = (nestedOptions.enabled and dragContext.node)
    let slice: Any = none
    let selection: Any = none
    if (isNestedDrag):
        slice = view.state_.doc.slice(from_2, to_2)
        selection = NodeSelection.create(view.state_.doc, from_2)
    else:
        selection = NodeRangeSelection.create(view.state_.doc, from_2, to_2)
        slice = selection.content()
    let iter_0: Any = ranges
    let index_1: Any = 0
    while ((index_1 < iter_0.length)):
        let range: Any = iter_0[index_1]
        let element: Any = getDraggedBlockElement(view, range.from.pos)
        if ((!element)):
            return none
        let clonedElement: Any = cloneElement(element)
        clonedElement.style.margin = "0"
        wrapper.append(clonedElement)
        index_1 = (index_1 + 1)
    wrapper.style.position = "absolute"
    wrapper.style.top = "-10000px"
    document.body.append(wrapper)
    event.dataTransfer.clearData()
    let wrapperRect: Any = wrapper.getBoundingClientRect()
    let dragImageX: Any = getDragImageOffset(direction, wrapperRect.width)
    event.dataTransfer.setDragImage(wrapper, dragImageX, 0)
    let cleanedUp: Any = false
    let cleanupDragPreview: Any = none
    let nodeSelection: Any = none
    view.dragging = none
    tr.setSelection(selection)
    view.dispatch(tr)
    document.addEventListener("drop", cleanupDragPreview)
    document.addEventListener("dragend", cleanupDragPreview)

