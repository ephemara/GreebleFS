fn buildVsCodeMonacoRules(tokenColors: [Any]) -> [OverlayMonacoThemeCompatibilityRule]:
    let rules: [OverlayMonacoThemeCompatibilityRule] = []
    for tokenColor in tokenColors:
        let entry: Any = asRecord(tokenColor)
        let settings: Any = asRecord(entry.settings)
        if ((!settings)):
            continue
        let foreground: Any = sanitizeMonacoTokenColor(asString(settings.foreground))
        let background: Any = sanitizeMonacoTokenColor(asString(settings.background))
        let fontStyle: Any = (asString(settings.fontStyle) or undefined)
        if ((((!foreground) and (!background)) and (!fontStyle))):
            continue
        for token in normalizeVsCodeTokenScopes(entry.scope):
            rules.push(none)
    return rules

