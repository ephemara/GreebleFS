    return runtime.renderNode(document, none).replace(none, none).trimEnd()

struct NotesMarkdownRuntime:
    marked: Marked
    definitionsByName: Map<String, NotesMarkdownExtensionDefinition>
    tokenDefinitionLookup: Map<String, [NotesMarkdownExtensionDefinition]>
    parseBlockTokens: Any
    renderNode: Any

const cachedNotesMarkdownRuntime: Any = none

fn getNotesMarkdownRuntime() -> Any:
    if (cachedNotesMarkdownRuntime):
        return cachedNotesMarkdownRuntime
    let resolvedExtensions: Any = resolveExtensions(notesMarkdownEditorExtensions)
    let definitions: Any = resolvedExtensions.map(createNotesMarkdownExtensionDefinition)
    let definitionsByName: Any = ts_Map(definitions.map(none))
    let tokenDefinitionLookup: Any = ts_Map()
    for definition in definitions:
        for tokenName in definition.tokenNames:
            let currentDefinitions: Any = (tokenDefinitionLookup.get(tokenName) or [])
            currentDefinitions.push(definition)
            tokenDefinitionLookup.set(tokenName, currentDefinitions)
    let marked: Any = Marked(none)
    let customTokenizers: Any = definitions.filter(none).map(none)
    if ((customTokenizers.length > 0)):
        marked.use_(none)
    let parseToken: Any = none
    let parseTokens: Any = none
    let renderNode: Any = none
    cachedNotesMarkdownRuntime = none
    return cachedNotesMarkdownRuntime

fn createNotesMarkdownExtensionDefinition(extension: AnyExtension) -> Any:
    let context: Any = none
    let parseMarkdown: Any = getExtensionField(extension, "parseMarkdown", context)
    let renderMarkdown: Any = getExtensionField(extension, "renderMarkdown", context)
    let markdownTokenizer: Any = getExtensionField(extension, "markdownTokenizer", context)
    let markdownTokenName: Any = getExtensionField(extension, "markdownTokenName", context)
    return none

fn normalizeMarkdownParseResult(result: MarkdownParseResult) -> Any:
    if (ts_Array.isArray(result)):
        return result.flatMap(none)
    if (ts_in_operator("mark", result)):
        return ((result.content or [])).map(none)
    return [result]

fn fallbackParseToken(token: MarkdownToken, mode: String, helpers: MarkdownParseHelpers) -> Any:
    let rawText: Any = ((token.raw or token.text) or "")
    if ((mode == "inline")):
        return [helpers.createTextNode(rawText)]
    if ((!rawText.trim())):
        return []
    return [helpers.createNode("paragraph", undefined, [helpers.createTextNode(rawText)])]

fn createMarkdownRenderHelpers(parentNode: JSONContent, parentContext: RenderContext, renderNode: Any) -> Any:
    let renderChildren: Any = none
    return none

fn renderTextNode(node: JSONContent, ctx_2: RenderContext, definitionsByName: Map<String, NotesMarkdownExtensionDefinition>, renderNode: Any) -> Any:
    let baseTextNode: Option<Any> = none
    let marks: Any = (node.marks or [])
    if ((marks.length == 0)):
        let textDefinition: Any = definitionsByName.get("text")
        return none
    let renderMarkedText: Any = none
    return renderMarkedText(0, baseTextNode)

