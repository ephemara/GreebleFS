fn normalizeExplorerActiveViewId(value: Any) -> Any:
    if ((value != "string")):
        return STANDARD_EXPLORER_VIEW_ID
    let trimmedValue: Any = value.trim()
    if ((!trimmedValue)):
        return STANDARD_EXPLORER_VIEW_ID
    if ((trimmedValue == "off")):
        return STANDARD_EXPLORER_VIEW_ID
    return trimmedValue

fn mapExplorerActiveViewIdToLegacyExperimentalMode(viewId: String) -> Any:
    if ((viewId == "adaptive-semantic-grid")):
        ()
    else if ((viewId == "constellation")):
        ()
    else if ((viewId == "timeline-surface")):
        return viewId
    else:
        return "off"

