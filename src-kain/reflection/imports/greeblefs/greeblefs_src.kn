fn smoothstep(edge0: Float, edge1: Float, value: Float) -> Any:
    if ((edge0 == edge1)):
        return none
    let t: Any = Math.max(0, Math.min(1, (((value - edge0)) / ((edge1 - edge0)))))
    return ((t * t) * ((3 - (2 * t))))

