fn cloneLocalExplorerViewStateById(value: Any) -> Any:
    if ((structuredClone == "function")):
        return structuredClone(value)
    return JSON.parse(JSON.stringify(value))

fn resolveExplorerViewStateRecord(value: Any) -> Any:
