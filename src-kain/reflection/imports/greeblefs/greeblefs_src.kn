fn getTargetElement(target: Any) -> Any:
    if (ts_instanceof_operator(target, Element)):
        return target
    if (ts_instanceof_operator(target, Node)):
        return target.parentElement
    return none

fn isEventInsideExplorerZoomScope(target: Any) -> Bool:
    return (getTargetElement(target).closest(EXPLORER_ZOOM_SCOPE_SELECTOR) != none)

fn shouldExplorerZoomScopeOwnWheelGesture(args: Any) -> Bool:
    return ((matchesWheelHotkey(args.event, args.binding) and isEventInsideExplorerZoomScope(args.target)))

fn useExplorerZoomGestureRouter(args: UseExplorerZoomGestureRouterArgs) -> Any:
    let controllerMapRef: Any = useRef(ts_Map())
    let registerZoomController: Any = useCallback(none, [])
    useLayoutEffect(none, [args.getViewportHeight, args.hotkeyBinding, args.scopeNode])
    return none

type ExplorerFileEntry = Any

type ExplorerBatchRenameMode = String

struct ExplorerBatchRenameRecipe:
    mode: ExplorerBatchRenameMode
    findText: String
    replaceText: String
    prefix: String
    suffix: String
    startingNumber: Float
    padding: Float

struct ExplorerBatchRenamePreviewRow:
    sourcePath: String
    currentName: String
    nextName: String
    destinationPath: String
    collision: Bool
    validationError: Any

struct ExplorerBatchRenamePreviewResult:
    rows: [ExplorerBatchRenamePreviewRow]
    validationError: Any

struct SplitEntryName:
    stem: String
    extension: String

const BATCH_RENAME_INDEX_TOKEN_PATTERN: Any = none

const BATCH_RENAME_DATE_TOKEN_PATTERN: Any = none

const BATCH_RENAME_INDEX_TOKEN_PATTERN_GLOBAL: Any = none

const BATCH_RENAME_PARENT_TOKEN_PATTERN: Any = none

fn buildExplorerBatchRenamePreview(entries: [ExplorerFileEntry], recipe: ExplorerBatchRenameRecipe) -> Any:
    let renameTargets: Any = entries.filter(none)
    let validationError: Any = validateBatchRenameRecipe(recipe)
    if (validationError):
        return none
    let previewRows: Any = renameTargets.map(none)
    let nextRows: Any = previewRows.map(none)
    let collisionCounts: Any = ts_Map()
    for row in nextRows:
        collisionCounts.set(row.destinationPath, (((collisionCounts.get(row.destinationPath) or 0)) + 1))
    for row in nextRows:
        row.collision = (ts_Boolean(validationError) or (((collisionCounts.get(row.destinationPath) or 0)) > 1))
    return none

fn validateBatchRenameRecipe(recipe: ExplorerBatchRenameRecipe) -> Any:
    if (((recipe.mode == "regex") and (recipe.findText.trim().length == 0))):
        return "Regex mode requires a pattern."
    if (((recipe.padding < 0) or (!ts_Number.isFinite(recipe.padding)))):
        return "Padding must be a finite, non-negative number."
    if ((!ts_Number.isFinite(recipe.startingNumber))):
        return "Starting number must be finite."
    if ((recipe.mode != "regex")):
        return none

fn applyRenameTransform(stem: String, recipe: ExplorerBatchRenameRecipe) -> Any:
    if ((recipe.findText.trim().length == 0)):
        return stem
    if ((recipe.mode == "regex")):
        let regex: Any = RegExp(recipe.findText, "g")
        return stem.replace(regex, normalizeRegexReplacement(recipe.replaceText))
    return stem.split(recipe.findText).join(recipe.replaceText)

fn applyRenameTokens(value: String, context: Any) -> String:
    return value.replace(BATCH_RENAME_DATE_TOKEN_PATTERN, context.date).replace(BATCH_RENAME_PARENT_TOKEN_PATTERN, context.parent).replace(BATCH_RENAME_INDEX_TOKEN_PATTERN_GLOBAL, context.index)

fn formatLocalDateToken(date: Date) -> String:
    let year: Any = date.getFullYear()
    let month: Any = ts_String((date.getMonth() + 1)).padStart(2, "0")
    let day: Any = ts_String(date.getDate()).padStart(2, "0")
    return year + "-" + month + "-" + day

fn formatSequenceNumber(value: Float, padding: Float) -> String:
    let width: Any = Math.max(1, (Math.trunc(padding) or 1))
    return ts_String(Math.max(0, Math.trunc(value))).padStart(width, "0")

fn normalizeRegexReplacement(value: String) -> String:
    return value.replace(none, "$<$1>")

fn splitEntryName(name: String) -> Any:
    let extensionMatch: Any = name.match_(none)
    let extension: Any = (extensionMatch[1] or "")
    let stem: Any = none
    return none

fn getPathParent(path: String) -> Any:
    let trimmed: Any = path.replace(none, "")
    let parentPath: Any = trimmed.replace(none, "")
    return none

fn getPathLeaf(path: String) -> String:
    let trimmed: Any = path.replace(none, "")
    let match_: Any = trimmed.match_(none)
    return (match_[1] or trimmed)

fn joinPath(parentPath: String, leafName: String) -> Any:
    if ((!parentPath)):
        return leafName
    let separator: Any = none
    return parentPath + separator + leafName

struct ExplorerChecksumResult:
    md5: String
    sha256: String

fn calculateExplorerChecksumsFromBase64(base64: String) -> Any:
    let bytes: Any = base64ToBytes(base64)
    let _: Any = (await ts_Promise.all([digestSha256(bytes), ts_Promise.resolve(digestMd5(bytes))]))
    let sha256: Any = none
    let md5: Any = none
    return none

fn base64ToBytes(base64: String) -> Any:
    if ((atob == "function")):
        let binary: Any = atob(base64)
        let bytes: Any = Uint8Array(binary.length)
        let index: Any = 0
        while ((index < binary.length)):
            ()
            index = (index + 1)
        return bytes
    let binary: Any = globalThis.Buffer.from(base64, "base64")
    if ((!binary)):
        ()
    return Uint8Array(binary)

fn digestSha256(bytes: Uint8Array) -> impl Async_<String>:
    if ((!globalThis.crypto.subtle)):
        ()
    let digest: Any = (await globalThis.crypto.subtle.digest("SHA-256", bytes))
    return bytesToHex(Uint8Array(digest))

fn digestMd5(bytes: Uint8Array) -> String:
    let words: Any = bytesToMd5Words(bytes)
    let a0: Any = 1732584193
    let b0: Any = 4023233417
    let c0: Any = 2562383102
    let d0: Any = 271733878
    let a: Any = a0
    let b: Any = b0
    let c: Any = c0
    let d: Any = d0
    let index: Any = 0
    while ((index < words.length)):
        let aa: Any = a
        let bb: Any = b
        let cc: Any = c
        let dd: Any = d
        a = md5Round(a, b, c, d, (words[(index + 0)] or 0), 7, 3614090360, 0)
        d = md5Round(d, a, b, c, (words[(index + 1)] or 0), 12, 3905402710, 1)
        c = md5Round(c, d, a, b, (words[(index + 2)] or 0), 17, 606105819, 2)
        b = md5Round(b, c, d, a, (words[(index + 3)] or 0), 22, 3250441966, 3)
        a = md5Round(a, b, c, d, (words[(index + 4)] or 0), 7, 4118548399, 4)
        d = md5Round(d, a, b, c, (words[(index + 5)] or 0), 12, 1200080426, 5)
        c = md5Round(c, d, a, b, (words[(index + 6)] or 0), 17, 2821735955, 6)
        b = md5Round(b, c, d, a, (words[(index + 7)] or 0), 22, 4249261313, 7)
        a = md5Round(a, b, c, d, (words[(index + 8)] or 0), 7, 1770035416, 8)
        d = md5Round(d, a, b, c, (words[(index + 9)] or 0), 12, 2336552879, 9)
        c = md5Round(c, d, a, b, (words[(index + 10)] or 0), 17, 4294925233, 10)
        b = md5Round(b, c, d, a, (words[(index + 11)] or 0), 22, 2304563134, 11)
        a = md5Round(a, b, c, d, (words[(index + 12)] or 0), 7, 1804603682, 12)
        d = md5Round(d, a, b, c, (words[(index + 13)] or 0), 12, 4254626195, 13)
        c = md5Round(c, d, a, b, (words[(index + 14)] or 0), 17, 2792965006, 14)
        b = md5Round(b, c, d, a, (words[(index + 15)] or 0), 22, 1236535329, 15)
        a = md5Round(a, b, c, d, (words[(index + 1)] or 0), 5, 4129170786, 16, 1518500249)
