    entry: ExplorerFileEntry
    maxWidth: Float
    maxHeight: Float

fn canRenderExplorerCollectionPreviewOverviewThumbnail(entry: ExplorerFileEntry) -> Any:
    if (entry.is_dir):
        return false
    return canRenderExplorerThumbnail(entry.extension, entry.size, forcedCollectionPreviewThumbnailSettings)

fn readExplorerCollectionPreviewOverviewThumbnail(request: ExplorerCollectionPreviewThumbnailRequest) -> Any:
    if ((!canRenderExplorerCollectionPreviewOverviewThumbnail(request.entry))):
        return none
    let thumbnailEntry: Any = (await resolveCollectionPreviewThumbnailSourceEntry(request.entry))
    if ((!thumbnailEntry)):
        return none
    let modelPreviewFormat: Any = getModelPreviewFormat(request.entry.extension)
    if (modelPreviewFormat):
        return readExplorerModelThumbnail(none)
    return readExplorerThumbnailForEntry(none)

fn resolveCollectionPreviewThumbnailSourceEntry(entry: ExplorerFileEntry) -> Any:
    let archiveLocation: Any = parseExplorerArchiveVirtualPath(entry.path)
    if ((!archiveLocation)):
        return entry
    let cacheKey: Any = [archiveLocation.archivePath, archiveLocation.entryPath, entry.entityId, entry.contentRevision].join("::")
    let cachedMaterialization: Any = collectionPreviewArchiveMaterializationCache.get(cacheKey)
    if (cachedMaterialization):
        let outputPath: Any = (await cachedMaterialization)
        return none
    let pendingMaterialization: Any = materializeExplorerArchiveEntry(none).then(none).catch_(none).finally(none)
    collectionPreviewArchiveMaterializationCache.set(cacheKey, pendingMaterialization)
    let outputPath: Any = (await pendingMaterialization)
    return none

