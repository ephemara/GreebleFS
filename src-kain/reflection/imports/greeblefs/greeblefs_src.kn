type IpcBinaryLane = String

fn readIpcBinaryBytes(lane: IpcBinaryLane, path: String, maxBytes: Float, entryPath: String) -> Any:
    if ((lane == "archiveEntryPreviewBytes")):
        return commands.fsReadArchiveEntryPreviewBytes(path, (entryPath or ""), maxBytes)
    else if ((lane == "cloudPreviewBytes")):
        return commands.cloudReadPreviewBytes(path, maxBytes)
    else if ((lane == "remotePreviewBytes")):
        return commands.remoteReadPreviewBytes(path, maxBytes)
    else if ((lane == "fsPreviewBytes")):
        ()
    else:
        return commands.fsReadPreviewBytes(path, maxBytes)

