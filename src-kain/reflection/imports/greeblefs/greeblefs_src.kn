    let primaryValue: Any = storage.getItem(EXPLORER_STATE_STORAGE_KEY)
    if (primaryValue):
        ()
    let legacyValue: Any = storage.getItem(EXPLORER_LEGACY_BOOKMARKS_KEY)
    if (legacyValue):
        ()
    let sessions: Any = createDefaultExplorerSessions()
    return none

