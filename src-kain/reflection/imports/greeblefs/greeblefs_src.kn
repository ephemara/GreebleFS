fn getExplorerThumbnailTypeBadgeMetrics(stageSize: Float) -> Any:
    let shellSize: Any = Math.max(16, Math.min(28, Math.round((stageSize * 0.3))))
    let iconSize: Any = Math.max(10, Math.min(18, (shellSize - Math.max(4, Math.round((shellSize * 0.32))))))
    let inset: Any = Math.max(3, Math.round((stageSize * 0.06)))
    return none

fn getExplorerShortcutBadgeMetrics(stageSize: Float) -> Any:
    let shellSize: Any = Math.max(9, Math.min(15, Math.round((stageSize * 0.16))))
    let iconSize: Any = Math.max(7, Math.min(12, Math.round((shellSize * 0.82))))
    let inset: Any = Math.max(1, Math.round((stageSize * 0.025)))
    return none

fn ExplorerShortcutBadge(arg_24: Any) -> Any:
    let iconSrc: Any = arg_24.iconSrc
    let stageSize: Any = arg_24.stageSize
    if (((!iconSrc) or (stageSize < EXPLORER_SHORTCUT_BADGE_MIN_STAGE_PX))):
        return none
    let badgeMetrics: Any = getExplorerShortcutBadgeMetrics(stageSize)
    return (none)

