fn scheduleExplorerPdfPreviewDocumentClose(sessionId: String, delayMs: Any) -> Any:
    let delayMs: Any = delayMs
    if ((!sessionId.trim())):
        return none
    cancelPendingExplorerPdfPreviewDocumentClose(sessionId)
    let timeoutId: Any = window.setTimeout(none, delayMs)
    pendingExplorerPdfSessionCloseTimeouts.set(sessionId, timeoutId)

fn cancelPendingExplorerPdfPreviewDocumentClose(sessionId: String) -> Any:
    let pendingTimeoutId: Any = pendingExplorerPdfSessionCloseTimeouts.get(sessionId)
    if ((pendingTimeoutId == none)):
        return none
    window.clearTimeout(pendingTimeoutId)
    pendingExplorerPdfSessionCloseTimeouts.delete_(sessionId)

