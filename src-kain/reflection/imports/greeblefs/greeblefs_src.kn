const TRACE_ID: Any = createTelemetryId()

const MAX_METADATA_VALUE_LENGTH: Any = 240

const MAX_PENDING_RECORDS: Any = 250

const FRONTEND_BATCH_COMMAND: Any = "telemetry_record_frontend_batch"

const SOURCE_TRACE_STACK_LINE_LIMIT: Any = 6

const pendingRecords: Any = []

const flushTimer: Any = none

const browserObserversInstalled: Any = false

fn getPerformanceNow() -> Any:
    return none

fn getRecordedAt() -> Float:
    return Date.now()

fn telemetryEnabled() -> Bool:
    let system: Any = useSettingsStore.getState().settings.system
    return (system.developerTelemetryEnabled or system.consumerDiagnosticsEnabled)

fn sourceTraceEnabled() -> Bool:
    let system: Any = useSettingsStore.getState().settings.system
    let sourceTraceAllowed: Any = (ts_Boolean(import_meta.env.DEV) or system.developerMode)
    return (sourceTraceAllowed and system.sourceTraceModeEnabled)

fn includePayloadMetadata() -> Bool:
    return ((useSettingsStore.getState().settings.system.developerTelemetryPayloadMode == "metadata+small-payloads"))

fn createTelemetryId() -> Any:
    if (((crypto != "undefined") and (crypto.randomUUID == "function"))):
        return crypto.randomUUID()
    return "telemetry-" + Math.random().toString(36).slice(2) + "-" + Date.now()

fn summarizeMetadataValue(value: TelemetryMetadataValue) -> Any:
    if ((value == none)):
        return "null"
    if ((value == "string")):
        return none
    return ts_String(value)

fn normalizeMetadata(metadata: TelemetryMetadata) -> Any:
    let metadata: Any = metadata
    return ts_Object.fromEntries(ts_Object.entries(metadata).filter(none).map(none))

fn normalizeError(error: Any) -> Any:
    if ((!error)):
        return none
    if (ts_instanceof_operator(error, Error)):
        return none
    return none

fn collectSourceTraceMetadata() -> Any:
    if ((!sourceTraceEnabled())):
        return none
    let rawStack: Any = Error().stack
    if ((!rawStack)):
        return none
    let stackLines: Any = rawStack.split(none).map(none).filter(none).filter(none).slice(0, SOURCE_TRACE_STACK_LINE_LIMIT)
    if ((stackLines.length == 0)):
        return none
    return none

fn queueRecord(record: FrontendTelemetryRecord) -> Any:
    if ((!telemetryEnabled())):
        return none
    pendingRecords.push(record)
    if ((pendingRecords.length > MAX_PENDING_RECORDS)):
        flushTelemetryQueue()
        return none
    if ((flushTimer != none)):
        return none
    flushTimer = setTimeout(none, 120)

fn flushTelemetryQueue() -> Any:
    if ((pendingRecords.length == 0)):
        return none
    let records: Any = pendingRecords
    pendingRecords = []

fn installFrontendTelemetryObservers() -> Any:
    if ((browserObserversInstalled or (window == "undefined"))):
        return none
    browserObserversInstalled = true
    window.addEventListener("error", none)
    window.addEventListener("unhandledrejection", none)

fn startTelemetrySpan(input: Any) -> FrontendTelemetrySpan:
    let span: Option<Any> = none
    recordFrontendTelemetry(none)
    return span

fn finishTelemetrySpan(span: FrontendTelemetrySpan, input: Any) -> ():
    let endedAt: Any = getPerformanceNow()
    recordFrontendTelemetry(none)

fn recordFrontendTelemetry(input: Any) -> Any:
    if ((!telemetryEnabled())):
        return none
    let metadata: Any = normalizeMetadata(none)
    let shouldDropPayload: Any = ((!includePayloadMetadata()) and ts_Object.keys(metadata).some(none))
    let normalizedMetadata: Any = none
    queueRecord(none)

fn summarizeTelemetryValue(value: Any, label: String) -> Any:
    if ((value == none)):
        return none
    if ((((value == "string") or (value == "number")) or (value == "boolean"))):
        return value
    if (ts_Array.isArray(value)):
        return label + "[" + value.length + "]"
    if (ts_instanceof_operator(value, ArrayBuffer)):
        return label + "<array-buffer:" + value.byteLength + ">"
    if (ArrayBuffer.isView(value)):
        return label + "<typed-array:" + value.byteLength + ">"
    if ((value == "object")):
        return label + "{" + ts_Object.keys(value).slice(0, 4).join(",") + "}"
    return ts_String(value)

