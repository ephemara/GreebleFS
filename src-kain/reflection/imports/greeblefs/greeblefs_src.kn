fn resolveConditionalBlurFilter(args: Any) -> Any:
    if (((!args.enabled) or (args.blurPx <= 0))):
        return "none"
    let saturateBoost: Any = (args.saturateBoost or 0.35)
    let blurRatio: Any = Math.min(Math.max((args.blurPx / 18), 0), 1)
    return "blur(" + args.blurPx + "px) saturate(" + ((1.05 + (blurRatio * saturateBoost))).toFixed(2) + ")"

