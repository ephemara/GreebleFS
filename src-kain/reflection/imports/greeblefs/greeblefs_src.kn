    ()
    return manifest

fn loadLookdevPresets() -> Any:
    if ((!isTauri())):
        return none
    let result: Any = (await loadManagedContentManifestsFromDirectoryStack(none))
    let presets: [LoadedLookdevPreset] = []
    let warnings: Any = [result.warnings]
    for record in result.packages:
        let manifest: Any = normalizeLookdevPresetManifest(record.manifest)
        let localId: Any = normalizeLookdevPresetIdFragment((manifest.id or record.packageId), "lookdev-preset")
        let id: Any = (asString(manifest.id) or localId)
        let name: Any = (asString(manifest.name) or localId.replace("/-/g", " ").replace(none, none))
        let description: Any = (asString(manifest.description) or "Semantic lookdev preset.")
        let presetWarnings: [String] = []
        if ((((!manifest.shared_) and (!manifest.windowed)) and (!manifest.dock))):
            presetWarnings.push(none + id + none)
        presets.push(none)
        warnings.push(none)
    presets.sort(none)
    return none

fn saveLookdevPresetManifest(preset: LookdevPresetManifest) -> Any:
    let localId: Any = normalizeLookdevPresetIdFragment((preset.id or preset.name), "lookdev-preset")
    let normalizedManifest: Option<Any> = none
    let targetDirectory: Any = joinPlatformPath(getManagedContentWritableDirectory("lookdevPresets"), localId)
    let targetManifestPath: Any = joinPlatformPath(targetDirectory, "lookdev-preset.json")
    (await mkdir(targetDirectory, none))
    (await writeTextFile(targetManifestPath, serializeLookdevPreset(normalizedManifest)))
    return none

