fn createSettingsContextMenuPreviewEntry(path: String, options: Any) -> Any:
    let normalizedPath: Any = path.trim()
    let segments: Any = normalizedPath.split(none).filter(ts_Boolean)
    let name: Any = ((options.name or segments[(segments.length - 1)]) or normalizedPath)
    let isDirectory: Any = (options.isDirectory or false)
    let extension: Any = none
    return none

fn buildSettingsContextMenuPreviewInvocation(contextKind: ExplorerMenuContextKind) -> Any:
    let currentLocation: Any = "/workspace/greeblefs-demo"
    let fileEntry: Any = createSettingsContextMenuPreviewEntry("/workspace/greeblefs-demo/notes/alpha.txt")
    let secondFileEntry: Any = createSettingsContextMenuPreviewEntry("/workspace/greeblefs-demo/notes/beta.ts")
    let previewEntry: Any = createSettingsContextMenuPreviewEntry("/workspace/greeblefs-demo/renders/preview.png")
    let baseInvocation: Option<Any> = none
    if ((contextKind == "background")):
        return baseInvocation
    else if ((contextKind == "multi-select")):
        return none
    else if ((contextKind == "search-result")):
        return none
    else if ((contextKind == "preview-pane")):
        return none
    else if ((contextKind == "entry")):
        ()
    else:
        return none

fn resolveContextMenuCommandSourceLabel(command: ExplorerCommandDefinition) -> Any:
    if ((command.source == "action")):
        return none + command.packName
    if ((command.source == "plugin")):
        return none + command.pluginName
    if ((command.source == "preview")):
        return "Preview Lane"
    return "Built-In"

fn getContextMenuPreviewPathKey(path: [String]) -> Any:
    return none

fn resolveContextMenuPreviewPanels(rootNodes: [ExplorerRuntimeMenuNode], openSubmenuPath: [String]) -> Any:
    let panels: [[ExplorerRuntimeMenuNode]] = [rootNodes]
    let resolvedPath: [String] = []
    let currentNodes: Any = rootNodes
    for submenuId in openSubmenuPath:
        let submenuNode: Any = currentNodes.find(none)
        if ((!submenuNode)):
            break
        panels.push(submenuNode.children)
        resolvedPath.push(submenuId)
        currentNodes = submenuNode.children
    return none

fn ExplorerContextMenuPreviewPanels(arg_1: Any) -> Any:
    let nodes: Any = arg_1.nodes
    let density: Any = arg_1.density
    let showDescriptions: Any = arg_1.showDescriptions
    let selectedNodeId: Any = arg_1.selectedNodeId
    let onSelectNode: Any = arg_1.onSelectNode
    let _: Any = useState([])
    let openSubmenuPath: Any = none
    let setOpenSubmenuPath: Any = none
    let panelState: Any = useMemo(none, [nodes, openSubmenuPath])
    useEffect(none, [nodes])
    if ((nodes.length == 0)):
        return (none)
    let panelWidth: Any = none
    return (none)

fn getThemePreviewBackground(theme: OverlayThemeDefinition, previewUrl: String) -> Any:
    if (previewUrl):
        return ["linear-gradient(180deg, rgba(5,10,18,0.1) 0%, rgba(5,10,18,0.72) 100%)", none + previewUrl + none].join(", ")
    return ["radial-gradient(circle at 18% 20%, " + (theme.palette.accentSoft or theme.palette.accent + "33") + ", transparent 28%)", "linear-gradient(135deg, " + theme.palette.appBackgroundAlt + " 0%, " + theme.palette.appBackground + " 52%, " + theme.palette.panelBackground + " 100%)"].join(", ")

fn clampThemeDescription(text: Any) -> Any:
    let trimmed: Any = text.trim()
    if ((!trimmed)):
        return none
    return none

fn getThemePackageSourceBadgeLabel(sourceKind: Any) -> String:
    if ((sourceKind == "plugin-package")):
        return "Plugin Package"
    else if ((sourceKind == "vscode-theme-directory")):
        return "VS Code Folder"
    else if ((sourceKind == "vscode-theme-vsix")):
        return "VS Code VSIX"
    else:
        return "Theme Folder"

fn getIconThemePackageSourceBadgeLabel(sourceKind: Any) -> String:
    if ((sourceKind == "built-in")):
        return "Built-In"
    else if ((sourceKind == "vscode-icon-theme-directory")):
        return "VS Code Folder"
    else if ((sourceKind == "vscode-icon-theme-vsix")):
        return "VS Code VSIX"
    else:
        return "Pack"

type ThemeCatalogSectionId = String

fn resolveThemeCatalogSectionId(theme: OverlayThemeDefinition, packageInfo: Any) -> Any:
    if ((theme.source == "built-in")):
        return "built-in"
    if (packageInfo.catalog.isOfficialPilot):
        return "official-pilot"
    return "legacy-archive"

fn getThemeCatalogBadgeLabel(sectionId: ThemeCatalogSectionId, packageInfo: Any) -> Any:
    if ((sectionId == "built-in")):
        return "Built-In"
    return (packageInfo.catalog.badgeLabel or "Package")

fn getThemeCatalogSectionTitle(sectionId: ThemeCatalogSectionId) -> String:
    if ((sectionId == "official-pilot")):
        return "Official Pilot Suite"
    else if ((sectionId == "built-in")):
        return "Built-In Baselines"
    else if ((sectionId == "legacy-archive")):
        return "Legacy / Lab Archive"

fn getThemeCatalogSectionSubtitle(sectionId: ThemeCatalogSectionId) -> String:
    if ((sectionId == "official-pilot")):
        return "The current pilot set. These are the front-of-house themes that should feel full-screen, readable, and intentional."
    else if ((sectionId == "built-in")):
        return "Bundled baseline themes stay visible and supported as stable defaults for the app and dock."
    else if ((sectionId == "legacy-archive")):
        return "Older experiments, transitional shells, and archive material remain selectable without reading like the primary product."

fn getThemeCatalogEntrySortRank(packageInfo: Any) -> Float:
    return (packageInfo.catalog.sortRank or 0)

fn getThemeCatalogCardOpacity(sectionId: ThemeCatalogSectionId) -> Any:
    if ((sectionId == "legacy-archive")):
        return 0.82
    if ((sectionId == "built-in")):
        return 0.96
    return 1

component ThemeCatalogCard(themeOption: Any, packageInfo: Any, active: Any, sectionId: Any, onSelect: Any, motionBinding: Any) with Reactive:
    state description: Any = clampThemeDescription((packageInfo.description or themeOption.description))
    state previewBackground: Any = getThemePreviewBackground(themeOption, packageInfo.previewUrl)
    state compiledEngineManifest: Any = packageInfo.compiledEngineManifest
    state defaultLayoutPrimitive: Any = compiledEngineManifest.defaultLayoutPrimitive
    state defaultNavigationPattern: Any = compiledEngineManifest.defaultNavigationPattern
    state defaultAnimationProfile: Any = compiledEngineManifest.defaultAnimationProfile
    state defaultIconPack: Any = compiledEngineManifest.defaultIconPack
    state defaultRenderStyle: Any = compiledEngineManifest.defaultRenderStyle
    state workbenchPreset: Any = themeOption.workbench.preset
    state explorerPreset: Any = themeOption.explorer.preset
    state dockPreset: Any = ((themeOption.dock.workbench.preset or themeOption.dock.explorer.preset) or none)
    state capabilityLabels: Any = [none, none, none, none, none, none, none, none, none, none].filter(none).slice(0, 10)
    render <div />

fn ThemeCatalogSection(arg_2: Any) -> Any:
    let sectionId: Any = arg_2.sectionId
    let themes: Any = arg_2.themes
    let activeThemeId: Any = arg_2.activeThemeId
    let onSelect: Any = arg_2.onSelect
    let themePackageLookup: Any = arg_2.themePackageLookup
    let createThemeCardMotion: Any = arg_2.createThemeCardMotion
    if ((themes.length == 0)):
        return none
    let isOfficialSuite: Any = (sectionId == "official-pilot")
    let sectionStyle: Any = none
    let sortedThemes: Any = [themes].sort(none)
    return (none)

fn getThemeCatalogEntryKey(theme: OverlayThemeDefinition, packageInfo: Any, index: Float) -> String:
    let sourceKind: Any = ((packageInfo.sourceKind or theme.source) or "built-in")
    let sourceLabel: Any = ((packageInfo.sourceLabel or packageInfo.directoryPath) or "catalog")
    return theme.id + ":" + sourceKind + ":" + sourceLabel + ":" + index

component ThemeCatalogGrid(themes: Any, activeThemeId: Any, onSelect: Any, themePackageLookup: Any, createThemeCardMotion: Any) with Reactive:
    fn catalogSections() -> Any:
        let groupedThemes: Option<Any> = none
        let iter_3: Any = themes
        let index_4: Any = 0
        while ((index_4 < iter_3.length)):
            let themeOption: Any = iter_3[index_4]
            let packageInfo: Any = themePackageLookup.get(themeOption.id)
            let sectionId: Any = resolveThemeCatalogSectionId(themeOption, packageInfo)
            groupedThemes[sectionId].push(themeOption)
            index_4 = (index_4 + 1)
        return (["official-pilot", "built-in", "legacy-archive"]).map(none)

    render <div className="space-y-4">{none}</div>

fn summarizeTopBarControls(topBar: LoadedOverlayTopBarDefinition) -> String:
    let prioritizedControls: Any = [topBar.navigationShortcuts, topBar.leadingControls, topBar.trailingControls]
    let labels: Any = ts_Array.from(ts_Set(prioritizedControls.map(none)))
    return labels.slice(0, 4).join(none)

component TopBarCatalogCard(topBar: Any, active: Any, border: Any, accent: Any, text: Any, muted: Any, onClick: Any) with Reactive:
    state controlSummary: Any = summarizeTopBarControls(topBar)
    render <button type="button" onClick={onClick} className="w-full rounded border p-3 text-left transition-colors" style={none}><div className="flex flex-wrap items-start justify-between gap-3"><div><div className="text-[11px] font-semibold">{topBar.name}</div><div className="mt-1 text-[11px] leading-4 opacity-55">{topBar.description}</div></div>{none}</div><div className="mt-3 flex flex-wrap items-center gap-1.5"><ThemeBadge label={getTopBarSourceLabel(topBar.source)} active={active} /><ThemeBadge label={getTopBarStyleLabel(topBar.topBarStyle)} active={active} /><ThemeBadge label={getTopBarNavigationModeLabel(topBar.navigationMode)} active={active} />{none}</div>{none}</button>

type ThemeBundleCatalogSourceKind = String

struct ThemeBundleCatalogEntry:
    pack: TPack
    sourceKind: ThemeBundleCatalogSourceKind
    sourceLabel: String
    sourceThemeId: Any

struct ThemeBundleCatalogCardOption:
    id: String
    name: String
    description: Any
    badges: [String]
    summary: Any
    sourceKind: ThemeBundleCatalogSourceKind
    sourceLabel: String
    tags: [String]
    warnings: [String]

fn buildThemeBundleCatalogEntries(standalonePacks: Any, themePackages: Any, selectLocalPacks: Any) -> [ThemeBundleCatalogEntry<TPack>]:
    let entryMap: Any = ts_Map()
    for pack in standalonePacks:
        entryMap.set(pack.id, none)
    for themePackage in themePackages:
        for pack in selectLocalPacks(themePackage):
            entryMap.set(pack.id, none)
    return [entryMap.values()].sort(none)

fn findThemeBundleCatalogPack(packs: Any, requestedId: Any) -> Any:
    let trimmedId: Any = requestedId.trim()
    if ((!trimmedId)):
        return none
    return ((packs.find(none) or none))

fn findThemeBundleCatalogEntry(entries: Any, requestedId: Any) -> Any:
    let trimmedId: Any = requestedId.trim()
    if ((!trimmedId)):
        return none
    return ((entries.find(none) or none))

fn findEmbeddedThemeBundleManifestPack(packs: Any, requestedId: Any) -> Any:
    let trimmedId: Any = requestedId.trim()
    if ((!trimmedId)):
        return none
    return (packs.find(none) or none)

fn resolveThemeBundlePackSelectionLabel(args: Any) -> Any:
    let trimmedId: Any = args.requestedId.trim()
    if ((!trimmedId)):
        return (args.emptyLabel or "None")
    let localMatch: Any = findThemeBundleCatalogPack((args.activeThemeLocalPacks or []), trimmedId)
    if (localMatch):
        return localMatch.name
    let catalogMatch: Any = findThemeBundleCatalogEntry(args.entries, trimmedId)
    if (catalogMatch):
        return catalogMatch.pack.name
    let embeddedMatch: Any = findEmbeddedThemeBundleManifestPack(args.embeddedPacks, trimmedId)
    if (embeddedMatch.name.trim()):
        return embeddedMatch.name.trim()
    return trimmedId

fn getThemeBundleCatalogSourceBadgeLabel(sourceKind: ThemeBundleCatalogSourceKind, sourceLabel: String) -> Any:
    return none

component ThemeBundlePackCatalogCard(option: Any, active: Any, border: Any, accent: Any, text: Any, muted: Any, onClick: Any) with Reactive:
    render <button type="button" onClick={onClick} className="w-full rounded border p-3 text-left transition-colors" style={none}><div className="flex flex-wrap items-start justify-between gap-3"><div><div className="text-[11px] font-semibold">{option.name}</div>{none}</div>{none}</div><div className="mt-3 flex flex-wrap items-center gap-1.5"><ThemeBadge label={getThemeBundleCatalogSourceBadgeLabel(option.sourceKind, option.sourceLabel)} active={active} />{none}{none}{none}</div>{none}</button>

fn countThemeBundleCatalogEntriesBySource(entries: Any) -> Any:
    return entries.reduce(none, none)

fn hasThemeBundlePackSelection(args: Any) -> Any:
    let trimmedId: Any = args.requestedId.trim()
    if ((!trimmedId)):
        return true
    return ts_Boolean(((findThemeBundleCatalogPack((args.activeThemeLocalPacks or []), trimmedId) or findThemeBundleCatalogEntry(args.entries, trimmedId)) or findEmbeddedThemeBundleManifestPack(args.embeddedPacks, trimmedId)))

