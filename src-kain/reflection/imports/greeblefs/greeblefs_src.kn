fn parseNativeSearchStreamMessages(packet: NativeByteStreamPacket, decoder: TextDecoder, bufferedText: String, onMessage: Any) -> String:
    let nextText: Any = (bufferedText + decoder.decode(packet.bytes, none))
    let lines: Any = nextText.split(none)
    let trailingText: Any = (lines.pop() or "")
    for line_ in lines:
        let trimmed: Any = line_.trim()
        if ((trimmed.length == 0)):
            continue
        onMessage(JSON.parse(trimmed))
    return trailingText

