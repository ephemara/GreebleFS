fn isSpreadsheetTabularTextExtension(extension: String) -> Bool:
    return SPREADSHEET_TABULAR_TEXT_EXTENSION_SET.has(normalizeSpreadsheetExtension(extension))

fn getSpreadsheetFileKind(extension: String) -> Any:
    let normalizedExtension: Any = normalizeSpreadsheetExtension(extension)
    if (isSpreadsheetWorkbookExtension(normalizedExtension)):
        return "workbook"
    if (isSpreadsheetTabularTextExtension(normalizedExtension)):
        return "tabular"
    return none

fn getSpreadsheetExportBookType(extension: String) -> Any:
    return (SPREADSHEET_EXPORT_BOOK_TYPE_BY_EXTENSION[normalizeSpreadsheetExtension(extension)] or none)

fn getSpreadsheetTabularDelimiter(extension: String) -> Any:
    return ((SPREADSHEET_TABULAR_DELIMITER_BY_EXTENSION[normalizeSpreadsheetExtension(extension)] or none))

fn normalizeSpreadsheetExtension(extension: String) -> String:
    return extension.trim().replace(none, "").toLowerCase()

