fn subscribeIpcStream(handle: ManagedIpcStreamHandle, listener: Any, options: SubscribeIpcStreamOptions) -> Any:
    let options: Any = options
    let deliveredSequences: Any = ts_Set()
    let deliverOnce: Any = none
    let unsubscribePromise: Any = subscribeTransportStreamPackets(handle, deliverOnce, none)
    let stopStreamListener: Any = bindDeferredUnlisten(unsubscribePromise)
    (await unsubscribePromise)
    return none

