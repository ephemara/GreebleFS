type IpcRegisterArtifactPathRequest = Any

const commands: Any = none

const unwrapTauriResult: Any = none

const ipcArtifactUrlCache: Any = ts_Map()

const FRONTEND_IPC_ARTIFACT_ROOT: Any = "ipc-artifacts/frontend"

type ManagedIpcArtifactDescriptor = IpcArtifactDescriptor

type ManagedIpcArtifactRef = IpcArtifactRef

type ManagedIpcArtifactRetention = IpcArtifactRetention

struct StageIpcArtifactBytesRequest:
    kind: String
    bytes: Uint8Array
    mediaType: Any
    retention: Any
    identityKey: Any
    contentRevision: Any
    deleteOnRelease: Any
    relativePath: Any
    suggestedFileName: Any

fn toIpcArtifactRef(descriptor: ManagedIpcArtifactDescriptor) -> Any:
    return none

fn resolveIpcArtifactUrl(descriptor: ManagedIpcArtifactDescriptor) -> Any:
    let cachedUrl: Any = ipcArtifactUrlCache.get(descriptor.id)
    if (cachedUrl):
        return cachedUrl
    let resolvedUrl: Any = resourceUrl(descriptor.resourceRid)
    ipcArtifactUrlCache.set(descriptor.id, resolvedUrl)
    return resolvedUrl

fn stageIpcArtifactBytes(request: StageIpcArtifactBytesRequest) -> impl Async_<ManagedIpcArtifactDescriptor>:
    let retention: Any = (request.retention or "ephemeral")
    let deleteOnRelease: Any = (request.deleteOnRelease or (retention == "ephemeral"))
    let relativePath: Any = (normalizeRelativeArtifactPath(request.relativePath) or buildDefaultFrontendArtifactRelativePath(request.kind, request.suggestedFileName, (request.mediaType or none)))
    let parentDirectory: Any = none
    if (parentDirectory):
        (await mkdir(parentDirectory, none))
    (await writeFile(relativePath, request.bytes, none))
    let absolutePath: Any = (await join(normalizeDirectoryPath((await appLocalDataDir())), relativePath))
    return unwrapTauriResult((await commands.ipcRegisterArtifactPath(none)))

fn releaseIpcArtifact(artifact: Any) -> impl Async_<()>:
    let id: Any = none
    ipcArtifactUrlCache.delete_(id)
    unwrapTauriResult((await commands.ipcReleaseArtifact(id)))

fn buildDefaultFrontendArtifactRelativePath(kind: String, suggestedFileName: Any, mediaType: Any) -> String:
    let artifactId: Any = createFrontendArtifactId()
    let safeKind: Any = sanitizeArtifactSegment((kind or "artifact"))
    let fileName: Any = sanitizeArtifactFileName((suggestedFileName or safeKind + "-" + artifactId + resolveFileExtension(mediaType)))
    return FRONTEND_IPC_ARTIFACT_ROOT + "/" + safeKind + "/" + fileName

fn createFrontendArtifactId() -> Any:
    if (((globalThis.crypto != "undefined") and (globalThis.crypto.randomUUID == "function"))):
        return globalThis.crypto.randomUUID()
    return Date.now() + "-" + Math.random().toString(16).slice(2)

fn sanitizeArtifactSegment(value: String) -> String:
    let sanitized: Any = value.trim().toLowerCase().replace("/[^a-z0-9._-]+/g", "-").replace("/-{2,}/g", "-").replace("/^-+|-+$/g", "")
    return (sanitized or "artifact")

fn sanitizeArtifactFileName(value: String) -> Any:
    let trimmed: Any = value.trim()
    if ((!trimmed)):
        return "artifact.bin"
    let sanitized: Any = trimmed.replace(none, "/").split("/").filter(ts_Boolean).pop().replace("/[^a-zA-Z0-9._-]+/g", "-").replace("/-{2,}/g", "-").replace("/^-+|-+$/g", "")
    return (sanitized or "artifact.bin")

fn normalizeRelativeArtifactPath(value: Any) -> Any:
    let trimmed: Any = value.trim()
    if ((!trimmed)):
        return none
    let normalized: Any = trimmed.replace(none, "/").replace(none, "")
    return (normalized or none)

fn normalizeDirectoryPath(value: String) -> String:
    return value.replace(none, "")

fn resolveFileExtension(mediaType: Any) -> String:
    if ((mediaType.toLowerCase() == "image/png")):
        return ".png"
    else if ((mediaType.toLowerCase() == "image/jpeg")):
        return ".jpg"
    else if ((mediaType.toLowerCase() == "image/webp")):
        return ".webp"
    else if ((mediaType.toLowerCase() == "image/gif")):
        return ".gif"
    else if ((mediaType.toLowerCase() == "image/svg+xml")):
        return ".svg"
    else if ((mediaType.toLowerCase() == "application/json")):
        return ".json"
    else if ((mediaType.toLowerCase() == "text/plain")):
        return ".txt"
    else:
        return ".bin"

