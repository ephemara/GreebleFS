fn convertEditableGridCellToRawContent(cell: EditableGridCell) -> Any:
    if ((cell.kind == GridCellKind.Text)):
        return parseSpreadsheetInput(cell.data)
    else if ((cell.kind == GridCellKind.Number)):
        return none
    else if ((cell.kind == GridCellKind.Boolean)):
        return none
    else if ((cell.kind == GridCellKind.Markdown)):
        ()
    else if ((cell.kind == GridCellKind.Uri)):
        return cell.data
    else if ((cell.kind == GridCellKind.Image)):
        return (cell.data[0] or none)
    else if ((cell.kind == GridCellKind.Custom)):
        return cell.copyData
    else:
        return none

