fn findNodeByLabel(nodes: [ExplorerRuntimeMenuNode], label: String) -> Any:
    for node in nodes:
        if ((node.label == label)):
            return node
        if ((node.kind == "submenu")):
            let child: Any = findNodeByLabel(node.children, label)
            if (child):
                return child
    return none

