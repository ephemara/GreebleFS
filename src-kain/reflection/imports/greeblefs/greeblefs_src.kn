struct ExplorerModelThumbnailRequest:
    entry: Any
    maxWidth: Float
    maxHeight: Float

type ExplorerModelThumbnailSourceEntry = Any

const pendingModelThumbnailRenders: Any = ts_Map()

fn readExplorerModelThumbnail(request: ExplorerModelThumbnailRequest) -> Any:
    let format: Any = getModelPreviewFormat(request.entry.extension)
    if ((!format)):
        ()
    let cacheKey: Any = buildExplorerModelThumbnailCacheKey(request.entry, format, request.maxWidth, request.maxHeight)
    let cachedThumbnail: Any = readCachedExplorerPreview(cacheKey)
    if (cachedThumbnail):
        return cachedThumbnail
    let pendingThumbnail: Any = pendingModelThumbnailRenders.get(cacheKey)
    if (pendingThumbnail):
        return pendingThumbnail
    let nextThumbnail: Any = renderModelThumbnailDataUrl(none).then(none).finally(none)
    pendingModelThumbnailRenders.set(cacheKey, nextThumbnail)
    return nextThumbnail

fn buildExplorerModelThumbnailCacheKey(entry: ExplorerModelThumbnailSourceEntry, format: ModelPreviewFormat, maxWidth: Float, maxHeight: Float) -> String:
    let normalizedWidth: Any = Math.max(1, Math.floor(maxWidth))
    let normalizedHeight: Any = Math.max(1, Math.floor(maxHeight))
    return ["model-thumbnail", format, entry.entityId, entry.contentRevision, normalizedWidth, normalizedHeight].join("::")

const THREE: Any = none

const MODEL_THUMBNAIL_RENDER_CONFIG: Any = none

type ModelPreviewFormat = Any

const loadModelPreviewObject: Any = none

const applyModelPreviewFallbackMaterials: Any = none

