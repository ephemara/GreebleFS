const defaultExplorerWorkspaceLayoutMode: ExplorerWorkspaceLayoutMode = "single"

const defaultExplorerWorkspaceAxisRatio: Any = 0.5

const EXPLORER_WORKSPACE_AXIS_RATIO_BOUNDS: Any = none

fn cloneExplorerWorkspaceLayoutDefinition(layout: ExplorerWorkspaceLayoutDefinition) -> Any:
    return none

