            let item_2: Any = iter_3[index_4]
            let from: Any = item_2.from
            let to: Any = item_2.to
            let newStart: Any = mapping.slice(index).map(from, (-1))
            let newEnd: Any = mapping.slice(index).map(to)
            let oldStart: Any = mapping.invert().map(newStart, (-1))
            let oldEnd: Any = mapping.invert().map(newEnd)
