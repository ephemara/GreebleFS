fn resolvePreferredAnimationId(args: Any) -> Any:
    let available: Any = ts_Set(ts_Array.from(args.availableAnimationIds))
    let fallbackId: Any = (args.fallbackAnimationId or animationSystemConfig.defaultOpenAnimationId)
    let preferredIds: Any = [args.userOverrideId, args.themeDefaultAnimationId, fallbackId]
    for candidate in preferredIds:
        if ((((candidate == "string") and candidate.trim()) and available.has(candidate))):
            return candidate
    return none

