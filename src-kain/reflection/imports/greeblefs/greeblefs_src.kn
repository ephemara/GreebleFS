    else if ((format == "obj")):
        return loadObjPreviewObject(sourcePath)
    else if ((format == "fbx")):
        return loadFbxPreviewObject(sourcePath)
    else if ((format == "stl")):
        return loadStlPreviewObject(sourcePath)
    else:
        ()

fn loadGlbPreviewObject(sourcePath: String) -> impl Async_<THREE_Object3D>:
    let loader: Any = createGltfLoader()
    let bytes: Any = (await readModelPreviewBytes(sourcePath, MODEL_PREVIEW_SOURCE_CONFIG.maxRootSourceBytes))
    let asset: Any = (await parseGltfAsync(loader, toArrayBuffer(bytes)))
    return (asset.scene or asset.scenes[0])

fn loadGltfPreviewObject(sourcePath: String) -> impl Async_<THREE_Object3D>:
    let loader: Any = createGltfLoader()
    let sourceBytes: Any = (await readModelPreviewBytes(sourcePath, MODEL_PREVIEW_SOURCE_CONFIG.maxRootSourceBytes))
    let preparedContent: Any = (await inlineGltfExternalResources(decodePreviewText(sourceBytes), sourcePath))

fn loadObjPreviewObject(sourcePath: String) -> impl Async_<THREE_Object3D>:
    let loader: Any = OBJLoader()
