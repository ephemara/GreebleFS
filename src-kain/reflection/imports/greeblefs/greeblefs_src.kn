fn buildExplorerRuntimeMenu(options: BuildExplorerRuntimeMenuOptions) -> Any:
    let pluginCommands: Any = normalizePluginContextMenuContributions(options.pluginContextMenuItems)
    let actionCommands: Any = normalizeExplorerActionContributions(options.actions)
    let menuPack: Any = resolveActiveMenuPack(options.menuPacks, options.activeMenuPackId)
    let targetEntries: Any = getActionEntries(options.invocation)
    let primaryEntry: Any = getPrimaryActionEntry(options.invocation, options.environment, targetEntries)
    let dynamicCommands: Any = createDynamicAudioCommands(options.invocation, options.environment)
    let previewCommands: Any = createPreviewContextMenuCommands(options.invocation, options.previewContextMenuRegistration)
    let commandRegistry: [ExplorerCommandDefinition] = [BUILT_IN_EXPLORER_CONTEXT_MENU_ITEMS, dynamicCommands, previewCommands, actionCommands, pluginCommands]
    let layout: Any = getLayoutForContext(menuPack, options.layoutOverridesByContext, options.invocation.kind)
    let handledCommandIds: Any = ts_Set()
    let layoutNodes: Any = buildNodesForLayout(layout, commandRegistry, options.invocation, targetEntries, primaryEntry, options.environment, none, 0, handledCommandIds)
    let previewInjectedNodes: Any = injectFallbackPreviewNodes(layoutNodes, layout, commandRegistry, options.invocation, targetEntries, primaryEntry, options.environment, handledCommandIds)
    let nodes: Any = injectFallbackActionNodes(previewInjectedNodes, layout, commandRegistry, options.invocation, targetEntries, primaryEntry, options.environment, handledCommandIds)
    let finalizedNodes: Any = none
    return none

fn resolveMenuInvocationInputModality(event: Any) -> Any:
    if ((!event)):
        return "mouse"
    if ((event.pointerType == "touch")):
        return "touch"
    if ((event.pointerType == "pen")):
        return "pen"
    return "mouse"

type ExplorerPickerEntry = Any

type ExplorerPickerRequest = Any

