fn inferFontFormat(filePath: String) -> Any:
    let extension: Any = getBaseName(filePath).split(".").pop().toLowerCase()
    if ((extension == "woff2")):
        return "woff2"
    else if ((extension == "woff")):
        return "woff"
    else if ((extension == "otf")):
        return "opentype"
    else if ((extension == "ttf")):
        ()
    else:
        return "truetype"

