fn buildConstellationGraph(input: ConstellationGraphBuildInput) -> Any:
    let nodeMetadata: Any = buildNodeMetadata(input.entries, input, Date.now())
    let comparedNodeMetadata: Any = selectComparedConstellationNodeMetadata(nodeMetadata)
    let edges: [ConstellationGraphEdge] = []
    let leftIndex: Any = 0
    while ((leftIndex < comparedNodeMetadata.length)):
        let left: Any = comparedNodeMetadata[leftIndex]
        if ((!left)):
            continue
        let rightIndex: Any = (leftIndex + 1)
        while ((rightIndex < comparedNodeMetadata.length)):
            let right: Any = comparedNodeMetadata[rightIndex]
            if ((!right)):
                continue
            let edge: Any = buildConstellationEdge(left, right)
            if ((!edge)):
                continue
            edges.push(edge)
            rightIndex = (rightIndex + 1)
        leftIndex = (leftIndex + 1)
    return none

fn buildConstellationLensBands(input: ConstellationBandBuildInput) -> Any:
    let nodeMetadata: Any = buildNodeMetadata(input.entries, input, (input.nowMs or Date.now()))
    let referenceNode: Any = findConstellationReferenceNode(nodeMetadata)
    if ((input.activeLens == "structure")):
        return buildStructureBands(nodeMetadata, input, referenceNode)
    else if ((input.activeLens == "time")):
        return buildTimeBands(nodeMetadata, input)
    else if ((input.activeLens == "similarity")):
        return buildSimilarityBands(nodeMetadata, input, referenceNode)
    else if ((input.activeLens == "workflow")):
        ()
    else:
        return buildWorkflowBands(nodeMetadata, input, referenceNode)

fn createConstellationGraphEdgeLookup(edges: Any) -> Map<String, ConstellationGraphEdge>:
    return ts_Map(edges.map(none))

fn createConstellationGraphAdjacencyLookup(edges: Any) -> Map<String, [ConstellationGraphEdge]>:
    let adjacency: Any = ts_Map()
    for edge in edges:
        let fromEdges: Any = (adjacency.get(edge.fromPath) or [])
        fromEdges.push(edge)
        adjacency.set(edge.fromPath, fromEdges)
        let toEdges: Any = (adjacency.get(edge.toPath) or [])
        toEdges.push(edge)
        adjacency.set(edge.toPath, toEdges)
    return adjacency

fn resolveConstellationRouteState(args: Any) -> Any:
    let nodeByPath: Any = ts_Map(args.graph.nodes.map(none))
    let adjacency: Any = createConstellationGraphAdjacencyLookup(args.graph.edges)
    let anchorPath: Any = ((((args.visibleEntryOrder.find(none).path or args.visibleEntryOrder.find(none).path) or args.dominantPath) or args.visibleEntryOrder[0].path) or none)
    if ((!anchorPath)):
        return none
    let candidateEdges: Any = (adjacency.get(anchorPath) or [])
    let rankedTargets: Any = candidateEdges.map(none).filter(none).sort(none).slice(0, CONSTELLATION_ROUTE_TARGET_LIMIT)
    return none

fn findConstellationEdgeBetween(edgeLookup: ReadonlyMap<String, ConstellationGraphEdge>, leftPath: String, rightPath: String) -> Any:
    if ((((!leftPath) or (!rightPath)) or (leftPath == rightPath))):
        return none
    return (edgeLookup.get(createConstellationEdgeId(leftPath, rightPath)) or none)

fn resolveConstellationNodeExplanation(args: Any) -> Any:
    let edgeLookup: Any = (args.edgeLookup or createConstellationGraphEdgeLookup(args.graph.edges))
    if ((args.routeAnchorPath and (args.routeAnchorPath != args.nodePath))):
        let routedEdge: Any = findConstellationEdgeBetween(edgeLookup, args.routeAnchorPath, args.nodePath)
        if (routedEdge):
            return none
    let adjacency: Any = (args.adjacencyLookup or createConstellationGraphAdjacencyLookup(args.graph.edges))
    let localEdges: Any = (adjacency.get(args.nodePath) or [])
    let strongestEdge: Option<Any> = none
    for edge in localEdges:
        if (((!strongestEdge) or (edge.scoreByLens[args.activeLens] > strongestEdge.scoreByLens[args.activeLens]))):
            strongestEdge = edge
    if ((!strongestEdge)):
        return none
    return none

fn getConstellationEdgeReasonsForLens(edge: ConstellationGraphEdge, activeLens: ConstellationLensId) -> [ConstellationEdgeReason]:
    return [edge.reasons].sort(none).slice(0, CONSTELLATION_HOVER_REASON_LIMIT)

fn buildStructureBands(nodeMetadata: Any, input: ConstellationBandBuildInput, referenceNode: Any) -> [ConstellationLensBand]:
    let folderEntries: Any = nodeMetadata.filter(none).map(none)
    let referenceParentPath: Any = none
    let localContextEntries: Any = nodeMetadata.filter(none).map(none)
    let siblingTypeEntries: Any = nodeMetadata.filter(none).map(none)
    let claimedPaths: Any = ts_Set([folderEntries.map(none), localContextEntries.map(none), siblingTypeEntries.map(none)])
    return compactConstellationBands([createBand("folders", "Folders", "Directory anchors define the structural map.", true, folderEntries), createBand("local-structure", "Local Context", "Sibling files stay closest to the active folder anchor.", false, sortConstellationEntries(localContextEntries, input.sortBy, input.sortOrder)), createBand("similar-shape", "Shared Shape", "Matching stems and file types stay nearby in structure view.", false, sortConstellationEntries(dedupeEntries(siblingTypeEntries), input.sortBy, input.sortOrder)), createBand("outer-structure", "Outer Surface", "Everything else stays visible without crowding the anchor cluster.", false, sortConstellationEntries(nodeMetadata.map(none).filter(none), input.sortBy, input.sortOrder))])

fn buildTimeBands(nodeMetadata: Any, input_2: ConstellationBandBuildInput) -> [ConstellationLensBand]:
    let buckets: Any = ts_Map()
    for node in nodeMetadata:
        let entries: Any = (buckets.get(node.recencyBucketId) or [])
        entries.push(node.entry)
        buckets.set(node.recencyBucketId, entries)
    return compactConstellationBands([createBand("today", "Today", "Fresh edits stay at the front of the time lens.", true, sortConstellationEntries((buckets.get("today") or []), "date", "desc")), createBand("this-week", "This Week", "Files touched this week stay one move away from the freshest layer.", false, sortConstellationEntries((buckets.get("this-week") or []), "date", "desc")), createBand("this-month", "This Month", "Current-month work stays visible before it falls into the archive.", false, sortConstellationEntries((buckets.get("this-month") or []), "date", "desc")), createBand("archive", "Archive", "Older files compress into the deeper timeline field.", false, sortConstellationEntries([((buckets.get("this-quarter") or [])), ((buckets.get("archive") or [])), ((buckets.get("undated") or []))], "date", "desc"))])

fn buildSimilarityBands(nodeMetadata: Any, input: ConstellationBandBuildInput, referenceNode: Any) -> [ConstellationLensBand]:
    let referenceTokens: Any = ts_Set((referenceNode.pathTokens or []))
    let referenceTags: Any = ts_Set((referenceNode.tagIds or []))
    let stemMatches: Any = nodeMetadata.filter(none).map(none)
    let typeMatches: Any = nodeMetadata.filter(none).map(none)
    let tokenMatches: Any = nodeMetadata.filter(none).map(none)
    let tagMatches: Any = nodeMetadata.filter(none).map(none)
    let claimedPaths: Any = ts_Set([stemMatches.map(none), typeMatches.map(none), tokenMatches.map(none), tagMatches.map(none)])
    return compactConstellationBands([createBand("stem-matches", "Shared Stem", "Files with the same basename stay closest to the current anchor.", true, sortConstellationEntries(dedupeEntries(stemMatches), input.sortBy, input.sortOrder)), createBand("type-matches", "Shared Type", "Matching extensions and tags form the next similarity ring.", false, sortConstellationEntries(dedupeEntries([typeMatches, tagMatches]), input.sortBy, input.sortOrder)), createBand("token-matches", "Shared Tokens", "Path tokens keep semantically close names within reach.", false, sortConstellationEntries(dedupeEntries(tokenMatches), input.sortBy, input.sortOrder)), createBand("outer-similarity", "Outer Matches", "The remaining surface stays visible without overwhelming the anchor.", false, sortConstellationEntries(nodeMetadata.map(none).filter(none), input.sortBy, input.sortOrder))])

fn buildWorkflowBands(nodeMetadata: Any, input: ConstellationBandBuildInput, referenceNode: Any) -> [ConstellationLensBand]:
    let folderEntries: Any = nodeMetadata.filter(none).map(none)
    let worksetEntries: Any = nodeMetadata.filter(none).map(none)
    let referenceParentPath: Any = none
    let localContextEntries: Any = nodeMetadata.filter(none).map(none)
    let recentEntries: Any = selectRecentConstellationFileEntries(nodeMetadata, CONSTELLATION_LENS_RECENT_ENTRY_LIMIT)
    let claimedPaths: Any = ts_Set([folderEntries.map(none), worksetEntries.map(none), localContextEntries.map(none), recentEntries.map(none)])
    return compactConstellationBands([createBand("folders", "Folders", "Directory anchors keep the map navigable.", true, folderEntries), createBand("workset", "Workset", "Selected, pinned, and bookmarked entries become the live task map.", false, sortConstellationEntries(dedupeEntries(worksetEntries), input.sortBy, input.sortOrder)), createBand("local-context", "Local Context", "Selection-adjacent files stay near the next-step orbit.", false, sortConstellationEntries(dedupeEntries(localContextEntries), input.sortBy, input.sortOrder)), createBand("recent-flow", "Recent Activity", "Freshly modified work stays elevated in the flow lens.", false, sortConstellationEntries(dedupeEntries(recentEntries), "date", "desc")), createBand("outer-flow", "Outer Flow", "The remaining files stay available without stealing focus.", false, sortConstellationEntries(nodeMetadata.map(none).filter(none), input.sortBy, input.sortOrder))])

fn findConstellationReferenceNode(nodeMetadata: Any) -> Any:
    let latestFileNode: Option<Any> = none
    for node in nodeMetadata:
        if (node.selected):
            return node
        if (((!latestFileNode) and (!node.entry.is_dir))):
            latestFileNode = node
        else if ((((!node.entry.is_dir) and latestFileNode) and (node.entry.modified > latestFileNode.entry.modified))):
            latestFileNode = node
    return (((((nodeMetadata.find(none) or nodeMetadata.find(none)) or latestFileNode) or nodeMetadata[0]) or none))

fn buildNodeMetadata(entries: Any, context: Any, nowMs: Float) -> [NodeMetadata]:
    return entries.map(none)

fn selectComparedConstellationNodeMetadata(nodeMetadata: Any) -> Any:
    let maxComparedNodes: Any = CONSTELLATION_GRAPH_NODE_BUDGETS.maxComparedNodes
    if ((nodeMetadata.length <= maxComparedNodes)):
        return [nodeMetadata]
    let requiredNodes: [NodeMetadata] = []
    let candidateNodes: [NodeMetadata] = []
    for node in nodeMetadata:
        if (((node.selected or node.pinned) or node.bookmarked)):
            requiredNodes.push(node)
        else:
            candidateNodes.push(node)
    let selectedRequiredNodes: Any = requiredNodes.slice(0, maxComparedNodes)
    let remainingBudget: Any = Math.max(0, (maxComparedNodes - selectedRequiredNodes.length))
    let selectedCandidateNodes: Any = selectBestConstellationGraphCandidateNodes(candidateNodes, remainingBudget)
    return [selectedRequiredNodes, selectedCandidateNodes].sort(none)

fn selectBestConstellationGraphCandidateNodes(candidateNodes: Any, limit: Float) -> Any:
    if ((limit <= 0)):
        return []
    let rankedNodes: [RankedConstellationNodeMetadata] = []
    for node in candidateNodes:
        let rankedNode: Any = none
        let insertIndex: Any = rankedNodes.findIndex(none)
        if ((insertIndex >= 0)):
            rankedNodes.splice(insertIndex, 0, rankedNode)
        else if ((rankedNodes.length < limit)):
            rankedNodes.push(rankedNode)
        if ((rankedNodes.length > limit)):
            rankedNodes.length = limit
    return rankedNodes.map(none)

fn compareRankedConstellationGraphCandidate(left: RankedConstellationNodeMetadata, right: RankedConstellationNodeMetadata) -> Float:
    return (((((right.score - left.score) or (right.node.entry.modified - left.node.entry.modified)) or (left.node.index - right.node.index)) or TEXT_COLLATOR.compare(left.node.entry.name, right.node.entry.name)))

fn getConstellationGraphCandidateScore(node: NodeMetadata) -> Float:
    let score: Any = 0
    if (node.entry.is_dir):
        score = (score + CONSTELLATION_GRAPH_NODE_BUDGETS.directoryScore)
    score = (score + getConstellationRecencyCandidateScore(node.recencyBucketId))
    if ((node.tagIds.length > 0)):
        score = (score + CONSTELLATION_GRAPH_NODE_BUDGETS.taggedScore)
    if (node.anchorEligible):
        score = (score + 24)
    return score

fn getConstellationRecencyCandidateScore(bucketId: ConstellationRecencyBucketId) -> Any:
    if ((bucketId == "today")):
        return CONSTELLATION_GRAPH_NODE_BUDGETS.recentTodayScore
    else if ((bucketId == "this-week")):
        return CONSTELLATION_GRAPH_NODE_BUDGETS.recentWeekScore
    else if ((bucketId == "this-month")):
        return CONSTELLATION_GRAPH_NODE_BUDGETS.recentMonthScore
    else if ((bucketId == "this-quarter")):
        return CONSTELLATION_GRAPH_NODE_BUDGETS.recentQuarterScore
    else if ((bucketId == "archive")):
        return CONSTELLATION_GRAPH_NODE_BUDGETS.archiveScore
    else if ((bucketId == "undated")):
        ()
    else:
        return 0

fn selectRecentConstellationFileEntries(nodeMetadata: Any, limit: Float) -> Any:
    if ((limit <= 0)):
        return []
    let recentNodes: [NodeMetadata] = []
    for node in nodeMetadata:
        if (node.entry.is_dir):
            continue
        let insertIndex: Any = recentNodes.findIndex(none)
        if ((insertIndex >= 0)):
            recentNodes.splice(insertIndex, 0, node)
        else if ((recentNodes.length < limit)):
            recentNodes.push(node)
        if ((recentNodes.length > limit)):
            recentNodes.length = limit
    return recentNodes.map(none)

fn buildConstellationEdge(left: NodeMetadata, right: NodeMetadata) -> Any:
    let reasons: [ConstellationEdgeReason] = []
    let sharedTokens: Any = intersectStringValues(left.pathTokens, right.pathTokens)
    let sharedTags: Any = intersectStringValues(left.tagIds, right.tagIds)
    let sharedStem: Any = ((left.stem.length > 0) and (left.stem == right.stem))
    let sharedExtension: Any = ((left.extension.length > 0) and (left.extension == right.extension))
    let sameParent: Any = ((left.parentPath.length > 0) and (left.parentPath == right.parentPath))
    let folderAnchor: Any = (((left.entry.is_dir and (right.parentPath == normalizeExplorerPath(left.entry.path)))) or ((right.entry.is_dir and (left.parentPath == normalizeExplorerPath(right.entry.path)))))
    if (folderAnchor):
        reasons.push(createConstellationReason("folderAnchor", none))
    if (sameParent):
        reasons.push(createConstellationReason("sameParent", left.entry.name + " and " + right.entry.name + " live under " + formatExplorerPathLabel(left.parentPath) + "."))
    if (sharedStem):
        reasons.push(createConstellationReason("sharedStem", "They share the base name " + left.stem + "."))
    if (sharedExtension):
        reasons.push(createConstellationReason("sameExtension", "Both resolve as ." + left.extension + " files."))
    let meaningfulSharedTokens: Any = sharedTokens.filter(none)
    if (((meaningfulSharedTokens.length >= 2) or meaningfulSharedTokens.some(none))):
        reasons.push(createConstellationReason("sharedPathToken", "Shared path tokens: " + meaningfulSharedTokens.slice(0, 3).join(", ") + "."))
    if ((sharedTags.length > 0)):
        reasons.push(createConstellationReason("sharedTag", "Shared tags: " + sharedTags.slice(0, 3).join(", ") + "."))
    if (((left.recencyBucketId != "undated") and (left.recencyBucketId == right.recencyBucketId))):
        reasons.push(createConstellationReason("sameRecencyBucket", "Both were modified in " + left.recencyBucketLabel.toLowerCase() + "."))
    let modifiedDistance: Any = Math.abs((left.entry.modified - right.entry.modified))
    if ((((left.entry.modified > 0) and (right.entry.modified > 0)) and (modifiedDistance <= (((72 * 60) * 60) * 1000)))):
        reasons.push(createConstellationReason("modifiedProximity", "Modified " + formatRelativeModificationDistance(modifiedDistance) + " apart."))
    if ((left.pinned and right.pinned)):
        reasons.push(createConstellationReason("pinnedWorkset", "Both entries are pinned into the current Constellation workset."))
    if (((((left.selected or right.selected)) and (Math.abs((left.index - right.index)) <= 4)) and (left.entry.path != right.entry.path))):
        reasons.push(createConstellationReason("selectionAdjacency", "This relationship stays close to the active selection pass."))
    if ((((left.bookmarked or right.bookmarked)) and ((((sameParent or folderAnchor) or sharedStem) or (meaningfulSharedTokens.length > 0))))):
        reasons.push(createConstellationReason("bookmarkAnchor", "A bookmarked path is reinforcing this relationship."))
    if ((reasons.length == 0)):
        return none
    let scoreByLens: Any = calculateConstellationScores(reasons)
    let maxScore: Any = Math.max(scoreByLens.structure, scoreByLens.time, scoreByLens.similarity, scoreByLens.workflow)
    let minimumEdgeScore: Any = Math.min(CONSTELLATION_MIN_EDGE_SCORE_BY_LENS.structure, CONSTELLATION_MIN_EDGE_SCORE_BY_LENS.time, CONSTELLATION_MIN_EDGE_SCORE_BY_LENS.similarity, CONSTELLATION_MIN_EDGE_SCORE_BY_LENS.workflow)
    if ((maxScore < minimumEdgeScore)):
        return none
    return none

fn calculateConstellationScores(reasons: Any) -> Any:
    return reasons.reduce(none, none)

fn createConstellationReason(kind: ConstellationEdgeReasonKind, detail: String) -> Any:
    let definition: Any = getConstellationReasonDefinition(kind)
    let weights: Any = CONSTELLATION_REASON_WEIGHTS[kind]
    return none

fn getConstellationRouteTargetBonus(node: ConstellationGraphNode, activeLens: ConstellationLensId, bookmarkPaths: ReadonlySet<String>) -> Float:
    let bonus: Any = 0
    if (node.pinned):
        bonus = (bonus + 0.24)
    if (bookmarkPaths.has(node.entry.path)):
        bonus = (bonus + 0.18)
    if (node.selected):
        bonus = (bonus + 0.12)
    if (((activeLens != "time") and node.entry.is_dir)):
        bonus = (bonus + 0.1)
    if (((activeLens == "workflow") and node.anchorEligible)):
        bonus = (bonus + 0.08)
    return bonus

fn getReasonLensWeight(reasonKind: ConstellationEdgeReasonKind, activeLens: ConstellationLensId) -> Float:
    return CONSTELLATION_REASON_WEIGHTS[reasonKind][activeLens]

fn getConstellationRecencyBucket(modifiedMs: Float, nowMs: Float) -> Any:
    if ((!modifiedMs)):
        return none
    let ageMs: Any = Math.max(0, (nowMs - modifiedMs))
    let bucket: Any = CONSTELLATION_RECENCY_BUCKETS.find(none)
    if ((!bucket)):
        return none
    return none

fn tokenizeConstellationPath(entry: FileEntry) -> [String]:
    let baseValue: Any = entry.name + " " + entry.path.toLowerCase()
    return ts_Array.from(ts_Set(baseValue.split("/[^a-z0-9]+/g").map(none).filter(none)))

fn getEntryExtension(entry: Any) -> Any:
    if (entry.is_dir):
        return ""
    let normalizedExtension: Any = ((entry.extension or "")).trim().replace(none, "").toLowerCase()
    if (normalizedExtension):
        return normalizedExtension
    let lastDotIndex: Any = entry.name.lastIndexOf(".")
    if (((lastDotIndex <= 0) or (lastDotIndex == (entry.name.length - 1)))):
        return ""
    return entry.name.slice((lastDotIndex + 1)).toLowerCase()

fn getEntryStem(entry: Any) -> Any:
    if (entry.is_dir):
        return entry.name.trim().toLowerCase()
    let normalizedName: Any = entry.name.trim().toLowerCase()
    let lastDotIndex: Any = normalizedName.lastIndexOf(".")
    return none

fn getExplorerParentPath(path: String) -> Any:
    if (path.startsWith("cloud://")):
        let trimmed: Any = path.replace(none, "")
        let segments: Any = trimmed.split("/")
        if ((segments.length <= 5)):
            return trimmed
        return segments.slice(0, (-1)).join("/")
    let normalized: Any = path.replace(none, "")
    let parts: Any = normalized.split(none)
    if ((parts.length <= 1)):
        return normalized
    if ("/^[A-Za-z]:$/".test_((parts[0] or ""))):
        return parts.slice(0, (-1)).join(none) + none
    return parts.slice(0, (-1)).join("/")

fn normalizeExplorerPath(path: String) -> Any:
    if (path.startsWith("cloud://")):
        return (path.replace(none, "") or path)
    return none

fn createBand(id: String, label: String, description: String, dominant: Bool, entries: Any) -> Any:
