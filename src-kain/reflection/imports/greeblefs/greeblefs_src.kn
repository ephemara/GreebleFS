fn asRecord(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    return value

fn asString(value: Any, fallback: Any) -> Any:
    let fallback: Any = fallback
    return none

fn asStringArray(value: Any) -> Any:
    if ((!ts_Array.isArray(value))):
        return []
    return ts_Array.from(ts_Set(value.filter(none).map(none)))

fn asStringRecord(value: Any) -> Any:
    let source: Any = asRecord(value)
    if ((!source)):
        return none
    return ts_Object.fromEntries(ts_Object.entries(source).filter(none).map(none))

fn normalizePackIdFragment(value: Any, fallback: String) -> String:
    let normalized: Any = ((value or fallback)).trim().toLowerCase().replace("/[^a-z0-9]+/g", "-").replace("/^-+|-+$/g", "")
    return (normalized or fallback)

fn createScopedPackId(scopeId: Any, localId: String) -> Any:
    let normalizedLocalId: Any = normalizePackIdFragment(localId, "theme-pack")
    if ((!scopeId)):
        return normalizedLocalId
    return normalizePackIdFragment(scopeId, "theme-bundle") + ":" + normalizedLocalId

fn deriveDisplayName(id: String) -> String:
    return id.replace("/[-_]+/g", " ").replace(none, " ").replace(none, none)

fn normalizePathAsset(path: String) -> String:
    return path.trim().replace(none, "")

fn toAssetUrl(filePath: String) -> Any:
    if ((window == "undefined")):
        return filePath

fn resolvePreviewUrl(directoryPath: String, previewPath: String) -> Any:
    let trimmedPath: Any = previewPath.trim()
    if ((!trimmedPath)):
        return undefined
    return toAssetUrl(joinPlatformPath(directoryPath, normalizePathAsset(trimmedPath)))

fn buildPackMetadata(manifest: TManifest, manifestPath: String, directoryPath: String, options: ThemeBundlePackOptions) -> Any:
    let localId: Any = normalizePackIdFragment((manifest.id or manifest.name), "theme-pack")
    let id: Any = createScopedPackId(options.scopeId, localId)
    return none

fn parseManifestText(text: String, filePath: String) -> LooseRecord:
    let trimmed: Any = text.trim()
    if ((!trimmed)):
        ()
    let parsed: Any = none
    let source: Any = asRecord(parsed)
    if ((!source)):
        ()
    return source

fn readOptionalLooseRecord(filePath: String) -> impl Async_<Any>:
    ()

fn getParentDirectoryPath(path: String) -> Any:
    let normalized: Any = path.replace(none, "/")
    let lastSlash: Any = normalized.lastIndexOf("/")
    if ((lastSlash <= 0)):
        return none
    return normalized.slice(0, lastSlash)

fn normalizeThemeBundleRuntimeModulePath(path: String) -> Any:
    let normalizedPath: Any = path.trim().replace(none, "/")
    if ((((!normalizedPath) or normalizedPath.startsWith("/")) or none.test_(normalizedPath))):
        return none
    let segments: [String] = []
    for segment in normalizedPath.split("/"):
        if (((!segment) or (segment == "."))):
            continue
        if ((segment == "..")):
            if ((segments.length == 0)):
                return none
            segments.pop()
            continue
        segments.push(segment)
    return segments.join("/")

fn normalizeThemeBundleComparisonPath(path: String) -> String:
    return path.replace(none, "/").replace(none, "/").replace(none, "")

fn getThemeBundleRelativePath(directoryPath: String, filePath: String) -> Any:
    let normalizedDirectoryPath: Any = normalizeThemeBundleComparisonPath(directoryPath)
    let normalizedFilePath: Any = normalizeThemeBundleComparisonPath(filePath)
    if (((!normalizedDirectoryPath) or (!normalizedFilePath))):
        return none
    if ((normalizedFilePath == normalizedDirectoryPath)):
        return ""
    if ((!normalizedFilePath.startsWith(normalizedDirectoryPath + "/"))):
        return none
    return normalizedFilePath.slice((normalizedDirectoryPath.length + 1))

fn resolveThemeBundleRuntimeModuleImportPath(fromModuleRelativePath: String, specifier: String) -> Any:
    let importerSegments: Any = fromModuleRelativePath.replace(none, "/").split("/").filter(ts_Boolean)
    importerSegments.pop()
    let specifierSegments: Any = specifier.replace(none, "/").split("/")
    return normalizeThemeBundleRuntimeModulePath([importerSegments, specifierSegments].join("/"))

fn buildThemeBundleRuntimeModuleCandidates(relativePath: String) -> Any:
    let normalizedRelativePath: Any = normalizeThemeBundleRuntimeModulePath(relativePath)
    if ((!normalizedRelativePath)):
        return []
    let candidates: Any = ts_Set()
    if (none.test_(normalizedRelativePath)):
        candidates.add(normalizedRelativePath)
    else:
        for extension in themeBundleRuntimeModuleExtensions:
            candidates.add(normalizedRelativePath + "." + extension)
            candidates.add(normalizedRelativePath + "/index." + extension)
    return [candidates]

fn createThemeBundleRelativeModuleSourceResolver(directoryPath: String) -> Any:
    return none

fn readManifestEntries(directoryEntries: [FileEntry], manifestNames: Any) -> impl Async_<[Any]>:
    let loaded: [Any] = []
    for entry in directoryEntries:
        if ((!entry.is_dir)):
            let lowerName: Any = entry.name.toLowerCase()
            let isManifest: Any = (lowerName.endsWith(".json") or lowerName.endsWith(".toml"))
            if ((!isManifest)):
                continue
            let text: Any = (await commands.fsReadTextFile(entry.path).then(unwrapTauriResult))
            loaded.push(none)
            continue
        for manifestName in manifestNames:
            let manifestPath: Any = joinPlatformPath(entry.path, manifestName)
    return loaded

fn mergeStringRecords(records: [Any]) -> Any:
    let records: Any = records
    let merged: Any = ts_Object.assign(none, none)
    return none

fn pickRecord(value: Any) -> Any:
    return asRecord(value)

fn readTokenCategoryFiles(directoryPath: String, categories: Any) -> impl Async_<Any>:
    let entries: Any = (await ts_Promise.all(categories.map(none)))
    return ts_Object.fromEntries(entries.filter(none))

fn normalizeTokenFilePayload(category: UiTokenCategory, source: Any) -> Any:
    if ((!source)):
        return none
    let explicitTokens: Any = normalizeUiTokenCategoryMap((source.tokens or source[category]))
    let fallbackTokens: Any = none
    return none

fn normalizeTokenFiles(tokenFiles: Any) -> UiTokenCollection:
    return mergeUiTokenCollections(none)

