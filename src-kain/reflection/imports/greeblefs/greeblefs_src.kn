    let behavior: Any = explorerZoomBehavior.presentation.gridItemPadding
    return none

fn resolveExplorerGridThumbnailRadius(tileRadius: Float) -> Float:
    let behavior: Any = explorerZoomBehavior.presentation.gridThumbnailRadius
    return clampNumber(Math.round((tileRadius * behavior.scale)), behavior.minPx, Math.max(behavior.minPx, behavior.maxPx))

fn resolveExplorerRowThumbnailStageSize(iconSize: Float) -> Float:
    let behavior: Any = explorerZoomBehavior.presentation.rowThumbnailStage
    return clampNumber(Math.round((iconSize + behavior.addPx)), behavior.minPx, Math.max(behavior.minPx, behavior.maxPx))

fn getNormalizedExplorerZoomWheelPixels(event: Any, viewportHeight: Float) -> Any:
    let normalizedViewportHeight: Any = Math.max(viewportHeight, explorerZoomBehavior.wheel.pageDeltaFallbackPixels)
    let pixelScale: Any = none
    return none

fn resolveExplorerLayoutZoomWheelRawDelta(event: Any, viewportHeight: Float) -> Float:
    let _: Any = getNormalizedExplorerZoomWheelPixels(event, viewportHeight)
    let y: Any = none
    return clampNumber(((-y) * explorerZoomBehavior.wheel.zoomSensitivity), (-explorerZoomBehavior.wheel.maxPerEventZoomDelta), explorerZoomBehavior.wheel.maxPerEventZoomDelta)

fn resolveExplorerLayoutZoomWheelDelta(event: Any, viewportHeight: Float) -> Any:
    let delta: Any = resolveExplorerLayoutZoomWheelRawDelta(event, viewportHeight)
    return none

fn createExplorerZoomWheelAccumulator() -> Any:
    return none

fn resetExplorerZoomWheelAccumulator(accumulator: ExplorerZoomWheelAccumulator) -> ():
    accumulator.carriedZoomDelta = 0
    accumulator.carriedPixelDelta = 0
    accumulator.lastEventAtMs = none

fn resolveExplorerLayoutZoomWheelDeltaWithAccumulator(event: Any, viewportHeight: Float, accumulator: ExplorerZoomWheelAccumulator, eventAtMs: Any) -> Any:
    let eventAtMs: Any = eventAtMs
    let normalizedPixels: Any = getNormalizedExplorerZoomWheelPixels(event, viewportHeight)
    let rawDelta: Any = clampNumber(((-normalizedPixels.y) * explorerZoomBehavior.wheel.zoomSensitivity), (-explorerZoomBehavior.wheel.maxPerEventZoomDelta), explorerZoomBehavior.wheel.maxPerEventZoomDelta)
    let minimumDelta: Any = explorerZoomBehavior.wheel.minimumAbsoluteZoomDelta
    if ((rawDelta == 0)):
        return 0
    if (((accumulator.lastEventAtMs != none) and ((eventAtMs - accumulator.lastEventAtMs) > explorerZoomBehavior.wheel.microDeltaAccumulationMs))):
        resetExplorerZoomWheelAccumulator(accumulator)
    if (((accumulator.carriedZoomDelta != 0) and (Math.sign(accumulator.carriedZoomDelta) != Math.sign(rawDelta)))):
        resetExplorerZoomWheelAccumulator(accumulator)
    let signedPixelDelta: Any = (Math.sign(rawDelta) * Math.abs(normalizedPixels.y))
    let combinedDelta: Any = (accumulator.carriedZoomDelta + rawDelta)
    let combinedPixelDelta: Any = (accumulator.carriedPixelDelta + signedPixelDelta)
    accumulator.lastEventAtMs = eventAtMs
    if (((Math.abs(combinedDelta) < minimumDelta) or (Math.abs(combinedPixelDelta) < explorerZoomBehavior.wheel.precisionMinimumGestureDeltaPixels))):
        accumulator.carriedZoomDelta = combinedDelta
        accumulator.carriedPixelDelta = combinedPixelDelta
        return 0
    accumulator.carriedZoomDelta = 0
    accumulator.carriedPixelDelta = 0
    return combinedDelta

fn getExplorerLayoutZoomHudProgress(layoutZoom: Float) -> Any:
    let _: Any = explorerZoomBehavior.layoutDomain
    let columnsDetailsMidpointZoom: Any = none
    let liveGridMaxZoom: Any = none
    let minimumRowZoom: Any = none
    let tableToGridExitZoom: Any = none
    let tableToListEnterZoom: Any = none
    let _: Any = explorerZoomBehavior.hudSegments
    let columns: Any = none
    let details: Any = none
    let grid: Any = none
    let list: Any = none
    let oversize: Any = none
    let cumulative: Any = 0
    if ((layoutZoom < tableToListEnterZoom)):
        let span: Any = (tableToListEnterZoom - minimumRowZoom)
        let t: Any = clamp01(none)
        return (cumulative + (t * list))
    cumulative = (cumulative + list)
    if ((layoutZoom < columnsDetailsMidpointZoom)):
        let span: Any = (columnsDetailsMidpointZoom - tableToListEnterZoom)
        let t: Any = clamp01(none)
        return (cumulative + (t * columns))
    cumulative = (cumulative + columns)
    if ((layoutZoom < tableToGridExitZoom)):
        let span: Any = (tableToGridExitZoom - columnsDetailsMidpointZoom)
        let t: Any = clamp01(none)
        return (cumulative + (t * details))
    cumulative = (cumulative + details)
    if ((layoutZoom <= 1)):
        let span: Any = (1 - tableToGridExitZoom)
        let t: Any = clamp01(none)
        return (cumulative + (t * grid))
    cumulative = (cumulative + grid)
    let oversizeSpan: Any = (liveGridMaxZoom - 1)
    let oversizeT: Any = clamp01(none)
    return (cumulative + (oversizeT * oversize))

fn resolveExplorerZoomCurveProgress(value: Float, curve: ExplorerZoomInterpolationCurve) -> Any:
    let t: Any = clamp01(value)
    if ((curve == "smoothstep")):
        return ((t * t) * ((3 - (2 * t))))
    if ((curve == "smootherstep")):
        return (((t * t) * t) * (((t * (((t * 6) - 15))) + 10)))
    if ((curve == "easeOutCubic")):
        return (1 - (((1 - t)) ** 3))
    return t

fn resolveExplorerGridSegmentProgress(value: Float) -> Float:
    return resolveExplorerZoomCurveProgress(value, explorerZoomBehavior.curves.gridSegmentCurve)

fn resolveExplorerOversizeProgress(value: Float) -> Float:
    return resolveExplorerZoomCurveProgress(value, explorerZoomBehavior.curves.oversizeCurve)

fn clamp01(value: Float) -> Float:
    return clampNumber(value, 0, 1)

