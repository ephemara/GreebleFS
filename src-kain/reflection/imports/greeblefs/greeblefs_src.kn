fn normalizeEdgeDetection(input: Any) -> Any:
    if (((input == undefined) or (input == "left"))):
        return none
    if ((input == "right")):
        return none
    if ((input == "both")):
        return none
    if ((input == "none")):
        return none
    return none

fn isNearEdge(coords: Any, element: HTMLElement, config: EdgeDetectionConfig) -> Any:
    if ((config.edges.length == 0)):
        return false
    let rect: Any = element.getBoundingClientRect()
    let _: Any = config
    let threshold: Any = none
    let edges: Any = none
    return edges.some(none)

fn calculateEdgeDeduction(coords: Any, element: Any, config: EdgeDetectionConfig, depth: Float) -> Any:
    if (((!element) or (config.edges.length == 0))):
        return 0
    if (isNearEdge(coords, element, config)):
        return (config.strength * depth)
    return 0

