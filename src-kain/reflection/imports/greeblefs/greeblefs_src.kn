fn resolveWasmExecSrc() -> Any:
    if ((document == "undefined")):
        return "runtime/wasm_exec.js"
    return URL("runtime/wasm_exec.js", document.baseURI).toString()

fn ensureGoWasmExecLoaded() -> Any:
    if ((window == "undefined")):
        ()
    if (window.Go):
        return none
    (await ts_Promise(none))

fn ensureBridgeRegistry() -> RuntimeBootBridgeRegistry:
    if ((window == "undefined")):
        ()
    if ((!window[HOST_BRIDGE_GLOBAL])):
        ()
    return window[HOST_BRIDGE_GLOBAL]

fn makeBridgeToken(runtimeId: String) -> String:
    let random: Any = Math.random().toString(36).slice(2, 10)
    return runtimeId + "::" + Date.now() + "::" + random

fn synchronizeBridgeContext(target: Any, nextContext: WasmPanelHostContext) -> ():
    for key in ts_Object.keys(target):
        target[key]
    ts_Object.assign(target, nextContext)

fn resolvePrimaryCompiler(runtimePackage: Any) -> Any:
    return (runtimePackage.manifest.compiler or none)

fn bootGoPanelRuntime(args: Any) -> Any:
    let _: Any = args
    let prepared: Any = none
    let runtimeId: Any = none
    let bridgeToken: Any = none
    let onRuntimeExit: Any = none
    (await ensureGoWasmExecLoaded())
    if ((!window.Go)):
        ()
    let goInstance: Any = window.Go()
    (goInstance).argv = ["greeblefs-panel", "--bridge-token=" + bridgeToken, "--runtime-id=" + runtimeId]
    let wasmFileBytes: Any = (await readRuntimeArtifactBytes(none))
    let wasmBytes: Any = wasmFileBytes.buffer.slice(wasmFileBytes.byteOffset, (wasmFileBytes.byteOffset + wasmFileBytes.byteLength))
    let wasmModule: Any = (await WebAssembly.instantiate(wasmBytes, goInstance.importObject))
    let disposed: Any = false
    goInstance.run(wasmModule.instance).then(none, none)
    return none

fn importRuntimeModule(modulePath: String) -> impl Async_<WasmBindgenPanelModule>:
    return import_dynamic(modulePath)

fn bootRustWasmBindgenPanelRuntime(args: Any) -> Any:
    let moduleUrl: Any = convertFileSrc(args.prepared.artifactPath) + "?cacheKey=" + encodeURIComponent(args.prepared.cacheKey)
    let runtimeModule: Any = (await importRuntimeModule(moduleUrl))
    let init: Any = none
    if ((!init)):
        ()
    (await init())
    let mountPanel: Any = none
    if ((!mountPanel)):
        ()
    (await ts_Promise.resolve(mountPanel(args.bridgeToken)))
    let unmountPanel: Any = none
    return none

