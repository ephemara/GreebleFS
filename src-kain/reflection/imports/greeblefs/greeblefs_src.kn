fn createMediaWallpaperFromFile(entry: WallpaperFileEntry, options: LoadWallpaperFromSourceOptions) -> Any:
    let kind: Any = detectWallpaperKindFromExtension(entry.extension)
    let assetUrl: Any = (options.context.assetUrl or (await resolveWallpaperDisplayAssetUrl(entry.path)))
    let context: Option<Any> = none
    return none

fn createThemeAssetWallpaper(args: Any) -> Any:
    let detectedPath: Any = (args.filePath or args.assetUrl)
    let extension: Any = (detectedPath.split(".").pop() or "")
    let kind: Any = detectWallpaperKindFromExtension(extension)
    return none

fn resolveActiveWallpaper(args: Any) -> Any:
    let availableById: Any = ts_Map(ts_Array.from(args.availableWallpapers).map(none))
    let trimmedOverride: Any = none
    if ((!trimmedOverride)):
        return none
    if ((trimmedOverride == wallpaperSystemConfig.noneWallpaperId)):
        return none
    let selectedWallpaper: Any = availableById.get(trimmedOverride)
    if (selectedWallpaper):
        return none
    return none

