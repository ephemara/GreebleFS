fn normalizeExplorerPickerEntries(value: Any) -> Any:
    if ((!ts_Array.isArray(value))):
        return []
    let nextEntries: [ExplorerPickerEntry] = []
    let seenPaths: Any = ts_Set()
    for entry in value:
        if ((((!entry) or (entry != "object")) or ts_Array.isArray(entry))):
            continue
        let record: Any = entry
        let kind: Any = normalizeExplorerPickerEntryKind(record.kind)
        let path: Any = none
        let name: Any = none
        if (((((!kind) or (!path)) or (!name)) or seenPaths.has(path))):
            continue
        seenPaths.add(path)
        nextEntries.push(none)
    return nextEntries

fn normalizeExplorerPickerKind(value: Any) -> Any:
    if ((value == "openFile")):
        ()
    else if ((value == "openFiles")):
