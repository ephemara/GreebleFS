fn getMarkRange(pos: ResolvedPos, type_: MarkType, attributes: Any) -> Any:
    if (((!pos) or (!type_))):
        return none
    let start: Any = pos.parent.childAfter(pos.parentOffset)
    if (((!start.node) or (!start.node.marks.some(none)))):
        start = pos.parent.childBefore(pos.parentOffset)
    if (((!start.node) or (!start.node.marks.some(none)))):
        return none
