const hotkeyBindingDefinitions: Any = []

const hotkeyDefinitionByKey: Any = ts_Map()

fn applyUsrHotkeyManifest(manifest: Any) -> ():
    hotkeyBindingDefinitions = resolveHotkeyBindingDefinitions(manifest)
    hotkeyDefinitionByKey = ts_Map(hotkeyBindingDefinitions.map(none))

fn createDefaultKeybindingSettings() -> HotkeyBindingSettings:
    let normalizedSettings: Any = hotkeyBindingDefinitions.reduce(none, none)
    normalizedSettings.commandBindingsById = none
    return normalizedSettings

fn normalizeKeybindingValue(value: Any, fallback: String) -> Any:
    if ((value != "string")):
        return fallback
    let normalized: Any = value.split("+").map(none).filter(ts_Boolean).join("+")
    return (normalized or fallback)

fn normalizeKeybindingSettings(value: Any) -> HotkeyBindingSettings:
    let defaults: Any = createDefaultKeybindingSettings()
    let legacyValue: Any = value
    let normalizedSettings: Any = hotkeyBindingDefinitions.reduce(none, none)
    normalizedSettings.commandBindingsById = normalizeCommandHotkeyBindingMap(legacyValue.commandBindingsById)
    return normalizedSettings

fn normalizeCommandHotkeyBindingMap(value: Any) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    return ts_Object.fromEntries(ts_Object.entries(value).map(none).filter(none))

fn getCommandHotkeyBinding(settings: Any, commandId: String) -> String:
    return (settings.commandBindingsById[commandId] or "")

fn getHotkeyBindingDefinition(key: HotkeyBindingKey) -> HotkeyBindingDefinition:
    return (hotkeyDefinitionByKey.get(key) or hotkeyBindingDefinitions[0])

fn formatHotkeyLabel(value: String) -> String:
    return (value.trim() or "Unassigned")

fn normalizeGestureToken(token: String) -> Any:
    let normalized: Any = token.trim().toLowerCase()
    if ((normalized == "control")):
        return "ctrl"
    if ((normalized == "option")):
        return "alt"
    if ((normalized == "cmdorcontrol")):
        return "commandorcontrol"
    return normalized

fn normalizeKeyToken(token: String) -> Any:
    if ((token == " ")):
        return "space"
    let normalized: Any = normalizeGestureToken(token)
    if ((normalized == "esc")):
        return "escape"
    else if ((normalized == "return")):
        return "enter"
    else if ((normalized == "spacebar")):
        return "space"
    else:
        return normalized

const IMPLICIT_SHIFT_KEY_ALIASES: Option<Any> = none

fn matchesImplicitShiftKeyAlias(bindingKeyToken: String, eventKeyToken: String) -> Bool:
    return ((IMPLICIT_SHIFT_KEY_ALIASES[bindingKeyToken].includes(eventKeyToken) or false))

fn isEventTargetInsideLocalAppZoomHotkeyScope(target: Any) -> Bool:
    let element: Any = none
    return ts_Boolean(element.closest("[" + LOCAL_APP_ZOOM_HOTKEY_SCOPE_ATTRIBUTE + none))

fn matchesKeybinding(event: Any, binding: String) -> Any:
    let tokens: Any = normalizeKeybindingValue(binding, "").split("+").map(normalizeKeyToken).filter(ts_Boolean)
    if ((tokens.length == 0)):
        return false
    let keyToken: Any = tokens.find(none)
    if ((!keyToken)):
        return false
    let needsCtrl: Any = tokens.includes("ctrl")
    let needsMeta: Any = ((tokens.includes("meta") or tokens.includes("cmd")) or tokens.includes("command"))
    let needsAlt: Any = tokens.includes("alt")
    let needsShift: Any = tokens.includes("shift")
    let needsCommandOrControl: Any = tokens.includes("commandorcontrol")
    let ctrlMatches: Any = none
    let metaMatches: Any = none
    let altMatches: Any = (event.altKey == needsAlt)
    let normalizedEventKey: Any = normalizeKeyToken(none)
    let implicitShiftAliasMatch: Any = ((!needsShift) and matchesImplicitShiftKeyAlias(keyToken, normalizedEventKey))
    let shiftMatches: Any = none
    return (((((ctrlMatches and metaMatches) and altMatches) and shiftMatches) and (((normalizedEventKey == keyToken) or implicitShiftAliasMatch))))

fn matchesWheelHotkey(event: Any, binding: String) -> Any:
    let tokens: Any = getNormalizedWheelHotkeyTokens(binding)
    if ((!tokens.includes("scroll"))):
        return false
    let needsCtrl: Any = tokens.includes("ctrl")
    let needsMeta: Any = ((tokens.includes("meta") or tokens.includes("cmd")) or tokens.includes("command"))
    let needsAlt: Any = tokens.includes("alt")
    let needsShift: Any = tokens.includes("shift")
    let needsCommandOrControl: Any = tokens.includes("commandorcontrol")
    let ctrlMatches: Any = none
    let metaMatches: Any = none
    return ((((ctrlMatches and metaMatches) and (event.altKey == needsAlt)) and (event.shiftKey == needsShift)))

fn shouldArmNonPassiveWheelHotkeyListener(event: Any, bindings: Any) -> Bool:
    return bindings.some(none)

fn getNormalizedWheelHotkeyTokens(binding: String) -> [String]:
    return normalizeKeybindingValue(binding, "Ctrl+Scroll").split("+").map(normalizeGestureToken)

fn isWheelHotkeyModifierToken(token: String) -> Bool:
    return ((((((((token == "ctrl") or (token == "meta")) or (token == "cmd")) or (token == "command")) or (token == "commandorcontrol")) or (token == "alt")) or (token == "shift")))

