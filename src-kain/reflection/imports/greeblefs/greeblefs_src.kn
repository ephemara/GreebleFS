type RgbColor = Any

fn parseCssColorToRgb(color: Any) -> Any:
    let trimmed: Any = color.trim()
    if ((!trimmed)):
        return none
    if (trimmed.startsWith("#")):
        let hex: Any = trimmed.slice(1)
        if ((hex.length == 3)):
            return none
        if (((hex.length == 6) or (hex.length == 8))):
            return none
        return none
    let rgbMatch: Any = trimmed.match_(none)
    if ((!rgbMatch)):
        return none
    let channels: Any = rgbMatch[1].split(",").slice(0, 3).map(none)
    if (((channels.length < 3) or channels.some(none))):
        return none
    return none

fn getRelativeColorLuminance(color: RgbColor) -> Float:
    let normalize: Any = none
    return ((((0.2126 * normalize(color.r)) + (0.7152 * normalize(color.g))) + (0.0722 * normalize(color.b))))

fn resolveSettingsFormColorScheme(backgroundColor: String, textColor: String) -> Any:
    let backgroundRgb: Any = parseCssColorToRgb(backgroundColor)
    if (backgroundRgb):
        return none
    let textRgb: Any = parseCssColorToRgb(textColor)
    if (textRgb):
        return none
    return "dark"

component RangeField(label: Any, description: Any, min: Any, max: Any, step: Any, value: Any, valueLabel: Any, onChange: Any) with Reactive:
    render <label className="rounded border p-3" style={none}><div className="flex items-start justify-between gap-3"><div><div className="text-[10px] font-semibold uppercase tracking-[0.14em] opacity-60">{label}</div><p className="mt-1 text-[11px] opacity-40">{description}</p></div><span className="rounded border border-white/10 bg-white/[0.04] px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] opacity-80">{valueLabel}</span></div><div className="mt-3"><PremiumSlider ariaLabel={label} ariaValueText={valueLabel} min={min} max={max} step={step} value={value} onChange={onChange} /></div></label>

fn formatShaderControlValue(control: OverlayShaderControlDefinition, value: Float) -> Any:
    if (control.formatValue):
        return control.formatValue(value)
    if ((control.step >= 1)):
        return Math.round(value)
    let decimals: Any = (control.step.split(".")[1].length or 2)
    return value.toFixed(Math.min(decimals, 3))

component ShortcutField(bindingKey: Any, value: Any, onCommit: Any) with Reactive:
    state definition: Any = getHotkeyBindingDefinition(bindingKey)
    render <ShortcutEditorCard label={definition.label} description={definition.description} scopeLabel={definition.scope} value={value} defaultValue={definition.defaultValue} onCommit={onCommit} resetLabel="Reset" />

fn formatExplorerChromeSurfaceLabel(surfaceId: Any) -> String:
    if ((surfaceId == "explorerTopbar")):
        return "Top Bar"
    else if ((surfaceId == "explorerToolbar")):
        return "Toolbar"
    else if ((surfaceId == "workspaceHeader")):
        return "Workspace"
    else if ((surfaceId == "railHeader")):
        return "Sources Rail"
    else if ((surfaceId == "previewHeader")):
        return "Preview"
    else if ((surfaceId == "explorerStatusBar")):
        return "Status Bar"
    else:
        return surfaceId

component ShortcutEditorCard(label: Any, description: Any, scopeLabel: Any, value: Any, defaultValue: Any, onCommit: Any, resetLabel: Any) with Reactive:
    state draft: Any = value
    state showInlineDescriptions: Any = useSettingsRowDescriptionsVisible()
    fn setDraft(value: Any):
        draft = value

    fn __component_effect_5():
        setDraft(value)

    fn commit():
        let normalized: Any = normalizeKeybindingValue(draft, defaultValue)
        setDraft(normalized)
        onCommit(normalized)

    render <label className="rounded border p-3" style={none}><div className="flex items-start justify-between gap-3"><div className="min-w-0 flex-1"><div className="flex items-center gap-1.5"><div className="text-[10px] font-semibold uppercase tracking-[0.14em] opacity-70">{label}</div>{none}</div>{none}</div><span className="rounded border border-white/10 bg-white/[0.04] px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] opacity-80">{scopeLabel}</span></div><input value={draft} onChange={none} onBlur={commit} onKeyDown={none} className="mt-3 w-full rounded border px-3 py-2 text-[11px] outline-none" style={none} /><div className="mt-2 flex items-center justify-between gap-3 text-[10px] opacity-45"><span>{"Live value:"}{formatHotkeyLabel(value)}</span><button type="button" onClick={none} className="rounded border px-2 py-1 font-semibold uppercase tracking-[0.14em]" style={none}>{resetLabel}</button></div></label>

component CommandShortcutField(label: Any, description: Any, surfaces: Any, value: Any, onCommit: Any) with Reactive:
    state scopeLabel: Any = surfaces.map(none).join(none)
    render <ShortcutEditorCard label={label} description={description} scopeLabel={(scopeLabel or "Explorer")} value={value} defaultValue="" onCommit={onCommit} resetLabel="Clear" />

