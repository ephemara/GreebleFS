    return none

fn getVerticalDirectionSign(origin: Any) -> Any:
    return none

fn getOverlayAnimationTransition(args: Any) -> Any:
    if (((args.phase == "open") or (args.phase == "closed"))):
        return "none"
    let preset: Any = getOverlayAnimationPreset(args.presetId)
    let duration: Any = clampOverlayAnimationDuration(args.durationMs)
    let easing: Any = none
    return ["transform " + duration + "ms " + easing, "opacity " + duration + "ms " + easing, "filter " + duration + "ms " + easing].join(", ")

fn getOverlayAnimationStyle(args: Any) -> Any:
    let preset: Any = getOverlayAnimationPreset(args.presetId)
    let enterFrom: Any = scaleMotionShape(preset.enterFrom, args.intensity)
    let exitTo: Any = scaleMotionShape(preset.exitTo, args.intensity)
    let verticalDirectionSign: Any = getVerticalDirectionSign(args.verticalOrigin)
    let shape: Any = none
    return none

fn getOverlayEffectStyle(args: Any) -> Any:
    let preset: Any = getOverlayAnimationPreset(args.presetId)
    if ((preset.effect == "none")):
        return none
    let duration: Any = clampOverlayAnimationDuration(args.durationMs)
    let intensity: Any = clampOverlayAnimationIntensity(args.intensity)
    let active: Any = none
    let opacity: Any = none
    let lift: Any = ((12 * intensity) * getVerticalDirectionSign(args.verticalOrigin))
    if ((preset.effect == "dissolve")):
        return none
    if ((preset.effect == "burn")):
        return none
    return none

