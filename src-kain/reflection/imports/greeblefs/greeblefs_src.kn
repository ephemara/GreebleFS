const EXPLORER_GRID_ZOOM_MIN: Any = explorerZoomBehavior.gridAnchors["icons-s"]

const EXPLORER_GRID_ZOOM_MAX: Any = explorerZoomBehavior.gridAnchors["icons-xl"]

const EXPLORER_GRID_ZOOM_STEP: Any = 0.08

const EXPLORER_LAYOUT_ZOOM_SLIDER_STEP: Any = 0.02

const EXPLORER_LAYOUT_ZOOM_MIN: Any = explorerZoomBehavior.layoutDomain.minimumRowZoom

const EXPLORER_LIVE_GRID_ZOOM_MAX: Any = explorerZoomBehavior.layoutDomain.liveGridMaxZoom

const EXPLORER_LAYOUT_ZOOM_MAX: Any = EXPLORER_LIVE_GRID_ZOOM_MAX

const EXPLORER_LAYOUT_ZOOM_TABLE_ENTER: Any = explorerZoomBehavior.layoutDomain.gridToTableEnterZoom

const EXPLORER_LAYOUT_ZOOM_TABLE_EXIT: Any = explorerZoomBehavior.layoutDomain.tableToGridExitZoom

const EXPLORER_LAYOUT_ZOOM_LIST_ENTER: Any = explorerZoomBehavior.layoutDomain.tableToListEnterZoom

const EXPLORER_LAYOUT_ZOOM_LIST_EXIT: Any = explorerZoomBehavior.layoutDomain.listToTableExitZoom

const EXPLORER_LAYOUT_ZOOM_TABLE_MIDPOINT: Any = explorerZoomBehavior.layoutDomain.columnsDetailsMidpointZoom

const explorerViewModes: Any = [none, none, none, none, none, none, none]

const explorerViewModeMap: Any = ts_Map(explorerViewModes.map(none))

const defaultExplorerViewMode: ExplorerViewMode = "details"

const explorerGridModeAnchors: Any = explorerGridZoomAnchors

fn isExplorerViewMode(value: Any) -> Any:
    return ((value == "string") and explorerViewModeMap.has(value))

fn normalizeExplorerViewMode(value: Any) -> Any:
    if ((value == "grid")):
        return "icons-l"
    return none

fn getExplorerViewModeDefinition(mode: ExplorerViewMode) -> ExplorerViewModeDefinition:
    return (explorerViewModeMap.get(mode) or explorerViewModeMap.get(defaultExplorerViewMode))

fn isExplorerGridMode(mode: ExplorerViewMode) -> Any:
    return ((((mode == "icons-xl") or (mode == "icons-l")) or (mode == "icons-m")) or (mode == "icons-s"))

fn getExplorerGridZoomAnchor(mode: ExplorerViewMode) -> Float:
    let anchor: Any = explorerGridModeAnchors.find(none)
    return (anchor.zoom or explorerGridModeAnchors.find(none).zoom)

fn normalizeExplorerGridZoom(value: Any, fallbackMode: ExplorerViewMode) -> Any:
    let fallbackMode: Any = fallbackMode
    if (((value == "number") and ts_Number.isFinite(value))):
        return clamp(value, EXPLORER_GRID_ZOOM_MIN, EXPLORER_LIVE_GRID_ZOOM_MAX)
    return getExplorerGridZoomAnchor(fallbackMode)

fn normalizeExplorerLayoutZoom(value: Any) -> Any:
    if (((value == "number") and ts_Number.isFinite(value))):
        return clamp(value, EXPLORER_LAYOUT_ZOOM_MIN, EXPLORER_LAYOUT_ZOOM_MAX)
    return EXPLORER_GRID_ZOOM_MIN

fn stepExplorerGridZoom(currentZoom: Float, direction: ExplorerViewWheelDirection) -> Float:
    let delta: Any = none
    return normalizeExplorerGridZoom((currentZoom + delta))

fn getNearestExplorerGridMode(gridZoom: Float) -> String:
    let zoom: Any = normalizeExplorerGridZoom(gridZoom)
    let closest: Any = explorerGridModeAnchors[0]
    let closestDistance: Any = Math.abs((zoom - closest.zoom))
    for anchor in explorerGridModeAnchors.slice(1):
        let distance: Any = Math.abs((zoom - anchor.zoom))
        if ((distance < closestDistance)):
            closest = anchor
            closestDistance = distance
    return closest.id

fn getExplorerGridIconMetricsForMode(mode: ExplorerGridMode) -> Any:
    let metrics: Any = getExplorerViewModeDefinition(mode).grid
    return none

fn getExplorerGridVisualMetricsForZoom(gridZoom: Float) -> Any:
    let zoom: Any = normalizeExplorerGridZoom(gridZoom)
    if ((zoom > EXPLORER_GRID_ZOOM_MAX)):
        return getExplorerOversizedGridVisualMetrics(zoom)
    let lowerIndex: Any = 0
    let index: Any = 0
    while ((index < explorerGridModeAnchors.length)):
        if ((explorerGridModeAnchors[index].zoom <= zoom)):
            lowerIndex = index
        index = (index + 1)
    let upperIndex: Any = Math.min((explorerGridModeAnchors.length - 1), (lowerIndex + 1))
    let lowerAnchor: Any = explorerGridModeAnchors[lowerIndex]
    let upperAnchor: Any = explorerGridModeAnchors[upperIndex]
    let lowerMetrics: Any = getExplorerViewModeDefinition(lowerAnchor.id).grid
    let upperMetrics: Any = getExplorerViewModeDefinition(upperAnchor.id).grid
    let range: Any = (upperAnchor.zoom - lowerAnchor.zoom)
    let t: Any = resolveExplorerGridSegmentProgress(none)
    return none

fn getAdjacentExplorerGridMode(currentMode: ExplorerViewMode, direction: ExplorerViewWheelDirection) -> Any:
    if ((!isExplorerGridMode(currentMode))):
        return none
    let currentIndex: Any = explorerGridModeAnchors.findIndex(none)
    if ((currentIndex < 0)):
        return none
    if ((direction == "larger")):
        return explorerGridModeAnchors[Math.min((explorerGridModeAnchors.length - 1), (currentIndex + 1))].id
    return explorerGridModeAnchors[Math.max(0, (currentIndex - 1))].id

fn getExplorerGridLayoutMetricsForZoom(gridZoom: Float) -> Any:
    let zoom: Any = normalizeExplorerGridZoom(gridZoom)
    if ((zoom > EXPLORER_GRID_ZOOM_MAX)):
        return getExplorerOversizedGridLayoutMetrics(zoom)
    let lowerIndex: Any = 0
    let index: Any = 0
    while ((index < explorerGridModeAnchors.length)):
        if ((explorerGridModeAnchors[index].zoom <= zoom)):
            lowerIndex = index
        index = (index + 1)
    let upperIndex: Any = Math.min((explorerGridModeAnchors.length - 1), (lowerIndex + 1))
    let lowerAnchor: Any = explorerGridModeAnchors[lowerIndex]
    let upperAnchor: Any = explorerGridModeAnchors[upperIndex]
    let lowerMetrics: Any = getExplorerViewModeDefinition(lowerAnchor.id).grid
    let upperMetrics: Any = getExplorerViewModeDefinition(upperAnchor.id).grid
    let range: Any = (upperAnchor.zoom - lowerAnchor.zoom)
    let t: Any = resolveExplorerGridSegmentProgress(none)
    return none

fn getExplorerGridMetricsForZoom(gridZoom: Float) -> Any:
    let layoutMetrics: Any = getExplorerGridLayoutMetricsForZoom(gridZoom)
    let iconMetrics: Any = getExplorerGridVisualMetricsForZoom(gridZoom)
    return none

fn createExplorerLayoutZoomState(viewMode: ExplorerViewMode, gridZoom: Float) -> Any:
    let normalizedGridZoom: Any = normalizeExplorerGridZoom(gridZoom, viewMode)
    if (isExplorerGridMode(viewMode)):
        return none
    if (((viewMode == "columns") or (viewMode == "details"))):
        let columnsAnchor: Any = (((EXPLORER_LAYOUT_ZOOM_LIST_ENTER + EXPLORER_LAYOUT_ZOOM_TABLE_MIDPOINT)) / 2)
        let detailsAnchor: Any = (((EXPLORER_LAYOUT_ZOOM_TABLE_MIDPOINT + EXPLORER_LAYOUT_ZOOM_TABLE_EXIT)) / 2)
        return none
    return none

fn adjustExplorerLayoutZoomState(state_: ExplorerLayoutZoomState, delta: Float) -> ExplorerLayoutZoomState:
    return resolveExplorerLayoutZoomStateAtValue(state_, (state_.layoutZoom + delta))

fn adjustExplorerLayoutZoomStateForWheelDelta(state_: ExplorerLayoutZoomState, delta: Float) -> Any:
    let projectedLayoutZoom: Any = (state_.layoutZoom + delta)
    let touchesRowDomain: Any = ((state_.layoutZoom < EXPLORER_GRID_ZOOM_MIN) or (projectedLayoutZoom < EXPLORER_GRID_ZOOM_MIN))
    let rowDetentMinimumDelta: Any = (explorerZoomBehavior.wheel.maxPerEventZoomDelta / Math.max(1, explorerZoomBehavior.wheel.rowModeZoomMultiplier))
    let shouldUseRowDetent: Any = (touchesRowDomain and (Math.abs(delta) >= rowDetentMinimumDelta))
    if (shouldUseRowDetent):
        if ((((state_.family == "grid") and (delta < 0)) and (projectedLayoutZoom <= EXPLORER_LAYOUT_ZOOM_TABLE_ENTER))):
            return createExplorerLayoutZoomStateForWheelStep("list", state_)
        if ((state_.family != "grid")):
            let resolvedState: Any = resolveExplorerLayoutZoomState(state_)
            let direction: Any = none
            return createExplorerLayoutZoomStateForWheelStep(stepExplorerViewMode(resolvedState.viewMode, direction), state_)
    return resolveExplorerLayoutZoomStateAtValue(state_, projectedLayoutZoom)

fn createExplorerLayoutZoomStateForWheelStep(viewMode: ExplorerViewMode, previousState: ExplorerLayoutZoomState) -> ExplorerLayoutZoomState:
    let gridZoom: Any = none
    return createExplorerLayoutZoomState(viewMode, gridZoom)

fn resolveExplorerLayoutZoomStateAtValue(state_: ExplorerLayoutZoomState, layoutZoom: Float) -> Any:
    let nextLayoutZoom: Any = normalizeExplorerLayoutZoom(layoutZoom)
    let nextStoredGridZoom: Any = none
    let nextFamily: Any = resolveExplorerLayoutZoomFamily(nextLayoutZoom, state_.family)
    return none

fn resolveExplorerLayoutZoomState(state_: ExplorerLayoutZoomState) -> Any:
    if ((state_.family == "list")):
        let definition: Any = getExplorerViewModeDefinition("list")
        return none
    if ((state_.family == "table")):
        let viewMode: Option<Any> = none
        let definition: Any = getExplorerViewModeDefinition(viewMode)
        return none
    let resolvedGridZoom: Any = normalizeExplorerGridZoom(Math.max(EXPLORER_GRID_ZOOM_MIN, state_.layoutZoom), "icons-l")
    let viewMode: Any = getNearestExplorerGridMode(resolvedGridZoom)
    return none

fn commitExplorerLayoutZoomState(state_: ExplorerLayoutZoomState) -> Any:
    if ((state_.family == "list")):
        return none
    if ((state_.family == "table")):
        let viewMode: Option<Any> = none
        return none
    let resolvedGridZoom: Any = normalizeExplorerGridZoom(Math.max(EXPLORER_GRID_ZOOM_MIN, state_.layoutZoom), "icons-l")
    return none

fn getExplorerGridZoomPercent(gridZoom: Float) -> Float:
    return Math.round((normalizeExplorerGridZoom(gridZoom) * 100))

fn stepExplorerViewMode(currentMode: ExplorerViewMode, direction: ExplorerViewWheelDirection) -> Any:
    let currentIndex: Any = explorerViewModes.findIndex(none)
    if ((currentIndex < 0)):
        return defaultExplorerViewMode
    if ((direction == "larger")):
        return explorerViewModes[Math.max(0, (currentIndex - 1))].id
    return explorerViewModes[Math.min((explorerViewModes.length - 1), (currentIndex + 1))].id

fn resolveEffectiveExplorerViewMode(requestedMode: ExplorerViewMode, options: Any) -> Any:
    if (options.isCompactDock):
        return "list"
    let definition: Any = getExplorerViewModeDefinition(requestedMode)
    if ((options.isSearchActive and (definition.presentation == "grid"))):
        return "details"
    return requestedMode

fn resolveThemedExplorerViewModes(options: ResolveThemedExplorerViewModesOptions) -> Any:
    return none

fn clamp(value: Float, min: Float, max: Float) -> Float:
    return Math.min(max, Math.max(min, value))

fn lerp(start: Float, end: Float, t: Float) -> Float:
    return (start + (((end - start)) * t))

fn getExplorerOversizedGridLayoutMetrics(gridZoom: Float) -> Any:
    let baseMetrics: Any = getExplorerViewModeDefinition("icons-xl").grid
    let oversizeProgress: Any = clamp((((gridZoom - EXPLORER_GRID_ZOOM_MAX)) / ((EXPLORER_LIVE_GRID_ZOOM_MAX - EXPLORER_GRID_ZOOM_MAX))), 0, 1)
    let easedProgress: Any = resolveExplorerOversizeProgress(oversizeProgress)
    let tileScale: Any = lerp(1, explorerZoomBehavior.oversize.tileScaleMax, easedProgress)
    let rowScale: Any = lerp(1, explorerZoomBehavior.oversize.rowScaleMax, easedProgress)
    let spacingScale: Any = lerp(1, explorerZoomBehavior.oversize.spacingScaleMax, easedProgress)
    return none

fn getExplorerOversizedGridVisualMetrics(gridZoom: Float) -> Any:
    let baseMetrics: Any = getExplorerViewModeDefinition("icons-xl").grid
    let oversizeProgress: Any = clamp((((gridZoom - EXPLORER_GRID_ZOOM_MAX)) / ((EXPLORER_LIVE_GRID_ZOOM_MAX - EXPLORER_GRID_ZOOM_MAX))), 0, 1)
    let easedProgress: Any = resolveExplorerOversizeProgress(oversizeProgress)
    let iconScale: Any = lerp(1, explorerZoomBehavior.oversize.rowScaleMax, easedProgress)
    return none

fn resolveExplorerLayoutZoomFamily(layoutZoom: Float, previousFamily: ExplorerLayoutZoomFamily) -> Any:
    if ((previousFamily == "list")):
        if ((layoutZoom >= EXPLORER_LAYOUT_ZOOM_TABLE_EXIT)):
            return "grid"
        if ((layoutZoom >= EXPLORER_LAYOUT_ZOOM_LIST_EXIT)):
            return "table"
        return "list"
    if ((previousFamily == "table")):
        if ((layoutZoom >= EXPLORER_LAYOUT_ZOOM_TABLE_EXIT)):
            return "grid"
        if ((layoutZoom <= EXPLORER_LAYOUT_ZOOM_LIST_ENTER)):
            return "list"
        return "table"
    if ((layoutZoom <= EXPLORER_LAYOUT_ZOOM_LIST_ENTER)):
        return "list"
    if ((layoutZoom <= EXPLORER_LAYOUT_ZOOM_TABLE_ENTER)):
        return "table"
    return "grid"

