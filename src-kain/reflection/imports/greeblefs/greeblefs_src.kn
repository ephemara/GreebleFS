type ManagedAccelerationRuntimeRequest = AccelerationRuntimeRequest

type ManagedAccelerationRuntimeStatusSnapshot = AccelerationRuntimeStatusSnapshot

fn isAccelerationRuntimeStatusSnapshot(value: Any) -> Any:
    if (((!value) or (value != "object"))):
        return false
    let candidate: Any = value
    return ((((ts_Array.isArray(candidate.providers) and (candidate.nativeGpu != none)) and (candidate.nativeGpu == "object")) and (candidate.routingMode == "string")) and (candidate.pythonProbeAttempted == "boolean"))

fn getAccelerationRuntimeStatus(request: ManagedAccelerationRuntimeRequest) -> impl Async_<ManagedAccelerationRuntimeStatusSnapshot>:
    let snapshot: Any = unwrapTauriResult((await commands.accelerationRuntimeGetStatus(request)))
    if ((!isAccelerationRuntimeStatusSnapshot(snapshot))):
        ()
    return snapshot

