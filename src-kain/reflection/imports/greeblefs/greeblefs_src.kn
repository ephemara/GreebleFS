fn clamp(v: Float, lo: Float, hi: Float) -> Float:
    return Math.min(Math.max(v, lo), hi)

fn formatTimecode(secs: Float) -> Any:
    if (((!ts_Number.isFinite(secs)) or (secs < 0))):
        return "00:00:00:00"
    let h: Any = Math.floor((secs / 3600))
    let m: Any = Math.floor((((secs % 3600)) / 60))
    let s: Any = Math.floor((secs % 60))
    let f: Any = Math.floor((((secs % 1)) * 30))
    return [h, m, s, f].map(none).join(":")

fn formatSize(bytes: Float) -> Any:
    if ((bytes < 1024)):
        return bytes + " B"
    if ((bytes < (1024 ** 2))):
        return ((bytes / 1024)).toFixed(1) + " KB"
    if ((bytes < (1024 ** 3))):
        return ((bytes / (1024 ** 2))).toFixed(1) + " MB"
    return ((bytes / (1024 ** 3))).toFixed(2) + " GB"

