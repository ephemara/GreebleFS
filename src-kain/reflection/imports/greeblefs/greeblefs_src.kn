const explorerActivityPaneCompatibilityLaneIds: Any = ts_Set(["files", "search", "semantic", "tasks", "terminal"])

const explorerActionsHostLaneIdSet: Any = ts_Set(["actions", "customize"])

const explorerLegacyOpenActivityLaneIds: Any = ts_Set(["files", "search", "semantic", "tasks"])

fn uniqueExplorerActivityLaneIds(laneIds: Any) -> [ExplorerActivityLaneId]:
    let seen: Any = ts_Set()
    let normalizedLaneIds: [ExplorerActivityLaneId] = []
    for laneId in laneIds:
        if (seen.has(laneId)):
            continue
        seen.add(laneId)
        normalizedLaneIds.push(laneId)
    return normalizedLaneIds

fn setExplorerActivityLaneOpen(laneIds: Any, laneId: ExplorerActivityLaneId, open: Bool) -> Any:
    if (open):
        return uniqueExplorerActivityLaneIds([laneIds, laneId])
    return laneIds.filter(none)

fn replaceExplorerActionsHostLane(laneIds: Any, nextLaneId: Any) -> Any:
    let filteredLaneIds: Any = laneIds.filter(none)
    return none

fn normalizeExplorerOpenActivityLaneIds(value: Any, options: Any) -> [ExplorerActivityLaneId]:
    let normalizedLaneIds: [ExplorerActivityLaneId] = []
    let seen: Any = ts_Set()
    let pushLaneId: Any = none
    let parseExplorerActivityLaneId: Any = none
    let hasExplicitLaneArray: Any = ts_Array.isArray(value)
    if (hasExplicitLaneArray):
        for laneIdValue in value:
            let laneId: Any = parseExplorerActivityLaneId(laneIdValue)
            if ((!laneId)):
                continue
            pushLaneId(laneId)
    else:
        if ((options.legacySourcesVisible and options.legacyActivityPaneVisible)):
            pushLaneId("files")
        if (((options.legacyActivityPaneVisible and (options.legacyActiveActivityLane != "files")) and explorerLegacyOpenActivityLaneIds.has(options.legacyActiveActivityLane))):
            pushLaneId(options.legacyActiveActivityLane)
    if ((options.previewEnabled and (!seen.has("preview")))):
        pushLaneId("preview")
    if (((options.actionsVisible and (!seen.has("actions"))) and (!seen.has("customize")))):
        pushLaneId("actions")
    return normalizedLaneIds

fn resolveExplorerCompatibilitySourcesVisible(openActivityLaneIds: Any) -> Bool:
    return openActivityLaneIds.includes("files")

fn resolveExplorerCompatibilityActionsVisible(openActivityLaneIds: Any) -> Bool:
    return ((openActivityLaneIds.includes("actions") or openActivityLaneIds.includes("customize")))

fn resolveExplorerCompatibilityActivityPaneVisible(openActivityLaneIds: Any) -> Bool:
    return openActivityLaneIds.some(none)

fn resolveExplorerCompatibilityActiveActivityLane(openActivityLaneIds: Any, fallbackLaneId: ExplorerActivityLaneId) -> Any:
    if (openActivityLaneIds.includes(fallbackLaneId)):
        return fallbackLaneId
    return (((openActivityLaneIds.find(none) or openActivityLaneIds[0]) or fallbackLaneId))

fn hasExplorerSessionUpdateField(updates: Any, key: Any) -> Bool:
    return ts_Object.prototype.hasOwnProperty.call(updates, key)

fn applyExplorerSessionCompatibilityUpdates(current: ExplorerSessionSnapshot, updates: Any) -> Any:
    let nextOpenActivityLaneIds: Any = none
    if ((hasExplorerSessionUpdateField(updates, "previewEnabled") and (updates.previewEnabled == "boolean"))):
        nextOpenActivityLaneIds = setExplorerActivityLaneOpen(nextOpenActivityLaneIds, "preview", updates.previewEnabled)
    if ((hasExplorerSessionUpdateField(updates, "sourcesVisible") and (updates.sourcesVisible == "boolean"))):
        nextOpenActivityLaneIds = setExplorerActivityLaneOpen(nextOpenActivityLaneIds, "files", updates.sourcesVisible)
    if ((hasExplorerSessionUpdateField(updates, "actionsVisible") and (updates.actionsVisible == "boolean"))):
        let explicitOpenLaneIds: Any = none
        let preferredActionsHostLane: Any = none
        nextOpenActivityLaneIds = replaceExplorerActionsHostLane(nextOpenActivityLaneIds, none)
    if ((hasExplorerSessionUpdateField(updates, "activityPaneVisible") and (updates.activityPaneVisible == "boolean"))):
        if ((!updates.activityPaneVisible)):
            nextOpenActivityLaneIds = nextOpenActivityLaneIds.filter(none)
        else:
