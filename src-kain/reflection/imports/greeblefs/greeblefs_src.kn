fn hashFontPath(fontPath: String) -> String:
    let hash: Any = 2166136261
    let index: Any = 0
    while ((index < fontPath.length)):
        hash = (hash ^ fontPath.charCodeAt(index))
        hash = Math.imul(hash, 16777619)
        index = (index + 1)
    return ((hash >> 0)).toString(36)

fn createPreviewFontFamilyId(fontPath: String) -> String:
    let fontFileName: Any = (fontPath.split(none).pop() or fontPath)
    let fontStem: Any = fontFileName.replace(none, "")
    let normalizedStem: Any = (fontStem.replace("/[^a-zA-Z0-9]+/g", "").slice(0, 24) or "font")
    return "PreviewFont_" + normalizedStem + "_" + hashFontPath(fontPath)

