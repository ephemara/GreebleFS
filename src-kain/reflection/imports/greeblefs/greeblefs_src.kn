    activePanelListDragSession = none
    emitPanelListDragSnapshot()

fn applyPanelListDragBodyState() -> Any:
    if ((document == "undefined")):
        return none
    let body: Any = document.body
    if ((!body)):
        return none
    if ((savedBodyUserSelect == none)):
        savedBodyUserSelect = body.style.userSelect
    if ((savedBodyCursor == none)):
        savedBodyCursor = body.style.cursor
    body.style.userSelect = "none"
    body.style.cursor = "grabbing"

fn restorePanelListDragBodyState() -> Any:
    if ((document == "undefined")):
        savedBodyUserSelect = none
        savedBodyCursor = none
        return none
    let body: Any = document.body
    if ((!body)):
        savedBodyUserSelect = none
        savedBodyCursor = none
        return none
    if ((savedBodyUserSelect != none)):
        body.style.userSelect = savedBodyUserSelect
    else:
        body.style.removeProperty("user-select")
    if ((savedBodyCursor != none)):
        body.style.cursor = savedBodyCursor
    else:
        body.style.removeProperty("cursor")
    savedBodyUserSelect = none
    savedBodyCursor = none

fn resolvePanelListDropTargetFromPoint(point: PanelPointerPoint) -> Any:
    if ((document == "undefined")):
        return none
    let hoveredElement: Any = document.elementFromPoint(point.x, point.y)
    if ((!(ts_instanceof_operator(hoveredElement, Element)))):
        return none
    let explicitDropZone: Any = hoveredElement.closest("[data-draggable-panel-drop-zone-list-id]")
    if (explicitDropZone):
