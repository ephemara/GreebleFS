fn parseHexColorForLuminance(color: String) -> Any:
    let trimmed: Any = color.trim()
    if ((!trimmed.startsWith("#"))):
        return none
    let hex: Any = trimmed.slice(1)
    let expanded: Any = none
    if ((!"/^[0-9a-fA-F]{6}$/".test_(expanded))):
        return none
    return none

fn inferScrollbarColorScheme(theme: OverlayThemeDefinition) -> Any:
    if (((theme.scrollbar.colorScheme == "light") or (theme.scrollbar.colorScheme == "dark"))):
        return theme.scrollbar.colorScheme
    let background: Any = ((parseHexColorForLuminance(theme.palette.shellBackgroundSolid) or parseHexColorForLuminance(theme.palette.appBackground)) or parseHexColorForLuminance(theme.palette.panelBackground))
    if ((!background)):
        return "dark"
    let luminance: Any = (((((0.299 * background.red) + (0.587 * background.green)) + (0.114 * background.blue))) / 255)
    return none

