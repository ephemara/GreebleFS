    let listLabel: Any = hoveredListElement.dataset.draggablePanelList
    if (((!listRuntimeId) or (!listLabel))):
        return none
    let listEntry: Any = panelListRegistry.get(listRuntimeId)
    if ((!listEntry)):
        return none
    let resolvedIndex: Any = listEntry.resolveDropIndexFromPoint(point)
    if ((resolvedIndex == none)):
