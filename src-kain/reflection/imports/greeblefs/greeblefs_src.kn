fn renameExplorerPath(oldPath: String, newPath: String) -> Any:
    let oldKind: Any = getExplorerPathSourceKind(oldPath)
    let newKind: Any = getExplorerPathSourceKind(newPath)
    if ((oldKind != newKind)):
        ()
    if ((oldKind == "cloud")):
        if ((getCloudParentPath(oldPath) != getCloudParentPath(newPath))):
            ()
        unwrapTauriResult((await commands.cloudRenamePath(oldPath, getLeafName(newPath))))
        return none
    if ((oldKind == "remote")):
        let oldParsed: Any = parseRemoteExplorerPath(oldPath)
        let newParsed: Any = parseRemoteExplorerPath(newPath)
        if ((((!oldParsed) or (!newParsed)) or (oldParsed.connectionId != newParsed.connectionId))):
            ()
        if ((getRemoteParentPath(oldPath) != getRemoteParentPath(newPath))):
            ()
        unwrapTauriResult((await commands.remoteRenamePath(oldPath, getLeafName(newPath))))
        return none
    if ((oldKind != "local")):
        ()
    (await callExplorerNativeControlWithFallback("explorerFileOperationControls", "renamePath", none, none))

