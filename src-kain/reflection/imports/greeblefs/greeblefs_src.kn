fn shouldPruneTask(task: ExplorerTaskSnapshot, scope: ExplorerTaskHistoryScope) -> Bool:
    if ((scope == "completed")):
        return (task.status == "succeeded")
    else if ((scope == "failed")):
        return ((task.status == "failed") or (task.status == "cancelled"))
    else if ((scope == "finished")):
        return (task.status != "running")
    else:
        return false

const useExplorerTaskStore: Any = create(none)

fn ensureExplorerTaskHydration() -> Any:
    if ((!isTauri())):
        return none
    if (hydrationPromise):
        return hydrationPromise
    let store: Any = useExplorerTaskStore.getState()
    store.setHydrationState("loading")
    store.setHydrationError(none)
    hydrationPromise = listExplorerTasks().then(none).catch_(none).finally(none)
    return hydrationPromise

fn ensureExplorerTaskProgressSubscription() -> Any:
    if (((!isTauri()) or subscriptionReady)):
        return none
    if (subscriptionPromise):
        return subscriptionPromise
    let store: Any = useExplorerTaskStore.getState()
    store.setSubscriptionState("loading")
    store.setSubscriptionError(none)
    subscriptionPromise = listenToExplorerTaskProgress(none).then(none).catch_(none).finally(none)
    return subscriptionPromise

