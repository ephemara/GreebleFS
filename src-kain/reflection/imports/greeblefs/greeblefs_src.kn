fn normalizeExplorerLayoutSelectionState(value: Any, fallback: ExplorerLayoutSelectionState) -> Any:
    if ((((!value) or (value != "object")) or ts_Array.isArray(value))):
        return none
    let source: Any = value
    let hasExplicitFollowThemeExplorerLayout: Any = ts_Object.prototype.hasOwnProperty.call(source, "followThemeExplorerLayout")
    let hasExplicitActiveExplorerLayoutId: Any = ts_Object.prototype.hasOwnProperty.call(source, "activeExplorerLayoutId")
    return none

fn normalizeExplorerLayoutSelectionByPresentationMode(value: Any, fallback: ExplorerLayoutSelectionByPresentationMode) -> Any:
    let source: Any = none
    let dockSelectionSource: Any = (source.dock or source.overlay)
    return none

fn resolveExplorerLayoutSelectionFallback(explorer: ExplorerSettings) -> ExplorerLayoutSelectionByPresentationMode:
    let legacySelection: Any = createExplorerLayoutSelectionState(explorer.followThemeExplorerLayout, explorer.activeExplorerLayoutId)
    return normalizeExplorerLayoutSelectionByPresentationMode(explorer.layoutSelectionByPresentationMode, none)

fn buildExplorerLayoutSelectionByPresentationModeUpdate(explorer: ExplorerSettings, presentationMode: Any, selectionUpdates: Any) -> Any:
    let targetPresentationMode: Any = (presentationMode or "windowed")
    let baseSelections: Any = resolveExplorerLayoutSelectionFallback(explorer)
    let currentSelection: Any = baseSelections[targetPresentationMode]
    let nextSelection: Any = normalizeExplorerLayoutSelectionState(none, currentSelection)
    let nextSelections: Any = none
    return none

