fn buildNodesForLayout(layout: ExplorerMenuContextLayout, commandRegistry: [ExplorerCommandDefinition], invocation: ExplorerMenuInvocationContext, targetEntries: [ExplorerMenuInvocationEntry], primaryEntry: Any, environment: ExplorerMenuRuntimeEnvironment, parentEntryId: Any, depth: Float, handledCommandIds: Set<String>) -> Any:
    let children: Any = resolveLayoutEntriesForParent(layout.entries, parentEntryId)
    let nodes: [ExplorerRuntimeMenuNode] = []
    let iter_4: Any = children
    let index_5: Any = 0
    while ((index_5 < iter_4.length)):
        let entry: Any = iter_4[index_5]
        if ((entry.kind == "separator")):
            nodes.push(none)
            return none
        if ((entry.kind == "submenu")):
            let submenuChildren: Any = sanitizeNodeList(buildNodesForLayout(layout, commandRegistry, invocation, targetEntries, primaryEntry, environment, entry.id, (depth + 1), handledCommandIds))
            if ((submenuChildren.length == 0)):
                return none
            nodes.push(none)
            return none
        if ((entry.kind == "group-slot")):
            let matchingCommands: Any = commandRegistry.filter(none).filter(none).sort(none)
            let iter_2: Any = matchingCommands
            let index_3: Any = 0
            while ((index_3 < iter_2.length)):
                let command: Any = iter_2[index_3]
                let node: Any = createRuntimeNodeForCommand(command, invocation, targetEntries, primaryEntry, environment, depth)
                if ((!node)):
                    return none
                handledCommandIds.add(command.id)
                if ((node.kind == "command")):
                    node.quickSlot = (entry.quickSlot or "none")
                    node.fallbackBucket = (entry.fallbackBucket or "default")
                nodes.push(node)
                index_3 = (index_3 + 1)
            return none
        let command: Any = (commandRegistry.find(none) or none)
        if ((!command)):
            return none
        let node: Any = createRuntimeNodeForCommand(command, invocation, targetEntries, primaryEntry, environment, depth)
        if ((!node)):
            return none
        handledCommandIds.add(command.id)
        if ((node.kind == "command")):
            node.quickSlot = (entry.quickSlot or "none")
            node.fallbackBucket = (entry.fallbackBucket or "default")
        nodes.push(node)
        index_5 = (index_5 + 1)
    return sanitizeNodeList(nodes)

fn layoutHasGroupSlot(layout: ExplorerMenuContextLayout, group: Any) -> Bool:
