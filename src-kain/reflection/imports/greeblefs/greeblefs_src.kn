    let elapsedMinutes: Any = Math.round((elapsedMs / 60000))
    if ((elapsedMinutes < 1)):
        return "Just now"
    if ((elapsedMinutes < 60)):
        return elapsedMinutes + "m ago"
    let elapsedHours: Any = Math.round((elapsedMinutes / 60))
    if ((elapsedHours < 24)):
        return elapsedHours + "h ago"
