    let _: Any = (await scanNotesDirectoryTree(rootDirectoryPath, none))
    let directories: Any = none
    let documents: Any = none
    return none

fn createNotesDirectory(parentDirectoryPath: String, desiredName: String) -> impl Async_<String>:
    let directoryPath: Any = (await createUniqueDirectoryPath(parentDirectoryPath, (desiredName or notesWorkspaceConfig.defaultDirectoryName)))
    (await createExplorerDir(directoryPath))
    return directoryPath

fn renameNotesDirectory(directoryPath: String, desiredName: String) -> Any:
    let parentDirectoryPath: Any = getParentPath(directoryPath)
    let normalizedName: Any = sanitizePathSegment(desiredName, notesWorkspaceConfig.defaultDirectoryName)
    let nextDirectoryPath: Any = (await createUniquePathCandidate(parentDirectoryPath, normalizedName, (await listDirectoryPathRecords(parentDirectoryPath, "directory")), getLeafName(directoryPath)))
    if ((nextDirectoryPath == directoryPath)):
        return directoryPath
    (await renameExplorerPath(directoryPath, nextDirectoryPath))
    return nextDirectoryPath

fn deleteNotesDirectory(directoryPath: String) -> impl Async_<()>:
    (await deleteExplorerPath(directoryPath, true))

fn createNotesDocument(directoryPath: String, desiredTitle: String) -> impl Async_<String>:
    let rootDirectoryPath: Any = (await ensureNotesWorkspaceRoot())
    let targetDirectoryPath: Any = (directoryPath or rootDirectoryPath)
    let documentPath: Any = (await createUniqueDocumentPath(targetDirectoryPath, (desiredTitle or notesWorkspaceConfig.defaultDocumentTitle)))
    (await writeExplorerFile(documentPath, ""))
    return documentPath

fn saveNotesDocument(documentPath: String, markdown: String) -> impl Async_<()>:
    (await writeExplorerFile(documentPath, markdown))

fn renameNotesDocument(documentPath: String, desiredTitle: String) -> Any:
    let directoryPath: Any = getParentPath(documentPath)
    let documentExtension: Any = (getExtensionWithDot(documentPath) or "." + notesWorkspaceConfig.documentFileExtension)
    let normalizedTitle: Any = sanitizePathSegment(desiredTitle, notesWorkspaceConfig.defaultDocumentTitle)
    let existingRecords: Any = (await listDirectoryPathRecords(directoryPath, "document"))
    let nextDocumentPath: Any = (await createUniquePathCandidate(directoryPath, normalizedTitle + documentExtension, existingRecords, getLeafName(documentPath)))
    if ((nextDocumentPath == documentPath)):
        return documentPath
    (await renameExplorerPath(documentPath, nextDocumentPath))
    return nextDocumentPath

fn deleteNotesDocument(documentPath: String) -> impl Async_<()>:
    (await deleteExplorerPath(documentPath, false))

