type BoundedWorkLaneOverflowStrategy = String

struct BoundedWorkLanePolicy:
    batchSize: Float
    maxConcurrentWork: Float
    maxCandidateQueueDepth: Float
    queueOverflowStrategy: BoundedWorkLaneOverflowStrategy
    cancelStaleBatches: Bool

struct BoundedWorkLaneCandidate:
    workKey: String
    priority: TPriority
    priorityRank: Float
    distanceFromFocus: Float
    sequence: Float

struct BoundedWorkLaneTelemetry:
    candidateCount: Float
    queuedCount: Float
    scheduledCount: Float
    completedCount: Float
    failedCount: Float
    droppedCount: Float
    coalescedCount: Float
    cancelled: Bool
    maxConcurrentWork: Float
    maxCandidateQueueDepth: Float
    queueOverflowStrategy: BoundedWorkLaneOverflowStrategy
    priorityCounts: Any

struct BoundedWorkLaneCandidateResult:
    candidate: TCandidate
    scheduledIndex: Float
    status: String
    value: Any
    error: Any

struct BoundedWorkLaneRunResult:
    queuedCandidates: [TCandidate]
    scheduledCandidates: [TCandidate]
    droppedCandidates: [TCandidate]
    results: [BoundedWorkLaneCandidateResult<TCandidate, TValue>]
    telemetry: BoundedWorkLaneTelemetry<TPriority>

struct RunBoundedWorkLaneInput:
    candidates: Any
    policy: BoundedWorkLanePolicy
    runCandidate: Any
    isStale: Any

struct NormalizedBoundedWorkQueue:
    queuedCandidates: [TCandidate]
    droppedCandidates: [TCandidate]
    coalescedCount: Float

fn runBoundedWorkLane(input: RunBoundedWorkLaneInput<TCandidate, TValue, TPriority>) -> Any:
    let queue: Any = normalizeBoundedWorkQueue(input.candidates, input.policy)
    let scheduledCandidates: Any = queue.queuedCandidates.slice(0, normalizePositiveInteger(input.policy.batchSize, 1))
    let maxConcurrentWork: Any = Math.max(1, Math.min(normalizePositiveInteger(input.policy.maxConcurrentWork, 1), (scheduledCandidates.length or 1)))
    let results: [BoundedWorkLaneCandidateResult<TCandidate, TValue>] = []
    let nextCandidateIndex: Any = 0
    let cancelled: Any = false
    let takeNextCandidate: Any = none
    let workers: Any = ts_Array.from(none, none)
    (await ts_Promise.all(workers))
    results.sort(none)
    let failedCount: Any = results.filter(none).length
    return none

fn normalizeBoundedWorkQueue(candidates: Any, policy: BoundedWorkLanePolicy) -> Any:
    let candidatesByKey: Any = ts_Map()
    let coalescedCount: Any = 0
    for candidate in candidates:
        let workKey: Any = candidate.workKey.trim()
        if ((!workKey)):
            continue
        let existing: Any = candidatesByKey.get(workKey)
        if ((!existing)):
            candidatesByKey.set(workKey, candidate)
            continue
        coalescedCount = (coalescedCount + 1)
        if ((compareBoundedWorkLaneCandidates(candidate, existing) < 0)):
            candidatesByKey.set(workKey, candidate)
    let coalescedCandidates: Any = [candidatesByKey.values()]
    let maxCandidateQueueDepth: Any = normalizePositiveInteger(policy.maxCandidateQueueDepth, 1)
    if ((coalescedCandidates.length <= maxCandidateQueueDepth)):
        return none
    let _: Any = applyOverflowStrategy(coalescedCandidates, maxCandidateQueueDepth, policy.queueOverflowStrategy)
    let queuedCandidates: Any = none
    let droppedCandidates: Any = none
    return none

fn applyOverflowStrategy(candidates: Any, maxCandidateQueueDepth: Float, strategy: BoundedWorkLaneOverflowStrategy) -> Any:
    if ((strategy == "drop-newest")):
        let orderedByArrival: Any = [candidates].sort(none)
        return none
    if ((strategy == "drop-oldest")):
        let orderedByArrival: Any = [candidates].sort(none)
        return none
    let orderedByPriority: Any = [candidates].sort(compareBoundedWorkLaneCandidates)
    return none

fn compareBoundedWorkLaneCandidates(left: TCandidate, right: TCandidate) -> Any:
    let priorityDelta: Any = (left.priorityRank - right.priorityRank)
    if ((priorityDelta != 0)):
        return priorityDelta
    let distanceDelta: Any = (left.distanceFromFocus - right.distanceFromFocus)
    if ((distanceDelta != 0)):
        return distanceDelta
    return (left.sequence - right.sequence)

fn createPriorityCounts(candidates: Any) -> Any:
    return candidates.reduce(none, none)

fn normalizePositiveInteger(value: Float, fallback: Float) -> Any:
    return none

