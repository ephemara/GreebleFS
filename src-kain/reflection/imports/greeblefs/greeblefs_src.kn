fn getThemeVisualAnimation(layer: Any) -> Any:
    if ((!layer.animation)):
        return undefined
    let durationMs: Any = none
    let easing: Any = (layer.animation.easing or "ease-in-out")
    let direction: Any = (layer.animation.direction or "alternate")
    return "overlay-theme-visual-" + layer.animation.kind + " " + durationMs + "ms " + easing + " infinite " + direction

