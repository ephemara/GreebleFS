fn main() -> Any:
    let lane = json_object_new()
    json_object_set(lane, "schemaVersion", 1)
    json_object_set(lane, "kind", "greeblefs.kain.ffi.lane")
    json_object_set(lane, "id", "python")
    json_object_set(lane, "label", "Python FFI")
    json_object_set(lane, "status", "analysis-live")
    json_object_set(lane, "hostRuntimeId", "greeblefs-python-sidecar")
    json_object_set(lane, "hostActionId", "kain.ffi.ui_inventory")
    json_object_set(lane, "catalogActionId", "kain.ffi.catalog")
    json_object_set(lane, "analysisRoot", "src-kain/ffi/python/analysis")
    json_object_set(lane, "bridgeSmoke", "src-kain/ffi/python/examples/ui_inventory_bridge/smoke.kn")
    json_object_set(lane, "bridgeExample", "src-kain/ffi/python/examples/ui_inventory_bridge/bridge_example.kn")
    json_object_set(lane, "summary", "Kain routes Python-heavy analysis and package work through std::python::bridge examples plus the existing managed GreebleFS Python sidecar.")
    return lane
