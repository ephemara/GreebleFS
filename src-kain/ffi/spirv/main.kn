fn main() -> Any:
    let lane = json_object_new()
    json_object_set(lane, "schemaVersion", 1)
    json_object_set(lane, "kind", "greeblefs.kain.ffi.lane")
    json_object_set(lane, "id", "spirv")
    json_object_set(lane, "label", "SPIR-V")
    json_object_set(lane, "status", "scaffold")
    json_object_set(lane, "summary", "Kain compiles shader and compute artifacts for GreebleFS GPU, preview, and lookdev consumers.")
    return lane
