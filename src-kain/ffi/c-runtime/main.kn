fn main() -> Any:
    let lane = json_object_new()
    json_object_set(lane, "schemaVersion", 1)
    json_object_set(lane, "kind", "greeblefs.kain.ffi.lane")
    json_object_set(lane, "id", "c-runtime")
    json_object_set(lane, "label", "C Runtime")
    json_object_set(lane, "status", "scaffold")
    json_object_set(lane, "summary", "Kain wraps C ABI, DLL, SDK, and legacy native-library work behind explicit trust boundaries.")
    return lane
