fn build_image_converter_tool() -> Any:
    let tool = json_object_new()
    let formats = json_array_new()
    let presets = json_array_new()
    let backends = json_array_new()
    let ui = json_object_new()

    append_item(formats, image_converter_format("png", "PNG", ".png", "image/png", "Pillow PNG"))
    append_item(formats, image_converter_format("jpg", "JPG", ".jpg", "image/jpeg", "Pillow JPEG"))
    append_item(formats, image_converter_format("webp", "WebP", ".webp", "image/webp", "Pillow WebP"))
    append_item(formats, image_converter_format("bmp", "BMP", ".bmp", "image/bmp", "Pillow BMP"))
    append_item(formats, image_converter_format("tiff", "TIFF", ".tiff", "image/tiff", "Pillow TIFF"))
    append_item(formats, image_converter_format("gif", "GIF", ".gif", "image/gif", "Pillow GIF"))
    append_item(formats, image_converter_format("ico", "ICO", ".ico", "image/x-icon", "Pillow ICO"))
    append_item(formats, image_converter_format("svg", "SVG", ".svg", "image/svg+xml", "Kain SVG embed"))
    append_item(formats, image_converter_format("pdf", "PDF", ".pdf", "application/pdf", "Pillow PDF"))

    append_item(presets, image_converter_resize_preset("icon-256", "256", 256, 256, "contain"))
    append_item(presets, image_converter_resize_preset("preview-1024", "1024", 1024, 1024, "contain"))
    append_item(presets, image_converter_resize_preset("wallpaper-4k", "4K", 3840, 2160, "cover"))
    append_item(presets, image_converter_resize_preset("wide-1920", "FHD", 1920, 1080, "cover"))
    append_item(presets, image_converter_resize_preset("thumb-512", "512", 512, 512, "scale-down"))

    append_item(backends, image_converter_backend("python-pillow", "Python Pillow", "python", "primary inspect, resize, convert, ICO, SVG embed", "live", true, string_array_2("pillow", "numpy"), "src-python/greeblefs_sidecar/image_converter_runtime.py"))
    append_item(backends, image_converter_backend("node-sharp-svgo", "Node Sharp/SVGO", "node", "future npm-native optimization lane", "declared", false, string_array_2("sharp", "svgo"), "usr/plugins-kain/kain-image-converter/plugin.runtime/node/image_converter_node_bridge.kn"))
    append_item(backends, image_converter_backend("cargo-image-resvg", "Cargo image/resvg", "cargo-ffi", "compiled plugin-owned native helper lane", "compiled-helper", false, string_array_3("image", "resvg", "ico"), "usr/plugins-kain/kain-image-converter/plugin.runtime/cargo/greeblefs-kain-image-tools"))
    append_item(backends, image_converter_backend("c-runtime-codecs", "C Runtime Codecs", "c-runtime", "future SDK/DLL codec lane", "available-in-kain", false, string_array_2("stb_image", "native-codecs"), "usr/plugins-kain/kain-image-converter/plugin.runtime/c-runtime/image_converter_c_runtime_bridge.kn"))
    append_item(backends, image_converter_backend("wasm-preview-worker", "WASM Preview Worker", "wasm", "future portable preview worker", "declared", false, string_array_2("wasm32", "kain"), "usr/plugins-kain/kain-image-converter/plugin.runtime/wasm/image_converter_preview_worker.kn"))

    json_object_set(ui, "density", "compact")
    json_object_set(ui, "layout", "converter-grid")

    json_object_set(tool, "id", "kain-image-converter.tool")
    json_object_set(tool, "kind", "image-converter")
    json_object_set(tool, "label", "Kain Image Converter")
    json_object_set(tool, "summary", "Kain-authored image conversion workbench with Python FFI live and Node/Cargo/C/WASM lanes declared.")
    json_object_set(tool, "primaryActionId", "kain.image.convert")
    json_object_set(tool, "defaultOutputFormat", "png")
    json_object_set(tool, "supportedInputExtensions", image_extensions())
    json_object_set(tool, "resizeModes", string_array_4("contain", "cover", "stretch", "scale-down"))
    json_object_set(tool, "formats", formats)
    json_object_set(tool, "resizePresets", presets)
    json_object_set(tool, "pipelineBackends", backends)
    json_object_set(tool, "ui", ui)
    return tool

