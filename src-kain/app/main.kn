    json_object_set(config_schema, "shape", "KCM-style settings module with cfg_ compatible state planned.")
    json_object_set(config_schema, "status", "reference")

    json_object_set(package_node, "id", "greeblefs.lattice.shell-control")
    json_object_set(package_node, "kind", "shell-package")
    json_object_set(package_node, "title", "Shell Control")
    json_object_set(package_node, "summary", "First Kain Lattice reference package for QML-like Settings and applet authoring.")
    json_object_set(package_node, "packagePath", "src-kain/lattice/greeblefs-shell-control")
    json_object_set(package_node, "entry", "src-kain/lattice/greeblefs-shell-control/main.kn")
    json_object_set(package_node, "metadata", "src-kain/lattice/greeblefs-shell-control/lattice.toml")
