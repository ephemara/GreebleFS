fn build_image_converter_fabric_pipelines() -> Array<Any>:
    let pipelines = json_array_new()
    let pipeline = json_object_new()
    let steps = json_array_new()
    let outputs = json_array_new()
    append_item(outputs, image_converter_fabric_output("settings", "value"))
    append_item(steps, image_converter_fabric_step("python_source", "Python Source", "python", "plugin.runtime/fabric/scripts/python_step.py", "declared", "Python/Numpy/Pillow lane can gather source metadata and prepare image settings.", json_array_new(), string_array_2("runtime.python", "contract.value"), outputs))
    let kain_outputs = json_array_new()
    append_item(kain_outputs, image_converter_fabric_output("image", "shared-image"))
    append_item(kain_outputs, image_converter_fabric_output("report", "value"))
    append_item(steps, image_converter_fabric_step("kain_orchestrator", "Kain Orchestrator", "kain", "plugin.runtime/fabric/src/main.kn", "declared", "Kain owns the typed conversion intent and neutral shared image contract.", string_array_1("python_source"), string_array_2("runtime.kain", "contract.shared-image"), kain_outputs))
    let c_outputs = json_array_new()
    append_item(c_outputs, image_converter_fabric_output("filtered_image", "shared-image"))
    append_item(c_outputs, image_converter_fabric_output("snapshot", "shared-buffer"))
    append_item(steps, image_converter_fabric_step("native_filter", "C ABI Filter", "c_abi", "plugin.runtime/fabric/src/native_step.kn", "declared", "C/DLL lane can mutate shared image bytes through Kain C runtime bridges.", string_array_1("kain_orchestrator"), string_array_2("runtime.c-abi", "contract.shared-buffer"), c_outputs))
    let cargo_outputs = json_array_new()
    append_item(cargo_outputs, image_converter_fabric_output("analysis", "value"))
    append_item(steps, image_converter_fabric_step("rust_analyzer", "Cargo Analyzer", "rust_crate", "plugin.runtime/fabric/src/rust_step.kn", "compiled-helper", "Plugin-owned Cargo helper can score outputs and expose crate FFI utilities.", string_array_2("native_filter", "kain_orchestrator"), string_array_2("runtime.rust-crate", "contract.value"), cargo_outputs))
    let node_outputs = json_array_new()
    append_item(node_outputs, image_converter_fabric_output("summary", "value"))
    append_item(node_outputs, image_converter_fabric_output("input_keys", "value"))
    append_item(steps, image_converter_fabric_step("node_packager", "Node Packager", "node", "plugin.runtime/fabric/scripts/node_step.mjs", "declared", "Node FFI lane can package previews, HTML reports, and npm-native optimizations.", string_array_2("kain_orchestrator", "rust_analyzer"), string_array_2("runtime.node", "contract.value"), node_outputs))
    json_object_set(pipeline, "id", "kain-image-converter.fabric")
    json_object_set(pipeline, "label", "Image Converter Fabric")
    json_object_set(pipeline, "manifestPath", "usr/plugins-kain/kain-image-converter/plugin.runtime/fabric/KAIN.fabric.toml")
    json_object_set(pipeline, "workspaceRoot", "usr/plugins-kain/kain-image-converter/plugin.runtime/fabric")
    json_object_set(pipeline, "reportDirectory", "plugin.runtime/fabric/.kain/fabric/reports")
    json_object_set(pipeline, "status", "declared")
    json_object_set(pipeline, "summary", "Fabric-ready multi-FFI session: Python prepares data, Kain authors shared contracts, C mutates bytes, Cargo analyzes, Node packages reports, and GreebleFS hosts the workbench safely.")
    json_object_set(pipeline, "eventStream", true)
    json_object_set(pipeline, "runtimes", string_array_5("python", "kain", "c_abi", "rust_crate", "node"))
    json_object_set(pipeline, "ffiLanes", string_array_5("python", "c-runtime", "cargo-ffi", "node", "wasm"))
    json_object_set(pipeline, "requiredCapabilities", string_array_6("runtime.python", "runtime.kain", "runtime.c-abi", "runtime.rust-crate", "runtime.node", "contract.shared-image"))
    json_object_set(pipeline, "outputContracts", string_array_4("value", "shared-image", "shared-buffer", "artifact"))
    json_object_set(pipeline, "steps", steps)
    append_item(pipelines, pipeline)
    return pipelines

fn build_image_converter_authoring_reference() -> Any:
    let reference = json_object_new()
    let features = json_array_new()
    let examples = json_array_new()
    let smoke_commands = json_array_new()

    append_item(features, image_converter_authoring_feature("typed-domain-model", "Structs, enums, traits, impls", "live", "usr/plugins-kain/kain-image-converter/plugin.kn", "The plugin declares typed conversion intent and plugin contracts before emitting host metadata."))
    append_item(features, image_converter_authoring_feature("compiler-owned-intents", "Patch law converge orchestrate examples", "authored", "usr/plugins-kain/kain-plugin-authoring-examples", "The example ladder shows Kain runtime intent forms for future plugin pipelines."))
    append_item(features, image_converter_authoring_feature("python-ffi", "Python FFI execution", "live", "src-python/greeblefs_sidecar/image_converter_runtime.py", "Pillow executes inspect plan convert SVG embed and ICO output."))
    append_item(features, image_converter_authoring_feature("node-ffi", "Node FFI optimizer lane", "declared", "usr/plugins-kain/kain-image-converter/plugin.runtime/node/image_converter_node_bridge.kn", "Sharp and SVGO are declared as the future fast optimization lane."))
    append_item(features, image_converter_authoring_feature("cargo-ffi", "Cargo FFI helper", "compiled-helper", "usr/plugins-kain/kain-image-converter/plugin.runtime/cargo/greeblefs-kain-image-tools", "A plugin-owned Rust crate proves native helper isolation and FFI symbols."))
    append_item(features, image_converter_authoring_feature("c-runtime", "C runtime codec bridge", "available-in-kain", "usr/plugins-kain/kain-image-converter/plugin.runtime/c-runtime/image_converter_c_runtime_bridge.kn", "The plugin declares the C/DLL/SDK lane Kain can use for native codecs."))
    append_item(features, image_converter_authoring_feature("wasm-worker", "WASM preview worker", "declared", "usr/plugins-kain/kain-image-converter/plugin.runtime/wasm/image_converter_preview_worker.kn", "Kain-authored portable worker target for future preview transforms."))

    append_item(examples, image_converter_reference_example("minimal-plugin", "Minimal Kain plugin catalog", "usr/plugins-kain/kain-plugin-authoring-examples/00_minimal_plugin.kn", "run", "kain run", string_array_3("json-catalog", "workbench", "action")))
    append_item(examples, image_converter_reference_example("contracts-and-laws", "Contracts and laws", "usr/plugins-kain/kain-plugin-authoring-examples/01_contracts_and_laws.kn", "run", "kain run", string_array_4("struct", "enum", "trait", "law")))
    append_item(examples, image_converter_reference_example("orchestrated-pipeline", "Orchestrated FFI pipeline", "usr/plugins-kain/kain-plugin-authoring-examples/02_orchestrated_ffi_pipeline.kn", "build", "kain build -t rust/js/ts", string_array_4("world", "patch", "converge", "orchestrate")))
    append_item(examples, image_converter_reference_example("component-world", "Component and world UI contract", "usr/plugins-kain/kain-plugin-authoring-examples/03_component_world_reference.kn", "build", "kain build -t rust", string_array_3("component", "world", "jsx")))

    json_array_push(smoke_commands, "kain run usr/plugins-kain/kain-image-converter/plugin.kn")
    json_array_push(smoke_commands, "kain run usr/plugins-kain/kain-image-converter/plugin.runtime/kain/image_converter_pipeline.kn")
    json_array_push(smoke_commands, "kain build usr/plugins-kain/kain-image-converter/plugin.kn -t ts")

    json_object_set(reference, "id", "kain-image-converter.reference")
    json_object_set(reference, "summary", "Canonical example for writing GreebleFS Kain plugins.")
    json_object_set(reference, "entry", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(reference, "languageFeatures", features)
    json_object_set(reference, "examples", examples)
    json_object_set(reference, "designRules", string_array_6("Kain owns plugin intent", "GreebleFS owns trusted rendering", "Host bridges write bytes", "FFI lanes are explicit", "Generated compatibility is optional", "Examples must smoke"))
    json_object_set(reference, "smokeCommands", smoke_commands)
    return reference

fn build_image_converter_contracts() -> Array<Any>:
    let items = json_array_new()
    append_item(items, image_converter_contract("plugin.catalog", "plugin-definition", "build_kain_plugin", "usr/plugins-kain/kain-image-converter/plugin.kn", "live", "Complete plugin catalog record consumed by GreebleFS."))
