    json_array_push(host_models, "host.windowShell")
    json_array_push(host_models, "host.profile")

    json_array_push(actions, "kain.ui.reload")
    json_array_push(actions, "settings.open")

    json_array_push(permissions, "settings.read")
    json_array_push(permissions, "kain.reload")

