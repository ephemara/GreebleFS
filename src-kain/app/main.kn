fn build_lattice_package_panel_registry() -> Any:
    let package_node = json_object_new()
    let imports = json_array_new()
    let surfaces = json_array_new()
    let host_models = json_array_new()
    let actions = json_array_new()
    let permissions = json_array_new()
    let config_schema = json_object_new()
    let panels = json_array_new()

    json_array_push(imports, "gfs.shell")
    json_array_push(imports, "gfs.panels")
    json_array_push(imports, "gfs.actions")
    json_array_push(imports, "gfs.ui")

    json_array_push(surfaces, "panel:explorer")
    json_array_push(surfaces, "panel:terminal")
    json_array_push(surfaces, "panel:settings")
    json_array_push(surfaces, "panel:plugins")

    json_array_push(host_models, "host.panels")
    json_array_push(host_models, "host.windowShell")
    json_array_push(host_models, "host.explorer")
    json_array_push(host_models, "host.profile")

    json_array_push(actions, "panel.activate")
    json_array_push(actions, "panel.open-window")
    json_array_push(actions, "panel.dock-window")

    json_array_push(permissions, "panels.read")
    json_array_push(permissions, "panels.activate")
    json_array_push(permissions, "windows.open")

    append_lattice_panel_descriptor(panels, "explorer", "Explorer", "explorer-workspace", "center", "visible", "ExplorerPanel")
    append_lattice_panel_descriptor(panels, "storage", "Storage", "storage-panel", "right-sidebar", "hidden", "StoragePanel")
    append_lattice_panel_descriptor(panels, "terminal", "Terminal", "terminal-overlay", "bottom-panel", "collapsed", "TerminalPanel")
    append_lattice_panel_descriptor(panels, "git", "Source", "git-manager", "bottom-panel", "collapsed", "SourcePanel")
    append_lattice_panel_descriptor(panels, "notes", "Notes", "notes-manager", "right-sidebar", "hidden", "NotesPanel")
    append_lattice_panel_descriptor(panels, "go-sample-panel", "Go Wasm", "go-wasm-smoke", "right-sidebar", "hidden", "GoWasmSmokePanel")
    append_lattice_panel_descriptor(panels, "settings", "Settings", "settings-page", "right-sidebar", "hidden", "SettingsPanel")
    append_lattice_panel_descriptor(panels, "plugins", "Plugins", "plugins-manager", "right-sidebar", "hidden", "PluginsPanel")

    json_object_set(config_schema, "source", "src/config/panelLatticeRegistry.ts")
    json_object_set(config_schema, "consumer", "src/panels/panelRegistry.tsx")
    json_object_set(config_schema, "descriptorCount", 8)
    json_object_set(config_schema, "panels", panels)
    json_object_set(config_schema, "status", "lattice-descriptor-live")

    json_object_set(package_node, "id", "greeblefs.lattice.panel-registry")
    json_object_set(package_node, "kind", "shell-panel-registry")
    json_object_set(package_node, "title", "Panel Registry")
    json_object_set(package_node, "summary", "Built-in shell panel metadata, dock defaults, navigation groups, icon slots, and host-model tags are now authored as Lattice descriptors while React remains the trusted renderer host.")
    json_object_set(package_node, "packagePath", "src-kain/lattice/greeblefs-panel-registry")
    json_object_set(package_node, "entry", "src-kain/lattice/greeblefs-panel-registry/main.kn")
    json_object_set(package_node, "metadata", "src-kain/lattice/greeblefs-panel-registry/lattice.toml")
    json_object_set(package_node, "imports", imports)
    json_object_set(package_node, "surfaces", surfaces)
    json_object_set(package_node, "hostModels", host_models)
    json_object_set(package_node, "actions", actions)
    json_object_set(package_node, "permissions", permissions)
    json_object_set(package_node, "configSchema", config_schema)
    return package_node

fn build_lattice_catalog(request: Any) -> Any:
    let catalog = json_object_new()
    let analogy = json_object_new()
    let imports = json_array_new()
    let primitives = json_array_new()
    let host_objects = json_array_new()
    let packages = json_array_new()
    let milestones = json_array_new()
    let consumers = json_array_new()

    json_object_set(analogy, "reference", "reference/plasma-desktop-master")
    json_object_set(analogy, "qmlLike", "Kain components declare properties, bindings, signals, actions, and render targets.")
    json_object_set(analogy, "nativeModelLike", "Rust and Tauron expose reflected host objects to Kain the way Qt/C++ exposes Q_PROPERTY and Q_INVOKABLE surfaces to QML.")
    json_object_set(analogy, "packageLike", "Kain Lattice packages map to Plasma-style applets, KCMs, containments, runners, and layout templates.")

    append_lattice_import(imports, "gfs.shell", "Shell", "panels, workbench surfaces, windows, dock chrome", "planned")
    append_lattice_import(imports, "gfs.settings", "Settings", "KCM-style settings modules, cfg_ bindings, migrations", "planned")
    append_lattice_import(imports, "gfs.ui", "UI", "semantic renderer primitives and layout vocabulary", "live")
    append_lattice_import(imports, "gfs.actions", "Actions", "command palette, context menus, applet actions", "planned")
    append_lattice_import(imports, "gfs.explorer", "Explorer", "file views, preview lanes, activity panes, item delegates", "planned")
    append_lattice_import(imports, "gfs.panels", "Panels", "built-in panels, dock defaults, navigation groups, native-window policy", "live")

    append_lattice_primitive(primitives, "package", "Plasmoid package metadata", "Declares id, kind, entry, imports, permissions, surfaces, host models, and config schema.", "reference")
    append_lattice_primitive(primitives, "component", "QML component", "Declarative object with properties, bindings, signals, actions, and render target.", "reference")
    append_lattice_primitive(primitives, "property", "Q_PROPERTY / property", "State slot that can bind to host models or config schema values.", "reference")
    append_lattice_primitive(primitives, "binding", "QML binding", "Expression that derives one value from host model or component state.", "planned")
    append_lattice_primitive(primitives, "signal", "QML signal", "Component event emitted into host actions or parent components.", "planned")
    append_lattice_primitive(primitives, "action", "PlasmaCore.Action", "Named command with label, enabled state, permission, and host call.", "planned")
    append_lattice_primitive(primitives, "settings-module", "KCM", "Settings page authored in Kain and rendered by trusted GreebleFS primitives.", "live")
    append_lattice_primitive(primitives, "semantic-surface-host", "QQuickItem host", "Trusted frontend host that mounts Lattice-authored semantic surfaces without custom JSX per module.", "live")
    append_lattice_primitive(primitives, "applet", "PlasmoidItem", "Small shell widget with icon, status, actions, tooltip, and compact/full representations.", "live")
    append_lattice_primitive(primitives, "panel-registry", "Containment/package registry", "Data-owned shell panel descriptor registry for dock placement, navigation, permissions, and host models.", "live")
    append_lattice_primitive(primitives, "panel", "Plasmoid containment item", "Single panel surface descriptor with trusted React renderer kind and future Lattice component id.", "live")

    append_lattice_host_object(host_objects, "host.settings", "GreebleFS settings store + Rust profile overlay", "Read and eventually write typed settings slices through reflected contracts.", "planned")
    append_lattice_host_object(host_objects, "host.kainBridge", "Tauron tauri-plugin-kain", "Reload, status, manifest, reflection, and dispatch operations.", "live")
    append_lattice_host_object(host_objects, "host.windowShell", "Tauron/GreebleFS window manager", "Window mode, dock state, panels, secondary windows, and focus state.", "planned")
    append_lattice_host_object(host_objects, "host.explorer", "GreebleFS Explorer runtime", "Locations, selections, preview sessions, actions, and activity lanes.", "planned")
    append_lattice_host_object(host_objects, "host.profile", "usr profile runtime", "Profile overlays, package roots, and migration state.", "planned")
    append_lattice_host_object(host_objects, "host.panels", "src/panels/panelRegistry.tsx + IDE dock graph", "Registered panel descriptors, activation, dock placement, native-window eligibility, and catalog metadata.", "live")

    json_array_push(packages, build_lattice_package_shell_control())
    json_array_push(packages, build_lattice_package_panel_registry())

    append_lattice_milestone(milestones, "lattice.catalog", "Catalog", "Expose the QML-like Kain Lattice package model through the resident bridge.", "live")
    append_lattice_milestone(milestones, "lattice.settings-module", "Settings Module", "Render one Kain-authored KCM-style settings module without hand-editing JSX.", "live")
    append_lattice_milestone(milestones, "lattice.semantic-host", "Semantic Host", "Mount Lattice package surfaces through a reusable React host with trusted action dispatch.", "live")
    append_lattice_milestone(milestones, "lattice.applet", "Applet", "Mount one Kain-authored applet into a shell surface with host actions.", "live")
    append_lattice_milestone(milestones, "lattice.panel-registry", "Panel Registry", "Use Lattice descriptors as the built-in panel metadata source while React renderers remain trusted hosts.", "live")
    append_lattice_milestone(milestones, "lattice.primitive-vocabulary", "Primitive Vocabulary", "Expose layout, display, control, and applet primitives through the safe semantic renderer.", "live")
    append_lattice_milestone(milestones, "lattice.host-reflection", "Host Reflection", "Generate host model wrappers from Rust/Tauron reflection.", "planned")

    json_array_push(consumers, "src/runtime/kainLatticeCatalog.ts")
    json_array_push(consumers, "src/runtime/kainSemanticUiRuntime.ts")
    json_array_push(consumers, "src/components/kain/KainSemanticAppletStrip.tsx")
    json_array_push(consumers, "src/components/settings/sections/KainUiSettingsSection.tsx")
    json_array_push(consumers, "src/config/panelLatticeRegistry.ts")
    json_array_push(consumers, "src/panels/panelRegistry.tsx")
    json_array_push(consumers, "src-kain/lattice/README.md")

    json_object_set(catalog, "schemaVersion", 1)
    json_object_set(catalog, "kind", "greeblefs.lattice.catalog")
    json_object_set(catalog, "name", "Kain Lattice")
    json_object_set(catalog, "source", "src-kain/app/main.kn")
    json_object_set(catalog, "stdlib", "src-kain/stdlib/greeblefs/lattice.kn")
    json_object_set(catalog, "packageRoot", "src-kain/lattice")
    json_object_set(catalog, "summary", "QML-like Kain authoring system for GreebleFS components, applets, settings modules, host models, bindings, and actions.")
    json_object_set(catalog, "namespace", json_string_field(request, "namespace"))
    json_object_set(catalog, "method", json_string_field(request, "method"))
    json_object_set(catalog, "analogy", analogy)
    json_object_set(catalog, "imports", imports)
    json_object_set(catalog, "primitives", primitives)
    json_object_set(catalog, "hostObjects", host_objects)
    json_object_set(catalog, "packages", packages)
    json_object_set(catalog, "milestones", milestones)
    json_object_set(catalog, "consumers", consumers)
    return catalog

fn append_ffi_lane(items, id: String, label: String, lane_kind: String, source_path: String, host_path: String, bridge: String, status: String, implemented: Bool, summary: String, next_action: String) -> Int:
    let lane = json_object_new()
    json_object_set(lane, "id", id)
    json_object_set(lane, "label", label)
    json_object_set(lane, "kind", lane_kind)
    json_object_set(lane, "sourcePath", source_path)
    json_object_set(lane, "hostPath", host_path)
    json_object_set(lane, "bridge", bridge)
    json_object_set(lane, "status", status)
    json_object_set(lane, "implemented", implemented)
    json_object_set(lane, "summary", summary)
    json_object_set(lane, "nextAction", next_action)
    json_array_push(items, lane)
    return 0

fn build_ffi_catalog(request: Any) -> Any:
    let catalog = json_object_new()
    let lanes = json_array_new()
    let analysis = json_array_new()
    let consumers = json_array_new()

    append_ffi_lane(lanes, "python", "Python FFI", "python-sidecar", "src-kain/ffi/python", "src-python/greeblefs_sidecar/actions.py:kain.ffi.ui_inventory", "GreebleFS Python sidecar + Kain Python FFI", "analysis-live", true, "Kain can route heavy analysis, AST inventory, ML/data tooling, and package work through the existing managed Python sidecar and Kain std::python::bridge examples.", "Use src-kain/ffi/python/examples/ui_inventory_bridge/bridge_example.kn as the repo-local Kain/Python FFI pattern.")
    append_ffi_lane(lanes, "node", "Node FFI", "node-ffi", "src-kain/ffi/node", "Node/native npm packages", "Kain Node FFI", "scaffold", false, "Kain can call Node/native packages for codegen, importers, and asset tools.", "Expose one npm-backed analyzer or generator through Kain.")
    append_ffi_lane(lanes, "c-runtime", "C Runtime", "c-abi", "src-kain/ffi/c-runtime", "native DLLs, SDKs, and C libraries", "Kain C runtime", "scaffold", false, "Kain can talk to C libraries and legacy native tools behind explicit trust boundaries.", "Wrap one tiny C ABI probe before product SDK work.")
    append_ffi_lane(lanes, "rust-reflection", "Rust Reflection", "rust-reflection", "src-kain/ffi/rust-reflection", "Tauron/GreebleFS reflected host schema", "Kain Rust reflection", "scaffold", false, "Rust and Tauron can describe host capabilities to Kain for generated wrappers and routed calls.", "Feed runtime host schema into generated Kain wrappers.")
    append_ffi_lane(lanes, "tauri-view", "Tauri View Bridge", "view-bridge", "src-kain/ffi/tauri-view", "@tauri-apps/api/kain + window.__KAIN_TAURI__", "Tauron Kain bridge", "bridge-live", true, "Webviews can call the Kain bridge for UI orchestration, reload, status, manifest, and dispatch.", "Turn Kain scaffold actions into real Tauron bridge calls.")
    append_ffi_lane(lanes, "spirv", "SPIR-V", "gpu-artifacts", "src-kain/ffi/spirv", "GreebleFS shader/GPU runtime cache", "Kain SPIR-V compiler", "scaffold", false, "Kain can compile shader and compute artifacts for lookdev, preview, and GPU pipelines.", "Compile one proof shader artifact into a GreebleFS cache entry.")

    json_array_push(analysis, "ts-frontend-ui-inventory")
    json_array_push(analysis, "plugin-manifest-audit")
    json_array_push(analysis, "settings-schema-drift")

    json_array_push(consumers, "src/runtime/kainFfiCatalog.ts")
    json_array_push(consumers, "src/components/settings/sections/KainUiSettingsSection.tsx")
    json_array_push(consumers, "src-python/greeblefs_sidecar/actions.py:kain.ffi.catalog")
    json_array_push(consumers, "src-python/greeblefs_sidecar/actions.py:kain.ffi.ui_inventory")
    json_array_push(consumers, "src-kain/ffi/python/examples/ui_inventory_bridge/smoke.kn")
    json_array_push(consumers, "src-kain/ffi/python/examples/ui_inventory_bridge/bridge_example.kn")
    json_array_push(consumers, "src-kain/ffi/README.md")

    json_object_set(catalog, "schemaVersion", 1)
    json_object_set(catalog, "kind", "greeblefs.ffi.catalog")
    json_object_set(catalog, "name", "Kain FFI")
    json_object_set(catalog, "source", "src-kain/app/main.kn")
    json_object_set(catalog, "registry", "src-kain/ffi/registry.kn")
    json_object_set(catalog, "root", "src-kain/ffi")
    json_object_set(catalog, "summary", "Kain-owned cross-language bridge map for Python, Node, C, Rust reflection, Tauron view orchestration, and GPU artifacts.")
    json_object_set(catalog, "namespace", json_string_field(request, "namespace"))
    json_object_set(catalog, "method", json_string_field(request, "method"))
    json_object_set(catalog, "lanes", lanes)
    json_object_set(catalog, "analysisPipelines", analysis)
    json_object_set(catalog, "consumers", consumers)
    return catalog

