fn string_array_8(a: String, b: String, c: String, d: String, e: String, f: String, g: String, h: String) -> Array<String>:
    let items = json_array_new()
    json_array_push(items, a)
    json_array_push(items, b)
    json_array_push(items, c)
    json_array_push(items, d)
    json_array_push(items, e)
    json_array_push(items, f)
    json_array_push(items, g)
    json_array_push(items, h)
    return items

fn string_array_10(a: String, b: String, c: String, d: String, e: String, f: String, g: String, h: String, i: String, j: String) -> Array<String>:
    let items = json_array_new()
    json_array_push(items, a)
    json_array_push(items, b)
    json_array_push(items, c)
    json_array_push(items, d)
    json_array_push(items, e)
    json_array_push(items, f)
    json_array_push(items, g)
    json_array_push(items, h)
    json_array_push(items, i)
    json_array_push(items, j)
    return items

fn append_item(items, value: Any) -> Int:
    json_array_push(items, value)
    return 0

fn build_authored_theme_entry(id: String, name: String, description: String, source: String, compatibility_theme_id: String, compatibility_bundle_path: String, status: String, selectable: Bool) -> Any:
    let theme = json_object_new()
    json_object_set(theme, "id", id)
    json_object_set(theme, "name", name)
    json_object_set(theme, "description", description)
    json_object_set(theme, "source", source)
    json_object_set(theme, "compatibilityThemeId", compatibility_theme_id)
    json_object_set(theme, "compatibilityBundlePath", compatibility_bundle_path)
    json_object_set(theme, "status", status)
    json_object_set(theme, "selectable", selectable)
    return theme

fn build_ui_theme() -> Any:
    let theme = json_object_new()
    let authored_themes = json_array_new()
    json_array_push(authored_themes, build_authored_theme_entry(
        "ion-lattice",
        "Ion Lattice",
        "A compact usr-authored Kain UI theme that emits a normal GreebleFS theme bundle until Kain owns the renderer directly.",
        "usr/profiles/default/kain-ui/themes/ion-lattice/main.kn",
        "kain-ion-lattice",
        "usr/themes/kain-ion-lattice/theme.json",
        "selectable",
        true
    ))

    json_object_set(theme, "selectionMode", "catalog")
    json_object_set(theme, "recommendedThemeId", "kain-ion-lattice")
    json_object_set(theme, "authoredThemes", authored_themes)
    json_object_set(theme, "appOpacity", 1.0)
    json_object_set(theme, "panelTransparency", 0.0)
    json_object_set(theme, "appZoom", 1.0)
    json_object_set(theme, "blurStrengthPx", 18)
    json_object_set(theme, "source", "src-kain/app/main.kn")
    return theme

fn build_ui_chrome() -> Any:
    let chrome = json_object_new()
    json_object_set(chrome, "density", "compact")
    json_object_set(chrome, "topBarMode", "theme-default")
    json_object_set(chrome, "buttonSize", "tight")
    json_object_set(chrome, "showAdvancedThemeLanes", false)
    return chrome

fn build_ui_layout() -> Any:
    let layout = json_object_new()
    json_object_set(layout, "shellFamily", "classic")
    json_object_set(layout, "settingsRailMode", "streamlined")
    json_object_set(layout, "explorerChromePreset", "focused")
    return layout

fn build_ui_motion() -> Any:
    let motion = json_object_new()
    json_object_set(motion, "preset", "subtle")
    json_object_set(motion, "interactionPreset", "subtle")
    json_object_set(motion, "shaderPerformanceMode", "performance")
    return motion

fn build_settings_category(key: String, label: String, description: String, section_keys: Array<String>) -> Any:
    let category = json_object_new()
    json_object_set(category, "key", key)
    json_object_set(category, "label", label)
    json_object_set(category, "description", description)
    json_object_set(category, "sectionKeys", section_keys)
    return category

fn build_ui_settings() -> Any:
    let settings = json_object_new()
    let categories = json_array_new()
    let hidden_sections = json_array_new()

    json_array_push(categories, build_settings_category(
        "start",
        "Start",
        "Profiles, system status, and the Kain-authored UI graph.",
        string_array_4("overview", "system", "profiles", "kain-ui")
    ))
    json_array_push(categories, build_settings_category(
        "interface",
        "Interface",
        "The controls that shape the actual shell.",
        string_array_6("appearance", "explorer", "layouts", "terminal", "dock", "context-menus")
    ))
    json_array_push(categories, build_settings_category(
        "visuals",
        "Visuals",
        "Assets and live rendering lanes.",
        string_array_4("icons", "wallpapers", "shaders", "animations")
    ))
    json_array_push(categories, build_settings_category(
        "pipelines",
        "Pipelines",
        "Models, audio, mobile, and cloud features.",
        string_array_6("models", "audio", "mobile", "cloud", "home", "hotkeys")
    ))
    json_array_push(categories, build_settings_category(
        "advanced-authoring",
        "Advanced",
        "Pack-level authoring lanes kept available without owning the main flow.",
        string_array_8("appearance-packs", "theme-recipes", "theme-engines", "shell-renderers", "top-bars", "interaction-motion", "layout-dynamics", "lookdev")
    ))

    json_array_push(hidden_sections, "theme-json")

    json_object_set(settings, "mode", "streamlined")
    json_object_set(settings, "categories", categories)
    json_object_set(settings, "hiddenSectionKeys", hidden_sections)
    json_object_set(settings, "primarySectionKeys", string_array_10("overview", "system", "profiles", "kain-ui", "appearance", "explorer", "layouts", "terminal", "dock", "context-menus"))
    return settings

fn build_ui_profile() -> Any:
    let profile = json_object_new()
    json_object_set(profile, "source", "app")
    json_object_set(profile, "scope", "global")
    json_object_set(profile, "overlays", string_array_2("usr/kain-ui/main.kn", "usr/profiles/<active>/kain-ui/main.kn"))
    return profile

fn build_ui_node(id: String, node_kind: String, title: String, description: String) -> Any:
    let node = json_object_new()
    json_object_set(node, "id", id)
    json_object_set(node, "kind", node_kind)
    if len(title) > 0:
        json_object_set(node, "title", title)
    if len(description) > 0:
        json_object_set(node, "description", description)
    json_object_set(node, "props", json_object_new())
    json_object_set(node, "children", json_array_new())
    return node

fn set_ui_node_prop_string(node: Any, key: String, value: String) -> Int:
    json_object_set(json_get(node, "props"), key, value)
    return 0

fn set_ui_node_prop_int(node: Any, key: String, value: Int) -> Int:
    json_object_set(json_get(node, "props"), key, value)
    return 0

fn set_ui_node_prop_bool(node: Any, key: String, value: Bool) -> Int:
    json_object_set(json_get(node, "props"), key, value)
    return 0

fn set_ui_node_text(node: Any, text: String, role: String) -> Int:
    json_object_set(node, "text", text)
    if len(role) > 0:
        json_object_set(node, "role", role)
    return 0

fn set_ui_node_label(node: Any, label: String, tone: String, active: Bool) -> Int:
    json_object_set(node, "label", label)
    if len(tone) > 0:
        json_object_set(node, "tone", tone)
    json_object_set(node, "active", active)
    return 0

fn set_ui_node_action(node: Any, action_id: String) -> Int:
    json_object_set(node, "actionId", action_id)
    return 0

fn set_ui_node_layout(node: Any, direction: String, gap: String, padding: String) -> Int:
    let layout = json_object_new()
    json_object_set(layout, "direction", direction)
    json_object_set(layout, "gap", gap)
    if len(padding) > 0:
        json_object_set(layout, "padding", padding)
    json_object_set(node, "layout", layout)
    return 0

fn append_ui_child(parent: Any, child: Any) -> Int:
    json_array_push(json_get(parent, "children"), child)
    return 0

fn append_ui_primitive(items, primitive_kind: String, maps_to: String, status: String) -> Int:
    let primitive = json_object_new()
    json_object_set(primitive, "kind", primitive_kind)
    json_object_set(primitive, "mapsTo", maps_to)
    json_object_set(primitive, "status", status)
    json_array_push(items, primitive)
    return 0

fn append_ui_token(items, id: String, category: String, value: String, maps_to: String) -> Int:
    let token = json_object_new()
    json_object_set(token, "id", id)
    json_object_set(token, "category", category)
    json_object_set(token, "value", value)
    json_object_set(token, "mapsTo", maps_to)
    json_array_push(items, token)
    return 0

fn append_ui_action(items, id: String, label: String, command: String, status: String) -> Int:
    let action = json_object_new()
    json_object_set(action, "id", id)
    json_object_set(action, "label", label)
    json_object_set(action, "command", command)
    json_object_set(action, "status", status)
    json_array_push(items, action)
    return 0

fn build_kain_authored_settings_surface() -> Any:
    let surface = json_object_new()
    let root = build_ui_node("settings.kain-authoring.root", "stack", "", "")
    set_ui_node_layout(root, "column", "compact", "none")

    let status_section = build_ui_node("settings.kain-authoring.status", "section", "Kain Authored Surface", "Semantic UI is coming from Kain, then React renders known primitives without replacing the current app.")
    let stdlib_row = build_ui_node("settings.kain-authoring.stdlib", "row", "Stdlib", "src-kain/stdlib/greeblefs/ui.kn defines the app-facing UI vocabulary.")
    let stdlib_pill = build_ui_node("settings.kain-authoring.stdlib.pill", "status-pill", "", "")
    set_ui_node_label(stdlib_pill, "scaffold", "live", true)
    append_ui_child(stdlib_row, stdlib_pill)

    let renderer_row = build_ui_node("settings.kain-authoring.renderer", "row", "Renderer", "src/components/kain/KainUiRenderer.tsx maps Kain nodes onto existing GreebleFS primitives.")
    let renderer_pill = build_ui_node("settings.kain-authoring.renderer.pill", "status-pill", "", "")
    set_ui_node_label(renderer_pill, "wired", "live", true)
    append_ui_child(renderer_row, renderer_pill)

    let action_row = build_ui_node("settings.kain-authoring.reload", "row", "Reload", "The first real action lane will ask Tauron to reload the resident Kain graph after edits.")
    let action_button = build_ui_node("settings.kain-authoring.reload.button", "button", "", "")
    set_ui_node_label(action_button, "reload", "pending", false)
    set_ui_node_action(action_button, "kain.ui.reload")
    append_ui_child(action_row, action_button)

    append_ui_child(status_section, stdlib_row)
    append_ui_child(status_section, renderer_row)
    append_ui_child(status_section, action_row)
    append_ui_child(root, status_section)

    let note = build_ui_node("settings.kain-authoring.note", "text", "", "")
    set_ui_node_text(note, "This is the first Kain-owned UI document: compact, semantic, normalized, and safe to grow one surface at a time.", "caption")
    append_ui_child(root, note)

    json_object_set(surface, "id", "settings.kain-authoring-proof")
    json_object_set(surface, "kind", "settings-module")
    json_object_set(surface, "title", "Kain UI Authoring Proof")
    json_object_set(surface, "summary", "Kain can now describe a small UI surface as data while GreebleFS keeps the current React shell.")
    json_object_set(surface, "mountSlot", "settings.kain-ui")
    json_object_set(surface, "order", 30)
    json_object_set(surface, "root", root)
    return surface

fn build_lattice_shell_control_surface() -> Any:
    let surface = json_object_new()
    let root = build_ui_node("settings.kain-lattice.root", "stack", "", "")
    set_ui_node_layout(root, "column", "compact", "none")

    let module_section = build_ui_node("settings.kain-lattice.module", "section", "Lattice Shell Control", "Kain Lattice can now hand-author a QML-style Settings module and mount it through a semantic host instead of bespoke JSX.")

    let package_row = build_ui_node("settings.kain-lattice.package", "row", "Package", "src-kain/lattice/greeblefs-shell-control/main.kn declares the component graph, host models, actions, and render target.")
    let package_pill = build_ui_node("settings.kain-lattice.package.pill", "status-pill", "", "")
    set_ui_node_label(package_pill, "mounted", "live", true)
    append_ui_child(package_row, package_pill)

    let host_row = build_ui_node("settings.kain-lattice.host-models", "row", "Host Models", "host.settings, host.kainBridge, host.windowShell, and host.profile are declared as native object contracts.")
    let host_pill = build_ui_node("settings.kain-lattice.host-models.pill", "status-pill", "", "")
    set_ui_node_label(host_pill, "4 models", "live", true)
    append_ui_child(host_row, host_pill)

    let binding_row = build_ui_node("settings.kain-lattice.bindings", "row", "Bindings", "The current pass records binding intent as data; later passes can evaluate safe expressions against reflected host models.")
    let binding_pill = build_ui_node("settings.kain-lattice.bindings.pill", "status-pill", "", "")
    set_ui_node_label(binding_pill, "declared", "live", true)
    append_ui_child(binding_row, binding_pill)

    let mount_row = build_ui_node("settings.kain-lattice.mount", "row", "Mount Slot", "The module is mounted by semantic metadata instead of a custom Settings JSX branch.")
    let mount_value = build_ui_node("settings.kain-lattice.mount.value", "key-value", "settings.kain-ui", "")
    set_ui_node_prop_string(mount_value, "key", "slot")
    set_ui_node_prop_string(mount_value, "value", "settings.kain-ui")
    append_ui_child(mount_row, mount_value)

    let controls_row = build_ui_node("settings.kain-lattice.controls", "row", "Controls", "Toggle/select/slider primitives are now part of the safe vocabulary; host writes stay disabled until reflected models land.")
    let controls_strip = build_ui_node("settings.kain-lattice.controls.strip", "action-strip", "", "")
    let toggle_node = build_ui_node("settings.kain-lattice.controls.toggle", "toggle", "Bridge", "")
    set_ui_node_prop_bool(toggle_node, "checked", true)
    set_ui_node_prop_bool(toggle_node, "readonly", true)
    let select_node = build_ui_node("settings.kain-lattice.controls.select", "select", "Mode", "")
    set_ui_node_prop_string(select_node, "value", "semantic")
    set_ui_node_prop_bool(select_node, "readonly", true)
    let slider_node = build_ui_node("settings.kain-lattice.controls.slider", "slider", "Power", "")
    set_ui_node_prop_int(slider_node, "value", 88)
    set_ui_node_prop_int(slider_node, "min", 0)
    set_ui_node_prop_int(slider_node, "max", 100)
    set_ui_node_prop_bool(slider_node, "readonly", true)
    append_ui_child(controls_strip, toggle_node)
    append_ui_child(controls_strip, select_node)
    append_ui_child(controls_strip, slider_node)
    append_ui_child(controls_row, controls_strip)

    let reload_row = build_ui_node("settings.kain-lattice.reload", "row", "Reload Bridge", "This action is authored in Kain and executed by the trusted frontend host through @tauri-apps/api/kain.")
    let reload_button = build_ui_node("settings.kain-lattice.reload.button", "button", "", "")
    set_ui_node_label(reload_button, "reload", "live", true)
    set_ui_node_action(reload_button, "kain.ui.reload")
    append_ui_child(reload_row, reload_button)

    append_ui_child(module_section, package_row)
    append_ui_child(module_section, host_row)
    append_ui_child(module_section, binding_row)
    append_ui_child(module_section, mount_row)
    append_ui_child(module_section, controls_row)
    append_ui_child(module_section, reload_row)
    append_ui_child(root, module_section)

    let notice = build_ui_node("settings.kain-lattice.notice", "notice", "", "")
    set_ui_node_text(notice, "Lattice V1 now has mount slots, ordered surfaces, controls, applets, and trusted action routing without generated JSX.", "caption")
    append_ui_child(root, notice)

    let note = build_ui_node("settings.kain-lattice.note", "text", "", "")
    set_ui_node_text(note, "This is the first semantic Lattice mount: Kain owns the object graph, React only hosts known primitives and trusted actions.", "caption")
    append_ui_child(root, note)

    json_object_set(surface, "id", "settings:kain-lattice-proof")
    json_object_set(surface, "kind", "settings-module")
    json_object_set(surface, "title", "Lattice Shell Control")
    json_object_set(surface, "summary", "Kain Lattice package mounted as a semantic GreebleFS Settings surface.")
    json_object_set(surface, "source", "src-kain/lattice/greeblefs-shell-control/main.kn")
    json_object_set(surface, "packageId", "greeblefs.lattice.shell-control")
    json_object_set(surface, "componentId", "ShellControlModule")
    json_object_set(surface, "mountId", "settings:kain-lattice-proof")
    json_object_set(surface, "mountSlot", "settings.kain-ui")
    json_object_set(surface, "order", 10)
    json_object_set(surface, "hostModels", string_array_4("host.settings", "host.kainBridge", "host.windowShell", "host.profile"))
    json_object_set(surface, "actions", string_array_2("kain.ui.reload", "settings.open"))
    json_object_set(surface, "root", root)
    return surface

fn build_lattice_runtime_status_applet_surface() -> Any:
    let surface = json_object_new()
    let root = build_ui_node("applet.kain-runtime.root", "applet", "Kain", "Resident Kain runtime")
