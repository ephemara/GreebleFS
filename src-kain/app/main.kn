    let meter = build_ui_node("applet.kain-runtime.meter", "mini-meter", "", "")
    set_ui_node_prop_int(meter, "value", 88)
    set_ui_node_prop_int(meter, "max", 100)
    set_ui_node_prop_string(meter, "tone", "live")
    append_ui_child(root, meter)

    let reload_button = build_ui_node("applet.kain-runtime.reload", "icon-button", "", "")
    set_ui_node_label(reload_button, "reload", "live", true)
