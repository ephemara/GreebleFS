fn build_kain_workbench_smoke_plugin() -> Any:
    let plugin = json_object_new()
    let permissions = json_array_new()
    let ffi_capabilities = json_array_new()
    let runtimes = json_array_new()
    let workbenches = json_array_new()
    let preview_workbenches = json_array_new()
    let actions = json_array_new()
    let wasm_targets = json_array_new()
    let cargo_ffi_targets = json_array_new()
    let generated_artifacts = json_array_new()

    append_kain_plugin_permission(permissions, "kain.bridge.dispatch", "Kain bridge dispatch", "trusted-kain-runtime", "live")
    append_kain_plugin_permission(permissions, "runtime.ffi.python", "Python FFI", "trusted-ffi", "declared")
    append_kain_plugin_permission(permissions, "runtime.ffi.node", "Node FFI", "trusted-ffi", "declared")
    append_kain_plugin_permission(permissions, "runtime.ffi.c", "C runtime", "trusted-ffi", "declared")
    append_kain_plugin_permission(permissions, "runtime.ffi.cargo", "Cargo FFI", "trusted-ffi", "declared")
    append_kain_plugin_permission(permissions, "runtime.wasm.compile", "WASM compile", "trusted-runtime-build", "declared")

    append_kain_plugin_ffi_capability(ffi_capabilities, "python.pipeline", "Python FFI pipeline", "python", "Kain plugin actions can route analysis through the managed Python sidecar or Kain's Python bridge.", "declared", true, "usr/plugins-kain/kain-workbench-smoke/plugin.kn", "src-python/greeblefs_sidecar/actions.py")
    append_kain_plugin_ffi_capability(ffi_capabilities, "node.pipeline", "Node FFI pipeline", "node", "Kain can call Node/native npm packages for fast plugin authoring and asset/tooling work.", "available-in-kain", false, "usr/plugins-kain/kain-workbench-smoke/plugin.kn", "node/native npm packages")
    append_kain_plugin_ffi_capability(ffi_capabilities, "c.pipeline", "C runtime pipeline", "c-runtime", "Kain can call native C libraries, DLLs, and SDKs behind explicit plugin trust.", "available-in-kain", false, "usr/plugins-kain/kain-workbench-smoke/plugin.kn", "native DLLs and SDKs")
    append_kain_plugin_ffi_capability(ffi_capabilities, "cargo.pipeline", "Cargo FFI pipeline", "cargo-ffi", "Kain can import or call Cargo crates so Rust ecosystem tools can become plugin pipelines without bespoke TS glue.", "available-in-kain", false, "usr/plugins-kain/kain-workbench-smoke/plugin.kn", "Cargo crates")
    append_kain_plugin_ffi_capability(ffi_capabilities, "wasm.pipeline", "WASM compiler pipeline", "wasm", "Kain can compile portable WASM artifacts that GreebleFS can mount through wasm-panel or wasm-worker hosts.", "available-in-kain", false, "usr/plugins-kain/kain-workbench-smoke/plugin.kn", "src/components/WasmPanelHost.tsx")

    append_kain_plugin_runtime(runtimes, "kain-workbench-smoke.runtime", "resident-kain-plugin", "kain", "usr/plugins-kain/kain-workbench-smoke/plugin.kn", "tauron.kain.bridge", "catalog-live", string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm"))

    append_kain_plugin_action(actions, "kain.plugin.inspect", "Inspect", "Return a safe proof payload from the Kain resident bridge for this plugin.", "greeblefs.plugins.action", "bridge-action", "live", true, string_array_3("python", "cargo-ffi", "wasm"))
    append_kain_plugin_action(actions, "kain.plugin.plan-preview", "Plan Preview", "Describe how this plugin would preview the current file through Kain before any unsafe FFI executes.", "greeblefs.plugins.action", "bridge-action", "live", true, string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm"))

    append_kain_plugin_workbench(workbenches, "kain-workbench-smoke.main", "Kain Workbench Smoke", "A first Kain-authored workbench proving the parallel usr/plugins-kain lane, bridge actions, FFI declarations, WASM targets, and Cargo FFI metadata.", "workbench.panels", 20, "kain-host", "KainPluginWorkbenchHost", false, string_array_4("host.plugins", "host.preview", "host.runtimePipeline", "host.kainBridge"), string_array_2("kain.plugin.inspect", "kain.plugin.plan-preview"), string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm"))

    append_kain_plugin_preview_workbench(
        preview_workbenches,
        "kain-workbench-smoke.preview.kn",
        "Kain Source Preview",
        "A Kain-authored preview workbench for .kn files. React hosts the shell, Kain owns the plugin intent and action routing.",
        980,
        "kain-host",
        "kain-workbench-smoke.runtime",
        "",
        "",
        build_kain_plugin_preview_match("file", string_array_2("kn", "ks"), json_array_new(), string_array_2("script", "text")),
        build_kain_plugin_preview_capabilities(false, false, false, true, true, true, false),
        build_kain_plugin_preview_chrome(true, false, "compact"),
        string_array_2("kain.plugin.inspect", "kain.plugin.plan-preview"),
        string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm")
    )

    append_kain_plugin_wasm_target(wasm_targets, "kain-smoke-worker", "Kain Smoke WASM Worker", "usr/plugins-kain/kain-workbench-smoke/plugin.runtime/wasm/smoke_worker.kn", "plugin.runtime/wasm/dist/smoke_worker.wasm", "wasm32-unknown-unknown", "declared")
    append_kain_plugin_cargo_ffi_target(cargo_ffi_targets, "kain-smoke-cargo-ffi", "Kain Smoke Cargo FFI", "greeblefs-kain-smoke-tools", "usr/plugins-kain/kain-workbench-smoke/plugin.runtime/cargo/greeblefs-kain-smoke-tools", "analysis", "declared")
    append_kain_plugin_generated_artifact(generated_artifacts, "compat-extension-toml", "plugin-compat-manifest", "usr/plugins-kain/kain-workbench-smoke/plugin.kn", "generated/kain-workbench-smoke/extension.toml", "future")

    json_object_set(plugin, "id", "kain-workbench-smoke")
    json_object_set(plugin, "name", "Kain Workbench Smoke")
    json_object_set(plugin, "version", "0.1.0")
    json_object_set(plugin, "description", "First Kain-native plugin package proving workbench, preview workbench, FFI, WASM, Cargo FFI, and trusted action metadata without replacing TSX plugins.")
    json_object_set(plugin, "category", "Kain Plugins")
    json_object_set(plugin, "source", "usr/plugins-kain/kain-workbench-smoke/plugin.kn")
    json_object_set(plugin, "directory", "usr/plugins-kain/kain-workbench-smoke")
    json_object_set(plugin, "manifestPath", "usr/plugins-kain/kain-workbench-smoke/plugin.kn")
    json_object_set(plugin, "status", "live")
    json_object_set(plugin, "tags", string_array_8("kain", "workbench", "preview", "ffi", "python", "node", "wasm", "cargo"))
    json_object_set(plugin, "permissions", permissions)
    json_object_set(plugin, "ffiCapabilities", ffi_capabilities)
    json_object_set(plugin, "runtimes", runtimes)
    json_object_set(plugin, "workbenches", workbenches)
    json_object_set(plugin, "previewWorkbenches", preview_workbenches)
    json_object_set(plugin, "actions", actions)
    json_object_set(plugin, "wasmTargets", wasm_targets)
    json_object_set(plugin, "cargoFfiTargets", cargo_ffi_targets)
    json_object_set(plugin, "generatedArtifacts", generated_artifacts)
    return plugin

