fn build_lattice_package_shell_control() -> Any:
    let package_node = json_object_new()
    let imports = json_array_new()
    let surfaces = json_array_new()
    let host_models = json_array_new()
    let actions = json_array_new()
    let permissions = json_array_new()
    let config_schema = json_object_new()

    json_array_push(imports, "gfs.shell")
    json_array_push(imports, "gfs.settings")
    json_array_push(imports, "gfs.actions")
    json_array_push(imports, "gfs.ui")

    json_array_push(surfaces, "settings:kain-lattice-proof")
    json_array_push(surfaces, "applet:kain-runtime-status")

    json_array_push(host_models, "host.settings")
    json_array_push(host_models, "host.kainBridge")
    json_array_push(host_models, "host.windowShell")
    json_array_push(host_models, "host.profile")

    json_array_push(actions, "kain.ui.reload")
    json_array_push(actions, "settings.open")

    json_array_push(permissions, "settings.read")
    json_array_push(permissions, "kain.reload")

    json_object_set(config_schema, "source", "src-kain/lattice/greeblefs-shell-control/lattice.toml")
    json_object_set(config_schema, "shape", "KCM-style settings module with cfg_ compatible state planned.")
    json_object_set(config_schema, "status", "reference")

    json_object_set(package_node, "id", "greeblefs.lattice.shell-control")
    json_object_set(package_node, "kind", "shell-package")
    json_object_set(package_node, "title", "Shell Control")
    json_object_set(package_node, "summary", "First Kain Lattice reference package for QML-like Settings and applet authoring.")
    json_object_set(package_node, "packagePath", "src-kain/lattice/greeblefs-shell-control")
    json_object_set(package_node, "entry", "src-kain/lattice/greeblefs-shell-control/main.kn")
    json_object_set(package_node, "metadata", "src-kain/lattice/greeblefs-shell-control/lattice.toml")
    json_object_set(package_node, "imports", imports)
    json_object_set(package_node, "surfaces", surfaces)
    json_object_set(package_node, "hostModels", host_models)
    json_object_set(package_node, "actions", actions)
    json_object_set(package_node, "permissions", permissions)
    json_object_set(package_node, "configSchema", config_schema)
    return package_node

fn append_lattice_panel_descriptor(items, id: String, label: String, render_kind: String, default_placement: String, default_visibility: String, component_id: String) -> Int:
