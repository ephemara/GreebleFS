fn json_field_present(object: Any, key: String) -> Bool:
    if !json_has(object, key):
        return false
    return json_string(json_get(object, key)) != "null"

fn json_string_field(object: Any, key: String) -> String:
    if json_field_present(object, key):
        return json_get_string(object, key)
    return ""

fn string_array_1(a: String) -> Array<String>:
    let items = json_array_new()
    json_array_push(items, a)
    return items

fn string_array_2(a: String, b: String) -> Array<String>:
    let items = json_array_new()
    json_array_push(items, a)
    json_array_push(items, b)
    return items

fn string_array_3(a: String, b: String, c: String) -> Array<String>:
    let items = json_array_new()
    json_array_push(items, a)
    json_array_push(items, b)
    json_array_push(items, c)
    return items

fn string_array_4(a: String, b: String, c: String, d: String) -> Array<String>:
    let items = json_array_new()
    json_array_push(items, a)
    json_array_push(items, b)
    json_array_push(items, c)
    json_array_push(items, d)
    return items

fn string_array_5(a: String, b: String, c: String, d: String, e: String) -> Array<String>:
