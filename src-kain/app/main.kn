fn build_kain_image_converter_plugin() -> Any:
    let plugin = json_object_new()
    let permissions = json_array_new()
    let ffi_capabilities = json_array_new()
    let runtimes = json_array_new()
    let tools = json_array_new()
    let workbenches = json_array_new()
    let preview_workbenches = json_array_new()
    let actions = json_array_new()
    let wasm_targets = json_array_new()
    let cargo_targets = json_array_new()
    let generated_artifacts = json_array_new()
    let runtime = json_object_new()

    append_item(permissions, image_converter_capability("kain.bridge.dispatch", "Kain bridge dispatch", "tauri-view", "Resident Tauron Kain bridge dispatches trusted workbench actions.", "live", true))
    append_item(permissions, image_converter_capability("runtime.ffi.python", "Python image IO", "python", "Pillow-backed resize/convert/ICO/SVG emit path.", "live", true))
    append_item(permissions, image_converter_capability("runtime.ffi.node", "Node asset tools", "node", "Sharp/SVGO path for future high-throughput conversion and vector cleanup.", "declared", false))
    append_item(permissions, image_converter_capability("runtime.ffi.cargo", "Cargo image helpers", "cargo-ffi", "Rust helper crate compiles beside the plugin for future native codecs.", "compiled-helper", false))

    append_item(ffi_capabilities, image_converter_capability("python.pillow.converter", "Python Pillow converter", "python", "Actual trusted image inspect/plan/convert action in the managed Python sidecar.", "live", true))
    append_item(ffi_capabilities, image_converter_capability("node.sharp.svgo", "Node Sharp/SVGO bridge", "node", "Declared Kain Node FFI lane for npm-native image optimization.", "declared", false))
    append_item(ffi_capabilities, image_converter_capability("cargo.image.resvg", "Cargo image/resvg bridge", "cargo-ffi", "Compiled plugin-owned Rust helper target for native image math and future codec calls.", "compiled-helper", false))
    append_item(ffi_capabilities, image_converter_capability("c.native.codecs", "C runtime codecs", "c-runtime", "Future C/DLL codec bridge for SDK-only formats.", "available-in-kain", false))
    append_item(ffi_capabilities, image_converter_capability("wasm.preview.worker", "WASM preview worker", "wasm", "Future Kain-compiled portable image worker.", "declared", false))

    json_object_set(runtime, "id", "kain-image-converter.runtime")
    json_object_set(runtime, "kind", "resident-kain-plugin")
    json_object_set(runtime, "language", "kain")
    json_object_set(runtime, "entry", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(runtime, "transport", "tauron.kain.bridge")
    json_object_set(runtime, "status", "catalog-live")
    json_object_set(runtime, "ffiLanes", string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm"))
    append_item(runtimes, runtime)

    append_item(tools, build_image_converter_tool())
    append_item(workbenches, image_converter_workbench())
    append_item(preview_workbenches, image_converter_preview_workbench())
    append_item(actions, image_converter_action("kain.image.inspect", "Inspect", "Inspect the selected image through the Kain-declared Python FFI lane.", "inspect", "kain.plugin.image_converter.inspect", string_array_2("python", "cargo-ffi")))
    append_item(actions, image_converter_action("kain.image.plan-conversion", "Plan", "Build the output path/format/resize plan before writing bytes.", "plan", "kain.plugin.image_converter.plan", string_array_3("python", "node", "cargo-ffi")))
    append_item(actions, image_converter_action("kain.image.convert", "Convert", "Resize and convert the image through the trusted Python sidecar action declared by this Kain plugin.", "convert", "kain.plugin.image_converter.convert", string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm")))

    append_kain_plugin_wasm_target(wasm_targets, "kain-image-converter-preview-worker", "Kain Image Converter Preview Worker", "usr/plugins-kain/kain-image-converter/plugin.runtime/wasm/image_converter_preview_worker.kn", "plugin.runtime/wasm/dist/image_converter_preview_worker.wasm", "wasm32-unknown-unknown", "declared")
    append_kain_plugin_cargo_ffi_target(cargo_targets, "kain-image-converter-cargo-ffi", "Kain Image Converter Cargo FFI", "greeblefs-kain-image-tools", "usr/plugins-kain/kain-image-converter/plugin.runtime/cargo/greeblefs-kain-image-tools", "image-math", "compiled-helper")
    append_kain_plugin_generated_artifact(generated_artifacts, "compat-extension-toml", "plugin-compat-manifest", "usr/plugins-kain/kain-image-converter/plugin.kn", "generated/kain-image-converter/extension.toml", "future")

    json_object_set(plugin, "id", "kain-image-converter")
    json_object_set(plugin, "name", "Kain Image Converter")
    json_object_set(plugin, "version", "0.2.0")
    json_object_set(plugin, "description", "Canonical Kain-native plugin example: typed image conversion intent, workbench and preview surfaces, trusted Python FFI, declared Node/Cargo/C/WASM lanes, and runnable authoring examples.")
    json_object_set(plugin, "category", "Kain Plugins")
    json_object_set(plugin, "source", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(plugin, "directory", "usr/plugins-kain/kain-image-converter")
    json_object_set(plugin, "manifestPath", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(plugin, "status", "live")
    json_object_set(plugin, "tags", string_array_8("kain", "workbench", "image", "converter", "ffi", "python", "reference", "orchestrate"))
    json_object_set(plugin, "permissions", permissions)
    json_object_set(plugin, "ffiCapabilities", ffi_capabilities)
    json_object_set(plugin, "runtimes", runtimes)
    json_object_set(plugin, "tools", tools)
    json_object_set(plugin, "hostUiKit", build_image_converter_host_ui_kit())
    json_object_set(plugin, "hostUiComponents", build_image_converter_host_ui_components())
    json_object_set(plugin, "workbenches", workbenches)
    json_object_set(plugin, "previewWorkbenches", preview_workbenches)
    json_object_set(plugin, "actions", actions)
    json_object_set(plugin, "wasmTargets", wasm_targets)
    json_object_set(plugin, "cargoFfiTargets", cargo_targets)
    json_object_set(plugin, "generatedArtifacts", generated_artifacts)
    json_object_set(plugin, "authoring", build_image_converter_authoring_reference())
    json_object_set(plugin, "contracts", build_image_converter_contracts())
    json_object_set(plugin, "pipelineStages", build_image_converter_pipeline_stages())
    json_object_set(plugin, "fabricPipelines", build_image_converter_fabric_pipelines())
    return plugin

fn build_kain_plugin_catalog(request: Any) -> Any:
    let catalog = json_object_new()
    let plugins = json_array_new()
    let consumers = json_array_new()
    json_array_push(plugins, build_kain_workbench_smoke_plugin())
    json_array_push(plugins, build_kain_image_converter_plugin())

    json_array_push(consumers, "src/runtime/kainPluginCatalog.ts")
    json_array_push(consumers, "src/config/pluginPackages.ts")
    json_array_push(consumers, "src/runtime/useFolderPluginRuntime.ts")
    json_array_push(consumers, "src/components/kain/KainPluginWorkbenchHost.tsx")
    json_array_push(consumers, "src/components/settings/sections/KainUiSettingsSection.tsx")
    json_array_push(consumers, "usr/plugins-kain/kain-workbench-smoke/plugin.kn")
    json_array_push(consumers, "usr/plugins-kain/kain-image-converter/plugin.kn")

    json_object_set(catalog, "schemaVersion", 1)
    json_object_set(catalog, "kind", "greeblefs.kain.plugin.catalog")
    json_object_set(catalog, "source", "src-kain/plugins/registry.kn")
    json_object_set(catalog, "root", "usr/plugins-kain")
    json_object_set(catalog, "stdlib", "src-kain/plugins/stdlib/greeblefs/plugin.kn")
    json_object_set(catalog, "host", "src/runtime/kainPluginCatalog.ts")
    json_object_set(catalog, "summary", "Parallel Kain-native plugin catalog for workbenches, preview workbenches, trusted actions, tools, FFI, WASM, and Cargo FFI while existing TSX plugins stay intact.")
    json_object_set(catalog, "namespace", json_string_field(request, "namespace"))
    json_object_set(catalog, "method", json_string_field(request, "method"))
    json_object_set(catalog, "plugins", plugins)
    json_object_set(catalog, "consumers", consumers)
    return catalog

fn build_kain_plugin_action_result(request: Any) -> Any:
    let args = json_get(request, "args")
    let plugin_id = json_string_field(args, "pluginId")
    let action_id = json_string_field(args, "actionId")
    let result = json_object_new()
    let payload = json_object_new()

    if plugin_id == "kain-image-converter":
        json_object_set(payload, "source", "src-kain/app/main.kn")
        json_object_set(payload, "catalog", "usr/plugins-kain/kain-image-converter/plugin.kn")
        json_object_set(payload, "safe", true)
        json_object_set(payload, "toolId", "kain-image-converter.tool")
        json_object_set(payload, "pythonSidecar", "kain.plugin.image_converter.convert")
        json_object_set(payload, "nodeFfi", "usr/plugins-kain/kain-image-converter/plugin.runtime/node/image_converter_node_bridge.kn")
        json_object_set(payload, "cargoFfi", "usr/plugins-kain/kain-image-converter/plugin.runtime/cargo/greeblefs-kain-image-tools")
        json_object_set(payload, "fabricManifest", "usr/plugins-kain/kain-image-converter/plugin.runtime/fabric/KAIN.fabric.toml")
        json_object_set(payload, "next", "The trusted host executes bytes through Python sidecar while Kain owns the workbench/tool/action contract.")

        json_object_set(result, "ok", true)
        json_object_set(result, "pluginId", plugin_id)
        json_object_set(result, "actionId", action_id)
        if action_id == "kain.image.convert":
            json_object_set(result, "label", "Convert")
            json_object_set(result, "summary", "Kain approved the image conversion action; the trusted Python sidecar can now write the output artifact.")
            json_object_set(result, "ffiLanes", string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm"))
        else:
            if action_id == "kain.image.plan-conversion":
                json_object_set(result, "label", "Plan")
                json_object_set(result, "summary", "Kain returned the conversion plan contract for the image converter workbench.")
                json_object_set(result, "ffiLanes", string_array_3("python", "node", "cargo-ffi"))
            else:
                json_object_set(result, "label", "Inspect")
                json_object_set(result, "summary", "Kain returned the inspect contract for the image converter workbench.")
                json_object_set(result, "ffiLanes", string_array_2("python", "cargo-ffi"))
        json_object_set(result, "result", payload)
        return result

    json_object_set(payload, "source", "src-kain/app/main.kn")
    json_object_set(payload, "catalog", "usr/plugins-kain/kain-workbench-smoke/plugin.kn")
    json_object_set(payload, "safe", true)
    json_object_set(payload, "next", "Route this action into the plugin-owned Kain runtime once per-plugin action sandboxes land.")

    json_object_set(result, "ok", plugin_id == "kain-workbench-smoke")
    json_object_set(result, "pluginId", plugin_id)
    json_object_set(result, "actionId", action_id)
    if action_id == "kain.plugin.plan-preview":
        json_object_set(result, "label", "Plan Preview")
        json_object_set(result, "summary", "Kain preview plan returned through the resident bridge without executing unsafe FFI.")
        json_object_set(result, "ffiLanes", string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm"))
    else:
        json_object_set(result, "label", "Inspect")
        json_object_set(result, "summary", "Kain plugin inspect proof returned through the resident bridge.")
        json_object_set(result, "ffiLanes", string_array_3("python", "cargo-ffi", "wasm"))
    json_object_set(result, "result", payload)
    return result

fn append_manifest_capability(items, id: String, lane: String, label: String, summary: String, status: String, implemented: Bool) -> Int:
    let capability = json_object_new()
    json_object_set(capability, "id", id)
    json_object_set(capability, "lane", lane)
    json_object_set(capability, "label", label)
    json_object_set(capability, "summary", summary)
    json_object_set(capability, "status", status)
    json_object_set(capability, "implemented", implemented)
    json_array_push(items, capability)
    return 0

fn append_manifest_dispatch(items, dispatch_namespace: String, method: String, summary: String, consumed_by: String) -> Int:
    let endpoint = json_object_new()
    json_object_set(endpoint, "namespace", dispatch_namespace)
    json_object_set(endpoint, "method", method)
    json_object_set(endpoint, "summary", summary)
    json_object_set(endpoint, "consumedBy", consumed_by)
    json_array_push(items, endpoint)
    return 0

fn append_manifest_artifact(items, id: String, artifact_kind: String, source: String, target: String, status: String) -> Int:
    let artifact = json_object_new()
    json_object_set(artifact, "id", id)
    json_object_set(artifact, "kind", artifact_kind)
    json_object_set(artifact, "source", source)
    json_object_set(artifact, "target", target)
    json_object_set(artifact, "status", status)
    json_array_push(items, artifact)
    return 0

fn append_manifest_schema(items, id: String, label: String, source: String, consumer: String, status: String) -> Int:
    let schema = json_object_new()
    json_object_set(schema, "id", id)
    json_object_set(schema, "label", label)
    json_object_set(schema, "source", source)
    json_object_set(schema, "consumer", consumer)
    json_object_set(schema, "status", status)
    json_array_push(items, schema)
    return 0

fn append_manifest_pipeline(items, id: String, label: String, summary: String, status: String) -> Int:
    let pipeline = json_object_new()
    json_object_set(pipeline, "id", id)
    json_object_set(pipeline, "label", label)
    json_object_set(pipeline, "summary", summary)
    json_object_set(pipeline, "status", status)
    json_array_push(items, pipeline)
    return 0

fn append_manifest_ffi_lane(items, id: String, label: String, summary: String, status: String) -> Int:
    let lane = json_object_new()
    json_object_set(lane, "id", id)
    json_object_set(lane, "label", label)
    json_object_set(lane, "summary", summary)
    json_object_set(lane, "status", status)
    json_array_push(items, lane)
    return 0

fn build_kain_manifest(request: Any) -> Any:
    let manifest = json_object_new()
    let bridge = json_object_new()
    let capabilities = json_array_new()
    let dispatch = json_array_new()
    let generated_artifacts = json_array_new()
    let settings_schemas = json_array_new()
    let pipelines = json_array_new()
    let ffi_lanes = json_array_new()
    let consumers = json_array_new()

    json_object_set(bridge, "runtimeId", "greeblefs-kain-app")
    json_object_set(bridge, "entry", "src-kain/app/main.kn")
    json_object_set(bridge, "dispatchFunction", "kain_bridge_dispatch")
    json_object_set(bridge, "transport", "tauron.kain.bridge.json-lines")
    json_object_set(bridge, "supervisor", "tauri-plugin-kain")

    append_manifest_capability(capabilities, "kain.app.manifest", "bridge", "Kain app manifest", "Kain can describe the app-level features it contributes to GreebleFS.", "live", true)
    append_manifest_capability(capabilities, "kain.ui.graph", "ui", "Kain UI graph", "Kain supplies theme, chrome, layout, motion, settings, and profile intent.", "live", true)
    append_manifest_capability(capabilities, "kain.ui.scaffold", "ui", "Kain semantic UI scaffold", "Kain can describe compact UI surfaces, primitive nodes, layout intent, tokens, and action ids for React to render.", "live", true)
    append_manifest_capability(capabilities, "kain.lattice.catalog", "ui", "Kain Lattice catalog", "Kain can describe QML-like packages, components, properties, bindings, signals, actions, host models, and KCM-style settings modules.", "live", true)
    append_manifest_capability(capabilities, "kain.lattice.panelRegistry", "ui", "Panel registry Lattice descriptors", "Kain Lattice now owns the built-in panel metadata contract while React keeps trusted panel renderers.", "live", true)
    append_manifest_capability(capabilities, "kain.ffi.uiInventory", "ffi", "UI inventory analyzer", "Kain can call the Python FFI UI inventory worker to emit hardcoded-surface maps for future Lattice migrations.", "live", true)
    append_manifest_capability(capabilities, "kain.settings.navigation", "settings", "Settings navigation ownership", "Kain can author Settings groups and hide compatibility lanes while GreebleFS keeps fallbacks.", "consumed", true)
    append_manifest_capability(capabilities, "kain.plugin.authoring", "plugins", "Plugin/action authoring", "Kain can author parallel Kain-native plugins with workbenches, preview workbenches, trusted actions, FFI declarations, and compatibility artifacts.", "live", true)
    append_manifest_capability(capabilities, "kain.plugin.imageConverter", "plugins", "Kain image converter workbench", "A Kain-authored plugin now declares an image converter tool, image preview workbench, trusted Python FFI actions, and Node/Cargo/C/WASM expansion lanes.", "live", true)
    append_manifest_capability(capabilities, "kain.plugin.hostUiKit", "plugins", "Kain plugin host UI kit", "Kain plugins can describe trusted shared GreebleFS controls while React keeps rendering and permissions.", "live", true)
    append_manifest_capability(capabilities, "kain.plugin.fabric", "plugins", "Kain plugin Fabric pipelines", "Kain plugins can advertise plugin-owned KAIN.fabric.toml manifests for Python/Kain/C ABI/Rust crate/Node multi-FFI sessions.", "live", true)
    append_manifest_capability(capabilities, "kain.host.reflection", "rust", "Rust host reflection", "Rust/Tauron can describe host capabilities for Kain to route or generate wrappers.", "planned", false)
    append_manifest_capability(capabilities, "kain.shader.spirv", "gpu", "SPIR-V shader artifacts", "Kain can compile GPU/shader artifacts for lookdev, preview, and compute pipelines.", "available-in-kain", false)
    append_manifest_capability(capabilities, "kain.wasm.compiler", "wasm", "Kain WASM compiler", "Kain can compile portable WASM artifacts for GreebleFS wasm-panel and wasm-worker runtime surfaces.", "available-in-kain", false)
    append_manifest_capability(capabilities, "kain.python.ffi", "ffi", "Python FFI bridge", "Kain can route Python-heavy analysis and package workflows through the existing managed Python sidecar.", "sidecar-hooked", true)
    append_manifest_capability(capabilities, "kain.node.ffi", "ffi", "Node FFI bridge", "Kain can call Node/native packages when that is the fastest authoring path.", "available-in-kain", false)
    append_manifest_capability(capabilities, "kain.c.runtime", "ffi", "C runtime bridge", "Kain can talk to C libraries, DLLs, compiled tools, SDKs, and legacy code.", "available-in-kain", false)
    append_manifest_capability(capabilities, "kain.cargo.ffi", "ffi", "Cargo FFI bridge", "Kain can import or call Cargo crates so Rust ecosystem tools can become plugin/runtime pipelines before hardened host promotion.", "available-in-kain", false)

    append_manifest_dispatch(dispatch, "greeblefs.ui", "graph", "Return the Kain-authored UI graph consumed by Settings and app defaults.", "src/runtime/kainUiGraph.ts")
    append_manifest_dispatch(dispatch, "greeblefs.ui", "scaffold", "Return Kain-authored semantic UI surfaces and primitive vocabulary for React rendering.", "src/runtime/kainUiScaffold.ts")
    append_manifest_dispatch(dispatch, "greeblefs.ui", "ping", "Smoke-test the resident bridge process.", "dev/mcp smoke")
    append_manifest_dispatch(dispatch, "greeblefs.lattice", "catalog", "Return the Kain Lattice QML-like package/component catalog.", "src/runtime/kainLatticeCatalog.ts")
    append_manifest_dispatch(dispatch, "greeblefs.ffi", "catalog", "Return the Kain FFI monorepo lane catalog.", "src/runtime/kainFfiCatalog.ts")
    append_manifest_dispatch(dispatch, "greeblefs.kain", "manifest", "Return the Kain app manifest that declares first-class GreebleFS contributions.", "src/runtime/kainManifest.ts")
    append_manifest_dispatch(dispatch, "greeblefs.plugins", "catalog", "Return the parallel Kain-native plugin catalog under usr/plugins-kain.", "src/runtime/kainPluginCatalog.ts")
    append_manifest_dispatch(dispatch, "greeblefs.plugins", "action", "Run a trusted Kain plugin action through the resident bridge.", "src/components/kain/KainPluginWorkbenchHost.tsx")

    append_manifest_artifact(generated_artifacts, "kain.plugin.proof", "plugin-manifest", "src-kain/runtimes/greeblefs-kain-control-plane/src/plugin_authoring.kn", "generated/plugin-proof.json", "proof")
    append_manifest_artifact(generated_artifacts, "kain.settings.proof", "settings-schema", "src-kain/runtimes/greeblefs-kain-control-plane/src/settings_authoring.kn", "generated/settings-proof.json", "proof")
    append_manifest_artifact(generated_artifacts, "kain.ui.graph", "runtime-graph", "src-kain/app/main.kn", "src/runtime/kainUiGraph.ts", "live")
    append_manifest_artifact(generated_artifacts, "kain.ui.scaffold", "semantic-ui-ir", "src-kain/app/main.kn", "src/runtime/kainUiScaffold.ts", "live")
    append_manifest_artifact(generated_artifacts, "kain.lattice.catalog", "lattice-package-catalog", "src-kain/app/main.kn", "src/runtime/kainLatticeCatalog.ts", "live")
    append_manifest_artifact(generated_artifacts, "kain.lattice.panelRegistry", "panel-descriptor-registry", "src-kain/lattice/greeblefs-panel-registry/main.kn", "src/config/panelLatticeRegistry.ts", "live")
    append_manifest_artifact(generated_artifacts, "kain.ffi.uiInventory", "hardcoded-surface-map", "src-kain/ffi/python/analysis/ui_inventory.py", "tmp/ui-hardcoded-surface-map.json", "live")
    append_manifest_artifact(generated_artifacts, "kain.ffi.catalog", "ffi-lane-catalog", "src-kain/ffi/registry.kn", "src/runtime/kainFfiCatalog.ts", "live")
    append_manifest_artifact(generated_artifacts, "kain.plugin.catalog", "kain-plugin-catalog", "src-kain/plugins/registry.kn", "src/runtime/kainPluginCatalog.ts", "live")
    append_manifest_artifact(generated_artifacts, "kain.plugin.smoke.compat", "plugin-compat-manifest", "usr/plugins-kain/kain-workbench-smoke/plugin.kn", "generated/kain-workbench-smoke/extension.toml", "future")
    append_manifest_artifact(generated_artifacts, "kain.plugin.imageConverter", "kain-plugin-tool", "usr/plugins-kain/kain-image-converter/plugin.kn", "src/components/kain/KainPluginWorkbenchHost.tsx", "live")
    append_manifest_artifact(generated_artifacts, "kain.plugin.imageConverter.fabric", "fabric-manifest", "usr/plugins-kain/kain-image-converter/plugin.runtime/fabric/KAIN.fabric.toml", "kain fabric validate", "declared")

    append_manifest_schema(settings_schemas, "greeblefs.kain.ui", "Kain UI Settings", "src-kain/app/main.kn", "Settings > Kain UI", "live")
    append_manifest_schema(settings_schemas, "greeblefs.kain.controlPlane", "Kain Control Plane Settings", "src-kain/runtimes/greeblefs-kain-control-plane/src/settings_authoring.kn", "generated proof", "proof")

    append_manifest_pipeline(pipelines, "kain.settings.first-class", "Settings ownership", "Kain authors Settings grouping now, then graduates schema/default/migration ownership per section.", "active")
    append_manifest_pipeline(pipelines, "kain.ui.semantic-renderer", "Semantic UI renderer", "Kain defines small UI surfaces as data and React renders known GreebleFS primitives until full codegen is ready.", "active")
    append_manifest_pipeline(pipelines, "kain.lattice.qml-like-shell", "Kain Lattice", "Kain becomes the QML-like authoring layer for GreebleFS packages, KCM-style settings modules, applets, panels, actions, bindings, and host models.", "active")
    append_manifest_pipeline(pipelines, "kain.lattice.panel-registry", "Panel registry migration", "Built-in panel metadata now resolves from Lattice descriptors before the renderers migrate into authored package components.", "active")
    append_manifest_pipeline(pipelines, "kain.ffi.ui-inventory", "UI hardcoded-surface inventory", "Kain Python FFI emits the hardcoded visual, interaction, and panel migration map for the next Lattice conversion passes.", "active")
    append_manifest_pipeline(pipelines, "kain.ffi.monorepo", "Kain FFI monorepo", "Kain owns a lane catalog for Python, Node, C, Rust reflection, Tauron view, and SPIR-V bridge work.", "active")
    append_manifest_pipeline(pipelines, "kain.plugin.first-class", "Kain plugin catalog", "Kain owns a parallel usr/plugins-kain lane for plugin workbenches, preview workbenches, trusted actions, FFI declarations, WASM targets, Cargo FFI targets, and future compatibility artifacts.", "active")
    append_manifest_pipeline(pipelines, "kain.plugin.image-converter", "Image converter workbench", "Kain now authors a real image conversion workbench with Python Pillow execution and declared Node, Cargo, C runtime, and WASM upgrade lanes.", "active")
    append_manifest_pipeline(pipelines, "kain.plugin.fabric", "Plugin Fabric sessions", "Kain plugin metadata can now point at plugin.runtime/fabric/KAIN.fabric.toml for dependency-ordered multi-FFI sessions.", "active")
    append_manifest_pipeline(pipelines, "kain.reflection.codegen", "Rust reflection codegen", "Kain consumes Rust/Tauron host shape and emits wrapper glue instead of hand-maintained mappings.", "planned")
    append_manifest_pipeline(pipelines, "kain.gpu.artifacts", "GPU artifact lane", "Kain compiles SPIR-V/shader artifacts for preview/lookdev pipelines.", "planned")

    append_manifest_ffi_lane(ffi_lanes, "python", "Python FFI", "Use the managed GreebleFS Python sidecar for dependency-heavy analysis, AST inventory, ML, data tooling, and reusable reports.", "sidecar-hooked")
    append_manifest_ffi_lane(ffi_lanes, "node", "Node FFI", "Use Node/native npm packages for authoring, codegen, and asset tooling.", "available-in-kain")
    append_manifest_ffi_lane(ffi_lanes, "c-runtime", "C runtime", "Use native C libraries, DLLs, SDKs, and compiled tools behind explicit host lanes.", "available-in-kain")
    append_manifest_ffi_lane(ffi_lanes, "cargo-ffi", "Cargo FFI", "Use Cargo crates and Rust libraries from Kain plugin/runtime pipelines before promoting stable seams into Rust host code.", "available-in-kain")
    append_manifest_ffi_lane(ffi_lanes, "rust-reflection", "Rust reflection", "Let Rust describe trusted host capabilities and let Kain generate or route calls.", "planned")
    append_manifest_ffi_lane(ffi_lanes, "wasm", "WASM", "Compile Kain-authored WASM artifacts for wasm-panel and wasm-worker runtime surfaces.", "available-in-kain")
    append_manifest_ffi_lane(ffi_lanes, "spirv", "SPIR-V", "Compile shader/compute artifacts that GreebleFS can cache and consume.", "available-in-kain")

    json_array_push(consumers, "src/runtime/kainManifest.ts")
    json_array_push(consumers, "src/runtime/kainUiScaffold.ts")
    json_array_push(consumers, "src/runtime/kainLatticeCatalog.ts")
    json_array_push(consumers, "src/runtime/kainFfiCatalog.ts")
    json_array_push(consumers, "src/runtime/kainPluginCatalog.ts")
    json_array_push(consumers, "src/components/kain/KainUiRenderer.tsx")
    json_array_push(consumers, "src/components/kain/KainPluginWorkbenchHost.tsx")
    json_array_push(consumers, "src/components/settings/sections/KainUiSettingsSection.tsx")
    json_array_push(consumers, "MCP greeblefs-dev-mcp smoke")

    json_object_set(manifest, "schemaVersion", 1)
    json_object_set(manifest, "kind", "greeblefs.kain.manifest")
    json_object_set(manifest, "source", "src-kain/app/main.kn")
    json_object_set(manifest, "label", "GreebleFS Kain Manifest")
    json_object_set(manifest, "summary", "Kain-authored contribution map for UI, Settings, plugins, pipelines, FFI, GPU, and generated compatibility artifacts.")
    json_object_set(manifest, "namespace", json_string_field(request, "namespace"))
    json_object_set(manifest, "method", json_string_field(request, "method"))
    json_object_set(manifest, "bridge", bridge)
    json_object_set(manifest, "capabilities", capabilities)
    json_object_set(manifest, "dispatch", dispatch)
    json_object_set(manifest, "generatedArtifacts", generated_artifacts)
    json_object_set(manifest, "settingsSchemas", settings_schemas)
    json_object_set(manifest, "pipelines", pipelines)
    json_object_set(manifest, "ffiLanes", ffi_lanes)
    json_object_set(manifest, "consumers", consumers)
    return manifest

fn build_ui_graph(request: Any) -> Any:
    let graph = json_object_new()
    json_object_set(graph, "schemaVersion", 1)
    json_object_set(graph, "kind", "greeblefs.ui.graph")
    json_object_set(graph, "source", "src-kain/app/main.kn")
    json_object_set(graph, "namespace", json_string_field(request, "namespace"))
    json_object_set(graph, "method", json_string_field(request, "method"))
    json_object_set(graph, "theme", build_ui_theme())
    json_object_set(graph, "chrome", build_ui_chrome())
    json_object_set(graph, "layout", build_ui_layout())
    json_object_set(graph, "motion", build_ui_motion())
    json_object_set(graph, "settings", build_ui_settings())
    json_object_set(graph, "profile", build_ui_profile())
    return graph

fn build_error(message: String) -> Any:
    let result = json_object_new()
    json_object_set(result, "ok", false)
    json_object_set(result, "error", message)
    return result

fn kain_bridge_dispatch(request_json: String) -> Any:
    let request = json_parse(request_json)
    let request_namespace = json_string_field(request, "namespace")
    let request_method = json_string_field(request, "method")

    if request_namespace == "greeblefs.ui" and request_method == "graph":
        return build_ui_graph(request)

    if request_namespace == "greeblefs.ui" and request_method == "scaffold":
        return build_ui_scaffold(request)

    if request_namespace == "greeblefs.ui" and request_method == "ping":
        let result = json_object_new()
        json_object_set(result, "ok", true)
        json_object_set(result, "source", "src-kain/app/main.kn")
        return result

    if request_namespace == "greeblefs.lattice" and request_method == "catalog":
        return build_lattice_catalog(request)

    if request_namespace == "greeblefs.ffi" and request_method == "catalog":
        return build_ffi_catalog(request)

    if request_namespace == "greeblefs.kain" and request_method == "manifest":
        return build_kain_manifest(request)

    if request_namespace == "greeblefs.plugins" and request_method == "catalog":
        return build_kain_plugin_catalog(request)

    if request_namespace == "greeblefs.plugins" and request_method == "action":
        return build_kain_plugin_action_result(request)

    return build_error("Unknown GreebleFS Kain UI request: " + request_namespace + "." + request_method)
