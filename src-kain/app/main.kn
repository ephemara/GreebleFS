    json_object_set(surface, "id", "applet:kain-runtime-status")
    json_object_set(surface, "kind", "shell-applet")
    json_object_set(surface, "title", "Kain Runtime")
    json_object_set(surface, "summary", "Compact Kain-authored runtime status applet mounted into the workbench top bar.")
    json_object_set(surface, "source", "src-kain/lattice/greeblefs-shell-control/main.kn")
    json_object_set(surface, "packageId", "greeblefs.lattice.shell-control")
    json_object_set(surface, "componentId", "RuntimeStatusApplet")
    json_object_set(surface, "mountId", "applet:kain-runtime-status")
    json_object_set(surface, "mountSlot", "workbench.topbar.trailing")
    json_object_set(surface, "order", 20)
    json_object_set(surface, "hostModels", string_array_2("host.kainBridge", "host.profile"))
    json_object_set(surface, "actions", string_array_2("kain.ui.reload", "settings.open"))
    json_object_set(surface, "root", root)
    return surface

fn build_ui_scaffold(request: Any) -> Any:
    let scaffold = json_object_new()
    let surfaces = json_array_new()
    let primitives = json_array_new()
    let tokens = json_array_new()
    let actions = json_array_new()
    let consumers = json_array_new()

    json_array_push(surfaces, build_lattice_shell_control_surface())
    json_array_push(surfaces, build_lattice_runtime_status_applet_surface())
    json_array_push(surfaces, build_kain_authored_settings_surface())

    append_ui_primitive(primitives, "stack", "flex column/row layout wrapper", "wired")
    append_ui_primitive(primitives, "action-strip", "compact grouped action/control row", "wired")
    append_ui_primitive(primitives, "divider", "semantic divider", "wired")
    append_ui_primitive(primitives, "section", "SettingsSectionBlock", "wired")
    append_ui_primitive(primitives, "row", "SettingsRow", "wired")
    append_ui_primitive(primitives, "key-value", "compact key/value field", "wired")
    append_ui_primitive(primitives, "notice", "semantic inline notice", "wired")
    append_ui_primitive(primitives, "status-pill", "SettingsStatusPill", "wired")
    append_ui_primitive(primitives, "text", "semantic text node", "wired")
    append_ui_primitive(primitives, "button", "theme-aware button/action host", "wired")
    append_ui_primitive(primitives, "toggle", "trusted read-only toggle primitive", "wired")
    append_ui_primitive(primitives, "select", "trusted read-only select primitive", "wired")
    append_ui_primitive(primitives, "slider", "trusted read-only slider primitive", "wired")
    append_ui_primitive(primitives, "settings-module", "KainSemanticSurfaceHost mount", "wired")
    append_ui_primitive(primitives, "shell-applet", "KainSemanticAppletStrip mount", "wired")
    append_ui_primitive(primitives, "applet", "compact shell applet wrapper", "wired")
    append_ui_primitive(primitives, "indicator", "compact live status indicator", "wired")
    append_ui_primitive(primitives, "icon-button", "compact top-bar action button", "wired")
    append_ui_primitive(primitives, "mini-meter", "compact status meter", "wired")

    append_ui_token(tokens, "control.button.size.tight", "geometry", "tight", "Kain UI graph chrome.buttonSize")
    append_ui_token(tokens, "surface.applet.mount.topbar.trailing", "geometry", "workbench.topbar.trailing", "WorkbenchTopBar applet strip")
    append_ui_token(tokens, "surface.settings.gap.compact", "spacing", "compact", "Settings row and block spacing")
    append_ui_token(tokens, "surface.settings.status.live", "interaction", "live", "SettingsStatusPill active state")
    append_ui_token(tokens, "surface.settings.text.caption", "typography", "caption", "Compact explanatory text")

    append_ui_action(actions, "kain.ui.reload", "Reload Kain UI", "tauron.kain.reload", "wired")
    append_ui_action(actions, "kain.ui.emit-artifact", "Emit UI Artifact", "greeblefs.ui.emit", "planned")

    json_array_push(consumers, "src/runtime/kainUiScaffold.ts")
    json_array_push(consumers, "src/runtime/kainSemanticUiRuntime.ts")
    json_array_push(consumers, "src/components/kain/KainSemanticSurfaceHost.tsx")
    json_array_push(consumers, "src/components/kain/KainUiRenderer.tsx")
    json_array_push(consumers, "src/components/kain/KainSemanticAppletStrip.tsx")
    json_array_push(consumers, "src/components/WorkbenchTopBar.tsx")
    json_array_push(consumers, "src/components/settings/sections/KainUiSettingsSection.tsx")

    json_object_set(scaffold, "schemaVersion", 1)
    json_object_set(scaffold, "kind", "greeblefs.ui.scaffold")
    json_object_set(scaffold, "source", "src-kain/app/main.kn")
    json_object_set(scaffold, "stdlib", "src-kain/stdlib/greeblefs/ui.kn")
    json_object_set(scaffold, "renderer", "src/components/kain/KainUiRenderer.tsx")
    json_object_set(scaffold, "summary", "Kain-authored semantic UI scaffold for defining GreebleFS surfaces, controls, layout intent, and action ids before deeper migration.")
    json_object_set(scaffold, "namespace", json_string_field(request, "namespace"))
    json_object_set(scaffold, "method", json_string_field(request, "method"))
    json_object_set(scaffold, "surfaces", surfaces)
    json_object_set(scaffold, "primitives", primitives)
    json_object_set(scaffold, "tokens", tokens)
    json_object_set(scaffold, "actions", actions)
    json_object_set(scaffold, "consumers", consumers)
    return scaffold

