{
  "version": 1,
  "id": "palm-organizer",
  "name": "Palm Organizer",
  "description": "Pocket-computer launcher styling with muted graphite, soft sage accents, and tidy icon cards.",
  "author": "Codex",
  "tags": ["pda", "palm", "launcher", "portable"],
  "extends": "nord",
  "fonts": {
    "ui": "\"IBM Plex Sans\", system-ui, sans-serif",
    "mono": "\"IBM Plex Mono\", \"Cascadia Code\", monospace"
  },
  "presentation": {
    "chromeStyle": "minimal",
    "density": "compact",
    "iconStyle": "system",
    "motionStyle": "fluid",
    "cornerRadius": 16,
    "panelSpacing": 8
  },
  "theme": {
    "palette": {
      "appBackground": "#d8ddcf",
      "appBackgroundAlt": "#c8cfbf",
      "shellBackground": "rgba(235, 239, 231, 0.94)",
      "shellBackgroundSolid": "rgba(235, 239, 231, 0.98)",
      "topBarBackground": "#4e5a53",
      "topBarMenuBackground": "#5d6b63",
      "sidebarBackground": "rgba(222, 229, 217, 0.96)",
      "panelBackground": "rgba(245, 248, 241, 0.96)",
      "panelAltBackground": "rgba(228, 234, 223, 0.98)",
      "cardBackground": "rgba(255, 255, 255, 0.94)",
      "cardHoverBackground": "rgba(244, 249, 240, 0.98)",
      "contextMenuBackground": "rgba(245, 248, 241, 0.98)",
      "inputBackground": "#ffffff",
      "terminalBackground": "#2f3833",
      "selectionBackground": "rgba(108, 154, 124, 0.18)",
      "textPrimary": "#243128",
      "textSecondary": "#314338",
      "textMuted": "rgba(36, 49, 40, 0.66)",
      "textDim": "rgba(36, 49, 40, 0.4)",
      "textInverse": "#f7faf6",
      "border": "rgba(85, 113, 94, 0.22)",
      "borderStrong": "rgba(85, 113, 94, 0.42)",
      "accent": "#6c9a7c",
      "accentSoft": "rgba(108, 154, 124, 0.16)",
      "accentContrast": "#ffffff"
    },
    "effects": {
      "backgroundImage": "linear-gradient(180deg, rgba(255,255,255,0.22), rgba(255,255,255,0) 42%)",
      "shadow": "0 14px 28px rgba(76, 90, 80, 0.18)",
      "overlayShadow": "0 -2px 0 0 #91b39d, 0 -18px 38px rgba(62, 74, 66, 0.26)"
    },
    "workbench": {
      "brandLabel": "Organizer",
      "topBarStyle": "minimal",
      "commandPaletteStyle": "floating",
      "terminalStyle": "solid",
      "settingsStyle": "floating",
      "tabStyle": "capsule",
      "metrics": {
        "chromeHeight": 34,
        "controlRadius": 14,
        "panelRadius": 16,
        "shellInset": 10,
        "pagePadding": 10,
        "panelGap": 8
      }
    },
    "explorer": {
      "railBrandLabel": "Pocket",
      "toolbarStyle": "minimal",
      "breadcrumbStyle": "plain",
      "selectionStyle": "outline",
      "hoverStyle": "lift",
      "previewStyle": "floating",
      "statusBarStyle": "hidden",
      "preferredViewMode": "icons-l",
      "metrics": {
        "railWidth": 236,
        "previewWidth": 400,
        "panelRadius": 16,
        "gridScale": 1.12,
        "iconScale": 1.08
      }
    }
  },
  "layoutPrimitives": [
    {
      "id": "palm-grid",
      "name": "Palm Grid",
      "kind": "grid",
      "props": {
        "cellSize": 132
      }
    }
  ],
  "navigationPatterns": [
    {
      "id": "palm-spatial",
      "name": "Palm Spatial",
      "kind": "spatial",
      "axis": "both",
      "props": {
        "breadcrumb": false
      }
    }
  ],
  "renderStyles": [
    {
      "id": "palm-render",
      "label": "Palm Launcher",
      "description": "Portable springboard-style launcher runtime.",
      "kind": "ios-springboard",
      "entryModule": "renderers/palm-organizer.tsx",
      "supportsLiveSwap": true
    }
  ],
  "defaultLayoutPrimitiveId": "palm-grid",
  "defaultNavigationPatternId": "palm-spatial",
  "defaultRenderStyleId": "palm-render",
  "visuals": [
    {
      "id": "palm-paper-sheen",
      "backgroundImage": "radial-gradient(circle at 14% 14%, rgba(255,255,255,0.4), transparent 22%)",
      "opacity": 0.9,
      "blendMode": "screen"
    }
  ]
}
