        "statusBarBackground": "rgba(248, 250, 252, 0.92)",
        "statusBarBorder": "rgba(15, 23, 42, 0.08)",
        "itemHoverBackground": "rgba(47, 111, 237, 0.05)",
        "itemHoverBorder": "rgba(15, 23, 42, 0.06)",
        "itemSelectedBackground": "rgba(47, 111, 237, 0.10)",
        "itemSelectedBorder": "rgba(47, 111, 237, 0.22)",
        "itemDropBackground": "rgba(47, 111, 237, 0.12)",
        "itemDropBorder": "rgba(47, 111, 237, 0.30)",
        "itemFocusShadow": "none",
        "inputBackground": "rgba(255, 255, 255, 0.98)",
        "inputBorder": "rgba(15, 23, 42, 0.08)",
        "chipBackground": "rgba(255, 255, 255, 0.78)",
        "chipBorder": "rgba(15, 23, 42, 0.08)",
        "chipActiveBackground": "rgba(47, 111, 237, 0.08)",
        "chipActiveBorder": "rgba(47, 111, 237, 0.20)",
