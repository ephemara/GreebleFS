  "layoutPrimitives": [
    {
      "id": "clarity-split",
      "name": "Clarity Split",
      "kind": "split",
      "props": {
        "primaryRatio": 0.64
      }
    }
  ],
  "navigationPatterns": [
    {
      "id": "clarity-palette",
      "name": "Clarity Palette",
      "kind": "palette",
      "axis": "horizontal",
      "props": {
        "searchFirst": true
      }
    }
  ],
  "renderStyles": [
    {
      "id": "clarity-render",
      "label": "Clarity Line Shell",
      "description": "A clean workbench renderer with a calm navigation rail and thin chrome.",
      "kind": "vs-code-workbench",
      "entryModule": "renderers/clarity-line-shell.tsx",
      "supportsLiveSwap": true
    }
  ],
  "themeRenderer": {
    "entryModule": "renderers/clarity-line-shell.tsx",
    "apiVersion": 1,
    "supportsLiveSwap": true,
    "fallbackRuntime": "workbench-tabs",
    "capabilities": {
      "customScreens": true,
      "wallpaperScene": true,
      "surfaceAdapters": true
    }
  },
  "defaultLayoutPrimitiveId": "clarity-split",
  "defaultNavigationPatternId": "clarity-palette",
  "defaultRenderStyleId": "clarity-render"
}
