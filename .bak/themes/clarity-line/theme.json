{
  "version": 1,
  "id": "clarity-line",
  "name": "Clarity Line",
  "description": "A restrained editorial shell with thin borders, compact explorer chrome, and calm neutral contrast.",
  "author": "Codex",
  "homepage": "https://overlayterm.local/themes/clarity-line",
  "tags": ["minimal", "clean", "editorial", "light", "custom-renderer"],
  "extends": "aqua-light",
  "assets": {
