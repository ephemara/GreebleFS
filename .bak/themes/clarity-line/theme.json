      "typography": {
        "railEyebrowSize": 10,
        "railTitleSize": 13,
        "toolbarFontSize": 11,
        "breadcrumbFontSize": 10,
        "entryTitleSize": 11,
        "entryMetaSize": 10,
        "statusFontSize": 10,
        "entryTitleWeight": 500,
        "labelLetterSpacing": "0.05em"
      }
