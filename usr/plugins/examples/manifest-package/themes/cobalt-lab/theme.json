{
  "version": 1,
  "id": "cobalt-lab",
  "name": "Cobalt Lab",
  "extends": "operator",
  "theme": {
    "defaultShaderId": "cobalt-halo",
    "palette": {
      "accent": "#38bdf8",
      "panelBackground": "#101b2f",
      "panelAltBackground": "#13213a",
      "textPrimary": "#dff6ff"
    },
    "fonts": {
      "ui": "\"Space Grotesk\", Inter, sans-serif",
      "mono": "\"JetBrains Mono\", \"Cascadia Code\", monospace"
    }
  },
  "visuals": [
    {
      "id": "cobalt-radial",
      "backgroundImage": "radial-gradient(circle at 20% 20%, rgba(56,189,248,0.28), transparent 50%)",
      "opacity": 1
    }
  ]
}
