{
  "name": "greeble3d",
  "private": true,
  "version": "0.1.0",
  "description": "Portable Greeble 3D modeler bundle with React host, Rust/WASM runtime, and Sketchfab integration.",
  "type": "module",
  "main": "./dist/lib/greeble3d.js",
  "module": "./dist/lib/greeble3d.js",
  "style": "./dist/lib/index.css",
  "types": "./dist/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/greeble3d.js"
    },
    "./styles.css": "./dist/lib/index.css",
    "./manifest": "./Greeble3D.manifest.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && vite build",
    "build:lib": "npm run build:wasm && vite build --mode library && npm run build:types",
    "build:types": "tsc -p tsconfig.types.json",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "build:wasm": "node build_wasm.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^3.0.6",
    "tailwind-merge": "^3.4.0",
    "three": "^0.165.0",
    "three-mesh-bvh": "^0.8.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}
