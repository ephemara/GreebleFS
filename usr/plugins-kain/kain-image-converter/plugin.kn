fn build_host_ui_kit() -> Any:
    let kit = json_object_new()
    let components = json_array_new()
    json_array_push(components, make_host_ui_component("image-converter.shell", "tool-shell", "Image Converter Shell", "workbench", "workbench", "Shared host-rendered shell for path, format, resize, quality, action strip, and compact result telemetry.", string_array_5("path-input", "format-select", "dimension-input", "action-strip", "result-panel"), string_array_3("kain.image.inspect", "kain.image.plan-conversion", "kain.image.convert"), string_array_5("host.files", "host.preview", "host.pythonSidecar", "host.kainBridge", "host.runtimePipeline")))
    json_array_push(components, make_host_ui_component("image-converter.preview-strip", "preview-toolbar", "Image Preview Strip", "preview-workbench", "preview-workbench", "Preview-pane compact controls for selected image conversion without TSX plugin code.", string_array_4("path-input", "format-select", "icon-button", "mini-meter"), string_array_3("kain.image.inspect", "kain.image.plan-conversion", "kain.image.convert"), string_array_4("host.preview", "host.files", "host.kainBridge", "host.plugins")))

    json_object_set(kit, "id", "greeblefs.image-workbench-kit")
    json_object_set(kit, "label", "GreebleFS Image Workbench Kit")
    json_object_set(kit, "version", "0.1.0")
    json_object_set(kit, "status", "live")
    json_object_set(kit, "summary", "Shared Kain-authored vocabulary for trusted compact GreebleFS workbench and preview controls.")
    json_object_set(kit, "primitives", string_array_6("path-input", "format-select", "dimension-input", "action-strip", "mini-meter", "result-panel"))
    json_object_set(kit, "tokens", string_array_4("density.compact", "radius.5", "surface.muted", "accent.safe"))
    json_object_set(kit, "components", components)
    return kit

