    json_object_set(item, "mimeType", mime_type)
    json_object_set(item, "encoder", encoder)
    json_object_set(item, "status", "live")
    json_object_set(item, "read", read)
    json_object_set(item, "write", write)
    json_array_push(items, item)
    return 0

