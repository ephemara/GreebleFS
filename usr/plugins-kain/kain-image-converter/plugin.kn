fn make_fabric_output(name: String, output_kind: String) -> Any:
    let output = json_object_new()
    json_object_set(output, "name", name)
    json_object_set(output, "kind", output_kind)
    return output

fn make_fabric_step(id: String, label: String, runtime: String, entry: String, status: String, summary: String, depends_on: Array<String>, requires: Array<String>, outputs: Array<Any>) -> Any:
    let step = json_object_new()
    json_object_set(step, "id", id)
    json_object_set(step, "label", label)
    json_object_set(step, "runtime", runtime)
    json_object_set(step, "entry", entry)
    json_object_set(step, "status", status)
    json_object_set(step, "summary", summary)
    json_object_set(step, "dependsOn", depends_on)
    json_object_set(step, "requires", requires)
    json_object_set(step, "outputs", outputs)
    return step

fn build_fabric_pipelines() -> Array<Any>:
    let pipelines = json_array_new()
    let pipeline = json_object_new()
    let steps = json_array_new()
    let outputs = json_array_new()

    json_array_push(outputs, make_fabric_output("settings", "value"))
    json_array_push(steps, make_fabric_step("python_source", "Python Source", "python", "plugin.runtime/fabric/scripts/python_step.py", "declared", "Python/Numpy/Pillow lane can gather source metadata and prepare image settings.", json_array_new(), string_array_2("runtime.python", "contract.value"), outputs))

    let kain_outputs = json_array_new()
    json_array_push(kain_outputs, make_fabric_output("image", "shared-image"))
    json_array_push(kain_outputs, make_fabric_output("report", "value"))
    json_array_push(steps, make_fabric_step("kain_orchestrator", "Kain Orchestrator", "kain", "plugin.runtime/fabric/src/main.kn", "declared", "Kain owns the typed conversion intent and neutral shared image contract.", string_array_1("python_source"), string_array_2("runtime.kain", "contract.shared-image"), kain_outputs))

    let c_outputs = json_array_new()
    json_array_push(c_outputs, make_fabric_output("filtered_image", "shared-image"))
    json_array_push(c_outputs, make_fabric_output("snapshot", "shared-buffer"))
    json_array_push(steps, make_fabric_step("native_filter", "C ABI Filter", "c_abi", "plugin.runtime/fabric/src/native_step.kn", "declared", "C/DLL lane can mutate shared image bytes through Kain C runtime bridges.", string_array_1("kain_orchestrator"), string_array_2("runtime.c-abi", "contract.shared-buffer"), c_outputs))

    let cargo_outputs = json_array_new()
    json_array_push(cargo_outputs, make_fabric_output("analysis", "value"))
    json_array_push(steps, make_fabric_step("rust_analyzer", "Cargo Analyzer", "rust_crate", "plugin.runtime/fabric/src/rust_step.kn", "compiled-helper", "Plugin-owned Cargo helper can score outputs and expose crate FFI utilities.", string_array_2("native_filter", "kain_orchestrator"), string_array_2("runtime.rust-crate", "contract.value"), cargo_outputs))

    let node_outputs = json_array_new()
    json_array_push(node_outputs, make_fabric_output("summary", "value"))
    json_array_push(node_outputs, make_fabric_output("input_keys", "value"))
    json_array_push(steps, make_fabric_step("node_packager", "Node Packager", "node", "plugin.runtime/fabric/scripts/node_step.mjs", "declared", "Node FFI lane can package previews, HTML reports, and npm-native optimizations.", string_array_2("kain_orchestrator", "rust_analyzer"), string_array_2("runtime.node", "contract.value"), node_outputs))

    json_object_set(pipeline, "id", "kain-image-converter.fabric")
    json_object_set(pipeline, "label", "Image Converter Fabric")
    json_object_set(pipeline, "manifestPath", "usr/plugins-kain/kain-image-converter/plugin.runtime/fabric/KAIN.fabric.toml")
    json_object_set(pipeline, "workspaceRoot", "usr/plugins-kain/kain-image-converter/plugin.runtime/fabric")
    json_object_set(pipeline, "reportDirectory", "plugin.runtime/fabric/.kain/fabric/reports")
    json_object_set(pipeline, "status", "declared")
    json_object_set(pipeline, "summary", "Fabric-ready multi-FFI session: Python prepares data, Kain authors shared contracts, C mutates bytes, Cargo analyzes, Node packages reports, and GreebleFS hosts the workbench safely.")
    json_object_set(pipeline, "eventStream", true)
    json_object_set(pipeline, "runtimes", string_array_5("python", "kain", "c_abi", "rust_crate", "node"))
    json_object_set(pipeline, "ffiLanes", string_array_5("python", "c-runtime", "cargo-ffi", "node", "wasm"))
    json_object_set(pipeline, "requiredCapabilities", string_array_6("runtime.python", "runtime.kain", "runtime.c-abi", "runtime.rust-crate", "runtime.node", "contract.shared-image"))
    json_object_set(pipeline, "outputContracts", string_array_4("value", "shared-image", "shared-buffer", "artifact"))
    json_object_set(pipeline, "steps", steps)
    json_array_push(pipelines, pipeline)
    return pipelines

fn build_authoring_reference() -> Any:
    let reference = json_object_new()
    let features = json_array_new()
    let examples = json_array_new()
    let smoke_commands = json_array_new()

    json_array_push(features, make_authoring_feature("typed-domain-model", "Structs, enums, traits, impls", "live", "usr/plugins-kain/kain-image-converter/plugin.kn", "The plugin declares typed conversion intent and plugin contracts before emitting host metadata."))
    json_array_push(features, make_authoring_feature("component-world", "Component and world surface", "live", "usr/plugins-kain/kain-image-converter/plugin.kn", "A Kain component/world pair describes the future native/web reference surface."))
    json_array_push(features, make_authoring_feature("patch-law-converge", "Patch, law, and converge", "live", "usr/plugins-kain/kain-image-converter/plugin.kn", "The plugin models mutation, validation, and lane selection as compiler-owned Kain intent."))
    json_array_push(features, make_authoring_feature("orchestrate", "Cross-runtime orchestrate", "authored", "usr/plugins-kain/kain-plugin-authoring-examples/02_orchestrated_ffi_pipeline.kn", "The reference pipeline stages Kain, Python, and Node while the trusted host controls execution."))
    json_array_push(features, make_authoring_feature("python-ffi", "Python FFI execution", "live", "src-python/greeblefs_sidecar/image_converter_runtime.py", "Pillow executes the current inspect, plan, convert, SVG embed, and ICO byte path."))
    json_array_push(features, make_authoring_feature("node-ffi", "Node FFI optimizer lane", "declared", "usr/plugins-kain/kain-image-converter/plugin.runtime/node/image_converter_node_bridge.kn", "Sharp/SVGO are declared as the future fast optimization lane."))
    json_array_push(features, make_authoring_feature("cargo-ffi", "Cargo FFI helper", "compiled-helper", "usr/plugins-kain/kain-image-converter/plugin.runtime/cargo/greeblefs-kain-image-tools", "A plugin-owned Rust crate proves native helper isolation and FFI symbols."))
    json_array_push(features, make_authoring_feature("c-runtime", "C runtime codec bridge", "available-in-kain", "usr/plugins-kain/kain-image-converter/plugin.runtime/c-runtime/image_converter_c_runtime_bridge.kn", "The plugin declares the C/DLL/SDK lane Kain can use for native codecs."))
    json_array_push(features, make_authoring_feature("wasm-worker", "WASM preview worker", "declared", "usr/plugins-kain/kain-image-converter/plugin.runtime/wasm/image_converter_preview_worker.kn", "Kain-authored portable worker target for future preview transforms."))

    json_array_push(examples, make_reference_example("minimal-plugin", "Minimal Kain plugin catalog", "usr/plugins-kain/kain-plugin-authoring-examples/00_minimal_plugin.kn", "run", "kain run", string_array_3("json-catalog", "workbench", "action")))
    json_array_push(examples, make_reference_example("contracts-and-laws", "Contracts and laws", "usr/plugins-kain/kain-plugin-authoring-examples/01_contracts_and_laws.kn", "run", "kain run", string_array_4("struct", "enum", "trait", "law")))
    json_array_push(examples, make_reference_example("orchestrated-pipeline", "Orchestrated FFI pipeline", "usr/plugins-kain/kain-plugin-authoring-examples/02_orchestrated_ffi_pipeline.kn", "build", "kain build -t rust/js/ts", string_array_4("world", "patch", "converge", "orchestrate")))
    json_array_push(examples, make_reference_example("component-world", "Component and world UI contract", "usr/plugins-kain/kain-plugin-authoring-examples/03_component_world_reference.kn", "build", "kain build -t rust", string_array_3("component", "world", "jsx")))

    json_array_push(smoke_commands, "toolchains/kain/payload/bin/kain.exe run usr/plugins-kain/kain-image-converter/plugin.kn")
    json_array_push(smoke_commands, "toolchains/kain/payload/bin/kain.exe run usr/plugins-kain/kain-image-converter/plugin.runtime/kain/image_converter_pipeline.kn")
    json_array_push(smoke_commands, "toolchains/kain/payload/bin/kain.exe build usr/plugins-kain/kain-image-converter/plugin.kn -t ts -o target/kain-image-converter-plugin-build/plugin.ts")

    json_object_set(reference, "id", "kain-image-converter.reference")
    json_object_set(reference, "summary", "Canonical example for writing GreebleFS Kain plugins: source-of-truth Kain, trusted host rendering, explicit FFI lanes, typed intent, and runnable examples.")
    json_object_set(reference, "entry", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(reference, "languageFeatures", features)
    json_object_set(reference, "examples", examples)
    json_object_set(reference, "designRules", string_array_6("Kain owns plugin intent", "GreebleFS owns trusted rendering", "Host bridges write bytes", "FFI lanes are explicit", "Generated compatibility is optional", "Examples must smoke"))
    json_object_set(reference, "smokeCommands", smoke_commands)
    return reference

fn build_contracts() -> Array<Any>:
    let items = json_array_new()
    json_array_push(items, make_contract("plugin.catalog", "plugin-definition", "build_kain_plugin", "usr/plugins-kain/kain-image-converter/plugin.kn", "live", "Complete plugin catalog record consumed by GreebleFS."))
    json_array_push(items, make_contract("tool.image-converter", "tool", "build_image_converter_tool", "usr/plugins-kain/kain-image-converter/plugin.kn", "live", "Format, resize, backend, and UI intent for the host."))
    json_array_push(items, make_contract("workbench.main", "workbench", "build_workbench", "usr/plugins-kain/kain-image-converter/plugin.kn", "live", "Primary workbench mounted through KainPluginWorkbenchHost."))
    json_array_push(items, make_contract("preview.image", "preview-workbench", "build_preview_workbench", "usr/plugins-kain/kain-image-converter/plugin.kn", "live", "Preview lane contribution for image files."))
    json_array_push(items, make_contract("orchestrate.pipeline", "orchestrate", "convert_pipeline", "usr/plugins-kain/kain-plugin-authoring-examples/02_orchestrated_ffi_pipeline.kn", "authored", "Cross-runtime pipeline contract for future direct Kain execution."))
    return items

fn build_pipeline_stages() -> Array<Any>:
    let items = json_array_new()
    json_array_push(items, make_pipeline_stage("catalog", "Kain plugin catalog", "kain", "usr/plugins-kain/kain-image-converter/plugin.kn", "live", "Returns the source-of-truth workbench/tool/action contract.", string_array_2("plugin-definition", "tool-contract")))
    json_array_push(items, make_pipeline_stage("bridge-approval", "Resident Tauron Kain bridge", "tauri-view", "src-kain/app/main.kn", "live", "Approves trusted plugin actions and routes safe payloads.", string_array_2("action-proof", "host-context")))
    json_array_push(items, make_pipeline_stage("python-bytes", "Python Pillow sidecar", "python", "src-python/greeblefs_sidecar/image_converter_runtime.py", "live", "Inspects, plans, resizes, converts, emits SVG embeds, and writes ICO/PDF/raster output.", string_array_3("image-info", "output-file", "warnings")))
    json_array_push(items, make_pipeline_stage("node-optimizer", "Node Sharp/SVGO optimizer", "node", "usr/plugins-kain/kain-image-converter/plugin.runtime/node/image_converter_node_bridge.kn", "declared", "Future fast raster/vector optimization lane through Kain Node FFI.", string_array_2("optimized-raster", "optimized-svg")))
    json_array_push(items, make_pipeline_stage("cargo-helper", "Cargo image math helper", "cargo-ffi", "usr/plugins-kain/kain-image-converter/plugin.runtime/cargo/greeblefs-kain-image-tools", "compiled-helper", "Plugin-owned Rust helper exports C ABI fit-dimension functions.", string_array_2("fit-width", "fit-height")))
    json_array_push(items, make_pipeline_stage("c-codecs", "C runtime codec bridge", "c-runtime", "usr/plugins-kain/kain-image-converter/plugin.runtime/c-runtime/image_converter_c_runtime_bridge.kn", "available-in-kain", "Future DLL/SDK codec lane for vendor formats.", string_array_2("native-codec", "sdk-bridge")))
    json_array_push(items, make_pipeline_stage("wasm-preview", "WASM preview worker", "wasm", "usr/plugins-kain/kain-image-converter/plugin.runtime/wasm/image_converter_preview_worker.kn", "declared", "Future portable preview transform worker.", string_array_2("worker-wasm", "preview-payload")))
    return items

fn build_image_converter_tool() -> Any:
    let tool = json_object_new()
    let formats = json_array_new()
    let presets = json_array_new()
    let backends = json_array_new()
    let ui = json_object_new()

    append_format(formats, "png", "PNG", ".png", "image/png", "Pillow PNG", true, true)
    append_format(formats, "jpg", "JPG", ".jpg", "image/jpeg", "Pillow JPEG", true, true)
    append_format(formats, "webp", "WebP", ".webp", "image/webp", "Pillow WebP", true, true)
    append_format(formats, "bmp", "BMP", ".bmp", "image/bmp", "Pillow BMP", true, true)
    append_format(formats, "tiff", "TIFF", ".tiff", "image/tiff", "Pillow TIFF", true, true)
    append_format(formats, "gif", "GIF", ".gif", "image/gif", "Pillow GIF", true, true)
    append_format(formats, "ico", "ICO", ".ico", "image/x-icon", "Pillow ICO", true, true)
    append_format(formats, "svg", "SVG", ".svg", "image/svg+xml", "Kain SVG embed", true, true)
    append_format(formats, "pdf", "PDF", ".pdf", "application/pdf", "Pillow PDF", true, true)

    append_resize_preset(presets, "icon-256", "256", 256, 256, "contain")
    append_resize_preset(presets, "preview-1024", "1024", 1024, 1024, "contain")
    append_resize_preset(presets, "wallpaper-4k", "4K", 3840, 2160, "cover")
    append_resize_preset(presets, "wide-1920", "FHD", 1920, 1080, "cover")
    append_resize_preset(presets, "thumb-512", "512", 512, 512, "scale-down")

    append_backend(backends, "python-pillow", "Python Pillow", "python", "primary decode, resize, encode, SVG embed, ICO emit", "live", true, string_array_2("pillow", "numpy"), "src-python/greeblefs_sidecar/image_converter_runtime.py")
    append_backend(backends, "node-sharp-svgo", "Node Sharp/SVGO", "node", "future fast raster/vector optimization path through Kain Node FFI", "declared", false, string_array_2("sharp", "svgo"), "usr/plugins-kain/kain-image-converter/plugin.runtime/node/image_converter_node_bridge.kn")
    append_backend(backends, "cargo-image-resvg", "Cargo image/resvg", "cargo-ffi", "future native codec and SVG raster path through Kain Cargo FFI", "compiled-helper", false, string_array_3("image", "resvg", "ico"), "usr/plugins-kain/kain-image-converter/plugin.runtime/cargo/greeblefs-kain-image-tools")
    append_backend(backends, "c-runtime-codecs", "C Runtime Codecs", "c-runtime", "future SDK/DLL codec lane for formats Pillow cannot write", "available-in-kain", false, string_array_2("stb_image", "native-codecs"), "usr/plugins-kain/kain-image-converter/plugin.runtime/c-runtime/image_converter_c_runtime_bridge.kn")
    append_backend(backends, "wasm-preview-worker", "WASM Preview Worker", "wasm", "future portable preview/thumbnail worker emitted by Kain", "declared", false, string_array_2("wasm32", "kain"), "usr/plugins-kain/kain-image-converter/plugin.runtime/wasm/image_converter_preview_worker.kn")

    json_object_set(ui, "density", "compact")
    json_object_set(ui, "layout", "converter-grid")
    json_object_set(ui, "sourceControl", "path-input")
    json_object_set(ui, "outputControl", "format-resize-quality")
    json_object_set(ui, "referenceMode", "plugin-as-teaching-example")

    json_object_set(tool, "id", "kain-image-converter.tool")
    json_object_set(tool, "kind", "image-converter")
    json_object_set(tool, "label", "Kain Image Converter")
    json_object_set(tool, "summary", "Reference-grade Kain workbench plugin: typed intent and compiler-owned contracts in plugin.kn; trusted Python FFI writes bytes; Node/Cargo/C/WASM lanes are explicit growth paths.")
    json_object_set(tool, "primaryActionId", "kain.image.convert")
    json_object_set(tool, "defaultOutputFormat", "png")
    json_object_set(tool, "supportedInputExtensions", image_extensions())
    json_object_set(tool, "resizeModes", string_array_4("contain", "cover", "stretch", "scale-down"))
    json_object_set(tool, "formats", formats)
    json_object_set(tool, "resizePresets", presets)
    json_object_set(tool, "pipelineBackends", backends)
    json_object_set(tool, "ui", ui)
    return tool

fn build_workbench() -> Any:
    let item = json_object_new()
    json_object_set(item, "id", "kain-image-converter.main")
    json_object_set(item, "title", "Kain Image Converter")
    json_object_set(item, "summary", "Open an image path, resize, convert, and inspect the Kain-authored FFI pipeline contract.")
    json_object_set(item, "kind", "workbench")
    json_object_set(item, "mountSlot", "workbench.panels")
    json_object_set(item, "order", 18)
    json_object_set(item, "rendererKind", "kain-host")
    json_object_set(item, "componentId", "KainPluginWorkbenchHost")
    json_object_set(item, "toolId", "kain-image-converter.tool")
    json_object_set(item, "defaultOpen", false)
    json_object_set(item, "hostModels", string_array_6("host.plugins", "host.files", "host.preview", "host.pythonSidecar", "host.kainBridge", "host.runtimePipeline"))
    json_object_set(item, "actions", string_array_3("kain.image.inspect", "kain.image.plan-conversion", "kain.image.convert"))
    json_object_set(item, "ffiLanes", string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm"))
    return item

fn build_preview_workbench() -> Any:
    let item = json_object_new()
    let match_rule = json_object_new()
    let capabilities = json_object_new()
    let chrome = json_object_new()

    json_object_set(match_rule, "appliesTo", "file")
    json_object_set(match_rule, "extensions", image_extensions())
    json_object_set(match_rule, "fileNames", json_array_new())
    json_object_set(match_rule, "previewKinds", string_array_2("image", "binary"))

    json_object_set(capabilities, "editable", false)
    json_object_set(capabilities, "save", false)
    json_object_set(capabilities, "export", true)
    json_object_set(capabilities, "workflowTabs", true)
    json_object_set(capabilities, "contextMenu", true)
    json_object_set(capabilities, "prefetch", true)
    json_object_set(capabilities, "closeGuard", false)

    json_object_set(chrome, "includePreviewTab", true)
    json_object_set(chrome, "includeEditTab", false)
    json_object_set(chrome, "topBarDensity", "compact")

    json_object_set(item, "id", "kain-image-converter.preview.image")
    json_object_set(item, "title", "Kain Convert")
    json_object_set(item, "summary", "Image preview workbench tab that routes conversion through Kain-authored Python/Node/Cargo lanes.")
    json_object_set(item, "order", 930)
    json_object_set(item, "rendererKind", "kain-host")
    json_object_set(item, "runtimeId", "kain-image-converter.runtime")
    json_object_set(item, "runtimeSurfaceId", "")
    json_object_set(item, "buildTarget", "")
    json_object_set(item, "toolId", "kain-image-converter.tool")
    json_object_set(item, "match", match_rule)
    json_object_set(item, "capabilities", capabilities)
    json_object_set(item, "workbenchChrome", chrome)
    json_object_set(item, "actions", string_array_3("kain.image.inspect", "kain.image.plan-conversion", "kain.image.convert"))
    json_object_set(item, "ffiLanes", string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm"))
    return item

fn build_kain_plugin() -> Any:
    let plugin = json_object_new()
    let permissions = json_array_new()
    let ffi_capabilities = json_array_new()
    let runtimes = json_array_new()
    let tools = json_array_new()
    let workbenches = json_array_new()
    let preview_workbenches = json_array_new()
    let actions = json_array_new()
    let wasm_targets = json_array_new()
    let cargo_targets = json_array_new()
    let generated_artifacts = json_array_new()
    let runtime = json_object_new()
    let wasm = json_object_new()
    let cargo = json_object_new()
    let compat = json_object_new()

    json_array_push(permissions, make_ffi("kain.bridge.dispatch", "Kain bridge dispatch", "tauri-view", "Resident Tauron Kain bridge dispatches trusted workbench actions.", "live", true))
    json_array_push(permissions, make_ffi("runtime.ffi.python", "Python image IO", "python", "Pillow-backed resize/convert/ICO/SVG emit path.", "live", true))
    json_array_push(permissions, make_ffi("runtime.ffi.node", "Node asset tools", "node", "Sharp/SVGO path for future high-throughput conversion and vector cleanup.", "declared", false))
    json_array_push(permissions, make_ffi("runtime.ffi.cargo", "Cargo image helpers", "cargo-ffi", "Rust helper crate compiles beside the plugin for future native codecs.", "compiled-helper", false))
    json_array_push(permissions, make_ffi("runtime.wasm.compile", "WASM preview worker", "wasm", "Future Kain WASM worker for portable previews.", "declared", false))

    json_array_push(ffi_capabilities, make_ffi("python.pillow.converter", "Python Pillow converter", "python", "Actual trusted image inspect/plan/convert action in the managed Python sidecar.", "live", true))
    json_array_push(ffi_capabilities, make_ffi("node.sharp.svgo", "Node Sharp/SVGO bridge", "node", "Declared Kain Node FFI lane for npm-native image optimization.", "declared", false))
    json_array_push(ffi_capabilities, make_ffi("cargo.image.resvg", "Cargo image/resvg bridge", "cargo-ffi", "Compiled plugin-owned Rust helper target for native image math and future codec calls.", "compiled-helper", false))
    json_array_push(ffi_capabilities, make_ffi("c.native.codecs", "C runtime codecs", "c-runtime", "Future C/DLL codec bridge for SDK-only formats.", "available-in-kain", false))
    json_array_push(ffi_capabilities, make_ffi("wasm.preview.worker", "WASM preview worker", "wasm", "Future Kain-compiled portable image worker.", "declared", false))

    json_object_set(runtime, "id", "kain-image-converter.runtime")
    json_object_set(runtime, "kind", "resident-kain-plugin")
    json_object_set(runtime, "language", "kain")
    json_object_set(runtime, "entry", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(runtime, "transport", "tauron.kain.bridge")
    json_object_set(runtime, "status", "catalog-live")
    json_object_set(runtime, "ffiLanes", string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm"))
    json_array_push(runtimes, runtime)

    json_array_push(tools, build_image_converter_tool())
    json_array_push(workbenches, build_workbench())
    json_array_push(preview_workbenches, build_preview_workbench())
    json_array_push(actions, make_action("kain.image.inspect", "Inspect", "Inspect the selected image through the Kain-declared Python FFI lane.", "inspect", "kain.plugin.image_converter.inspect", string_array_2("python", "cargo-ffi")))
    json_array_push(actions, make_action("kain.image.plan-conversion", "Plan", "Build the output path/format/resize plan before writing bytes.", "plan", "kain.plugin.image_converter.plan", string_array_3("python", "node", "cargo-ffi")))
    json_array_push(actions, make_action("kain.image.convert", "Convert", "Resize and convert the image through the trusted Python sidecar action declared by this Kain plugin.", "convert", "kain.plugin.image_converter.convert", string_array_5("python", "node", "c-runtime", "cargo-ffi", "wasm")))

    json_object_set(wasm, "id", "kain-image-converter-preview-worker")
    json_object_set(wasm, "label", "Kain Image Converter Preview Worker")
    json_object_set(wasm, "source", "plugin.runtime/wasm/image_converter_preview_worker.kn")
    json_object_set(wasm, "target", "plugin.runtime/wasm/dist/image_converter_preview_worker.wasm")
    json_object_set(wasm, "buildTarget", "wasm32-unknown-unknown")
    json_object_set(wasm, "status", "declared")
    json_array_push(wasm_targets, wasm)

    json_object_set(cargo, "id", "kain-image-converter-cargo-ffi")
    json_object_set(cargo, "label", "Kain Image Converter Cargo FFI")
    json_object_set(cargo, "crateName", "greeblefs-kain-image-tools")
    json_object_set(cargo, "cratePath", "plugin.runtime/cargo/greeblefs-kain-image-tools")
    json_object_set(cargo, "feature", "image-math")
    json_object_set(cargo, "status", "compiled-helper")
    json_array_push(cargo_targets, cargo)

    json_object_set(compat, "id", "compat-extension-toml")
    json_object_set(compat, "kind", "plugin-compat-manifest")
    json_object_set(compat, "source", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(compat, "target", "generated/kain-image-converter/extension.toml")
    json_object_set(compat, "status", "future")
    json_array_push(generated_artifacts, compat)

    json_object_set(plugin, "id", "kain-image-converter")
    json_object_set(plugin, "name", "Kain Image Converter")
    json_object_set(plugin, "version", "0.2.0")
    json_object_set(plugin, "description", "Canonical Kain-native plugin example: typed image conversion intent, workbench and preview surfaces, trusted Python FFI, declared Node/Cargo/C/WASM lanes, and runnable authoring examples.")
    json_object_set(plugin, "category", "Kain Plugins")
    json_object_set(plugin, "source", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(plugin, "directory", "usr/plugins-kain/kain-image-converter")
    json_object_set(plugin, "manifestPath", "usr/plugins-kain/kain-image-converter/plugin.kn")
    json_object_set(plugin, "status", "live")
    json_object_set(plugin, "tags", string_array_8("kain", "workbench", "image", "converter", "ffi", "python", "reference", "orchestrate"))
    json_object_set(plugin, "permissions", permissions)
    json_object_set(plugin, "ffiCapabilities", ffi_capabilities)
    json_object_set(plugin, "runtimes", runtimes)
    json_object_set(plugin, "tools", tools)
    json_object_set(plugin, "hostUiKit", build_host_ui_kit())
    json_object_set(plugin, "hostUiComponents", build_host_ui_components())
    json_object_set(plugin, "workbenches", workbenches)
    json_object_set(plugin, "previewWorkbenches", preview_workbenches)
    json_object_set(plugin, "actions", actions)
    json_object_set(plugin, "wasmTargets", wasm_targets)
    json_object_set(plugin, "cargoFfiTargets", cargo_targets)
    json_object_set(plugin, "generatedArtifacts", generated_artifacts)
    json_object_set(plugin, "authoring", build_authoring_reference())
    json_object_set(plugin, "contracts", build_contracts())
    json_object_set(plugin, "pipelineStages", build_pipeline_stages())
    json_object_set(plugin, "fabricPipelines", build_fabric_pipelines())
    return plugin

fn main() -> Any:
    return build_kain_plugin()
