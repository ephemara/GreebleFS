type ImageFormatId = String
type ImagePath = String

enum ImageConverterLane:
    Kain
    Python
    Node
    Cargo
    CRuntime
    Wasm

enum ImageConverterSurface:
    Workbench
    PreviewWorkbench
    ReferenceGuide

struct ImageConversionIntent:
    source_path: ImagePath
    output_format: ImageFormatId
    width: Int
    height: Int
    fit_mode: String
    quality: Int

struct ImageConverterPluginContract:
    id: String
    lane: ImageConverterLane
    surface: ImageConverterSurface
    source_path: String
    status: String

trait ReferenceLine:
    fn reference_line(_self: Self_) -> String:
        let __trait_placeholder = none

impl ReferenceLine for ImageConversionIntent:
    fn reference_line(_self: Self_) -> String:
        return f"{_self.source_path}->{_self.output_format}:{_self.width}x{_self.height}:{_self.fit_mode}"

impl ReferenceLine for ImageConverterPluginContract:
    fn reference_line(_self: Self_) -> String:
        return f"{_self.id}:{_self.status}:{_self.source_path}"

fn string_array_1(a: String) -> Array<String>:
    let items = json_array_new()
    json_array_push(items, a)
    return items

