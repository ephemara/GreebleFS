fn python_image_converter_bridge_manifest() -> Any:
    let manifest = json_object_new()
    let actions = json_array_new()
    let formats = json_array_new()
    json_array_push(actions, "kain.plugin.image_converter.inspect")
    json_array_push(actions, "kain.plugin.image_converter.plan")
    json_array_push(actions, "kain.plugin.image_converter.convert")
    json_array_push(formats, "png")
    json_array_push(formats, "jpg")
    json_array_push(formats, "webp")
    json_array_push(formats, "bmp")
    json_array_push(formats, "tiff")
    json_array_push(formats, "gif")
    json_array_push(formats, "ico")
    json_array_push(formats, "svg")
    json_array_push(formats, "pdf")
    json_object_set(manifest, "id", "kain-image-converter.python-bridge")
    json_object_set(manifest, "kind", "python-ffi-bridge")
    json_object_set(manifest, "status", "live")
    json_object_set(manifest, "module", "src-python/greeblefs_sidecar/image_converter_runtime.py")
    json_object_set(manifest, "actions", actions)
    json_object_set(manifest, "formats", formats)
    json_object_set(manifest, "bridge", "GreebleFS managed Python sidecar")
    json_object_set(manifest, "hostProof", "src-python/greeblefs_sidecar/actions.py")
    json_object_set(manifest, "source", "usr/plugins-kain/kain-image-converter/plugin.runtime/python/image_converter_python_bridge.kn")
    return manifest

fn main() -> Any:
    return python_image_converter_bridge_manifest()
