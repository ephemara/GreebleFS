{
  "mobile": {
    "layout": {
      "chromeScale": 1.08,
      "directoriesFirst": true,
      "gridZoom": 1,
      "interfaceScale": 1.08,
      "pagePadding": 16,
      "showHiddenFiles": false,
      "showTabLabels": true,
      "sortBy": "name",
      "sortOrder": "asc",
      "touchComfort": "comfortable",
      "viewMode": "icons-m"
    },
    "remoteAccessMode": "lan",
    "tailscaleHostname": "",
    "tailscaleLoginServer": ""
  },
  "models": {
    "capabilityBindings": {
      "image-cutout": {
        "backendPreference": "auto",
        "modelId": "image-cutout-sam2-small"
      },
      "local-inference": {
        "backendPreference": "auto",
        "modelId": null
      },
      "semantic-indexing": {
        "backendPreference": "auto",
        "modelId": "semantic-minilm-l6-v2"
      },
      "source-separation": {
        "backendPreference": "cuda",
        "modelId": null
      }
    },
    "semanticIndexRootOverrides": {}
  },
  "polygemini": {
    "autoStart": false,
    "defaultModel": "gemini-2.5-flash",
    "maxTokens": 8192,
    "serverPort": 8090,
    "serverUrl": "http://localhost",
    "temperature": 0.7
  },
  "python": {
    "autoUpgradePip": true,
    "bootstrapPackages": "",
    "createBoilerplate": true,
    "preferredInterpreterPath": "",
    "runtimeRoot": ""
  },
  "screenshots": {
    "closeEditorAfterAction": true,
    "defaultCaptureMode": "region",
    "defaultOutputAction": "save-copy",
    "saveDirectory": "Screenshots",
    "showGrid": true
  },
  "system": {
    "accelerationRoutingMode": "auto",
    "consumerDiagnosticsEnabled": false,
    "consumerDiagnosticsIncludePerfSamples": true,
    "consumerDiagnosticsIncludePluginRuntime": true,
    "consumerDiagnosticsIncludeRendererRuntime": true,
    "devTelemetryHudVisible": false,
    "developerMode": true,
    "developerTelemetryCaptureMode": "raw",
    "developerTelemetryEnabled": true,
    "developerTelemetryMaxFileSizeMb": 64,
    "developerTelemetryPayloadMode": "metadata+small-payloads",
    "developerTelemetryShowInspector": true,
    "developerTelemetryWriteToFile": true,
    "developerTestSettingsEnabled": false,
    "gpuTierMode": "auto",
    "hideAppInTray": false,
    "launchAtStartup": false,
    "linuxDisplayBackendPreference": "auto",
    "linuxNvidiaWebkitWorkaroundMode": "auto",
    "showInTaskbar": true,
    "sourceTraceModeEnabled": false,
    "startMobileShareOnBoot": false
  }
}