{
  "version": 1,
  "id": "prism-switchboard",
  "name": "Prism Switchboard",
  "description": "Compact switchboard for pinned folders, launch routes, actions, and widgets.",
  "author": "GreebleFS",
  "tags": ["showcase", "cards", "favorites", "switcher", "editorial"],
  "defaultPresetId": "switchboard",
  "presets": [
    {
      "id": "switchboard",
      "name": "Switchboard",
      "modules": [
        { "id": "bookmarks", "moduleId": "bookmarks", "limit": 6 },
        { "id": "quick-access", "moduleId": "quick-access", "limit": 6 },
        { "id": "launchpad", "moduleId": "launchpad", "limit": 6 },
        { "id": "actions", "moduleId": "actions", "limit": 5 },
        { "id": "widgets", "moduleId": "widgets", "limit": 2 }
      ]
    },
    {
      "id": "recall",
      "name": "Recall",
      "modules": [
        { "id": "recent", "moduleId": "recent-folders", "limit": 6 },
        { "id": "most-used", "moduleId": "most-used-folders", "limit": 6 },
        { "id": "saved-searches", "moduleId": "saved-searches", "limit": 4 }
      ]
    }
  ]
}
