{
  "version": 1,
  "id": "greeblefs-core-drag-engines",
  "name": "GreebleFS Core Drag Engines",
  "description": "Built-in Explorer drag/drop engine presets. Kain and user-authored policies can emit the same shape.",
  "defaultEngineId": "performance",
  "sourcePath": "usr/profiles/default/explorer-drag-engines/greeblefs-core/explorer-drag-engine.json",
  "engines": [
    {
      "id": "performance",
      "name": "Performance",
      "description": "Lean registered hit testing and CSS transform presentation for low-latency Explorer drags.",
      "sourceKind": "usr-shipped-package",
      "tags": ["default", "fast", "css"],
      "engine": {
        "pointer": {
          "startDistancePx": 6,
          "coalesceWithRaf": true,
          "hitTestMode": "registered-rects",
          "statePublish": "on-change",
          "sharedSessionLingerMs": 1500
        },
        "intent": {
          "plainDrag": "internal",
          "nativeOutModifier": "alt",
          "copyModifierByPlatform": {
            "windows": "ctrl",
            "linux": "ctrl",
            "macos": "alt"
          }
        },
        "dropTargets": {
          "surfacePriority": {
            "scope-root": 0,
            "non-target-chrome": 0,
            "navigation-target": 1,
            "directory-target": 2
          },
          "directoryAutoOpenDelayMs": 950,
          "navigationAutoOpenDelayMs": 900,
          "tabAutoOpenDelayMs": 1050
        },
        "autoscroll": {
          "enabled": true,
          "edgePx": 88,
          "outsetPx": 24,
          "minSpeedPxPerSecond": 220,
          "maxSpeedPxPerSecond": 1680
        },
        "presentation": {
          "overlayRenderer": "css-transform",
          "pointerOffset": { "x": 18, "y": 20 },
          "maxStackDepth": 1,
          "spring": { "stiffness": 420, "damping": 34, "mass": 0.42 },
          "rotationSpring": { "stiffness": 320, "damping": 26, "mass": 0.3 },
          "tiltFactor": 0.04,
          "maxTiltDegrees": 3,
          "sourceGhostOpacity": 0.24,
          "sourceGhostScale": 0.985,
          "targetHighlightScale": 1.018,
          "targetHighlightOpacity": 0.92,
          "dwellIndicatorHeightPx": 2,
          "folderInhaleScale": 1.025,
          "folderDwellScale": 1.045,
          "folderInhaleLiftPx": 1,
          "folderDwellLiftPx": 3,
          "dropBurstDurationMs": 120,
          "cancelBurstDurationMs": 90,
          "glassBlurEnabled": false,
          "heavyShadowEnabled": false,
          "overlayRadiusPx": 12
        }
      },
      "controls": {
        "pointerStartDistancePx": 6,
        "dwellDelayScale": 1,
        "autoscrollSpeedScale": 1,
        "overlayWeight": 0.25,
        "targetMagnetism": 0.55,
        "nativeOutModifier": "alt"
      }
    },
