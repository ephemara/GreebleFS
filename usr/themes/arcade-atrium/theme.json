{
  "version": 1,
  "id": "arcade-atrium",
  "name": "Arcade Atrium",
  "description": "A bright hybrid shell that mixes Dreamcast optimism, Wii channel spacing, and XMB-style focus rails into a glossy arcade lobby.",
  "author": "Codex",
  "homepage": "https://overlayterm.local/themes/arcade-atrium",
  "tags": ["console", "dreamcast", "wii", "xmb", "bright", "custom-renderer"],
  "extends": "dreamcast-skyline",
  "assets": {
    "background": "assets/wallpaper.svg",
    "preview": "assets/wallpaper.svg"
  },
  "fonts": {
    "ui": "\"Space Grotesk\", Inter, sans-serif",
    "mono": "\"JetBrains Mono\", \"Cascadia Code\", monospace"
  },
  "presentation": {
    "chromeStyle": "glass",
    "density": "comfortable",
    "iconStyle": "vector",
    "motionStyle": "fluid",
    "cornerRadius": 28,
    "panelSpacing": 12
  },
  "theme": {
    "palette": {
      "appBackground": "#e6f6fb",
      "appBackgroundAlt": "#f7fbfd",
      "shellBackground": "rgba(233, 248, 252, 0.84)",
      "shellBackgroundSolid": "rgba(241, 251, 255, 0.96)",
      "topBarBackground": "rgba(252, 254, 255, 0.92)",
      "topBarMenuBackground": "rgba(244, 250, 252, 0.96)",
      "sidebarBackground": "rgba(229, 244, 248, 0.84)",
      "panelBackground": "rgba(255, 255, 255, 0.78)",
      "panelAltBackground": "rgba(243, 250, 252, 0.84)",
      "cardBackground": "rgba(255, 255, 255, 0.82)",
      "cardHoverBackground": "rgba(250, 253, 255, 0.92)",
      "contextMenuBackground": "rgba(255, 255, 255, 0.96)",
      "inputBackground": "rgba(255, 255, 255, 0.94)",
      "terminalBackground": "#11273c",
      "selectionBackground": "rgba(35, 183, 255, 0.16)",
      "textPrimary": "#123148",
      "textSecondary": "#26445a",
      "textMuted": "rgba(18, 49, 72, 0.64)",
      "textDim": "rgba(18, 49, 72, 0.42)",
      "textInverse": "#ffffff",
      "border": "rgba(36, 96, 126, 0.14)",
      "borderStrong": "rgba(35, 183, 255, 0.34)",
      "accent": "#23b7ff",
      "accentSoft": "rgba(35, 183, 255, 0.14)",
      "accentContrast": "#ffffff",
      "success": "#26c281",
      "warning": "#ff934f",
      "danger": "#e35d6a",
      "info": "#0fd7c7",
      "note": "#0fb8ff",
      "prompt": "#ff8f59"
    },
    "effects": {
      "backgroundImage": "radial-gradient(circle at 14% 18%, rgba(15,184,255,0.12), transparent 24%), radial-gradient(circle at 74% 10%, rgba(255,147,79,0.12), transparent 18%), linear-gradient(180deg, rgba(255,255,255,0.16), rgba(255,255,255,0) 42%)",
      "shadow": "0 22px 52px rgba(17, 55, 76, 0.14)",
      "overlayShadow": "0 -3px 0 0 #23b7ff, 0 -24px 44px rgba(17, 55, 76, 0.18)"
    },
    "workbench": {
      "brandLabel": "Atrium",
      "topBarStyle": "floating",
      "commandPaletteStyle": "glass",
      "terminalStyle": "glass",
      "settingsStyle": "floating",
      "tabStyle": "capsule",
      "metrics": {
        "chromeHeight": 40,
        "controlRadius": 18,
        "panelRadius": 28,
        "shellInset": 12,
        "pagePadding": 14,
        "panelGap": 12,
        "commandPaletteWidth": 840
      },
      "cssVars": {
        "--overlay-workbench-brand": "atrium"
      }
    },
    "explorer": {
      "railBrandLabel": "Arcade Deck",
      "toolbarStyle": "floating",
      "breadcrumbStyle": "capsule",
      "selectionStyle": "glow",
      "hoverStyle": "lift",
      "previewStyle": "floating",
      "statusBarStyle": "floating",
      "preferredViewMode": "icons-xl",
      "preferredExperimentalViewMode": "adaptive-semantic-grid",
      "metrics": {
        "railWidth": 252,
        "previewWidth": 452,
        "panelRadius": 28,
        "gridScale": 1.26,
        "iconScale": 1.24,
        "hoverLiftPx": 4
      },
      "cssVars": {
        "--overlay-explorer-brand": "arcade-deck"
      }
    }
  },
  "compatibility": {
    "shellBlueprints": ["classic-dock", "tile-start", "xmb-cross-media"],
    "tags": ["arcade", "atrium", "frosted"]
  },
  "layoutPrimitives": [
    {
      "id": "atrium-split",
      "name": "Atrium Split",
      "kind": "split",
      "props": {
        "primaryRatio": 0.7
      }
    }
  ],
  "navigationPatterns": [
    {
      "id": "atrium-spatial",
      "name": "Atrium Spatial",
      "kind": "spatial",
      "axis": "both",
      "props": {
        "breadcrumb": false,
        "focusRing": "accent"
      }
    }
  ],
  "renderStyles": [
    {
      "id": "atrium-render",
      "label": "Atrium Channels",
      "description": "A launcher-grid fallback tuned for the custom bright-console renderer.",
      "kind": "wii-channels",
      "entryModule": "renderers/arcade-atrium-shell.tsx",
      "supportsLiveSwap": true
    }
  ],
  "themeRenderer": {
    "entryModule": "renderers/arcade-atrium-shell.tsx",
    "apiVersion": 1,
    "supportsLiveSwap": true,
    "fallbackRuntime": "channel-launcher",
    "capabilities": {
      "customScreens": true,
      "wallpaperScene": true,
      "surfaceAdapters": true
    }
  },
  "defaultLayoutPrimitiveId": "atrium-split",
  "defaultNavigationPatternId": "atrium-spatial",
  "defaultRenderStyleId": "atrium-render",
  "visuals": [
    {
      "id": "atrium-gloss",
      "backgroundImage": "linear-gradient(180deg, rgba(255,255,255,0.28), rgba(255,255,255,0) 34%), radial-gradient(circle at 82% 0%, rgba(255,255,255,0.35), transparent 20%)",
      "opacity": 0.94,
      "blendMode": "screen"
    },
    {
      "id": "atrium-grid",
      "backgroundImage": "repeating-linear-gradient(90deg, rgba(35,183,255,0.05) 0 1px, transparent 1px 52px), repeating-linear-gradient(180deg, rgba(15,215,199,0.04) 0 1px, transparent 1px 52px)",
      "opacity": 0.5,
      "blendMode": "screen"
    }
  ]
}
