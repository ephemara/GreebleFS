{
  "version": 1,
  "id": "dos-navigator",
  "name": "DOS Navigator",
  "description": "File-manager blue, bright cyan chrome, and strict no-nonsense utility styling.",
  "author": "Codex",
  "tags": ["retro", "dos", "utility", "file-manager"],
  "extends": "github-dark",
  "fonts": {
    "ui": "\"IBM Plex Mono\", \"Cascadia Code\", monospace",
    "mono": "\"IBM Plex Mono\", \"Cascadia Code\", monospace"
  },
  "presentation": {
    "chromeStyle": "solid",
    "density": "compact",
    "iconStyle": "system",
    "motionStyle": "instant",
    "cornerRadius": 2,
    "panelSpacing": 4
  },
  "theme": {
    "palette": {
      "appBackground": "#00155e",
      "appBackgroundAlt": "#001a74",
      "shellBackground": "rgba(0, 18, 94, 0.92)",
      "shellBackgroundSolid": "rgba(0, 18, 94, 0.98)",
      "topBarBackground": "#00217f",
      "topBarMenuBackground": "#06298f",
      "sidebarBackground": "#001d73",
      "panelBackground": "#001b6b",
      "panelAltBackground": "#00237f",
      "cardBackground": "#00298f",
      "cardHoverBackground": "#0534a8",
      "contextMenuBackground": "#001f79",
      "inputBackground": "#001453",
      "terminalBackground": "#001144",
      "selectionBackground": "rgba(0, 255, 255, 0.16)",
      "textPrimary": "#dffcff",
      "textSecondary": "#8ffaff",
      "textMuted": "rgba(223, 252, 255, 0.7)",
      "textDim": "rgba(223, 252, 255, 0.36)",
      "border": "rgba(0, 255, 255, 0.2)",
      "borderStrong": "rgba(0, 255, 255, 0.42)",
      "accent": "#00f0ff",
      "accentSoft": "rgba(0, 240, 255, 0.16)",
      "accentContrast": "#00144d",
      "warning": "#ffd84a"
    },
    "effects": {
      "backgroundImage": "linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0) 24%)",
      "shadow": "0 14px 36px rgba(0, 0, 0, 0.46)",
      "overlayShadow": "0 -2px 0 0 #00f0ff, 0 -18px 48px rgba(0, 4, 24, 0.84)"
    },
    "workbench": {
      "brandLabel": "Navigator",
      "topBarStyle": "solid",
      "commandPaletteStyle": "solid",
      "terminalStyle": "solid",
      "settingsStyle": "solid",
      "tabStyle": "segment",
      "metrics": {
        "chromeHeight": 30,
        "controlRadius": 2,
        "panelRadius": 2,
        "shellInset": 2,
        "pagePadding": 6,
        "panelGap": 4
      }
    },
    "explorer": {
      "railBrandLabel": "Drive Map",
      "toolbarStyle": "solid",
      "breadcrumbStyle": "plain",
      "selectionStyle": "fill",
      "hoverStyle": "fill",
      "previewStyle": "attached",
      "statusBarStyle": "solid",
      "preferredViewMode": "details",
      "metrics": {
        "railWidth": 232,
        "previewWidth": 420,
        "panelRadius": 2,
        "rowHeightScale": 0.92,
        "iconScale": 0.86
      }
    }
  },
  "layoutPrimitives": [
    {
      "id": "dos-stack",
      "name": "DOS Stack",
      "kind": "stack",
      "props": {
        "gap": 4
      }
    }
  ],
  "navigationPatterns": [
    {
      "id": "dos-tabs",
      "name": "DOS Tabs",
      "kind": "tabbed",
      "axis": "horizontal",
      "props": {
        "directionalNavigation": true
      }
    }
  ],
  "renderStyles": [
    {
      "id": "dos-render",
      "label": "DOS Utility",
      "description": "Hard-edged workbench chrome for retro utility layouts.",
      "kind": "vs-code-workbench",
      "entryModule": "renderers/dos-navigator.tsx",
      "supportsLiveSwap": true
    }
  ],
  "defaultLayoutPrimitiveId": "dos-stack",
  "defaultNavigationPatternId": "dos-tabs",
  "defaultRenderStyleId": "dos-render",
  "visuals": [
    {
      "id": "dos-grid-hum",
      "backgroundImage": "repeating-linear-gradient(90deg, rgba(0,240,255,0.03) 0 1px, transparent 1px 24px)",
      "opacity": 0.5,
      "blendMode": "screen"
    }
  ]
}
