{
  "preset": "custom",
  "layoutPrimitiveId": "doors-split-shell",
  "navigationPatternId": "doors-hierarchy-tabs",
  "renderStyleId": "doors-desktop",
  "chromeLayoutId": "default",
  "defaultModeProfileId": "inspector",
  "railBrandLabel": "Explorer",
  "toolbarStyle": "solid",
  "breadcrumbStyle": "plain",
  "selectionStyle": "fill",
  "hoverStyle": "fill",
  "previewStyle": "attached",
  "statusBarStyle": "solid",
  "labelMode": "inline",
  "preferredViewMode": "details",
  "rail": {
    "defaultViewMode": "tree",
    "showViewModeSelector": false,
    "showAutoExpandToggle": false,
