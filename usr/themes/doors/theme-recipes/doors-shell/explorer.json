      "drives",
      "bookmarks",
      "saved-searches",
      "tags"
    ],
    "hiddenSectionIds": [
      "saved-searches",
      "tags"
    ],
    "sectionChrome": "plain",
    "rowChrome": "plain",
    "hierarchyGuideStyle": "soft",
